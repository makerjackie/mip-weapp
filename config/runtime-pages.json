{
  "schemaVersion": 1,
  "case": "mip-weapp",
  "coverage": "full",
  "routeCount": 41,
  "notes": [
    "Canonical runtime route contract for the membership case.",
    "Must match src/app.json page inventory exactly.",
    "config/project.json routes must list the same 41 paths.",
    "verify-runtime.mjs loads this file; error is never a success state for data routes."
  ],
  "deviceRequiredCapabilities": [
    {
      "id": "phone-auth",
      "label": "微信手机号授权",
      "routes": [
        "packages/member/access/index",
        "packages/member/event-detail/index",
        "pages/membership/index"
      ],
      "reason": "open-type=getPhoneNumber only works on a real device"
    },
    {
      "id": "wechat-pay",
      "label": "微信支付",
      "routes": [
        "pages/membership/index",
        "packages/member/payment-result/index",
        "packages/member/order-detail/index"
      ],
      "reason": "wx.requestPayment and real entitlement require a real device and merchant binding"
    },
    {
      "id": "customer-service",
      "label": "小程序客服会话",
      "routes": ["packages/member/help/index"],
      "reason": "open-type=contact opens WeChat customer service on a real device"
    },
    {
      "id": "subscription-message",
      "label": "活动订阅消息",
      "routes": [
        "packages/member/event-detail/index"
      ],
      "reason": "订阅授权必须由用户手势触发，授权结果和微信送达都需要真机验证"
    },
    {
      "id": "share",
      "label": "分享",
      "routes": ["packages/member/event-detail/index"],
      "reason": "Share sheet behavior is device/WeChat-client only when enabled"
    },
    {
      "id": "phone-calendar",
      "label": "系统日历",
      "routes": ["packages/member/event-detail/index"],
      "reason": "wx.addPhoneCalendar requires real-device permission and calendar verification"
    },
    {
      "id": "photo-upload",
      "label": "活动相册上传",
      "routes": [
        "packages/member/event-album/index",
        "packages/admin/event-album/index"
      ],
      "reason": "相册/相机选择、客户端压缩、CloudBase 上传与内容审核需要真机链路"
    },
    {
      "id": "qr-checkin",
      "label": "二维码签到",
      "routes": [
        "packages/member/ticket/index",
        "packages/admin/event-registrations/index"
      ],
      "reason": "动态签到码需要两台真机验证出示、扫码、重复扫码与撤销签到"
    },
    {
      "id": "two-account-follow",
      "label": "双账号关注关系",
      "routes": [
        "packages/member/member-detail/index",
        "packages/member/connections/index"
      ],
      "reason": "关注、取消关注、粉丝列表与互相关注状态需要两个真实微信账号闭环验证"
    }
  ],
  "sensitivePatterns": [
    "openid",
    "open_id",
    "from_openid",
    "fileid",
    "file_id",
    "cloud://",
    "mysql://",
    "jdbc:",
    "secretid",
    "secretkey",
    "appsecret",
    "phone_number",
    "phonenumber",
    "ticket_code"
  ],
