{
  "schemaVersion": 1,
  "case": "mip-weapp",
  "coverage": "full",
  "routeCount": 62,
  "notes": [
    "Canonical runtime route contract for this membership product.",
    "Must match src/app.json page inventory exactly.",
    "config/project.json routes must list the same 62 paths.",
    "verify-runtime.mjs loads this file; error is never a success state for data routes."
  ],
  "deviceRequiredCapabilities": [
    {
      "id": "phone-auth",
      "label": "微信手机号授权",
      "routes": [
        "packages/member/mip-access/index",
        "packages/member/mip-events/registration/index",
        "pages/membership/index"
      ],
      "reason": "open-type=getPhoneNumber only works on a real device"
    },
    {
      "id": "wechat-pay",
      "label": "微信支付",
      "routes": [
        "pages/membership/index",
        "packages/member/mip-events/registration/index",
        "packages/member/mip-events/detail/index",
        "packages/member/payment-result/index",
        "packages/member/order-detail/index"
      ],
      "reason": "wx.requestPayment and real entitlement require a real device and merchant binding"
    },
    {
      "id": "customer-service",
      "label": "小程序客服会话",
      "routes": ["packages/member/help/index"],
      "reason": "open-type=contact opens WeChat customer service on a real device"
    },
    {
      "id": "subscription-message",
      "label": "活动订阅消息",
      "routes": ["packages/member/mip-notifications/index"],
      "reason": "订阅授权必须由用户手势触发，授权结果和微信送达都需要真机验证"
    },
    {
      "id": "share",
      "label": "分享",
      "routes": ["packages/member/mip-events/detail/index"],
      "reason": "Share sheet behavior is device/WeChat-client only when enabled"
    },
    {
      "id": "calendar-location",
      "label": "活动日历与地图",
      "routes": ["packages/member/mip-events/detail/index"],
      "reason": "wx.addPhoneCalendar 和 wx.openLocation 需要在微信真机中验收"
    },
    {
      "id": "event-album-photo",
      "label": "活动照片上传",
      "routes": ["packages/member/event-album/index"],
      "reason": "wx.chooseMedia、客户端压缩、图片安全检查和上传结果需要真机验收"
    },
    {
      "id": "photo-save",
      "label": "签到海报保存",
      "routes": ["packages/admin/event-console/index"],
      "reason": "wx.saveImageToPhotosAlbum 的相册权限和保存结果需要真机验证"
    },
    {
      "id": "qr-checkin",
      "label": "二维码签到",
      "routes": [
        "packages/member/mip-events/check-in/index",
        "packages/admin/event-registrations/index"
      ],
      "reason": "动态签到码需要两台真机验证出示、扫码、重复扫码与撤销签到"
    },
    {
      "id": "ai-voice",
      "label": "AI 语音草稿",
      "routes": ["packages/member/mip-ai/index"],
      "reason": "录音权限、音频上传和语音整理链路需要真机验证"
    }
  ],
  "sensitivePatterns": [
    "openid",
    "open_id",
    "from_openid",
    "fileid",
    "file_id",
    "cloud://",
    "mysql://",
    "jdbc:",
    "secretid",
    "secretkey",
    "appsecret",
    "phone_number",
    "phonenumber",
    "ticket_code"
  ],
