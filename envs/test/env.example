# 测试目标配置模板（复制为 .env.local；密钥另放 .env.secrets.local，均不入 Git）
# 方向 B：测试环境全部新建（同实例第二库 + mip-t-* 函数集 + admin-test.mip.cool）。
# 部署测试函数集前，先按 docs/mip/ENVIRONMENTS.md 完成第二库的一次性创建。

MINI_PROGRAM_NAME=MIP
APP_NAMESPACE=mip
MINI_PROGRAM_APP_ID=<与生产相同的 AppID>
MIP_ALLOWED_APP_IDS=<与生产相同的 AppID>
CLOUDBASE_ENV_ID=<与生产相同的 EnvID>
MIP_DEPLOYMENT_STAGE=staging
MIP_CATALOG_STAGE=TEST
MIP_PAYMENT_MODE=disabled
# 测试不放支付商户：支付链路禁用，管理端免费补录
WECHAT_PAY_MERCHANT_ID=

# 测试 = 同实例第二库：填写实际建库名；部署/迁移需同时传 --confirm-schema=<同名>
MIP_DB_SCHEMA=<第二库名，如 mip_test>
MIP_IDENTITY_FUNCTION_NAME=mip-t-identity-api
MIP_MEDIA_FUNCTION_NAME=mip-t-media-api
MIP_EVENTS_FUNCTION_NAME=mip-t-events-api
MIP_OPPORTUNITIES_FUNCTION_NAME=mip-t-opportunities-api
MIP_COMMUNITY_FUNCTION_NAME=mip-t-community-api
MIP_COMMERCE_FUNCTION_NAME=mip-t-commerce-api
MIP_ADMIN_FUNCTION_NAME=mip-t-admin-api
MIP_GROWTH_FUNCTION_NAME=mip-t-growth-api
MIP_GAME_FUNCTION_NAME=mip-t-game-api
MIP_TASKS_FUNCTION_NAME=mip-t-tasks-api
MIP_BANNERS_FUNCTION_NAME=mip-t-banners-api
MIP_AI_FUNCTION_NAME=mip-t-ai-api
MIP_NOTIFICATIONS_FUNCTION_NAME=mip-t-notifications-api
MIP_PAY_FUNCTION_NAME=mip-t-cloudpay
MIP_PAY_CALLBACK_FUNCTION=mip-t-cloudpay-callback
MIP_REFUND_FUNCTION_NAME=mip-t-refund-worker
MIP_LEDGER_FUNCTION_NAME=mip-t-payment-ledger
MIP_NOTIFICATION_FUNCTION_NAME=mip-t-notification-worker
MIP_OUTBOX_FUNCTION_NAME=mip-t-outbox-worker
MIP_MESSAGE_SCHEDULER_FUNCTION_NAME=mip-t-message-scheduler
MIP_KNOWLEDGE_SCHEDULER_FUNCTION_NAME=mip-t-knowledge-scheduler

# 测试后台（新 Pages 项目，部署后回填实际域名）
MIP_ADMIN_WEB_LOGIN_CONFIRM_URL=https://admin-test.mip.cool/api/internal/auth/challenge/confirm

# 测试目录不放 ASR/OpenAI/SMS 凭据：AI/短信能力保持关闭
