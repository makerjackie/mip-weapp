.tab-bar {
  --color-brand: #fcdf03;
  --color-muted: #a3a3a3;

  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 9999;
  box-sizing: border-box;
  width: 100%;
  padding-bottom: env(safe-area-inset-bottom);
  pointer-events: auto;
  background-color: #202020;
  border-top: 1rpx solid #363636;
}

.tab-bar-row {
  display: flex;
  align-items: stretch;
  width: 100%;
  max-width: 100%;
  height: 96rpx;
  margin-right: auto;
  margin-left: auto;
}

.tab-bar-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
}

.tab-bar-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-bar-badge {
  position: absolute;
  top: -10rpx;
  left: 34rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 6rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 32rpx;
  color: #080808;
  text-align: center;
  background: #fcdf03;
  border: 2rpx solid #202020;
  border-radius: 999rpx;
}

.tab-bar-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 30rpx;
}

@media (min-width: 600px) and (max-width: 959px) {
  .tab-bar-row {
    max-width: 720px;
  }
}

@media (min-width: 960px) {
  .tab-bar-row {
    max-width: 840px;
  }
}
