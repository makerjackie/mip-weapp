<view class="tab-bar">
  <view class="tab-bar-row" aria-role="tablist" aria-label="主导航">
    <view
      wx:for="{{tabs}}"
      wx:key="value"
      class="tab-bar-item"
      data-tab-bar-item="true"
      data-value="{{item.value}}"
      data-index="{{index}}"
      aria-role="tab"
      aria-label="{{item.label}}"
      aria-selected="{{selected === index}}"
      bindtap="switchTab"
    >
      <view class="tab-bar-icon">
        <t-icon
          name="{{selected === index ? item.iconActive : item.icon}}"
          size="48rpx"
          color="{{selected === index ? 'var(--color-brand)' : 'var(--color-muted)'}}"
        />
        <view wx:if="{{item.value === 'pages/profile/index' && unreadCount > 0}}" class="tab-bar-badge">{{unreadCount > 99 ? '99+' : unreadCount}}</view>
      </view>
      <view class="tab-bar-label" style="color: {{selected === index ? 'var(--color-brand)' : 'var(--color-muted)'}}">{{item.label}}</view>
    </view>
  </view>
</view>
