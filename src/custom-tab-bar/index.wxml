<cover-view class="tab-bar-surface"></cover-view>
<view class="tab-bar">
  <view class="tab-bar-row">
    <view
      wx:for="{{tabs}}"
      wx:key="value"
      class="tab-bar-item"
      data-tab-bar-item="true"
      data-value="{{item.value}}"
      data-index="{{index}}"
      bindtap="switchTab"
    >
      <t-icon
        name="{{selected === index ? item.iconActive : item.icon}}"
        size="48rpx"
        color="{{selected === index ? 'var(--color-brand)' : 'var(--color-muted)'}}"
      />
      <view class="tab-bar-label" style="color: {{selected === index ? 'var(--color-brand)' : 'var(--color-muted)'}}">{{item.label}}</view>
    </view>
  </view>
</view>
