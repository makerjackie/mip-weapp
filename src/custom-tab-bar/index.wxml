<t-tab-bar
  value="{{value}}"
  theme="tag"
  custom-style="--td-tab-bar-height: 84rpx; --td-font-body-extraSmall: 20rpx/28rpx sans-serif; --td-tab-bar-active-color: var(--color-brand); --td-tab-bar-color: var(--color-muted); --td-tab-bar-bg-color: var(--color-panel); --td-tab-bar-active-bg: var(--color-brand-soft); --td-tab-bar-border-color: var(--color-line); z-index: 1000;"
  fixed
  split="{{false}}"
  bordered
  safe-area-inset-bottom
  bind:change="change"
>
  <t-tab-bar-item value="pages/index/index" icon="{{value === 'pages/index/index' ? 'home-filled' : 'home'}}">首页</t-tab-bar-item>
  <t-tab-bar-item value="pages/explore/index" icon="{{value === 'pages/explore/index' ? 'usergroup-filled' : 'usergroup'}}">认识</t-tab-bar-item>
  <t-tab-bar-item value="pages/events/index" icon="{{value === 'pages/events/index' ? 'calendar-event-filled' : 'calendar-event'}}">活动</t-tab-bar-item>
  <t-tab-bar-item value="pages/profile/index" icon="{{value === 'pages/profile/index' ? 'user-filled' : 'user'}}">我的</t-tab-bar-item>
</t-tab-bar>
