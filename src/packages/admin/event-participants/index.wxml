<view id="admin-event-participants-page" class="mip-admin-operations-workspace mip-admin-page mip-admin-workspace-page min-h-screen bg-canvas px-6 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-7 text-ink">
  <mip-admin-workspace-nav />

  <view class="text-[length:40rpx] font-bold">活动参与者</view>
  <view class="mt-2 text-[length:23rpx] text-muted">汇总查询各活动的报名和签到记录。</view>

  <view wx:if="{{state !== 'forbidden'}}" class="mip-admin-filter-grid mt-5 grid gap-3 rounded-[16rpx] bg-panel p-4">
    <view class="mip-admin-filter-wide">
      <t-input class="box-border max-w-full" value="{{query}}" placeholder="搜索用户或活动" bind:change="updateQuery" bind:enter="search" />
    </view>
    <picker range="{{events}}" range-key="title" value="{{eventIndex}}" bindchange="chooseEvent">
      <view class="box-border min-h-[88rpx] break-all rounded-[12rpx] bg-panel-raised px-3 py-3">活动：{{events[eventIndex].title || '全部活动'}}</view>
    </picker>
    <picker range="{{branches}}" range-key="name" value="{{branchIndex}}" bindchange="chooseBranch">
      <view class="box-border min-h-[88rpx] break-all rounded-[12rpx] bg-panel-raised px-3 py-3">分会：{{branches[branchIndex].name || '全部分会'}}</view>
    </picker>
    <picker mode="date" value="{{createdFromDate}}" data-field="createdFromDate" bindchange="chooseDate">
      <view class="box-border min-h-[88rpx] rounded-[12rpx] bg-panel-raised px-3 py-3">报名日期起：{{createdFromDate || '不限'}}</view>
    </picker>
    <picker mode="date" value="{{createdToDate}}" data-field="createdToDate" bindchange="chooseDate">
      <view class="box-border min-h-[88rpx] rounded-[12rpx] bg-panel-raised px-3 py-3">报名日期止：{{createdToDate || '不限'}}</view>
    </picker>
    <view wx:if="{{canPhone}}" class="flex min-h-[88rpx] items-center" role="checkbox" aria-checked="{{includePhone}}" bind:tap="togglePhone">
      <t-tag variant="outline" theme="{{includePhone ? 'primary' : 'default'}}">显示手机号</t-tag>
    </view>
    <view class="mip-admin-span-wide flex flex-wrap gap-1" role="radiogroup" aria-label="报名状态">
      <view wx:for="{{statuses}}" wx:key="value" class="flex min-h-[88rpx] items-center" role="radio" aria-checked="{{status === item.value}}">
        <t-tag variant="outline" theme="{{status === item.value ? 'primary' : 'default'}}" data-value="{{item.value}}" bind:tap="chooseStatus">{{item.label}}</t-tag>
      </view>
    </view>
    <view class="mip-admin-filter-actions mip-admin-span-wide">
      <view wx:if="{{canExport}}" class="min-w-0"><t-button block variant="outline" bind:tap="exportRows">导出</t-button></view>
      <view class="min-w-0"><t-button block theme="primary" bind:tap="search">查询</t-button></view>
    </view>
  </view>

  <view wx:if="{{state === 'loading'}}" class="mt-6 rounded-[16rpx] bg-panel p-5">
    <t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading />
  </view>
  <view wx:elif="{{state === 'error' || state === 'conflict'}}" class="mt-6">
    <app-empty-state title="暂时无法加载参与者" description="{{message}}" action-text="重新加载" bind:action="load" />
  </view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-6">
    <app-empty-state title="无运营权限" description="{{message}}" />
  </view>
  <view wx:elif="{{items.length === 0}}" class="mt-6">
    <app-empty-state title="没有符合条件的参与者" description="调整筛选条件后重新查询。" />
  </view>
  <view wx:else class="mip-admin-record-list mt-5" style="--mip-admin-record-columns: minmax(0, 1.15fr) minmax(0, 1.45fr) minmax(0, 1fr) minmax(0, 1.7fr);">
    <view class="mip-admin-record-header">
      <view>用户与联系</view><view>活动与分会</view><view>报名状态与时间</view><view>报名信息与操作</view>
    </view>
    <view wx:for="{{items}}" wx:key="id" class="mip-admin-record-row">
      <view class="mip-admin-record-cell">
        <view class="mip-admin-record-label">用户与联系</view>
        <view class="break-all text-[length:28rpx] font-semibold">{{item.nickname}}</view>
        <view class="mt-2 break-all text-[length:22rpx] text-muted">手机号：{{item.phoneText}}</view>
      </view>
      <view class="mip-admin-record-cell">
        <view class="mip-admin-record-label">活动与分会</view>
        <view class="break-all text-[length:25rpx] font-semibold">{{item.eventTitle}}</view>
        <view class="mt-2 break-all text-[length:22rpx] text-muted">{{item.branchName || '平台'}}</view>
      </view>
      <view class="mip-admin-record-cell">
        <view class="mip-admin-record-label">报名状态与时间</view>
        <t-tag variant="outline" theme="{{item.statusTheme}}">{{item.statusText}}</t-tag>
        <view class="mt-2 break-all text-[length:22rpx] text-muted">报名时间：{{item.submittedText}}</view>
      </view>
      <view class="mip-admin-record-cell">
        <view class="mip-admin-record-label">报名信息与操作</view>
        <view wx:if="{{item.answerItems.length}}" class="rounded-[12rpx] bg-panel-raised p-3">
          <view wx:for="{{item.answerItems}}" wx:key="key" class="mt-1 break-all text-[length:22rpx]">
            {{item.label}}：<text class="text-muted">{{item.value}}</text>
          </view>
        </view>
        <view wx:else class="text-[length:22rpx] text-muted">未填写补充信息</view>
        <view class="mip-admin-record-actions mt-3">
          <t-button block variant="outline" data-id="{{item.eventId}}" bind:tap="openRoster">查看活动参与者</t-button>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{nextCursor}}" class="mt-4">
    <t-button block variant="outline" loading="{{loadingMore}}" bind:tap="loadMore">加载更多</t-button>
  </view>
  <view wx:if="{{message && state === 'ready'}}" class="mt-4 rounded-[12rpx] bg-panel p-3 text-danger">{{message}}</view>
  <app-page-exit />
</view>
