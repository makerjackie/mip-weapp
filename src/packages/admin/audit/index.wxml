<view id="admin-audit-page" class="mip-admin-page min-h-screen bg-canvas px-6 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-7 text-ink">
  <view class="text-[length:40rpx] font-bold">审计记录</view><view class="mt-2 text-[length:23rpx] text-muted">敏感读取和管理变更只追加记录</view>
  <view class="mip-admin-filter-grid mt-5 grid gap-3 rounded-[16rpx] bg-panel p-3"><t-input value="{{action}}" placeholder="操作名称" bind:change="updateAction" /><view><t-input value="{{resourceType}}" placeholder="资源类型" bind:change="updateResource" bind:enter="search" /></view><view class="mip-admin-filter-wide"><t-button block variant="outline" bind:tap="search">筛选</t-button></view></view>
  <view wx:if="{{state === 'loading'}}" class="mt-6 rounded-[16rpx] bg-panel p-5"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error' || state === 'conflict'}}" class="mt-6"><app-empty-state title="暂时无法加载审计记录" description="{{message}}" action-text="重新加载" bind:action="loadAudit" /></view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-6"><app-empty-state title="没有审计权限" description="当前账号不能查看审计记录。" /></view>
  <view wx:elif="{{items.length === 0}}" class="mt-6"><app-empty-state title="暂无审计记录" description="符合筛选条件的记录会显示在这里。" /></view>
  <view wx:else class="mip-admin-card-list mt-5 flex flex-col gap-3"><view wx:for="{{items}}" wx:key="id" class="rounded-[16rpx] bg-panel px-4 py-4"><view class="flex items-start justify-between gap-3"><view class="text-[length:26rpx] font-semibold">{{item.actionLabel}}</view><view class="text-[length:21rpx] text-muted">{{item.createdAt}}</view></view><view class="mt-2 text-[length:22rpx] text-muted">{{item.actorNickname}} · {{item.roleLabel}}</view><view class="mt-1 text-[length:22rpx] text-muted">{{item.resourceType}} · {{item.scopeLabel}}</view><view class="mt-3 break-all rounded-[10rpx] bg-panel-raised px-3 py-2 text-[length:20rpx] text-muted">{{item.metadataText}}</view></view></view>
  <view wx:if="{{nextCursor}}" class="mt-4"><t-button block variant="outline" loading="{{loadingMore}}" bind:tap="loadMoreAudit">加载更多</t-button></view>
  <app-page-exit />
</view>
