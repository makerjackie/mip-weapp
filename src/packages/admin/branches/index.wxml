<view id="admin-branches-page" class="mip-admin-page mip-admin-workspace-page min-h-screen bg-canvas px-6 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-7 text-ink">
  <mip-admin-workspace-nav />
  <view class="text-[length:40rpx] font-bold">城市分会</view>
  <view class="mt-2 text-[length:23rpx] text-muted">维护城市分会的名称、城市和启用状态</view>

  <view wx:if="{{canManage && state === 'ready'}}" class="mt-5 rounded-[16rpx] bg-panel p-4">
    <view class="text-[length:28rpx] font-semibold">{{editorId ? '编辑分会' : '新增分会'}}</view>
    <view class="mip-admin-section-grid mt-4 grid gap-4">
      <view><view class="text-[length:23rpx] text-muted">分会标识</view><view class="mt-2"><t-input value="{{branchKey}}" maxlength="64" placeholder="例如 shenzhen" disabled="{{!!editorId}}" data-field="branchKey" bind:change="updateField" /></view><view class="mt-2 text-[length:22rpx] text-muted">创建后不可修改，仅使用小写字母、数字和连字符。</view></view>
      <view><view class="text-[length:23rpx] text-muted">分会名称</view><view class="mt-2"><t-input value="{{name}}" maxlength="80" placeholder="填写分会名称" data-field="name" bind:change="updateField" /></view></view>
      <view><view class="text-[length:23rpx] text-muted">城市</view><view class="mt-2"><t-input value="{{cityName}}" maxlength="80" placeholder="填写城市名称" data-field="cityName" bind:change="updateField" /></view></view>
      <view><view class="text-[length:23rpx] text-muted">简介</view><view class="mt-2"><t-input value="{{summary}}" maxlength="500" placeholder="可选" data-field="summary" bind:change="updateField" /></view></view>
      <view class="mip-admin-span-wide grid grid-cols-2 gap-2">
        <t-button block variant="outline" disabled="{{processing}}" bind:tap="resetEditor">{{editorId ? '取消编辑' : '清空'}}</t-button>
        <t-button block theme="primary" loading="{{processing}}" bind:tap="saveBranch">保存</t-button>
      </view>
    </view>
  </view>

  <view wx:if="{{state === 'loading'}}" class="mt-6 rounded-[16rpx] bg-panel p-5"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error' || state === 'conflict'}}" class="mt-6"><app-empty-state title="暂时无法加载城市分会" description="{{message}}" action-text="重新加载" bind:action="loadBranches" /></view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-6"><app-empty-state title="没有分会管理权限" description="当前账号不能维护城市分会。" /></view>
  <view wx:elif="{{branches.length === 0}}" class="mt-6"><app-empty-state title="暂无城市分会" description="新增后会显示在这里。" /></view>
  <view wx:else class="mip-admin-card-list mt-5 flex flex-col gap-3">
    <view wx:for="{{branches}}" wx:key="id" class="rounded-[16rpx] bg-panel px-4 py-4">
      <view class="flex items-start justify-between gap-3">
        <view class="min-w-0 flex-1"><view class="text-[length:28rpx] font-semibold">{{item.name}}</view><view class="mt-1 text-[length:22rpx] text-muted">{{item.cityName}} · {{item.branchKey}}</view></view>
        <t-tag variant="outline">{{item.statusText}}</t-tag>
      </view>
      <view wx:if="{{item.summary}}" class="mt-3 text-[length:24rpx] leading-[1.7] text-muted">{{item.summary}}</view>
      <view class="mip-admin-section-grid mt-3 grid gap-2 text-[length:22rpx] text-muted">
        <view>有效玩家 {{item.currentPlayerCount}}</view>
        <view class="break-all">城市管理员 {{item.branchAdminSummary}}</view>
      </view>
      <view class="mt-4 rounded-[12rpx] bg-panel-raised px-3 py-3">
        <view class="text-[length:23rpx] font-semibold">停用检查</view>
        <view class="mt-2 grid grid-cols-2 gap-2 text-[length:22rpx] text-muted">
          <view>成员 {{item.blockers.activeMemberships}}</view>
          <view>城市管理员 {{item.blockers.activeBranchAdmins}}</view>
          <view>已发布活动 {{item.blockers.publishedEvents}}</view>
          <view>已发布机会 {{item.blockers.publishedOpportunities}}</view>
        </view>
      </view>
      <view class="mt-4 grid grid-cols-2 gap-2">
        <t-button block size="small" variant="outline" disabled="{{processing}}" data-id="{{item.id}}" bind:tap="editBranch">编辑</t-button>
        <t-button block size="small" variant="outline" theme="{{item.status === 'ACTIVE' ? 'danger' : 'primary'}}" loading="{{processing}}" data-id="{{item.id}}" bind:tap="changeStatus">{{item.status === 'ACTIVE' ? '停用' : '启用'}}</t-button>
      </view>
    </view>
  </view>
  <view wx:if="{{message && state === 'ready'}}" class="mt-4 rounded-[12rpx] bg-panel px-4 py-3 text-[length:23rpx] text-danger">{{message}}</view>
  <app-page-exit />
</view>
