<view id="admin-event-feedback-page" class="mip-admin-page mip-admin-workspace-page min-h-screen bg-canvas px-6 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-7 text-ink">
  <mip-admin-workspace-nav />
  <view class="text-[length:40rpx] font-bold">活动反馈</view>
  <view class="mt-2 text-[length:23rpx] text-muted">{{eventTitle || '查看活动参与反馈'}}</view>

  <view wx:if="{{canRead && (state === 'ready' || state === 'empty')}}" class="mt-5 flex flex-wrap gap-2">
    <t-tag wx:for="{{ratingOptions}}" wx:key="value" theme="{{item.value === rating ? 'primary' : 'default'}}" variant="outline" data-rating="{{item.value}}" bind:tap="chooseRating">{{item.label}}</t-tag>
  </view>

  <view wx:if="{{state === 'loading'}}" class="mt-6 rounded-[16rpx] bg-panel p-5"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error' || state === 'conflict'}}" class="mt-6"><app-empty-state title="活动反馈加载失败" description="{{message}}" action-text="重新加载" bind:action="retryLoad" /></view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-6"><app-empty-state title="没有反馈查看权限" description="当前账号不能查看本场活动反馈。" /></view>
  <view wx:elif="{{state === 'empty'}}" class="mt-6"><app-empty-state title="暂无活动反馈" description="当前筛选条件下没有反馈。" /></view>
  <view wx:elif="{{state === 'ready'}}" class="mip-admin-card-list mt-5 flex flex-col gap-3">
    <view wx:for="{{items}}" wx:key="id" class="rounded-[16rpx] bg-panel px-4 py-4">
      <view class="flex items-center justify-between gap-3"><view class="text-[length:26rpx] font-semibold">{{item.nickname || '匿名用户'}}</view><view wx:if="{{item.rating}}" class="text-[length:24rpx] text-brand">{{item.rating}} 分</view></view>
      <view class="mt-3 whitespace-pre-wrap text-[length:26rpx] leading-7">{{item.body}}</view>
      <view class="mt-3 text-[length:20rpx] text-muted">提交于 {{item.submittedText}}<text wx:if="{{item.updatedText && item.updatedText !== item.submittedText}}"> · 更新于 {{item.updatedText}}</text></view>
    </view>
    <view wx:if="{{nextCursor}}" class="mip-admin-span-wide mt-2"><t-button block variant="outline" loading="{{loadingMore}}" disabled="{{loadingMore}}" bind:tap="loadMore">加载更多</t-button></view>
  </view>
  <view wx:if="{{message && (state === 'ready' || state === 'empty')}}" class="mt-4 rounded-[12rpx] bg-panel px-4 py-3 text-[length:23rpx] text-danger">{{message}}</view>
  <app-page-exit />
</view>
