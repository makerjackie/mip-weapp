<view id="admin-community-reports-page" class="mip-admin-page mip-admin-workspace-page min-h-screen bg-canvas px-6 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-7 text-ink">
  <mip-admin-workspace-nav />
  <view class="text-[length:40rpx] font-bold">举报审核</view>
  <view class="mt-2 text-[length:23rpx] text-muted">查看并更新用户举报的审核状态</view>

  <view wx:if="{{canManage && state === 'ready'}}" class="mt-5 flex flex-wrap gap-2">
    <t-tag wx:for="{{statusOptions}}" wx:key="value" theme="{{item.value === status ? 'primary' : 'default'}}" variant="outline" data-status="{{item.value}}" bind:tap="chooseStatus">{{item.label}}</t-tag>
  </view>

  <view wx:if="{{actionReportId && state === 'ready'}}" class="mt-5 rounded-[16rpx] border border-line bg-panel p-4">
    <view class="text-[length:28rpx] font-semibold">{{actionTitle}}</view>
    <view class="mt-2 text-[length:22rpx] text-muted">审核原因会写入审核记录。</view>
    <view class="mt-3"><t-textarea class="box-border max-w-full" value="{{reason}}" maxlength="300" autosize placeholder="填写审核原因" bind:change="updateReason" /></view>
    <view class="mt-4 grid grid-cols-2 gap-2">
      <t-button block variant="outline" disabled="{{processing}}" bind:tap="cancelAction">取消</t-button>
      <t-button block theme="primary" loading="{{processing}}" bind:tap="confirmAction">{{actionButton}}</t-button>
    </view>
  </view>

  <view wx:if="{{state === 'loading'}}" class="mt-6 rounded-[16rpx] bg-panel p-5"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error' || state === 'conflict'}}" class="mt-6"><app-empty-state title="暂时无法加载举报" description="{{message}}" action-text="重新加载" bind:action="retryLoad" /></view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-6"><app-empty-state title="没有举报审核权限" description="当前账号不能查看或处理用户举报。" /></view>
  <view wx:elif="{{reports.length === 0}}" class="mt-6"><app-empty-state title="暂无举报" description="当前状态下没有待显示的举报。" /></view>
  <view wx:else class="mip-admin-card-list mt-5 flex flex-col gap-3">
    <view wx:for="{{reports}}" wx:key="reportId" class="rounded-[16rpx] bg-panel px-4 py-4">
      <view class="flex items-start justify-between gap-3">
        <view><view class="text-[length:27rpx] font-semibold">{{item.categoryLabel}}</view><view class="mt-1 text-[length:21rpx] text-muted">提交于 {{item.createdText}}</view></view>
        <t-tag variant="outline">{{item.statusText}}</t-tag>
      </view>
      <view class="mt-4 grid grid-cols-2 gap-3">
        <view class="min-w-0 rounded-[12rpx] bg-panel-raised px-3 py-3"><view class="text-[length:21rpx] text-muted">举报人</view><view class="mt-1 truncate text-[length:24rpx] font-semibold">{{item.reporter.nickname}}</view><view wx:if="{{item.reporter.headline}}" class="mt-1 text-[length:21rpx] text-muted">{{item.reporter.headline}}</view><view wx:if="{{item.reporter.cityName}}" class="mt-1 text-[length:21rpx] text-muted">{{item.reporter.cityName}}</view></view>
        <view class="min-w-0 rounded-[12rpx] bg-panel-raised px-3 py-3"><view class="text-[length:21rpx] text-muted">被举报用户</view><view class="mt-1 truncate text-[length:24rpx] font-semibold">{{item.target.nickname}}</view><view wx:if="{{item.target.headline}}" class="mt-1 text-[length:21rpx] text-muted">{{item.target.headline}}</view><view wx:if="{{item.target.cityName}}" class="mt-1 text-[length:21rpx] text-muted">{{item.target.cityName}}</view></view>
      </view>
      <view wx:if="{{item.description}}" class="mt-4 text-[length:24rpx] leading-[1.7]">{{item.description}}</view>
      <view wx:else class="mt-4 text-[length:22rpx] text-muted">未填写补充说明</view>
      <view wx:if="{{item.resolutionReason}}" class="mt-4 rounded-[12rpx] border border-line px-3 py-3"><view class="text-[length:21rpx] text-muted">处理原因</view><view class="mt-1 text-[length:23rpx]">{{item.resolutionReason}}</view></view>
      <view class="mt-4 text-[length:21rpx] text-muted">最近更新 {{item.updatedText}}<text wx:if="{{item.reviewedText}}"> · 审核时间 {{item.reviewedText}}</text></view>
      <view wx:if="{{item.status === 'PENDING'}}" class="mt-4"><t-button block size="small" theme="primary" disabled="{{processing}}" data-id="{{item.reportId}}" data-action="CLAIM" bind:tap="beginAction">领取审核</t-button></view>
      <view wx:elif="{{item.status === 'REVIEWING'}}" class="mt-4 grid grid-cols-2 gap-2"><t-button block size="small" variant="outline" disabled="{{processing}}" data-id="{{item.reportId}}" data-action="DISMISSED" bind:tap="beginAction">驳回</t-button><t-button block size="small" theme="primary" disabled="{{processing}}" data-id="{{item.reportId}}" data-action="RESOLVED" bind:tap="beginAction">完成处理</t-button></view>
    </view>
  </view>
  <view wx:if="{{message && state === 'ready'}}" class="mt-4 rounded-[12rpx] bg-panel px-4 py-3 text-[length:23rpx] text-danger">{{message}}</view>
  <view wx:if="{{state === 'ready'}}" class="mt-4 text-[length:22rpx] text-muted">审核结果不会自动更改用户账号状态。</view>
  <app-page-exit />
</view>
