<view id="admin-dashboard-page" class="min-h-screen bg-canvas px-6 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-7 text-ink">
  <view class="border-b border-line pb-5"><view class="text-[length:22rpx] font-semibold text-brand">MIP 管理</view><view class="mt-2 text-[length:40rpx] font-bold">运营工作台</view><view class="mt-2 text-[length:24rpx] text-muted">按当前账号权限显示可处理任务</view></view>
  <view wx:if="{{state === 'loading'}}" class="mt-6 rounded-[16rpx] bg-panel px-5 py-6"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error' || state === 'conflict'}}" class="mt-6"><app-empty-state title="暂时无法加载工作台" description="{{message}}" action-text="重新加载" bind:action="loadDashboard" /></view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-6"><app-empty-state title="没有运营权限" description="当前账号未获得管理权限。" action-text="重新验证" bind:action="loadDashboard" /></view>
  <view wx:else>
    <view class="mt-6 grid grid-cols-2 gap-3">
      <view class="rounded-[16rpx] bg-panel px-4 py-4"><view class="text-[length:36rpx] font-bold">{{counts.activePlayers}}</view><view class="mt-1 text-[length:22rpx] text-muted">有效玩家</view></view>
      <view class="rounded-[16rpx] bg-panel px-4 py-4"><view class="text-[length:36rpx] font-bold">{{counts.pendingRegistrations}}</view><view class="mt-1 text-[length:22rpx] text-muted">待处理报名</view></view>
      <view class="rounded-[16rpx] bg-panel px-4 py-4"><view class="text-[length:36rpx] font-bold">{{counts.pendingRefunds}}</view><view class="mt-1 text-[length:22rpx] text-muted">退款处理中</view></view>
      <view class="rounded-[16rpx] bg-panel px-4 py-4"><view class="text-[length:36rpx] font-bold">{{counts.publishedOpportunities}}</view><view class="mt-1 text-[length:22rpx] text-muted">公开机会</view></view>
    </view>
    <view class="mt-6 flex flex-col gap-3">
      <view wx:if="{{canBranches}}" class="flex min-h-[96rpx] items-center rounded-[16rpx] bg-panel px-4" data-path="/packages/admin/branches/index" bind:tap="openPage"><view class="flex-1"><view class="text-[length:28rpx] font-semibold">城市分会</view><view class="mt-1 text-[length:22rpx] text-muted">新增、编辑和启停城市分会</view></view><t-icon name="chevron-right" size="32rpx" color="var(--color-muted)" /></view>
      <view wx:if="{{canCommunityReports}}" class="flex min-h-[96rpx] items-center rounded-[16rpx] bg-panel px-4" data-path="/packages/admin/community-reports/index" bind:tap="openPage"><view class="flex-1"><view class="text-[length:28rpx] font-semibold">举报审核</view><view class="mt-1 text-[length:22rpx] text-muted">领取举报并记录审核结果</view></view><t-icon name="chevron-right" size="32rpx" color="var(--color-muted)" /></view>
      <view wx:if="{{canAnnouncements}}" class="flex min-h-[96rpx] items-center rounded-[16rpx] bg-panel px-4" data-path="/packages/admin/announcements/index" bind:tap="openPage"><view class="flex-1"><view class="text-[length:28rpx] font-semibold">公告管理</view><view class="mt-1 text-[length:22rpx] text-muted">维护平台和城市分会公告</view></view><t-icon name="chevron-right" size="32rpx" color="var(--color-muted)" /></view>
      <view wx:if="{{canUsers}}" class="flex min-h-[96rpx] items-center rounded-[16rpx] bg-panel px-4" data-path="/packages/admin/profiles/index" bind:tap="openPage"><view class="flex-1"><view class="text-[length:28rpx] font-semibold">用户管理</view><view class="mt-1 text-[length:22rpx] text-muted">筛选、资料、名单与导出</view></view><t-icon name="chevron-right" size="32rpx" color="var(--color-muted)" /></view>
      <view wx:if="{{canEvents}}" class="flex min-h-[96rpx] items-center rounded-[16rpx] bg-panel px-4" data-path="/packages/admin/managed-events/index" bind:tap="openPage"><view class="flex-1"><view class="text-[length:28rpx] font-semibold">活动管理</view><view class="mt-1 text-[length:22rpx] text-muted">活动、参与者、签到和团队</view></view><t-icon name="chevron-right" size="32rpx" color="var(--color-muted)" /></view>
      <view wx:if="{{canOrders}}" class="flex min-h-[96rpx] items-center rounded-[16rpx] bg-panel px-4" data-path="/packages/admin/orders/index" bind:tap="openPage"><view class="flex-1"><view class="text-[length:28rpx] font-semibold">订单与退款</view><view class="mt-1 text-[length:22rpx] text-muted">查看订单并提交退款请求</view></view><t-icon name="chevron-right" size="32rpx" color="var(--color-muted)" /></view>
      <view wx:if="{{canOpportunities}}" class="flex min-h-[96rpx] items-center rounded-[16rpx] bg-panel px-4" data-path="/packages/admin/opportunities/index" bind:tap="openPage"><view class="flex-1"><view class="text-[length:28rpx] font-semibold">机会管理</view><view class="mt-1 text-[length:22rpx] text-muted">查看状态、下架和审计</view></view><t-icon name="chevron-right" size="32rpx" color="var(--color-muted)" /></view>
      <view wx:if="{{canGrowth}}" class="flex min-h-[96rpx] items-center rounded-[16rpx] bg-panel px-4" data-path="/packages/admin/growth-levels/index" bind:tap="openPage"><view class="flex-1"><view class="text-[length:28rpx] font-semibold">成长管理</view><view class="mt-1 text-[length:22rpx] text-muted">等级、规则、流水和人工调整</view></view><t-icon name="chevron-right" size="32rpx" color="var(--color-muted)" /></view>
      <view wx:if="{{canBadges}}" class="flex min-h-[96rpx] items-center rounded-[16rpx] bg-panel px-4" data-path="/packages/admin/badges/index" bind:tap="openPage"><view class="flex-1"><view class="text-[length:28rpx] font-semibold">勋章管理</view><view class="mt-1 text-[length:22rpx] text-muted">目录、授予、撤销和佩戴状态</view></view><t-icon name="chevron-right" size="32rpx" color="var(--color-muted)" /></view>
      <view wx:if="{{canGame}}" class="flex min-h-[96rpx] items-center rounded-[16rpx] bg-panel px-4" data-path="/packages/admin/game/index" bind:tap="openPage"><view class="flex-1"><view class="text-[length:28rpx] font-semibold">赛季与队伍</view><view class="mt-1 text-[length:22rpx] text-muted">配置赛季、队伍、对阵和排行榜</view></view><t-icon name="chevron-right" size="32rpx" color="var(--color-muted)" /></view>
      <view wx:if="{{canTasks}}" class="flex min-h-[96rpx] items-center rounded-[16rpx] bg-panel px-4" data-path="/packages/admin/tasks/index" bind:tap="openPage"><view class="flex-1"><view class="text-[length:28rpx] font-semibold">任务管理</view><view class="mt-1 text-[length:22rpx] text-muted">任务配置、发布和完成流水</view></view><t-icon name="chevron-right" size="32rpx" color="var(--color-muted)" /></view>
      <view wx:if="{{canBanners}}" class="flex min-h-[96rpx] items-center rounded-[16rpx] bg-panel px-4" data-path="/packages/admin/banners/index" bind:tap="openPage"><view class="flex-1"><view class="text-[length:28rpx] font-semibold">Banner 管理</view><view class="mt-1 text-[length:22rpx] text-muted">维护公开页面图片、跳转和排序</view></view><t-icon name="chevron-right" size="32rpx" color="var(--color-muted)" /></view>
      <view wx:if="{{canExceptions}}" class="flex min-h-[96rpx] items-center rounded-[16rpx] bg-panel px-4" data-path="/packages/admin/exceptions/index" bind:tap="openPage"><view class="flex-1"><view class="text-[length:28rpx] font-semibold">异常中心</view><view class="mt-1 text-[length:22rpx] text-muted">查看支付、通知和后台任务异常</view></view><t-icon name="chevron-right" size="32rpx" color="var(--color-muted)" /></view>
      <view wx:if="{{canRoles}}" class="flex min-h-[96rpx] items-center rounded-[16rpx] bg-panel px-4" data-path="/packages/admin/roles/index" bind:tap="openPage"><view class="flex-1"><view class="text-[length:28rpx] font-semibold">角色与权限</view><view class="mt-1 text-[length:22rpx] text-muted">平台、分会和活动角色</view></view><t-icon name="chevron-right" size="32rpx" color="var(--color-muted)" /></view>
      <view wx:if="{{canAudit}}" class="flex min-h-[96rpx] items-center rounded-[16rpx] bg-panel px-4" data-path="/packages/admin/audit/index" bind:tap="openPage"><view class="flex-1"><view class="text-[length:28rpx] font-semibold">审计记录</view><view class="mt-1 text-[length:22rpx] text-muted">查看敏感读取与管理变更</view></view><t-icon name="chevron-right" size="32rpx" color="var(--color-muted)" /></view>
    </view>
  </view>
  <app-page-exit />
</view>
