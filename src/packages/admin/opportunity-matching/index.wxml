<view id="admin-opportunity-matching-page" class="mip-admin-page mip-admin-workspace-page min-h-screen bg-canvas px-6 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-7 text-ink">
  <mip-admin-workspace-nav />
  <view class="text-[length:40rpx] font-bold">机会撮合设置</view><view class="mt-2 text-[length:23rpx] text-muted">配置推荐阈值并查看最近撮合记录。</view>
  <view wx:if="{{state === 'loading'}}" class="mt-6 rounded-[16rpx] bg-panel p-5"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-6"><app-empty-state title="没有机会管理权限" description="当前账号不能管理撮合设置。" /></view>
  <view wx:elif="{{state === 'error'}}" class="mt-6"><app-empty-state title="暂时无法加载撮合设置" description="{{message}}" action-text="重新加载" bind:action="load" /></view>
  <block wx:else>
    <view class="mip-admin-section-grid mt-5 grid gap-4">
      <view class="rounded-[16rpx] bg-panel p-4"><view class="text-[length:27rpx] font-semibold">推荐阈值</view><view class="mt-3 grid grid-cols-2 gap-3"><t-input type="number" label="人才最低分" value="{{talentMinScore}}" data-field="talentMinScore" bind:change="updateNumber" /><t-input type="number" label="项目最低分" value="{{projectMinScore}}" data-field="projectMinScore" bind:change="updateNumber" /></view><view class="mt-3"><t-input type="number" label="最大结果数" value="{{maximumCandidates}}" data-field="maximumCandidates" bind:change="updateNumber" /></view><view class="mt-4 flex min-h-[88rpx] items-center justify-between border-t border-line pt-3"><view><view class="text-[length:23rpx]">外部模型排序</view><view class="mt-1 text-[length:20rpx] text-muted">未配置或调用失败时自动使用本地规则。</view></view><t-switch checked="{{externalProviderEnabled}}" bind:change="toggleProvider" /></view><view class="mt-4"><t-button block theme="primary" loading="{{saving}}" bind:tap="save">保存设置</t-button></view></view>
      <view class="rounded-[16rpx] bg-panel p-4"><view class="text-[length:27rpx] font-semibold">重新计算</view><view class="mt-2 text-[length:21rpx] text-muted">仅支持已发布机会，结果归属机会发布人。</view><view class="mt-3"><t-input value="{{opportunityId}}" placeholder="输入机会 ID" bind:change="updateOpportunityId" /></view><view class="mt-3"><t-button block variant="outline" loading="{{recalculating}}" bind:tap="recalculate">重新计算</t-button></view></view>
    </view>
    <view class="mt-6 text-[length:28rpx] font-semibold">最近记录</view><view wx:if="{{!requests.length}}" class="mt-3 rounded-[16rpx] bg-panel px-4 py-7 text-center text-[length:22rpx] text-muted">暂无撮合记录。</view><view wx:else class="mip-admin-card-list mt-3 flex flex-col gap-3"><view wx:for="{{requests}}" wx:key="id" class="rounded-[16rpx] bg-panel px-4 py-4"><view class="text-[length:25rpx] font-semibold">{{item.sourceOpportunity.title}}</view><view class="mt-2 text-[length:21rpx] text-muted">{{item.resultCount}} 条 · {{item.provider === 'EXTERNAL' ? '外部模型排序' : '本地规则排序'}} · 结果版本 {{item.resultVersion}}</view><view wx:if="{{item.fallbackReason}}" class="mt-2 text-[length:20rpx] text-muted">外部模型未使用，已安全回退。</view></view></view>
    <view wx:if="{{message}}" class="mt-4 rounded-[12rpx] bg-panel px-4 py-3 text-[length:23rpx] text-danger">{{message}}</view>
  </block>
  <app-page-exit />
</view>
