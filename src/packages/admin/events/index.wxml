<view id="admin-events-page" class="min-h-screen bg-canvas px-6 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-7 text-ink">
  <view class="text-[length:40rpx] font-bold">{{eventId ? '编辑活动' : '新建活动'}}</view>
  <view class="mt-2 text-[length:23rpx] text-muted">活动保存后进入内容检查，通过后可以发布。</view>

  <view wx:if="{{state === 'loading'}}" class="mt-6 rounded-[16rpx] bg-panel p-5">
    <t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading />
  </view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-6">
    <app-empty-state title="没有活动编辑权限" description="{{message || '当前账号不能编辑活动。'}}" />
  </view>
  <view wx:elif="{{state === 'error' && eventId}}" class="mt-6">
    <app-empty-state title="活动信息加载失败" description="{{message}}" action-text="重新加载" bind:action="loadEvent" />
  </view>
  <view wx:elif="{{state === 'error'}}" class="mt-6">
    <app-empty-state title="活动配置加载失败" description="{{message}}" action-text="重新加载" bind:action="loadAccessAndBranches" />
  </view>

  <view wx:else class="mt-5 flex flex-col gap-4">
    <view wx:if="{{conflict && !cancelConflict}}" class="rounded-[16rpx] border border-solid border-brand bg-brand-soft p-4">
      <view class="text-[length:26rpx] font-semibold">活动信息已更新</view>
      <view class="mt-2 text-[length:23rpx] text-muted">{{message}}</view>
      <view class="mt-4"><t-button block variant="outline" bind:tap="refreshAfterConflict">载入最新版本</t-button></view>
    </view>
    <view wx:if="{{cancelConflict}}" class="rounded-[16rpx] border border-solid border-brand bg-brand-soft p-4">
      <view class="text-[length:26rpx] font-semibold">取消操作需要重新确认</view>
      <view class="mt-2 text-[length:23rpx] text-muted">{{message}}</view>
      <view class="mt-4"><t-button block variant="outline" bind:tap="refreshAfterCancelConflict">载入最新版本</t-button></view>
    </view>

    <view class="rounded-[16rpx] bg-panel p-4">
      <view class="mb-3 text-[length:27rpx] font-semibold">基本信息</view>
      <view class="mb-2 text-[length:23rpx] text-muted">活动名称</view>
      <t-input class="box-border max-w-full" value="{{draft.title}}" maxlength="120" data-field="title" bind:change="updateField" />
      <view class="mb-2 mt-4 text-[length:23rpx] text-muted">活动摘要</view>
      <t-input class="box-border max-w-full" value="{{draft.summary}}" maxlength="300" data-field="summary" bind:change="updateField" />
      <view class="mb-2 mt-4 text-[length:23rpx] text-muted">活动介绍</view>
      <t-textarea class="box-border max-w-full" value="{{draft.description}}" maxlength="20000" autosize data-field="description" bind:change="updateField" />
      <view class="mt-2 text-[length:20rpx] leading-5 text-muted">可使用 # 标题、- 列表和 ![图片说明](https://图片地址) 排版活动介绍。</view>
      <view class="mb-2 mt-4 text-[length:23rpx] text-muted">活动介绍图片</view>
      <view wx:for="{{draft.contentMedia}}" wx:key="assetId" class="mb-3 rounded-[12rpx] bg-panel-raised p-3">
        <image class="h-[260rpx] w-full rounded-[10rpx] bg-canvas" mode="aspectFill" src="{{item.imageUrl}}" data-index="{{index}}" bind:tap="previewContentImage" />
        <t-input class="box-border mt-2 max-w-full" value="{{item.caption}}" maxlength="120" placeholder="图片说明（选填）" data-index="{{index}}" bind:change="updateContentCaption" />
        <view class="mt-2 grid grid-cols-3 gap-2">
          <t-button size="small" variant="outline" disabled="{{index === 0}}" data-index="{{index}}" data-direction="-1" bind:tap="moveContentImage">上移</t-button>
          <t-button size="small" variant="outline" disabled="{{index === draft.contentMedia.length - 1}}" data-index="{{index}}" data-direction="1" bind:tap="moveContentImage">下移</t-button>
          <t-button size="small" variant="text" theme="danger" data-index="{{index}}" bind:tap="removeContentImage">移除</t-button>
        </view>
      </view>
      <t-button block variant="outline" loading="{{contentUploading}}" disabled="{{saving || cancelBusy || draft.contentMedia.length >= 12}}" bind:tap="chooseContentImage">上传介绍图片</t-button>
      <view class="mb-2 mt-4 text-[length:23rpx] text-muted">参与须知</view>
      <t-textarea class="box-border max-w-full" value="{{draft.notices}}" maxlength="5000" autosize data-field="notices" bind:change="updateField" />
    </view>

    <view class="rounded-[16rpx] bg-panel p-4">
      <view class="mb-3 text-[length:27rpx] font-semibold">活动封面</view>
      <image wx:if="{{coverUrl}}" class="h-[320rpx] w-full rounded-[12rpx] bg-panel-raised" mode="aspectFill" src="{{coverUrl}}" />
      <view wx:else class="flex h-[240rpx] items-center justify-center rounded-[12rpx] bg-panel-raised text-[length:23rpx] text-muted">暂未上传封面</view>
      <view class="mt-3"><t-button block variant="outline" loading="{{coverUploading}}" disabled="{{saving || cancelBusy}}" bind:tap="chooseCover">{{coverUrl ? '更换封面' : '上传封面'}}</t-button></view>
    </view>

    <view class="rounded-[16rpx] bg-panel p-4">
      <view class="mb-3 text-[length:27rpx] font-semibold">活动范围</view>
      <view wx:if="{{canChangeScope}}" class="flex flex-wrap gap-2">
        <view class="flex min-h-[88rpx] items-center" aria-role="radio" aria-checked="{{draft.scopeType === 'PLATFORM'}}" data-value="PLATFORM" bind:tap="chooseScope"><t-tag theme="{{draft.scopeType === 'PLATFORM' ? 'primary' : 'default'}}" variant="outline">平台活动</t-tag></view>
        <view class="flex min-h-[88rpx] items-center" aria-role="radio" aria-checked="{{draft.scopeType === 'BRANCH'}}" data-value="BRANCH" bind:tap="chooseScope"><t-tag theme="{{draft.scopeType === 'BRANCH' ? 'primary' : 'default'}}" variant="outline">城市分会活动</t-tag></view>
      </view>
      <view wx:else class="text-[length:23rpx] text-muted">当前活动按已授权范围管理。</view>
      <picker wx:if="{{draft.scopeType === 'BRANCH' && branches.length}}" class="mt-3" mode="selector" disabled="{{!canSelectBranch}}" range="{{branches}}" range-key="name" value="{{branchIndex}}" bindchange="changeBranch">
        <view class="box-border flex min-h-[80rpx] max-w-full items-center justify-between rounded-[12rpx] bg-panel-raised px-3 text-[length:24rpx]">
          <text>{{branchIndex >= 0 ? branches[branchIndex].name : '选择城市分会'}}</text>
          <text class="text-muted">选择</text>
        </view>
      </picker>
      <view wx:elif="{{draft.scopeType === 'BRANCH'}}" class="mt-3 text-[length:23rpx] text-danger">当前没有可管理的城市分会。</view>
    </view>

    <view class="rounded-[16rpx] bg-panel p-4">
      <view class="mb-3 text-[length:27rpx] font-semibold">活动时间</view>
      <view class="grid grid-cols-2 gap-3">
        <picker mode="date" value="{{startsDate}}" bindchange="changeDateTimePart" data-field="startsDate"><view class="box-border min-h-[80rpx] rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:23rpx]"><view class="text-muted">开始日期</view><view class="mt-1">{{startsDate}}</view></view></picker>
        <picker mode="time" value="{{startsTime}}" bindchange="changeDateTimePart" data-field="startsTime"><view class="box-border min-h-[80rpx] rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:23rpx]"><view class="text-muted">开始时间</view><view class="mt-1">{{startsTime}}</view></view></picker>
        <picker mode="date" value="{{endsDate}}" bindchange="changeDateTimePart" data-field="endsDate"><view class="box-border min-h-[80rpx] rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:23rpx]"><view class="text-muted">结束日期</view><view class="mt-1">{{endsDate}}</view></view></picker>
        <picker mode="time" value="{{endsTime}}" bindchange="changeDateTimePart" data-field="endsTime"><view class="box-border min-h-[80rpx] rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:23rpx]"><view class="text-muted">结束时间</view><view class="mt-1">{{endsTime}}</view></view></picker>
      </view>
      <view class="mt-4 flex min-h-[72rpx] items-center justify-between"><view class="text-[length:23rpx]">设置报名截止时间</view><t-switch value="{{registrationDeadlineEnabled}}" data-field="registrationDeadlineEnabled" bind:change="toggleDeadline" /></view>
      <view wx:if="{{registrationDeadlineEnabled}}" class="grid grid-cols-2 gap-3">
        <picker mode="date" value="{{registrationDeadlineDate}}" bindchange="changeDateTimePart" data-field="registrationDeadlineDate"><view class="box-border min-h-[72rpx] rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:22rpx]">{{registrationDeadlineDate}}</view></picker>
        <picker mode="time" value="{{registrationDeadlineTime}}" bindchange="changeDateTimePart" data-field="registrationDeadlineTime"><view class="box-border min-h-[72rpx] rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:22rpx]">{{registrationDeadlineTime}}</view></picker>
      </view>
      <view class="mt-3 flex min-h-[72rpx] items-center justify-between"><view class="text-[length:23rpx]">设置取消报名截止时间</view><t-switch value="{{cancellationDeadlineEnabled}}" data-field="cancellationDeadlineEnabled" bind:change="toggleDeadline" /></view>
      <view wx:if="{{cancellationDeadlineEnabled}}" class="grid grid-cols-2 gap-3">
        <picker mode="date" value="{{cancellationDeadlineDate}}" bindchange="changeDateTimePart" data-field="cancellationDeadlineDate"><view class="box-border min-h-[72rpx] rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:22rpx]">{{cancellationDeadlineDate}}</view></picker>
        <picker mode="time" value="{{cancellationDeadlineTime}}" bindchange="changeDateTimePart" data-field="cancellationDeadlineTime"><view class="box-border min-h-[72rpx] rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:22rpx]">{{cancellationDeadlineTime}}</view></picker>
      </view>
    </view>

    <view class="rounded-[16rpx] bg-panel p-4">
      <view class="mb-3 text-[length:27rpx] font-semibold">活动形式</view>
      <view class="flex flex-wrap gap-2"><view class="flex min-h-[88rpx] items-center" aria-role="radio" aria-checked="{{draft.eventMode === 'OFFLINE'}}" data-field="eventMode" data-value="OFFLINE" bind:tap="choose"><t-tag theme="{{draft.eventMode === 'OFFLINE' ? 'primary' : 'default'}}" variant="outline">线下</t-tag></view><view class="flex min-h-[88rpx] items-center" aria-role="radio" aria-checked="{{draft.eventMode === 'ONLINE'}}" data-field="eventMode" data-value="ONLINE" bind:tap="choose"><t-tag theme="{{draft.eventMode === 'ONLINE' ? 'primary' : 'default'}}" variant="outline">线上</t-tag></view><view class="flex min-h-[88rpx] items-center" aria-role="radio" aria-checked="{{draft.eventMode === 'HYBRID'}}" data-field="eventMode" data-value="HYBRID" bind:tap="choose"><t-tag theme="{{draft.eventMode === 'HYBRID' ? 'primary' : 'default'}}" variant="outline">线上与线下</t-tag></view></view>
      <block wx:if="{{draft.eventMode !== 'ONLINE'}}">
        <view class="mb-2 mt-4 text-[length:23rpx] text-muted">场地名称</view><t-input class="box-border max-w-full" value="{{draft.venueName}}" maxlength="200" data-field="venueName" bind:change="updateField" />
        <view class="mb-2 mt-4 text-[length:23rpx] text-muted">详细地址</view><t-input class="box-border max-w-full" value="{{draft.address}}" maxlength="500" data-field="address" bind:change="updateField" />
        <view class="mt-3"><t-button block variant="outline" disabled="{{saving || cancelBusy}}" bind:tap="chooseVenue">从地图选择地点</t-button></view>
        <view class="mb-2 mt-4 text-[length:23rpx] text-muted">城市</view><t-input class="box-border max-w-full" value="{{draft.cityName}}" maxlength="100" data-field="cityName" bind:change="updateField" />
      </block>
      <block wx:if="{{draft.eventMode !== 'OFFLINE'}}">
        <view class="mb-2 mt-4 text-[length:23rpx] text-muted">线上活动地址</view><t-input class="box-border max-w-full" value="{{draft.onlineUrl}}" maxlength="1000" placeholder="https://" data-field="onlineUrl" bind:change="updateField" />
      </block>
    </view>

    <view class="rounded-[16rpx] bg-panel p-4">
      <view class="mb-3 text-[length:27rpx] font-semibold">报名设置</view>
      <view class="mb-2 text-[length:23rpx] text-muted">参与方式</view>
      <view class="flex flex-wrap gap-2"><view class="flex min-h-[88rpx] items-center" aria-role="radio" aria-checked="{{draft.accessType === 'FREE'}}" data-field="accessType" data-value="FREE" bind:tap="choose"><t-tag theme="{{draft.accessType === 'FREE' ? 'primary' : 'default'}}" variant="outline">免费报名</t-tag></view><view class="flex min-h-[88rpx] items-center" aria-role="radio" aria-checked="{{draft.accessType === 'MEMBER_INCLUDED'}}" data-field="accessType" data-value="MEMBER_INCLUDED" bind:tap="choose"><t-tag theme="{{draft.accessType === 'MEMBER_INCLUDED' ? 'primary' : 'default'}}" variant="outline">玩家权益包含</t-tag></view><view class="flex min-h-[88rpx] items-center" aria-role="radio" aria-checked="{{draft.accessType === 'PAID'}}" data-field="accessType" data-value="PAID" bind:tap="choose"><t-tag theme="{{draft.accessType === 'PAID' ? 'primary' : 'default'}}" variant="outline">付费报名</t-tag></view></view>
      <view wx:if="{{draft.accessType === 'PAID'}}">
        <view class="mb-2 mt-4 text-[length:23rpx] text-muted">报名价格（元）</view><t-input class="box-border max-w-full" type="digit" value="{{draft.priceYuan}}" data-field="priceYuan" bind:change="updateField" />
        <view class="mt-2 text-[length:22rpx] text-muted">付费报名在支付完成后自动确认。</view>
      </view>
      <view wx:else>
        <view class="mb-2 mt-4 text-[length:23rpx] text-muted">确认方式</view>
        <view class="flex flex-wrap gap-2"><view class="flex min-h-[88rpx] items-center" aria-role="radio" aria-checked="{{draft.registrationPolicy === 'AUTO'}}" data-field="registrationPolicy" data-value="AUTO" bind:tap="choose"><t-tag theme="{{draft.registrationPolicy === 'AUTO' ? 'primary' : 'default'}}" variant="outline">自动确认</t-tag></view><view class="flex min-h-[88rpx] items-center" aria-role="radio" aria-checked="{{draft.registrationPolicy === 'APPROVAL'}}" data-field="registrationPolicy" data-value="APPROVAL" bind:tap="choose"><t-tag theme="{{draft.registrationPolicy === 'APPROVAL' ? 'primary' : 'default'}}" variant="outline">人工确认</t-tag></view></view>
      </view>
      <view class="mb-2 mt-4 text-[length:23rpx] text-muted">名额上限</view><t-input class="box-border max-w-full" type="number" value="{{draft.capacity}}" placeholder="不填写表示不限额" data-field="capacity" bind:change="updateField" />
      <view wx:if="{{draft.accessType !== 'PAID'}}" class="mt-3 flex min-h-[72rpx] items-center justify-between"><view class="text-[length:23rpx]">名额满后启用候补</view><t-switch value="{{draft.waitlistEnabled}}" bind:change="toggleWaitlist" /></view>
    </view>

    <view class="rounded-[16rpx] bg-panel p-4">
      <view class="mb-3 text-[length:27rpx] font-semibold">活动相册</view>
      <view class="flex min-h-[72rpx] items-center justify-between"><view class="text-[length:23rpx]">开放活动相册</view><t-switch value="{{draft.albumEnabled}}" bind:change="toggleAlbum" /></view>
      <view wx:if="{{draft.albumEnabled}}">
        <view class="mb-2 mt-4 text-[length:23rpx] text-muted">照片发布方式</view>
        <view class="flex flex-wrap gap-2"><view class="flex min-h-[88rpx] items-center" aria-role="radio" aria-checked="{{draft.albumSubmissionPolicy === 'REVIEW'}}" data-field="albumSubmissionPolicy" data-value="REVIEW" bind:tap="choose"><t-tag theme="{{draft.albumSubmissionPolicy === 'REVIEW' ? 'primary' : 'default'}}" variant="outline">审核后发布</t-tag></view><view class="flex min-h-[88rpx] items-center" aria-role="radio" aria-checked="{{draft.albumSubmissionPolicy === 'AUTO'}}" data-field="albumSubmissionPolicy" data-value="AUTO" bind:tap="choose"><t-tag theme="{{draft.albumSubmissionPolicy === 'AUTO' ? 'primary' : 'default'}}" variant="outline">自动发布</t-tag></view></view>
      </view>
    </view>

    <t-button block theme="primary" loading="{{saving}}" disabled="{{coverUploading || conflict || eventStatus === 'CANCELLED' || eventStatus === 'ENDED'}}" bind:tap="save">保存活动</t-button>
    <t-button wx:if="{{eventId && eventStatus !== 'CANCELLED' && eventStatus !== 'ENDED'}}" block variant="outline" theme="danger" disabled="{{saving || cancelBusy || conflict}}" bind:tap="openCancelDialog">取消活动</t-button>
    <view wx:if="{{cancelDialogVisible && !cancelConflict}}" class="rounded-[16rpx] bg-panel p-4">
      <view class="text-[length:27rpx] font-semibold">取消活动</view>
      <view class="mb-2 mt-4 text-[length:23rpx] text-muted">取消原因（必填）</view>
      <t-textarea class="box-border max-w-full" value="{{cancelReason}}" maxlength="300" autosize placeholder="填写取消原因" bind:change="updateCancelReason" />
      <view class="mt-4 grid grid-cols-2 gap-3"><t-button block variant="outline" disabled="{{cancelBusy}}" bind:tap="closeCancelDialog">暂不取消</t-button><t-button block theme="danger" loading="{{cancelBusy}}" bind:tap="confirmCancelEvent">确认取消</t-button></view>
    </view>
    <view wx:if="{{message}}" class="rounded-[12rpx] bg-panel px-4 py-3 text-[length:23rpx] text-danger">{{message}}</view>
  </view>
  <app-page-exit />
</view>
