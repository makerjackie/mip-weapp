<view id="admin-badges-page" class="mip-admin-page mip-admin-workspace-page min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-5 text-ink">
  <mip-admin-workspace-nav />
  <view class="text-[length:40rpx] font-bold">勋章管理</view>
  <view class="mt-2 text-[length:23rpx] text-muted">维护勋章目录并管理用户获授记录。</view>

  <view wx:if="{{state === 'loading'}}" class="mt-5 rounded-[16rpx] bg-panel px-5 py-6"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-5"><app-empty-state title="没有勋章管理权限" description="当前账号不能管理勋章。" /></view>
  <view wx:elif="{{state === 'error' || state === 'conflict'}}" class="mt-5"><app-empty-state title="暂时无法加载勋章" description="{{message}}" action-text="重新加载" bind:action="loadPage" /></view>
  <block wx:else>
    <view wx:if="{{canManage}}" class="mt-5 rounded-[16rpx] bg-panel px-4 py-5">
      <view class="text-[length:28rpx] font-semibold">{{editorId ? '编辑勋章' : '新增勋章'}}</view>
      <view class="mip-admin-section-grid mt-3 grid gap-2">
        <view class="grid grid-cols-2 gap-2"><t-input value="{{key}}" placeholder="稳定标识" data-field="key" bind:change="updateField" /><t-input value="{{name}}" placeholder="名称" data-field="name" bind:change="updateField" /></view>
        <view><t-textarea value="{{description}}" placeholder="说明" maxlength="500" data-field="description" bind:change="updateField" /></view>
        <view class="grid grid-cols-2 gap-2"><t-input value="{{iconName}}" placeholder="TDesign 图标名（可选）" data-field="iconName" bind:change="updateField" /><t-input type="number" value="{{sortOrder}}" placeholder="显示顺序" data-field="sortOrder" bind:change="updateField" /></view>
        <view><t-input value="{{imageUrl}}" placeholder="正式图片地址（可后续替换）" data-field="imageUrl" bind:change="updateField" /></view>
        <view><view class="text-[length:22rpx] text-muted">占位形状</view><view class="mt-1 flex flex-wrap gap-2"><t-tag variant="outline" theme="{{placeholderShape === 'CIRCLE' ? 'primary' : 'default'}}" data-value="CIRCLE" bind:tap="chooseShape">圆形</t-tag><t-tag variant="outline" theme="{{placeholderShape === 'DIAMOND' ? 'primary' : 'default'}}" data-value="DIAMOND" bind:tap="chooseShape">菱形</t-tag><t-tag variant="outline" theme="{{placeholderShape === 'HEXAGON' ? 'primary' : 'default'}}" data-value="HEXAGON" bind:tap="chooseShape">六边形</t-tag></view></view>
        <view><view class="text-[length:22rpx] text-muted">状态</view><view class="mt-1 flex flex-wrap gap-2"><t-tag variant="outline" theme="{{status === 'DRAFT' ? 'primary' : 'default'}}" data-value="DRAFT" bind:tap="chooseStatus">草稿</t-tag><t-tag variant="outline" theme="{{status === 'ACTIVE' ? 'primary' : 'default'}}" data-value="ACTIVE" bind:tap="chooseStatus">启用</t-tag><t-tag variant="outline" theme="{{status === 'INACTIVE' ? 'primary' : 'default'}}" data-value="INACTIVE" bind:tap="chooseStatus">停用</t-tag></view></view>
        <view class="mip-admin-span-wide grid grid-cols-2 gap-2"><t-button block variant="outline" bind:tap="resetEditor">清空</t-button><t-button block theme="primary" loading="{{saving}}" bind:tap="saveBadge">保存</t-button></view>
      </view>
    </view>

    <view class="mt-6 text-[length:30rpx] font-semibold">勋章目录</view>
    <view wx:if="{{badges.length === 0}}" class="mt-3"><app-empty-state title="暂无勋章" description="可以先新增测试勋章，正式图片后续替换。" /></view>
    <view wx:else class="mip-admin-card-list mt-3 flex flex-col gap-3"><view wx:for="{{badges}}" wx:key="id" class="min-h-[112rpx] rounded-[16rpx] bg-panel px-4 py-4" data-id="{{item.id}}" bind:tap="editBadge"><view class="flex items-start justify-between gap-3"><view class="min-w-0 flex-1"><view class="truncate text-[length:27rpx] font-semibold">{{item.name}}</view><view class="mt-1 text-[length:20rpx] text-muted">{{item.key}} · 顺序 {{item.sortOrder}}</view><view class="mt-2 line-clamp-2 text-[length:22rpx] text-muted">{{item.description || '暂无说明'}}</view></view><t-tag variant="outline">{{item.statusText}}</t-tag></view></view></view>

    <view wx:if="{{canManage}}" class="mt-6 rounded-[16rpx] bg-panel px-4 py-5">
      <view class="text-[length:28rpx] font-semibold">授予勋章</view>
      <view class="mt-3"><t-input value="{{awardUserId}}" placeholder="用户 ID" data-field="awardUserId" bind:change="updateField" /></view>
      <view class="mt-3 flex flex-wrap gap-2"><block wx:for="{{badges}}" wx:key="id"><t-tag wx:if="{{item.status === 'ACTIVE'}}" variant="outline" theme="{{awardBadgeId === item.id ? 'primary' : 'default'}}" data-id="{{item.id}}" bind:tap="chooseAwardBadge">{{item.name}}</t-tag></block></view>
      <view class="mt-3"><t-textarea value="{{awardReason}}" placeholder="授予原因" maxlength="300" data-field="awardReason" bind:change="updateField" /></view>
      <view class="mt-4"><t-button block theme="primary" loading="{{saving}}" bind:tap="grantBadge">确认授予</t-button></view>
    </view>

    <view class="mt-6 text-[length:30rpx] font-semibold">获授记录</view>
    <view class="mt-3 flex gap-2"><view class="min-w-0 flex-1"><t-input id="badge-award-query" value="{{awardQuery}}" placeholder="昵称、勋章或用户 ID" data-field="awardQuery" bind:change="updateField" /></view><t-button theme="primary" bind:tap="searchAwards">查询</t-button></view>
    <view wx:if="{{awards.length === 0}}" class="mt-3"><app-empty-state title="暂无获授记录" description="授予后会显示在这里。" /></view>
    <view wx:else class="mip-admin-card-list mt-3 flex flex-col gap-3"><view wx:for="{{awards}}" wx:key="id" class="rounded-[16rpx] bg-panel px-4 py-4"><view class="flex items-start justify-between gap-3"><view><view class="text-[length:26rpx] font-semibold">{{item.nickname}} · {{item.badgeName}}</view><view class="mt-1 text-[length:20rpx] text-muted">{{item.awardReason}}</view><view wx:if="{{item.equipped}}" class="mt-2 text-[length:20rpx] text-brand">佩戴中</view></view><t-tag variant="outline">{{item.status === 'ACTIVE' ? '有效' : '已撤销'}}</t-tag></view><view wx:if="{{item.status === 'ACTIVE'}}" class="mt-3"><t-button block variant="outline" theme="danger" data-id="{{item.id}}" bind:tap="revokeBadge">撤销</t-button></view></view></view>
    <view wx:if="{{message}}" class="mt-4 rounded-[12rpx] bg-panel-raised px-4 py-3 text-[length:22rpx] text-danger">{{message}}</view>
  </block>
  <app-page-exit />
</view>
