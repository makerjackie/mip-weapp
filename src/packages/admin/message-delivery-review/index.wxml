<view id="admin-message-delivery-review-page" class="mip-admin-page mip-admin-workspace-page min-h-screen bg-canvas px-6 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-7 text-ink">
  <mip-admin-workspace-nav />
  <view class="flex items-start justify-between gap-3">
    <view class="min-w-0 flex-1"><view class="text-[length:40rpx] font-bold">消息投递复核明细</view><view class="mt-2 text-[length:23rpx] text-muted">查看当前业务事实和复核租约</view></view>
    <t-button class="min-h-[88rpx]" size="large" variant="outline" bind:tap="backToList">返回列表</t-button>
  </view>

  <view wx:if="{{state === 'loading'}}" class="mt-6 rounded-[16rpx] bg-panel px-5 py-6"><t-skeleton row-col="{{[1,1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error' || state === 'conflict'}}" class="mt-6"><app-empty-state title="暂时无法加载投递复核明细" description="{{message}}" action-text="重新加载" bind:action="retryLoad" /></view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-6"><app-empty-state title="没有投递复核权限" description="当前账号不能查看投递复核明细。" /></view>
  <block wx:elif="{{item}}">
    <view class="mip-admin-section-grid mt-5 grid gap-4">
      <view class="rounded-[16rpx] bg-panel px-4 py-4">
        <view class="flex items-start justify-between gap-3"><view class="min-w-0 flex-1"><view class="text-[length:30rpx] font-semibold">{{item.sourceText}}</view><view class="mt-2 break-all text-[length:21rpx] text-muted">来源标识：{{item.resourceRef.id}}</view></view><t-tag variant="outline" theme="{{item.classification === 'MANUAL_REVIEW' || item.classification === 'TERMINAL_FAILURE' ? 'danger' : item.classification === 'SUCCEEDED' ? 'success' : 'warning'}}">{{item.classificationText}}</t-tag></view>
        <view class="mt-4 grid grid-cols-2 gap-3 text-[length:23rpx]"><view><view class="text-muted">复核状态</view><view class="mt-1">{{item.workflowText}}</view></view><view><view class="text-muted">当前业务状态</view><view class="mt-1">{{item.statusText}}</view></view><view><view class="text-muted">处理尝试</view><view class="mt-1">{{item.sourceState.attempts}} 次</view></view><view><view class="text-muted">最后结论</view><view class="mt-1">{{item.outcomeText}}</view></view><view><view class="text-muted">重试处理</view><view class="mt-1">{{item.retryText}}</view></view></view>
      </view>

      <view class="rounded-[16rpx] bg-panel px-4 py-4 text-[length:23rpx]"><view class="text-[length:27rpx] font-semibold">证据版本</view><view class="mt-3 break-all font-mono text-[length:21rpx] text-muted">{{item.evidenceRevision}}</view><view class="mt-3 flex items-center justify-between gap-3"><text class="text-muted">复核版本</text><text>{{item.workflow.version}}</text></view><view class="mt-2 flex items-center justify-between gap-3"><text class="text-muted">发生时间</text><text>{{item.occurredText}}</text></view></view>

      <view class="rounded-[16rpx] bg-panel px-4 py-4 text-[length:23rpx]"><view class="text-[length:27rpx] font-semibold">业务证据</view><block wx:if="{{item.resourceRef.type === 'CAMPAIGN_DISPATCH'}}"><view class="mt-3 flex items-center justify-between gap-3"><text class="text-muted">消息活动</text><text class="min-w-0 max-w-[60%] break-all text-right">{{item.evidence.campaignName}}</text></view><view class="mt-2 flex items-center justify-between gap-3"><text class="text-muted">活动状态</text><text>{{item.evidence.campaignStatus}}</text></view><view class="mt-2 flex items-center justify-between gap-3"><text class="text-muted">派发记录</text><text>{{item.evidence.submittedCount}} / {{item.evidence.recipientCount}}</text></view><view class="mt-2 flex items-center justify-between gap-3"><text class="text-muted">投递队列覆盖</text><text>{{item.evidence.outboxCoveredCount}} / {{item.evidence.outboxCount}}</text></view></block><block wx:else><view class="mt-3 flex items-center justify-between gap-3"><text class="text-muted">渠道</text><text>{{item.evidence.channel}}</text></view><view class="mt-2 flex items-center justify-between gap-3"><text class="text-muted">预留授权</text><text>{{item.evidence.reservedGrantCount}} 条</text></view><view class="mt-2 flex items-center justify-between gap-3"><text class="text-muted">业务目标</text><text>{{item.evidenceTargetText}}</text></view></block><view wx:if="{{item.sourceState.lastErrorCode}}" class="mt-3 text-danger">错误码：{{item.sourceState.lastErrorCode}}</view></view>

      <view class="rounded-[16rpx] bg-panel px-4 py-4 text-[length:23rpx]"><view class="text-[length:27rpx] font-semibold">投递租约</view><view class="mt-3 flex items-center justify-between gap-3"><text class="text-muted">可处理时间</text><text>{{item.availableText}}</text></view><view class="mt-2 flex items-center justify-between gap-3"><text class="text-muted">业务租约到期</text><text>{{item.sourceLeaseText}}</text></view><view class="mt-2 flex items-center justify-between gap-3"><text class="text-muted">送达时间</text><text>{{item.deliveredText}}</text></view><view class="mt-3 border-t border-line pt-3"><view class="text-muted">认领租约</view><view class="mt-1">{{item.claimText}}</view></view></view>

      <view wx:if="{{item.workflow.resolution}}" class="mip-admin-span-wide rounded-[16rpx] bg-panel px-4 py-4 text-[length:23rpx]"><view class="text-[length:27rpx] font-semibold">处理结果</view><view class="mt-3 leading-[1.7] text-muted">{{item.resolutionText}}</view><view wx:if="{{item.workflow.resolution.evidenceReference}}" class="mt-2 break-all text-muted">证据引用：{{item.workflow.resolution.evidenceReference}}</view></view>
    </view>

    <view class="mip-admin-span-wide mt-5 rounded-[16rpx] border border-line bg-panel px-4 py-4"><view class="text-[length:27rpx] font-semibold">可执行动作</view><view wx:if="{{item.workflow.status !== 'RESOLVED'}}" class="mt-2 text-[length:22rpx] leading-[1.7] text-muted">核对只读取当前持久化事实，不会重新发送消息；结果未知时不能标记为已送达。</view><view wx:if="{{item.actions.canResolve}}" class="mt-4"><textarea class="box-border min-h-[144rpx] w-full rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:24rpx]" maxlength="500" placeholder="{{item.classification === 'MANUAL_REVIEW' ? '处理说明（必填）' : '处理说明（选填）'}}" value="{{resolutionNote}}" bind:input="updateResolutionNote" /><input class="mt-3 box-border h-[76rpx] w-full rounded-[12rpx] bg-panel-raised px-3 text-[length:23rpx]" maxlength="300" placeholder="证据引用（选填）" value="{{evidenceReference}}" bind:input="updateEvidenceReference" /></view><view class="mt-4 grid grid-cols-2 gap-2"><t-button wx:if="{{item.actions.canClaim}}" class="min-h-[88rpx]" block size="large" theme="primary" loading="{{busyAction === 'claim'}}" disabled="{{busyAction !== ''}}" bind:tap="claimReview">认领复核</t-button><t-button wx:if="{{item.actions.canReconcile}}" class="min-h-[88rpx]" block size="large" theme="primary" loading="{{busyAction === 'reconcile'}}" disabled="{{busyAction !== ''}}" bind:tap="reconcileReview">核对投递状态</t-button><t-button wx:if="{{item.actions.canResolve}}" class="min-h-[88rpx]" block size="large" variant="outline" disabled="{{busyAction !== ''}}" loading="{{busyAction === 'resolve'}}" bind:tap="resolveReview">{{item.classification === 'MANUAL_REVIEW' ? '确认未知结果，不重放' : '接受终止结果'}}</t-button></view><view wx:if="{{!item.actions.canClaim && !item.actions.canReconcile && !item.actions.canResolve && item.workflow.status !== 'RESOLVED'}}" class="mt-3 text-[length:22rpx] text-muted">当前没有可执行动作。</view><view wx:if="{{message}}" class="mt-3 rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:23rpx] text-danger">{{message}}</view></view>
  </block>
  <app-page-exit />
</view>
