<view id="admin-payment-attempts-page" class="mip-admin-page mip-admin-workspace-page min-h-screen bg-canvas px-6 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-7 text-ink">
  <mip-admin-workspace-nav />
  <view class="text-[length:40rpx] font-bold">支付尝试记录</view>
  <view class="mt-2 text-[length:23rpx] text-muted">按支付渠道、状态和订单事实查看支付尝试，不展示 provider 原始响应。</view>
  <view class="mip-admin-filter-grid mt-5 grid gap-3 rounded-[16rpx] bg-panel p-3">
    <view class="mip-admin-filter-wide"><t-input class="box-border max-w-full" value="{{query}}" placeholder="搜索昵称、玩家编号或订单号" bind:change="updateQuery" bind:enter="applyFilters" /><view class="mt-3"><t-button block size="small" variant="outline" bind:tap="applyFilters">查询</t-button></view></view>
    <view class="grid grid-cols-2 gap-2">
      <picker range="{{providerOptions}}" range-key="label" value="{{providerIndex}}" bindchange="changeProvider"><view class="flex min-h-[88rpx] items-center justify-between rounded-[12rpx] bg-panel-raised px-3 text-[length:22rpx]"><text class="text-muted">支付渠道</text><text>{{providerOptions[providerIndex].label}}</text></view></picker>
      <picker range="{{statusOptions}}" range-key="label" value="{{statusIndex}}" bindchange="changeStatus"><view class="flex min-h-[88rpx] items-center justify-between rounded-[12rpx] bg-panel-raised px-3 text-[length:22rpx]"><text class="text-muted">状态</text><text>{{statusOptions[statusIndex].label}}</text></view></picker>
    </view>
    <view class="grid grid-cols-2 gap-2">
      <picker mode="date" value="{{createdFromDate}}" data-field="createdFromDate" bindchange="changeDate"><view class="flex min-h-[88rpx] flex-col justify-center rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:22rpx]"><view class="text-muted">开始日期</view><view class="mt-1">{{createdFromDate || '不限'}}</view></view></picker>
      <picker mode="date" value="{{createdToDate}}" data-field="createdToDate" bindchange="changeDate"><view class="flex min-h-[88rpx] flex-col justify-center rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:22rpx]"><view class="text-muted">结束日期</view><view class="mt-1">{{createdToDate || '不限'}}</view></view></picker>
    </view>
    <view class="grid grid-cols-2 gap-2"><picker range="{{pageSizeOptions}}" value="{{pageSizeIndex}}" bindchange="changePageSize"><view class="flex min-h-[80rpx] items-center justify-between rounded-[12rpx] bg-panel-raised px-3 text-[length:22rpx]"><text class="text-muted">每页</text><text>{{pageSize}} 条</text></view></picker><t-button block size="small" variant="outline" bind:tap="clearDates">清除日期</t-button></view>
  </view>
  <view wx:if="{{state === 'loading'}}" class="mt-6 rounded-[16rpx] bg-panel p-5"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-6"><app-empty-state title="无权访问支付尝试记录" description="当前账号不能查看订单支付事实。" /></view>
  <view wx:elif="{{state === 'error'}}" class="mt-6"><app-empty-state title="暂时无法加载支付尝试记录" description="{{message}}" action-text="重新加载" bind:action="load" /></view>
  <view wx:elif="{{state === 'empty'}}" class="mt-6"><app-empty-state title="暂无支付尝试记录" description="符合筛选条件的记录会显示在这里。" /></view>
  <view wx:else class="mip-admin-record-list mt-5" style="--mip-admin-record-columns: minmax(0, 1.15fr) minmax(0, 1.35fr) minmax(0, 1.3fr) minmax(0, 1.25fr) minmax(0, 1.25fr);">
    <view class="mip-admin-record-header"><view>用户</view><view>订单</view><view>渠道与状态</view><view>金额</view><view>时间</view></view>
    <view wx:for="{{items}}" wx:key="id" class="mip-admin-record-row">
      <view class="mip-admin-record-cell"><view class="mip-admin-record-label">用户</view><view class="font-semibold">{{item.nickname}}</view><view class="mt-1 text-[length:20rpx] text-muted">玩家编号：{{item.playerNumber || '未提供'}}</view></view>
      <view class="mip-admin-record-cell"><view class="mip-admin-record-label">订单</view><view class="break-all font-semibold">{{item.orderNumberMasked}}</view><view class="mt-1 text-[length:21rpx] text-muted">{{item.orderTitle}}</view><view class="mt-1 text-[length:20rpx] text-muted">{{item.orderType === 'MEMBERSHIP' ? '会员订单' : item.orderType === 'EVENT' ? '活动订单' : '内容订单'}}</view></view>
      <view class="mip-admin-record-cell"><view class="mip-admin-record-label">渠道与状态</view><view>{{item.providerText}}</view><view class="mt-2"><t-tag variant="outline" theme="{{item.statusTheme}}">{{item.statusText}}</t-tag></view><view wx:if="{{item.providerPaymentIdMasked}}" class="mt-2 break-all text-[length:20rpx] text-muted">支付标识：{{item.providerPaymentIdMasked}}</view><view wx:if="{{item.requiresAttention}}" class="mt-2 text-[length:20rpx] text-danger">需要关注</view></view>
      <view class="mip-admin-record-cell"><view class="mip-admin-record-label">金额</view><view class="font-semibold">{{item.amountText}}</view></view>
      <view class="mip-admin-record-cell"><view class="mip-admin-record-label">时间</view><view class="text-[length:21rpx] text-muted">创建：{{item.createdText}}</view><view class="mt-1 text-[length:21rpx] text-muted">更新：{{item.updatedText}}</view><view class="mip-admin-record-actions mt-3"><t-button block size="small" variant="outline" data-id="{{item.orderId}}" bind:tap="openOrders">查看订单</t-button></view></view>
    </view>
  </view>
  <view wx:if="{{message && state === 'ready'}}" class="mt-4 rounded-[12rpx] bg-panel px-4 py-3 text-[length:23rpx] text-danger">{{message}}</view>
  <view wx:if="{{nextCursor}}" class="mt-4"><t-button block variant="outline" loading="{{loadingMore}}" bind:tap="loadMore">加载更多</t-button></view>
  <app-page-exit />
</view>
