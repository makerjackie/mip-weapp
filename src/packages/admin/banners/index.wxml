<view id="admin-banners-page" class="min-h-screen bg-canvas px-6 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-7 text-ink">
  <view class="flex items-center justify-between gap-3">
    <view>
      <view class="text-[length:40rpx] font-bold">Banner 管理</view>
      <view class="mt-2 text-[length:23rpx] text-muted">维护图片、跳转地址、顺序和展示状态</view>
    </view>
    <t-button theme="primary" bind:tap="createBanner">新增</t-button>
  </view>

  <view wx:if="{{state === 'loading'}}" class="mt-6 rounded-[16rpx] bg-panel px-5 py-6"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error' || state === 'conflict'}}" class="mt-6"><app-empty-state title="暂时无法加载 Banner" description="{{message}}" action-text="重新加载" bind:action="retryLoad" /></view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-6"><app-empty-state title="没有 Banner 管理权限" description="当前账号不能维护 Banner。" /></view>
  <block wx:else>
    <view class="mt-5 rounded-[16rpx] bg-panel px-4 py-4">
      <view class="flex items-center gap-2"><view class="min-w-0 flex-1"><t-input value="{{query}}" placeholder="搜索名称或跳转地址" bind:change="updateQuery" /></view><t-button theme="default" bind:tap="search">搜索</t-button></view>
      <view class="mt-3 grid grid-cols-4 gap-2">
        <view class="flex min-h-[88rpx] items-center justify-center rounded-[12rpx] text-[length:22rpx] {{!statusFilter ? 'bg-brand text-on-brand' : 'bg-panel-raised text-muted'}}" data-status="" bind:tap="chooseStatus">全部</view>
        <view class="flex min-h-[88rpx] items-center justify-center rounded-[12rpx] text-[length:22rpx] {{statusFilter === 'ACTIVE' ? 'bg-brand text-on-brand' : 'bg-panel-raised text-muted'}}" data-status="ACTIVE" bind:tap="chooseStatus">已启用</view>
        <view class="flex min-h-[88rpx] items-center justify-center rounded-[12rpx] text-[length:22rpx] {{statusFilter === 'INACTIVE' ? 'bg-brand text-on-brand' : 'bg-panel-raised text-muted'}}" data-status="INACTIVE" bind:tap="chooseStatus">已停用</view>
        <view class="flex min-h-[88rpx] items-center justify-center rounded-[12rpx] text-[length:22rpx] {{statusFilter === 'DELETED' ? 'bg-brand text-on-brand' : 'bg-panel-raised text-muted'}}" data-status="DELETED" bind:tap="chooseStatus">已删除</view>
      </view>
    </view>

    <view wx:if="{{!items.length}}" class="mt-6"><app-empty-state title="暂无 Banner" description="当前筛选条件下没有记录。" action-text="新增 Banner" bind:action="createBanner" /></view>
    <view wx:else class="mt-5 flex flex-col gap-4">
      <view wx:for="{{items}}" wx:key="id" class="overflow-hidden rounded-[16rpx] bg-panel">
        <image class="h-[240rpx] w-full bg-panel-raised" mode="aspectFill" src="{{item.imageUrl}}" aria-label="{{item.accessibilityLabel}}" />
        <view class="px-4 py-4">
          <view class="flex items-start justify-between gap-3"><view class="min-w-0 flex-1 text-[length:28rpx] font-semibold">{{item.title}}</view><view class="shrink-0 rounded-full bg-panel-raised px-3 py-1 text-[length:21rpx] text-muted">{{item.statusLabel}}</view></view>
          <view class="mt-2 text-[length:22rpx] text-muted">{{item.targetLabel}} · {{item.dimensionsLabel}}</view>
          <view class="mt-2 break-all text-[length:21rpx] leading-5 text-muted">{{item.targetValue}}</view>
          <view wx:if="{{item.status !== 'DELETED'}}" class="mt-4 grid grid-cols-2 gap-2">
            <view class="flex min-h-[88rpx] items-center justify-center rounded-[12rpx] bg-panel-raised text-[length:23rpx]" data-banner-id="{{item.id}}" bind:tap="editBanner">编辑</view>
            <view class="flex min-h-[88rpx] items-center justify-center rounded-[12rpx] bg-panel-raised text-[length:23rpx]" data-banner-id="{{item.id}}" bind:tap="toggleStatus">{{item.status === 'ACTIVE' ? '停用' : '启用'}}</view>
            <view class="flex min-h-[88rpx] items-center justify-center rounded-[12rpx] bg-panel-raised text-[length:23rpx]" data-banner-id="{{item.id}}" data-direction="UP" bind:tap="moveBanner">上移</view>
            <view class="flex min-h-[88rpx] items-center justify-center rounded-[12rpx] bg-panel-raised text-[length:23rpx]" data-banner-id="{{item.id}}" data-direction="DOWN" bind:tap="moveBanner">下移</view>
            <view class="col-span-2 flex min-h-[88rpx] items-center justify-center rounded-[12rpx] border border-danger text-[length:23rpx] text-danger" data-banner-id="{{item.id}}" bind:tap="deleteBanner">删除</view>
          </view>
          <view wx:if="{{mutatingId === item.id}}" class="mt-3 text-[length:22rpx] text-muted">正在处理</view>
        </view>
      </view>
      <view wx:if="{{truncated}}" class="rounded-[12rpx] bg-panel px-4 py-3 text-[length:22rpx] text-muted">当前仅显示前 100 条记录，请使用筛选缩小范围。</view>
    </view>
  </block>
  <view wx:if="{{message && state === 'ready'}}" class="mt-4 rounded-[12rpx] bg-panel px-4 py-3 text-[length:23rpx] text-danger">{{message}}</view>
  <app-page-exit />
</view>
