<view id="admin-exports-page" class="min-h-screen bg-canvas px-6 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-7 text-ink">
  <view class="text-[length:40rpx] font-bold">导出与现场资料</view>
  <view class="mt-2 text-[length:23rpx] text-muted">导出文件仅限已授权的运营工作，有效期较短。</view>

  <view wx:if="{{state === 'loading'}}" class="mt-6 rounded-[16rpx] bg-panel p-5">
    <t-skeleton row-col="{{[1,1]}}" theme="paragraph" animation="gradient" loading />
  </view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-6">
    <app-empty-state title="没有导出权限" description="当前活动角色只能在线完成已授权任务。" />
  </view>
  <view wx:elif="{{state === 'error' || state === 'conflict'}}" class="mt-6">
    <app-empty-state title="暂时无法加载" description="{{message}}" action-text="重新加载" bind:action="loadCapabilities" />
  </view>
  <view wx:else class="mt-6 flex flex-col gap-4">
    <view wx:if="{{pendingState !== 'none'}}" class="rounded-[16rpx] border border-line bg-panel px-5 py-5">
      <view class="text-[length:29rpx] font-semibold">
        {{pendingState === 'checking' ? '正在确认导出' : pendingState === 'conflict' ? '导出状态已变化' : pendingState === 'retry' ? '导出需要重试' : pendingState === 'resumable' ? '有未完成的导出' : '上次导出'}}
      </view>
      <view class="mt-2 text-[length:23rpx] text-muted">{{pendingMessage}}</view>
      <view wx:if="{{pendingFileName}}" class="mt-2 break-all text-[length:21rpx] text-muted">{{pendingFileName}}</view>
      <view wx:if="{{pendingState === 'resumable' || pendingState === 'retry' || pendingState === 'conflict'}}" class="mt-4">
        <view class="grid grid-cols-2 gap-3">
          <t-button block variant="outline" disabled="{{recovering || !!processing}}" bind:tap="discardPendingExport">不再继续</t-button>
          <t-button block theme="primary" loading="{{recovering}}" disabled="{{!!processing}}" bind:tap="resumePendingExport">继续导出</t-button>
        </view>
      </view>
    </view>

    <view class="rounded-[16rpx] bg-panel px-5 py-5">
      <view class="text-[length:29rpx] font-semibold">参与者名单</view>
      <view class="mt-2 text-[length:23rpx] text-muted">{{canPhone ? '包含已授权的联系电话，文件有效期较短。' : '不包含联系电话。'}}</view>
      <view class="mt-4">
        <t-button block theme="primary" loading="{{processing === 'EVENT_ROSTER'}}" disabled="{{recovering}}" data-type="EVENT_ROSTER" bind:tap="createExport">导出参与者名单</t-button>
      </view>
    </view>

    <view class="rounded-[16rpx] bg-panel px-5 py-5">
      <view class="text-[length:29rpx] font-semibold">活动订单</view>
      <view class="mt-2 text-[length:23rpx] text-muted">包含订单金额、支付和退款状态。</view>
      <view class="mt-4">
        <t-button block variant="outline" loading="{{processing === 'EVENT_ORDERS'}}" disabled="{{recovering}}" data-type="EVENT_ORDERS" bind:tap="createExport">导出活动订单</t-button>
      </view>
    </view>

    <view wx:if="{{lastTicketId}}" class="rounded-[16rpx] border border-line bg-panel px-4 py-4">
      <view class="text-[length:24rpx]">导出文件已打开</view>
      <view class="mt-1 text-[length:21rpx] text-muted">{{expiresAt}}</view>
    </view>
  </view>

  <view wx:if="{{message && state === 'ready'}}" class="mt-4 rounded-[12rpx] bg-panel px-4 py-3 text-[length:23rpx] text-danger">{{message}}</view>
  <app-page-exit />
</view>
