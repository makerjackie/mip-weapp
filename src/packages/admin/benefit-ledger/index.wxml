<view id="admin-benefit-ledger-page" class="mip-admin-page mip-admin-workspace-page min-h-screen bg-canvas px-6 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-7 text-ink">
  <mip-admin-workspace-nav />
  <view class="text-[length:40rpx] font-bold">统一权益流水</view>
  <view class="mt-2 text-[length:23rpx] text-muted">聚合会员权益、成长权益和关联订单事实。</view>
  <view class="mip-admin-filter-grid mt-5 grid gap-3 rounded-[16rpx] bg-panel p-3">
    <view class="grid grid-cols-2 gap-2">
      <picker mode="selector" range="{{typeOptions}}" range-key="label" value="{{typeIndex}}" bindchange="changeType"><view class="flex min-h-[88rpx] items-center justify-between rounded-[12rpx] bg-panel-raised px-3 text-[length:22rpx]"><text class="text-muted">权益类型</text><text>{{typeOptions[typeIndex].label}}</text></view></picker>
      <picker mode="selector" range="{{pageSizeOptions}}" value="{{pageSizeIndex}}" bindchange="changePageSize"><view class="flex min-h-[88rpx] items-center justify-between rounded-[12rpx] bg-panel-raised px-3 text-[length:22rpx]"><text class="text-muted">每页</text><text>{{pageSize}} 条</text></view></picker>
    </view>
    <view><t-input value="{{query}}" placeholder="搜索昵称或玩家编号" bind:change="updateQuery" bind:enter="applyFilters" /></view>
    <view class="grid grid-cols-2 gap-2">
      <picker mode="date" value="{{createdFromDate}}" data-field="createdFromDate" bindchange="changeDate"><view class="flex min-h-[88rpx] flex-col justify-center rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:22rpx]"><view class="text-muted">开始日期</view><view class="mt-1">{{createdFromDate || '不限'}}</view></view></picker>
      <picker mode="date" value="{{createdToDate}}" data-field="createdToDate" bindchange="changeDate"><view class="flex min-h-[88rpx] flex-col justify-center rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:22rpx]"><view class="text-muted">结束日期</view><view class="mt-1">{{createdToDate || '不限'}}</view></view></picker>
    </view>
    <view class="grid grid-cols-2 gap-2"><t-button block size="small" variant="outline" bind:tap="clearDates">清除日期</t-button><t-button block size="small" theme="primary" bind:tap="applyFilters">查询</t-button></view>
  </view>
  <view wx:if="{{state === 'loading'}}" class="mt-6 rounded-[16rpx] bg-panel p-5"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-6"><app-empty-state title="无权访问统一权益流水" description="{{message}}" /></view>
  <view wx:elif="{{state === 'error' || state === 'conflict'}}" class="mt-6"><app-empty-state title="暂时无法加载权益流水" description="{{message}}" action-text="重新加载" bind:action="load" /></view>
  <view wx:elif="{{state === 'empty'}}" class="mt-6"><app-empty-state title="暂无权益流水" description="符合筛选条件的记录会显示在这里。" /></view>
  <view wx:else class="mip-admin-record-list mt-5" style="--mip-admin-record-columns: minmax(0, 0.7fr) minmax(0, 1.1fr) minmax(0, 1.6fr) minmax(0, 1.6fr) minmax(0, 1.3fr);">
    <view class="mip-admin-record-header"><view>类型</view><view>成员</view><view>权益</view><view>状态与时间</view><view>关联事实</view></view>
    <view wx:for="{{items}}" wx:key="*this" class="mip-admin-record-row"><view class="mip-admin-record-cell"><view class="mip-admin-record-label text-[length:20rpx] text-muted">类型</view><view class="font-semibold">{{item.typeText}}</view></view><view class="mip-admin-record-cell"><view class="mip-admin-record-label text-[length:20rpx] text-muted">成员</view><view>{{item.nickname}}</view><view class="mt-1 text-[length:20rpx] text-muted">玩家编号：{{item.playerNumber || '未提供'}}</view></view><view class="mip-admin-record-cell"><view class="mip-admin-record-label text-[length:20rpx] text-muted">权益</view><view>{{item.benefitName}}</view><view wx:if="{{item.metric}}" class="mt-1 text-[length:20rpx] text-muted">{{item.metric}} {{item.deltaText}}</view></view><view class="mip-admin-record-cell"><view class="mip-admin-record-label text-[length:20rpx] text-muted">状态与时间</view><view>{{item.statusText}}</view><view class="mt-1 text-[length:20rpx] text-muted">记录：{{item.occurredText}}</view><view wx:if="{{item.startsAt}}" class="mt-1 text-[length:20rpx] text-muted">有效期：{{item.periodText}}</view></view><view class="mip-admin-record-cell"><view class="mip-admin-record-label text-[length:20rpx] text-muted">关联事实</view><view class="text-[length:21rpx] text-muted">{{item.orderText}}</view></view></view>
  </view>
  <view wx:if="{{message && state === 'ready'}}" class="mt-4 rounded-[12rpx] bg-panel px-4 py-3 text-[length:23rpx] text-danger">{{message}}</view>
  <view wx:if="{{nextCursor}}" class="mt-4"><t-button block variant="outline" loading="{{loadingMore}}" bind:tap="loadMore">加载更多</t-button></view>
  <app-page-exit />
</view>
