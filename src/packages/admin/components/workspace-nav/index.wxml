<view class="mip-admin-workspace-nav" wx:if="{{groups.length}}" aria-label="运营导航">
  <view class="mip-admin-workspace-brand">
    <view class="mip-admin-workspace-mark">{{brandMark}}</view>
    <view class="mip-admin-workspace-brand-copy">
      <text class="mip-admin-workspace-product">{{productName}}</text>
      <text class="mip-admin-workspace-subtitle">运营管理</text>
    </view>
  </view>

  <scroll-view class="mip-admin-workspace-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view wx:for="{{groups}}" wx:key="key" class="mip-admin-workspace-group">
      <text class="mip-admin-workspace-group-label">{{item.label}}</text>
      <view
        wx:for="{{item.items}}"
        wx:for-item="navItem"
        wx:key="key"
        class="mip-admin-workspace-link {{navItem.active ? 'mip-admin-workspace-link--active' : ''}}"
        data-active="{{navItem.active ? 'true' : 'false'}}"
        data-route="{{navItem.route}}"
        aria-label="{{navItem.label}}"
        aria-current="{{navItem.active ? 'page' : ''}}"
        role="button"
        hover-class="mip-admin-workspace-link--pressed"
        bind:tap="navigate"
      >
        <text>{{navItem.label}}</text>
      </view>
    </view>
  </scroll-view>
  <scroll-view
    class="mip-admin-workspace-mobile-scroll"
    scroll-x
    scroll-into-view="{{activeItemTarget}}"
    scroll-with-animation
    enhanced
    show-scrollbar="{{false}}"
  >
    <view class="mip-admin-workspace-mobile-links">
      <view
        wx:for="{{groups}}"
        wx:for-item="group"
        wx:key="key"
        class="mip-admin-workspace-mobile-group"
      >
        <view
          id="admin-nav-{{navItem.key}}"
          wx:for="{{group.items}}"
          wx:for-item="navItem"
          wx:key="key"
          class="mip-admin-workspace-link {{navItem.active ? 'mip-admin-workspace-link--active' : ''}}"
          data-route="{{navItem.route}}"
          aria-label="{{navItem.label}}"
          aria-current="{{navItem.active ? 'page' : ''}}"
          role="button"
          hover-class="mip-admin-workspace-link--pressed"
          bind:tap="navigate"
        >
          <text>{{navItem.label}}</text>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
