<t-popup
  visible="{{visible}}"
  placement="{{placement}}"
  prevent-scroll-through
  bind:visible-change="handleVisibleChange"
>
  <view class="mip-admin-responsive-panel" role="dialog" aria-label="{{title}}">
    <view class="mip-admin-responsive-panel__header">
      <view class="mip-admin-responsive-panel__title">{{title}}</view>
      <view
        class="mip-admin-responsive-panel__close"
        role="button"
        aria-label="关闭{{title}}"
        hover-class="mip-admin-responsive-panel__close--pressed"
        bind:tap="handleClose"
      >
        关闭
      </view>
    </view>
    <scroll-view
      class="mip-admin-responsive-panel__body"
      scroll-y
      enhanced
      show-scrollbar="{{false}}"
    >
      <slot />
    </scroll-view>
  </view>
</t-popup>
