.mip-admin-responsive-panel {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  width: 100vw;
  max-width: 100vw;
  max-height: 86vh;
  padding: 32rpx 40rpx calc(env(safe-area-inset-bottom) + 32rpx);
  overflow: hidden;
  color: var(--color-ink, #fff);
  overflow-wrap: anywhere;
  background: var(--color-panel, #202020);
  border-radius: 24rpx 24rpx 0 0;
}

.mip-admin-responsive-panel__header {
  display: flex;
  flex: none;
  gap: 24rpx;
  align-items: center;
  justify-content: space-between;
  min-width: 0;
}

.mip-admin-responsive-panel__title {
  min-width: 0;
  font-size: 32rpx;
  font-weight: 700;
}

.mip-admin-responsive-panel__close {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  min-height: 88rpx;
  padding: 0 16rpx;
  font-size: 22rpx;
  color: var(--color-brand, #fcdf03);
  border-radius: 12rpx;
}

.mip-admin-responsive-panel__close--pressed {
  background: var(--color-panel-raised, #2a2a2a);
}

.mip-admin-responsive-panel__body {
  flex: 1;
  width: 100%;
  min-width: 0;
  min-height: 0;
  max-height: calc(86vh - 120rpx);
}

@media (min-width: 960px) {
  .mip-admin-responsive-panel {
    width: 520px;
    max-width: 100vw;
    height: 100vh;
    max-height: 100vh;
    padding: 24px;
    border-radius: 16px 0 0 16px;
  }

  .mip-admin-responsive-panel__title {
    font-size: 20px;
  }

  .mip-admin-responsive-panel__close {
    min-width: 44px;
    min-height: 44px;
    padding: 0 12px;
    font-size: 14px;
  }

  .mip-admin-responsive-panel__body {
    max-height: none;
  }
}
