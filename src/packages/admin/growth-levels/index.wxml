<view id="admin-growth-levels-page" class="mip-admin-page mip-admin-workspace-page min-h-screen bg-canvas px-6 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-7 text-ink">
  <mip-admin-workspace-nav />
  <view class="text-[length:40rpx] font-bold">成长等级</view><view class="mt-2 text-[length:23rpx] text-muted">等级门槛必须递增，已使用等级可以停用。</view>
  <view class="mt-5 grid grid-cols-2 gap-2"><t-button block variant="outline" bind:tap="openBenefits">权益</t-button><t-button block variant="outline" bind:tap="openRules">奖励规则</t-button><t-button block variant="outline" bind:tap="openEntries">成长流水</t-button><t-button block variant="outline" bind:tap="openTransitions">等级变更记录</t-button><t-button block variant="outline" bind:tap="openBenefitLedger">统一权益流水</t-button></view>
  <view wx:if="{{canConfigure}}" class="mt-5 rounded-[16rpx] bg-panel p-4">
    <view class="text-[length:27rpx] font-semibold">{{editorId ? '编辑等级' : '新增等级'}}</view>
    <view class="mip-admin-section-grid mt-3 grid gap-3">
      <view><t-input value="{{name}}" placeholder="等级名称" data-field="name" bind:change="updateField" /></view><view><t-input value="{{displayBadge}}" placeholder="展示标识" data-field="displayBadge" bind:change="updateField" /></view>
      <view><t-input type="number" value="{{minimumExperience}}" placeholder="经验门槛" data-field="minimumExperience" bind:change="updateField" /></view><view><t-input type="number" value="{{sortOrder}}" placeholder="显示顺序" data-field="sortOrder" bind:change="updateField" /></view>
      <view class="mip-admin-span-wide"><view class="text-[length:23rpx] font-semibold">关联权益</view><view class="mt-1 flex flex-wrap gap-1"><view wx:for="{{benefits}}" wx:key="id" class="flex min-h-[88rpx] items-center" role="checkbox" aria-checked="{{item.selected}}"><t-tag variant="outline" theme="{{item.selected ? 'primary' : 'default'}}" data-id="{{item.id}}" bind:tap="toggleBenefit">{{item.name}}</t-tag></view></view></view>
      <view class="mip-admin-span-wide flex gap-1" role="radiogroup"><view class="flex min-h-[88rpx] items-center" role="radio" aria-checked="{{status === 'DRAFT'}}"><t-tag variant="outline" theme="{{status === 'DRAFT' ? 'primary' : 'default'}}" data-value="DRAFT" bind:tap="chooseStatus">草稿</t-tag></view><view class="flex min-h-[88rpx] items-center" role="radio" aria-checked="{{status === 'ACTIVE'}}"><t-tag variant="outline" theme="{{status === 'ACTIVE' ? 'primary' : 'default'}}" data-value="ACTIVE" bind:tap="chooseStatus">启用</t-tag></view><view class="flex min-h-[88rpx] items-center" role="radio" aria-checked="{{status === 'INACTIVE'}}"><t-tag variant="outline" theme="{{status === 'INACTIVE' ? 'primary' : 'default'}}" data-value="INACTIVE" bind:tap="chooseStatus">停用</t-tag></view></view>
      <view class="mip-admin-span-wide grid grid-cols-2 gap-2"><t-button block variant="outline" bind:tap="resetEditor">清空</t-button><t-button block theme="primary" loading="{{saving}}" bind:tap="save">保存</t-button></view>
    </view>
  </view>
  <view wx:if="{{state === 'loading'}}" class="mt-6 rounded-[16rpx] bg-panel p-5"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error' || state === 'conflict'}}" class="mt-6"><app-empty-state title="暂时无法加载等级" description="{{message}}" action-text="重新加载" bind:action="loadLevels" /></view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-6"><app-empty-state title="没有成长管理权限" description="当前账号不能查看成长配置。" /></view>
  <view wx:elif="{{levels.length === 0}}" class="mt-6"><app-empty-state title="暂无成长等级" description="拥有配置权限的账号可以新增等级。" /></view>
  <view wx:else class="mip-admin-card-list mt-5 flex flex-col gap-3"><view wx:for="{{levels}}" wx:key="id" class="min-h-[112rpx] rounded-[16rpx] bg-panel px-4 py-4" data-id="{{item.id}}" bind:tap="edit"><view class="flex items-start justify-between"><view><view class="text-[length:28rpx] font-semibold">{{item.name}}<text wx:if="{{item.displayBadge}}" class="ml-2 text-[length:21rpx] text-muted">{{item.displayBadge}}</text></view><view class="mt-1 text-[length:22rpx] text-muted">{{item.minimumExperience}} 经验 · 顺序 {{item.sortOrder}}</view></view><t-tag variant="outline" theme="{{item.statusTheme}}">{{item.statusText}}</t-tag></view><view wx:if="{{item.status === 'ACTIVE'}}" class="mt-3 flex items-center justify-between text-[length:22rpx] text-muted" role="button" data-id="{{item.id}}" catch:tap="openLevelUsers"><text>当前人数 {{item.currentUserCount}}</text><text>{{item.currentUserPercentage}}%</text></view><view class="mt-2 text-[length:22rpx] text-muted">权益：{{item.benefitText}}</view></view></view>
  <view wx:if="{{message && state === 'ready'}}" class="mt-4 rounded-[12rpx] bg-panel px-4 py-3 text-[length:23rpx] text-danger">{{message}}</view>
  <app-page-exit />
</view>
