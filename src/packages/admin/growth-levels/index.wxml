<view id="admin-growth-levels-page" class="min-h-screen bg-canvas px-6 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-7 text-ink">
  <view class="text-[length:40rpx] font-bold">成长等级</view><view class="mt-2 text-[length:23rpx] text-muted">等级门槛必须递增，已使用等级只能停用。</view>
  <view class="mt-5 grid grid-cols-2 gap-3"><t-button block variant="outline" bind:tap="openRules">奖励规则</t-button><t-button block variant="outline" bind:tap="openEntries">成长流水</t-button></view>
  <view wx:if="{{canConfigure}}" class="mt-5 rounded-[16rpx] bg-panel p-4"><view class="text-[length:27rpx] font-semibold">{{editorId ? '编辑等级' : '新增等级'}}</view><view class="mt-3"><t-input value="{{levelKey}}" placeholder="稳定等级 key" disabled="{{!!editorId}}" data-field="levelKey" bind:change="updateField" /></view><view class="mt-2"><t-input value="{{name}}" placeholder="等级名称" data-field="name" bind:change="updateField" /></view><view class="mt-2"><t-input type="number" value="{{minimumExperience}}" placeholder="经验门槛" data-field="minimumExperience" bind:change="updateField" /></view><view class="mt-2"><t-input value="{{benefits}}" placeholder="权益，用顿号分隔" data-field="benefits" bind:change="updateField" /></view><view class="mt-3 flex gap-2"><t-tag variant="outline" data-value="DRAFT" bind:tap="chooseStatus">草稿</t-tag><t-tag variant="outline" data-value="ACTIVE" bind:tap="chooseStatus">启用</t-tag><t-tag variant="outline" data-value="INACTIVE" bind:tap="chooseStatus">停用</t-tag></view><view class="mt-4 grid grid-cols-2 gap-2"><t-button block variant="outline" bind:tap="resetEditor">清空</t-button><t-button block theme="primary" loading="{{saving}}" bind:tap="save">保存</t-button></view></view>
  <view wx:if="{{state === 'loading'}}" class="mt-6 rounded-[16rpx] bg-panel p-5"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error' || state === 'conflict'}}" class="mt-6"><app-empty-state title="暂时无法加载等级" description="{{message}}" action-text="重新加载" bind:action="loadLevels" /></view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-6"><app-empty-state title="没有成长管理权限" description="当前账号不能查看成长配置。" /></view>
  <view wx:elif="{{levels.length === 0}}" class="mt-6"><app-empty-state title="暂无成长等级" description="拥有配置权限的账号可以新增等级。" /></view>
  <view wx:else class="mt-5 flex flex-col gap-3"><view wx:for="{{levels}}" wx:key="id" class="rounded-[16rpx] bg-panel px-4 py-4" data-id="{{item.id}}" bind:tap="edit"><view class="flex items-start justify-between"><view><view class="text-[length:28rpx] font-semibold">{{item.name}}</view><view class="mt-1 text-[length:22rpx] text-muted">{{item.levelKey}} · {{item.minimumExperience}} 经验</view></view><t-tag variant="outline">{{item.status}}</t-tag></view><view class="mt-3 text-[length:22rpx] text-muted">权益 {{item.benefits.length}} 项 · 版本 {{item.version}}</view></view></view>
  <view wx:if="{{message && state === 'ready'}}" class="mt-4 rounded-[12rpx] bg-panel px-4 py-3 text-[length:23rpx] text-danger">{{message}}</view>
  <app-page-exit />
</view>
