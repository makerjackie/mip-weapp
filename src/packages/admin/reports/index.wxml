<view id="admin-reports-page" class="min-h-screen bg-canvas px-5 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-5 text-ink">
  <view class="border-b border-ink pb-5"><view class="text-[length:21rpx] font-semibold tracking-[0.16em] text-coral">社区治理</view><view class="mt-2 text-[length:40rpx] font-bold">成员举报</view><view class="mt-2 text-[length:21rpx] text-muted">先核实，再处理；系统不会自动处罚。</view></view>
  <view class="mt-4"><t-tabs value="{{status}}" theme="line" bind:change="changeStatus"><t-tab-panel value="PENDING" label="待处理" /><t-tab-panel value="RESOLVED" label="已处理" /><t-tab-panel value="DISMISSED" label="不处理" /></t-tabs></view>
  <view wx:if="{{state === 'loading'}}" class="mt-5 bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}" class="mt-5"><app-empty-state title="暂时无法加载举报" description="{{message}}" action-text="重新加载" bind:action="loadItems" /></view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-5"><app-empty-state title="没有举报审核权限" description="请联系主理人调整权限。" /></view>
  <view wx:elif="{{!items.length}}" class="mt-5"><app-empty-state title="当前没有相关举报" description="新的举报会按提交时间出现在这里。" /></view>
  <view wx:else class="mt-5 flex flex-col gap-3">
    <view wx:for="{{items}}" wx:key="id" class="rounded-[22rpx] bg-panel px-4 py-4">
      <view class="flex items-start gap-3"><image wx:if="{{item.targetAvatarUrl}}" class="h-[76rpx] w-[76rpx] shrink-0 rounded-full bg-brand-soft" src="{{item.targetAvatarUrl}}" mode="aspectFill" /><view wx:else class="flex h-[76rpx] w-[76rpx] shrink-0 items-center justify-center rounded-full bg-brand-soft text-brand">成员</view><view class="min-w-0 flex-1"><view class="flex items-center justify-between gap-2"><view class="truncate text-[length:25rpx] font-semibold">{{item.targetNickname}}</view><view class="rounded-full bg-[#FFF0E8] px-2 py-1 text-[length:18rpx] text-[#9F4727]">{{item.categoryText}}</view></view><view class="mt-1 text-[length:19rpx] text-muted">{{item.createdText}} · 累计 {{item.priorReportCount}} 次</view></view></view>
      <view class="mt-3 rounded-[16rpx] bg-canvas px-3 py-3 text-[length:22rpx] leading-5 text-muted">{{item.description || '用户未补充说明'}}</view>
      <view wx:if="{{status === 'PENDING'}}" class="mt-3 grid grid-cols-2 gap-2"><t-button block size="small" variant="outline" theme="primary" loading="{{processingId === item.id}}" data-index="{{index}}" data-decision="DISMISS" bind:tap="decide">不作处理</t-button><t-button block size="small" theme="danger" loading="{{processingId === item.id}}" data-index="{{index}}" data-decision="HIDE_PROFILE" bind:tap="decide">暂停展示</t-button></view>
      <view wx:else class="mt-3 text-[length:20rpx] text-muted">处理结果：{{item.resolutionReason || '已完成'}}</view>
    </view>
  </view>
  <view wx:if="{{message && state === 'ready'}}" class="mt-4 rounded-[18rpx] bg-[#FFF0E8] px-4 py-3 text-[length:23rpx] text-[#9F4727]">{{message}}</view>
  <app-page-exit />
</view>
