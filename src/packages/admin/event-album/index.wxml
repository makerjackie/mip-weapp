<view id="admin-event-album-page" class="mip-admin-page min-h-screen bg-canvas px-6 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-7 text-ink">
  <view class="text-[length:40rpx] font-bold">活动相册审核</view>
  <view class="mt-2 text-[length:23rpx] text-muted">{{eventTitle || '审核活动照片'}}</view>

  <view wx:if="{{canManage && (state === 'ready' || state === 'empty')}}" class="mt-5 flex flex-wrap gap-2">
    <t-tag wx:for="{{statusOptions}}" wx:key="value" theme="{{item.value === status ? 'primary' : 'default'}}" variant="outline" data-status="{{item.value}}" bind:tap="chooseStatus">{{item.label}}</t-tag>
  </view>

  <view wx:if="{{actionPhotoId && state === 'ready'}}" class="mt-5 rounded-[16rpx] border border-line bg-panel p-4">
    <view class="text-[length:28rpx] font-semibold">{{decision === 'APPROVE' ? '批准照片' : '拒绝照片'}}</view>
    <view class="mt-2 text-[length:22rpx] text-muted">请填写本次处理原因。</view>
    <view class="mt-3"><t-textarea class="box-border max-w-full" value="{{reason}}" maxlength="300" autosize placeholder="填写审核原因" bind:change="updateReason" /></view>
    <view class="mt-4 grid grid-cols-2 gap-2"><t-button block variant="outline" disabled="{{processing}}" bind:tap="cancelReview">取消</t-button><t-button block theme="primary" loading="{{processing}}" bind:tap="confirmReview">确认</t-button></view>
  </view>

  <view wx:if="{{state === 'loading'}}" class="mt-6 rounded-[16rpx] bg-panel p-5"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error' || state === 'conflict'}}" class="mt-6"><app-empty-state title="{{state === 'conflict' ? '照片状态已更新' : '相册照片加载失败'}}" description="{{message}}" action-text="重新加载" bind:action="retryLoad" /></view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-6"><app-empty-state title="没有相册审核权限" description="当前账号不能查看或审核本场活动照片。" /></view>
  <view wx:elif="{{state === 'empty'}}" class="mt-6"><app-empty-state title="暂无照片" description="当前筛选状态下没有照片。" /></view>
  <view wx:else class="mip-admin-media-grid mt-5 grid grid-cols-2 gap-3">
    <view wx:for="{{photos}}" wx:key="id" class="overflow-hidden rounded-[16rpx] bg-panel">
      <image wx:if="{{item.imageUrl}}" class="h-[300rpx] w-full bg-panel-raised" mode="aspectFill" src="{{item.imageUrl}}" data-url="{{item.imageUrl}}" bind:tap="preview" />
      <view wx:else class="flex h-[300rpx] items-center justify-center bg-panel-raised px-3 text-center text-[length:22rpx] text-muted">照片文件不可用</view>
      <view class="px-3 py-3">
        <view class="truncate text-[length:23rpx] font-semibold">{{item.nickname}}</view>
        <view wx:if="{{item.caption}}" class="mt-1 line-clamp-2 text-[length:21rpx] text-muted">{{item.caption}}</view>
        <view class="mt-2 text-[length:20rpx] text-muted">提交于 {{item.createdText}}</view>
        <view wx:if="{{item.moderationReason}}" class="mt-2 text-[length:21rpx]">审核原因：{{item.moderationReason}}</view>
        <view wx:if="{{item.reviewedText}}" class="mt-1 text-[length:20rpx] text-muted">审核于 {{item.reviewedText}}</view>
        <view wx:if="{{item.status === 'PENDING'}}" class="mt-3 grid grid-cols-2 gap-2"><t-button block size="small" variant="outline" disabled="{{processing}}" data-id="{{item.id}}" data-decision="REJECT" bind:tap="beginReview">拒绝</t-button><t-button block size="small" theme="primary" disabled="{{processing}}" data-id="{{item.id}}" data-decision="APPROVE" bind:tap="beginReview">批准</t-button></view>
      </view>
    </view>
  </view>
  <view wx:if="{{message && (state === 'ready' || state === 'empty')}}" class="mt-4 rounded-[12rpx] bg-panel px-4 py-3 text-[length:23rpx] text-danger">{{message}}</view>
  <app-page-exit />
</view>
