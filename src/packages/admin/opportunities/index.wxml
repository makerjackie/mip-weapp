<view id="admin-opportunities-page" class="min-h-screen bg-canvas px-6 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-7 text-ink">
  <view class="text-[length:40rpx] font-bold">机会管理</view><view class="mt-2 text-[length:23rpx] text-muted">查看发布状态、内容安全结果和下架记录</view>
  <view class="mt-5 rounded-[16rpx] bg-panel p-3"><t-input value="{{query}}" placeholder="搜索机会名称" bind:change="updateQuery" bind:enter="search" /><view class="mt-3 flex flex-wrap gap-2"><t-tag variant="outline" data-value="" bind:tap="chooseStatus">全部</t-tag><t-tag variant="outline" data-value="DRAFT" bind:tap="chooseStatus">草稿</t-tag><t-tag variant="outline" data-value="PUBLISHED" bind:tap="chooseStatus">招募中</t-tag><t-tag variant="outline" data-value="ENDED" bind:tap="chooseStatus">已结束</t-tag><t-tag variant="outline" data-value="UNPUBLISHED" bind:tap="chooseStatus">已下架</t-tag><t-tag variant="outline" data-value="ARCHIVED" bind:tap="chooseStatus">已归档</t-tag></view></view>
  <view wx:if="{{state === 'loading'}}" class="mt-6 rounded-[16rpx] bg-panel p-5"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error' || state === 'conflict'}}" class="mt-6"><app-empty-state title="暂时无法加载机会" description="{{message}}" action-text="重新加载" bind:action="loadOpportunities" /></view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-6"><app-empty-state title="没有机会管理权限" description="当前账号不能管理机会内容。" /></view>
  <view wx:elif="{{opportunities.length === 0}}" class="mt-6"><app-empty-state title="没有符合条件的机会" description="调整筛选条件后重新查询。" /></view>
  <view wx:else class="mt-5 flex flex-col gap-3"><view wx:for="{{opportunities}}" wx:key="id" class="rounded-[16rpx] bg-panel px-4 py-4"><view class="flex items-start justify-between gap-3"><view class="min-w-0 flex-1 text-[length:28rpx] font-semibold">{{item.title}}</view><t-tag variant="outline">{{item.status}}</t-tag></view><view class="mt-2 text-[length:23rpx] text-muted">{{item.branchName || '平台'}} · 引荐 {{item.referralCount}}</view><view class="mt-2 text-[length:23rpx]">{{item.valueSummary}}</view><view class="mt-2 text-[length:21rpx] text-muted">内容安全：{{item.contentSafetyStatus}} · 版本 {{item.version}}</view><view wx:if="{{item.moderationReason}}" class="mt-2 text-[length:22rpx] text-danger">下架原因：{{item.moderationReason}}</view><view wx:if="{{item.archiveReason}}" class="mt-2 text-[length:22rpx] text-muted">归档原因：{{item.archiveReason}}</view><view wx:if="{{item.status === 'PUBLISHED' || item.status === 'ENDED'}}" class="mt-4"><t-button block variant="outline" theme="danger" loading="{{processingId === item.id}}" data-id="{{item.id}}" data-version="{{item.version}}" bind:tap="unpublish">下架机会</t-button></view><view wx:if="{{item.status === 'DRAFT' && canArchive}}" class="mt-4"><t-button block variant="outline" theme="danger" loading="{{processingId === item.id}}" data-id="{{item.id}}" data-version="{{item.version}}" bind:tap="archive">归档草稿</t-button></view></view></view>
  <view wx:if="{{message && state === 'ready'}}" class="mt-4 rounded-[12rpx] bg-panel px-4 py-3 text-[length:23rpx] text-danger">{{message}}</view>
  <view wx:if="{{nextCursor}}" class="mt-4"><t-button block variant="outline" loading="{{loadingMore}}" bind:tap="loadMoreOpportunities">加载更多</t-button></view>
  <app-page-exit />
</view>
