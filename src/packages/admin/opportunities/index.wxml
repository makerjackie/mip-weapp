<view id="admin-opportunities-page" class="mip-admin-page mip-admin-workspace-page min-h-screen bg-canvas px-6 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-7 text-ink">
  <mip-admin-workspace-nav />
  <view class="flex items-start justify-between gap-3"><view><view class="text-[length:40rpx] font-bold">机会管理</view><view class="mt-2 text-[length:23rpx] text-muted">查询机会明细、状态和运营记录</view></view><t-button size="small" theme="primary" bind:tap="createOpportunity">新增机会</t-button></view>

  <view class="mip-admin-filter-grid mt-5 grid gap-3 rounded-[16rpx] bg-panel p-3">
    <view class="mip-admin-filter-wide"><t-input value="{{query}}" placeholder="搜索标题、价值、目标或详情" bind:change="updateQuery" bind:enter="search" /></view>
    <view class="mip-admin-filter-wide grid grid-cols-2 gap-2"><t-input value="{{ownerQuery}}" placeholder="发布人" data-field="ownerQuery" bind:change="updateFilter" /><t-input value="{{cityQuery}}" placeholder="城市" data-field="cityQuery" bind:change="updateFilter" /></view>
    <view class="mip-admin-filter-wide grid grid-cols-2 gap-2"><t-input type="digit" value="{{minAmountYuan}}" placeholder="最低金额（元）" data-field="minAmountYuan" bind:change="updateFilter" /><t-input type="digit" value="{{maxAmountYuan}}" placeholder="最高金额（元）" data-field="maxAmountYuan" bind:change="updateFilter" /></view>
    <view class="mip-admin-filter-wide grid grid-cols-2 gap-2">
      <picker mode="date" value="{{updatedFromDate}}" data-field="updatedFromDate" bindchange="changeUpdatedDate"><view class="rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:22rpx]"><view class="text-muted">更新时间起</view><view class="mt-1">{{updatedFromDate || '不限'}}</view></view></picker>
      <picker mode="date" value="{{updatedToDate}}" data-field="updatedToDate" bindchange="changeUpdatedDate"><view class="rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:22rpx]"><view class="text-muted">更新时间止</view><view class="mt-1">{{updatedToDate || '不限'}}</view></view></picker>
    </view>
    <view wx:if="{{updatedFromDate || updatedToDate}}" class="mt-2 text-right text-[length:21rpx] text-muted" bind:tap="clearUpdatedDates">清除日期</view>
    <view class="mip-admin-filter-wide grid grid-cols-2 gap-2"><picker mode="date" value="{{deadlineFromDate}}" data-field="deadlineFromDate" bindchange="changeUpdatedDate"><view class="min-h-[88rpx] rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:22rpx]"><view class="text-muted">截止时间起</view><view class="mt-1">{{deadlineFromDate || '不限'}}</view></view></picker><picker mode="date" value="{{deadlineToDate}}" data-field="deadlineToDate" bindchange="changeUpdatedDate"><view class="min-h-[88rpx] rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:22rpx]"><view class="text-muted">截止时间止</view><view class="mt-1">{{deadlineToDate || '不限'}}</view></view></picker></view>
    <view wx:if="{{deadlineFromDate || deadlineToDate}}" class="flex min-h-[88rpx] items-center justify-end text-[length:21rpx] text-muted" bind:tap="clearDeadlineDates">清除截止时间</view>
    <view class="mip-admin-span-wide flex flex-wrap gap-1" role="radiogroup"><view class="flex min-h-[88rpx] items-center" role="radio" aria-checked="{{status === ''}}"><t-tag variant="outline" theme="{{status === '' ? 'primary' : 'default'}}" data-value="" bind:tap="chooseStatus">全部</t-tag></view><view class="flex min-h-[88rpx] items-center" role="radio" aria-checked="{{status === 'DRAFT'}}"><t-tag variant="outline" theme="{{status === 'DRAFT' ? 'primary' : 'default'}}" data-value="DRAFT" bind:tap="chooseStatus">草稿</t-tag></view><view class="flex min-h-[88rpx] items-center" role="radio" aria-checked="{{status === 'PUBLISHED'}}"><t-tag variant="outline" theme="{{status === 'PUBLISHED' ? 'primary' : 'default'}}" data-value="PUBLISHED" bind:tap="chooseStatus">招募中</t-tag></view><view class="flex min-h-[88rpx] items-center" role="radio" aria-checked="{{status === 'ENDED'}}"><t-tag variant="outline" theme="{{status === 'ENDED' ? 'primary' : 'default'}}" data-value="ENDED" bind:tap="chooseStatus">已结束</t-tag></view><view class="flex min-h-[88rpx] items-center" role="radio" aria-checked="{{status === 'UNPUBLISHED'}}"><t-tag variant="outline" theme="{{status === 'UNPUBLISHED' ? 'primary' : 'default'}}" data-value="UNPUBLISHED" bind:tap="chooseStatus">已下架</t-tag></view><view class="flex min-h-[88rpx] items-center" role="radio" aria-checked="{{status === 'ARCHIVED'}}"><t-tag variant="outline" theme="{{status === 'ARCHIVED' ? 'primary' : 'default'}}" data-value="ARCHIVED" bind:tap="chooseStatus">已归档</t-tag></view></view>
    <view class="mip-admin-span-wide flex flex-wrap gap-1"><t-tag variant="outline" theme="{{locationTypes.indexOf('CITY') >= 0 ? 'primary' : 'default'}}" data-type="CITY" bind:tap="toggleLocationType">城市</t-tag><t-tag variant="outline" theme="{{locationTypes.indexOf('NATIONAL') >= 0 ? 'primary' : 'default'}}" data-type="NATIONAL" bind:tap="toggleLocationType">全国</t-tag><t-tag variant="outline" theme="{{locationTypes.indexOf('REMOTE') >= 0 ? 'primary' : 'default'}}" data-type="REMOTE" bind:tap="toggleLocationType">远程</t-tag></view>
    <view class="mip-admin-span-wide grid grid-cols-2 gap-2"><t-button block variant="outline" bind:tap="exportOpportunities">导出</t-button><t-button block theme="primary" bind:tap="search">查询</t-button></view>
  </view>

  <view wx:if="{{state === 'loading'}}" class="mt-6 rounded-[16rpx] bg-panel p-5"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error' || state === 'conflict'}}" class="mt-6"><app-empty-state title="暂时无法加载机会" description="{{message}}" action-text="重新加载" bind:action="loadOpportunities" /></view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-6"><app-empty-state title="没有机会管理权限" description="当前账号不能管理机会内容。" /></view>
  <view wx:elif="{{opportunities.length === 0}}" class="mt-6"><app-empty-state title="没有符合条件的机会" description="调整筛选条件后重新查询。" /></view>
  <view wx:else class="mip-admin-card-list mt-5 flex flex-col gap-3">
    <view wx:for="{{opportunities}}" wx:key="id" class="rounded-[16rpx] bg-panel px-4 py-4">
      <view class="flex items-start justify-between gap-3"><view class="min-w-0 flex-1 text-[length:28rpx] font-semibold">{{item.title}}</view><t-tag variant="outline" theme="{{item.statusTheme}}">{{item.statusText}}</t-tag></view>
      <view class="mt-2 text-[length:23rpx] text-muted">{{item.ownerNickname}} · {{item.cityName || item.branchName || '平台'}} · 引荐 {{item.referralCount}}</view>
      <view class="mt-2 text-[length:23rpx]">{{item.valueSummary}}</view>
      <view wx:if="{{item.commercialTerms.amountDisplay}}" class="mt-2 text-[length:21rpx] text-muted">结构化金额：{{item.commercialTerms.amountDisplay}} · 范围：{{item.commercialTerms.locationDisplay || '未设置'}}</view>
      <view class="mt-2 text-[length:21rpx] text-muted">截止时间：{{item.deadlineText || '未设置'}} · 更新时间：{{item.updatedText || '未记录'}}</view>
      <view class="mt-3 grid grid-cols-2 gap-2"><t-button block variant="outline" data-id="{{item.id}}" bind:tap="openDetail">查看</t-button><t-button wx:if="{{item.status !== 'ARCHIVED'}}" block variant="outline" data-id="{{item.id}}" bind:tap="editOpportunity">编辑</t-button></view>
      <view wx:if="{{item.status === 'PUBLISHED' || item.status === 'ENDED'}}" class="mt-4"><t-button block variant="outline" theme="danger" loading="{{processingId === item.id}}" data-id="{{item.id}}" data-version="{{item.version}}" bind:tap="unpublish">下架机会</t-button></view>
      <view wx:if="{{item.status === 'DRAFT' && canArchive}}" class="mt-4"><t-button block variant="outline" theme="danger" loading="{{processingId === item.id}}" data-id="{{item.id}}" data-status="{{item.status}}" data-version="{{item.version}}" bind:tap="archive">归档草稿</t-button></view>
    </view>
  </view>
  <view wx:if="{{message && state === 'ready'}}" class="mt-4 rounded-[12rpx] bg-panel px-4 py-3 text-[length:23rpx] text-danger">{{message}}</view>
  <view wx:if="{{nextCursor}}" class="mt-4"><t-button block variant="outline" loading="{{loadingMore}}" bind:tap="loadMoreOpportunities">加载更多</t-button></view>
  <app-page-exit />
</view>
