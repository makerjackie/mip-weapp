<view id="admin-message-delivery-records-page" class="mip-admin-page mip-admin-workspace-page min-h-screen bg-canvas px-6 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-7 text-ink">
  <mip-admin-workspace-nav />
  <view class="flex items-start justify-between gap-3"><view class="min-w-0 flex-1"><view class="text-[length:40rpx] font-bold">消息投递记录</view><view class="mt-2 text-[length:23rpx] text-muted">查看微信渠道的投递尝试</view></view></view>

  <view class="mip-admin-span-wide mt-5 rounded-[16rpx] bg-panel px-4 py-4">
    <view class="flex flex-col gap-3">
      <view class="flex min-w-0 gap-2"><input class="box-border min-h-[76rpx] min-w-0 flex-1 rounded-[12rpx] bg-panel-raised px-3 text-[length:23rpx]" placeholder="搜索消息标题、活动、昵称或玩家编号" value="{{query}}" bindinput="updateQuery" /><t-button size="small" theme="primary" bind:tap="submitQuery">搜索</t-button></view>
      <view class="grid grid-cols-2 gap-2">
        <picker range="{{['全部渠道','微信订阅消息','微信客服消息','微信服务通知']}}" value="{{channel ? (channel === 'WECHAT_SUBSCRIPTION' ? 1 : channel === 'WECHAT_CUSTOMER_SERVICE' ? 2 : 3) : 0}}" bindchange="chooseChannel"><view class="min-h-[72rpx] rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:22rpx]">渠道：{{channel ? (channel === 'WECHAT_SUBSCRIPTION' ? '微信订阅消息' : channel === 'WECHAT_CUSTOMER_SERVICE' ? '微信客服消息' : '微信服务通知') : '全部渠道'}}</view></picker>
        <picker range="{{['全部状态','等待处理','处理中','已送达','失败','已取消']}}" value="{{status ? (status === 'PENDING' ? 1 : status === 'PROCESSING' ? 2 : status === 'DELIVERED' ? 3 : status === 'FAILED' ? 4 : 5) : 0}}" bindchange="chooseStatus"><view class="min-h-[72rpx] rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:22rpx]">状态：{{status ? (status === 'PENDING' ? '等待处理' : status === 'PROCESSING' ? '处理中' : status === 'DELIVERED' ? '已送达' : status === 'FAILED' ? '失败' : '已取消') : '全部状态'}}</view></picker>
      </view>
      <view class="grid grid-cols-2 gap-2"><picker mode="date" value="{{from}}" bindchange="chooseFrom"><view class="min-h-[72rpx] rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:22rpx]">开始日期：{{from || '不限'}}</view></picker><picker mode="date" value="{{to}}" bindchange="chooseTo"><view class="min-h-[72rpx] rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:22rpx]">结束日期：{{to || '不限'}}</view></picker></view>
    </view>
  </view>

  <view wx:if="{{state === 'loading'}}" class="mt-6 rounded-[16rpx] bg-panel px-5 py-6"><t-skeleton row-col="{{[1,1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-6"><app-empty-state title="没有消息管理权限" description="当前账号不能查看消息投递记录。" /></view>
  <view wx:elif="{{state === 'error' || state === 'conflict'}}" class="mt-6"><app-empty-state title="暂时无法加载消息投递记录" description="{{message}}" action-text="重新加载" bind:action="retryLoad" /></view>
  <view wx:elif="{{state === 'empty'}}" class="mt-6"><app-empty-state title="暂无消息投递记录" description="满足条件的投递记录会显示在这里。" /></view>
  <block wx:elif="{{items.length}}">
    <view class="mip-admin-section-grid mt-5 grid gap-3"><view wx:for="{{items}}" wx:key="recordKey" class="rounded-[16rpx] bg-panel px-4 py-4"><view class="flex items-start justify-between gap-3"><view class="min-w-0 flex-1 text-[length:27rpx] font-semibold">{{item.title}}</view><t-tag size="small" variant="outline" theme="{{item.status === 'DELIVERED' ? 'success' : item.status === 'FAILED' ? 'danger' : 'warning'}}">{{item.statusText}}</t-tag></view><view class="mt-2 text-[length:22rpx] text-muted">{{item.eventTitle || item.campaignName || '普通消息'}} · {{item.recipientText}}</view><view class="mt-3 flex flex-wrap gap-2 text-[length:21rpx] text-muted"><text>{{item.channelText}}</text><text>{{item.branchName || '平台范围'}}</text><text>尝试 {{item.attempts}} 次</text><text>{{item.occurredText}}</text></view><view class="mt-2 text-[length:21rpx] {{item.lastErrorCode ? 'text-danger' : 'text-muted'}}">最近错误：{{item.errorText}}</view><view class="mt-1 text-[length:21rpx] text-muted">计划：{{item.availableText}} · 完成：{{item.deliveredText}}</view></view></view>
    <view class="mt-5 flex flex-col items-center gap-3"><picker range="{{pageSizes}}" value="{{pageSizeIndex}}" bindchange="choosePageSize"><view class="rounded-[12rpx] bg-panel px-4 py-3 text-[length:22rpx]">每页 {{pageSize}} 条</view></picker><t-button wx:if="{{nextCursor}}" variant="outline" loading="{{loadingMore}}" bind:tap="loadMore">加载更多</t-button></view>
  </block>
  <app-page-exit />
</view>
