<view id="admin-growth-entries-page" class="min-h-screen bg-canvas px-6 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-7 text-ink">
  <view class="flex items-start justify-between"><view><view class="text-[length:40rpx] font-bold">成长流水</view><view class="mt-2 text-[length:23rpx] text-muted">查看奖励记录与受控人工调整</view></view><t-button wx:if="{{canExport}}" size="small" variant="outline" loading="{{exportPending}}" bind:tap="createExport">导出流水</t-button></view>
  <view class="mt-5 flex gap-2"><t-tag variant="outline" data-value="EXPERIENCE" bind:tap="chooseMetric">经验值</t-tag><t-tag variant="outline" data-value="CONTRIBUTION" bind:tap="chooseMetric">贡献值</t-tag></view>
  <view wx:if="{{canAdjust}}" class="mt-5 rounded-[16rpx] bg-panel p-4"><view class="text-[length:27rpx] font-semibold">人工调整</view><view class="mt-3"><t-input value="{{query}}" placeholder="搜索用户昵称" bind:change="updateQuery" bind:enter="searchUsers" /></view><view wx:if="{{candidates.length}}" class="mt-2 flex flex-col gap-2"><view wx:for="{{candidates}}" wx:key="id" class="rounded-[10rpx] bg-panel-raised px-3 py-3" data-id="{{item.id}}" data-name="{{item.nickname}}" bind:tap="chooseUser">{{item.nickname}} · {{item.branchName || '未设置分会'}}</view></view><view wx:if="{{selectedUserName}}" class="mt-3 text-[length:23rpx] text-brand">已选择：{{selectedUserName}}</view><view class="mt-2"><t-input type="number" value="{{deltaValue}}" placeholder="调整数值，可为负数" bind:change="updateDelta" /></view><view class="mt-2"><t-input value="{{reason}}" placeholder="填写调整原因" bind:change="updateReason" /></view><view class="mt-4"><t-button block theme="primary" loading="{{processing}}" bind:tap="adjust">确认调整</t-button></view></view>
  <view wx:if="{{state === 'loading'}}" class="mt-6 rounded-[16rpx] bg-panel p-5"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error' || state === 'conflict'}}" class="mt-6"><app-empty-state title="暂时无法加载流水" description="{{message}}" action-text="重新加载" bind:action="loadEntries" /></view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-6"><app-empty-state title="没有成长流水权限" description="当前账号不能查看成长流水。" /></view>
  <view wx:elif="{{entries.length === 0}}" class="mt-6"><app-empty-state title="暂无成长流水" description="符合筛选条件的记录会显示在这里。" /></view>
  <view wx:else class="mt-5 flex flex-col gap-3"><view wx:for="{{entries}}" wx:key="id" class="rounded-[16rpx] bg-panel px-4 py-4"><view class="flex items-start justify-between"><view><view class="text-[length:27rpx] font-semibold">{{item.nickname}}</view><view class="mt-1 text-[length:22rpx] text-muted">{{item.sourceEventType}}</view></view><view class="text-right"><view class="text-[length:28rpx] font-semibold text-brand">{{item.deltaValue > 0 ? '+' : ''}}{{item.deltaValue}}</view><view class="mt-1 text-[length:21rpx] text-muted">余额 {{item.balanceAfter}}</view></view></view><view wx:if="{{item.adjustmentReason}}" class="mt-3 text-[length:22rpx] text-muted">{{item.adjustmentReason}}</view></view></view>
  <view wx:if="{{message && state === 'ready'}}" class="mt-4 rounded-[12rpx] bg-panel px-4 py-3 text-[length:23rpx] text-danger">{{message}}</view>
  <view wx:if="{{nextCursor}}" class="mt-4"><t-button block variant="outline" loading="{{loadingMore}}" bind:tap="loadMoreEntries">加载更多</t-button></view>
  <app-page-exit />
</view>
