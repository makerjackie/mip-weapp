<view id="admin-user-content-page" class="mip-admin-page mip-admin-workspace-page min-h-screen bg-canvas px-6 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-7 text-ink">
  <mip-admin-workspace-nav />
  <view class="text-[length:40rpx] font-bold">用户内容</view>
  <view class="mt-2 text-[length:23rpx] text-muted">查看合作卡与超级案例，并处理需要下架的已发布内容</view>

  <view wx:if="{{canManage}}" class="admin-user-content-filter-grid mt-5 rounded-[16rpx] bg-panel p-3">
    <t-input class="box-border max-w-full" value="{{query}}" placeholder="搜索内容或用户昵称" bind:change="updateQuery" bind:enter="search" />
    <picker range="{{kindOptions}}" range-key="label" value="{{kindIndex}}" bindchange="changeKind">
      <view class="flex min-h-[88rpx] items-center justify-between rounded-[12rpx] bg-panel-raised px-3 text-[length:22rpx]"><text>内容类型</text><text>{{kindOptions[kindIndex].label}}</text></view>
    </picker>
    <picker range="{{statusOptions}}" range-key="label" value="{{statusIndex}}" bindchange="changeStatus">
      <view class="flex min-h-[88rpx] items-center justify-between rounded-[12rpx] bg-panel-raised px-3 text-[length:22rpx]"><text>内容状态</text><text>{{statusOptions[statusIndex].label}}</text></view>
    </picker>
    <t-button block variant="outline" bind:tap="search">查询</t-button>
  </view>

  <view wx:if="{{state === 'loading'}}" class="mt-6 rounded-[16rpx] bg-panel p-5"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error' || state === 'conflict'}}" class="mt-6"><app-empty-state title="暂时无法加载用户内容" description="{{message}}" action-text="重新加载" bind:action="retryLoad" /></view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-6"><app-empty-state title="没有用户内容治理权限" description="当前账号不能查看或下架用户内容。" /></view>
  <view wx:elif="{{items.length === 0}}" class="mt-6"><app-empty-state title="暂无用户内容" description="当前筛选条件下没有可显示的合作卡或超级案例。" /></view>
  <view wx:else class="admin-user-content-grid mt-5">
    <view wx:for="{{items}}" wx:key="id" class="rounded-[16rpx] bg-panel px-4 py-4" role="button" aria-label="查看{{item.kindText}}详情" data-id="{{item.id}}" data-kind="{{item.kind}}" bind:tap="openDetail">
      <view class="flex items-start justify-between gap-3"><view class="min-w-0 flex-1"><view class="text-[length:27rpx] font-semibold">{{item.title}}</view><view class="mt-1 text-[length:21rpx] text-muted">{{item.kindText}}{{item.roleText ? ' · ' + item.roleText : ''}}</view></view><t-tag variant="outline">{{item.statusText}}</t-tag></view>
      <view wx:if="{{item.summary}}" class="mt-3 line-clamp-2 text-[length:23rpx] leading-[1.6]">{{item.summary}}</view>
      <view class="mt-3 rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:21rpx]"><view>{{item.owner.nickname}}</view><view class="mt-1 text-muted">{{item.owner.branchName || '未设置主分会'}}{{item.owner.cityName ? ' · ' + item.owner.cityName : ''}}</view></view>
      <view class="mt-3 flex items-center justify-between gap-2 text-[length:20rpx] text-muted"><text>安全检查：{{item.safetyText}}</text><text>{{item.updatedText}}</text></view>
    </view>
  </view>
  <view wx:if="{{nextCursor && state === 'ready'}}" class="mt-5"><t-button block variant="outline" loading="{{loadingMore}}" bind:tap="loadMore">加载更多</t-button></view>
  <view wx:if="{{message && state === 'ready'}}" class="mt-4 text-[length:22rpx] text-danger">{{message}}</view>
  <app-page-exit />

  <mip-admin-responsive-panel visible="{{detailOpen}}" title="用户内容详情" bind:close="closeDetail" bind:visible-change="handleDetailVisibility">
    <view wx:if="{{detailState === 'loading'}}" class="py-5"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
    <view wx:elif="{{detailState === 'error' || detailState === 'conflict'}}"><app-empty-state title="详情加载失败" description="{{detailMessage}}" action-text="重新加载" bind:action="retryDetail" /></view>
    <view wx:elif="{{detailState === 'forbidden'}}"><app-empty-state title="没有查看权限" description="{{detailMessage || '当前账号不能查看该用户内容。'}}" /></view>
    <view wx:elif="{{detail}}" class="pb-4">
      <view class="flex items-start justify-between gap-3"><view class="min-w-0 flex-1"><view class="text-[length:30rpx] font-semibold">{{detail.kind === 'COOPERATION_CARD' ? detail.positioning : detail.projectName}}</view><view class="mt-1 text-[length:21rpx] text-muted">{{detail.kindText}}{{detail.roleText ? ' · ' + detail.roleText : ''}}</view></view><t-tag variant="outline">{{detail.statusText}}</t-tag></view>
      <view class="mt-4 rounded-[16rpx] bg-panel-raised px-4 py-4"><view class="text-[length:21rpx] text-muted">发布用户</view><view class="mt-1 text-[length:25rpx] font-semibold">{{detail.owner.nickname}}</view><view class="mt-1 text-[length:21rpx] text-muted">{{detail.owner.branchName || '未设置主分会'}}{{detail.owner.cityName ? ' · ' + detail.owner.cityName : ''}}</view></view>

      <block wx:if="{{detail.kind === 'COOPERATION_CARD'}}">
        <view class="mt-4 rounded-[16rpx] bg-panel-raised px-4 py-4"><view class="text-[length:21rpx] text-muted">目标方向</view><view class="mt-2 whitespace-pre-wrap text-[length:23rpx] leading-[1.7]">{{detail.targetSummary}}</view></view>
        <view wx:if="{{detail.roleFieldViews.length}}" class="mt-4 rounded-[16rpx] bg-panel-raised px-4 py-4"><view class="text-[length:25rpx] font-semibold">合作信息</view><view wx:for="{{detail.roleFieldViews}}" wx:key="key" class="mt-3 border-b border-line pb-3"><view class="text-[length:20rpx] text-muted">{{item.label}}</view><view class="mt-1 whitespace-pre-wrap text-[length:23rpx]">{{item.value}}</view></view></view>
        <view wx:if="{{detail.abilityViews.length}}" class="mt-4 rounded-[16rpx] bg-panel-raised px-4 py-4"><view class="text-[length:25rpx] font-semibold">能力评分</view><view class="mt-3 grid grid-cols-2 gap-2"><view wx:for="{{detail.abilityViews}}" wx:key="key" class="rounded-[10rpx] bg-panel px-3 py-2 text-[length:21rpx]">{{item.label}} · {{item.score}}/5</view></view></view>
      </block>

      <block wx:else>
        <image wx:if="{{detail.coverUrl}}" class="mt-4 h-[320rpx] w-full rounded-[16rpx] bg-panel-raised" src="{{detail.coverUrl}}" mode="aspectFill" />
        <view class="mt-4 rounded-[16rpx] bg-panel-raised px-4 py-4"><view class="text-[length:21rpx] text-muted">案例摘要</view><view class="mt-2 whitespace-pre-wrap text-[length:23rpx] leading-[1.7]">{{detail.summary}}</view><view class="mt-3 text-[length:21rpx] text-muted">{{detail.cityLabel || '未设置城市'}}{{detail.industryLabel ? ' · ' + detail.industryLabel : ''}}{{detail.caseType ? ' · ' + detail.caseType : ''}}</view></view>
        <view class="mt-4 rounded-[16rpx] bg-panel-raised px-4 py-4"><view class="text-[length:21rpx] text-muted">项目责任</view><view class="mt-2 whitespace-pre-wrap text-[length:23rpx] leading-[1.7]">{{detail.responsibility}}</view><view class="mt-4 text-[length:21rpx] text-muted">案例说明</view><view class="mt-2 whitespace-pre-wrap text-[length:23rpx] leading-[1.7]">{{detail.description}}</view></view>
        <view wx:if="{{detail.media.length}}" class="admin-user-content-media mt-4"><image wx:for="{{detail.media}}" wx:key="assetId" class="h-[220rpx] w-full rounded-[12rpx] bg-panel-raised" src="{{item.url}}" mode="aspectFill" /></view>
      </block>

      <view class="mt-4 rounded-[16rpx] bg-panel-raised px-4 py-4"><view class="text-[length:21rpx] text-muted">内容状态</view><view class="mt-2 text-[length:23rpx]">安全检查：{{detail.safetyText}}</view><view class="mt-1 text-[length:21rpx] text-muted">发布：{{detail.publishedText}} · 更新：{{detail.updatedText}}</view></view>
      <view wx:if="{{detail.historyViews.length}}" class="mt-4 rounded-[16rpx] bg-panel-raised px-4 py-4"><view class="text-[length:25rpx] font-semibold">下架记录</view><view wx:for="{{detail.historyViews}}" wx:key="createdAt" class="mt-3 border-b border-line pb-3"><view class="text-[length:22rpx]">{{item.actorNickname}} · {{item.createdText}}</view><view class="mt-1 whitespace-pre-wrap text-[length:21rpx] text-muted">{{item.reason}}</view></view></view>

      <view wx:if="{{detail.status === 'PUBLISHED'}}" class="mt-4 rounded-[16rpx] border border-line bg-panel-raised px-4 py-4"><view class="text-[length:25rpx] font-semibold">下架内容</view><view class="mt-1 text-[length:21rpx] text-muted">下架原因会保存在审计记录中。</view><t-textarea class="mt-3 box-border max-w-full" value="{{reason}}" maxlength="300" autosize placeholder="填写下架原因" disabled="{{processing}}" bind:change="updateReason" /><view wx:if="{{detailMessage}}" class="mt-2 text-[length:21rpx] text-danger">{{detailMessage}}</view><view class="mt-4"><t-button block theme="danger" loading="{{processing}}" bind:tap="unpublish">确认下架</t-button></view></view>
      <view wx:elif="{{detailMessage}}" class="mt-4 text-[length:21rpx] text-danger">{{detailMessage}}</view>
    </view>
  </mip-admin-responsive-panel>
</view>
