<view id="admin-exceptions-page" class="mip-admin-page mip-admin-workspace-page min-h-screen bg-canvas px-6 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-7 text-ink">
  <mip-admin-workspace-nav />
  <view class="text-[length:40rpx] font-bold">运营待办与异常</view>
  <view class="mt-2 text-[length:23rpx] text-muted">按当前权限汇总待处理、处理中和需人工复核项目</view>

  <view wx:if="{{state === 'loading'}}" class="mt-6 rounded-[16rpx] bg-panel p-5"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error' || state === 'conflict'}}" class="mt-6"><app-empty-state title="暂时无法加载异常" description="{{message}}" action-text="重新加载" bind:action="retryLoad" /></view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-6"><app-empty-state title="没有查看权限" description="当前账号不能查看异常中心。" /></view>
  <block wx:else>
    <view class="mt-6">
      <view class="flex flex-wrap items-end justify-between gap-3">
        <view class="min-w-0 flex-1"><view class="text-[length:30rpx] font-semibold">统一待办</view><view class="mt-1 text-[length:22rpx] text-muted">项目来自现有订单、事件、内容、消息和后台异常事实</view></view>
        <view class="flex max-w-full flex-wrap gap-2">
          <t-tag theme="{{queueState === '' ? 'primary' : 'default'}}" variant="outline" data-value="" bind:tap="chooseQueueState">全部</t-tag>
          <t-tag theme="{{queueState === 'PENDING' ? 'primary' : 'default'}}" variant="outline" data-value="PENDING" bind:tap="chooseQueueState">待处理</t-tag>
          <t-tag theme="{{queueState === 'PROCESSING' ? 'primary' : 'default'}}" variant="outline" data-value="PROCESSING" bind:tap="chooseQueueState">处理中</t-tag>
          <t-tag theme="{{queueState === 'MANUAL_REVIEW' ? 'primary' : 'default'}}" variant="outline" data-value="MANUAL_REVIEW" bind:tap="chooseQueueState">需人工复核</t-tag>
        </view>
      </view>
      <view wx:if="{{queueItems.length}}" class="mt-4 mip-admin-section-grid grid gap-3">
        <view wx:for="{{queueItems}}" wx:key="id" class="flex min-h-[112rpx] items-center rounded-[16rpx] bg-panel px-4 py-4" data-id="{{item.id}}" bind:tap="openQueueItem">
          <view class="min-w-0 flex-1"><view class="flex items-start justify-between gap-3"><view class="min-w-0 flex-1 text-[length:27rpx] font-semibold">{{item.title}}</view><t-tag variant="outline" theme="{{item.state === 'MANUAL_REVIEW' ? 'danger' : item.state === 'PROCESSING' ? 'warning' : 'default'}}">{{item.stateText}}</t-tag></view><view class="mt-2 text-[length:22rpx] leading-[1.6] text-muted">{{item.summary}}</view><view class="mt-1 text-[length:21rpx] text-muted">{{item.sourceText}} · {{item.occurredText}}</view></view>
          <t-icon wx:if="{{item.reviewRef || item.target}}" name="chevron-right" size="30rpx" color="var(--color-muted)" />
        </view>
      </view>
      <view wx:else class="mt-4 rounded-[16rpx] bg-panel px-4 py-5 text-[length:23rpx] text-muted">当前没有待处理项目。</view>
    </view>

    <view wx:if="{{canDeliveryReview}}" class="mt-6">
      <view class="flex flex-wrap items-end justify-between gap-3">
        <view class="min-w-0 flex-1"><view class="text-[length:30rpx] font-semibold">消息投递复核</view><view class="mt-1 text-[length:22rpx] text-muted">处理投递超时、结果未知和终止状态</view></view>
        <view class="flex max-w-full flex-wrap gap-2"><t-tag theme="{{reviewWorkflowStatus === 'ACTIVE' ? 'primary' : 'default'}}" variant="outline" data-value="ACTIVE" bind:tap="chooseReviewWorkflow">待处理</t-tag><t-tag theme="{{reviewWorkflowStatus === 'RESOLVED' ? 'primary' : 'default'}}" variant="outline" data-value="RESOLVED" bind:tap="chooseReviewWorkflow">已闭环</t-tag></view>
      </view>
      <view wx:if="{{reviewState === 'loading'}}" class="mt-4 rounded-[16rpx] bg-panel p-5"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
      <view wx:elif="{{reviewState === 'error' || reviewState === 'conflict'}}" class="mt-4"><app-empty-state title="投递复核加载失败" description="{{reviewMessage}}" action-text="重新加载" bind:action="retryLoad" /></view>
      <view wx:elif="{{reviewState === 'empty'}}" class="mt-4"><app-empty-state title="{{reviewWorkflowStatus === 'ACTIVE' ? '暂无待处理投递' : '暂无已闭环记录'}}" description="{{reviewWorkflowStatus === 'ACTIVE' ? '当前没有需要人工复核的消息投递。' : '完成复核后可在此查看处理记录。'}}" /></view>
      <view wx:else class="mt-4 flex flex-col gap-3">
        <view wx:for="{{reviewItems}}" wx:key="id" class="rounded-[16rpx] bg-panel px-4 py-4">
          <view data-id="{{item.id}}" bind:tap="toggleReview">
            <view class="flex items-start justify-between gap-3"><view class="min-w-0 flex-1"><view class="text-[length:27rpx] font-semibold">{{item.sourceText}}</view><view class="mt-1 break-all text-[length:20rpx] text-muted">{{item.resourceRef.id}}</view></view><t-tag variant="outline" theme="{{item.classification === 'MANUAL_REVIEW' || item.classification === 'TERMINAL_FAILURE' ? 'danger' : 'warning'}}">{{item.classificationText}}</t-tag></view>
            <view class="mt-3 text-[length:22rpx] leading-[1.7] text-muted">{{item.stateSummary}}</view>
            <view class="mt-1 text-[length:22rpx] leading-[1.7] text-muted">{{item.evidenceSummary}}</view>
            <view class="mt-2 flex items-center justify-between text-[length:21rpx] text-muted"><text>{{item.workflowText}} · {{item.occurredText}}</text><t-icon name="{{item.selected ? 'chevron-up' : 'chevron-down'}}" size="28rpx" color="var(--color-muted)" /></view>
          </view>
          <view wx:if="{{item.selected}}" class="mt-4 border-t border-line pt-4">
            <view wx:if="{{item.resolutionText}}" class="rounded-[12rpx] bg-canvas px-3 py-3 text-[length:22rpx] leading-[1.7] text-muted">处理结果：{{item.resolutionText}}</view>
            <view wx:if="{{item.workflow.status !== 'RESOLVED'}}" class="text-[length:22rpx] leading-[1.7] text-muted">核对投递状态不会重新发送消息；结果未知时不会标记为已送达。</view>
            <textarea wx:if="{{item.actions.canResolve}}" class="mt-3 min-h-[144rpx] w-full rounded-[12rpx] bg-canvas px-3 py-3 text-[length:24rpx]" maxlength="500" placeholder="{{item.requiresNote ? '处理说明（必填）' : '处理说明（选填）'}}" value="{{resolutionNote}}" bind:input="updateResolutionNote" />
            <input wx:if="{{item.actions.canResolve}}" class="mt-3 h-[76rpx] rounded-[12rpx] bg-canvas px-3 text-[length:23rpx]" maxlength="300" placeholder="证据引用（选填）" value="{{evidenceReference}}" bind:input="updateEvidenceReference" />
            <view class="mt-4 flex flex-wrap gap-2">
              <t-button wx:if="{{item.actions.canClaim}}" size="small" theme="primary" loading="{{busyReviewId === item.id}}" disabled="{{busyReviewId !== ''}}" data-id="{{item.id}}" bind:tap="claimReview">认领复核</t-button>
              <t-button wx:if="{{item.actions.canReconcile}}" size="small" theme="primary" loading="{{busyReviewId === item.id}}" disabled="{{busyReviewId !== ''}}" data-id="{{item.id}}" bind:tap="reconcileReview">核对投递状态</t-button>
              <t-button wx:if="{{item.actions.canResolve}}" size="small" variant="outline" loading="{{busyReviewId === item.id}}" disabled="{{busyReviewId !== ''}}" data-id="{{item.id}}" bind:tap="resolveReview">{{item.requiresNote ? '确认未知结果，不重放' : '接受终止结果'}}</t-button>
            </view>
          </view>
          <view class="mt-4 border-t border-line pt-3"><t-button class="min-h-[88rpx]" block size="large" variant="outline" disabled="{{busyReviewId !== ''}}" data-id="{{item.id}}" bind:tap="openReview">查看复核明细</t-button></view>
        </view>
        <view wx:if="{{reviewNextCursor}}" class="flex justify-center py-2"><t-button size="small" variant="outline" loading="{{reviewLoadingMore}}" disabled="{{reviewLoadingMore}}" bind:tap="loadMoreDeliveryReviews">加载更多</t-button></view>
      </view>
      <view wx:if="{{reviewMessage && (reviewState === 'ready' || reviewState === 'empty')}}" class="mt-3 rounded-[12rpx] bg-panel px-4 py-3 text-[length:23rpx] text-danger">{{reviewMessage}}</view>
    </view>

    <view wx:if="{{canOperationalExceptions}}" class="mt-7 border-t border-line pt-6">
      <view class="text-[length:30rpx] font-semibold">其他异常</view>
      <view class="mt-4 grid gap-3"><view class="flex flex-wrap gap-2"><t-tag wx:for="{{typeOptions}}" wx:key="value" theme="{{item.value === type ? 'primary' : 'default'}}" variant="outline" data-value="{{item.value}}" bind:tap="chooseType">{{item.label}}</t-tag></view><view class="flex flex-wrap gap-2"><t-tag wx:for="{{statusOptions}}" wx:key="value" theme="{{item.value === status ? 'primary' : 'default'}}" variant="outline" data-value="{{item.value}}" bind:tap="chooseStatus">{{item.label}}</t-tag></view></view>
      <view wx:if="{{exceptionsState === 'loading'}}" class="mt-5 rounded-[16rpx] bg-panel p-5"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
      <view wx:elif="{{exceptionsState === 'error' || exceptionsState === 'conflict'}}" class="mt-5"><app-empty-state title="其他异常加载失败" description="{{exceptionsMessage}}" action-text="重新加载" bind:action="retryLoad" /></view>
      <view wx:elif="{{exceptionsState === 'empty'}}" class="mt-5"><app-empty-state title="暂无异常" description="当前筛选条件下没有异常记录。" /></view>
      <view wx:else class="mt-5 flex flex-col gap-3"><view wx:for="{{items}}" wx:key="id" class="rounded-[16rpx] bg-panel px-4 py-4"><view class="flex items-start justify-between gap-3"><view class="min-w-0 flex-1"><view class="text-[length:27rpx] font-semibold">{{item.title}}</view><view class="mt-2 text-[length:23rpx] leading-[1.7] text-muted">{{item.summary}}</view></view><t-tag variant="outline" theme="{{item.status === 'FAILED' || item.status === 'REJECTED' ? 'danger' : 'warning'}}">{{item.statusText}}</t-tag></view><view class="mt-3 text-[length:21rpx] text-muted">{{item.sourceText}} · {{item.occurredText}}</view><view wx:if="{{item.reasonCode === 'DELIVERY_OUTCOME_UNKNOWN'}}" class="mt-2 text-[length:22rpx] text-muted">投递结果未知，此处不提供重试操作。</view><view wx:if="{{item.target}}" class="mt-4 flex min-h-[72rpx] items-center border-t border-line pt-3" data-id="{{item.id}}" bind:tap="openTarget"><view class="flex-1 text-[length:23rpx] font-semibold text-brand">查看相关业务</view><t-icon name="chevron-right" size="30rpx" color="var(--color-brand)" /></view></view></view>
    </view>
  </block>
  <app-page-exit />
</view>
