<view id="admin-event-console-page" class="min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-4 text-ink">
  <view wx:if="{{state === 'loading'}}" class="rounded-[26rpx] bg-panel px-5 py-8">
    <t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading />
  </view>
  <view wx:elif="{{state === 'error'}}">
    <app-empty-state title="暂时无法管理这场活动" description="{{message}}" action-text="重新加载" bind:action="load" />
  </view>
  <view wx:elif="{{state === 'forbidden'}}">
    <app-empty-state title="没有本场活动权限" description="请联系活动负责人确认你的协作角色。" />
  </view>
  <block wx:else>
    <view class="overflow-hidden rounded-[26rpx] bg-panel">
      <image wx:if="{{item.coverUrl}}" class="h-[280rpx] w-full bg-brand-soft" src="{{item.coverUrl}}" mode="aspectFill" />
      <view class="px-5 py-5">
        <view class="flex items-center justify-between gap-3">
          <t-tag variant="light">{{item.statusText}}</t-tag>
          <view class="text-[length:20rpx] font-semibold text-brand">{{item.roleText}}</view>
        </view>
        <view class="mt-3 text-[length:32rpx] font-bold">{{item.title}}</view>
        <view class="mt-2 text-[length:22rpx] text-muted">{{item.startsText}}</view>
        <view class="mt-1 text-[length:22rpx] text-muted">{{item.location || '地点待补充'}}</view>
        <view class="mt-4 flex items-end justify-between border-t border-line pt-4">
          <view><view class="font-mono text-[length:38rpx] font-bold">{{item.registrationCount}}</view><view class="mt-1 text-[length:20rpx] text-muted">当前报名</view></view>
          <view class="text-[length:21rpx] font-semibold text-brand active:opacity-70" bind:tap="openPreview">查看用户端 <t-icon name="chevron-right" size="30rpx" color="var(--color-brand)" /></view>
        </view>
      </view>
    </view>

    <view wx:if="{{item.canRoster || item.canCheckIn}}" class="mt-4">
      <t-button block theme="primary" bind:tap="openRoster">{{item.canCheckIn ? '查看报名与签到' : '查看报名名单'}}</t-button>
    </view>

    <view class="mt-5 overflow-hidden rounded-[24rpx] bg-panel">
      <view wx:if="{{item.canEdit}}" class="flex min-h-[104rpx] items-center gap-3 border-b border-line px-4 active:bg-panel-muted" bind:tap="openEditor">
        <view class="flex h-[64rpx] w-[64rpx] shrink-0 items-center justify-center rounded-full bg-brand-soft"><t-icon name="edit-1" size="34rpx" color="var(--color-brand)" /></view>
        <view class="min-w-0 flex-1"><view class="text-[length:25rpx] font-semibold">活动信息</view><view class="mt-1 text-[length:20rpx] text-muted">时间、地点、名额、报名设置与内容</view></view>
        <t-icon name="chevron-right" size="34rpx" color="var(--color-muted)" />
      </view>
      <view wx:if="{{item.canRoster || item.canCheckIn}}" class="flex min-h-[104rpx] items-center gap-3 border-b border-line px-4 active:bg-panel-muted" bind:tap="openRoster">
        <view class="flex h-[64rpx] w-[64rpx] shrink-0 items-center justify-center rounded-full bg-brand-soft"><t-icon name="usergroup" size="34rpx" color="var(--color-brand)" /></view>
        <view class="min-w-0 flex-1"><view class="text-[length:25rpx] font-semibold">报名与签到</view><view class="mt-1 text-[length:20rpx] text-muted">审核、候补、联系报名者与现场签到</view></view>
        <t-icon name="chevron-right" size="34rpx" color="var(--color-muted)" />
      </view>
      <view wx:if="{{item.canManageTeam}}" class="flex min-h-[104rpx] items-center gap-3 border-b border-line px-4 active:bg-panel-muted" bind:tap="openManagers">
        <view class="flex h-[64rpx] w-[64rpx] shrink-0 items-center justify-center rounded-full bg-brand-soft"><t-icon name="user-setting" size="34rpx" color="var(--color-brand)" /></view>
        <view class="min-w-0 flex-1"><view class="text-[length:25rpx] font-semibold">团队与权限</view><view class="mt-1 text-[length:20rpx] text-muted">负责人、活动管理员和现场工作人员</view></view>
        <t-icon name="chevron-right" size="34rpx" color="var(--color-muted)" />
      </view>
      <view wx:if="{{item.canAlbum}}" class="flex min-h-[104rpx] items-center gap-3 px-4 active:bg-panel-muted" bind:tap="openAlbum">
        <view class="flex h-[64rpx] w-[64rpx] shrink-0 items-center justify-center rounded-full bg-brand-soft"><t-icon name="image" size="34rpx" color="var(--color-brand)" /></view>
        <view class="min-w-0 flex-1"><view class="text-[length:25rpx] font-semibold">活动相册</view><view class="mt-1 text-[length:20rpx] text-muted">审核成员上传的现场照片</view></view>
        <t-icon name="chevron-right" size="34rpx" color="var(--color-muted)" />
      </view>
    </view>

    <view wx:if="{{item.canEdit}}" class="mt-4 flex min-h-[96rpx] items-center justify-between rounded-[22rpx] border border-line bg-panel px-4 active:bg-panel-muted" bind:tap="openMoreActions">
      <view><view class="text-[length:24rpx] font-semibold">更多活动操作</view><view class="mt-1 text-[length:20rpx] text-muted">复制、结束或取消活动</view></view>
      <t-icon name="chevron-right" size="34rpx" color="var(--color-muted)" />
    </view>
  </block>
  <view wx:if="{{message && state === 'ready'}}" class="mt-4 rounded-[18rpx] bg-[#FFF0E8] px-4 py-3 text-[length:22rpx] text-[#9F4727]">{{message}}</view>
</view>
