<view id="admin-opportunity-editor-page" class="min-h-screen bg-canvas px-6 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-7 text-ink">
  <view class="text-[length:40rpx] font-bold">{{opportunityId ? '编辑机会' : '新增机会'}}</view>
  <view wx:if="{{state === 'loading'}}" class="mt-6 rounded-[16rpx] bg-panel p-5"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <app-empty-state wx:elif="{{state === 'error'}}" class="mt-6" title="暂时无法加载" description="{{message}}" action-text="重新加载" bind:action="load" />
  <view wx:else class="mt-5 flex flex-col gap-3">
    <view class="rounded-[16rpx] bg-panel p-4"><view class="text-[length:25rpx] font-semibold">归属范围</view><view class="mt-2 flex gap-2" role="radiogroup"><view class="flex min-h-[88rpx] items-center" role="radio" aria-checked="{{scopeType === 'PLATFORM'}}"><t-tag theme="{{scopeType === 'PLATFORM' ? 'primary' : 'default'}}" variant="outline" data-value="PLATFORM" bind:tap="chooseScope">平台</t-tag></view><view class="flex min-h-[88rpx] items-center" role="radio" aria-checked="{{scopeType === 'BRANCH'}}"><t-tag theme="{{scopeType === 'BRANCH' ? 'primary' : 'default'}}" variant="outline" data-value="BRANCH" bind:tap="chooseScope">城市分会</t-tag></view></view><picker wx:if="{{scopeType === 'BRANCH'}}" range="{{options.branches}}" range-key="name" value="{{branchIndex}}" bindchange="chooseBranch"><view class="min-h-[88rpx] rounded-[12rpx] bg-panel-raised px-3 py-3">分会：{{options.branches[branchIndex].name || '请选择'}}</view></picker></view>
    <view class="rounded-[16rpx] bg-panel p-4"><picker range="{{options.owners}}" range-key="nickname" value="{{ownerIndex}}" bindchange="chooseOwner"><view class="min-h-[88rpx] rounded-[12rpx] bg-panel-raised px-3 py-3">发布人：{{options.owners[ownerIndex].nickname || '请选择'}}</view></picker><picker class="mt-2" range="{{options.cities}}" range-key="label" value="{{cityIndex}}" bindchange="chooseCity"><view class="min-h-[88rpx] rounded-[12rpx] bg-panel-raised px-3 py-3">城市：{{options.cities[cityIndex].label || '未设置'}}</view></picker></view>
    <view class="rounded-[16rpx] bg-panel p-4"><t-input value="{{title}}" label="标题" placeholder="填写机会标题" data-field="title" bind:change="updateField" /><t-textarea class="mt-2" value="{{valueSummary}}" label="价值说明" placeholder="说明能提供的价值" data-field="valueSummary" bind:change="updateField" /><t-textarea class="mt-2" value="{{targetSummary}}" label="合作目标" placeholder="说明期望的合作" data-field="targetSummary" bind:change="updateField" /><t-textarea class="mt-2" value="{{description}}" label="详细说明" placeholder="填写具体内容" data-field="description" bind:change="updateField" /></view>
    <view class="rounded-[16rpx] bg-panel p-4"><picker mode="date" value="{{deadlineDate}}" bindchange="chooseDeadline"><view class="min-h-[88rpx] rounded-[12rpx] bg-panel-raised px-3 py-3">截止日期：{{deadlineDate || '未设置'}}</view></picker><view wx:if="{{deadlineDate}}" class="flex min-h-[88rpx] items-center justify-end text-muted" bind:tap="clearDeadline">清除截止日期</view></view>
    <view class="rounded-[16rpx] bg-panel p-4"><view class="text-[length:25rpx] font-semibold">合作角色</view><view class="mt-2 flex flex-wrap gap-1"><view wx:for="{{roles}}" wx:key="key" class="flex min-h-[88rpx] items-center" role="checkbox" aria-checked="{{item.selected}}"><t-tag variant="outline" theme="{{item.selected ? 'primary' : 'default'}}" data-key="{{item.key}}" bind:tap="toggleRole">{{item.label}}</t-tag></view></view></view>
    <view class="rounded-[16rpx] bg-panel p-4"><view class="text-[length:25rpx] font-semibold">标签</view><view class="mt-2 flex flex-wrap gap-1"><view wx:for="{{tags}}" wx:key="id" class="flex min-h-[88rpx] items-center" role="checkbox" aria-checked="{{item.selected}}"><t-tag variant="outline" theme="{{item.selected ? 'primary' : 'default'}}" data-id="{{item.id}}" bind:tap="toggleTag">{{item.label}}</t-tag></view></view></view>
    <view wx:if="{{message}}" class="rounded-[12rpx] bg-panel px-4 py-3 text-danger">{{message}}</view>
    <t-button block theme="primary" loading="{{saving}}" bind:tap="save">保存</t-button>
  </view>
  <app-page-exit />
</view>
