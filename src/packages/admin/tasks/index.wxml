<view id="admin-tasks-page" class="mip-admin-page min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-4 text-ink">
  <view class="flex items-start justify-between gap-3"><view><view class="text-[length:38rpx] font-bold">任务管理</view><view class="mt-2 text-[length:23rpx] text-muted">配置任务内容、奖励和附件要求</view></view><t-button id="admin-task-create" size="small" theme="primary" bind:tap="openCreate">新增任务</t-button></view>
  <view class="mip-admin-filter-grid mt-5 grid gap-3 rounded-[16rpx] bg-panel px-4 py-4"><view class="mip-admin-filter-wide"><input class="h-[80rpx] w-full rounded-[12rpx] bg-panel-raised px-3 text-[length:25rpx] text-ink" value="{{query}}" placeholder="搜索任务名称或内容" placeholder-class="text-muted" bindinput="updateQuery" confirm-type="search" bindconfirm="loadTasks" /></view><view class="flex flex-wrap gap-2"><t-tag variant="outline" data-status="" bind:tap="chooseStatus">全部</t-tag><t-tag variant="outline" data-status="DRAFT" bind:tap="chooseStatus">草稿</t-tag><t-tag variant="outline" data-status="PUBLISHED" bind:tap="chooseStatus">已发布</t-tag><t-tag variant="outline" data-status="UNPUBLISHED" bind:tap="chooseStatus">已下架</t-tag></view><view><t-button block variant="outline" bind:tap="openCompletions">查看完成流水</t-button></view></view>
  <view wx:if="{{editorOpen}}" class="mt-4 rounded-[16rpx] border border-brand bg-panel px-4 py-5">
    <view class="flex items-center justify-between"><view class="text-[length:28rpx] font-semibold">{{editingId ? '编辑任务' : '新增任务'}}</view><view class="text-[length:23rpx] text-muted" bind:tap="closeEditor">关闭</view></view>
    <view class="mip-admin-section-grid mt-4 grid gap-4">
      <view><view class="text-[length:23rpx] text-muted">任务名称</view><input class="mt-2 h-[80rpx] w-full rounded-[12rpx] bg-panel-raised px-3 text-[length:25rpx] text-ink" maxlength="100" value="{{name}}" bindinput="updateName" /></view>
      <view><view class="text-[length:23rpx] text-muted">奖励经验值</view><input type="number" class="mt-2 h-[80rpx] w-full rounded-[12rpx] bg-panel-raised px-3 text-[length:25rpx] text-ink" value="{{rewardExperience}}" bindinput="updateReward" /></view>
      <view class="mip-admin-span-wide"><view class="text-[length:23rpx] text-muted">任务内容</view><textarea class="mt-2 box-border min-h-[240rpx] w-full rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:25rpx] leading-[1.6] text-ink" maxlength="5000" value="{{content}}" bindinput="updateContent" /></view>
      <view class="flex min-h-[88rpx] items-center justify-between"><view><view class="text-[length:25rpx]">需要上传附件</view><view class="mt-1 text-[length:21rpx] text-muted">用户需提交一张图片</view></view><switch checked="{{attachmentRequired}}" color="#FCDF03" bindchange="toggleAttachment" /></view>
      <view><view class="text-[length:23rpx] text-muted">任务范围</view><view class="mt-2 flex gap-2"><t-tag id="task-assignment-mode-all" variant="{{assignmentMode === 'ALL' ? 'light' : 'outline'}}" theme="warning" data-mode="ALL" bind:tap="chooseAssignmentMode">全部成员</t-tag><t-tag id="task-assignment-mode-selected" variant="{{assignmentMode === 'SELECTED' ? 'light' : 'outline'}}" theme="warning" data-mode="SELECTED" bind:tap="chooseAssignmentMode">指定成员</t-tag></view></view>
      <view class="mip-admin-span-wide"><view class="text-[length:23rpx] text-muted">适用成长等级</view><view class="mt-1 text-[length:21rpx] text-muted">不选择时，全部成长等级均可完成。</view><view wx:if="{{eligibleLevelOptions.length}}" class="mt-2 flex flex-wrap gap-2"><t-tag wx:for="{{eligibleLevelOptions}}" wx:key="id" variant="{{item.selected ? 'light' : 'outline'}}" theme="warning" data-level-id="{{item.id}}" bind:tap="toggleEligibleLevel">{{item.name}} · {{item.thresholdText}}{{item.status === 'ACTIVE' ? '' : ' · 已停用'}}</t-tag></view><view wx:elif="{{eligibleLevelsState === 'error'}}" class="mt-2 text-[length:22rpx] text-danger">{{eligibleLevelsMessage}}</view><view wx:elif="{{eligibleLevelsState === 'ready'}}" class="mt-2 text-[length:22rpx] text-muted">暂无启用的成长等级。</view><view wx:else class="mt-2 text-[length:22rpx] text-muted">成长等级加载中。</view></view>
      <view class="mip-admin-span-wide"><view class="text-[length:23rpx] text-muted">截止时间</view><view class="mt-2 flex items-center gap-2"><picker class="min-h-[80rpx] flex-1 rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:25rpx]" mode="date" value="{{endsDate}}" bindchange="updateEndsDate"><view>{{endsDate || '选择日期'}}</view></picker><picker class="min-h-[80rpx] w-[180rpx] rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:25rpx]" mode="time" value="{{endsTime}}" bindchange="updateEndsTime"><view>{{endsTime}}</view></picker><t-button wx:if="{{endsDate}}" size="small" variant="text" bind:tap="clearDeadline">清除</t-button></view></view>
      <view class="mip-admin-span-wide"><view class="text-[length:23rpx] text-muted">用户模板（选填）</view><image wx:if="{{templateUrl}}" class="mip-admin-poster mt-2 h-[280rpx] w-full rounded-[12rpx] bg-panel-raised" mode="aspectFit" src="{{templateUrl}}" /><view class="mt-2 flex gap-2"><t-button size="small" variant="outline" loading="{{uploadingTemplate}}" bind:tap="uploadTemplate">{{templateAssetId ? '更换模板' : '上传模板'}}</t-button><t-button wx:if="{{templateAssetId}}" size="small" variant="text" bind:tap="removeTemplate">移除模板</t-button></view></view>
      <view class="mip-admin-span-wide"><t-button block theme="primary" loading="{{processing}}" bind:tap="saveTask">保存任务</t-button></view>
    </view>
  </view>
  <view wx:if="{{state === 'loading'}}" class="mt-5 rounded-[16rpx] bg-panel px-4 py-6"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error' || state === 'conflict'}}" class="mt-5"><app-empty-state title="暂时无法加载任务" description="{{message}}" action-text="重新加载" bind:action="loadTasks" /></view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-5"><app-empty-state title="没有任务管理权限" description="当前账号不能管理任务。" /></view>
  <view wx:elif="{{state === 'empty'}}" class="mt-5"><app-empty-state title="暂无任务" description="新增任务后可保存为草稿并发布。" action-text="新增任务" bind:action="openCreate" /></view>
  <view wx:else class="mip-admin-card-list mt-5 flex flex-col gap-3">
    <view wx:for="{{tasks}}" wx:key="id" class="rounded-[16rpx] bg-panel px-4 py-4"><view class="flex items-start justify-between gap-3"><view class="min-w-0 flex-1 text-[length:28rpx] font-semibold">{{item.name}}</view><view class="shrink-0 rounded-full bg-brand-soft px-3 py-1 text-[length:20rpx] text-brand">{{item.statusText}}</view></view><view class="mt-2 line-clamp-2 text-[length:22rpx] text-muted">{{item.content}}</view><view class="mt-3 flex flex-wrap gap-3 text-[length:21rpx] text-muted"><text>奖励 {{item.rewardExperience}} 经验值</text><text>{{item.attachmentText}}</text><text>{{item.assignmentText}}</text><text>{{item.eligibleLevelText}}</text><text>{{item.deadlineText}}</text><text>{{item.templateText}}</text><text>完成 {{item.completionCount}} 人</text></view><view class="mt-4 flex flex-wrap gap-2"><t-button size="small" variant="outline" data-id="{{item.id}}" bind:tap="editTask">编辑</t-button><t-button wx:if="{{item.assignmentMode === 'SELECTED'}}" size="small" variant="outline" data-id="{{item.id}}" data-version="{{item.version}}" bind:tap="openAssignments">派发</t-button><t-button wx:if="{{item.status !== 'PUBLISHED'}}" size="small" theme="primary" data-id="{{item.id}}" data-action="publish" bind:tap="changeStatus">发布</t-button><t-button wx:if="{{item.status === 'PUBLISHED'}}" size="small" variant="outline" data-id="{{item.id}}" data-action="unpublish" bind:tap="changeStatus">下架</t-button><t-button size="small" variant="outline" data-id="{{item.id}}" bind:tap="openCompletions">流水</t-button><t-button size="small" theme="danger" variant="text" data-id="{{item.id}}" data-action="delete" bind:tap="changeStatus">删除</t-button></view></view>
  </view>
  <view wx:if="{{nextCursor}}" class="mt-4"><t-button block variant="outline" loading="{{loadingMore}}" bind:tap="loadMore">加载更多</t-button></view>
  <view wx:if="{{message && (state === 'ready' || editorOpen)}}" class="mt-4 rounded-[12rpx] bg-panel px-4 py-3 text-[length:23rpx] text-danger">{{message}}</view>
  <app-page-exit />
</view>
