<view id="admin-orders-page" class="min-h-screen bg-canvas px-6 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-7 text-ink">
  <view class="flex items-start justify-between"><view><view class="text-[length:40rpx] font-bold">{{eventId ? '活动订单' : '订单与退款'}}</view><view class="mt-2 text-[length:23rpx] text-muted">金额和退款资格以订单记录为准</view></view><t-button wx:if="{{canExport}}" size="small" variant="outline" loading="{{exportPending}}" bind:tap="createExport">导出订单</t-button></view>
  <view class="mt-5 flex flex-wrap gap-2"><t-tag variant="outline" data-value="" bind:tap="chooseStatus">全部</t-tag><t-tag variant="outline" data-value="PAID" bind:tap="chooseStatus">已支付</t-tag><t-tag variant="outline" data-value="REFUND_PENDING" bind:tap="chooseStatus">退款中</t-tag><t-tag variant="outline" data-value="REFUNDED" bind:tap="chooseStatus">已退款</t-tag></view>
  <view wx:if="{{state === 'loading'}}" class="mt-6 rounded-[16rpx] bg-panel p-5"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error' || state === 'conflict'}}" class="mt-6"><app-empty-state title="暂时无法加载订单" description="{{message}}" action-text="重新加载" bind:action="loadOrders" /></view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-6"><app-empty-state title="没有订单权限" description="当前账号不能查看此范围的订单。" /></view>
  <view wx:elif="{{orders.length === 0}}" class="mt-6"><app-empty-state title="暂无订单" description="符合筛选条件的订单会显示在这里。" /></view>
  <view wx:else class="mt-5 flex flex-col gap-3"><view wx:for="{{orders}}" wx:key="id" class="rounded-[16rpx] bg-panel px-4 py-4"><view class="flex items-start justify-between gap-3"><view><view class="text-[length:27rpx] font-semibold">{{item.nickname}}</view><view class="mt-1 text-[length:21rpx] text-muted">{{item.orderType}} · {{item.merchantOrderNoMasked}}</view></view><t-tag variant="outline">{{item.status}}</t-tag></view><view wx:if="{{item.merchantOrderNo}}" class="mt-2 text-[length:22rpx] text-muted">业务订单号：{{item.merchantOrderNo}}</view><view wx:if="{{item.providerTransactionIdMasked}}" class="mt-1 text-[length:22rpx] text-muted">微信支付单号：{{item.providerTransactionIdMasked}}</view><view class="mt-3 text-[length:28rpx] font-semibold">{{item.amountText}}</view><view wx:if="{{item.refundedAmountCents}}" class="mt-1 text-[length:22rpx] text-muted">已退款 {{item.refundedText}}</view><view wx:if="{{item.refundStatus}}" class="mt-1 text-[length:22rpx] text-muted">退款状态：{{item.refundStatus}}</view><view wx:if="{{canRefund && (item.status === 'PAID' || item.status === 'PARTIALLY_REFUNDED')}}" class="mt-4"><t-button block variant="outline" theme="danger" loading="{{processingId === item.id}}" data-id="{{item.id}}" bind:tap="submitRefund">提交退款</t-button></view><view wx:if="{{canRefund && item.status === 'REFUND_PENDING' && item.refundId && (item.refundStatus === 'PENDING' || item.refundStatus === 'PROVIDER_CREATED' || item.refundStatus === 'PROCESSING')}}" class="mt-4"><t-button block variant="outline" loading="{{processingId === item.id}}" data-order-id="{{item.id}}" data-refund-id="{{item.refundId}}" bind:tap="retryRefund">重试退款处理</t-button></view></view></view>
  <view wx:if="{{message && state === 'ready'}}" class="mt-4 rounded-[12rpx] bg-panel px-4 py-3 text-[length:23rpx] text-danger">{{message}}</view>
  <view wx:if="{{nextCursor}}" class="mt-4"><t-button block variant="outline" loading="{{loadingMore}}" bind:tap="loadMoreOrders">加载更多</t-button></view>
  <app-page-exit />
</view>
