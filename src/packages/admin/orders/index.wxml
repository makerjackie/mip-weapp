<view id="admin-orders-page" class="mip-admin-operations-workspace mip-admin-page mip-admin-workspace-page min-h-screen bg-canvas px-6 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-7 text-ink">
  <mip-admin-workspace-nav />
  <view class="flex flex-wrap items-start justify-between gap-3">
    <view class="min-w-0 flex-1">
      <view class="text-[length:40rpx] font-bold">{{eventId ? '活动订单' : '订单与退款'}}</view>
      <view class="mt-2 text-[length:23rpx] text-muted">金额、退款状态和可用操作以服务端记录为准</view>
    </view>
    <t-button wx:if="{{canExport}}" class="shrink-0" size="small" variant="outline" loading="{{exportPending}}" bind:tap="createExport">导出订单</t-button>
  </view>

  <view class="mip-admin-filter-grid mt-5 grid gap-3 rounded-[16rpx] bg-panel p-3">
    <view class="mip-admin-filter-wide">
      <t-input class="box-border max-w-full" value="{{query}}" placeholder="搜索昵称、订单号或业务资源" bind:change="updateQuery" bind:enter="search" />
      <view class="mt-3"><t-button block size="small" variant="outline" bind:tap="search">查询</t-button></view>
    </view>
    <view class="mip-admin-filter-wide grid grid-cols-2 gap-2">
      <picker wx:if="{{!eventId}}" range="{{orderTypeOptions}}" range-key="label" value="{{orderTypeIndex}}" bindchange="changeOrderType">
        <view class="rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:22rpx]">
          <view class="text-muted">订单类型</view>
          <view class="mt-1">{{orderTypeOptions[orderTypeIndex].label}}</view>
        </view>
      </picker>
      <picker range="{{statusOptions}}" range-key="label" value="{{statusIndex}}" bindchange="changeStatus">
        <view class="rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:22rpx]">
          <view class="text-muted">订单状态</view>
          <view class="mt-1">{{statusOptions[statusIndex].label}}</view>
        </view>
      </picker>
      <picker range="{{refundStatusOptions}}" range-key="label" value="{{refundStatusIndex}}" bindchange="changeRefundStatus">
        <view class="rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:22rpx]">
          <view class="text-muted">退款状态</view>
          <view class="mt-1">{{refundStatusOptions[refundStatusIndex].label}}</view>
        </view>
      </picker>
    </view>
    <view class="mip-admin-filter-wide grid grid-cols-2 gap-2">
      <picker mode="date" value="{{createdFromDate}}" data-field="createdFromDate" bindchange="changeCreatedDate">
        <view class="rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:22rpx]">
          <view class="text-muted">创建日期起</view>
          <view class="mt-1">{{createdFromDate || '不限'}}</view>
        </view>
      </picker>
      <picker mode="date" value="{{createdToDate}}" data-field="createdToDate" bindchange="changeCreatedDate">
        <view class="rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:22rpx]">
          <view class="text-muted">创建日期止</view>
          <view class="mt-1">{{createdToDate || '不限'}}</view>
        </view>
      </picker>
    </view>
    <view wx:if="{{createdFromDate || createdToDate}}" class="flex min-h-[80rpx] items-center justify-end text-[length:21rpx] text-muted" bind:tap="clearCreatedDates">清除日期</view>
  </view>

  <view wx:if="{{state === 'ready'}}" class="mt-5 rounded-[16rpx] bg-panel px-4 py-4">
    <view class="flex items-center justify-between"><view class="text-[length:27rpx] font-semibold">收费汇总</view><view class="text-[length:21rpx] text-muted">{{summary.orderCount}} 笔订单 · {{summary.paidOrderCount}} 笔已支付</view></view>
    <view class="mip-admin-summary-grid mt-3 grid grid-cols-2 gap-2 text-[length:22rpx]"><view class="rounded-[10rpx] bg-panel-raised px-3 py-3"><view class="text-muted">活动收入</view><view class="mt-1 font-semibold">{{summary.eventGrossText}}</view></view><view class="rounded-[10rpx] bg-panel-raised px-3 py-3"><view class="text-muted">会员收入</view><view class="mt-1 font-semibold">{{summary.membershipGrossText}}</view></view><view class="rounded-[10rpx] bg-panel-raised px-3 py-3"><view class="text-muted">收费总额</view><view class="mt-1 font-semibold">{{summary.grossText}}</view></view><view class="rounded-[10rpx] bg-panel-raised px-3 py-3"><view class="text-muted">退款金额</view><view class="mt-1 font-semibold">{{summary.refundedText}}</view></view></view>
    <view class="mt-3 flex items-end justify-between border-0 border-t border-solid border-line pt-3"><view class="text-[length:22rpx] text-muted">净收费</view><view class="text-[length:29rpx] font-bold text-brand">{{summary.netText}}</view></view>
  </view>

  <view wx:if="{{state === 'loading'}}" class="mt-6 rounded-[16rpx] bg-panel p-5">
    <t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading />
  </view>
  <view wx:elif="{{state === 'error' || state === 'conflict'}}" class="mt-6">
    <app-empty-state title="暂时无法加载订单" description="{{message}}" action-text="重新加载" bind:action="loadOrders" />
  </view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-6">
    <app-empty-state title="没有订单权限" description="当前账号不能查看此范围的订单。" />
  </view>
  <view wx:elif="{{orders.length === 0}}" class="mt-6">
    <app-empty-state title="暂无订单" description="符合筛选条件的订单会显示在这里。" />
  </view>
  <view wx:else class="mip-admin-record-list mt-5" style="--mip-admin-record-columns: minmax(0, 1.35fr) minmax(0, 1.65fr) minmax(0, 1.25fr) minmax(0, 1.45fr);">
    <view class="mip-admin-record-header">
      <view>用户与订单</view><view>业务资源</view><view>金额与时间</view><view>状态与操作</view>
    </view>
    <view wx:for="{{orders}}" wx:key="id" class="mip-admin-record-row">
      <view class="mip-admin-record-cell">
        <view class="mip-admin-record-label">用户与订单</view>
        <view class="break-all text-[length:27rpx] font-semibold">{{item.nickname}}</view>
        <view class="mt-1 text-[length:22rpx] text-muted">{{item.orderTypeText}}</view>
        <view class="mt-1 break-all text-[length:21rpx] text-muted">订单号：{{item.merchantOrderNoMasked}}</view>
      </view>
      <view class="mip-admin-record-cell">
        <view class="mip-admin-record-label">业务资源</view>
        <view class="break-all text-[length:24rpx] font-semibold">{{item.resourceTitle}}</view>
        <view class="mt-1 text-[length:21rpx] text-muted">{{item.resourceTypeText}}{{item.resourceBranchName ? ' · ' + item.resourceBranchName : ''}}</view>
        <view wx:if="{{item.providerTransactionIdMasked}}" class="mt-2 break-all text-[length:21rpx] text-muted">微信支付单号：{{item.providerTransactionIdMasked}}</view>
        <view wx:if="{{item.entitlementWindowText}}" class="mt-2 break-all text-[length:21rpx] text-muted">会员权益有效期：{{item.entitlementWindowText}}</view>
      </view>
      <view class="mip-admin-record-cell">
        <view class="mip-admin-record-label">金额与时间</view>
        <view class="text-[length:21rpx] text-muted">订单金额</view>
        <view class="mt-1 text-[length:27rpx] font-semibold">{{item.amountText}}</view>
        <view class="mt-2 text-[length:21rpx] text-muted">已退金额：{{item.refundedText}}</view>
        <view class="mt-2 text-[length:21rpx] text-muted">创建：{{item.createdText}}</view>
        <view class="mt-1 text-[length:21rpx] text-muted">支付：{{item.paidText || '未支付'}}</view>
      </view>
      <view class="mip-admin-record-cell">
        <view class="mip-admin-record-label">状态与操作</view>
        <t-tag variant="outline" theme="{{item.statusTheme}}">{{item.statusText}}</t-tag>
        <view class="mt-2 text-[length:22rpx] text-muted">退款状态：{{item.refundStatusText}}</view>
        <view class="mip-admin-record-actions mt-3">
          <t-button block variant="outline" data-id="{{item.id}}" bind:tap="openOrderDetail">查看详情</t-button>
        </view>
        <view wx:if="{{item.canSubmitRefund && (item.status === 'PAID' || item.status === 'PARTIALLY_REFUNDED')}}" class="mip-admin-record-actions mt-3">
          <t-button block variant="outline" theme="danger" loading="{{processingId === item.id}}" data-id="{{item.id}}" bind:tap="submitRefund">提交退款</t-button>
        </view>
        <view wx:if="{{item.canRetryRefund && item.status === 'REFUND_PENDING' && item.refundId && (item.refundStatus === 'PENDING' || item.refundStatus === 'PROVIDER_CREATED' || item.refundStatus === 'PROCESSING')}}" class="mip-admin-record-actions mt-3">
          <t-button block variant="outline" loading="{{processingId === item.id}}" data-order-id="{{item.id}}" data-refund-id="{{item.refundId}}" bind:tap="retryRefund">重试退款处理</t-button>
        </view>
      </view>
    </view>
  </view>
  <view wx:if="{{message && state === 'ready'}}" class="mt-4 rounded-[12rpx] bg-panel px-4 py-3 text-[length:23rpx] text-danger">{{message}}</view>
  <view wx:if="{{nextCursor}}" class="mt-4">
    <t-button block variant="outline" loading="{{loadingMore}}" bind:tap="loadMoreOrders">加载更多</t-button>
  </view>
  <app-page-exit />
  <mip-admin-responsive-panel visible="{{detailOpen}}" title="订单详情" bind:close="closeOrderDetail" bind:visible-change="handleDetailVisibility">
    <view wx:if="{{detailState === 'loading'}}" class="mt-4">
      <t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading />
    </view>
    <view wx:elif="{{detailState === 'error'}}" class="mt-4">
      <app-empty-state title="订单详情加载失败" description="{{detailMessage}}" action-text="重新加载" bind:action="retryOrderDetail" />
    </view>
    <view wx:else class="mt-3 flex flex-col gap-3">
      <view class="rounded-[16rpx] bg-panel-raised px-4 py-4">
        <view class="flex items-start justify-between gap-3">
          <view class="min-w-0 flex-1"><view class="break-all text-[length:28rpx] font-semibold">{{detail.product.title}}</view><view class="mt-1 text-[length:21rpx] text-muted">{{detail.order.orderTypeText}} · {{detail.product.resourceTypeText}}</view></view>
          <t-tag variant="outline">{{detail.order.statusText}}</t-tag>
        </view>
        <view class="mt-4 grid grid-cols-2 gap-2 text-[length:22rpx]">
          <view class="rounded-[12rpx] bg-panel px-3 py-3"><view class="text-muted">订单金额</view><view class="mt-1 font-semibold">{{detail.order.amountText}}</view></view>
          <view class="rounded-[12rpx] bg-panel px-3 py-3"><view class="text-muted">已退金额</view><view class="mt-1 font-semibold">{{detail.order.refundedText}}</view></view>
        </view>
        <view class="mt-3 break-all text-[length:21rpx] text-muted">订单号：{{detail.order.merchantOrderNoMasked}}</view>
        <view wx:if="{{detail.order.providerTransactionIdMasked}}" class="mt-1 break-all text-[length:21rpx] text-muted">支付单号：{{detail.order.providerTransactionIdMasked}}</view>
        <view class="mt-3 grid grid-cols-2 gap-2 text-[length:20rpx] text-muted"><view>创建：{{detail.order.createdText}}</view><view>更新：{{detail.order.updatedText}}</view><view>支付：{{detail.order.paidText}}</view><view>关闭：{{detail.order.closedText}}</view></view>
      </view>

      <view class="rounded-[16rpx] bg-panel-raised px-4 py-4">
        <view class="text-[length:25rpx] font-semibold">买家</view>
        <view class="mt-3 flex items-start justify-between gap-3"><view><view class="text-[length:25rpx]">{{detail.buyer.nickname}}</view><view class="mt-1 text-[length:21rpx] text-muted">{{detail.buyer.kindText}} · {{detail.buyer.accountStatusText}}</view></view><view class="text-right text-[length:21rpx] text-muted">{{detail.buyer.locationText}}</view></view>
      </view>

      <view class="rounded-[16rpx] bg-panel-raised px-4 py-4">
        <view class="text-[length:25rpx] font-semibold">商品快照</view>
        <view wx:if="{{detail.product.branchName}}" class="mt-1 text-[length:21rpx] text-muted">{{detail.product.branchName}}</view>
        <view wx:if="{{detail.product.facts.length}}" class="mt-3 grid grid-cols-2 gap-2">
          <view wx:for="{{detail.product.facts}}" wx:key="label" class="rounded-[12rpx] bg-panel px-3 py-3"><view class="text-[length:20rpx] text-muted">{{item.label}}</view><view class="mt-1 text-[length:22rpx]">{{item.value}}</view></view>
        </view>
        <view wx:if="{{detail.product.benefits.length}}" class="mt-3"><view class="text-[length:21rpx] text-muted">权益快照</view><view class="mt-2 flex flex-wrap gap-2"><view wx:for="{{detail.product.benefits}}" wx:key="*this" class="rounded-full bg-panel px-3 py-2 text-[length:20rpx]">{{item}}</view></view></view>
        <view wx:if="{{!detail.product.facts.length && !detail.product.benefits.length}}" class="mt-3 text-[length:21rpx] text-muted">当前订单没有可展示的商品快照字段。</view>
      </view>

      <view class="rounded-[16rpx] bg-panel-raised px-4 py-4">
        <view class="text-[length:25rpx] font-semibold">订单状态时间线</view>
        <view class="mt-1 text-[length:19rpx] text-muted">仅展示有明确记录时间的状态节点。</view>
        <view wx:for="{{detail.statusTimeline}}" wx:key="key" class="mt-3 border-0 border-t border-solid border-line pt-3"><view class="flex items-center justify-between gap-3"><view class="text-[length:22rpx]">{{item.statusText}}</view><view class="text-[length:20rpx] text-muted">{{item.occurredText}}</view></view><view class="mt-1 text-[length:19rpx] text-muted">{{item.evidenceText}}</view></view>
        <view wx:if="{{!detail.statusTimeline.length}}" class="mt-3 text-[length:21rpx] text-muted">暂无可核验的状态变更记录。</view>
      </view>

      <view class="rounded-[16rpx] bg-panel-raised px-4 py-4">
        <view class="text-[length:25rpx] font-semibold">支付处理</view>
        <view wx:if="{{detail.payment.attempts.length}}" class="mt-3 flex flex-col gap-2"><view wx:for="{{detail.payment.attempts}}" wx:key="key" class="rounded-[12rpx] bg-panel px-3 py-3"><view class="flex items-center justify-between gap-3"><view class="text-[length:22rpx]">{{item.providerText}}</view><view class="text-[length:21rpx] {{item.requiresAttention ? 'text-danger' : 'text-muted'}}">{{item.statusText}}</view></view><view wx:if="{{item.providerPaymentIdMasked}}" class="mt-2 break-all text-[length:20rpx] text-muted">支付引用：{{item.providerPaymentIdMasked}}</view><view class="mt-2 text-[length:19rpx] text-muted">创建 {{item.createdText}} · 更新 {{item.updatedText}}</view><view wx:if="{{item.requiresAttention}}" class="mt-2 text-[length:20rpx] text-danger">当前记录需要核对。</view></view></view>
        <view wx:else class="mt-3 text-[length:21rpx] text-muted">暂无支付尝试记录。</view>
        <view class="mt-4 text-[length:22rpx] font-semibold">支付回调</view>
        <view wx:if="{{detail.payment.callbacks.length}}" class="mt-2 flex flex-col gap-2"><view wx:for="{{detail.payment.callbacks}}" wx:key="key" class="rounded-[12rpx] bg-panel px-3 py-3"><view class="flex items-center justify-between gap-3"><view class="text-[length:21rpx]">{{item.statusText}}</view><view class="text-[length:20rpx] {{item.requiresAttention ? 'text-danger' : 'text-muted'}}">{{item.verificationStatus === 'VERIFIED' ? '已验证' : '未通过验证'}}</view></view><view class="mt-2 text-[length:19rpx] text-muted">接收 {{item.createdText}} · 处理 {{item.processedText}}</view></view></view>
        <view wx:else class="mt-2 text-[length:21rpx] text-muted">暂无可关联的支付回调记录。</view>
      </view>

      <view class="rounded-[16rpx] bg-panel-raised px-4 py-4">
        <view class="text-[length:25rpx] font-semibold">退款记录</view>
        <view wx:if="{{detail.refunds.length}}" class="mt-3 flex flex-col gap-3"><view wx:for="{{detail.refunds}}" wx:key="id" class="rounded-[12rpx] bg-panel px-3 py-3"><view class="flex items-center justify-between gap-3"><view class="text-[length:23rpx] font-semibold">{{item.amountText}}</view><view class="text-[length:21rpx] {{item.requiresAttention ? 'text-danger' : 'text-muted'}}">{{item.statusText}}</view></view><view class="mt-2 text-[length:20rpx] text-muted">发起方：{{item.requestedByText}} · {{item.createdText}}</view><view wx:if="{{item.reason}}" class="mt-2 text-[length:21rpx]">原因：{{item.reason}}</view><view class="mt-2 break-all text-[length:19rpx] text-muted">退款单号：{{item.merchantRefundNoMasked}}</view><view wx:if="{{item.providerRefundIdMasked}}" class="mt-1 break-all text-[length:19rpx] text-muted">支付平台退款号：{{item.providerRefundIdMasked}}</view><view wx:if="{{item.callback}}" class="mt-2 text-[length:20rpx] text-muted">回调：{{item.callback.statusText}} · {{item.callback.processedText}}</view><view wx:if="{{item.requiresAttention}}" class="mt-2 text-[length:20rpx] text-danger">当前退款记录需要核对。</view><view wx:if="{{item.statusTimeline.length}}" class="mt-3 border-0 border-t border-solid border-line pt-2"><view wx:for="{{item.statusTimeline}}" wx:for-item="step" wx:key="key" class="mt-2 flex items-center justify-between gap-3 text-[length:19rpx]"><view>{{step.statusText}} · {{step.evidenceText}}</view><view class="text-muted">{{step.occurredText}}</view></view></view><view wx:else class="mt-3 text-[length:19rpx] text-muted">暂无可核验的退款状态变更记录。</view></view></view>
        <view wx:else class="mt-3 text-[length:21rpx] text-muted">暂无退款记录。</view>
      </view>

      <view class="rounded-[16rpx] bg-panel-raised px-4 py-4">
        <view class="text-[length:25rpx] font-semibold">关联权益时间线</view>
        <view wx:if="{{detail.entitlementTimeline.length}}" class="mt-3 flex flex-col gap-2"><view wx:for="{{detail.entitlementTimeline}}" wx:key="key" class="rounded-[12rpx] bg-panel px-3 py-3"><view class="flex items-center justify-between gap-3"><view class="text-[length:22rpx]">{{item.kindText}}</view><view class="text-[length:21rpx] text-muted">{{item.statusText}}</view></view><view class="mt-2 text-[length:20rpx] text-muted">生效：{{item.startsText}}</view><view class="mt-1 text-[length:20rpx] text-muted">到期：{{item.endsText}}</view><view wx:if="{{item.kind === 'CONTENT'}}" class="mt-1 text-[length:20rpx] text-muted">首次访问：{{item.firstAccessedText}}</view><view wx:if="{{item.revokedAt}}" class="mt-1 text-[length:20rpx] text-muted">撤销：{{item.revokedText}}</view></view></view>
        <view wx:else class="mt-3 text-[length:21rpx] text-muted">暂无关联权益记录。</view>
      </view>
    </view>
  </mip-admin-responsive-panel>
</view>
