<view id="admin-orders-page" class="min-h-screen bg-canvas px-6 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-7 text-ink">
  <view class="border-b border-ink pb-5"><view class="text-[length:21rpx] font-semibold tracking-[0.16em] text-gold">财务与售后</view><view class="mt-2 text-[length:44rpx] font-bold">订单与退款</view></view>
  <view wx:if="{{state === 'loading'}}" class="mt-7 bg-panel px-5 py-8"><t-skeleton row-col="{{[1, 1, 1, 1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}" class="mt-7"><app-empty-state title="暂时无法加载订单" description="服务暂时没有响应，请稍后重试。" action-text="重新加载" bind:action="loadOrders" /></view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-7">
    <app-empty-state
      title="没有运营权限"
      description="请使用已授权的运营账号进入，或联系主理人开通权限。"
      action-text="重新验证"
      bind:action="loadOrders"
    />
  </view>
  <view wx:elif="{{orders.length === 0}}" class="mt-7"><app-empty-state title="还没有订单" description="用户完成会员下单后会出现在这里。" /></view>
  <view wx:else class="mt-6 flex flex-col gap-4">
    <view wx:for="{{orders}}" wx:key="id" class="border border-line bg-panel">
      <view class="flex items-center justify-between border-b border-line px-4 py-3 text-[length:20rpx]"><view class="text-muted">{{item.orderText}}</view><view class="font-semibold text-brand">{{item.statusText}}</view></view>
      <view class="px-5 py-5">
        <view class="flex items-end justify-between gap-3"><view class="min-w-0 flex-1"><view class="truncate text-[length:28rpx] font-semibold">{{item.planName}}</view><view class="mt-2 text-[length:21rpx] text-muted">{{item.createdText}}</view></view><view class="shrink-0 text-[length:34rpx] font-bold text-coral">{{item.amountText}}</view></view>
        <view wx:if="{{item.canRefund}}" class="mt-5 active:opacity-70"><t-button block theme="danger" variant="outline" loading="{{processingId === item.id}}" data-order-id="{{item.id}}" bind:tap="refund">{{item.refundActionText}}</t-button></view>
        <view wx:if="{{item.canConfirmRefund}}" class="mt-5 border-l-[8rpx] border-gold bg-canvas px-4 py-4">
          <view class="text-[length:23rpx] font-semibold">微信已退款，但状态还没自动更新？</view>
          <view class="mt-2 text-[length:21rpx] leading-5 text-muted">请先在微信支付账单或商户平台确认款项已退回，再手动完成订单。</view>
          <view class="mt-4 active:opacity-70"><t-button block theme="primary" variant="outline" loading="{{processingId === item.id}}" data-order-id="{{item.id}}" data-refund-id="{{item.refundId}}" bind:tap="confirmRefund">确认已退款到账</t-button></view>
        </view>
      </view>
    </view>
  </view>
  <view wx:if="{{message && state === 'ready'}}" class="mt-5 border-l-[8rpx] border-coral bg-panel px-4 py-4 text-[length:24rpx] text-muted">{{message}}</view>
  <view class="mt-5 text-[length:21rpx] leading-5 text-muted">退款状态会自动同步；只有微信回调或负责人确认到账后，订单与会员权益才会更新。</view>
  <app-page-exit />
</view>
