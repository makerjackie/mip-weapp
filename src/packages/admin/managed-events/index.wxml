<view id="admin-managed-events-page" class="mip-admin-page min-h-screen bg-canvas px-6 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-7 text-ink">
  <view class="flex items-center justify-between"><view><view class="text-[length:40rpx] font-bold">活动管理</view><view class="mt-1 text-[length:24rpx] text-muted">查看和处理全部授权活动</view></view><t-button wx:if="{{canCreate}}" size="small" theme="primary" bind:tap="createEvent">新建活动</t-button></view><view class="mt-3"><t-button block variant="outline" bind:tap="openParticipants">活动参与者</t-button></view>
  <view class="mt-5 rounded-[16rpx] bg-panel p-3"><t-input value="{{query}}" placeholder="搜索活动名称" bind:change="updateQuery" bind:enter="search" /><view class="mt-3 flex flex-wrap gap-1" role="radiogroup"><view class="flex min-h-[88rpx] items-center" role="radio" aria-checked="{{status === ''}}"><t-tag variant="outline" theme="{{status === '' ? 'primary' : 'default'}}" data-value="" bind:tap="changeStatus">全部</t-tag></view><view class="flex min-h-[88rpx] items-center" role="radio" aria-checked="{{status === 'PUBLISHED'}}"><t-tag variant="outline" theme="{{status === 'PUBLISHED' ? 'primary' : 'default'}}" data-value="PUBLISHED" bind:tap="changeStatus">已发布</t-tag></view><view class="flex min-h-[88rpx] items-center" role="radio" aria-checked="{{status === 'DRAFT'}}"><t-tag variant="outline" theme="{{status === 'DRAFT' ? 'primary' : 'default'}}" data-value="DRAFT" bind:tap="changeStatus">草稿</t-tag></view><view class="flex min-h-[88rpx] items-center" role="radio" aria-checked="{{status === 'UNPUBLISHED'}}"><t-tag variant="outline" theme="{{status === 'UNPUBLISHED' ? 'primary' : 'default'}}" data-value="UNPUBLISHED" bind:tap="changeStatus">已下架</t-tag></view><view class="flex min-h-[88rpx] items-center" role="radio" aria-checked="{{status === 'ARCHIVED'}}"><t-tag variant="outline" theme="{{status === 'ARCHIVED' ? 'primary' : 'default'}}" data-value="ARCHIVED" bind:tap="changeStatus">已归档</t-tag></view></view></view>
  <view wx:if="{{state === 'ready' && canManagePolicy}}" class="mt-4 rounded-[16rpx] bg-panel px-4 py-4">
    <view class="text-[length:27rpx] font-semibold">默认取消报名时间</view>
    <view class="mt-1 text-[length:22rpx] text-muted">活动未单独设置时，参与者可在开始前指定小时数之前取消。0 表示开始前均可取消。</view>
    <view class="mt-3 flex items-center gap-3"><input class="box-border h-[72rpx] min-w-0 flex-1 rounded-[12rpx] bg-panel-raised px-3 text-[length:24rpx]" type="number" value="{{cancellationHoursBeforeStart}}" maxlength="3" bindinput="updateCancellationHours" /><view class="text-[length:23rpx] text-muted">小时</view><t-button size="small" theme="primary" loading="{{policySaving}}" bind:tap="saveEventPolicy">保存</t-button></view>
  </view>
  <view wx:if="{{state === 'loading'}}" class="mt-6 rounded-[16rpx] bg-panel p-5"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error' || state === 'conflict'}}" class="mt-6"><app-empty-state title="暂时无法加载活动" description="{{message}}" action-text="重新加载" bind:action="loadEvents" /></view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-6"><app-empty-state title="没有活动管理权限" description="当前账号不能查看活动管理内容。" /></view>
  <view wx:elif="{{events.length === 0 && canCreate}}" class="mt-6"><app-empty-state title="没有符合条件的活动" description="调整筛选条件或新建活动。" action-text="新建活动" bind:action="createEvent" /></view>
  <view wx:elif="{{events.length === 0}}" class="mt-6"><app-empty-state title="没有符合条件的活动" description="授权范围内的活动会显示在这里。" /></view>
  <view wx:else class="mip-admin-card-list mt-5 flex flex-col gap-3">
    <view wx:for="{{events}}" wx:key="id" class="rounded-[16rpx] bg-panel px-4 py-4" data-id="{{item.id}}" bind:tap="openEvent">
      <view class="flex items-start justify-between gap-3"><view class="min-w-0 flex-1 text-[length:29rpx] font-semibold">{{item.title}}</view><t-tag variant="outline" theme="{{item.statusTheme}}">{{item.statusText}}</t-tag></view>
      <view class="mt-2 text-[length:23rpx] text-muted">{{item.cityName || '未设置城市'}} · {{item.startsText}}</view>
      <view class="mt-3 flex gap-5 text-[length:23rpx]"><view>有效报名 {{item.registrationCount}}</view><view>签到 {{item.attendedCount}}</view></view>
      <view wx:if="{{item.canClone || item.status === 'DRAFT'}}" class="mt-3 flex flex-col gap-2">
        <t-button wx:if="{{item.canClone}}" block variant="outline" loading="{{cloneBusyId === item.id}}" disabled="{{processingId || cloneBusyId}}" data-id="{{item.id}}" data-version="{{item.version}}" catch:tap="cloneEvent">复制为草稿</t-button>
        <t-button wx:if="{{item.status === 'DRAFT'}}" block variant="outline" theme="danger" loading="{{processingId === item.id}}" disabled="{{processingId || cloneBusyId}}" data-id="{{item.id}}" data-version="{{item.version}}" catch:tap="archiveEvent">归档草稿</t-button>
      </view>
    </view>
  </view>
  <view wx:if="{{message && state === 'ready'}}" class="mt-4 rounded-[12rpx] bg-panel px-4 py-3 text-[length:23rpx] text-danger">{{message}}</view>
  <view wx:if="{{nextCursor}}" class="mt-4"><t-button block variant="outline" loading="{{loadingMore}}" bind:tap="loadMoreEvents">加载更多</t-button></view>
  <app-page-exit />
</view>
