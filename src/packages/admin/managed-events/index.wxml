<view id="admin-managed-events-page" class="min-h-screen bg-canvas px-6 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-7 text-ink">
  <view class="flex items-center justify-between"><view><view class="text-[length:40rpx] font-bold">活动管理</view><view class="mt-1 text-[length:24rpx] text-muted">查看和处理全部授权活动</view></view><t-button wx:if="{{canCreate}}" size="small" theme="primary" bind:tap="createEvent">新建活动</t-button></view>
  <view class="mt-5 rounded-[16rpx] bg-panel p-3"><t-input value="{{query}}" placeholder="搜索活动名称" bind:change="updateQuery" bind:enter="search" /><view class="mt-3 flex flex-wrap gap-2"><t-tag variant="outline" data-value="" bind:tap="changeStatus">全部</t-tag><t-tag variant="outline" data-value="PUBLISHED" bind:tap="changeStatus">已发布</t-tag><t-tag variant="outline" data-value="DRAFT" bind:tap="changeStatus">草稿</t-tag><t-tag variant="outline" data-value="UNPUBLISHED" bind:tap="changeStatus">已下架</t-tag></view></view>
  <view wx:if="{{state === 'loading'}}" class="mt-6 rounded-[16rpx] bg-panel p-5"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error' || state === 'conflict'}}" class="mt-6"><app-empty-state title="暂时无法加载活动" description="{{message}}" action-text="重新加载" bind:action="loadEvents" /></view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-6"><app-empty-state title="没有活动管理权限" description="当前账号不能查看活动管理内容。" /></view>
  <view wx:elif="{{events.length === 0 && canCreate}}" class="mt-6"><app-empty-state title="没有符合条件的活动" description="调整筛选条件或新建活动。" action-text="新建活动" bind:action="createEvent" /></view>
  <view wx:elif="{{events.length === 0}}" class="mt-6"><app-empty-state title="没有符合条件的活动" description="授权范围内的活动会显示在这里。" /></view>
  <view wx:else class="mt-5 flex flex-col gap-3">
    <view wx:for="{{events}}" wx:key="id" class="rounded-[16rpx] bg-panel px-4 py-4" data-id="{{item.id}}" bind:tap="openEvent">
      <view class="flex items-start justify-between gap-3"><view class="min-w-0 flex-1 text-[length:29rpx] font-semibold">{{item.title}}</view><t-tag variant="outline">{{item.status}}</t-tag></view>
      <view class="mt-2 text-[length:23rpx] text-muted">{{item.cityName || '未设置城市'}} · {{item.startsAt}}</view>
      <view class="mt-3 flex gap-5 text-[length:23rpx]"><view>报名 {{item.registrationCount}}</view><view>签到 {{item.attendedCount}}</view><view>版本 {{item.version}}</view></view>
    </view>
  </view>
  <view wx:if="{{message && state === 'ready'}}" class="mt-4 rounded-[12rpx] bg-panel px-4 py-3 text-[length:23rpx] text-danger">{{message}}</view>
  <view wx:if="{{nextCursor}}" class="mt-4"><t-button block variant="outline" loading="{{loadingMore}}" bind:tap="loadMoreEvents">加载更多</t-button></view>
  <app-page-exit />
</view>
