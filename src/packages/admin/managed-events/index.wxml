<view id="admin-managed-events-page" class="mip-admin-page mip-admin-workspace-page min-h-screen bg-canvas px-6 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-7 text-ink">
  <mip-admin-workspace-nav />
  <view class="mip-managed-events-header flex items-start justify-between gap-4">
    <view class="min-w-0"><view class="text-[length:40rpx] font-bold">活动管理</view><view class="mt-1 text-[length:24rpx] text-muted">查看和处理全部授权活动</view></view>
    <view class="mip-managed-events-header-actions flex shrink-0 flex-wrap justify-end gap-2">
      <view class="mip-managed-events-header-action"><t-button class="mip-managed-events-header-button" size="small" variant="outline" bind:tap="openParticipants">活动参与者</t-button></view>
      <view wx:if="{{canCreate}}" class="mip-managed-events-header-action"><t-button class="mip-managed-events-header-button" size="small" theme="primary" bind:tap="createEvent">新建活动</t-button></view>
    </view>
  </view>
  <view class="mip-managed-events-filter mip-admin-filter-grid mt-5 grid gap-3 rounded-[16rpx] bg-panel p-3">
    <view class="mip-admin-filter-wide"><t-input class="box-border max-w-full" value="{{query}}" placeholder="搜索活动名称" bind:change="updateQuery" bind:enter="search" /></view>
    <t-input class="box-border max-w-full" value="{{cityOrBranch}}" placeholder="城市或分会" data-field="cityOrBranch" bind:change="updateTextFilter" />
    <picker range="{{eventTypeOptions}}" range-key="label" value="{{eventTypeIndex}}" bindchange="changeEventType"><view class="box-border min-h-[88rpx] rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:22rpx]"><view class="text-muted">活动类型</view><view class="mt-1">{{eventTypeOptions[eventTypeIndex].label}}</view></view></picker>
    <picker mode="date" value="{{startsFromDate}}" data-field="startsFromDate" bindchange="changeStartsDate"><view class="box-border min-h-[88rpx] rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:22rpx]"><view class="text-muted">开始日期起</view><view class="mt-1">{{startsFromDate || '不限'}}</view></view></picker>
    <picker mode="date" value="{{startsToDate}}" data-field="startsToDate" bindchange="changeStartsDate"><view class="box-border min-h-[88rpx] rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:22rpx]"><view class="text-muted">开始日期止</view><view class="mt-1">{{startsToDate || '不限'}}</view></view></picker>
    <picker range="{{accessTypeOptions}}" range-key="label" value="{{accessTypeIndex}}" bindchange="changeAccessType"><view class="box-border min-h-[88rpx] rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:22rpx]"><view class="text-muted">收费类型</view><view class="mt-1">{{accessTypeOptions[accessTypeIndex].label}}</view></view></picker>
    <picker range="{{sortOptions}}" range-key="label" value="{{sortIndex}}" bindchange="changeSort"><view class="box-border min-h-[88rpx] rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:22rpx]"><view class="text-muted">排序</view><view class="mt-1">{{sortOptions[sortIndex].label}}</view></view></picker>
    <t-input class="box-border max-w-full" type="digit" value="{{priceMinYuan}}" placeholder="最低价格（元）" data-field="priceMinYuan" bind:change="updateTextFilter" />
    <t-input class="box-border max-w-full" type="digit" value="{{priceMaxYuan}}" placeholder="最高价格（元）" data-field="priceMaxYuan" bind:change="updateTextFilter" />
    <view class="mip-admin-span-wide flex flex-wrap gap-1" role="radiogroup" aria-label="活动状态"><view wx:for="{{statuses}}" wx:key="value" class="flex min-h-[88rpx] items-center" role="radio" aria-checked="{{status === item.value}}"><t-tag variant="outline" theme="{{status === item.value ? 'primary' : 'default'}}" data-value="{{item.value}}" bind:tap="changeStatus">{{item.label}}</t-tag></view></view>
    <view class="mip-admin-filter-actions mip-admin-span-wide"><view class="mip-managed-events-filter-action min-w-0"><t-button block variant="outline" bind:tap="clearFilters">清除筛选</t-button></view><view class="mip-managed-events-filter-action min-w-0"><t-button block theme="primary" bind:tap="search">查询</t-button></view></view>
  </view>
  <view wx:if="{{state === 'ready' && canManagePolicy}}" class="mt-4 rounded-[16rpx] bg-panel px-4 py-4">
    <view class="text-[length:27rpx] font-semibold">默认取消报名时间</view>
    <view class="mt-1 text-[length:22rpx] text-muted">活动未单独设置时，参与者可在开始前指定小时数之前取消。0 表示开始前均可取消。</view>
    <view class="mt-3 flex items-center gap-3"><input class="box-border h-[72rpx] min-w-0 flex-1 rounded-[12rpx] bg-panel-raised px-3 text-[length:24rpx]" type="number" value="{{cancellationHoursBeforeStart}}" maxlength="3" bindinput="updateCancellationHours" /><view class="text-[length:23rpx] text-muted">小时</view><t-button size="small" theme="primary" loading="{{policySaving}}" bind:tap="saveEventPolicy">保存</t-button></view>
  </view>
  <view wx:if="{{state === 'loading'}}" class="mt-6 rounded-[16rpx] bg-panel p-5"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error' || state === 'conflict'}}" class="mt-6"><app-empty-state title="暂时无法加载活动" description="{{message}}" action-text="重新加载" bind:action="loadEvents" /></view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-6"><app-empty-state title="没有活动管理权限" description="当前账号不能查看活动管理内容。" /></view>
  <view wx:elif="{{events.length === 0 && canCreate}}" class="mt-6"><app-empty-state title="没有符合条件的活动" description="调整筛选条件或新建活动。" action-text="新建活动" bind:action="createEvent" /></view>
  <view wx:elif="{{events.length === 0}}" class="mt-6"><app-empty-state title="没有符合条件的活动" description="授权范围内的活动会显示在这里。" /></view>
  <view wx:else class="mip-admin-record-list mt-5" style="--mip-admin-record-columns: minmax(0, 2fr) minmax(0, 1.5fr) minmax(0, 1fr) minmax(0, 1.5fr);">
    <view class="mip-admin-record-header">
      <view>活动</view><view>时间与城市</view><view>报名与签到</view><view>状态与操作</view>
    </view>
    <view wx:for="{{events}}" wx:key="id" class="mip-admin-record-row" data-id="{{item.id}}" bind:tap="openEvent">
      <view class="mip-admin-record-cell">
        <view class="mip-admin-record-label">活动</view>
        <view class="text-[length:29rpx] font-semibold">{{item.title}}</view>
        <view class="mt-2 text-[length:22rpx] text-muted">类型：{{item.eventTypeText}}</view>
        <view class="mt-1 text-[length:22rpx] text-muted">{{item.accessTypeText}} · {{item.priceText}}</view>
      </view>
      <view class="mip-admin-record-cell">
        <view class="mip-admin-record-label">时间与城市</view>
        <view class="text-[length:23rpx] text-muted">{{item.startsText}}</view>
        <view class="mt-1 text-[length:23rpx] text-muted">{{item.cityName || '未设置城市'}}</view>
        <view class="mt-1 text-[length:23rpx] text-muted">{{item.branchName || '平台活动'}}</view>
      </view>
      <view class="mip-admin-record-cell">
        <view class="mip-admin-record-label">报名与签到</view>
        <view class="flex flex-wrap gap-x-5 gap-y-1 text-[length:23rpx]"><view>有效报名 {{item.registrationCount}}</view><view>签到 {{item.attendedCount}}</view></view>
      </view>
      <view class="mip-admin-record-cell">
        <view class="mip-admin-record-label">状态与操作</view>
        <t-tag variant="outline" theme="{{item.statusTheme}}">{{item.statusText}}</t-tag>
        <view wx:if="{{item.canClone || item.status === 'DRAFT'}}" class="mip-admin-record-actions mt-3">
          <t-button wx:if="{{item.canClone}}" block variant="outline" loading="{{cloneBusyId === item.id}}" disabled="{{processingId || cloneBusyId}}" data-id="{{item.id}}" data-version="{{item.version}}" catch:tap="cloneEvent">复制为草稿</t-button>
          <t-button wx:if="{{item.status === 'DRAFT'}}" block variant="outline" theme="danger" loading="{{processingId === item.id}}" disabled="{{processingId || cloneBusyId}}" data-id="{{item.id}}" data-version="{{item.version}}" catch:tap="archiveEvent">归档草稿</t-button>
        </view>
      </view>
    </view>
  </view>
  <view wx:if="{{message && state === 'ready'}}" class="mt-4 rounded-[12rpx] bg-panel px-4 py-3 text-[length:23rpx] text-danger">{{message}}</view>
  <view wx:if="{{nextCursor}}" class="mt-4"><t-button block variant="outline" loading="{{loadingMore}}" bind:tap="loadMoreEvents">加载更多</t-button></view>
  <app-page-exit />
</view>
