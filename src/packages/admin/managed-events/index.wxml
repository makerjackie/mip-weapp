<view id="admin-managed-events-page" class="min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-4 text-ink">
  <view class="flex items-end justify-between gap-4">
    <view><view class="text-[length:36rpx] font-bold">活动管理</view><view class="mt-1 text-[length:21rpx] text-muted">选择一场活动，再进入具体运营任务</view></view>
    <view wx:if="{{globalAdmin}}" class="shrink-0 text-[length:22rpx] font-semibold text-brand" bind:tap="createEvent">新建活动</view>
  </view>

  <view wx:if="{{state === 'loading'}}" class="mt-5 rounded-[26rpx] bg-panel px-5 py-8"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}" class="mt-5"><app-empty-state title="暂时无法加载活动" description="{{message}}" action-text="重新加载" bind:action="load" /></view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-5"><app-empty-state title="没有活动管理权限" description="请联系活动负责人为你分配本场活动权限。" /></view>
  <block wx:else>
    <view class="mt-4">
      <t-tabs value="{{status}}" bind:change="changeStatus" t-class="bg-transparent">
        <t-tab-panel label="全部" value="ALL" />
        <t-tab-panel label="草稿" value="DRAFT" />
        <t-tab-panel label="已发布" value="PUBLISHED" />
        <t-tab-panel label="已结束" value="COMPLETED" />
      </t-tabs>
    </view>
    <view class="mt-3 flex items-center gap-2 rounded-[18rpx] border border-line bg-panel px-3 py-2">
      <t-icon name="search" size="32rpx" color="var(--color-muted)" />
      <input class="box-border h-[64rpx] min-w-0 flex-1 max-w-full text-[length:24rpx]" value="{{query}}" bindinput="updateQuery" placeholder="搜索活动名称或地点" />
      <view wx:if="{{query}}" class="px-2 py-2 text-[length:21rpx] text-muted" bind:tap="clearQuery">清除</view>
    </view>
    <view wx:if="{{items.length === 0}}" class="mt-5"><app-empty-state title="没有符合条件的活动" description="{{allItems.length ? '换一个状态或清除搜索后再试。' : '活动负责人添加你后，会在这里显示。'}}" /></view>
    <view wx:else class="mt-5 flex flex-col gap-4">
      <view wx:for="{{items}}" wx:key="id" class="overflow-hidden rounded-[24rpx] bg-panel active:bg-panel-muted" data-event-id="{{item.id}}" bind:tap="openEvent">
        <view class="flex gap-4 px-4 py-4">
          <image wx:if="{{item.coverUrl}}" class="h-[156rpx] w-[208rpx] shrink-0 rounded-[18rpx] bg-brand-soft" src="{{item.coverUrl}}" mode="aspectFill" />
          <view wx:else class="flex h-[156rpx] w-[208rpx] shrink-0 items-center justify-center rounded-[18rpx] bg-brand-soft"><t-icon name="calendar-event" size="52rpx" color="var(--color-brand)" /></view>
          <view class="min-w-0 flex-1">
            <view class="flex items-center justify-between gap-2"><view class="rounded-full bg-brand-soft px-2 py-1 text-[length:18rpx] font-semibold text-brand">{{item.statusText}}</view><view class="text-[length:18rpx] text-muted">{{item.roleText}}</view></view>
            <view class="mt-2 line-clamp-2 text-[length:26rpx] font-bold">{{item.title}}</view>
            <view class="mt-2 truncate text-[length:20rpx] text-muted">{{item.startsText}}</view>
            <view class="mt-1 truncate text-[length:20rpx] text-muted">{{item.location || '地点待补充'}}</view>
          </view>
        </view>
        <view class="flex min-h-[82rpx] items-center justify-between border-t border-line px-4">
          <view class="text-[length:21rpx] text-muted">{{item.registrationCount}} 人报名</view>
          <view class="flex items-center gap-1 text-[length:22rpx] font-semibold text-brand">进入管理 <t-icon name="chevron-right" size="32rpx" color="var(--color-brand)" /></view>
        </view>
      </view>
    </view>
  </block>
  <view wx:if="{{message && state === 'ready'}}" class="mt-4 rounded-[18rpx] bg-[#FFF0E8] px-4 py-3 text-[length:22rpx] text-[#9F4727]">{{message}}</view>
</view>
