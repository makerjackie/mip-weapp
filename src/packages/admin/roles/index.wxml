<view id="admin-roles-page" class="min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+40rpx)] pt-4 text-ink">
  <view wx:if="{{state === 'loading'}}" class="rounded-[26rpx] bg-panel px-5 py-8"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'forbidden'}}"><app-empty-state title="仅主理人可管理权限" description="全局管理员权限会影响所有活动、成员与订单。" /></view>
  <view wx:elif="{{state === 'error'}}"><app-empty-state title="暂时无法加载管理员" description="{{message}}" action-text="重新加载" bind:action="load" /></view>
  <block wx:else>
    <view class="rounded-[28rpx] bg-brand px-5 py-5 text-white">
      <view class="text-[length:32rpx] font-bold">团队权限</view>
      <view class="mt-2 text-[length:21rpx] leading-5 text-brand-soft">全局权限与单场活动管理员分开管理；最小授权，随时可暂停。</view>
    </view>

    <view wx:if="{{profiles.length}}" class="mt-4 rounded-[26rpx] bg-panel px-5 py-5">
      <view class="text-[length:26rpx] font-bold">添加管理员</view>
      <picker class="mt-4" mode="selector" range="{{profileLabels}}" value="{{selectedProfileIndex}}" bindchange="chooseProfile">
        <view class="flex h-[82rpx] items-center justify-between rounded-[18rpx] bg-canvas px-4 text-[length:23rpx]"><text>{{profileLabels[selectedProfileIndex] || '选择已认证成员'}}</text><t-icon name="chevron-down" size="32rpx" color="var(--color-muted)" /></view>
      </picker>
      <picker class="mt-3" mode="selector" range="{{roleLabels}}" value="{{selectedRoleIndex}}" bindchange="chooseRole">
        <view class="flex h-[82rpx] items-center justify-between rounded-[18rpx] bg-canvas px-4 text-[length:23rpx]"><text>{{roleLabels[selectedRoleIndex]}}</text><t-icon name="chevron-down" size="32rpx" color="var(--color-muted)" /></view>
      </picker>
      <view class="mt-4"><t-button block theme="primary" loading="{{busyId}}" bind:tap="addRole">添加到运营团队</t-button></view>
    </view>

    <view class="mt-4 overflow-hidden rounded-[26rpx] bg-panel">
      <view class="border-b border-line px-5 py-4 text-[length:26rpx] font-bold">当前管理员</view>
      <view wx:for="{{roles}}" wx:key="profileId" class="border-b border-line px-5 py-4 last:border-b-0">
        <view class="flex items-start justify-between gap-3">
          <view class="min-w-0 flex-1"><view class="text-[length:25rpx] font-semibold">{{item.nickname}}</view><view class="mt-1 text-[length:20rpx] text-muted">{{item.roleText}} · {{item.permissionText}}</view></view>
          <view wx:if="{{item.active}}" class="rounded-full bg-brand-soft px-3 py-1 text-[length:19rpx] text-brand">使用中</view>
          <view wx:else class="rounded-full bg-panel-muted px-3 py-1 text-[length:19rpx] text-muted">已暂停</view>
        </view>
        <view wx:if="{{item.canEdit}}" class="mt-3 text-right"><t-button size="small" variant="outline" theme="{{item.active ? 'danger' : 'primary'}}" loading="{{busyId === item.profileId}}" data-profile-id="{{item.profileId}}" data-role="{{item.role}}" data-active="{{item.active}}" bind:tap="toggleRole">{{item.active ? '暂停权限' : '恢复权限'}}</t-button></view>
      </view>
    </view>
    <view wx:if="{{message}}" class="mt-4 rounded-[18rpx] bg-[#FFF0E8] px-4 py-3 text-[length:22rpx] text-[#9F4727]">{{message}}</view>
  </block>
  <app-page-exit />
</view>
