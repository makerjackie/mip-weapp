<view id="admin-announcements-page" class="min-h-screen bg-canvas px-6 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-7 text-ink">
  <view class="flex items-center justify-between gap-4">
    <view><view class="text-[length:40rpx] font-bold">公告管理</view><view class="mt-2 text-[length:23rpx] text-muted">维护平台和城市分会公告</view></view>
    <t-button size="small" theme="primary" bind:tap="createItem">新建</t-button>
  </view>
  <scroll-view class="mt-5 whitespace-nowrap" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="inline-flex gap-2">
      <view class="rounded-full px-4 py-2 text-[length:23rpx] {{status === '' ? 'bg-brand text-on-brand' : 'bg-panel text-muted'}}" data-status="" bind:tap="chooseStatus">全部</view>
      <view class="rounded-full px-4 py-2 text-[length:23rpx] {{status === 'DRAFT' ? 'bg-brand text-on-brand' : 'bg-panel text-muted'}}" data-status="DRAFT" bind:tap="chooseStatus">草稿</view>
      <view class="rounded-full px-4 py-2 text-[length:23rpx] {{status === 'PUBLISHED' ? 'bg-brand text-on-brand' : 'bg-panel text-muted'}}" data-status="PUBLISHED" bind:tap="chooseStatus">已发布</view>
      <view class="rounded-full px-4 py-2 text-[length:23rpx] {{status === 'WITHDRAWN' ? 'bg-brand text-on-brand' : 'bg-panel text-muted'}}" data-status="WITHDRAWN" bind:tap="chooseStatus">已撤回</view>
    </view>
  </scroll-view>

  <view wx:if="{{state === 'loading'}}" class="mt-6 rounded-[16rpx] bg-panel px-5 py-6"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error' || state === 'conflict'}}" class="mt-6"><app-empty-state title="暂时无法加载公告" description="{{message}}" action-text="重新加载" bind:action="retryLoad" /></view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-6"><app-empty-state title="没有公告管理权限" description="当前账号不能维护公告。" /></view>
  <view wx:elif="{{state === 'empty'}}" class="mt-6"><app-empty-state title="暂无公告" description="新公告会先保存为草稿。" action-text="新建公告" bind:action="createItem" /></view>
  <view wx:else class="mt-5 flex flex-col gap-3">
    <view wx:for="{{items}}" wx:key="id" class="rounded-[16rpx] bg-panel px-4 py-4">
      <view data-id="{{item.id}}" bind:tap="editItem">
        <view class="flex items-start gap-2"><view class="min-w-0 flex-1 text-[length:28rpx] font-semibold">{{item.title}}</view><t-tag size="small" variant="outline">{{item.statusText}}</t-tag></view>
        <view class="mt-2 line-clamp-2 text-[length:24rpx] leading-[1.7] text-muted">{{item.summary}}</view>
        <view class="mt-3 flex flex-wrap items-center gap-2 text-[length:21rpx] text-muted"><text>{{item.scopeText}}</text><text>内容检查：{{item.safetyText}}</text><text wx:if="{{item.isPinned}}" class="text-brand">已置顶</text></view>
        <view class="mt-2 text-[length:20rpx] text-muted">更新于 {{item.updatedText}}</view>
      </view>
      <view class="mt-4 grid grid-cols-2 gap-2 border-t border-line pt-4">
        <t-button wx:if="{{item.status !== 'PUBLISHED'}}" block size="small" theme="primary" loading="{{processingId === item.id}}" data-id="{{item.id}}" data-transition="PUBLISH" bind:tap="transition">发布</t-button>
        <t-button wx:if="{{item.status === 'PUBLISHED'}}" block size="small" variant="outline" loading="{{processingId === item.id}}" data-id="{{item.id}}" data-transition="{{item.isPinned ? 'UNPIN' : 'PIN'}}" bind:tap="transition">{{item.isPinned ? '取消置顶' : '置顶'}}</t-button>
        <t-button wx:if="{{item.status === 'PUBLISHED'}}" block size="small" variant="outline" theme="danger" loading="{{processingId === item.id}}" data-id="{{item.id}}" data-transition="WITHDRAW" bind:tap="transition">撤回</t-button>
      </view>
    </view>
  </view>
  <view wx:if="{{message && state === 'ready'}}" class="mt-4 rounded-[12rpx] bg-panel px-4 py-3 text-[length:23rpx] text-danger">{{message}}</view>
  <app-page-exit />
</view>
