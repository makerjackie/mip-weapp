<view id="admin-game-page" class="min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-4 text-ink">
  <view class="flex items-start justify-between gap-3"><view><view class="text-[length:38rpx] font-bold">赛季管理</view><view class="mt-2 text-[length:23rpx] text-muted">配置赛季、队伍、对阵和排行榜</view></view><t-button size="small" theme="primary" bind:tap="openCreateSeason">新增赛季</t-button></view>
  <view wx:if="{{state === 'loading'}}" class="mt-5 rounded-[16rpx] bg-panel px-4 py-6"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}" class="mt-5"><app-empty-state title="暂时无法加载赛季管理" description="{{message}}" action-text="重新加载" bind:action="load" /></view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-5"><app-empty-state title="没有赛季管理权限" description="当前账号不能管理赛季。" /></view>
  <block wx:else>
    <scroll-view wx:if="{{seasons.length}}" scroll-x class="mt-5 whitespace-nowrap"><view class="inline-flex gap-2"><t-tag wx:for="{{seasons}}" wx:key="id" variant="{{selectedSeasonId === item.id ? 'light' : 'outline'}}" theme="warning" data-id="{{item.id}}" bind:tap="chooseSeason">{{item.name}}</t-tag></view></scroll-view>
    <view wx:if="{{editorOpen}}" class="mt-4 rounded-[16rpx] border border-brand bg-panel px-4 py-4">
      <view class="flex items-center justify-between"><view class="text-[length:28rpx] font-semibold">{{editingSeasonId ? '编辑赛季' : '新增赛季'}}</view><view class="text-[length:22rpx] text-muted" bind:tap="closeEditor">关闭</view></view>
      <view class="mt-3"><t-input value="{{seasonKey}}" placeholder="赛季标识" data-field="seasonKey" bind:change="updateField" /></view><view class="mt-2"><t-input value="{{seasonName}}" placeholder="赛季名称" data-field="seasonName" bind:change="updateField" /></view><view class="mt-2"><t-input value="{{seasonSummary}}" placeholder="赛季说明（选填）" data-field="seasonSummary" bind:change="updateField" /></view><view class="mt-2"><t-textarea value="{{rulesText}}" maxlength="4000" placeholder="用户可见规则" data-field="rulesText" bind:change="updateField" /></view>
      <view class="mt-3 flex gap-2"><t-tag variant="{{periodKind === 'HALF_YEAR' ? 'light' : 'outline'}}" data-kind="HALF_YEAR" bind:tap="choosePeriod">半年</t-tag><t-tag variant="{{periodKind === 'YEAR' ? 'light' : 'outline'}}" data-kind="YEAR" bind:tap="choosePeriod">年度</t-tag><t-tag variant="{{periodKind === 'CUSTOM' ? 'light' : 'outline'}}" data-kind="CUSTOM" bind:tap="choosePeriod">自定义</t-tag></view>
      <view class="mt-3 grid grid-cols-2 gap-2"><picker class="min-h-[80rpx] rounded-[12rpx] bg-panel-raised px-3 py-3" mode="date" value="{{startsDate}}" bindchange="updateStartsDate"><view>{{startsDate || '开始日期'}}</view></picker><picker class="min-h-[80rpx] rounded-[12rpx] bg-panel-raised px-3 py-3" mode="date" value="{{endsDate}}" bindchange="updateEndsDate"><view>{{endsDate || '结束日期'}}</view></picker></view>
      <view class="mt-4"><t-button block theme="primary" loading="{{processing}}" bind:tap="saveSeason">保存赛季</t-button></view>
    </view>

    <view wx:if="{{selectedSeasonId}}" class="mt-4 flex flex-col gap-3">
      <block wx:for="{{seasons}}" wx:key="id"><view wx:if="{{item.id === selectedSeasonId}}" class="rounded-[16rpx] bg-panel px-4 py-4"><view class="flex items-start justify-between"><view><view class="text-[length:28rpx] font-semibold">{{item.name}}</view><view class="mt-1 text-[length:21rpx] text-muted">{{item.status}}</view></view><view class="flex gap-2"><t-button wx:if="{{item.status !== 'CLOSED'}}" size="small" variant="outline" data-id="{{item.id}}" bind:tap="editSeason">编辑</t-button><t-button wx:if="{{item.status === 'DRAFT'}}" size="small" theme="primary" data-id="{{item.id}}" data-status="ACTIVE" bind:tap="changeSeasonStatus">启用</t-button><t-button wx:if="{{item.status === 'ACTIVE'}}" size="small" variant="outline" data-id="{{item.id}}" data-status="CLOSED" bind:tap="changeSeasonStatus">结束</t-button></view></view></view></block>

      <view class="rounded-[16rpx] bg-panel px-4 py-4"><view class="text-[length:28rpx] font-semibold">新增队伍</view><view class="mt-3"><t-input value="{{teamName}}" placeholder="队伍名称" data-field="teamName" bind:change="updateField" /></view><view class="mt-2"><t-input value="{{teamSummary}}" placeholder="队伍说明（选填）" data-field="teamSummary" bind:change="updateField" /></view><picker wx:if="{{branches.length}}" class="mt-2 min-h-[80rpx] rounded-[12rpx] bg-panel-raised px-3 py-3" range="{{branches}}" range-key="name" value="{{teamBranchIndex}}" bindchange="updateBranch"><view>{{teamBranchIndex >= 0 ? branches[teamBranchIndex].name : '选择城市分会（选填）'}}</view></picker><view class="mt-3"><t-button block variant="outline" loading="{{processing}}" bind:tap="createTeam">创建队伍</t-button></view></view>
      <view wx:if="{{teams.length}}" class="overflow-hidden rounded-[16rpx] bg-panel"><view wx:for="{{teams}}" wx:key="id" class="flex min-h-[96rpx] items-center gap-3 border-b border-line px-4 py-3"><view class="min-w-0 flex-1"><view class="text-[length:25rpx]">{{item.name}}</view><view class="mt-1 text-[length:20rpx] text-muted">{{item.branchName || '未设置分会'}} · {{item.memberCount}} 人</view></view><t-button size="small" variant="outline" data-id="{{item.id}}" bind:tap="openMembers">成员</t-button></view></view>

      <view wx:if="{{memberPanelOpen}}" class="rounded-[16rpx] border border-brand bg-panel px-4 py-4"><view class="text-[length:27rpx] font-semibold">{{memberTeamName}}成员</view><view class="mt-3 max-h-[640rpx] overflow-y-auto"><view wx:for="{{members}}" wx:key="memberRef" class="flex min-h-[88rpx] items-center gap-2 border-b border-line py-2"><checkbox checked="{{item.selected}}" data-index="{{index}}" bind:tap="toggleMember" /><view class="min-w-0 flex-1"><view class="truncate text-[length:23rpx]">{{item.nickname}}</view><view class="text-[length:19rpx] text-muted">{{item.branchName || '未设置分会'}}<text wx:if="{{item.teamName}}"> · 当前 {{item.teamName}}</text></view></view><t-tag variant="{{item.selectedRole === 'CAPTAIN' ? 'light' : 'outline'}}" data-index="{{index}}" bind:tap="setCaptain">队长</t-tag></view></view><view class="mt-4"><t-button block theme="primary" loading="{{processing}}" bind:tap="saveMembers">保存成员</t-button></view></view>

      <view wx:if="{{teams.length >= 2}}" class="rounded-[16rpx] bg-panel px-4 py-4"><view class="text-[length:28rpx] font-semibold">新增每周对阵</view><view class="mt-3 grid grid-cols-2 gap-2"><picker class="min-h-[80rpx] rounded-[12rpx] bg-panel-raised px-3 py-3" range="{{teams}}" range-key="name" value="{{matchTeamAIndex}}" bindchange="updateMatchTeamA"><view>{{teams[matchTeamAIndex].name}}</view></picker><picker class="min-h-[80rpx] rounded-[12rpx] bg-panel-raised px-3 py-3" range="{{teams}}" range-key="name" value="{{matchTeamBIndex}}" bindchange="updateMatchTeamB"><view>{{teams[matchTeamBIndex].name}}</view></picker></view><view class="mt-2 grid grid-cols-2 gap-2"><picker class="min-h-[80rpx] rounded-[12rpx] bg-panel-raised px-3 py-3" mode="date" value="{{matchWeekStart}}" bindchange="updateMatchStart"><view>{{matchWeekStart || '开始日期'}}</view></picker><picker class="min-h-[80rpx] rounded-[12rpx] bg-panel-raised px-3 py-3" mode="date" value="{{matchWeekEnd}}" bindchange="updateMatchEnd"><view>{{matchWeekEnd || '结束日期'}}</view></picker></view><view class="mt-3"><t-button block variant="outline" loading="{{processing}}" bind:tap="createMatch">创建对阵</t-button></view></view>
      <view wx:if="{{matches.length}}" class="overflow-hidden rounded-[16rpx] bg-panel"><view wx:for="{{matches}}" wx:key="id" class="flex min-h-[96rpx] items-center gap-3 border-b border-line px-4 py-3"><view class="min-w-0 flex-1"><view class="text-[length:23rpx]">{{item.teamA.name}} {{item.teamA.score === null ? '-' : item.teamA.score}} : {{item.teamB.score === null ? '-' : item.teamB.score}} {{item.teamB.name}}</view><view class="mt-1 text-[length:19rpx] text-muted">{{item.weekStart}} 至 {{item.weekEnd}}</view></view><t-button wx:if="{{item.status === 'SCHEDULED'}}" size="small" theme="primary" data-id="{{item.id}}" bind:tap="finalizeMatch">结算</t-button></view></view>

      <view class="rounded-[16rpx] bg-panel px-4 py-4"><view class="text-[length:28rpx] font-semibold">生成排行榜</view><view class="mt-2 text-[length:21rpx] text-muted">生成后保存当前成长流水快照，不接受手动分数。</view><view class="mt-3 grid grid-cols-2 gap-2"><t-button variant="outline" data-type="TEAM_HALF_YEAR" bind:tap="generateRanking">团队半年榜</t-button><t-button variant="outline" data-type="TEAM_YEAR" bind:tap="generateRanking">团队年度榜</t-button><t-button variant="outline" data-type="INDIVIDUAL_SEASON" bind:tap="generateRanking">个人赛季榜</t-button><t-button variant="outline" data-type="INDIVIDUAL_ALL_TIME" bind:tap="generateRanking">个人累计榜</t-button></view></view>
    </view>
    <view wx:if="{{message}}" class="mt-4 rounded-[12rpx] bg-panel px-4 py-3 text-[length:22rpx] text-danger">{{message}}</view>
  </block>
  <app-page-exit />
</view>
