<view id="admin-profiles-page" class="mip-admin-page min-h-screen bg-canvas px-6 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-7 text-ink">
  <view class="text-[length:40rpx] font-bold">用户管理</view><view class="mt-2 text-[length:23rpx] text-muted">组合筛选、脱敏资料、名单和授权字段编辑</view>
  <view class="mip-admin-filter-grid mt-5 grid gap-3 rounded-[16rpx] bg-panel p-3">
    <view class="mip-admin-filter-wide"><t-input value="{{query}}" placeholder="搜索昵称、资料或城市" bind:change="updateQuery" bind:enter="search" /></view>
    <view class="flex flex-wrap gap-2"><t-button wx:if="{{canFilterBranches}}" size="small" variant="outline" bind:tap="chooseBranch">{{branchLabel}}</t-button><t-button wx:if="{{levels.length}}" size="small" variant="outline" bind:tap="chooseLevel">{{levelLabel}}</t-button></view>
    <view class="grid grid-cols-2 gap-2"><t-input type="number" value="{{experienceMin}}" placeholder="最低经验值" data-field="experienceMin" bind:change="updateRangeFilter" /><t-input type="number" value="{{experienceMax}}" placeholder="最高经验值" data-field="experienceMax" bind:change="updateRangeFilter" /></view>
    <view class="grid grid-cols-2 gap-2"><picker mode="date" value="{{createdFromDate}}" data-field="createdFromDate" bindchange="changeCreatedDate"><view class="flex min-h-[88rpx] flex-col justify-center rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:22rpx]"><view class="text-muted">注册日期起</view><view class="mt-1">{{createdFromDate || '不限'}}</view></view></picker><picker mode="date" value="{{createdToDate}}" data-field="createdToDate" bindchange="changeCreatedDate"><view class="flex min-h-[88rpx] flex-col justify-center rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:22rpx]"><view class="text-muted">注册日期止</view><view class="mt-1">{{createdToDate || '不限'}}</view></view></picker></view>
    <view wx:if="{{createdFromDate || createdToDate}}" class="flex min-h-[88rpx] items-center justify-end text-[length:21rpx] text-muted" role="button" bind:tap="clearCreatedDates">清除日期</view>
    <view class="flex flex-wrap gap-2" role="radiogroup" aria-label="用户身份"><view class="flex min-h-[88rpx] items-center" role="radio" aria-checked="{{kind === ''}}"><t-tag variant="outline" theme="{{kind === '' ? 'primary' : 'default'}}" data-field="kind" data-value="" bind:tap="chooseFilter">全部身份</t-tag></view><view class="flex min-h-[88rpx] items-center" role="radio" aria-checked="{{kind === 'PLAYER'}}"><t-tag variant="outline" theme="{{kind === 'PLAYER' ? 'primary' : 'default'}}" data-field="kind" data-value="PLAYER" bind:tap="chooseFilter">玩家</t-tag></view><view class="flex min-h-[88rpx] items-center" role="radio" aria-checked="{{kind === 'GUEST'}}"><t-tag variant="outline" theme="{{kind === 'GUEST' ? 'primary' : 'default'}}" data-field="kind" data-value="GUEST" bind:tap="chooseFilter">嘉宾</t-tag></view></view>
    <view class="flex flex-wrap gap-2" role="radiogroup" aria-label="账号状态"><view class="flex min-h-[88rpx] items-center" role="radio" aria-checked="{{status === ''}}"><t-tag variant="outline" theme="{{status === '' ? 'primary' : 'default'}}" data-field="status" data-value="" bind:tap="chooseFilter">全部状态</t-tag></view><view class="flex min-h-[88rpx] items-center" role="radio" aria-checked="{{status === 'ACTIVE'}}"><t-tag variant="outline" theme="{{status === 'ACTIVE' ? 'primary' : 'default'}}" data-field="status" data-value="ACTIVE" bind:tap="chooseFilter">正常</t-tag></view><view class="flex min-h-[88rpx] items-center" role="radio" aria-checked="{{status === 'BLOCKED'}}"><t-tag variant="outline" theme="{{status === 'BLOCKED' ? 'primary' : 'default'}}" data-field="status" data-value="BLOCKED" bind:tap="chooseFilter">已限制</t-tag></view></view>
    <view class="flex flex-wrap gap-2" role="radiogroup" aria-label="名单状态"><view class="flex min-h-[88rpx] items-center" role="radio" aria-checked="{{controlType === ''}}"><t-tag variant="outline" theme="{{controlType === '' ? 'primary' : 'default'}}" data-field="controlType" data-value="" bind:tap="chooseFilter">全部名单</t-tag></view><view class="flex min-h-[88rpx] items-center" role="radio" aria-checked="{{controlType === 'BLOCKLIST'}}"><t-tag variant="outline" theme="{{controlType === 'BLOCKLIST' ? 'primary' : 'default'}}" data-field="controlType" data-value="BLOCKLIST" bind:tap="chooseFilter">黑名单</t-tag></view><view class="flex min-h-[88rpx] items-center" role="radio" aria-checked="{{controlType === 'ALLOWLIST'}}"><t-tag variant="outline" theme="{{controlType === 'ALLOWLIST' ? 'primary' : 'default'}}" data-field="controlType" data-value="ALLOWLIST" bind:tap="chooseFilter">白名单</t-tag></view></view>
    <view class="flex flex-wrap gap-2" role="radiogroup" aria-label="手机状态"><view class="flex min-h-[88rpx] items-center" role="radio" aria-checked="{{phoneBound === ''}}"><t-tag variant="outline" theme="{{phoneBound === '' ? 'primary' : 'default'}}" data-field="phoneBound" data-value="" bind:tap="chooseFilter">全部手机状态</t-tag></view><view class="flex min-h-[88rpx] items-center" role="radio" aria-checked="{{phoneBound === 'BOUND'}}"><t-tag variant="outline" theme="{{phoneBound === 'BOUND' ? 'primary' : 'default'}}" data-field="phoneBound" data-value="BOUND" bind:tap="chooseFilter">已绑定手机</t-tag></view><view class="flex min-h-[88rpx] items-center" role="radio" aria-checked="{{phoneBound === 'UNBOUND'}}"><t-tag variant="outline" theme="{{phoneBound === 'UNBOUND' ? 'primary' : 'default'}}" data-field="phoneBound" data-value="UNBOUND" bind:tap="chooseFilter">未绑定手机</t-tag></view></view>
    <view class="flex flex-wrap gap-2" role="radiogroup" aria-label="档案状态"><view class="flex min-h-[88rpx] items-center" role="radio" aria-checked="{{profileComplete === ''}}"><t-tag variant="outline" theme="{{profileComplete === '' ? 'primary' : 'default'}}" data-field="profileComplete" data-value="" bind:tap="chooseFilter">全部档案状态</t-tag></view><view class="flex min-h-[88rpx] items-center" role="radio" aria-checked="{{profileComplete === 'COMPLETE'}}"><t-tag variant="outline" theme="{{profileComplete === 'COMPLETE' ? 'primary' : 'default'}}" data-field="profileComplete" data-value="COMPLETE" bind:tap="chooseFilter">档案完整</t-tag></view><view class="flex min-h-[88rpx] items-center" role="radio" aria-checked="{{profileComplete === 'INCOMPLETE'}}"><t-tag variant="outline" theme="{{profileComplete === 'INCOMPLETE' ? 'primary' : 'default'}}" data-field="profileComplete" data-value="INCOMPLETE" bind:tap="chooseFilter">档案待完善</t-tag></view></view>
    <view class="flex flex-wrap gap-2" role="radiogroup" aria-label="加入时间"><view class="flex min-h-[88rpx] items-center" role="radio" aria-checked="{{joinedWithinDays === 7}}"><t-tag variant="outline" theme="{{joinedWithinDays === 7 ? 'primary' : 'default'}}" data-field="joinedWithinDays" data-value="7" bind:tap="chooseFilter">近 7 天加入</t-tag></view><view class="flex min-h-[88rpx] items-center" role="radio" aria-checked="{{joinedWithinDays === 30}}"><t-tag variant="outline" theme="{{joinedWithinDays === 30 ? 'primary' : 'default'}}" data-field="joinedWithinDays" data-value="30" bind:tap="chooseFilter">近 30 天加入</t-tag></view><view class="flex min-h-[88rpx] items-center" role="radio" aria-checked="{{joinedWithinDays === 0}}"><t-tag variant="outline" theme="{{joinedWithinDays === 0 ? 'primary' : 'default'}}" data-field="joinedWithinDays" data-value="0" bind:tap="chooseFilter">全部加入时间</t-tag></view></view>
    <view class="mip-admin-span-wide flex flex-wrap gap-2"><t-button size="small" variant="outline" bind:tap="search">查询</t-button><t-button wx:if="{{canPhone && !includePhone}}" size="small" variant="outline" bind:tap="showPhones">查看手机号原文</t-button><t-button wx:if="{{canExport}}" size="small" variant="outline" loading="{{exportPending}}" bind:tap="createExport">创建导出</t-button></view>
  </view>
  <view wx:if="{{state === 'loading'}}" class="mt-6 rounded-[16rpx] bg-panel p-5"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error' || state === 'conflict'}}" class="mt-6"><app-empty-state title="暂时无法加载用户" description="{{message}}" action-text="重新加载" bind:action="loadUsers" /></view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-6"><app-empty-state title="没有用户管理权限" description="当前账号不能查看用户管理内容。" /></view>
  <view wx:elif="{{users.length === 0}}" class="mt-6"><app-empty-state title="没有符合条件的用户" description="调整筛选条件后重新查询。" /></view>
  <view wx:else class="mip-admin-card-list mt-5 flex flex-col gap-3">
    <view wx:for="{{users}}" wx:key="id" class="rounded-[16rpx] bg-panel px-4 py-4">
      <view class="flex items-start justify-between gap-3">
        <view><view class="text-[length:28rpx] font-semibold">{{item.nickname}}</view><view class="mt-1 text-[length:22rpx] text-muted">{{item.kind === 'PLAYER' ? '玩家' : '嘉宾'}} · {{item.branchName || '未设置分会'}}</view></view>
        <t-tag variant="outline" theme="{{item.statusTheme}}">{{item.statusText}}</t-tag>
      </view>
      <view class="mt-3 grid grid-cols-2 gap-2"><view class="rounded-[10rpx] bg-panel-raised px-3 py-2"><view class="text-[length:20rpx] text-muted">当前等级</view><view class="mt-1 text-[length:23rpx]">{{item.levelName || '未定级'}} · {{item.experience}} 经验</view></view><view class="rounded-[10rpx] bg-panel-raised px-3 py-2"><view class="text-[length:20rpx] text-muted">注册时间</view><view class="mt-1 text-[length:23rpx]">{{item.createdText}}</view></view></view>
      <view class="mt-3 text-[length:23rpx]">{{item.headline || '未填写资料标题'}}</view><view wx:if="{{item.introduction}}" class="mt-2 text-[length:22rpx] text-muted">{{item.introduction}}</view>
      <view wx:if="{{includePhone}}" class="mt-2 text-[length:22rpx] text-muted">手机号：{{item.phoneNumber || '未绑定'}}</view><view wx:elif="{{item.phoneBound}}" class="mt-2 text-[length:22rpx] text-muted">手机已绑定</view><view wx:else class="mt-2 text-[length:22rpx] text-muted">手机未绑定</view>
      <view wx:if="{{item.controlText}}" class="mt-2 text-[length:22rpx] text-danger">{{item.controlText}}</view>
      <view class="mt-4"><t-button size="small" variant="outline" data-id="{{item.id}}" bind:tap="openDetail">查看详情</t-button></view>
      <view wx:if="{{canEdit}}" class="mt-3 flex flex-wrap gap-2"><t-button size="small" variant="outline" loading="{{processingId === item.id}}" data-id="{{item.id}}" data-version="{{item.profileVersion}}" data-field="nickname" bind:tap="editField">编辑昵称</t-button><t-button size="small" variant="outline" loading="{{processingId === item.id}}" data-id="{{item.id}}" data-version="{{item.profileVersion}}" data-field="headline" bind:tap="editField">编辑标题</t-button><t-button size="small" variant="outline" loading="{{processingId === item.id}}" data-id="{{item.id}}" data-version="{{item.profileVersion}}" data-field="introduction" bind:tap="editField">编辑介绍</t-button></view>
      <view wx:if="{{canControl}}" class="mt-3 flex flex-wrap gap-2"><t-button wx:if="{{!item.hasBlocklist}}" size="small" variant="outline" theme="danger" data-id="{{item.id}}" data-type="BLOCKLIST" data-active="true" bind:tap="setControl">加入黑名单</t-button><t-button wx:if="{{item.hasBlocklist}}" size="small" variant="outline" data-id="{{item.id}}" data-type="BLOCKLIST" data-active="false" bind:tap="setControl">撤销黑名单</t-button><t-button wx:if="{{!item.hasAllowlist}}" size="small" variant="outline" data-id="{{item.id}}" data-type="ALLOWLIST" data-active="true" bind:tap="setControl">加入白名单</t-button><t-button wx:if="{{item.hasAllowlist}}" size="small" variant="outline" data-id="{{item.id}}" data-type="ALLOWLIST" data-active="false" bind:tap="setControl">撤销白名单</t-button></view>
    </view>
  </view>
  <view wx:if="{{message && state === 'ready'}}" class="mt-4 rounded-[12rpx] bg-panel px-4 py-3 text-[length:23rpx] text-danger">{{message}}</view>
  <view wx:if="{{nextCursor}}" class="mt-4"><t-button block variant="outline" loading="{{loadingMore}}" bind:tap="loadMoreUsers">加载更多</t-button></view>
  <app-page-exit />
  <t-popup visible="{{detailOpen}}" placement="bottom" prevent-scroll-through bind:visible-change="handleDetailVisibility">
    <view class="mip-admin-popup-panel box-border max-h-[86vh] rounded-t-[24rpx] bg-panel px-5 pb-[calc(env(safe-area-inset-bottom)+32rpx)] pt-5 text-ink">
      <view class="flex items-center justify-between"><view class="text-[length:32rpx] font-bold">用户详情</view><view class="min-h-[64rpx] px-2 py-2 text-[length:22rpx] text-brand" bind:tap="closeDetail">关闭</view></view>
      <view wx:if="{{detailState === 'loading'}}" class="mt-4"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
      <view wx:elif="{{detailState === 'error'}}" class="mt-4"><app-empty-state title="用户详情加载失败" description="{{detailMessage}}" /></view>
      <scroll-view wx:else scroll-y class="mt-3 max-h-[72vh]">
        <view class="rounded-[16rpx] bg-panel-raised px-4 py-4"><view class="flex items-center justify-between gap-3"><view><view class="text-[length:29rpx] font-semibold">{{detail.nickname}}</view><view class="mt-1 text-[length:21rpx] text-muted">{{detail.kind === 'PLAYER' ? '玩家' : '嘉宾'}} · {{detail.statusText}}</view></view><view class="text-right text-[length:21rpx] text-muted">{{detail.branchName || '未设置分会'}}<view>{{detail.cityName}}</view></view></view><view wx:if="{{detail.headline}}" class="mt-3 text-[length:23rpx]">{{detail.headline}}</view><view wx:if="{{detail.introduction}}" class="mt-2 text-[length:22rpx] leading-6 text-muted">{{detail.introduction}}</view><view class="mt-2 text-[length:21rpx] text-muted">{{detail.phoneBound ? (detail.phoneNumber || '手机已绑定') : '手机未绑定'}}</view></view>
        <view class="mt-3 grid grid-cols-3 gap-2"><view class="rounded-[12rpx] bg-panel-raised px-2 py-3 text-center"><view class="text-[length:27rpx] font-bold">{{detail.counts.registrations}}</view><view class="mt-1 text-[length:19rpx] text-muted">报名</view></view><view class="rounded-[12rpx] bg-panel-raised px-2 py-3 text-center"><view class="text-[length:27rpx] font-bold">{{detail.counts.attended}}</view><view class="mt-1 text-[length:19rpx] text-muted">到场</view></view><view class="rounded-[12rpx] bg-panel-raised px-2 py-3 text-center"><view class="text-[length:27rpx] font-bold">{{detail.counts.orders}}</view><view class="mt-1 text-[length:19rpx] text-muted">订单</view></view><view class="rounded-[12rpx] bg-panel-raised px-2 py-3 text-center"><view class="text-[length:27rpx] font-bold">{{detail.counts.opportunities}}</view><view class="mt-1 text-[length:19rpx] text-muted">机会</view></view><view class="rounded-[12rpx] bg-panel-raised px-2 py-3 text-center"><view class="text-[length:27rpx] font-bold">{{detail.counts.cooperationCards}}</view><view class="mt-1 text-[length:19rpx] text-muted">合作卡</view></view><view class="rounded-[12rpx] bg-panel-raised px-2 py-3 text-center"><view class="text-[length:27rpx] font-bold">{{detail.counts.superCases}}</view><view class="mt-1 text-[length:19rpx] text-muted">案例</view></view></view>
        <view class="mt-3 rounded-[16rpx] bg-panel-raised px-4 py-4"><view class="text-[length:25rpx] font-semibold">会员与成长</view><view class="mt-3 grid grid-cols-2 gap-3 text-center"><view><view class="text-[length:24rpx] font-semibold">{{detail.growth.levelName || '未定级'}}</view><view class="text-[length:18rpx] text-muted">等级</view></view><view><view class="text-[length:24rpx] font-semibold">{{detail.growth.experience}}</view><view class="text-[length:18rpx] text-muted">经验值</view></view><view><view class="text-[length:24rpx] font-semibold">{{detail.growth.contribution}}</view><view class="text-[length:18rpx] text-muted">贡献值</view></view><view><view class="text-[length:24rpx] font-semibold">{{detail.growth.coin}}</view><view class="text-[length:18rpx] text-muted">游戏币</view></view></view><view wx:if="{{detail.membership}}" class="mt-3 text-[length:21rpx] text-muted">会员状态：{{detail.membershipText}} · 有效期至 {{detail.membershipEndsText}}</view></view>
        <view wx:if="{{detail.tags.length}}" class="mt-3 rounded-[16rpx] bg-panel-raised px-4 py-4"><view class="text-[length:25rpx] font-semibold">行业与能力</view><view class="mt-3 flex flex-wrap gap-2"><view wx:for="{{detail.tags}}" wx:key="id" class="rounded-full bg-panel px-3 py-2 text-[length:20rpx] text-muted">{{item.label}}</view></view></view>
        <view wx:if="{{detail.companies.length || detail.organizations.length}}" class="mt-3 rounded-[16rpx] bg-panel-raised px-4 py-4"><view class="text-[length:25rpx] font-semibold">公司与组织</view><view wx:for="{{detail.companies}}" wx:key="name" class="mt-3 text-[length:22rpx]">{{item.name}}<text wx:if="{{item.role}}" class="text-muted"> · {{item.role}}</text></view><view wx:for="{{detail.organizations}}" wx:key="name" class="mt-3 text-[length:22rpx]">{{item.name}}<text wx:if="{{item.role}}" class="text-muted"> · {{item.role}}</text></view></view>
        <view wx:if="{{detail.relatedRecords.superCases.length}}" class="mt-3 rounded-[16rpx] bg-panel-raised px-4 py-4"><view class="text-[length:25rpx] font-semibold">超级案例</view><view wx:for="{{detail.relatedRecords.superCases}}" wx:key="id" class="flex min-h-[88rpx] items-center justify-between border-b border-panel" data-id="{{item.id}}" bind:tap="openRelatedCase"><view class="min-w-0 flex-1"><view>{{item.title}}</view><view class="mt-1 text-[length:20rpx] text-muted">{{item.summary || '暂无摘要'}}</view></view><text class="ml-3 text-brand">查看</text></view></view>
        <view wx:if="{{detail.relatedRecords.opportunities.length}}" class="mt-3 rounded-[16rpx] bg-panel-raised px-4 py-4"><view class="text-[length:25rpx] font-semibold">机会</view><view wx:for="{{detail.relatedRecords.opportunities}}" wx:key="id" class="flex min-h-[88rpx] items-center justify-between border-b border-panel" data-id="{{item.id}}" bind:tap="openRelatedOpportunity"><text>{{item.title}}</text><text class="ml-3 text-brand">查看</text></view></view>
        <view wx:if="{{detail.relatedRecords.registrations.length}}" class="mt-3 rounded-[16rpx] bg-panel-raised px-4 py-4"><view class="text-[length:25rpx] font-semibold">活动记录</view><view wx:for="{{detail.relatedRecords.registrations}}" wx:key="id" class="flex min-h-[88rpx] items-center justify-between border-b border-panel" data-id="{{item.eventId}}" bind:tap="openRelatedRegistration"><text>{{item.title}}</text><text class="ml-3 text-brand">查看</text></view></view>
        <view wx:if="{{detail.relatedRecords.orders.length}}" class="mt-3 rounded-[16rpx] bg-panel-raised px-4 py-4"><view class="flex items-center justify-between"><view class="text-[length:25rpx] font-semibold">订单记录</view><view class="flex min-h-[88rpx] items-center text-brand" bind:tap="openOrders">查看订单</view></view><view wx:for="{{detail.relatedRecords.orders}}" wx:key="id" class="mt-2 text-[length:22rpx]">{{item.title}} · {{item.amountText}}</view></view>
      </scroll-view>
    </view>
  </t-popup>
</view>
