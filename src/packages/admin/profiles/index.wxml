<view id="admin-profiles-page" class="min-h-screen bg-canvas px-6 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-7 text-ink">
  <view class="border-b border-ink pb-5"><view class="text-[length:21rpx] font-semibold tracking-[0.16em] text-brand">成员管理</view><view class="mt-2 text-[length:44rpx] font-bold">资料审核与展示</view></view>
  <view class="mt-5 border-b border-line">
    <t-tabs value="{{view}}" theme="line" space-evenly bind:change="changeView">
      <t-tab-panel value="PENDING" label="待审核" />
      <t-tab-panel value="APPROVED" label="已公开" />
      <t-tab-panel value="SUSPENDED" label="已暂停" />
      <t-tab-panel value="REJECTED" label="已驳回" />
    </t-tabs>
  </view>
  <view wx:if="{{state === 'loading'}}" class="mt-7 bg-panel px-5 py-8"><t-skeleton row-col="{{[1, 1, 1, 1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}" class="mt-7"><app-empty-state title="暂时无法加载资料" description="服务暂时没有响应，请稍后重试。" action-text="重新加载" bind:action="loadProfiles" /></view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-7">
    <app-empty-state
      title="没有运营权限"
      description="请使用已授权的运营账号进入，或联系主理人开通权限。"
      action-text="重新验证"
      bind:action="loadProfiles"
    />
  </view>
  <view wx:elif="{{profiles.length === 0}}" class="mt-7"><app-empty-state title="{{emptyTitle}}" description="{{emptyDescription}}" /></view>
  <view wx:else class="mt-6 flex flex-col gap-4">
    <view wx:for="{{profiles}}" wx:key="id" class="border-l-[10rpx] border-brand bg-panel px-5 py-5">
      <view class="flex items-start gap-4">
        <image
          wx:if="{{item.avatarUrl}}"
          class="h-[96rpx] w-[96rpx] shrink-0 rounded-full bg-line object-cover"
          src="{{item.avatarUrl}}"
          mode="aspectFill"
          lazy-load="{{false}}"
        />
        <view wx:else class="flex h-[96rpx] w-[96rpx] shrink-0 items-center justify-center rounded-full bg-line text-[length:22rpx] text-muted">无头像</view>
        <view class="min-w-0 flex-1">
          <view class="truncate text-[length:31rpx] font-bold">{{item.nickname}}{{item.city ? ' · ' + item.city : ''}}</view>
          <view class="mt-3 line-clamp-3 text-[length:24rpx] leading-6">{{item.headline || '未填写介绍'}}</view>
        </view>
      </view>
      <view class="mt-3 flex flex-wrap gap-2"><t-tag wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" variant="outline">{{tag}}</t-tag></view>
      <view wx:if="{{view === 'PENDING'}}" class="mt-5 grid grid-cols-2 gap-3"><t-button block variant="outline" theme="danger" loading="{{processingId === item.id}}" data-profile-id="{{item.id}}" data-decision="reject" bind:tap="review">驳回</t-button><t-button block theme="primary" loading="{{processingId === item.id}}" data-profile-id="{{item.id}}" data-decision="approve" bind:tap="review">通过</t-button></view>
      <view wx:elif="{{view === 'APPROVED'}}" class="mt-5"><t-button block variant="outline" theme="danger" loading="{{processingId === item.id}}" data-profile-id="{{item.id}}" data-status="SUSPENDED" bind:tap="setVisibility">暂停展示</t-button></view>
      <view wx:elif="{{view === 'SUSPENDED'}}" class="mt-5"><t-button block theme="primary" loading="{{processingId === item.id}}" data-profile-id="{{item.id}}" data-status="APPROVED" bind:tap="setVisibility">恢复公开</t-button></view>
    </view>
  </view>
  <view wx:if="{{message && state === 'ready'}}" class="mt-5 border-l-[8rpx] border-danger bg-panel px-4 py-4 text-[length:24rpx] text-muted">{{message}}</view>
</view>
