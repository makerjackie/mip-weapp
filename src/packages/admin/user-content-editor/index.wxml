<view id="admin-user-content-editor-page" class="mip-admin-page mip-admin-workspace-page min-h-screen bg-canvas px-6 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-7 text-ink">
  <mip-admin-workspace-nav />
  <view class="text-[length:40rpx] font-bold">{{contentId ? '编辑用户内容' : '新增用户内容'}}</view>
  <view class="mt-2 text-[length:23rpx] text-muted">归属用户必须明确选择；保存和状态变更会记录审计。</view>
  <view wx:if="{{state === 'loading'}}" class="mt-6 rounded-[16rpx] bg-panel p-5"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <app-empty-state wx:elif="{{state === 'error' || state === 'forbidden'}}" class="mt-6" title="用户内容编辑页不可用" description="{{message}}" action-text="重新加载" bind:action="load" />
  <view wx:else class="admin-user-content-editor-grid mt-5">
    <view class="rounded-[16rpx] bg-panel p-4"><view class="text-[length:25rpx] font-semibold">归属与状态</view><picker class="mt-3" range="{{options.owners}}" range-key="nickname" value="{{ownerIndex < 0 ? 0 : ownerIndex}}" bindchange="chooseOwner"><view class="min-h-[88rpx] rounded-[12rpx] bg-panel-raised px-3 py-3">归属用户：{{ownerName}}</view></picker><picker class="mt-3" range="{{statuses}}" range-key="label" value="{{statusIndex}}" bindchange="chooseStatus"><view class="min-h-[88rpx] rounded-[12rpx] bg-panel-raised px-3 py-3">状态：{{statuses[statusIndex].label}}</view></picker></view>
    <block wx:if="{{kind === 'COOPERATION_CARD'}}">
      <view class="rounded-[16rpx] bg-panel p-4"><picker range="{{roleOptions}}" range-key="label" value="{{roleIndex}}" bindchange="chooseRole"><view class="min-h-[88rpx] rounded-[12rpx] bg-panel-raised px-3 py-3">合作角色：{{roleOptions[roleIndex].label}}</view></picker><t-input class="mt-3" value="{{positioning}}" label="合作定位" placeholder="填写合作定位" data-field="positioning" bind:change="updateField" /><t-textarea class="mt-3" value="{{targetSummary}}" label="合作目标" placeholder="填写合作目标" data-field="targetSummary" bind:change="updateField" /></view>
      <view class="rounded-[16rpx] bg-panel p-4"><view class="text-[length:25rpx] font-semibold">合作信息</view><view wx:for="{{roleFields}}" wx:key="key" class="mt-3"><t-textarea value="{{item.value}}" label="{{item.label}}" placeholder="{{item.placeholder}}" data-key="{{item.key}}" bind:change="updateRoleField" /></view></view>
      <view class="rounded-[16rpx] bg-panel p-4"><view class="text-[length:25rpx] font-semibold">能力评分</view><view wx:for="{{abilityScores}}" wx:key="key" class="mt-3 flex items-center gap-2"><view class="min-w-0 flex-1 text-[length:22rpx]">{{item.label}}</view><input class="w-[120rpx] rounded-[12rpx] bg-panel-raised px-3 py-2" type="number" value="{{item.score}}" data-key="{{item.key}}" bindinput="updateAbility" /></view></view>
    </block>
    <block wx:else>
      <view class="rounded-[16rpx] bg-panel p-4"><t-input value="{{projectName}}" label="项目名称" placeholder="填写项目名称" data-field="projectName" bind:change="updateField" /><t-textarea class="mt-3" value="{{summary}}" label="案例摘要" placeholder="填写案例摘要" data-field="summary" bind:change="updateField" /><t-textarea class="mt-3" value="{{responsibility}}" label="项目责任" placeholder="填写项目责任" data-field="responsibility" bind:change="updateField" /><t-input class="mt-3" value="{{caseType}}" label="案例类型" placeholder="填写案例类型" data-field="caseType" bind:change="updateField" /><t-textarea class="mt-3" value="{{description}}" label="案例说明" placeholder="填写案例说明" data-field="description" bind:change="updateField" /></view>
      <view class="rounded-[16rpx] bg-panel p-4"><picker mode="date" value="{{startedOn}}" bindchange="chooseDate" data-field="startedOn"><view class="min-h-[88rpx] rounded-[12rpx] bg-panel-raised px-3 py-3">开始日期：{{startedOn || '未设置'}}</view></picker><picker class="mt-3" mode="date" value="{{endedOn}}" bindchange="chooseDate" data-field="endedOn"><view class="min-h-[88rpx] rounded-[12rpx] bg-panel-raised px-3 py-3">结束日期：{{endedOn || '未设置'}}</view></picker><picker class="mt-3" range="{{options.cities}}" range-key="label" value="{{cityIndex < 0 ? 0 : cityIndex}}" bindchange="chooseCity"><view class="min-h-[88rpx] rounded-[12rpx] bg-panel-raised px-3 py-3">城市：{{cityIndex >= 0 ? options.cities[cityIndex].label : '未设置'}}</view></picker><picker class="mt-3" range="{{industryOptions}}" range-key="label" value="{{industryIndex < 0 ? 0 : industryIndex}}" bindchange="chooseIndustry"><view class="min-h-[88rpx] rounded-[12rpx] bg-panel-raised px-3 py-3">行业：{{industryIndex >= 0 ? industryOptions[industryIndex].label : '未设置'}}</view></picker></view>
    </block>
    <view wx:if="{{message}}" class="rounded-[12rpx] bg-panel px-4 py-3 text-danger">{{message}}</view><view class="mip-admin-span-wide"><t-button block theme="primary" loading="{{saving}}" bind:tap="save">保存</t-button></view>
  </view>
  <app-page-exit />
</view>
