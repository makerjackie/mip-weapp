<view id="admin-opportunity-detail-page" class="mip-admin-page min-h-screen bg-canvas px-6 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-7 text-ink">
  <view wx:if="{{state === 'loading'}}" class="rounded-[16rpx] bg-panel p-5"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <app-empty-state wx:elif="{{state === 'forbidden'}}" title="无运营权限" description="{{message}}" />
  <app-empty-state wx:elif="{{state === 'error'}}" title="暂时无法加载机会" description="{{message}}" action-text="重新加载" bind:action="load" />
  <block wx:else>
    <view class="flex items-start justify-between gap-3"><view class="min-w-0 flex-1"><view class="text-[length:40rpx] font-bold">{{item.title}}</view><view class="mt-2 text-[length:23rpx] text-muted">{{item.ownerNickname}} · {{item.cityName || item.branchName || '平台'}}</view></view><t-tag theme="{{item.status === 'PUBLISHED' ? 'success' : item.status === 'UNPUBLISHED' ? 'danger' : 'default'}}" variant="outline">{{item.statusText}}</t-tag></view>
    <image wx:if="{{item.coverUrl}}" class="mt-5 h-[320rpx] w-full rounded-[16rpx]" src="{{item.coverUrl}}" mode="aspectFill" />
    <view class="mt-5 rounded-[16rpx] bg-panel p-4"><view class="font-semibold">价值说明</view><view class="mt-2 whitespace-pre-wrap text-muted">{{item.valueSummary}}</view><view class="mt-4 font-semibold">合作目标</view><view class="mt-2 whitespace-pre-wrap text-muted">{{item.targetSummary || '未填写'}}</view><view class="mt-4 font-semibold">详细说明</view><view class="mt-2 whitespace-pre-wrap text-muted">{{item.description || '未填写'}}</view></view>
    <view class="mt-3 rounded-[16rpx] bg-panel p-4 text-[length:23rpx]"><view>合作角色：{{item.roleText}}</view><view class="mt-2">标签：{{item.tagText}}</view><view class="mt-2">截止时间：{{item.deadlineText}}</view><view class="mt-2">更新时间：{{item.updatedText}}</view></view>
    <view class="mt-6 text-[length:28rpx] font-semibold">组队玩家</view><view wx:if="{{item.teamMembers.length}}" class="mt-3 flex flex-col gap-2"><view wx:for="{{item.teamMembers}}" wx:key="userId" class="rounded-[12rpx] bg-panel px-4 py-3"><view>{{item.nickname}}</view><view class="mt-1 text-[length:21rpx] text-muted">{{item.branchName || '未加入分会'}}</view></view></view><app-empty-state wx:else class="mt-3" title="暂无组队玩家" description="用户加入机会后会显示在这里。" />
    <view wx:if="{{canManageComments && commentSettings}}" class="mt-6 rounded-[16rpx] bg-panel px-4 py-5">
      <view class="text-[length:28rpx] font-semibold">评论管理</view>
      <view class="mt-4 flex items-center justify-between"><view><view>开放评论</view><view class="mt-1 text-[length:21rpx] text-muted">允许用户发布普通评论</view></view><switch checked="{{commentSettings.commentsEnabled}}" color="#FCDF03" data-field="commentsEnabled" bindchange="updateCommentSetting" /></view>
      <view class="mt-4 flex items-center justify-between"><view><view>开放项目评价</view><view class="mt-1 text-[length:21rpx] text-muted">机会结束后允许提交评分和评价</view></view><switch checked="{{commentSettings.reviewsEnabled}}" color="#FCDF03" data-field="reviewsEnabled" bindchange="updateCommentSetting" /></view>
      <view class="mt-4 flex items-center justify-between"><view><view>开放打 call</view><view class="mt-1 text-[length:21rpx] text-muted">允许用户为评论表达支持</view></view><switch checked="{{commentSettings.callsEnabled}}" color="#FCDF03" data-field="callsEnabled" bindchange="updateCommentSetting" /></view>
      <view class="mt-4 flex items-center justify-between"><view><view>发布前审核</view><view class="mt-1 text-[length:21rpx] text-muted">开启后，新内容先进入待审核</view></view><switch checked="{{commentSettings.moderationMode === 'REVIEW'}}" color="#FCDF03" bindchange="updateModerationMode" /></view>
      <view class="mt-4"><t-button block theme="primary" loading="{{processing}}" bind:tap="saveCommentSettings">保存评论设置</t-button></view>
    </view>
    <view wx:if="{{canManageComments}}" class="mt-6">
      <view class="text-[length:28rpx] font-semibold">评论审核</view>
      <view wx:if="{{comments.length}}" class="mt-3 flex flex-col gap-2">
        <view wx:for="{{comments}}" wx:key="id" class="rounded-[12rpx] bg-panel px-4 py-4">
          <view class="flex items-center justify-between gap-3"><view class="min-w-0 truncate font-semibold">{{item.authorNickname}}{{item.participant ? ' · 参与人' : ''}}</view><view class="text-[length:20rpx] text-muted">{{item.statusText}}</view></view>
          <view class="mt-1 text-[length:20rpx] text-muted">{{item.type === 'REVIEW' ? '项目评价 · ' + item.rating + ' / 5' : '评论'}} · {{item.createdText}} · 打 call {{item.callCount}}</view>
          <view class="mt-3 whitespace-pre-wrap text-[length:23rpx] leading-7">{{item.body}}</view>
          <view class="mt-3 flex gap-2"><t-button wx:if="{{item.status === 'PENDING' || item.status === 'HIDDEN'}}" size="small" theme="primary" loading="{{processing}}" data-id="{{item.id}}" data-action="PUBLISH" bind:tap="moderateComment">发布</t-button><t-button wx:if="{{item.status === 'PENDING' || item.status === 'PUBLISHED'}}" size="small" variant="outline" theme="danger" loading="{{processing}}" data-id="{{item.id}}" data-action="HIDE" bind:tap="moderateComment">隐藏</t-button></view>
        </view>
      </view>
      <app-empty-state wx:else class="mt-3" title="暂无评论" description="用户提交的评论和项目评价会显示在这里。" />
    </view>
    <view wx:if="{{canManageComments}}" class="mt-6">
      <view class="text-[length:28rpx] font-semibold">评论举报</view>
      <view wx:if="{{commentReports.length}}" class="mt-3 flex flex-col gap-2">
        <view wx:for="{{commentReports}}" wx:key="id" class="rounded-[12rpx] bg-panel px-4 py-4">
          <view class="font-semibold">{{item.categoryText}}</view><view class="mt-1 text-[length:20rpx] text-muted">{{item.reporterNickname}} · {{item.createdText}}</view><view wx:if="{{item.description}}" class="mt-3 whitespace-pre-wrap text-[length:23rpx]">{{item.description}}</view>
          <view class="mt-3 flex gap-2"><t-button size="small" theme="danger" loading="{{processing}}" data-id="{{item.id}}" data-decision="RESOLVED" bind:tap="closeCommentReport">确认违规</t-button><t-button size="small" variant="outline" loading="{{processing}}" data-id="{{item.id}}" data-decision="DISMISSED" bind:tap="closeCommentReport">驳回举报</t-button></view>
        </view>
      </view>
      <app-empty-state wx:else class="mt-3" title="暂无待处理举报" description="用户提交的评论举报会显示在这里。" />
    </view>
    <view wx:if="{{item.status !== 'ARCHIVED'}}" class="mt-4 grid grid-cols-2 gap-2"><t-button block variant="outline" bind:tap="edit">编辑</t-button><t-button wx:if="{{item.status === 'DRAFT' || item.status === 'UNPUBLISHED'}}" block theme="primary" loading="{{processing}}" bind:tap="publish">发布</t-button><t-button wx:elif="{{item.status === 'PUBLISHED'}}" block theme="primary" loading="{{processing}}" bind:tap="end">结束</t-button><t-button wx:else block variant="outline" theme="danger" loading="{{processing}}" bind:tap="unpublish">下架</t-button></view>
    <view wx:if="{{item.status === 'PUBLISHED'}}" class="mt-3"><t-button block variant="outline" theme="danger" loading="{{processing}}" bind:tap="unpublish">下架</t-button></view>
    <view wx:if="{{canArchive && item.status !== 'PUBLISHED' && item.status !== 'ARCHIVED'}}" class="mt-3"><t-button block variant="outline" theme="danger" loading="{{processing}}" bind:tap="archive">归档</t-button></view>
    <view class="mt-6 text-[length:28rpx] font-semibold">操作记录</view><view wx:if="{{history.length}}" class="mt-3 flex flex-col gap-2"><view wx:for="{{history}}" wx:key="id" class="rounded-[12rpx] bg-panel px-4 py-3"><view>{{item.actionText}}</view><view class="mt-1 text-[length:21rpx] text-muted">{{item.actorNickname}} · {{item.createdText || '未记录'}}</view></view></view><app-empty-state wx:else class="mt-3" title="暂无操作记录" description="后续发生的操作会记录在这里。" />
    <view wx:if="{{message}}" class="mt-4 rounded-[12rpx] bg-panel px-4 py-3 text-danger">{{message}}</view>
  </block>
  <app-page-exit />
</view>
