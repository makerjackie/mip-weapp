<view id="admin-task-completions-page" class="mip-admin-page min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-4 text-ink">
  <view class="flex items-start justify-between gap-3"><view><view class="text-[length:38rpx] font-bold">任务完成流水</view><view class="mt-2 text-[length:23rpx] text-muted">查看完成结果、附件和奖励经验值</view></view><t-button size="small" variant="outline" loading="{{exporting}}" bind:tap="exportRows">导出</t-button></view>
  <view class="mip-admin-filter-grid mt-5 grid gap-3 rounded-[16rpx] bg-panel px-4 py-4"><view class="mip-admin-filter-wide"><input class="h-[80rpx] w-full rounded-[12rpx] bg-panel-raised px-3 text-[length:25rpx] text-ink" value="{{query}}" placeholder="搜索用户或任务" placeholder-class="text-muted" bindinput="updateQuery" confirm-type="search" bindconfirm="loadCompletions" /></view><view class="mip-admin-filter-wide flex gap-2"><t-tag variant="outline" data-value="" bind:tap="chooseResult">全部结果</t-tag><t-tag variant="outline" data-value="SUCCESS" bind:tap="chooseResult">成功</t-tag><t-tag variant="outline" data-value="FAILED" bind:tap="chooseResult">失败</t-tag></view><view class="mip-admin-filter-wide grid grid-cols-2 gap-3"><picker mode="date" value="{{completedFrom}}" bindchange="chooseFrom"><view class="rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:23rpx]">{{completedFrom || '开始日期'}}</view></picker><picker mode="date" value="{{completedUntil}}" bindchange="chooseUntil"><view class="rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:23rpx]">{{completedUntil || '结束日期'}}</view></picker></view><view wx:if="{{taskId || query || resultStatus || completedFrom || completedUntil}}" class="flex min-h-[80rpx] items-center justify-end text-[length:22rpx] text-brand" bind:tap="clearFilters">清除筛选</view></view>
  <view wx:if="{{selected}}" class="mt-4 rounded-[16rpx] border border-brand bg-panel px-4 py-5"><view class="flex items-center justify-between"><view class="text-[length:28rpx] font-semibold">流水详情</view><view class="text-[length:22rpx] text-muted" bind:tap="closeDetail">关闭</view></view><view class="mt-4 grid grid-cols-2 gap-3 text-[length:23rpx]"><view><view class="text-muted">用户</view><view class="mt-1">{{selected.nickname}}</view></view><view><view class="text-muted">处理结果</view><view class="mt-1">{{selected.resultText}}</view></view><view><view class="text-muted">任务</view><view class="mt-1">{{selected.taskName}}</view></view><view><view class="text-muted">奖励</view><view class="mt-1 text-brand">{{selected.rewardExperience}} 经验值</view></view></view><view class="mt-4 text-[length:22rpx] text-muted">完成时间</view><view class="mt-1 text-[length:24rpx]">{{selected.completedText}}</view><view class="mt-4 text-[length:22rpx] text-muted">任务内容快照</view><view class="mt-1 whitespace-pre-wrap text-[length:24rpx] leading-[1.6]">{{selected.taskContent}}</view><view wx:if="{{selected.attachment}}" class="mt-4"><view class="text-[length:22rpx] text-muted">附件 · {{selected.attachmentSizeText}}</view><image class="mt-2 h-[360rpx] w-full rounded-[12rpx] bg-panel-raised" mode="aspectFit" src="{{selected.attachment.url}}" /></view></view>
  <view wx:if="{{state === 'loading'}}" class="mt-5 rounded-[16rpx] bg-panel px-4 py-6"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}" class="mt-5"><app-empty-state title="暂时无法加载任务流水" description="{{message}}" action-text="重新加载" bind:action="loadCompletions" /></view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-5"><app-empty-state title="没有任务流水权限" description="当前账号不能查看任务流水。" /></view>
  <view wx:elif="{{state === 'empty'}}" class="mt-5"><app-empty-state title="暂无任务流水" description="符合筛选条件的完成记录会显示在这里。" /></view>
  <view wx:else class="mip-admin-card-list mt-5 flex flex-col gap-3"><view wx:for="{{items}}" wx:key="id" class="rounded-[16rpx] bg-panel px-4 py-4" data-id="{{item.id}}" bind:tap="openDetail"><view class="flex items-start justify-between gap-3"><view><view class="text-[length:27rpx] font-semibold">{{item.nickname}}</view><view class="mt-1 text-[length:22rpx] text-muted">{{item.taskName}}</view></view><view class="text-right"><view class="text-[length:24rpx] font-semibold text-brand">+{{item.rewardExperience}}</view><view class="mt-1 text-[length:20rpx] text-muted">{{item.resultText}}</view></view></view><view class="mt-3 flex items-center justify-between border-t border-line pt-3 text-[length:21rpx] text-muted"><text>{{item.completedText}}</text><text>{{item.attachment ? '有附件' : '无附件'}}</text></view></view></view>
  <view wx:if="{{nextCursor}}" class="mt-4"><t-button block variant="outline" loading="{{loadingMore}}" bind:tap="loadMore">加载更多</t-button></view>
  <view wx:if="{{message && state === 'ready'}}" class="mt-4 rounded-[12rpx] bg-panel px-4 py-3 text-[length:23rpx] text-danger">{{message}}</view>
  <app-page-exit />
</view>
