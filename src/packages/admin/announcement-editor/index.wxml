<view id="admin-announcement-editor-page" class="min-h-screen bg-canvas px-5 pb-[calc(env(safe-area-inset-bottom)+120rpx)] pt-5 text-ink">
  <view class="border-b border-ink pb-5"><view class="text-[length:21rpx] font-semibold tracking-[0.16em] text-brand">社区公告</view><view class="mt-2 text-[length:40rpx] font-bold">{{announcementId ? '编辑公告' : '新建公告'}}</view><view class="mt-2 text-[length:21rpx] text-muted">先保存草稿，再从公告列表确认发布。</view></view>
  <view wx:if="{{state === 'loading'}}" class="mt-5 bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}" class="mt-5"><app-empty-state title="暂时无法编辑公告" description="{{message}}" action-text="重新加载" bind:action="loadItem" /></view>
  <view wx:else class="mt-5 flex flex-col gap-4">
    <view class="rounded-[22rpx] bg-panel px-4 py-4"><view class="text-[length:22rpx] font-semibold">标题</view><input class="mt-3 box-border min-h-[72rpx] max-w-full rounded-[16rpx] bg-canvas px-3 text-[length:25rpx]" maxlength="80" value="{{title}}" placeholder="例如：本周活动安排" bind:input="updateTitle" /></view>
    <view class="rounded-[22rpx] bg-panel px-4 py-4"><view class="text-[length:22rpx] font-semibold">摘要</view><textarea class="mt-3 box-border h-[150rpx] w-full max-w-full rounded-[16rpx] bg-canvas px-3 py-3 text-[length:24rpx]" maxlength="160" value="{{summary}}" placeholder="列表中显示的一两句话" bind:input="updateSummary" /></view>
    <view class="rounded-[22rpx] bg-panel px-4 py-4"><view class="text-[length:22rpx] font-semibold">正文</view><textarea class="mt-3 box-border h-[420rpx] w-full max-w-full rounded-[16rpx] bg-canvas px-3 py-3 text-[length:24rpx]" maxlength="5000" value="{{body}}" placeholder="完整公告内容" bind:input="updateBody" /></view>
    <t-button block theme="primary" loading="{{saving}}" bind:tap="save">保存草稿</t-button>
  </view>
  <view wx:if="{{message && state === 'ready'}}" class="mt-4 rounded-[18rpx] bg-[#FFF0E8] px-4 py-3 text-[length:23rpx] text-[#9F4727]">{{message}}</view>
  <app-page-exit />
</view>
