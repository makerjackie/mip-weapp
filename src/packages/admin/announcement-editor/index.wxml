<view id="admin-announcement-editor-page" class="mip-admin-page mip-admin-workspace-page min-h-screen bg-canvas px-6 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-7 text-ink">
  <mip-admin-workspace-nav />
  <view class="text-[length:40rpx] font-bold">{{announcementId ? '公告详情' : '新建公告'}}</view>
  <view class="mt-2 text-[length:23rpx] text-muted">保存后在公告列表确认发布</view>

  <view wx:if="{{state === 'loading'}}" class="mt-6 rounded-[16rpx] bg-panel px-5 py-6"><t-skeleton row-col="{{[1,1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error' || state === 'conflict'}}" class="mt-6"><app-empty-state title="暂时无法编辑公告" description="{{message}}" action-text="重新加载" bind:action="retryLoad" /></view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-6"><app-empty-state title="没有公告管理权限" description="当前账号不能维护公告。" /></view>
  <view wx:else class="mip-admin-section-grid mt-5 flex flex-col gap-4">
    <view wx:if="{{announcementId}}" class="rounded-[16rpx] bg-panel px-4 py-4"><view class="flex items-center justify-between"><text class="text-[length:24rpx]">公告状态</text><text class="text-[length:23rpx] text-muted">{{status === 'DRAFT' ? '草稿' : status === 'PUBLISHED' ? '已发布' : '已撤回'}}</text></view><view class="mt-3 flex items-center justify-between"><text class="text-[length:24rpx]">内容检查</text><text class="text-[length:23rpx] text-muted">{{safetyText}}</text></view><view wx:if="{{!editable}}" class="mt-3 text-[length:22rpx] text-muted">已发布公告需要先撤回再编辑。</view></view>

    <view class="rounded-[16rpx] bg-panel px-4 py-4">
      <view class="text-[length:26rpx] font-semibold">展示范围</view>
      <view class="mt-3 grid grid-cols-2 gap-2"><view wx:if="{{platformAllowed}}" class="rounded-[12rpx] px-3 py-3 text-center text-[length:23rpx] {{draft.scopeType === 'PLATFORM' ? 'bg-brand text-on-brand' : 'bg-panel-raised text-muted'}}" data-scope="PLATFORM" bind:tap="chooseScope">全平台</view><view wx:if="{{branches.length}}" class="rounded-[12rpx] px-3 py-3 text-center text-[length:23rpx] {{draft.scopeType === 'BRANCH' ? 'bg-brand text-on-brand' : 'bg-panel-raised text-muted'}}" data-scope="BRANCH" bind:tap="chooseScope">城市分会</view></view>
      <picker wx:if="{{draft.scopeType === 'BRANCH'}}" class="mt-3" range="{{branches}}" range-key="name" value="{{branchIndex}}" disabled="{{!editable}}" bindchange="changeBranch"><view class="min-h-[72rpx] rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:24rpx]">{{branchIndex >= 0 ? branches[branchIndex].name : '选择城市分会'}}</view></picker>
    </view>

    <view class="rounded-[16rpx] bg-panel px-4 py-4"><view class="text-[length:24rpx] font-semibold">标题</view><view class="mt-3"><t-input value="{{draft.title}}" maxlength="100" placeholder="填写公告标题" disabled="{{!editable}}" data-field="title" bind:change="updateField" /></view></view>
    <view class="rounded-[16rpx] bg-panel px-4 py-4"><view class="text-[length:24rpx] font-semibold">摘要</view><textarea class="mt-3 box-border h-[160rpx] w-full rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:24rpx]" value="{{draft.summary}}" maxlength="240" placeholder="填写列表摘要" disabled="{{!editable}}" data-field="summary" bind:input="updateField" /></view>
    <view class="mip-admin-span-wide rounded-[16rpx] bg-panel px-4 py-4"><view class="text-[length:24rpx] font-semibold">正文</view><textarea class="mt-3 box-border h-[440rpx] w-full rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:24rpx] leading-[1.7]" value="{{draft.body}}" maxlength="5000" placeholder="填写公告正文" disabled="{{!editable}}" data-field="body" bind:input="updateField" /></view>

    <view class="rounded-[16rpx] bg-panel px-4 py-4">
      <view class="text-[length:26rpx] font-semibold">关联内容</view>
      <view class="mt-3 grid grid-cols-3 gap-2"><view class="rounded-[12rpx] px-2 py-3 text-center text-[length:22rpx] {{!draft.targetType ? 'bg-brand text-on-brand' : 'bg-panel-raised text-muted'}}" data-type="" bind:tap="chooseTargetType">不关联</view><view class="rounded-[12rpx] px-2 py-3 text-center text-[length:22rpx] {{draft.targetType === 'EVENT' ? 'bg-brand text-on-brand' : 'bg-panel-raised text-muted'}}" data-type="EVENT" bind:tap="chooseTargetType">活动</view><view class="rounded-[12rpx] px-2 py-3 text-center text-[length:22rpx] {{draft.targetType === 'OPPORTUNITY' ? 'bg-brand text-on-brand' : 'bg-panel-raised text-muted'}}" data-type="OPPORTUNITY" bind:tap="chooseTargetType">机会</view></view>
      <picker wx:if="{{draft.targetType}}" class="mt-3" range="{{targetOptions}}" range-key="label" value="{{targetIndex}}" disabled="{{!editable || targetLoading}}" bindchange="changeTarget"><view class="min-h-[72rpx] rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:24rpx]">{{targetLoading ? '正在加载' : targetIndex >= 0 ? targetOptions[targetIndex].label : '选择关联内容'}}</view></picker>
    </view>

    <view class="rounded-[16rpx] bg-panel px-4 py-4">
      <view class="text-[length:26rpx] font-semibold">展示时间</view>
      <view class="mt-3 grid grid-cols-2 gap-2"><picker mode="date" value="{{visibleFromDate}}" disabled="{{!editable}}" data-field="visibleFromDate" bindchange="changeDateTimePart"><view class="rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:23rpx]"><view class="text-muted">开始日期</view><view class="mt-1">{{visibleFromDate}}</view></view></picker><picker mode="time" value="{{visibleFromTime}}" disabled="{{!editable}}" data-field="visibleFromTime" bindchange="changeDateTimePart"><view class="rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:23rpx]"><view class="text-muted">开始时间</view><view class="mt-1">{{visibleFromTime}}</view></view></picker></view>
      <view class="mt-4 flex items-center justify-between"><text class="text-[length:24rpx]">设置结束时间</text><t-switch value="{{visibleUntilEnabled}}" disabled="{{!editable}}" bind:change="toggleVisibleUntil" /></view>
      <view wx:if="{{visibleUntilEnabled}}" class="mt-3 grid grid-cols-2 gap-2"><picker mode="date" value="{{visibleUntilDate}}" disabled="{{!editable}}" data-field="visibleUntilDate" bindchange="changeDateTimePart"><view class="rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:23rpx]"><view class="text-muted">结束日期</view><view class="mt-1">{{visibleUntilDate}}</view></view></picker><picker mode="time" value="{{visibleUntilTime}}" disabled="{{!editable}}" data-field="visibleUntilTime" bindchange="changeDateTimePart"><view class="rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:23rpx]"><view class="text-muted">结束时间</view><view class="mt-1">{{visibleUntilTime}}</view></view></picker></view>
    </view>

    <view wx:if="{{editable}}" class="mip-admin-span-wide"><t-button block theme="primary" loading="{{saving}}" bind:tap="save">保存草稿</t-button></view>
  </view>
  <view wx:if="{{message && state === 'ready'}}" class="mt-4 rounded-[12rpx] bg-panel px-4 py-3 text-[length:23rpx] text-danger">{{message}}</view>
  <app-page-exit />
</view>
