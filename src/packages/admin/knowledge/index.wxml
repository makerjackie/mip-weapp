<view id="admin-knowledge-page" class="mip-admin-page mip-admin-workspace-page min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-4 text-ink">
  <mip-admin-workspace-nav />
  <view class="flex items-start justify-between gap-3">
    <view><view class="text-[length:38rpx] font-bold">知识内容管理</view><view class="mt-2 text-[length:23rpx] text-muted">维护信息源、分类、采集计划、内容和评论审核</view></view>
    <t-button wx:if="{{section === 'CONTENTS' || section === 'SOURCES' || section === 'CATEGORIES' || section === 'SCHEDULES'}}" size="small" theme="primary" bind:tap="openCreate">新增</t-button>
  </view>

  <scroll-view scroll-x class="mt-5 whitespace-nowrap"><view class="inline-flex gap-2"><t-tag wx:for="{{sectionOptions}}" wx:key="value" variant="{{section === item.value ? 'light' : 'outline'}}" theme="warning" data-section="{{item.value}}" bind:tap="chooseSection">{{item.label}}</t-tag></view></scroll-view>

  <view wx:if="{{state === 'loading'}}" class="mt-5 rounded-[16rpx] bg-panel px-4 py-6"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error' || state === 'conflict'}}" class="mt-5"><app-empty-state title="暂时无法加载知识内容管理" description="{{message}}" action-text="重新加载" bind:action="load" /></view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-5"><app-empty-state title="没有知识内容管理权限" description="当前账号不能管理知识内容。" /></view>

  <block wx:else>
    <view wx:if="{{editorKind}}" class="mt-4 rounded-[16rpx] border border-brand bg-panel px-4 py-4">
      <view class="flex items-center justify-between"><view class="text-[length:28rpx] font-semibold">{{editorId ? '编辑' : '新增'}}{{editorKind === 'SOURCE' ? '信息源' : editorKind === 'CATEGORY' ? '分类' : editorKind === 'SCHEDULE' ? '采集计划' : '内容'}}</view><view class="flex min-h-[88rpx] items-center px-2 text-[length:22rpx] text-muted" bind:tap="closeEditor">关闭</view></view>

      <view wx:if="{{editorKind === 'SOURCE'}}" class="mip-admin-section-grid mt-3 flex flex-col gap-2">
        <t-input value="{{editorKey}}" label="信息源标识" placeholder="稳定英文标识" data-field="editorKey" bind:change="updateField" />
        <t-input value="{{editorName}}" label="名称" data-field="editorName" bind:change="updateField" />
        <picker class="box-border min-h-[88rpx] rounded-[12rpx] bg-panel-raised px-3 py-3" range="{{sourceTypeOptions}}" range-key="label" value="{{sourceTypeIndex}}" bindchange="chooseSourceType"><view class="text-[length:22rpx] text-muted">来源类型</view><view class="mt-1 text-[length:25rpx]">{{sourceTypeOptions[sourceTypeIndex].label}}</view></picker>
        <t-input wx:if="{{sourceTypeIndex > 0}}" value="{{editorEndpointUrl}}" label="HTTPS 地址" placeholder="https://" data-field="editorEndpointUrl" bind:change="updateField" />
        <view class="flex items-center justify-between rounded-[12rpx] bg-panel-raised px-3 py-3"><text class="text-[length:24rpx]">启用信息源</text><t-switch value="{{editorStatus === 'ACTIVE'}}" bind:change="toggleEditorActive" /></view>
      </view>

      <view wx:elif="{{editorKind === 'CATEGORY'}}" class="mip-admin-section-grid mt-3 flex flex-col gap-2">
        <t-input value="{{editorKey}}" label="分类标识" placeholder="稳定英文标识" data-field="editorKey" bind:change="updateField" />
        <t-input value="{{editorName}}" label="分类名称" data-field="editorName" bind:change="updateField" />
        <view class="mip-admin-span-wide"><t-textarea value="{{editorSummary}}" label="分类说明" maxlength="300" data-field="editorSummary" bind:change="updateField" /></view>
        <t-input value="{{editorSortOrder}}" type="number" label="显示顺序" data-field="editorSortOrder" bind:change="updateField" />
        <view class="flex items-center justify-between rounded-[12rpx] bg-panel-raised px-3 py-3"><text class="text-[length:24rpx]">启用分类</text><t-switch value="{{editorStatus === 'ACTIVE'}}" bind:change="toggleEditorActive" /></view>
      </view>

      <view wx:elif="{{editorKind === 'CONTENT'}}" class="mip-admin-section-grid mt-3 flex flex-col gap-2">
        <picker class="box-border min-h-[88rpx] rounded-[12rpx] bg-panel-raised px-3 py-3" range="{{categories}}" range-key="name" value="{{editorCategoryIndex}}" bindchange="chooseEditorCategory"><view class="text-[length:22rpx] text-muted">内容分类</view><view class="mt-1 text-[length:25rpx]">{{categories[editorCategoryIndex].name || '请先新增分类'}}</view></picker>
        <picker class="box-border min-h-[88rpx] rounded-[12rpx] bg-panel-raised px-3 py-3" range="{{sourcePickerOptions}}" range-key="name" value="{{editorSourceIndex}}" bindchange="chooseEditorSource"><view class="text-[length:22rpx] text-muted">信息源</view><view class="mt-1 text-[length:25rpx]">{{sourcePickerOptions[editorSourceIndex].name}}</view></picker>
        <picker class="box-border min-h-[88rpx] rounded-[12rpx] bg-panel-raised px-3 py-3" range="{{contentTypeOptions}}" range-key="label" value="{{contentTypeIndex}}" bindchange="chooseContentType"><view class="text-[length:22rpx] text-muted">内容类型</view><view class="mt-1 text-[length:25rpx]">{{contentTypeOptions[contentTypeIndex].label}}</view></picker>
        <picker class="box-border min-h-[88rpx] rounded-[12rpx] bg-panel-raised px-3 py-3" range="{{accessTypeOptions}}" range-key="label" value="{{accessTypeIndex}}" bindchange="chooseAccessType"><view class="text-[length:22rpx] text-muted">访问方式</view><view class="mt-1 text-[length:25rpx]">{{accessTypeOptions[accessTypeIndex].label}}</view></picker>
        <view class="mip-admin-span-wide"><t-input value="{{editorTitle}}" label="标题" data-field="editorTitle" bind:change="updateField" /></view>
        <view class="mip-admin-span-wide"><t-textarea value="{{editorSummary}}" label="摘要" maxlength="500" data-field="editorSummary" bind:change="updateField" /></view>
        <view wx:if="{{contentTypeIndex === 0 || contentTypeIndex === 1 || contentTypeIndex === 5}}" class="mip-admin-span-wide"><t-textarea value="{{editorBody}}" label="正文" maxlength="100000" data-field="editorBody" bind:change="updateField" /></view>
        <view wx:if="{{contentTypeIndex === 2 || contentTypeIndex === 3}}" class="mip-admin-span-wide"><t-input value="{{editorExternalUrl}}" label="HTTPS 内容地址" placeholder="https://" data-field="editorExternalUrl" bind:change="updateField" /></view>
        <block wx:if="{{contentTypeIndex === 4}}"><t-input value="{{editorFinderUserName}}" label="视频号原始 ID" data-field="editorFinderUserName" bind:change="updateField" /><t-input value="{{editorFeedId}}" label="视频 feedId" data-field="editorFeedId" bind:change="updateField" /></block>
        <t-input value="{{editorAuthorName}}" label="作者或专家" placeholder="选填" data-field="editorAuthorName" bind:change="updateField" />
        <view class="flex items-center justify-between rounded-[12rpx] bg-panel-raised px-3 py-3"><text class="text-[length:24rpx]">开启评论</text><t-switch value="{{editorCommentsEnabled}}" bind:change="toggleComments" /></view>
        <view class="flex items-center justify-between rounded-[12rpx] bg-panel-raised px-3 py-3"><text class="text-[length:24rpx]">评论先审核后发布</text><t-switch value="{{editorReviewMode}}" bind:change="toggleReviewMode" /></view>
        <view wx:if="{{accessTypeIndex === 2}}" class="mip-admin-span-wide mt-2 rounded-[12rpx] border border-line px-3 py-3">
          <view class="text-[length:24rpx] font-semibold">单内容付费目录</view>
          <view class="mt-2 flex flex-col gap-2"><t-input value="{{editorPriceYuan}}" type="digit" label="价格（元）" placeholder="留空使用测试默认价" data-field="editorPriceYuan" bind:change="updateField" /><t-input value="{{editorUnlockDays}}" type="number" label="有效天数" placeholder="留空为永久" data-field="editorUnlockDays" bind:change="updateField" /><t-input value="{{editorRefundWindowHours}}" type="number" label="未访问退款时限（小时）" data-field="editorRefundWindowHours" bind:change="updateField" /></view>
          <view class="mt-2 flex items-center justify-between"><text class="text-[length:23rpx]">目录启用</text><t-switch value="{{editorProductActive}}" bind:change="toggleProductActive" /></view>
          <view class="mt-2 flex items-center justify-between"><text class="text-[length:23rpx]">首次访问前可退款</text><t-switch value="{{editorRefundable}}" bind:change="toggleRefundable" /></view>
        </view>
      </view>
      <view wx:else class="mip-admin-section-grid mt-3 flex flex-col gap-2">
        <picker class="box-border min-h-[88rpx] max-w-full rounded-[12rpx] bg-panel-raised px-3 py-3" range="{{scheduleSourceOptions}}" range-key="name" value="{{scheduleSourceIndex}}" disabled="{{processing || scheduleRetryPending}}" bindchange="chooseScheduleSource"><view class="text-[length:22rpx] text-muted">信息源</view><view class="mt-1 truncate text-[length:25rpx]">{{scheduleSourceIndex >= 0 ? scheduleSourceOptions[scheduleSourceIndex].name : '暂无可用信息源'}}</view><view wx:if="{{scheduleSourceIndex >= 0}}" class="mt-1 text-[length:20rpx] text-muted">{{scheduleSourceOptions[scheduleSourceIndex].sourceType}}</view></picker>
        <picker class="box-border min-h-[88rpx] max-w-full rounded-[12rpx] bg-panel-raised px-3 py-3" range="{{scheduleCategoryOptions}}" range-key="name" value="{{scheduleCategoryIndex}}" disabled="{{processing || scheduleRetryPending}}" bindchange="chooseScheduleCategory"><view class="text-[length:22rpx] text-muted">内容分类</view><view class="mt-1 truncate text-[length:25rpx]">{{scheduleCategoryIndex >= 0 ? scheduleCategoryOptions[scheduleCategoryIndex].name : '暂无可用分类'}}</view></picker>
        <picker class="box-border min-h-[88rpx] max-w-full rounded-[12rpx] bg-panel-raised px-3 py-3" mode="time" value="{{scheduleTimeOfDay}}" disabled="{{processing || scheduleRetryPending}}" bindchange="chooseScheduleTime"><view class="text-[length:22rpx] text-muted">每日执行时间</view><view class="mt-1 text-[length:25rpx]">{{scheduleTimeOfDay}}</view></picker>
        <view class="box-border min-h-[88rpx] rounded-[12rpx] bg-panel-raised px-3 py-3"><view class="text-[length:22rpx] text-muted">时区</view><view class="mt-1 text-[length:25rpx]">{{scheduleTimeZone}}</view></view>
        <view class="flex min-h-[88rpx] items-center justify-between rounded-[12rpx] bg-panel-raised px-3 py-3"><view><view class="text-[length:24rpx]">启用计划</view><view class="mt-1 text-[length:20rpx] text-muted">暂停后不再自动采集</view></view><t-switch value="{{scheduleStatus === 'ACTIVE'}}" disabled="{{processing || scheduleRetryPending}}" bind:change="toggleScheduleActive" /></view>
        <view class="box-border min-h-[88rpx] rounded-[12rpx] bg-panel-raised px-3 py-3"><view class="text-[length:22rpx] text-muted">当前版本</view><view class="mt-1 text-[length:25rpx]">{{editorVersion}}</view></view>
        <view wx:if="{{scheduleRetryPending}}" class="mip-admin-span-wide rounded-[12rpx] border border-brand bg-brand-soft px-3 py-3 text-[length:22rpx] leading-[1.6]">计划可能已保存。请保持当前内容不变，并重试确认自动执行状态。</view>
      </view>
      <view class="mt-4"><t-button block theme="primary" loading="{{processing}}" disabled="{{editorKind === 'SCHEDULE' && (scheduleSourceIndex < 0 || scheduleCategoryIndex < 0)}}" bind:tap="saveEditor">{{editorKind === 'SCHEDULE' && scheduleRetryPending ? '重试确认' : '保存'}}</t-button></view>
    </view>

    <view wx:if="{{section === 'RUNS' && categories.length}}" class="mt-4 rounded-[16rpx] bg-panel px-4 py-4"><view class="text-[length:24rpx] font-semibold">热点归档分类</view><picker class="mt-3 rounded-[12rpx] bg-panel-raised px-3 py-3" range="{{categories}}" range-key="name" value="{{ingestionCategoryIndex}}" bindchange="chooseIngestionCategory"><view class="text-[length:24rpx]">{{categories[ingestionCategoryIndex].name}}</view></picker><view class="mt-2 text-[length:21rpx] text-muted">抓取仅由运营人员手动触发，内容进入待审核状态。</view></view>

    <view wx:if="{{section === 'SCHEDULES' ? !schedules.length && !editorKind : !items.length && !editorKind}}" class="mt-5"><app-empty-state title="暂无记录" description="当前栏目没有可显示的记录。" /></view>
    <view wx:elif="{{section !== 'SCHEDULES'}}" class="mip-admin-card-list mt-4 flex flex-col gap-3">
      <view wx:for="{{items}}" wx:key="id" class="rounded-[16rpx] bg-panel px-4 py-4">
        <view class="flex items-start justify-between gap-3"><view class="min-w-0 flex-1"><view class="text-[length:27rpx] font-semibold">{{item.title || item.name || item.contentTitle || item.sourceName || '处理记录'}}</view><view wx:if="{{section === 'COMMENTS'}}" class="mt-2 whitespace-pre-wrap text-[length:24rpx]">{{item.body}}</view><view wx:if="{{section === 'REPORTS' && item.description}}" class="mt-2 text-[length:23rpx]">{{item.description}}</view><view class="mt-2 text-[length:21rpx] text-muted">{{item.detailLabel}}</view></view><t-tag variant="outline">{{item.statusLabel}}</t-tag></view>
        <view wx:if="{{item.summary && section === 'CONTENTS'}}" class="mt-2 line-clamp-2 text-[length:22rpx] text-muted">{{item.summary}}</view>
        <view wx:if="{{item.product}}" class="mt-2 text-[length:21rpx] text-muted">付费目录 {{item.priceLabel}} · {{item.product.status}}</view>

        <view wx:if="{{section === 'SOURCES' || section === 'CATEGORIES'}}" class="mt-3"><t-button size="small" variant="outline" data-id="{{item.id}}" bind:tap="editItem">编辑</t-button></view>
        <view wx:if="{{section === 'CONTENTS'}}" class="mt-3 flex flex-wrap gap-2">
          <t-button wx:if="{{item.status !== 'PUBLISHED'}}" size="small" variant="outline" data-id="{{item.id}}" bind:tap="editItem">编辑</t-button>
          <t-button wx:if="{{item.status === 'DRAFT' && !item.reviewedAt}}" size="small" theme="primary" data-id="{{item.id}}" data-version="{{item.version}}" data-decision="SUBMIT" bind:tap="transitionContent">提交审核</t-button>
          <t-button wx:if="{{item.status === 'PENDING_REVIEW'}}" size="small" theme="primary" data-id="{{item.id}}" data-version="{{item.version}}" data-decision="APPROVE" bind:tap="transitionContent">审核通过</t-button>
          <t-button wx:if="{{item.status === 'PENDING_REVIEW'}}" size="small" variant="outline" data-id="{{item.id}}" data-version="{{item.version}}" data-decision="REJECT" bind:tap="transitionContent">驳回</t-button>
          <t-button wx:if="{{item.status === 'DRAFT' && item.reviewedAt}}" size="small" theme="primary" data-id="{{item.id}}" data-version="{{item.version}}" data-decision="PUBLISH" bind:tap="transitionContent">发布</t-button>
          <t-button wx:if="{{item.status === 'PUBLISHED'}}" size="small" variant="outline" data-id="{{item.id}}" data-version="{{item.version}}" data-decision="WITHDRAW" bind:tap="transitionContent">下架</t-button>
        </view>
        <view wx:if="{{section === 'COMMENTS'}}" class="mt-3 flex gap-2"><t-button wx:if="{{item.status !== 'PUBLISHED'}}" size="small" theme="primary" data-id="{{item.id}}" data-version="{{item.version}}" data-decision="PUBLISH" bind:tap="moderateComment">发布</t-button><t-button wx:if="{{item.status !== 'HIDDEN'}}" size="small" variant="outline" data-id="{{item.id}}" data-version="{{item.version}}" data-decision="HIDE" bind:tap="moderateComment">隐藏</t-button></view>
        <view wx:if="{{section === 'REPORTS' && (item.status === 'PENDING' || item.status === 'REVIEWING')}}" class="mt-3 flex gap-2"><t-button size="small" theme="primary" data-id="{{item.id}}" data-version="{{item.version}}" data-status="RESOLVED" bind:tap="closeReport">已处理</t-button><t-button size="small" variant="outline" data-id="{{item.id}}" data-version="{{item.version}}" data-status="DISMISSED" bind:tap="closeReport">驳回</t-button></view>
      </view>
    </view>

    <view wx:if="{{section === 'SCHEDULES' && schedules.length}}" class="mip-admin-card-list mt-4 flex flex-col gap-3">
      <view wx:for="{{schedules}}" wx:key="id" class="rounded-[16rpx] bg-panel px-4 py-4">
        <view class="flex items-start justify-between gap-3"><view class="min-w-0 flex-1"><view class="truncate text-[length:27rpx] font-semibold">{{item.source.name}}</view><view class="mt-1 text-[length:22rpx] text-muted">每日 {{item.dailyTime}} · {{item.category.name}}</view></view><t-tag variant="outline" theme="{{item.status === 'ACTIVE' ? 'warning' : 'default'}}">{{item.statusLabel}}</t-tag></view>
        <view class="mt-3 rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:21rpx] leading-[1.7] text-muted"><view>时区：{{item.timeZone}}</view><view>下次执行：{{item.nextRunLabel || '尚未安排'}}</view><view>最近开始：{{item.lastStartedLabel || '尚未执行'}}</view><view>最近完成：{{item.lastCompletedLabel || '尚未完成'}}</view><view wx:if="{{item.lastRunId}}" class="break-all">最近执行编号：{{item.lastRunId}}</view><view wx:if="{{item.lastErrorCode}}" class="text-danger">最近错误：{{item.lastErrorCode}}（已尝试 {{item.attemptCount}} 次）</view></view>
        <view class="mt-3 flex items-center justify-between gap-3"><view class="text-[length:20rpx] text-muted">{{item.source.sourceType}} · 版本 {{item.version}}</view><t-button size="small" variant="outline" disabled="{{processing || scheduleRetryPending}}" data-id="{{item.id}}" bind:tap="editItem">编辑</t-button></view>
      </view>
    </view>

    <view wx:if="{{section === 'RUNS' && sources.length}}" class="mt-5"><view class="mb-3 text-[length:27rpx] font-semibold">手动抓取</view><view class="mip-admin-card-list flex flex-col gap-3"><view wx:for="{{sources}}" wx:key="id" class="flex items-center justify-between gap-3 rounded-[16rpx] bg-panel px-4 py-4"><view><view class="text-[length:25rpx] font-semibold">{{item.name}}</view><view class="mt-1 text-[length:21rpx] text-muted">{{item.sourceType}}</view></view><t-button size="small" theme="primary" disabled="{{item.sourceType === 'MANUAL' || item.status !== 'ACTIVE' || processing}}" data-id="{{item.id}}" bind:tap="runIngestion">抓取</t-button></view></view></view>
    <view wx:if="{{message}}" class="mt-4 rounded-[12rpx] bg-panel px-4 py-3 text-[length:22rpx] text-danger">{{message}}</view>
  </block>
  <app-page-exit />
</view>
