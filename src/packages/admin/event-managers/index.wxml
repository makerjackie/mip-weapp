<view id="admin-event-managers-page" class="min-h-screen bg-canvas px-6 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-7 text-ink">
  <view class="text-[length:40rpx] font-bold">活动团队</view><view class="mt-2 text-[length:23rpx] text-muted">负责人、管理员和现场人员按角色权限执行任务。</view>
  <view wx:if="{{canChange}}" class="mt-5 rounded-[16rpx] bg-panel p-4"><t-input value="{{query}}" placeholder="搜索成员昵称" bind:change="updateQuery" bind:enter="search" /><view class="mt-3 flex flex-wrap gap-2"><t-tag wx:if="{{canGrantOwner}}" variant="outline" data-role="EVENT_OWNER" bind:tap="chooseRole">负责人</t-tag><t-tag wx:if="{{canGrantManager}}" variant="outline" data-role="EVENT_MANAGER" bind:tap="chooseRole">管理员</t-tag><t-tag wx:if="{{canGrantStaff}}" variant="outline" data-role="EVENT_STAFF" bind:tap="chooseRole">现场人员</t-tag></view><view class="mt-2 text-[length:22rpx] text-muted">将设置为：{{selectedRole}}</view><view wx:if="{{candidates.length}}" class="mt-3 flex flex-col gap-2"><view wx:for="{{candidates}}" wx:key="id" class="flex items-center rounded-[12rpx] bg-panel-raised px-3 py-3"><view class="flex-1"><view class="text-[length:25rpx]">{{item.nickname}}</view><view class="mt-1 text-[length:21rpx] text-muted">{{item.cityName || '未填写城市'}}</view></view><t-button size="small" loading="{{processingId === item.id}}" data-id="{{item.id}}" bind:tap="grant">设置</t-button></view></view></view>
  <view wx:if="{{state === 'loading'}}" class="mt-6 rounded-[16rpx] bg-panel p-5"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error' || state === 'conflict'}}" class="mt-6"><app-empty-state title="暂时无法加载团队" description="{{message}}" action-text="重新加载" bind:action="loadRoles" /></view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-6"><app-empty-state title="没有团队管理权限" description="当前账号不能查看活动团队。" /></view>
  <view wx:elif="{{roles.length === 0}}" class="mt-6"><app-empty-state title="暂未设置活动团队" description="拥有权限的账号可以搜索成员并设置角色。" /></view>
  <view wx:else class="mt-5 flex flex-col gap-3"><view wx:for="{{roles}}" wx:key="id" class="flex items-center rounded-[16rpx] bg-panel px-4 py-4"><view class="flex-1"><view class="text-[length:27rpx] font-semibold">{{item.nickname}}</view><view class="mt-1 text-[length:22rpx] text-muted">{{item.roleKey}} · {{item.status}}</view></view><t-button wx:if="{{canChange && item.canManage && item.status === 'ACTIVE'}}" size="small" variant="outline" theme="danger" loading="{{processingId === item.userId}}" data-user-id="{{item.userId}}" data-role="{{item.roleKey}}" bind:tap="revoke">撤销</t-button></view></view>
  <view wx:if="{{message && state === 'ready'}}" class="mt-4 rounded-[12rpx] bg-panel px-4 py-3 text-[length:23rpx] text-danger">{{message}}</view>
  <app-page-exit />
</view>
