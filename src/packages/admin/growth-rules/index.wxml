<view id="admin-growth-rules-page" class="mip-admin-page mip-admin-workspace-page min-h-screen bg-canvas px-6 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-7 text-ink">
  <mip-admin-workspace-nav />
  <view class="text-[length:40rpx] font-bold">奖励规则</view>
  <view class="mt-2 text-[length:23rpx] text-muted">奖励行为和成长类型由服务端固定，可调整奖励数值、每日上限和状态。</view>
  <view wx:if="{{canConfigure && !editorId}}" class="mt-5 rounded-[16rpx] bg-panel px-4 py-3 text-[length:23rpx] text-muted">选择下方规则进行编辑。</view>
  <view wx:if="{{canConfigure && editorId}}" class="mt-5 rounded-[16rpx] bg-panel p-4">
    <view class="text-[length:27rpx] font-semibold">编辑规则</view>
    <view class="mt-3 text-[length:25rpx] font-semibold">{{name}}</view>
    <view class="mt-1 text-[length:22rpx] text-muted">{{sourceLabel}} · {{metric === 'EXPERIENCE' ? '经验值' : '贡献值'}}</view>
    <view class="mip-admin-section-grid mt-3 grid gap-2"><view><t-input type="number" value="{{deltaValue}}" placeholder="单次奖励数值" data-field="deltaValue" bind:change="updateField" /></view><view><t-input type="number" value="{{dailyLimitValue}}" placeholder="每日上限，可不填" data-field="dailyLimitValue" bind:change="updateField" /></view></view>
    <view class="mt-3 flex gap-2" role="radiogroup" aria-label="规则状态"><view class="flex min-h-[88rpx] items-center" role="radio" aria-checked="{{status === 'DRAFT'}}"><t-tag variant="outline" theme="{{status === 'DRAFT' ? 'primary' : 'default'}}" data-field="status" data-value="DRAFT" bind:tap="choose">草稿</t-tag></view><view class="flex min-h-[88rpx] items-center" role="radio" aria-checked="{{status === 'ACTIVE'}}"><t-tag variant="outline" theme="{{status === 'ACTIVE' ? 'primary' : 'default'}}" data-field="status" data-value="ACTIVE" bind:tap="choose">启用</t-tag></view><view class="flex min-h-[88rpx] items-center" role="radio" aria-checked="{{status === 'INACTIVE'}}"><t-tag variant="outline" theme="{{status === 'INACTIVE' ? 'primary' : 'default'}}" data-field="status" data-value="INACTIVE" bind:tap="choose">停用</t-tag></view></view>
    <view class="mt-4 grid grid-cols-2 gap-2"><t-button block variant="outline" bind:tap="resetEditor">取消</t-button><t-button block theme="primary" loading="{{saving}}" bind:tap="save">保存</t-button></view>
  </view>
  <view wx:if="{{state === 'loading'}}" class="mt-6 rounded-[16rpx] bg-panel p-5"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error' || state === 'conflict'}}" class="mt-6"><app-empty-state title="暂时无法加载规则" description="{{message}}" action-text="重新加载" bind:action="loadRules" /></view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-6"><app-empty-state title="没有成长管理权限" description="当前账号不能查看奖励规则。" /></view>
  <view wx:elif="{{rules.length === 0}}" class="mt-6"><app-empty-state title="奖励规则未初始化" description="请先完成默认运营配置。" /></view>
  <view wx:else class="mip-admin-card-list mt-5 flex flex-col gap-3"><view wx:for="{{rules}}" wx:key="id" class="min-h-[88rpx] rounded-[16rpx] bg-panel px-4 py-4" role="button" data-id="{{item.id}}" bind:tap="edit"><view class="flex items-start justify-between"><view><view class="text-[length:27rpx] font-semibold">{{item.name}}</view><view class="mt-1 text-[length:22rpx] text-muted">{{item.metricLabel}} {{item.deltaValue}}</view></view><t-tag variant="outline" theme="{{item.statusTheme}}">{{item.statusLabel}}</t-tag></view><view class="mt-2 text-[length:22rpx] text-muted">{{item.sourceLabel}} · 每日上限 {{item.dailyLimitValue === null ? '不限' : item.dailyLimitValue}}</view></view></view>
  <view wx:if="{{message && state === 'ready'}}" class="mt-4 rounded-[12rpx] bg-panel px-4 py-3 text-[length:23rpx] text-danger">{{message}}</view>
  <app-page-exit />
</view>
