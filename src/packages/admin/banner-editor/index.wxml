<view id="admin-banner-editor-page" class="min-h-screen bg-canvas px-6 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-7 text-ink">
  <view class="text-[length:40rpx] font-bold">{{bannerId ? 'Banner 详情' : '新增 Banner'}}</view>
  <view class="mt-2 text-[length:23rpx] text-muted">新增记录默认停用，可在列表确认启用</view>

  <view wx:if="{{state === 'loading'}}" class="mt-6 rounded-[16rpx] bg-panel px-5 py-6"><t-skeleton row-col="{{[1,1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error' || state === 'conflict'}}" class="mt-6"><app-empty-state title="暂时无法编辑 Banner" description="{{message}}" action-text="重新加载" bind:action="retryLoad" /></view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-6"><app-empty-state title="没有 Banner 管理权限" description="当前账号不能维护 Banner。" /></view>
  <view wx:else class="mt-5 flex flex-col gap-4">
    <view wx:if="{{bannerId}}" class="rounded-[16rpx] bg-panel px-4 py-4"><view class="flex items-center justify-between"><text class="text-[length:24rpx]">当前状态</text><text class="text-[length:23rpx] text-muted">{{status === 'ACTIVE' ? '已启用' : '已停用'}}</text></view></view>

    <view class="rounded-[16rpx] bg-panel px-4 py-4">
      <view class="text-[length:26rpx] font-semibold">Banner 图片</view>
      <view class="mt-2 text-[length:22rpx] text-muted">至少 750 × 300，宽高比 1.8–3.2，支持 PNG 或 JPEG</view>
      <image wx:if="{{imageUrl}}" class="mt-3 h-[240rpx] w-full rounded-[12rpx] bg-panel-raised" mode="aspectFill" src="{{imageUrl}}" aria-label="{{draft.accessibilityLabel || 'Banner 图片预览'}}" />
      <view wx:if="{{imageUrl}}" class="mt-2 text-[length:21rpx] text-muted">{{imageWidth}} × {{imageHeight}}</view>
      <view class="mt-3"><t-button block theme="default" loading="{{uploading}}" bind:tap="chooseImage">{{imageUrl ? '更换图片' : '选择并上传图片'}}</t-button></view>
    </view>

    <view class="rounded-[16rpx] bg-panel px-4 py-4"><view class="text-[length:24rpx] font-semibold">管理名称</view><view class="mt-3"><t-input value="{{draft.title}}" maxlength="100" placeholder="填写 Banner 名称" data-field="title" bind:change="updateField" /></view></view>
    <view class="rounded-[16rpx] bg-panel px-4 py-4"><view class="text-[length:24rpx] font-semibold">图片说明</view><view class="mt-2 text-[length:22rpx] text-muted">用于无障碍阅读和图片无法显示时的说明</view><view class="mt-3"><t-input value="{{draft.accessibilityLabel}}" maxlength="120" placeholder="说明图片内容" data-field="accessibilityLabel" bind:change="updateField" /></view></view>

    <view class="rounded-[16rpx] bg-panel px-4 py-4">
      <view class="text-[length:26rpx] font-semibold">跳转类型</view>
      <view class="mt-3 grid grid-cols-2 gap-2"><view class="flex min-h-[88rpx] items-center justify-center rounded-[12rpx] text-[length:23rpx] {{draft.targetType === 'MINIPROGRAM_PATH' ? 'bg-brand text-on-brand' : 'bg-panel-raised text-muted'}}" data-type="MINIPROGRAM_PATH" bind:tap="chooseTargetType">小程序页面</view><view class="flex min-h-[88rpx] items-center justify-center rounded-[12rpx] text-[length:23rpx] {{draft.targetType === 'ARTICLE_URL' ? 'bg-brand text-on-brand' : 'bg-panel-raised text-muted'}}" data-type="ARTICLE_URL" bind:tap="chooseTargetType">公众号文章</view></view>
      <view class="mt-4 text-[length:24rpx] font-semibold">跳转地址</view>
      <view class="mt-2 text-[length:22rpx] text-muted">{{draft.targetType === 'MINIPROGRAM_PATH' ? '填写允许的小程序绝对路径' : '填写 mp.weixin.qq.com 的 HTTPS 文章链接'}}</view>
      <view class="mt-3"><t-input value="{{draft.targetValue}}" maxlength="1024" placeholder="填写跳转地址" data-field="targetValue" bind:change="updateField" /></view>
    </view>

    <t-button block theme="primary" loading="{{saving}}" disabled="{{uploading}}" bind:tap="save">保存</t-button>
  </view>
  <view wx:if="{{message && state === 'ready'}}" class="mt-4 rounded-[12rpx] bg-panel px-4 py-3 text-[length:23rpx] text-danger">{{message}}</view>
  <app-page-exit />
</view>
