<view id="admin-growth-benefits-page" class="mip-admin-page min-h-screen bg-canvas px-6 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-7 text-ink">
  <view class="text-[length:40rpx] font-bold">权益管理</view><view class="mt-2 text-[length:23rpx] text-muted">维护权益名称、说明、顺序和状态。</view>
  <view wx:if="{{canConfigure}}" class="mt-5 rounded-[16rpx] bg-panel p-4"><view class="font-semibold">{{editorId ? '编辑权益' : '新增权益'}}</view><view class="mt-3"><t-input value="{{name}}" placeholder="权益名称" data-field="name" bind:change="updateField" /></view><view class="mt-2"><t-textarea value="{{description}}" placeholder="权益说明" data-field="description" bind:change="updateField" /></view><view class="mt-2"><t-input type="number" value="{{sortOrder}}" placeholder="显示顺序" data-field="sortOrder" bind:change="updateField" /></view><view class="mt-2 flex gap-1" role="radiogroup"><view class="flex min-h-[88rpx] items-center" role="radio" aria-checked="{{status === 'DRAFT'}}"><t-tag variant="outline" theme="{{status === 'DRAFT' ? 'primary' : 'default'}}" data-value="DRAFT" bind:tap="chooseStatus">草稿</t-tag></view><view class="flex min-h-[88rpx] items-center" role="radio" aria-checked="{{status === 'ACTIVE'}}"><t-tag variant="outline" theme="{{status === 'ACTIVE' ? 'primary' : 'default'}}" data-value="ACTIVE" bind:tap="chooseStatus">启用</t-tag></view><view class="flex min-h-[88rpx] items-center" role="radio" aria-checked="{{status === 'INACTIVE'}}"><t-tag variant="outline" theme="{{status === 'INACTIVE' ? 'primary' : 'default'}}" data-value="INACTIVE" bind:tap="chooseStatus">停用</t-tag></view></view><view class="mt-3 grid grid-cols-2 gap-2"><t-button block variant="outline" bind:tap="reset">清空</t-button><t-button block theme="primary" loading="{{saving}}" bind:tap="save">保存</t-button></view></view>
  <view wx:if="{{state === 'loading'}}" class="mt-6 rounded-[16rpx] bg-panel p-5"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view><app-empty-state wx:elif="{{state === 'forbidden'}}" class="mt-6" title="无运营权限" description="{{message}}" /><app-empty-state wx:elif="{{state === 'error'}}" class="mt-6" title="暂时无法加载权益" description="{{message}}" action-text="重新加载" bind:action="load" /><app-empty-state wx:elif="{{items.length === 0}}" class="mt-6" title="暂无权益" description="可以先新增权益，再关联到成长等级。" />
  <view wx:else class="mt-5 flex flex-col gap-3"><view wx:for="{{items}}" wx:key="id" class="min-h-[112rpx] rounded-[16rpx] bg-panel p-4" data-id="{{item.id}}" bind:tap="edit"><view class="flex justify-between gap-3"><view class="font-semibold">{{item.name}}</view><t-tag variant="outline" theme="{{item.statusTheme}}">{{item.statusText}}</t-tag></view><view class="mt-2 text-[length:22rpx] text-muted">{{item.description || '暂无说明'}}</view><view class="mt-2 text-[length:21rpx] text-muted">显示顺序：{{item.sortOrder}}</view></view></view>
  <view wx:if="{{message && state === 'ready'}}" class="mt-4 rounded-[12rpx] bg-panel px-4 py-3 text-danger">{{message}}</view><app-page-exit />
</view>
