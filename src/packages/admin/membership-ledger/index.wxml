<view id="admin-membership-ledger-page" class="mip-admin-page mip-admin-workspace-page min-h-screen bg-canvas px-6 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-7 text-ink">
  <mip-admin-workspace-nav />
  <view class="flex flex-wrap items-start justify-between gap-3"><view><view class="text-[length:40rpx] font-bold">会员权益台账</view><view class="mt-2 text-[length:23rpx] text-muted">按权益记录时间查看购买与人工开通事实</view></view></view>
  <view class="mip-admin-filter-grid mt-5 grid gap-3 rounded-[16rpx] bg-panel p-3">
    <view class="mip-admin-filter-wide"><t-input class="box-border max-w-full" value="{{userQuery}}" placeholder="搜索昵称或玩家编号" bind:change="updateUserQuery" bind:enter="search" /><view class="mt-3"><t-button block size="small" variant="outline" bind:tap="search">查询</t-button></view></view>
    <view class="mip-admin-filter-wide grid grid-cols-2 gap-2"><picker range="{{statusOptions}}" range-key="label" value="{{statusIndex}}" bindchange="changeStatus"><view class="rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:22rpx]"><view class="text-muted">权益状态</view><view class="mt-1">{{statusOptions[statusIndex].label}}</view></view></picker><picker range="{{sourceOptions}}" range-key="label" value="{{sourceIndex}}" bindchange="changeSource"><view class="rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:22rpx]"><view class="text-muted">权益来源</view><view class="mt-1">{{sourceOptions[sourceIndex].label}}</view></view></picker></view>
    <view class="mip-admin-filter-wide grid grid-cols-2 gap-2"><picker mode="date" value="{{createdFromDate}}" data-field="createdFromDate" bindchange="changeDate"><view class="rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:22rpx]"><view class="text-muted">记录日期起</view><view class="mt-1">{{createdFromDate || '不限'}}</view></view></picker><picker mode="date" value="{{createdToDate}}" data-field="createdToDate" bindchange="changeDate"><view class="rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:22rpx]"><view class="text-muted">记录日期止</view><view class="mt-1">{{createdToDate || '不限'}}</view></view></picker></view>
    <view wx:if="{{createdFromDate || createdToDate}}" class="flex min-h-[80rpx] items-center justify-end text-[length:21rpx] text-muted" bind:tap="clearDates">清除日期</view>
  </view>
  <view wx:if="{{state === 'loading'}}" class="mt-6 rounded-[16rpx] bg-panel p-5"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-6"><app-empty-state title="无权访问会员权益台账" description="{{message}}" /></view>
  <view wx:elif="{{state === 'error'}}" class="mt-6"><app-empty-state title="会员权益台账加载失败" description="{{message}}" action-text="重新加载" bind:action="retry" /></view>
  <view wx:elif="{{state === 'ready' && items.length === 0}}" class="mt-6"><app-empty-state title="暂无权益记录" description="符合筛选条件的会员权益记录会显示在这里。" /></view>
  <view wx:elif="{{state === 'ready' && items.length > 0}}" class="mip-admin-record-list mt-5" style="--mip-admin-record-columns: minmax(0, 1.2fr) minmax(0, 1fr) minmax(0, 1.5fr) minmax(0, 1.8fr);">
    <view class="mip-admin-record-header"><view>用户</view><view>来源与状态</view><view>有效期</view><view>订单或调整事实</view></view>
    <view wx:for="{{items}}" wx:key="id" class="mip-admin-record-row"><view class="mip-admin-record-cell"><view class="mip-admin-record-label">用户</view><view class="break-all text-[length:25rpx] font-semibold">{{item.user.nickname}}</view><view class="mt-1 text-[length:20rpx] text-muted">{{item.user.playerNumber ? '玩家编号 ' + item.user.playerNumber : '嘉宾'}}</view><view class="mt-1 text-[length:20rpx] text-muted">{{item.user.status === 'ACTIVE' ? '正常' : (item.user.status === 'BLOCKED' ? '已限制' : '已关闭')}}</view></view><view class="mip-admin-record-cell"><view class="mip-admin-record-label">来源与状态</view><view class="text-[length:23rpx] font-semibold">{{item.sourceText}}</view><view class="mt-2"><t-tag variant="outline" theme="{{item.status === 'ACTIVE' ? 'success' : (item.status === 'REFUNDED' || item.status === 'REVOKED' ? 'danger' : 'default')}}">{{item.statusText}}{{item.currentlyActive ? ' · 当前生效' : ''}}</t-tag></view><view class="mt-2 text-[length:20rpx] text-muted">记录：{{item.createdText}}</view></view><view class="mip-admin-record-cell"><view class="mip-admin-record-label">有效期</view><view class="text-[length:21rpx]">{{item.startsText}}</view><view class="mt-1 text-[length:21rpx] text-muted">至 {{item.endsText}}</view><view class="mt-2 text-[length:20rpx] text-muted">更新：{{item.updatedText}}</view></view><view class="mip-admin-record-cell"><view class="mip-admin-record-label">订单或调整事实</view><view wx:if="{{item.order}}" class="text-[length:21rpx]">订单 {{item.order.id}}</view><view wx:if="{{item.order}}" class="mt-1 text-[length:20rpx] text-muted">{{item.orderText}} · {{item.refundText}}</view><view wx:else class="text-[length:21rpx]">{{item.adjustmentText}}</view><view wx:if="{{item.adjustment}}" class="mt-1 text-[length:20rpx] text-muted">版本 {{item.adjustment.expectedChainVersion}} → {{item.adjustment.resultChainVersion}}</view></view></view>
  </view>
  <view wx:if="{{message && state === 'ready'}}" class="mt-4 rounded-[12rpx] bg-panel px-4 py-3 text-[length:23rpx] text-danger">{{message}}</view><view wx:if="{{nextCursor}}" class="mt-4"><t-button block variant="outline" loading="{{loadingMore}}" bind:tap="loadMore">加载更多</t-button></view><app-page-exit />
</view>
