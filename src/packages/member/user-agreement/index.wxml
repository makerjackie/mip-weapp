<view id="mip-user-agreement-page" class="mip-member-page min-h-screen bg-canvas px-3 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-3 text-ink">
  <view wx:if="{{state === 'loading'}}" class="rounded-[16rpx] bg-panel px-3 py-6 text-[24rpx] text-muted">正在加载协议…</view>
  <view wx:elif="{{state === 'error'}}" class="rounded-[16rpx] bg-panel px-3 py-6">
    <view class="text-[24rpx]">{{message}}</view>
    <view class="mt-3 flex min-h-[88rpx] items-center text-[24rpx] text-brand" aria-role="button" bind:tap="loadAgreement">重新加载</view>
  </view>
  <view wx:else class="rounded-[16rpx] bg-panel px-3 py-4">
    <view class="text-[32rpx] font-semibold leading-[44rpx]">{{agreement.title}}</view>
    <view wx:if="{{agreement.isDemo}}" class="mt-3 text-[24rpx] leading-[36rpx] text-brand">演示内容，仅供测试，不作为正式服务承诺。</view>
    <view wx:if="{{agreement.version}}" class="mt-2 text-[22rpx] leading-[32rpx] text-muted">版本 {{agreement.version}}</view>
    <text wx:if="{{agreement.body}}" selectable class="mt-4 block whitespace-pre-wrap text-[24rpx] leading-[36rpx]">{{agreement.body}}</text>
    <view wx:else class="mt-4 text-[24rpx] text-muted">协议暂未配置，请稍后查看。</view>
  </view>
  <app-page-exit managed bind:exit="leavePage" />
</view>
