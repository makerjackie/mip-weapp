<view id="member-access-page" class="min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-5 text-ink">
  <view wx:if="{{state === 'loading'}}" class="rounded-[28rpx] bg-panel px-5 py-8"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}"><app-empty-state title="暂时无法继续" description="服务暂时没有响应，请稍后重试。" action-text="重新加载" bind:action="loadState" /></view>
  <block wx:else>
    <view class="mx-auto mt-[90rpx] flex h-[112rpx] w-[112rpx] items-center justify-center rounded-full bg-brand-soft"><t-icon name="mobile" size="54rpx" color="var(--color-brand)" /></view>
    <view class="mt-5 text-center text-[length:38rpx] font-bold">{{phoneBound ? '手机号已绑定' : title}}</view>
    <view class="mx-auto mt-3 max-w-[620rpx] text-center text-[length:23rpx] leading-6 text-muted">{{phoneBound ? '现在可以继续使用报名、支付与售后服务' : description}}</view>
    <view wx:if="{{message}}" class="mt-4 rounded-[18rpx] bg-[#FFF0E8] px-4 py-3 text-[length:23rpx] text-[#9F4727]">{{message}}</view>
    <button id="access-primary-action" wx:if="{{!phoneBound}}" open-type="getPhoneNumber" disabled="{{bindingPhone}}" class="mt-8 flex h-[96rpx] w-full items-center justify-center gap-2 rounded-[18rpx] border-0 bg-brand text-[length:28rpx] font-semibold text-white active:bg-brand-active disabled:opacity-60" bind:getphonenumber="bindPhone">
      <text>{{bindingPhone ? '正在登录…' : '微信手机号快捷登录'}}</text>
    </button>
    <view id="access-primary-action" wx:else class="mx-auto mt-8 w-[320rpx]"><t-button block theme="primary" bind:tap="browseFirst">返回继续</t-button></view>
    <view wx:if="{{!phoneBound}}" class="mt-3"><t-button block variant="text" theme="primary" bind:tap="browseFirst">先逛一逛</t-button></view>
    <view wx:if="{{!phoneBound}}" class="mt-4 text-center text-[length:20rpx] text-muted">登录即表示同意 <text class="text-brand" bind:tap="openAgreement">《用户协议》</text> 与 <text class="text-brand" bind:tap="openPrivacy">《隐私政策》</text></view>
  </block>
</view>
