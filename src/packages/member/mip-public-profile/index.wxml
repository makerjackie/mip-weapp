<view id="mip-public-profile-page" class="mip-member-page min-h-screen bg-[#080808] px-3 pb-[calc(env(safe-area-inset-bottom)+176rpx)] text-ink">
  <view wx:if="{{state === 'loading'}}" class="pt-3">
    <view class="rounded-[16rpx] bg-panel px-3 py-6"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  </view>
  <view wx:elif="{{state === 'blocked'}}" class="pt-5">
    <app-empty-state title="已屏蔽该用户" description="可以在屏蔽列表中解除屏蔽。" action-text="查看屏蔽列表" bind:action="openBlockedList" />
    <app-page-exit />
  </view>
  <view wx:elif="{{state === 'error'}}" class="pt-5">
    <app-empty-state title="暂时无法查看档案" description="{{message}}" action-text="重新加载" bind:action="loadProfile" />
    <app-page-exit />
  </view>

  <block wx:elif="{{profile}}">
    <view class="-mx-3 bg-panel px-3 pb-5 pt-3">
      <view class="flex items-center gap-3">
        <image wx:if="{{profile.avatarUrl}}" class="h-[160rpx] w-[160rpx] shrink-0 rounded-full border-[4rpx] border-[#393939] bg-panel-raised" mode="aspectFill" src="{{profile.avatarUrl}}" />
        <view wx:else class="flex h-[160rpx] w-[160rpx] shrink-0 items-center justify-center rounded-full border-[4rpx] border-[#393939] bg-brand-soft"><t-icon name="user" size="64rpx" color="var(--color-brand)" /></view>
        <view class="min-w-0 flex-1">
          <view class="flex items-center gap-2"><view class="truncate text-[length:32rpx] font-medium">{{profile.displayName}}</view><text class="shrink-0 rounded-[8rpx] bg-brand px-2 py-1 text-[length:18rpx] font-medium text-on-brand">{{profile.kindLabel}}</text></view>
          <view wx:if="{{profile.branchText || profile.primaryIndustry || profile.identityStatus}}" class="mt-2 truncate text-[length:20rpx] text-ink"><text wx:if="{{profile.branchText}}">{{profile.branchText}}</text><text wx:if="{{profile.branchText && (profile.primaryIndustry || profile.identityStatus)}}">｜</text><text wx:if="{{profile.primaryIndustry}}">{{profile.primaryIndustry.label}}</text><text wx:if="{{profile.primaryIndustry && profile.identityStatus}}">｜</text><text wx:if="{{profile.identityStatus}}">{{profile.identityStatus}}</text></view>
          <view wx:if="{{profile.headline}}" class="mt-2 line-clamp-2 text-[length:20rpx] leading-5 text-muted">{{profile.headline}}</view>
        </view>
      </view>
      <view wx:if="{{profile.abilities.length}}" class="mt-4 flex flex-wrap gap-2"><text wx:for="{{profile.abilities}}" wx:key="id" class="rounded-[8rpx] bg-panel-raised px-2 py-1 text-[length:20rpx] text-muted">{{item.label}}</text></view>
      <view wx:if="{{profile.badges.length}}" class="mt-3 flex flex-wrap gap-2">
        <view wx:for="{{profile.badges}}" wx:key="id" class="flex h-[48rpx] items-center gap-1 rounded-[8rpx] border border-line px-2">
          <image wx:if="{{item.imageUrl}}" class="h-[28rpx] w-[28rpx] rounded-full" mode="aspectFill" src="{{item.imageUrl}}" />
          <t-icon wx:elif="{{item.iconName}}" name="{{item.iconName}}" size="26rpx" color="var(--color-brand)" />
          <view wx:else class="h-[20rpx] w-[20rpx] rounded-full bg-brand" />
          <text class="text-[length:18rpx] text-muted">{{item.name}}</text>
        </view>
      </view>
    </view>

    <view class="-mx-3 grid grid-cols-4 border-y border-line bg-[#080808]">
      <view class="flex min-h-[112rpx] flex-col items-center justify-center" aria-role="{{isSelf ? 'button' : 'text'}}" data-category="GUEST" bind:tap="openOwnInfluence"><text class="text-[length:28rpx] font-semibold">{{influence ? influence.guestCount : '—'}}</text><text class="mt-1 text-[length:19rpx] text-muted">嘉宾</text></view>
      <view class="flex min-h-[112rpx] flex-col items-center justify-center" aria-role="{{isSelf ? 'button' : 'text'}}" data-category="INTERACTION" bind:tap="openOwnInfluence"><text class="text-[length:28rpx] font-semibold">{{influence ? influence.interactionCount : '—'}}</text><text class="mt-1 text-[length:19rpx] text-muted">互动</text></view>
      <view class="flex min-h-[112rpx] flex-col items-center justify-center" aria-role="{{isSelf ? 'button' : 'text'}}" data-category="ACTIVE_INTEREST" bind:tap="openOwnInfluence"><text class="text-[length:28rpx] font-semibold">{{influence ? influence.interestCount : '—'}}</text><text class="mt-1 text-[length:19rpx] text-muted">感兴趣</text></view>
      <view class="flex min-h-[112rpx] flex-col items-center justify-center" aria-role="{{isSelf ? 'button' : 'text'}}" data-category="VISITOR" bind:tap="openOwnInfluence"><text class="text-[length:28rpx] font-semibold">{{influence ? influence.visitorCount : '—'}}</text><text class="mt-1 text-[length:19rpx] text-muted">访客</text></view>
    </view>

    <view class="-mx-3 flex h-[80rpx] border-b border-line bg-[#080808]">
      <view class="public-profile-tab-hit relative flex min-w-0 flex-1 items-center justify-center text-[length:28rpx] {{activeSection === 'cooperation' ? 'font-medium text-brand' : 'text-muted'}}" aria-role="tab" aria-selected="{{activeSection === 'cooperation'}}" data-section="cooperation" bind:tap="changeSection">合作卡<view wx:if="{{activeSection === 'cooperation'}}" class="absolute inset-x-0 bottom-0 h-[4rpx] bg-brand" /></view>
      <view class="public-profile-tab-hit relative flex min-w-0 flex-1 items-center justify-center text-[length:28rpx] {{activeSection === 'cases' ? 'font-medium text-brand' : 'text-muted'}}" aria-role="tab" aria-selected="{{activeSection === 'cases'}}" data-section="cases" bind:tap="changeSection">超级案例<view wx:if="{{activeSection === 'cases'}}" class="absolute inset-x-0 bottom-0 h-[4rpx] bg-brand" /></view>
      <view class="public-profile-tab-hit relative flex min-w-0 flex-1 items-center justify-center text-[length:28rpx] {{activeSection === 'opportunities' ? 'font-medium text-brand' : 'text-muted'}}" aria-role="tab" aria-selected="{{activeSection === 'opportunities'}}" data-section="opportunities" bind:tap="changeSection">相关机会<view wx:if="{{activeSection === 'opportunities'}}" class="absolute inset-x-0 bottom-0 h-[4rpx] bg-brand" /></view>
    </view>

    <view wx:if="{{activeSection === 'cooperation'}}" class="pt-3">
      <view wx:if="{{cooperationCards.length}}" class="flex flex-col gap-3">
        <view wx:for="{{cooperationCards}}" wx:key="id" class="overflow-hidden rounded-[32rpx] bg-panel active:bg-panel-raised" aria-role="button" data-id="{{item.id}}" bind:tap="openCooperationCard">
          <cooperation-role-card role-key="{{item.roleKey}}" positioning="{{item.positioning}}" target-summary="{{item.targetSummary}}" />
        </view>
      </view>
      <view wx:else class="py-12 text-center text-[length:22rpx] text-muted">暂无已发布合作卡。</view>
    </view>

    <view wx:elif="{{activeSection === 'cases'}}" class="pt-3">
      <view wx:if="{{superCases.length}}" class="relative pl-[100rpx]">
        <view class="absolute bottom-6 left-[36rpx] top-3 w-[2rpx] bg-brand" />
        <view wx:for="{{superCases}}" wx:key="id" class="relative pb-6" aria-role="button" data-id="{{item.id}}" bind:tap="openSuperCase">
          <view class="absolute left-[-76rpx] top-[12rpx] h-[24rpx] w-[24rpx] rounded-full border-[2rpx] border-white bg-brand" />
          <view wx:if="{{item.publishedText}}" class="mb-3 text-[length:22rpx] font-medium text-brand">{{item.publishedText}}</view>
          <view class="overflow-hidden rounded-[16rpx] bg-panel active:bg-panel-raised">
            <image wx:if="{{item.coverUrl}}" class="h-[220rpx] w-full bg-panel-raised" src="{{item.coverUrl}}" mode="aspectFill" />
            <view class="px-3 py-3"><view class="line-clamp-1 text-[length:26rpx] font-medium">{{item.projectName}}</view><view class="mt-2 line-clamp-2 text-[length:20rpx] leading-5 text-muted">{{item.summary}}</view><view wx:if="{{item.cityLabel || item.industryLabel}}" class="mt-3 truncate text-[length:18rpx] text-brand">{{item.cityLabel}} {{item.industryLabel}}</view></view>
          </view>
        </view>
      </view>
      <view wx:else class="py-12 text-center text-[length:22rpx] text-muted">暂无已发布超级案例。</view>
    </view>

    <view wx:elif="{{activeSection === 'opportunities'}}" class="pt-3">
      <view class="mb-3 flex items-center justify-between text-[length:22rpx]"><text>招募中的机会</text><text class="text-muted">{{opportunities.length}} 个</text></view>
      <view wx:if="{{opportunities.length}}" class="flex flex-col gap-3">
        <view wx:for="{{opportunities}}" wx:key="id" class="flex h-[352rpx] overflow-hidden rounded-[16rpx] bg-panel active:bg-panel-raised" aria-role="button" data-id="{{item.id}}" bind:tap="openOpportunity">
          <image wx:if="{{item.coverUrl}}" class="m-3 h-[320rpx] w-[240rpx] shrink-0 rounded-[12rpx] bg-panel-raised" src="{{item.coverUrl}}" mode="aspectFill" />
          <view wx:else class="m-3 flex h-[320rpx] w-[240rpx] shrink-0 items-center justify-center rounded-[12rpx] bg-brand-soft text-[length:36rpx] font-bold text-brand">MIP</view>
          <view class="min-w-0 flex-1 py-4 pr-3"><view class="line-clamp-2 text-[length:28rpx] font-medium leading-6">{{item.title}}</view><view class="mt-4 line-clamp-2 text-[length:20rpx] leading-5 text-muted">价值：{{item.valueSummary}}</view><view class="mt-3 line-clamp-2 text-[length:20rpx] leading-5 text-muted">寻找：{{item.targetSummary}}</view><view class="mt-4 flex items-center justify-between gap-2 text-[length:18rpx] text-muted"><text class="truncate">{{item.cityLabel || item.branchName || '全国'}}</text><text class="shrink-0 rounded-full bg-brand-soft px-2 py-1 text-brand">{{item.referralCount}} 人引荐</text></view></view>
        </view>
      </view>
      <view wx:else class="py-12 text-center text-[length:22rpx] text-muted">暂无招募中的机会。</view>
    </view>

    <view wx:if="{{profile.introduction || profile.companies.length || profile.organizations.length}}" class="mt-5 rounded-[16rpx] bg-panel px-4 py-4">
      <view wx:if="{{profile.introduction}}"><view class="text-[length:28rpx] font-medium">个人简介</view><view class="mt-2 whitespace-pre-wrap text-[length:22rpx] leading-6 text-muted">{{profile.introduction}}</view></view>
      <view wx:if="{{profile.companies.length || profile.organizations.length}}" class="{{profile.introduction ? 'mt-5 border-t border-line pt-4' : ''}}">
        <view class="text-[length:28rpx] font-medium">经历</view>
        <view wx:for="{{profile.companies}}" wx:key="name" class="mt-3"><view class="text-[length:22rpx]">{{item.name}}</view><view wx:if="{{item.role}}" class="mt-1 text-[length:20rpx] text-muted">{{item.role}}</view></view>
        <view wx:for="{{profile.organizations}}" wx:key="name" class="mt-3"><view class="text-[length:22rpx]">{{item.name}}</view><view wx:if="{{item.role}}" class="mt-1 text-[length:20rpx] text-muted">{{item.role}}</view></view>
      </view>
    </view>

    <view wx:if="{{!isSelf}}" class="mt-4 rounded-[16rpx] border border-line bg-panel px-4 py-4">
      <view class="text-[length:28rpx] font-medium">社区安全</view>
      <view class="mt-2 text-[length:20rpx] leading-5 text-muted">举报只提交给运营人员处理，屏蔽不会通知对方。</view>
      <view wx:if="{{safetyState === 'access'}}" class="mt-4 rounded-[12rpx] bg-panel-raised px-3 py-3"><view class="text-[length:22rpx]">需要完成身份信息后继续。</view><view class="mt-3"><t-button block theme="primary" bind:tap="openAccess">继续</t-button></view></view>
      <view wx:else class="mt-4 grid grid-cols-2 gap-3"><t-button block variant="outline" disabled="{{safetyState === 'loading' || safetyState === 'processing'}}" bind:tap="reportProfile">举报</t-button><t-button block variant="outline" theme="danger" loading="{{safetyState === 'processing'}}" disabled="{{safetyState === 'loading'}}" bind:tap="blockProfile">屏蔽</t-button></view>
      <view wx:if="{{safetyMessage && safetyState === 'error'}}" class="mt-3 text-[length:20rpx] text-danger">{{safetyMessage}}</view><view wx:elif="{{safetyMessage}}" class="mt-3 text-[length:20rpx] text-muted">{{safetyMessage}}</view>
      <view wx:if="{{canRetryReport}}" class="mt-3"><t-button block variant="outline" bind:tap="retryReport">重新提交举报</t-button></view>
    </view>

    <view wx:if="{{!isSelf}}" class="mip-member-fixed-inset fixed inset-x-3 bottom-[calc(env(safe-area-inset-bottom)+16rpx)] z-20 flex h-[112rpx] items-center gap-2 rounded-full border border-[#5c5320] bg-[rgba(255,221,2,0.1)] p-2">
      <view class="flex h-[80rpx] min-w-0 flex-1 items-center px-3"><view class="min-w-0"><view class="truncate text-[length:22rpx] font-medium">{{profile.displayName}}</view><view class="mt-1 text-[length:18rpx] text-muted">{{interestActive ? '已标记感兴趣' : '公开档案'}}</view></view></view>
      <view wx:if="{{interestState === 'access'}}" class="flex min-h-[88rpx] w-[336rpx] shrink-0 items-center justify-center rounded-full bg-brand px-3 text-center text-[length:24rpx] font-medium text-on-brand" aria-role="button" bind:tap="openAccess">完成身份信息后继续</view>
      <view wx:else class="flex min-h-[88rpx] w-[336rpx] shrink-0 items-center justify-center rounded-full bg-brand px-3 text-[length:28rpx] font-medium text-on-brand active:bg-brand-active {{interestState === 'loading' || interestState === 'processing' ? 'opacity-50' : ''}}" aria-role="button" aria-disabled="{{interestState === 'loading' || interestState === 'processing'}}" bind:tap="toggleInterest">{{interestState === 'processing' ? '处理中' : (interestActive ? '取消感兴趣' : '我感兴趣')}}</view>
    </view>
    <view wx:if="{{interestMessage}}" class="fixed inset-x-6 bottom-[calc(env(safe-area-inset-bottom)+132rpx)] z-20 rounded-[8rpx] bg-danger px-3 py-2 text-center text-[length:20rpx] text-white">{{interestMessage}}</view>
    <app-page-exit />
  </block>
</view>
