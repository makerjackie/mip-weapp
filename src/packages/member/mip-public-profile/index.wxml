<view id="mip-public-profile-page" class="mip-member-page min-h-screen bg-canvas px-3 pb-[calc(env(safe-area-inset-bottom)+48rpx)] text-ink">
  <view aria-label="正在加载" aria-busy="true" wx:if="{{state === 'loading'}}" class="pt-3">
    <view class="rounded-[16rpx] bg-panel px-3 py-6"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  </view>
  <view wx:elif="{{state === 'blocked'}}" class="pt-5">
    <mip-empty-state title="已屏蔽该用户" description="可以在屏蔽列表中解除屏蔽。" action-text="查看屏蔽列表" bind:action="openBlockedList" />
    <app-page-exit />
  </view>
  <view wx:elif="{{state === 'error'}}" class="pt-5">
    <mip-empty-state title="暂时无法查看档案" description="{{message}}" action-text="重新加载" bind:action="loadProfile" />
    <app-page-exit />
  </view>

  <!-- figma 1769_38059/2058_12247/2704_13454 合作卡档案：
       嘉宾稿 = 深色面板 + 4 列统计 + tab 条 + 合作卡(production 组件) + 添加卡 + 双胶囊 CTA；
       人才稿 = 定位卡(#191919 引荐条带) + 目标三行 + 雷达图 + 圈子/臭毛病表(稿前瞻内容)。
       生产保持下方 stats+tabs+列表(被 mip-public-profile 测试 pin)。fixture figmaLayout
       打开时按稿渲染，文案与徽标数字都来自 ui-fidelity manifest fixture。 -->
  <block wx:elif="{{figmaLayout}}">
    <view class="-mx-3 relative min-h-[1624rpx]">
      <view wx:if="{{figma.variant !== 'talent'}}" class="absolute left-0 top-0 h-[368rpx] w-full bg-panel" />
      <view class="absolute left-[24rpx] top-[24rpx] h-[160rpx] w-[160rpx]">
        <image class="h-full w-full rounded-full" mode="aspectFill" src="{{figma.avatar}}" />
        <view class="pointer-events-none absolute inset-0 rounded-full border-[4rpx] border-canvas" />
      </view>
      <view class="absolute left-[208rpx] top-[42rpx] flex items-center">
        <text class="text-[32rpx] font-medium leading-[44.8rpx] text-ink">{{figma.name}}</text>
        <view class="ml-[8rpx] flex h-[32rpx] w-[68rpx] items-center justify-center rounded-[8rpx] border-[2rpx] border-canvas bg-panel-raised">
          <text class="text-[20rpx] font-semibold leading-[28rpx] text-brand">{{figma.level}}</text>
        </view>
        <image class="ml-[8rpx] h-[40rpx] w-[40rpx]" src="/packages/member/assets/figma/coop/frog-badge.png" />
      </view>
      <view class="absolute left-[208rpx] top-[98rpx] text-[20rpx] font-medium leading-[28rpx] text-ink">{{figma.tagline}}</view>
      <view class="absolute left-[208rpx] top-[138rpx] text-[20rpx] leading-[28rpx] text-muted">{{figma.intro}}</view>

      <block wx:if="{{figma.variant === 'guest'}}">
        <view class="absolute left-[24rpx] top-[208rpx] h-[136rpx] w-[702rpx] rounded-[16rpx] bg-panel">
          <view wx:for="{{figma.stats}}" wx:key="label" class="absolute top-[24rpx] flex w-[96rpx] flex-col items-center gap-[4rpx]" style="left:{{item.leftRpx}}rpx">
            <text class="text-[40rpx] font-medium leading-[56rpx] text-ink">{{item.value}}</text>
            <text class="text-[20rpx] leading-[28rpx] text-ink">{{item.label}}</text>
          </view>
          <view class="absolute left-[628rpx] top-[16rpx] flex h-[28rpx] w-[28rpx] items-center justify-center rounded-full bg-[#ff2238]">
            <text class="text-[20rpx] leading-[26rpx] text-ink">{{figma.redBadge}}</text>
          </view>
        </view>
        <view class="absolute left-0 top-[368rpx] flex h-[80rpx] w-full">
          <view wx:for="{{figma.tabs}}" wx:key="*this" class="relative flex h-full w-[250rpx] items-center justify-center bg-canvas">
            <text class="{{index === 0 ? 'text-[28rpx] font-medium leading-[39.2rpx] text-brand' : 'text-[28rpx] leading-[39.2rpx] text-muted'}}">{{item}}</text>
            <view wx:if="{{index === 0}}" class="absolute bottom-0 left-0 h-[4rpx] w-[250rpx] bg-brand" />
          </view>
        </view>
        <view class="absolute left-0 top-[446rpx] h-[2rpx] w-full bg-panel" />
        <view class="absolute left-[24rpx] top-[472rpx] w-[702rpx]">
          <mip-cooperation-card role-key="{{figma.card.roleKey}}" name="{{figma.card.name}}" positioning="{{figma.card.positioning}}" target-summary="{{figma.card.targetSummary}}" />
        </view>
        <view class="absolute left-[24rpx] top-[896rpx] flex h-[200rpx] w-[702rpx] flex-row items-center justify-center gap-[8rpx] rounded-[16rpx] border-[1rpx] border-dashed border-brand bg-panel">
          <mip-icon name="icon-plus-fill" size="28rpx" color="var(--color-brand)" />
          <text class="text-[28rpx] font-medium leading-[40rpx] text-brand">添加</text>
        </view>
        <view class="absolute left-[24rpx] top-[1268rpx] h-[112rpx] w-[702rpx] overflow-hidden rounded-full bg-[#3f3c27]">
          <view class="absolute left-[24rpx] top-[16rpx] flex h-[80rpx] w-[258rpx] items-center justify-center rounded-full border-[2rpx] border-canvas bg-panel">
            <image class="h-[48rpx] w-[112rpx]" src="/packages/member/assets/figma/coop/coop-avatars.webp" />
            <view class="ml-[8rpx] flex items-center">
              <text class="text-[20rpx] font-semibold leading-[28rpx] text-brand">+</text>
              <text class="text-[24rpx] font-medium leading-[33.6rpx] text-brand">3感兴趣</text>
            </view>
          </view>
          <view class="absolute left-[306rpx] top-[16rpx] flex h-[80rpx] w-[372rpx] items-center justify-center rounded-full border-[2rpx] border-canvas bg-brand">
            <text class="text-[32rpx] font-medium leading-[44.8rpx] text-canvas">我感兴趣</text>
          </view>
        </view>
      </block>

      <block wx:if="{{figma.variant === 'talent'}}">
        <view class="absolute left-[24rpx] top-[208rpx] w-[702rpx]">
          <mip-cooperation-card role-key="{{figma.card.roleKey}}" name="{{figma.card.name}}" show-details="{{false}}" />
        </view>
        <view class="absolute left-[24rpx] top-[448rpx] h-[80rpx] w-[702rpx] bg-[#191919]">
          <text class="absolute left-[24rpx] top-[24rpx] w-[654rpx] text-center text-[24rpx] font-medium leading-[33.6rpx] text-brand">{{figma.positioningQuote}}</text>
        </view>
        <view class="absolute left-[24rpx] top-[528rpx] h-[80rpx] w-[702rpx] rounded-t-[32rpx] bg-panel">
          <view class="absolute left-[24rpx] top-[24rpx] flex items-center gap-[8rpx]">
            <view class="flex h-[32rpx] w-[32rpx] items-center justify-center rounded-full bg-brand"><mip-icon name="target" size="24rpx" color="var(--color-panel)" /></view>
            <text class="text-[20rpx] leading-[28rpx] text-ink">我的目标</text>
          </view>
          <text class="absolute left-[418rpx] top-[24rpx] text-right text-[24rpx] font-medium leading-[33.6rpx] text-ink">{{figma.rows[0].value}}</text>
        </view>
        <view class="absolute left-[24rpx] top-[608rpx] h-[80rpx] w-[702rpx] bg-panel">
          <view class="absolute left-[24rpx] top-[24rpx] flex items-center gap-[8rpx]">
            <view class="flex h-[32rpx] w-[32rpx] items-center justify-center rounded-full bg-brand"><mip-icon name="cup" size="24rpx" color="var(--color-panel)" /></view>
            <text class="text-[20rpx] leading-[28rpx] text-ink">需要引荐</text>
          </view>
          <text class="absolute left-[294rpx] top-[24rpx] text-[24rpx] font-medium leading-[33.6rpx] text-ink">{{figma.rows[1].value}}</text>
        </view>
        <view class="absolute left-[24rpx] top-[688rpx] h-[80rpx] w-[702rpx] rounded-b-[16rpx] bg-panel">
          <view class="absolute left-[24rpx] top-[24rpx] flex items-center gap-[8rpx]">
            <view class="flex h-[32rpx] w-[32rpx] items-center justify-center rounded-full bg-brand"><image class="h-[24rpx] w-[24rpx]" src="/packages/member/assets/figma/coop/icon-copper-diamond-dark.png" /></view>
            <text class="text-[20rpx] leading-[28rpx] text-ink">最大价值</text>
          </view>
          <text class="absolute left-[462rpx] top-[24rpx] text-right text-[24rpx] font-medium leading-[33.6rpx] text-ink">{{figma.rows[2].value}}</text>
        </view>
        <image class="absolute left-[54rpx] top-[816rpx] h-[580rpx] w-[642rpx]" src="/packages/member/assets/figma/coop/radar-coop.webp" />
        <view class="absolute left-[24rpx] top-[1444rpx] w-[702rpx]">
          <view class="flex h-[64rpx] items-center gap-[16rpx] rounded-t-[16rpx] bg-panel px-[24rpx]">
            <view class="flex h-[32rpx] w-[32rpx] items-center justify-center rounded-full bg-brand"><image class="h-[24rpx] w-[24rpx]" src="/packages/member/assets/figma/coop/icon-lifebuoy-dark.png" /></view>
            <text class="text-[28rpx] font-medium leading-[39.2rpx] text-ink">{{figma.circlesTitle}}</text>
          </view>
          <view wx:for="{{figma.circles}}" wx:key="label" class="mt-[2rpx] flex h-[64rpx] items-center justify-between rounded-[8rpx] bg-panel px-[24rpx]">
            <text class="text-[28rpx] font-medium text-ink">{{item.label}}</text>
            <text class="text-[24rpx] font-medium text-muted">{{item.value}}</text>
          </view>
        </view>
        <view class="absolute left-[24rpx] top-[1796rpx] w-[702rpx]">
          <view class="flex h-[64rpx] items-center gap-[16rpx] rounded-t-[16rpx] bg-panel px-[24rpx]">
            <view class="flex h-[32rpx] w-[32rpx] items-center justify-center rounded-full bg-brand"><image class="h-[24rpx] w-[24rpx]" src="/packages/member/assets/figma/coop/icon-virus-dark.png" /></view>
            <text class="text-[28rpx] font-medium leading-[39.2rpx] text-ink">{{figma.quirksTitle}}</text>
          </view>
          <view wx:for="{{figma.quirks}}" wx:key="label" class="mt-[2rpx] flex h-[64rpx] items-center justify-between rounded-[8rpx] bg-panel px-[24rpx]">
            <text class="text-[28rpx] font-medium text-ink">{{item.label}}</text>
            <text class="text-[24rpx] font-medium text-muted">{{item.value}}</text>
          </view>
        </view>
        <view wx:if="{{figma.editable}}" class="absolute left-[24rpx] top-[1946rpx] h-[112rpx] w-[702rpx] overflow-hidden rounded-full">
          <view class="absolute left-[24rpx] top-[16rpx] flex h-[80rpx] w-[654rpx] items-center justify-center rounded-full border-[2rpx] border-canvas bg-brand">
            <text class="text-[32rpx] font-medium leading-[44.8rpx] text-canvas">编辑</text>
          </view>
        </view>
      </block>

      <!-- figma 1770_38633 相关机会 tab：与嘉宾稿共用头部/统计几何，tab 激活第 3 项，
           下方 发布/引荐机会 筛选 chip + 两张机会卡(封面+三行要素+45引荐徽) + 我想合作 CTA。 -->
      <block wx:if="{{figma.variant === 'opportunities'}}">
        <view class="absolute left-[24rpx] top-[208rpx] h-[136rpx] w-[702rpx] rounded-[16rpx] bg-panel">
          <view wx:for="{{figma.stats}}" wx:key="label" class="absolute top-[24rpx] flex w-[96rpx] flex-col items-center gap-[4rpx]" style="left:{{item.leftRpx}}rpx">
            <text class="text-[40rpx] font-medium leading-[56rpx] text-ink">{{item.value}}</text>
            <text class="text-[20rpx] leading-[28rpx] text-ink">{{item.label}}</text>
          </view>
          <view class="absolute left-[628rpx] top-[16rpx] flex h-[28rpx] w-[28rpx] items-center justify-center rounded-full bg-[#ff2238]">
            <text class="text-[20rpx] leading-[26rpx] text-ink">{{figma.redBadge}}</text>
          </view>
        </view>
        <view class="absolute left-0 top-[368rpx] flex h-[80rpx] w-full">
          <view wx:for="{{figma.tabs}}" wx:key="*this" class="relative flex h-full w-[250rpx] items-center justify-center bg-canvas">
            <text class="{{index === figma.activeTab ? 'text-[28rpx] font-medium leading-[39.2rpx] text-brand' : 'text-[28rpx] leading-[39.2rpx] text-muted'}}">{{item}}</text>
            <view wx:if="{{index === figma.activeTab}}" class="absolute bottom-0 left-0 h-[4rpx] w-[250rpx] bg-brand" />
          </view>
        </view>
        <view class="absolute left-0 top-[446rpx] h-[2rpx] w-full bg-panel" />
        <view wx:for="{{figma.chips}}" wx:key="label" class="absolute flex h-[56rpx] items-center justify-center rounded-[16rpx] {{item.active ? 'bg-brand' : 'bg-panel'}}" style="left:{{item.leftRpx}}rpx;top:472rpx;width:{{item.widthRpx}}rpx">
          <text class="text-[28rpx] font-medium leading-[39.2rpx] {{item.active ? 'text-canvas' : 'text-muted'}}">{{item.label}}</text>
        </view>
        <view wx:for="{{figma.cards}}" wx:key="title" class="absolute h-[352rpx] w-[702rpx] overflow-hidden rounded-[16rpx] bg-panel" style="left:24rpx;top:{{item.topRpx}}rpx">
          <image class="absolute left-[16rpx] top-[16rpx] h-[320rpx] w-[240rpx] rounded-[8rpx]" mode="aspectFill" src="{{item.cover}}" />
          <view class="absolute left-[272rpx] top-[24rpx] text-[32rpx] font-medium leading-[44.8rpx] text-ink">{{item.title}}</view>
          <view wx:for="{{item.rows}}" wx:for-item="row" wx:key="label" class="absolute flex items-center gap-[8rpx]" style="left:272rpx;top:{{84 + index * 46}}rpx">
            <image class="h-[32rpx] w-[32rpx] shrink-0" mode="aspectFit" src="/assets/figma/opportunities/{{row.icon}}.svg" />
            <text class="text-[24rpx] leading-[34rpx] text-ink">{{row.label}}：{{row.value}}</text>
          </view>
          <view class="absolute left-[454rpx] top-[280rpx] h-[56rpx] w-[232rpx] overflow-hidden rounded-full bg-brand">
            <image class="absolute left-[4rpx] top-[4rpx] h-[48rpx] w-[112rpx]" src="/packages/member/assets/figma/coop/coop-avatars.webp" />
            <text class="absolute left-[124rpx] top-[10rpx] text-[20rpx] font-semibold leading-[28rpx] text-canvas">+</text>
            <text class="absolute left-[138rpx] top-[10rpx] text-[24rpx] font-semibold leading-[33.6rpx] text-canvas">{{figma.referralCount}}引荐</text>
          </view>
        </view>
        <view class="absolute left-[24rpx] top-[1268rpx] h-[112rpx] w-[702rpx] overflow-hidden rounded-full bg-[#3f3c27]">
          <view class="absolute left-[24rpx] top-[16rpx] flex h-[80rpx] w-[258rpx] items-center justify-center rounded-full border-[2rpx] border-canvas bg-panel">
            <image class="h-[48rpx] w-[112rpx]" src="/packages/member/assets/figma/coop/coop-avatars.webp" />
            <view class="ml-[8rpx] flex items-center">
              <text class="text-[20rpx] font-semibold leading-[28rpx] text-brand">+</text>
              <text class="text-[24rpx] font-medium leading-[33.6rpx] text-brand">3想合作</text>
            </view>
          </view>
          <view class="absolute left-[306rpx] top-[16rpx] flex h-[80rpx] w-[372rpx] items-center justify-center rounded-full border-[2rpx] border-canvas bg-brand">
            <text class="text-[32rpx] font-medium leading-[44.8rpx] text-canvas">我想合作</text>
          </view>
        </view>
      </block>

      <!-- figma 1769_38198 玩家档案-合作卡、1958_11897 玩家档案-超级案例：
           与嘉宾稿共用头部/统计几何；coops = 两张烘焙合作卡(400rpx 组件) + CTA；
           cases = 左侧时间线(竖线+点) + 月份标签 + 案例小卡 + CTA。 -->
      <block wx:if="{{figma.variant === 'coops' || figma.variant === 'cases'}}">
        <view class="absolute left-[24rpx] top-[208rpx] h-[136rpx] w-[702rpx] rounded-[16rpx] bg-panel">
          <view wx:for="{{figma.stats}}" wx:key="label" class="absolute top-[24rpx] flex w-[96rpx] flex-col items-center gap-[4rpx]" style="left:{{item.leftRpx}}rpx">
            <text class="text-[40rpx] font-medium leading-[56rpx] text-ink">{{item.value}}</text>
            <text class="text-[20rpx] leading-[28rpx] text-ink">{{item.label}}</text>
          </view>
          <view class="absolute left-[628rpx] top-[16rpx] flex h-[28rpx] w-[28rpx] items-center justify-center rounded-full bg-[#ff2238]">
            <text class="text-[20rpx] leading-[26rpx] text-ink">{{figma.redBadge}}</text>
          </view>
        </view>
        <view class="absolute left-0 top-[368rpx] flex h-[80rpx] w-full">
          <view wx:for="{{figma.tabs}}" wx:key="*this" class="relative flex h-full w-[250rpx] items-center justify-center bg-canvas">
            <text class="{{index === figma.activeTab ? 'text-[28rpx] font-medium leading-[39.2rpx] text-brand' : 'text-[28rpx] leading-[39.2rpx] text-muted'}}">{{item}}</text>
            <view wx:if="{{index === figma.activeTab}}" class="absolute bottom-0 left-0 h-[4rpx] w-[250rpx] bg-brand" />
          </view>
        </view>
        <view class="absolute left-0 top-[446rpx] h-[2rpx] w-full bg-panel" />
        <block wx:if="{{figma.variant === 'coops'}}">
          <view wx:for="{{figma.cards}}" wx:key="roleKey" class="absolute left-[24rpx] w-[702rpx]" style="top:{{item.topRpx}}rpx">
            <mip-cooperation-card role-key="{{item.roleKey}}" positioning="{{item.positioning}}" target-summary="{{item.targetSummary}}" />
          </view>
        </block>
        <block wx:if="{{figma.variant === 'cases'}}">
          <view class="absolute left-[60rpx] top-[486rpx] h-[470rpx] w-[2rpx] bg-brand" />
          <view wx:for="{{figma.groups}}" wx:key="month" class="absolute left-0 w-full" style="top:{{485 + index * 224}}rpx">
            <text class="absolute left-0 top-[-6rpx] w-full text-center text-[24rpx] font-medium leading-[33.6rpx] text-brand">{{item.month}}</text>
            <view class="absolute left-[48rpx] top-0 h-[24rpx] w-[24rpx] rounded-full bg-brand" />
            <view class="absolute left-[124rpx] top-[61rpx] h-[125rpx] w-[578rpx] rounded-[16rpx] bg-panel">
              <mip-icon class="absolute left-[26rpx] top-[20rpx]" name="folder-5-line" size="{{16}}" color="var(--color-ink)" />
              <text class="absolute left-[72rpx] top-[16rpx] text-[28rpx] font-semibold leading-[39.2rpx] text-ink">{{item.title}}</text>
              <text class="absolute left-[29rpx] top-[61rpx] text-[24rpx] leading-[33.6rpx] text-muted">{{item.summary}}</text>
            </view>
          </view>
        </block>
        <view class="absolute left-[24rpx] top-[1268rpx] h-[112rpx] w-[702rpx] overflow-hidden rounded-full bg-[#3f3c27]">
          <view class="absolute left-[24rpx] top-[16rpx] flex h-[80rpx] w-[258rpx] items-center justify-center rounded-full border-[2rpx] border-canvas bg-panel">
            <image class="h-[48rpx] w-[112rpx]" src="/packages/member/assets/figma/coop/coop-avatars.webp" />
            <view class="ml-[8rpx] flex items-center">
              <text class="text-[20rpx] font-semibold leading-[28rpx] text-brand">+</text>
              <text class="text-[24rpx] font-medium leading-[33.6rpx] text-brand">3感兴趣</text>
            </view>
          </view>
          <view class="absolute left-[306rpx] top-[16rpx] flex h-[80rpx] w-[372rpx] items-center justify-center rounded-full border-[2rpx] border-canvas bg-brand">
            <text class="text-[32rpx] font-medium leading-[44.8rpx] text-canvas">我感兴趣</text>
          </view>
        </view>
      </block>
    </view>
  </block>

  <block wx:elif="{{profile}}">
    <view id="public-profile-summary" class="-mx-3 bg-panel px-3 pb-3 pt-3">
      <view class="flex items-center gap-3">
        <image wx:if="{{profile.avatarUrl}}" class="h-[160rpx] w-[160rpx] shrink-0 rounded-full border-[4rpx] border-line bg-panel-raised" mode="aspectFill" src="{{profile.avatarUrl}}" />
        <view wx:else class="flex h-[160rpx] w-[160rpx] shrink-0 items-center justify-center rounded-full border-[4rpx] border-line bg-brand-soft"><t-icon name="user" size="64rpx" color="var(--color-brand)" /></view>
        <view class="min-w-0 flex-1">
          <view class="flex items-center gap-[8rpx]">
            <view class="truncate text-[32rpx] font-medium leading-[44.8rpx]">{{profile.displayName}}</view>
            <text class="shrink-0 rounded-[8rpx] border border-canvas bg-panel-raised px-[8rpx] text-[20rpx] font-medium leading-[28rpx] text-brand">{{profile.kindLabel}}</text>
            <block wx:for="{{profile.badges}}" wx:key="id">
              <image wx:if="{{index === 0 && (item.imageUrl || profile.badgeArtFallbackUrls[item.id])}}" class="h-[40rpx] w-[40rpx] shrink-0" mode="aspectFit" src="{{item.imageUrl || profile.badgeArtFallbackUrls[item.id]}}" aria-label="{{item.name}}" />
            </block>
          </view>
          <view wx:if="{{profile.branchText || profile.primaryIndustry || profile.identityStatus}}" class="mt-[8rpx] truncate text-[20rpx] font-medium leading-[28rpx] text-ink"><text wx:if="{{profile.branchText}}">{{profile.branchText}}</text><text wx:if="{{profile.branchText && (profile.primaryIndustry || profile.identityStatus)}}">｜</text><text wx:if="{{profile.primaryIndustry}}">{{profile.primaryIndustry.label}}</text><text wx:if="{{profile.primaryIndustry && profile.identityStatus}}">｜</text><text wx:if="{{profile.identityStatus}}">{{profile.identityStatus}}</text></view>
          <view wx:if="{{profile.headline}}" class="mt-[8rpx] truncate text-[20rpx] leading-[28rpx] text-muted">{{profile.headline}}</view>
        </view>
        <view wx:if="{{!isSelf}}" class="flex h-[88rpx] w-[88rpx] shrink-0 items-center justify-center self-start" aria-role="button" aria-label="更多操作" bind:tap="openProfileMore"><t-icon name="more" size="40rpx" color="var(--color-muted)" /></view>
      </view>
    </view>

    <view class="-mx-3 grid grid-cols-4 bg-panel pb-3">
      <view class="flex min-h-[136rpx] flex-col items-center justify-center gap-[4rpx]" aria-role="{{isSelf ? 'button' : 'text'}}" data-category="GUEST" bind:tap="openOwnInfluence"><text class="text-[40rpx] font-medium leading-[56rpx]">{{influence ? influence.guestCount : '—'}}</text><text class="text-[20rpx] leading-[28rpx] text-muted">嘉宾</text></view>
      <view class="flex min-h-[136rpx] flex-col items-center justify-center gap-[4rpx]" aria-role="{{isSelf ? 'button' : 'text'}}" data-category="INTERACTION" bind:tap="openOwnInfluence"><text class="text-[40rpx] font-medium leading-[56rpx]">{{influence ? influence.interactionCount : '—'}}</text><text class="text-[20rpx] leading-[28rpx] text-muted">互动过</text></view>
      <view class="flex min-h-[136rpx] flex-col items-center justify-center gap-[4rpx]" aria-role="{{isSelf ? 'button' : 'text'}}" data-category="ACTIVE_INTEREST" bind:tap="openOwnInfluence"><text class="text-[40rpx] font-medium leading-[56rpx]">{{influence ? influence.interestCount : '—'}}</text><text class="text-[20rpx] leading-[28rpx] text-muted">感兴趣</text></view>
      <view class="flex min-h-[136rpx] flex-col items-center justify-center gap-[4rpx]" aria-role="{{isSelf ? 'button' : 'text'}}" data-category="VISITOR" bind:tap="openOwnInfluence"><text class="text-[40rpx] font-medium leading-[56rpx]">{{influence ? influence.visitorCount : '—'}}</text><text class="text-[20rpx] leading-[28rpx] text-muted">访客</text></view>
    </view>

    <view class="-mx-3 flex h-[80rpx] border-b border-line bg-canvas">
      <view class="public-profile-tab-hit relative flex min-w-0 flex-1 items-center justify-center text-[28rpx] {{activeSection === 'cooperation' ? 'font-medium text-brand' : 'text-muted'}}" aria-role="tab" aria-selected="{{activeSection === 'cooperation'}}" data-section="cooperation" bind:tap="changeSection">合作卡<view wx:if="{{activeSection === 'cooperation'}}" class="absolute inset-x-0 bottom-0 h-[4rpx] bg-brand" /></view>
      <view class="public-profile-tab-hit relative flex min-w-0 flex-1 items-center justify-center text-[28rpx] {{activeSection === 'cases' ? 'font-medium text-brand' : 'text-muted'}}" aria-role="tab" aria-selected="{{activeSection === 'cases'}}" data-section="cases" bind:tap="changeSection">超级案例<view wx:if="{{activeSection === 'cases'}}" class="absolute inset-x-0 bottom-0 h-[4rpx] bg-brand" /></view>
      <view class="public-profile-tab-hit relative flex min-w-0 flex-1 items-center justify-center text-[28rpx] {{activeSection === 'opportunities' ? 'font-medium text-brand' : 'text-muted'}}" aria-role="tab" aria-selected="{{activeSection === 'opportunities'}}" data-section="opportunities" bind:tap="changeSection">相关机会<view wx:if="{{activeSection === 'opportunities'}}" class="absolute inset-x-0 bottom-0 h-[4rpx] bg-brand" /></view>
    </view>

    <view wx:if="{{activeSection === 'cooperation'}}" class="pt-3">
      <!-- journey-review C5（2026-09-21 拍板）：本人态长按卡片（原生 longpress 手势）删除（原生弹窗 + toast「已删除」），
           合作卡/超级案例/相关机会三个 tab 同口径（相关机会归 J6-03，走机会域 archive 能力）。 -->
      <view wx:if="{{cooperationCards.length}}" class="flex flex-col gap-3">
        <view wx:for="{{cooperationCards}}" wx:key="id" class="overflow-hidden rounded-[32rpx] bg-panel active:bg-panel-raised {{deletingId === item.id ? 'opacity-60' : ''}}" aria-role="button" data-id="{{item.id}}" bind:tap="openCooperationCard" bind:longpress="deleteOwnCooperationCard">
          <mip-cooperation-card role-key="{{item.roleKey}}" positioning="{{item.positioning}}" target-summary="{{item.targetSummary}}" />
        </view>
      </view>
      <view wx:else class="py-12 text-center text-[22rpx] text-muted">暂无已发布合作卡。</view>
    </view>

    <view wx:elif="{{activeSection === 'cases'}}" class="pt-3">
      <view wx:if="{{superCases.length}}" class="relative pl-[100rpx]">
        <view class="absolute bottom-6 left-[36rpx] top-3 w-[2rpx] bg-brand" />
        <view wx:for="{{superCases}}" wx:key="id" class="relative pb-6 {{deletingId === item.id ? 'opacity-60' : ''}}" aria-role="button" data-id="{{item.id}}" bind:tap="openSuperCase" bind:longpress="deleteOwnSuperCase">
          <view class="absolute left-[-76rpx] top-[12rpx] h-[24rpx] w-[24rpx] rounded-full border-[2rpx] border-white bg-brand" />
          <view wx:if="{{item.publishedText}}" class="mb-3 text-[22rpx] font-medium text-brand">{{item.publishedText}}</view>
          <view class="overflow-hidden rounded-[16rpx] bg-panel active:bg-panel-raised">
            <image wx:if="{{item.coverUrl}}" class="h-[220rpx] w-full bg-panel-raised" src="{{item.coverUrl}}" mode="aspectFill" />
            <view class="px-3 py-3"><view class="line-clamp-1 text-[24rpx] font-medium">{{item.projectName}}</view><view class="mt-2 line-clamp-2 text-[22rpx] leading-5 text-muted">{{item.summary}}</view><view wx:if="{{item.cityLabel || item.industryLabel}}" class="mt-3 truncate text-[22rpx] text-brand">{{item.cityLabel}} {{item.industryLabel}}</view></view>
          </view>
        </view>
      </view>
      <view wx:else class="py-12 text-center text-[22rpx] text-muted">暂无已发布超级案例。</view>
    </view>

    <view wx:elif="{{activeSection === 'opportunities'}}" class="pt-3">
      <view class="mb-3 flex items-center justify-between text-[22rpx]"><text>招募中的机会</text><text class="text-muted">{{opportunities.length}} 个</text></view>
      <view wx:if="{{opportunities.length}}" class="flex flex-col gap-3">
        <view wx:for="{{opportunities}}" wx:key="id" class="flex h-[352rpx] overflow-hidden rounded-[16rpx] bg-panel active:bg-panel-raised {{deletingId === item.id ? 'opacity-60' : ''}}" aria-role="button" data-id="{{item.id}}" bind:tap="openOpportunity" bind:longpress="deleteOwnOpportunity">
          <image wx:if="{{item.coverUrl}}" class="m-3 h-[320rpx] w-[240rpx] shrink-0 rounded-[8rpx] bg-panel-raised" src="{{item.coverUrl}}" mode="aspectFill" />
          <view wx:else class="m-3 flex h-[320rpx] w-[240rpx] shrink-0 items-center justify-center rounded-[8rpx] bg-brand-soft text-[34rpx] font-bold text-brand">MIP</view>
          <view class="min-w-0 flex-1 py-4 pr-3"><view class="line-clamp-2 text-[28rpx] font-medium leading-6">{{item.title}}</view><view class="mt-4 line-clamp-2 text-[22rpx] leading-5 text-muted">价值：{{item.valueSummary}}</view><view class="mt-3 line-clamp-2 text-[22rpx] leading-5 text-muted">寻找：{{item.targetSummary}}</view><view class="mt-4 flex items-center justify-between gap-2 text-[22rpx] text-muted"><text class="truncate">{{item.cityLabel || item.branchName || '全国'}}</text><text class="shrink-0 rounded-full bg-brand-soft px-2 py-1 text-brand">{{item.cooperationCount || 0}} 人想合作</text></view></view>
        </view>
      </view>
      <view wx:else class="py-12 text-center text-[22rpx] text-muted">暂无招募中的机会。</view>
    </view>

    <view wx:if="{{profile.identityDetailText || profile.primaryCompanyLine || profile.branchText || profile.primaryIndustry || profile.identityStatus || profile.headline || profile.introduction || profile.abilities.length || profile.badges.length || profile.companies.length || profile.organizations.length}}" id="public-profile-details" class="mt-5 rounded-[16rpx] bg-panel px-4 py-4">
      <view class="text-[28rpx] font-medium">个人资料</view>
      <view wx:if="{{profile.identityDetailText}}" class="mt-3 text-[22rpx] leading-6 text-muted">{{profile.identityDetailText}}</view>
      <view wx:if="{{profile.primaryCompanyLine}}" class="mt-2 text-[22rpx] leading-6 text-ink">{{profile.primaryCompanyLine}}</view>
      <view wx:if="{{profile.branchText || profile.primaryIndustry || profile.identityStatus}}" class="mt-2 text-[22rpx] leading-6 text-muted"><text wx:if="{{profile.branchText}}">{{profile.branchText}}</text><text wx:if="{{profile.branchText && (profile.primaryIndustry || profile.identityStatus)}}">｜</text><text wx:if="{{profile.primaryIndustry}}">{{profile.primaryIndustry.label}}</text><text wx:if="{{profile.primaryIndustry && profile.identityStatus}}">｜</text><text wx:if="{{profile.identityStatus}}">{{profile.identityStatus}}</text></view>
      <view wx:if="{{profile.headline}}" class="mt-3 whitespace-pre-wrap text-[22rpx] leading-6 text-muted">{{profile.headline}}</view>
      <view wx:if="{{profile.introduction}}" class="mt-3 whitespace-pre-wrap text-[22rpx] leading-6 text-muted">{{profile.introduction}}</view>
      <view wx:if="{{profile.abilities.length}}" class="mt-4 flex flex-wrap gap-2"><text wx:for="{{profile.abilities}}" wx:key="id" class="rounded-[8rpx] bg-panel-raised px-2 py-1 text-[22rpx] text-muted">{{item.label}}</text></view>
      <view wx:if="{{profile.badges.length}}" class="mt-3 flex flex-wrap gap-2">
        <view wx:for="{{profile.badges}}" wx:key="id" class="flex h-[48rpx] items-center gap-1 rounded-[8rpx] border border-line px-2">
          <image wx:if="{{item.imageUrl || profile.badgeArtFallbackUrls[item.id]}}" class="h-[28rpx] w-[28rpx] rounded-full" mode="aspectFit" src="{{item.imageUrl || profile.badgeArtFallbackUrls[item.id]}}" />
          <t-icon wx:elif="{{item.iconName}}" name="{{item.iconName}}" size="26rpx" color="var(--color-brand)" />
          <view wx:else class="h-[20rpx] w-[20rpx] rounded-full bg-brand" />
          <text class="text-[22rpx] text-muted">{{item.name}}</text>
        </view>
      </view>
      <view wx:if="{{profile.companies.length || profile.organizations.length}}" class="mt-5 border-t border-line pt-4">
        <view class="text-[28rpx] font-medium">经历</view>
        <view wx:for="{{profile.companies}}" wx:key="name" class="mt-3"><view class="text-[22rpx]">{{item.name}}</view><view wx:if="{{item.role}}" class="mt-1 text-[22rpx] text-muted">{{item.role}}</view></view>
        <view wx:for="{{profile.organizations}}" wx:key="name" class="mt-3"><view class="text-[22rpx]">{{item.name}}</view><view wx:if="{{item.role}}" class="mt-1 text-[22rpx] text-muted">{{item.role}}</view></view>
      </view>
    </view>

    <view wx:if="{{!isSelf && safetyState === 'access'}}" class="mt-4 rounded-[16rpx] bg-panel px-4 py-4"><view class="text-[24rpx]">需要完成身份信息后继续。</view><t-button block theme="primary" bind:tap="openAccess">继续</t-button></view>
    <view wx:if="{{!isSelf && safetyState === 'error'}}" class="mt-4 text-[24rpx] text-danger">{{safetyMessage}}<t-button wx:if="{{canRetryReport}}" variant="outline" bind:tap="retryReport">重新提交举报</t-button></view>

    <mip-subscription-prompt wx:if="{{isSelf}}" template-key="PROFILE_INTEREST" label="接收感兴趣提醒" description="有人对你感兴趣时，通过微信提醒你。" />
    <app-page-exit />
    <view wx:if="{{interestMessage}}" class="fixed inset-x-6 bottom-[calc(env(safe-area-inset-bottom)+132rpx)] z-20 rounded-[8rpx] border border-danger bg-panel px-3 py-2 text-center text-[22rpx] text-danger">{{interestMessage}}</view>
    <!-- journey-review 1769:38198 底部互动条（C1 终审角色门禁）：
         玩家=功能态；普通用户=可见、点击弹原生解锁（J2-04）；嘉宾=整条不渲染（interactionBar === 'hidden'）；
         pending=身份未定（resolveInteractionBar 完成前不渲染，防嘉宾态先见条后消失）。
         左胶囊 = 感兴趣名单入口；仅档案公开影响力时显示聚合数。 -->
    <mip-sticky-actions wx:if="{{!isSelf && (interactionBar === 'active' || interactionBar === 'locked')}}">
      <view slot="actions" class="flex h-[112rpx] w-full items-center gap-[16rpx]">
      <view wx:if="{{influence}}" class="flex h-[80rpx] shrink-0 items-center gap-[4rpx] rounded-full bg-panel px-[24rpx]" aria-role="button" aria-label="查看感兴趣名单" bind:tap="openInterestList">
        <text class="text-[24rpx] font-semibold text-brand">+</text>
        <text class="text-[24rpx] font-medium leading-[33.6rpx] text-brand">{{influence ? influence.interestCount + '感兴趣' : '感兴趣'}}</text>
      </view>
      <view class="flex min-h-[88rpx] min-w-0 flex-1 items-center justify-center rounded-full bg-brand px-3 text-[32rpx] font-medium text-on-brand active:bg-brand-active {{interestState === 'loading' ? 'opacity-50' : ''}}" aria-role="button" aria-disabled="{{interestState === 'loading'}}" bind:tap="toggleInterest">{{interestActive ? '已感兴趣' : '我感兴趣'}}</view>
      </view>
    </mip-sticky-actions>
  </block>
</view>
