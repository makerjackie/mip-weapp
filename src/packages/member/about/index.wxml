<view id="member-about-page" class="mip-member-page min-h-screen bg-canvas px-5 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-12 text-center text-ink">
  <view class="mx-auto flex h-[132rpx] w-[132rpx] items-center justify-center rounded-[36rpx] bg-brand text-[length:52rpx] font-bold text-on-brand">{{markText}}</view>
  <view class="mt-6 text-[length:40rpx] font-bold">{{productName}}</view>
  <view class="mt-2 text-[length:22rpx] text-muted" bind:tap="copyVersion">{{versionText}}</view>
  <view class="mt-8 rounded-[28rpx] bg-panel px-5 py-6 text-left"><view class="text-[length:29rpx] font-semibold">产品说明</view><view class="mt-3 text-[length:23rpx] leading-7 text-muted">{{productName}} 是会员、城市分会、活动、机会与合作档案小程序。</view></view>
  <view class="mt-5 rounded-[24rpx] bg-brand-soft px-5 py-5 text-left text-[length:22rpx] leading-6 text-brand">会员身份、订单、支付、报名和退款状态均以服务端记录为准。</view>
  <app-page-exit />
</view>
