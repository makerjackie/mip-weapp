<view id="mip-member-card-page" class="mip-member-page min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+180rpx)] pt-5 text-ink">
  <view wx:if="{{state === 'loading'}}" class="rounded-[16rpx] bg-panel px-5 py-6"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}"><app-empty-state title="暂时无法加载名片" description="{{message}}" action-text="重新加载" bind:action="retryLoad" /></view>
  <block wx:else>
    <view class="flex items-center justify-between">
      <view><view class="text-[length:34rpx] font-semibold">我的名片</view><view class="mt-1 text-[length:22rpx] text-muted">展示已允许用于名片的资料。</view></view>
      <view class="min-h-[64rpx] px-2 py-2 text-[length:23rpx] text-brand" bind:tap="openProfileEdit">编辑名片</view>
    </view>

    <view class="relative mt-4 h-[492rpx] w-full overflow-hidden rounded-[18rpx]" style="background: {{theme.background}}; color: {{theme.foreground}};">
      <image wx:if="{{theme.asset}}" class="absolute inset-0 h-full w-full" mode="aspectFill" src="{{theme.asset}}" />
      <view class="absolute inset-0 px-5 py-5">
        <view class="max-w-[420rpx] truncate text-[length:42rpx] font-bold">{{nickname}}</view>
        <view wx:if="{{companyName || roleTitle}}" class="mt-2 max-w-[420rpx] truncate text-[length:22rpx] font-semibold">{{companyName}}{{companyName && roleTitle ? ' · ' : ''}}{{roleTitle}}</view>
        <view wx:if="{{organizationLine}}" class="mt-1 max-w-[420rpx] truncate text-[length:21rpx]" style="color: {{theme.muted}};">{{organizationLine}}</view>
        <view class="absolute bottom-5 left-5 flex max-w-[480rpx] flex-col gap-1 text-[length:19rpx] leading-[1.45]" style="color: {{theme.muted}};">
          <view wx:if="{{phone}}" class="truncate">电话　{{phone}}</view>
          <view wx:if="{{wechat}}" class="truncate">微信　{{wechat}}</view>
          <view wx:if="{{email}}" class="truncate">邮箱　{{email}}</view>
          <view wx:if="{{address}}" class="truncate">地址　{{address}}</view>
          <view wx:if="{{!phone && !wechat && !email && !address}}" class="truncate">{{memberType}}{{identityStatus ? ' · ' + identityStatus : ''}}{{branchName ? ' · ' + branchName : ''}}</view>
        </view>
      </view>
      <image wx:if="{{cardAvatarUrl}}" class="absolute right-5 top-5 h-[192rpx] w-[192rpx] rounded-full" mode="aspectFill" src="{{cardAvatarUrl}}" />
      <view wx:else class="absolute right-5 top-5 flex h-[192rpx] w-[192rpx] items-center justify-center rounded-full bg-white text-[length:52rpx] font-bold text-black">{{initial}}</view>
      <view class="absolute bottom-5 right-5 flex h-[104rpx] w-[104rpx] items-center justify-center rounded-[12rpx] bg-white p-2">
        <image wx:if="{{codeUrl}}" class="h-full w-full" mode="aspectFit" src="{{codeUrl}}" />
        <text wx:else class="text-[length:22rpx] text-muted">—</text>
      </view>
    </view>

    <view wx:if="{{codeMessage}}" class="mt-3 flex items-center justify-between rounded-[12rpx] bg-panel px-4 py-3 text-[length:22rpx] text-muted"><text>{{codeMessage}}</text><text class="ml-3 shrink-0 text-brand" bind:tap="retryCode">重试</text></view>

    <view class="mt-5 text-[length:25rpx] font-semibold">名片样式</view>
    <view class="mt-3 grid grid-cols-4 gap-2">
      <view wx:for="{{themeOptions}}" wx:key="key" class="overflow-hidden rounded-[12rpx] border-2 {{styleKey === item.key ? 'border-brand' : 'border-transparent'}}" data-key="{{item.key}}" bind:tap="chooseStyle">
        <view class="relative h-[96rpx]" style="background: {{item.background}};"><image wx:if="{{item.asset}}" class="absolute inset-0 h-full w-full" mode="aspectFill" src="{{item.asset}}" /></view>
        <view class="bg-panel py-2 text-center text-[length:22rpx] text-muted">{{item.label}}</view>
      </view>
    </view>

    <view class="mt-5 rounded-[16rpx] bg-panel px-4 py-4">
      <view class="flex items-center justify-between gap-3"><view><view class="text-[length:25rpx] font-semibold">名片头像</view><view class="mt-1 text-[length:22rpx] text-muted">可使用当前头像或数字分身。</view></view><view class="shrink-0 text-[length:22rpx] text-brand" bind:tap="openDigitalAvatar">管理分身</view></view>
      <view class="mt-3 grid grid-cols-2 gap-2">
        <view class="rounded-[12rpx] px-3 py-3 text-center text-[length:22rpx] {{avatarSource === 'ORIGINAL' ? 'bg-brand text-on-brand' : 'bg-panel-raised text-muted'}}" data-source="ORIGINAL" bind:tap="chooseAvatarSource">当前头像</view>
        <view class="rounded-[12rpx] px-3 py-3 text-center text-[length:22rpx] {{avatarSource === 'DIGITAL' ? 'bg-brand text-on-brand' : 'bg-panel-raised text-muted'}}" data-source="DIGITAL" bind:tap="chooseAvatarSource">{{digitalAvatarUrl ? '数字分身' : '暂未生成'}}</view>
      </view>
    </view>

    <image wx:if="{{posterPath}}" class="mt-4 h-[300rpx] w-full rounded-[16rpx] bg-panel" mode="aspectFit" src="{{posterPath}}" bind:tap="previewPoster" />
    <view wx:if="{{message}}" class="mt-4 rounded-[12rpx] bg-panel px-4 py-3 text-[length:22rpx] text-danger">{{message}}</view>

    <mip-sticky-actions>
      <view slot="actions" class="grid w-full grid-cols-2 gap-3">
        <t-button block open-type="share" variant="outline">分享名片</t-button>
        <t-button block theme="primary" loading="{{generating}}" bind:tap="savePoster">下载名片</t-button>
      </view>
    </mip-sticky-actions>
  </block>
  <canvas id="mip-member-card-canvas" type="2d" class="fixed left-[-9999px] top-0 h-[492px] w-[702px]"></canvas>
  <app-page-exit />
</view>
