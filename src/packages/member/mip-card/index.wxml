<view id="mip-member-card-page" class="min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-5 text-ink">
  <view class="text-[length:40rpx] font-bold">我的名片</view>
  <view class="mt-2 text-[length:23rpx] text-muted">名片只展示公开档案中的信息。</view>

  <view wx:if="{{state === 'loading'}}" class="mt-5 rounded-[16rpx] bg-panel px-5 py-6"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}" class="mt-5"><app-empty-state title="暂时无法加载名片" description="{{message}}" action-text="重新加载" bind:action="retryLoad" /></view>
  <block wx:else>
    <view class="mt-5 flex gap-2">
      <view class="flex-1 rounded-full px-3 py-2 text-center text-[length:22rpx] {{styleKey === 'BLACK' ? 'bg-brand text-on-brand' : 'bg-panel text-muted'}}" data-key="BLACK" bind:tap="chooseStyle">黑色</view>
      <view class="flex-1 rounded-full px-3 py-2 text-center text-[length:22rpx] {{styleKey === 'YELLOW' ? 'bg-brand text-on-brand' : 'bg-panel text-muted'}}" data-key="YELLOW" bind:tap="chooseStyle">黄色</view>
      <view class="flex-1 rounded-full px-3 py-2 text-center text-[length:22rpx] {{styleKey === 'LIGHT' ? 'bg-brand text-on-brand' : 'bg-panel text-muted'}}" data-key="LIGHT" bind:tap="chooseStyle">浅色</view>
    </view>

    <view class="mt-4 rounded-[16rpx] bg-panel px-4 py-4">
      <view class="flex items-center justify-between gap-3"><view><view class="text-[length:25rpx] font-semibold">名片头像</view><view class="mt-1 text-[length:21rpx] text-muted">选择原头像或已生成的数字分身。</view></view><view class="shrink-0 text-[length:22rpx] text-brand" bind:tap="openDigitalAvatar">数字分身</view></view>
      <view class="mt-3 grid grid-cols-2 gap-2">
        <view class="rounded-[12rpx] px-3 py-3 text-center text-[length:22rpx] {{avatarSource === 'ORIGINAL' ? 'bg-brand text-on-brand' : 'bg-panel-raised text-muted'}}" data-source="ORIGINAL" bind:tap="chooseAvatarSource">原头像</view>
        <view class="rounded-[12rpx] px-3 py-3 text-center text-[length:22rpx] {{avatarSource === 'DIGITAL' ? 'bg-brand text-on-brand' : 'bg-panel-raised text-muted'}}" data-source="DIGITAL" bind:tap="chooseAvatarSource">{{digitalAvatarUrl ? '数字分身' : '暂未生成'}}</view>
      </view>
    </view>

    <view class="mt-4 overflow-hidden rounded-[24rpx] px-6 pb-7 pt-6" style="background: {{palette.background}}; color: {{palette.foreground}};">
      <view class="h-[12rpx] w-[96rpx] rounded-full" style="background: {{palette.accent}};" />
      <view class="mt-4 text-[length:48rpx] font-bold">MIP</view>
      <view class="mt-1 text-[length:20rpx]" style="color: {{palette.muted}};">会员名片</view>
      <image wx:if="{{cardAvatarUrl}}" class="mt-6 h-[176rpx] w-[176rpx] rounded-full" mode="aspectFill" src="{{cardAvatarUrl}}" />
      <view wx:else class="mt-6 flex h-[176rpx] w-[176rpx] items-center justify-center rounded-full text-[length:64rpx] font-bold" style="background: {{palette.accent}}; color: {{palette.background}};">{{initial}}</view>
      <view class="mt-6 text-[length:42rpx] font-bold">{{nickname}}</view>
      <view class="mt-2 text-[length:22rpx]" style="color: {{palette.muted}};">{{memberType}}{{identityStatus ? ' · ' + identityStatus : ''}}</view>
      <view class="mt-6 text-[length:28rpx] font-semibold leading-8">{{headline || '暂未填写个人介绍'}}</view>
      <view wx:if="{{branchName}}" class="mt-6 text-[length:22rpx]" style="color: {{palette.muted}};">城市分会　{{branchName}}</view>
      <view wx:if="{{industryName}}" class="mt-2 text-[length:22rpx]" style="color: {{palette.muted}};">主要行业　{{industryName}}</view>
      <view wx:if="{{abilities.length}}" class="mt-5 flex flex-wrap gap-2"><view wx:for="{{abilities}}" wx:key="*this" class="rounded-full px-3 py-2 text-[length:20rpx]" style="background: {{palette.chip}};">{{item}}</view></view>
      <view class="mt-8 text-[length:20rpx]" style="color: {{palette.muted}};">通过微信分享可查看公开档案</view>
    </view>

    <image wx:if="{{posterPath}}" class="mt-4 h-[720rpx] w-full rounded-[16rpx] bg-panel" mode="aspectFit" src="{{posterPath}}" bind:tap="previewPoster" />
    <view class="mt-4 grid grid-cols-2 gap-3"><t-button block variant="outline" loading="{{generating}}" bind:tap="createPoster">生成图片</t-button><t-button block theme="primary" disabled="{{generating}}" bind:tap="savePoster">保存到相册</t-button></view>
    <view class="mt-3"><t-button block open-type="share" variant="outline">分享名片</t-button></view>
    <view wx:if="{{message}}" class="mt-4 rounded-[12rpx] bg-panel px-4 py-3 text-[length:22rpx] text-danger">{{message}}</view>
  </block>
  <canvas id="mip-member-card-canvas" type="2d" class="fixed left-[-9999px] top-0 h-[600px] w-[375px]"></canvas>
  <app-page-exit />
</view>
