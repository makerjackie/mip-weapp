<view id="mip-case-editor-page" class="mip-member-page case-editor-page min-h-screen bg-canvas px-3 pb-[calc(env(safe-area-inset-bottom)+48rpx)] text-ink">
  <view aria-label="正在加载" aria-busy="true" wx:if="{{state === 'loading'}}" class="rounded-[16rpx] bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}"><mip-empty-state title="暂时无法编辑案例" description="{{message}}" action-text="重新加载" bind:action="initialize" /><app-page-exit /></view>
  <!-- figma 2173_42605 编辑超级案例:全宽 brand 引导横幅 + AI助手卡 + 我的案例标题 +
       每个项目一整块 panel 表单(项目名称/一句话描述/开始时间/担任职责/主营城市 + 热门城市标签
       [标注 2127_2195:主营城市使用城市标签库]/主营地区/项目类型/展开讲讲) + 添加项目 +
       底部吸附「保存」。素材上传与取消入口不在设计稿内,已移除。 -->
  <block wx:else>
    <view class="case-editor-guidance -mx-3 flex h-[64rpx] items-center justify-center bg-brand px-4 text-center text-[28rpx] font-medium leading-[39.2rpx] text-on-brand">做过哪些展现您能力的超级案例</view>

    <view class="case-editor-ai mt-6 flex min-h-[200rpx] items-center justify-center rounded-[16rpx] border-[2rpx] border-brand bg-panel" aria-role="button" aria-label="AI 语音填写，即将开放" bind:tap="onAiAssistant">
      <view class="flex items-center gap-[12rpx]">
        <image class="case-editor-ai__icon h-[48rpx] w-[48rpx]" src="/packages/member/mip-cases/editor/assets/ai-assistant.svg" mode="aspectFit" />
        <text class="case-editor-ai__label text-[28rpx] font-medium leading-[40rpx] text-brand">AI助手</text>
      </view>
    </view>

    <view class="case-editor-section-heading mt-4 flex min-h-[56rpx] items-center justify-between gap-3">
      <view class="flex min-w-0 items-center gap-2">
        <image class="case-editor-section-icon h-[32rpx] w-[32rpx] shrink-0" src="/packages/member/mip-cases/editor/assets/case-section.svg" mode="aspectFit" />
        <view class="case-editor-section-title text-[32rpx] font-medium">我的案例</view>
      </view>
      <view wx:if="{{publicationStatus === 'PUBLISHED'}}" class="case-editor-status shrink-0 rounded-full bg-brand px-3 py-1 text-[22rpx] font-medium text-on-brand">{{publicationStatusText}}</view>
      <view wx:else class="case-editor-status shrink-0 rounded-full border border-line bg-panel px-3 py-1 text-[22rpx] text-muted">{{publicationStatusText}}</view>
    </view>

    <view class="case-editor-form-layout mt-2">
      <block wx:for="{{projects}}" wx:for-item="project" wx:for-index="groupIndex" wx:key="groupIndex">
      <view class="case-editor-project">
      <view wx:if="{{groupIndex > 0}}" class="case-editor-project-heading flex min-h-[56rpx] items-center justify-between">
        <text class="text-[32rpx] font-medium text-ink">项目 {{groupIndex + 1}}</text>
        <view class="flex h-[56rpx] items-center" aria-role="button" aria-label="删除项目 {{groupIndex + 1}}" data-group-index="{{groupIndex}}" bind:tap="removeProject">
          <text class="text-[24rpx] text-danger">删除项目</text>
        </view>
      </view>
      <view class="case-editor-field-group">
        <view class="case-editor-field-row">
          <view class="case-editor-field__label">项目名称</view>
          <input aria-label="项目名称" class="case-editor-field__control" value="{{project.projectName}}" maxlength="120" placeholder="示例：MIP全球创意人平台" placeholder-class="case-editor-field__placeholder" data-group-index="{{groupIndex}}" data-field="projectName" bindinput="updateProjectText" />
        </view>
        <view class="case-editor-field-row">
          <view class="case-editor-field__label">一句话描述案例</view>
          <input aria-label="项目摘要" class="case-editor-field__control" value="{{project.summary}}" maxlength="240" placeholder="示例：千万超级个体生意写作社群" placeholder-class="case-editor-field__placeholder" data-group-index="{{groupIndex}}" data-field="summary" bindinput="updateProjectText" />
        </view>
        <picker mode="date" value="{{project.startedOn}}" data-group-index="{{groupIndex}}" bindchange="changeProjectStart">
          <view class="case-editor-field-row">
            <view class="case-editor-field__label">开始时间</view>
            <view class="case-editor-field__value">
              <text class="case-editor-field__value-text">{{project.startedOn || '请选择'}}</text>
              <image class="case-editor-field-icon h-[40rpx] w-[40rpx] shrink-0" src="/packages/member/mip-cases/editor/assets/calendar.svg" mode="aspectFit" />
            </view>
          </view>
        </picker>
        <view class="case-editor-field-row">
          <view class="case-editor-field__label">担任职责</view>
          <input aria-label="承担职责" class="case-editor-field__control" value="{{project.responsibility}}" maxlength="500" placeholder="示例：MIP团队管理" placeholder-class="case-editor-field__placeholder" data-group-index="{{groupIndex}}" data-field="responsibility" bindinput="updateProjectText" />
        </view>
        <view class="case-editor-field-row" aria-role="button" aria-label="选择主营城市" data-group-index="{{groupIndex}}" data-selected="{{project.cityLabel}}" bind:tap="openCitySelector">
          <view class="case-editor-field__label">主营城市</view>
          <view class="case-editor-field__value">
            <text class="case-editor-field__value-text {{project.cityLabel ? 'text-ink' : ''}}">{{project.cityLabel || '请选择城市'}}</text>
            <image class="case-editor-chevron h-[32rpx] w-[32rpx] shrink-0" src="/packages/member/mip-cases/editor/assets/chevron.svg" mode="aspectFit" />
          </view>
        </view>
        <view class="case-editor-hot-cities" aria-label="热门城市快捷选择">
          <mip-tag-chip
            wx:for="{{hotCities}}"
            wx:for-item="hotCity"
            wx:key="label"
            block
            label="{{hotCity.label}}"
            active="{{project.cityLabel === hotCity.label}}"
            data-group-index="{{groupIndex}}"
            data-label="{{hotCity.label}}"
            bind:tap="applyHotCity"
          />
        </view>
        <view class="case-editor-field-row">
          <view class="case-editor-field__label">主营地区</view>
          <input aria-label="主营地区" class="case-editor-field__control" value="{{project.region}}" maxlength="120" placeholder="示例：总部在深圳，2026 大湾区扩张中" placeholder-class="case-editor-field__placeholder" data-group-index="{{groupIndex}}" data-field="region" bindinput="updateProjectText" />
        </view>
        <view class="case-editor-field-row">
          <view class="case-editor-field__label">项目类型</view>
          <input aria-label="项目类型" class="case-editor-field__control" value="{{project.caseType}}" maxlength="80" placeholder="示例：广告策划，文化创意，商业地产等" placeholder-class="case-editor-field__placeholder" data-group-index="{{groupIndex}}" data-field="caseType" bindinput="updateProjectText" />
        </view>
        <view class="case-editor-description">
          <view class="text-[28rpx] font-medium leading-[33.6rpx]">展开讲讲（选填）</view>
          <textarea aria-label="项目说明" class="case-editor-description__control" value="{{project.description}}" maxlength="300" placeholder="示例：MIP是面向创意的协作与资源对接的游戏化运作生态，成立1年促成千万生意，战绩可查" placeholder-class="case-editor-field__placeholder" data-group-index="{{groupIndex}}" data-field="description" bindinput="updateProjectText" />
          <view class="text-right text-[28rpx] leading-[40rpx] text-muted">{{project.description.length}}/300</view>
        </view>
      </view>
      </view>
      </block>
    </view>

    <view class="mt-2 flex h-[92rpx] items-center justify-end gap-[16rpx] pr-[6rpx]" aria-role="button" aria-label="添加项目" bind:tap="addProject">
      <mip-icon name="icon-plus-fill" size="{{14}}" color="var(--color-brand)" />
      <text class="text-[24rpx] font-medium text-brand">添加项目</text>
    </view>

    <view wx:if="{{message}}" class="mt-4 rounded-[8rpx] border border-danger px-4 py-3 text-[22rpx] leading-6 text-danger" aria-live="polite">{{message}}</view>

    <mip-sticky-actions>
      <view id="case-editor-fixed-actions" slot="actions" class="case-editor-actions flex min-h-[112rpx] w-full items-center">
        <mip-pill-button class="min-w-0 flex-1" label="保存" loading="{{saving}}" disabled="{{saving}}" bind:tap="saveCase" />
      </view>
    </mip-sticky-actions>
  </block>
</view>
