<view id="mip-case-detail-page" class="min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-4 text-ink">
  <view wx:if="{{state === 'loading'}}" class="rounded-[16rpx] bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}"><app-empty-state title="暂时无法查看案例" description="{{message}}" action-text="重新加载" bind:action="load" /><app-page-exit /></view>
  <block wx:elif="{{item}}">
    <view class="overflow-hidden rounded-[16rpx] bg-panel"><view class="flex h-[360rpx] items-center justify-center bg-panel-raised"><image wx:if="{{item.coverUrl}}" class="h-full w-full" src="{{item.coverUrl}}" mode="aspectFill" /><t-icon wx:else name="image" size="92rpx" color="var(--color-brand)" /></view><view class="px-5 py-5"><view class="flex items-center justify-between text-[length:21rpx] text-muted"><text>{{item.cityLabel || '全国'}}</text><text>{{item.industryLabel || item.caseType || ''}}</text></view><view class="mt-3 text-[length:36rpx] font-bold leading-8">{{item.projectName}}</view><view class="mt-3 text-[length:24rpx] leading-7 text-muted">{{item.summary}}</view></view></view>
    <view class="mt-4 rounded-[16rpx] bg-panel px-5 py-5"><view class="text-[length:28rpx] font-semibold">案例信息</view><view wx:if="{{item.startedOn || item.endedOn}}" class="mt-3 text-[length:22rpx] text-muted">{{item.startedOn || '未填写'}} 至 {{item.endedOn || '至今'}}</view><view class="mt-4 text-[length:21rpx] text-muted">职责</view><view class="mt-1 whitespace-pre-wrap text-[length:24rpx] leading-7">{{item.responsibility}}</view><view class="mt-4 text-[length:21rpx] text-muted">详细说明</view><view class="mt-1 whitespace-pre-wrap text-[length:24rpx] leading-7">{{item.description}}</view></view>
    <view wx:if="{{item.media.length}}" class="mt-4 flex flex-col gap-3"><image wx:for="{{item.media}}" wx:key="url" class="w-full rounded-[16rpx] bg-panel" src="{{item.url}}" mode="widthFix" data-url="{{item.url}}" bind:tap="previewImage" /></view>
    <view class="mt-4 flex min-h-[112rpx] items-center rounded-[16rpx] bg-panel px-5 py-4" bind:tap="openAuthor"><view class="min-w-0 flex-1"><view class="text-[length:21rpx] text-muted">发布人</view><view class="mt-2 text-[length:27rpx] font-semibold">{{item.author.nickname}}</view><view wx:if="{{item.author.headline}}" class="mt-1 text-[length:22rpx] text-muted">{{item.author.headline}}</view></view><t-icon name="chevron-right" size="30rpx" color="var(--color-brand)" /></view>
    <t-button wx:if="{{!item.mine}}" class="mt-5" block size="large" theme="primary" loading="{{acting}}" bind:tap="toggleInterest">{{item.interestActive ? '取消感兴趣' : '我感兴趣'}}</t-button>
    <t-button wx:if="{{item.canEdit}}" class="mt-5" block size="large" theme="primary" bind:tap="edit">编辑案例</t-button>
    <t-button wx:if="{{item.mine && item.status === 'PUBLISHED'}}" class="mt-3" block size="large" variant="outline" theme="danger" loading="{{acting}}" bind:tap="unpublish">下架案例</t-button>
    <t-button wx:if="{{item.mine}}" class="mt-3" block size="large" variant="text" theme="danger" loading="{{acting}}" bind:tap="deleteCase">删除案例</t-button>
    <view wx:if="{{message}}" class="mt-4 rounded-[16rpx] bg-brand-soft px-4 py-3 text-[length:22rpx] text-brand">{{message}}</view>
    <app-page-exit label="返回案例" />
  </block>
</view>
