<view id="mip-case-detail-page" class="mip-member-page min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-4 text-ink">
  <view wx:if="{{state === 'loading'}}" class="rounded-[16rpx] bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}"><app-empty-state title="暂时无法查看案例" description="{{message}}" action-text="重新加载" bind:action="load" /><app-page-exit /></view>
  <block wx:elif="{{item}}">
    <view class="overflow-hidden rounded-[18rpx] bg-brand text-on-brand">
      <view class="flex h-[360rpx] items-center justify-center"><image wx:if="{{item.coverUrl}}" class="h-full w-full" src="{{item.coverUrl}}" mode="aspectFill" /><image wx:else class="h-[112rpx] w-[280rpx]" src="/assets/brand/mip-logo-black.png" mode="aspectFit" /></view>
      <view class="border-t border-black/10 px-5 py-5"><view class="text-[length:38rpx] font-bold leading-8">{{item.projectName}}</view><view class="mt-3 text-[length:23rpx] leading-7 opacity-75">{{item.summary}}</view></view>
    </view>
    <view class="mt-4 overflow-hidden rounded-[16rpx] bg-panel px-4">
      <view class="flex min-h-[80rpx] items-start gap-3 border-b border-line py-3"><view class="w-[152rpx] shrink-0 text-[length:21rpx] text-muted">项目名称</view><view class="min-w-0 flex-1 text-[length:24rpx]">{{item.projectName}}</view></view>
      <view class="flex min-h-[80rpx] items-start gap-3 border-b border-line py-3"><view class="w-[152rpx] shrink-0 text-[length:21rpx] text-muted">一句话说明</view><view class="min-w-0 flex-1 text-[length:24rpx] leading-6">{{item.summary}}</view></view>
      <view class="flex min-h-[80rpx] items-start gap-3 border-b border-line py-3"><view class="w-[152rpx] shrink-0 text-[length:21rpx] text-muted">项目时间</view><view class="min-w-0 flex-1 text-[length:24rpx]">{{item.startedOn || '未填写'}} 至 {{item.endedOn || '至今'}}</view></view>
      <view class="flex min-h-[80rpx] items-start gap-3 border-b border-line py-3"><view class="w-[152rpx] shrink-0 text-[length:21rpx] text-muted">负责内容</view><view class="min-w-0 flex-1 whitespace-pre-wrap text-[length:24rpx] leading-6">{{item.responsibility}}</view></view>
      <view class="flex min-h-[80rpx] items-start gap-3 border-b border-line py-3"><view class="w-[152rpx] shrink-0 text-[length:21rpx] text-muted">项目城市</view><view class="min-w-0 flex-1 text-[length:24rpx]">{{item.cityLabel || '未填写'}}</view></view>
      <view class="flex min-h-[80rpx] items-start gap-3 border-b border-line py-3"><view class="w-[152rpx] shrink-0 text-[length:21rpx] text-muted">案例类型</view><view class="min-w-0 flex-1 text-[length:24rpx]">{{item.industryLabel || item.caseType || '未填写'}}</view></view>
      <view class="flex min-h-[80rpx] items-start gap-3 py-3"><view class="w-[152rpx] shrink-0 text-[length:21rpx] text-muted">案例说明</view><view class="min-w-0 flex-1 whitespace-pre-wrap text-[length:24rpx] leading-7">{{item.description}}</view></view>
    </view>
    <view wx:if="{{item.media.length}}" class="mt-4 flex flex-col gap-3"><image wx:for="{{item.media}}" wx:key="url" class="w-full rounded-[16rpx] bg-panel" src="{{item.url}}" mode="widthFix" data-url="{{item.url}}" bind:tap="previewImage" /></view>
    <view class="mt-4 flex min-h-[112rpx] items-center rounded-[16rpx] bg-panel px-5 py-4" bind:tap="openAuthor"><view class="min-w-0 flex-1"><view class="text-[length:21rpx] text-muted">发布人</view><view class="mt-2 text-[length:27rpx] font-semibold">{{item.author.nickname}}</view><view wx:if="{{item.author.headline}}" class="mt-1 text-[length:22rpx] text-muted">{{item.author.headline}}</view></view><t-icon name="chevron-right" size="30rpx" color="var(--color-brand)" /></view>
    <t-button wx:if="{{!item.mine}}" class="mt-5" block size="large" theme="primary" loading="{{acting}}" bind:tap="toggleInterest">{{item.interestActive ? '取消感兴趣' : '我感兴趣'}}</t-button>
    <t-button wx:if="{{item.canEdit}}" class="mt-5" block size="large" theme="primary" bind:tap="edit">编辑案例</t-button>
    <t-button wx:if="{{item.mine && item.status === 'PUBLISHED'}}" class="mt-3" block size="large" variant="outline" theme="danger" loading="{{acting}}" bind:tap="unpublish">下架案例</t-button>
    <t-button wx:if="{{item.mine}}" class="mt-3" block size="large" variant="text" theme="danger" loading="{{acting}}" bind:tap="deleteCase">删除案例</t-button>
    <view wx:if="{{message}}" class="mt-4 rounded-[16rpx] bg-brand-soft px-4 py-3 text-[length:22rpx] text-brand">{{message}}</view>
    <app-page-exit label="返回案例" />
  </block>
</view>
