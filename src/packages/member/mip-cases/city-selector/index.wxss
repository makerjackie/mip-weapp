/* figma 2215_4618 超级案例详情-选择城市 */
#mip-city-selector-page {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
}

.city-selector-search {
  display: flex;
  flex-shrink: 0;
  padding: 24rpx 24rpx 0;
}

.city-selector-scroll {
  position: relative;
  flex: 1;
  min-height: 0;
}

/* 分组标题：热门城市 / 字母分组，24px 内容缩进（48rpx） */
.city-selector-section-title {
  padding-left: 48rpx;
  margin: 32rpx 0;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 44rpx;
  color: #fff;
}

.city-selector-grid {
  display: grid;
  grid-template-columns: repeat(3, 202rpx);
  gap: 24rpx;
  padding: 0 48rpx;
}

.city-selector-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  font-size: 28rpx;
  line-height: 40rpx;
  color: #f7f7f7;
  background: #333;
  border-radius: 16rpx;
}

.city-selector-chip--active {
  color: #080808;
  background: var(--color-brand);
}

.city-selector-group {
  margin-top: 32rpx;
}

.city-selector-group__letter {
  margin-top: 0;
}

.city-selector-empty-hint {
  padding: 32rpx 48rpx;
  font-size: 28rpx;
  color: var(--color-muted);
}

.city-selector-scroll__footer-space {
  height: 48rpx;
}

/* 右侧字母索引条：贴右缘垂直居中，黄字（设计 355,78 12×700） */
.city-selector-index {
  position: absolute;
  top: 50%;
  right: 8rpx;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  transform: translateY(-50%);
}

.city-selector-index__letter {
  padding: 2rpx 12rpx;
  font-size: 26rpx;
  line-height: 28rpx;
  color: var(--color-brand);
  text-align: center;
}

.city-selector-index__letter--dimmed {
  opacity: 0.3;
}
