<view id="mip-cases-list-page" class="min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-4 text-ink">
  <view class="flex items-center justify-between"><view><view class="text-[length:36rpx] font-bold">超级案例</view><view class="mt-1 text-[length:22rpx] text-muted">展示已发布的项目经历和结果。</view></view><view class="rounded-[12rpx] bg-brand px-4 py-3 text-[length:22rpx] font-semibold text-on-brand" bind:tap="create">发布案例</view></view>
  <view class="mt-4 flex gap-2"><view wx:if="{{!mine}}" class="rounded-full bg-brand px-4 py-2 text-[length:22rpx] text-on-brand" bind:tap="toggleMine">全部案例</view><view wx:else class="rounded-full bg-panel px-4 py-2 text-[length:22rpx] text-muted" bind:tap="toggleMine">全部案例</view><view wx:if="{{mine}}" class="rounded-full bg-brand px-4 py-2 text-[length:22rpx] text-on-brand" bind:tap="toggleMine">我的案例</view><view wx:else class="rounded-full bg-panel px-4 py-2 text-[length:22rpx] text-muted" bind:tap="toggleMine">我的案例</view></view>
  <view wx:if="{{state === 'loading'}}" class="mt-5 rounded-[16rpx] bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}" class="mt-5"><app-empty-state title="暂时无法加载案例" description="{{message}}" action-text="重新加载" bind:action="load" /></view>
  <view wx:elif="{{!items.length}}" class="mt-5"><app-empty-state title="暂时没有案例" description="{{mine ? '已保存的草稿和已发布案例会显示在这里。' : '已发布的案例会显示在这里。'}}" action-text="{{mine ? '发布案例' : ''}}" bind:action="create" /></view>
  <view wx:else class="mt-5 flex flex-col gap-4">
    <view wx:for="{{items}}" wx:key="id" class="overflow-hidden rounded-[18rpx] bg-panel active:opacity-90" data-id="{{item.id}}" bind:tap="open">
      <view class="relative flex h-[300rpx] items-center justify-center overflow-hidden bg-brand">
        <image wx:if="{{item.coverUrl}}" class="h-full w-full" src="{{item.coverUrl}}" mode="aspectFill" />
        <image wx:else class="h-[96rpx] w-[240rpx]" src="/assets/brand/mip-logo-black.png" mode="aspectFit" />
        <view class="absolute bottom-0 left-0 right-0 bg-black/55 px-4 py-3 text-white">
          <view class="truncate text-[length:30rpx] font-bold">{{item.projectName}}</view>
          <view class="mt-1 line-clamp-2 text-[length:21rpx] leading-5 opacity-80">{{item.summary}}</view>
        </view>
      </view>
      <view class="px-4 py-3">
        <view class="flex min-h-[64rpx] items-center gap-3 border-b border-line"><view class="w-[128rpx] shrink-0 text-[length:20rpx] text-muted">项目成员</view><view class="min-w-0 flex-1 truncate text-[length:23rpx]">{{item.author.nickname}}</view></view>
        <view class="flex min-h-[64rpx] items-center gap-3 border-b border-line"><view class="w-[128rpx] shrink-0 text-[length:20rpx] text-muted">项目城市</view><view class="min-w-0 flex-1 truncate text-[length:23rpx]">{{item.cityLabel || '未填写'}}</view></view>
        <view class="flex min-h-[64rpx] items-center gap-3"><view class="w-[128rpx] shrink-0 text-[length:20rpx] text-muted">案例类型</view><view class="min-w-0 flex-1 truncate text-[length:23rpx]">{{item.industryLabel || item.caseType || '未填写'}}</view></view>
        <view wx:if="{{mine}}" class="flex min-h-[72rpx] items-center justify-between border-t border-line"><view class="text-[length:20rpx] text-muted">{{item.status}}</view><view class="flex min-h-[64rpx] items-center px-3 text-[length:21rpx] text-danger" data-id="{{item.id}}" catch:tap="deleteCase">{{archivingId === item.id ? '正在删除' : '删除'}}</view></view>
      </view>
    </view>
  </view>
  <view wx:if="{{loadingMore}}" class="py-5 text-center text-[length:21rpx] text-muted">正在加载</view>
  <app-page-exit label="返回合作卡" />
</view>
