<view id="event-ticket-page" class="min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+40rpx)] pt-4 text-ink">
  <view wx:if="{{state === 'loading'}}" class="rounded-[28rpx] bg-panel px-5 py-8"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}"><app-empty-state title="暂时无法加载凭证" description="服务暂时没有响应，请稍后重试。" action-text="重新加载" bind:action="load" /></view>
  <view wx:elif="{{!registration}}"><app-empty-state title="没有找到报名记录" description="该活动可能尚未报名，或记录暂时不可用。" /></view>
  <block wx:else>
    <view class="overflow-hidden rounded-[34rpx] bg-panel shadow-[0_18rpx_40rpx_rgba(40,94,70,0.12)]">
      <view class="flex items-center justify-between bg-brand px-5 py-3 text-on-brand">
        <view class="flex items-center gap-2 text-[length:23rpx] font-semibold"><t-icon name="check-circle" size="30rpx" color="var(--color-on-brand)" />{{headline}}</view>
        <view class="rounded-full bg-white/15 px-3 py-1 text-[length:19rpx]">报名凭证</view>
      </view>
      <view class="px-5 pb-5 pt-4">
        <view class="line-clamp-2 text-[length:32rpx] font-bold leading-[1.25]">{{event.title}}</view>
        <view class="mt-3 flex items-center gap-2 text-[length:22rpx] text-muted"><t-icon name="time" size="28rpx" color="var(--color-muted)" />{{startsText}}</view>
        <view class="mt-2 flex items-center gap-2 text-[length:22rpx] text-muted"><t-icon name="location" size="28rpx" color="var(--color-muted)" />{{event.location}}</view>

        <view wx:if="{{registration.registrationState === 'REGISTERED'}}" class="mt-4 border-t border-line pt-4 text-center">
          <view class="text-[length:25rpx] font-bold">现场签到码</view>
          <view class="mt-1 text-[length:19rpx] text-muted">请勿转发，二维码会定时更新</view>
          <canvas wx:if="{{passValue}}" id="checkin-qrcode-canvas" type="2d" class="fixed left-[-9999px] top-0 h-[180px] w-[180px]"></canvas>
          <view wx:if="{{passImagePath}}" class="mt-3 flex justify-center">
            <image class="h-[180px] w-[180px] rounded-[12rpx] border border-line bg-white" mode="aspectFit" src="{{passImagePath}}" />
          </view>
          <view wx:elif="{{passValue}}" class="mt-3 flex justify-center">
            <view class="flex h-[180px] w-[180px] items-center justify-center rounded-[12rpx] border border-line bg-white text-[length:21rpx] text-muted">正在绘制签到码…</view>
          </view>
          <view wx:else class="mt-3 text-[length:22rpx] text-muted">正在生成签到码…</view>
          <view class="mt-2 text-[length:19rpx] text-muted">{{passExpiresText}}</view>
          <t-button size="small" variant="text" loading="{{passLoading}}" bind:tap="refreshPass">刷新签到码</t-button>
        </view>

        <view class="mt-4 flex items-center justify-between border-t border-line pt-3 text-[length:20rpx]">
          <text class="text-muted">凭证号</text><text class="font-semibold tracking-[1rpx]">{{credentialText}}</text>
        </view>
      </view>
    </view>
    <view class="mt-3 rounded-[20rpx] bg-brand-soft px-4 py-3 text-[length:21rpx] leading-5 text-brand">{{detail}}</view>
    <view wx:if="{{canCancel}}" class="mt-4"><t-button block variant="outline" theme="danger" loading="{{busy}}" bind:tap="cancel">取消报名</t-button></view>
    <view wx:if="{{message}}" class="mt-3 rounded-[18rpx] bg-[#FFF0E8] px-4 py-3 text-[length:22rpx] text-[#9F4727]">{{message}}</view>
  </block>
  <app-page-exit />
</view>
