<view id="member-benefits-page" class="mip-member-page min-h-screen bg-canvas px-3 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-4 text-ink">
  <view class="rounded-[20rpx] bg-brand px-5 py-5 text-on-brand"><view class="text-[length:22rpx] font-semibold">{{membershipLabel}}</view><view class="mt-2 text-[length:36rpx] font-bold">会员权益</view><view class="mt-3 text-[length:22rpx] opacity-70">{{membershipDescription}}</view><view wx:if="{{membershipEndsText}}" class="mt-2 text-[length:21rpx] opacity-70">会员有效期至 {{membershipEndsText}}</view></view>

  <view wx:if="{{state === 'loading'}}" class="mt-4 flex flex-col gap-3"><view class="rounded-[16rpx] bg-panel px-4 py-6"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view><view class="rounded-[16rpx] bg-panel px-4 py-6"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view></view>
  <view wx:elif="{{state === 'error'}}" class="mt-5"><app-empty-state title="会员权益暂时无法加载" description="请稍后重试。" action-text="重新加载" bind:action="load" /></view>
  <block wx:else>
    <view wx:if="{{isPlayer}}" class="mt-4 rounded-[16rpx] bg-panel px-4 py-5">
      <view class="flex items-center justify-between gap-3"><view class="min-w-0 flex-1"><view class="text-[length:29rpx] font-semibold">当前权益</view><view class="mt-1 text-[length:22rpx] text-muted">{{currentSourceText}}</view></view><view class="rounded-full bg-brand-soft px-3 py-1 text-[length:20rpx] text-brand">有效</view></view>
      <view wx:if="{{planEndsText}}" class="mt-3 text-[length:21rpx] text-muted">本期权益至 {{planEndsText}}</view>
      <view wx:if="{{activeBenefits.length}}" class="mt-4 flex flex-col gap-3"><view wx:for="{{activeBenefits}}" wx:key="key" class="flex items-start gap-3 text-[length:23rpx]"><t-icon class="mt-1 shrink-0" name="check" size="26rpx" color="var(--color-brand)" /><view class="min-w-0 flex-1"><view>{{item.label}}</view><view class="mt-1 text-[length:20rpx] text-muted">当前有效</view></view></view></view>
      <view wx:else class="mt-4 text-[length:22rpx] text-muted">当前记录未配置单独权益说明。</view>
    </view>
    <view wx:if="{{membershipHistory.length}}" class="mt-6">
      <view class="text-[length:30rpx] font-bold">会员记录</view>
      <view class="mt-3 flex flex-col gap-3">
        <view wx:for="{{membershipHistory}}" wx:key="entitlementId" class="rounded-[16rpx] bg-panel px-4 py-4">
          <view class="flex items-center justify-between gap-3"><view class="min-w-0 flex-1 text-[length:26rpx] font-semibold">{{item.title}}</view><view class="shrink-0 rounded-full bg-brand-soft px-3 py-1 text-[length:20rpx] text-brand">{{item.statusLabel}}</view></view>
          <view wx:if="{{item.planName}}" class="mt-2 text-[length:21rpx] text-muted">来源：{{item.sourceLabel}}</view>
          <view class="mt-2 text-[length:21rpx] text-muted">{{item.startsText}} 至 {{item.endsText}}</view>
        </view>
      </view>
    </view>
    <view class="mt-6 text-[length:30rpx] font-bold">会员方案</view>
    <view wx:if="{{plans.length === 0}}" class="mt-3"><app-empty-state title="暂无会员方案" description="会员方案启用后会显示在这里。" /></view>
    <view wx:else class="mt-3 flex flex-col gap-3">
    <view wx:for="{{plans}}" wx:key="id" class="rounded-[16rpx] bg-panel px-4 py-5"><view class="text-[length:29rpx] font-semibold">{{item.name}}</view><view wx:if="{{item.description}}" class="mt-2 text-[length:22rpx] leading-5 text-muted">{{item.description}}</view><view wx:if="{{item.benefits.length}}" class="mt-4 flex flex-col gap-3"><view wx:for="{{item.benefits}}" wx:for-item="benefit" wx:key="*this" class="flex items-start gap-3 text-[length:23rpx]"><t-icon class="mt-1 shrink-0" name="check" size="26rpx" color="var(--color-brand)" /><text class="min-w-0 flex-1">{{benefit}}</text></view></view></view>
    </view>
  </block>
  <view class="mt-4 rounded-[16rpx] border border-line bg-panel px-4 py-4 text-[length:22rpx] leading-5 text-muted">退款、到期或权益撤销后，会员身份和可用权益会按当前会员记录更新。</view>
  <view wx:if="{{message && state !== 'error'}}" class="mt-4 rounded-[16rpx] border border-line bg-panel-raised px-4 py-3 text-[length:22rpx]">{{message}}</view>
  <view wx:if="{{membershipKnown && state === 'ready' && plans.length}}" class="mt-6"><t-button block size="large" theme="primary" bind:tap="openMembership">查看会员方案</t-button></view>
  <app-page-exit label="返回" />
</view>
