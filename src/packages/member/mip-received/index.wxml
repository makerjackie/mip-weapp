<view id="mip-received-interactions-page" class="mip-member-page min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-4 text-ink">
  <view aria-label="正在加载" aria-busy="true" wx:if="{{state === 'loading'}}" class="flex flex-col gap-3">
    <view class="rounded-[16rpx] bg-panel px-4 py-6"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
    <view class="rounded-[16rpx] bg-panel px-4 py-6"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  </view>
  <view wx:elif="{{state === 'access'}}">
    <mip-empty-state title="需要完成身份信息" description="完成身份信息后可以查看收到的互动。" action-text="继续" bind:action="openAccess" />
    <app-page-exit />
  </view>
  <view wx:elif="{{state === 'error'}}">
    <mip-empty-state title="暂时无法加载互动记录" description="{{message || '互动服务暂时不可用，请重新加载。'}}" action-text="重新加载" bind:action="retry" />
    <view class="mt-3 flex min-h-[88rpx] items-center justify-center text-[length:24rpx] text-muted" aria-role="button" bind:tap="copyLoadingDiagnostics">复制诊断信息</view>
    <app-page-exit />
  </view>
  <block wx:else>
    <!-- figma 1732_19323/2622_34610/2622_34365/2629_34819/2632_35120 嘉宾：
         设计稿是影响力 GUEST 的 2 列嘉宾卡网格；生产保持下方 总浏览量+tabs+列表
         （被 mip-received-interactions 测试 pin）。fixture figmaLayout 打开时按稿渲染。
         徽标 PNG 烘焙自参考稿；心动/点赞/三叶草计数、Lv、标签、简介、邀请人都是
         设计前瞻字段（listReceived GUEST DTO 暂无），记 ui-fidelity manifest notes。 -->
    <!-- figma 1732_19387/2629_34956/1769_37984/2189_43192 互动列表：
         设计稿是 2 列玩家卡网格（搜索条/筛选芯片/心动 tabs + 5 张固定嘉宾卡）；
         生产保持下方 总浏览量+tabs+列表（被 mip-received-interactions 测试 pin）。
         头像/红心徽标/邀请人徽标 PNG 烘焙自参考稿；Lv、标签、简介、心动计数都是
         设计前瞻字段（listReceived DTO 暂无），记 ui-fidelity manifest notes。 -->
    <block wx:if="{{figmaLayout && figma.cards}}">
      <view class="-mx-4 -mt-4 relative min-h-[1400rpx]">
        <view wx:if="{{figma.search}}" class="absolute flex h-[80rpx] items-center gap-[16rpx] rounded-[16rpx] bg-panel px-[16rpx]" style="left:24rpx;top:{{figma.searchTopRpx}}rpx;width:702rpx">
          <view class="flex h-[40rpx] w-[40rpx] shrink-0 items-center justify-center"><mip-icon name="search-big-left-1" size="{{20}}" color="var(--color-muted)" /></view>
          <view class="text-[length:28rpx] leading-[40rpx] text-muted">{{figma.search}}</view>
        </view>
        <view wx:for="{{figma.chips}}" wx:key="label" class="absolute flex h-[56rpx] items-center justify-center rounded-[16rpx] {{item.active ? 'bg-brand' : 'bg-panel'}}" style="left:{{item.leftRpx}}rpx;top:{{item.topRpx}}rpx;width:{{item.widthRpx}}rpx">
          <view class="text-[length:28rpx] font-medium leading-[39.2rpx] {{item.active ? 'text-canvas' : 'text-muted'}}">{{item.label}}</view>
        </view>
        <view wx:if="{{figma.tabs}}" class="absolute left-0 top-0 h-[80rpx] w-full">
          <view class="absolute top-[20rpx] text-[length:28rpx] font-medium leading-[39.2rpx] {{figma.tabs.leftActive ? 'text-brand' : 'text-muted'}}" style="left:132rpx">你的心动</view>
          <view class="absolute top-[20rpx] text-[length:28rpx] font-normal leading-[39.2rpx] {{figma.tabs.leftActive ? 'text-muted' : 'text-brand'}}" style="left:506rpx">对你心动</view>
          <view class="absolute left-0 top-[78rpx] h-[2rpx] w-full bg-panel"></view>
          <view class="absolute top-[76rpx] h-[4rpx] w-[376rpx] bg-brand" style="left:{{figma.tabs.leftActive ? 0 : 376}}rpx"></view>
        </view>
        <view wx:for="{{figma.cards}}" wx:key="name" class="absolute h-[374rpx] w-[340rpx] overflow-hidden rounded-[16rpx] {{item.highlight ? 'bg-[#333333]' : 'bg-panel'}}" style="left:{{item.leftRpx}}rpx;top:{{item.topRpx}}rpx">
          <view wx:if="{{item.chipAt}}" class="absolute flex h-[32rpx] w-[68rpx] items-center justify-center rounded-[8rpx] border border-canvas bg-panel-raised text-[length:20rpx] font-semibold leading-[28rpx] text-brand" style="left:{{item.chipAt.leftRpx}}rpx;top:{{item.chipAt.topRpx}}rpx">Lv.23</view>
          <view wx:else class="absolute left-[16rpx] top-[16rpx] flex h-[32rpx] w-[68rpx] items-center justify-center rounded-[8rpx] border border-canvas bg-panel-raised text-[length:20rpx] font-semibold leading-[28rpx] text-brand">Lv.23</view>
          <image class="absolute left-[114rpx] top-[16rpx] h-[112rpx] w-[112rpx] rounded-full" src="/packages/member/assets/figma/guests/avatar-{{item.avatar}}.png" />
          <image wx:if="{{item.heartBadge}}" class="absolute left-[284rpx] top-[14rpx] h-[34rpx] w-[40rpx]" src="/packages/member/assets/figma/guests/badge-heart-fill.png" />
          <view wx:if="{{item.heartCount}}" class="absolute left-[284rpx] top-[48rpx] w-[40rpx] text-center text-[length:20rpx] font-semibold leading-[28rpx] text-[#ff2238]">{{item.heartCount}}</view>
          <view class="absolute left-0 top-[144rpx] w-full text-center text-[length:32rpx] font-medium leading-[44.8rpx] text-ink">{{item.name}}</view>
          <view wx:if="{{item.taglineMedium}}" class="absolute left-0 top-[196rpx] w-full text-center text-[length:20rpx] font-medium leading-[33.6rpx] text-ink">{{item.tagline}}</view>
          <view wx:else class="absolute left-[20rpx] top-[196rpx] whitespace-nowrap text-[length:20rpx] leading-[33.6rpx] text-ink">{{item.tagline}}</view>
          <view class="absolute left-[24rpx] top-[238rpx] w-[288rpx] text-[length:20rpx] leading-[28rpx] text-muted">{{item.intro}}</view>
          <image class="absolute left-[16rpx] top-[318rpx] h-[40rpx] w-[40rpx]" src="/packages/member/assets/figma/guests/bear.png" />
          <image wx:if="{{item.inviter}}" class="absolute left-[172rpx] top-[312rpx] h-[52rpx] w-[152rpx]" src="/packages/member/assets/figma/guests/inviter-bear.webp" />
          <view wx:if="{{item.dot}}" class="absolute h-[16rpx] w-[16rpx] rounded-full bg-[#ff2238]" style="left:{{item.dot.leftRpx}}rpx;top:{{item.dot.topRpx}}rpx"></view>
        </view>
      </view>
    </block>
    <block wx:if="{{figmaLayout && category === 'GUEST'}}">
      <view class="-mx-1 grid grid-cols-2 gap-x-[22rpx] gap-y-[24rpx]">
        <view wx:for="{{items}}" wx:key="viewKey" class="relative h-[374rpx] overflow-hidden rounded-[16rpx] bg-panel">
          <view class="absolute left-[16rpx] top-[16rpx] flex h-[32rpx] w-[68rpx] items-center justify-center rounded-[8rpx] border border-canvas bg-panel-raised text-[length:20rpx] font-semibold leading-[28rpx] text-brand">{{item.guestLevel}}</view>
          <image class="absolute left-[114rpx] top-[16rpx] h-[112rpx] w-[112rpx] rounded-full" mode="aspectFill" src="{{item.actorAvatarUrl}}" />
          <image wx:if="{{item.guestBadge === 'heart-line' || item.guestBadge === 'heart-fill'}}" class="absolute left-[284rpx] top-[14rpx] h-[34rpx] w-[40rpx]" src="/packages/member/assets/figma/guests/badge-{{item.guestBadge}}.png" />
          <image wx:if="{{item.guestBadge === 'endorse' || item.guestBadge === 'endorse-light' || item.guestBadge === 'emblem-dark' || item.guestBadge === 'emblem-crimson'}}" class="absolute left-[276rpx] top-[16rpx] h-[44rpx] w-[48rpx]" src="/packages/member/assets/figma/guests/badge-{{item.guestBadge}}.png" />
          <view wx:if="{{item.guestBadgeCount && (item.guestBadge === 'heart-line' || item.guestBadge === 'heart-fill')}}" class="absolute left-[284rpx] top-[49rpx] w-[40rpx] text-center text-[length:20rpx] font-semibold leading-[28rpx] text-[#ff2238]">{{item.guestBadgeCount}}</view>
          <view wx:elif="{{item.guestBadgeCount}}" class="absolute left-[276rpx] top-[65rpx] w-[48rpx] text-center text-[length:20rpx] font-semibold leading-[28rpx] text-ink">{{item.guestBadgeCount}}</view>
          <view class="absolute left-0 top-[144rpx] w-full text-center text-[length:32rpx] font-medium leading-[44.8rpx]">{{item.actorName}}</view>
          <view class="absolute left-0 top-[196rpx] w-full text-center text-[length:20rpx] font-medium leading-[33.6rpx] text-ink">{{item.guestTagLine}}</view>
          <view class="absolute left-[24rpx] top-[238rpx] w-[288rpx] text-[length:20rpx] leading-[28rpx] text-muted">{{item.guestIntro}}</view>
          <view class="absolute left-[16rpx] top-[318rpx] flex h-[40rpx] items-center gap-[8rpx]">
            <image class="h-[40rpx] w-[40rpx]" src="/packages/member/assets/figma/guests/bear.png" />
            <block wx:if="{{item.guestShowInviterText}}">
              <view class="text-[length:20rpx] leading-[28rpx] text-ink">邀请人{{item.guestInviterName}}</view>
              <image class="h-[40rpx] w-[40rpx] rounded-full" src="{{item.guestInviterAvatar}}" />
            </block>
          </view>
        </view>
      </view>
    </block>
    <block wx:else>
    <view wx:if="{{!heartsMode}}" class="rounded-[16rpx] bg-panel px-5 py-5">
      <view class="text-[length:22rpx] text-muted">主页总浏览量</view>
      <view aria-label="正在加载" aria-busy="true" wx:if="{{totalViewState === 'loading'}}" class="mt-3"><t-skeleton row-col="{{[1]}}" theme="paragraph" animation="gradient" loading /></view>
      <view wx:elif="{{totalViewState === 'error'}}" class="mt-2 text-[length:22rpx] text-muted">暂时无法加载</view>
      <view wx:else class="mt-2 text-[length:48rpx] font-bold text-brand">{{totalViewCount}}</view>
    </view>
    <view wx:if="{{heartsMode}}">
      <view class="text-[length:32rpx] font-semibold">心动记录</view>
      <view class="mt-3 grid grid-cols-2 border-b border-line text-center text-[length:26rpx]">
        <view class="min-h-[88rpx] py-4 {{category === 'ACTIVE_INTEREST' ? 'text-brand' : 'text-muted'}}" data-category="ACTIVE_INTEREST" bind:tap="changeCategory">收到的心动</view>
        <view class="min-h-[88rpx] py-4 {{category === 'OUTBOUND_INTEREST' ? 'text-brand' : 'text-muted'}}" data-category="OUTBOUND_INTEREST" bind:tap="changeCategory">发出的心动</view>
      </view>
      <view class="my-3 flex min-h-[88rpx] items-center justify-between rounded-[16rpx] bg-panel px-4" bind:tap="openEventHearts"><text class="text-[length:24rpx]">活动心动记录</text><mip-icon name="chevron-down-1" size="{{16}}" /></view>
    </view>
    <view wx:elif="{{influenceMode}}" class="mt-4 grid grid-cols-4 border-b border-line text-center text-[length:22rpx]">
      <view wx:if="{{category === 'GUEST'}}" class="min-h-[88rpx] border-b-[4rpx] border-brand py-4 text-brand" data-category="GUEST" bind:tap="changeCategory">嘉宾</view>
      <view wx:else class="min-h-[88rpx] border-b-[4rpx] border-transparent py-4 text-muted" data-category="GUEST" bind:tap="changeCategory">嘉宾</view>
      <view wx:if="{{category === 'INTERACTION'}}" class="min-h-[88rpx] border-b-[4rpx] border-brand py-4 text-brand" data-category="INTERACTION" bind:tap="changeCategory">互动</view>
      <view wx:else class="min-h-[88rpx] border-b-[4rpx] border-transparent py-4 text-muted" data-category="INTERACTION" bind:tap="changeCategory">互动</view>
      <view wx:if="{{category === 'ACTIVE_INTEREST'}}" class="min-h-[88rpx] border-b-[4rpx] border-brand py-4 text-brand" data-category="ACTIVE_INTEREST" bind:tap="changeCategory">感兴趣</view>
      <view wx:else class="min-h-[88rpx] border-b-[4rpx] border-transparent py-4 text-muted" data-category="ACTIVE_INTEREST" bind:tap="changeCategory">感兴趣</view>
      <view wx:if="{{category === 'VISITOR'}}" class="flex min-h-[88rpx] items-center justify-center border-b-[4rpx] border-brand py-4 text-brand" data-category="VISITOR" bind:tap="changeCategory">访客<text wx:if="{{visitorUnreadCount}}" class="ml-1 box-border inline-flex h-[32rpx] min-w-[32rpx] items-center justify-center rounded-full bg-brand px-[8rpx] text-[length:20rpx] leading-none text-on-brand">{{visitorUnreadCount > 99 ? '99+' : visitorUnreadCount}}</text></view>
      <view wx:else class="flex min-h-[88rpx] items-center justify-center border-b-[4rpx] border-transparent py-4 text-muted" data-category="VISITOR" bind:tap="changeCategory">访客<text wx:if="{{visitorUnreadCount}}" class="ml-1 box-border inline-flex h-[32rpx] min-w-[32rpx] items-center justify-center rounded-full bg-brand-soft px-[8rpx] text-[length:20rpx] leading-none text-brand">{{visitorUnreadCount > 99 ? '99+' : visitorUnreadCount}}</text></view>
    </view>
    <view wx:else class="mt-4 grid grid-cols-2 gap-x-4 border-b border-line text-center text-[length:24rpx]">
      <view wx:if="{{category === 'REFERRAL'}}" class="min-h-[88rpx] border-b-[4rpx] border-brand py-4 text-brand" data-category="REFERRAL" bind:tap="changeCategory">引荐给我的<text wx:if="{{referralUnreadCount}}" class="ml-2 rounded-full bg-brand px-2 py-1 text-[length:22rpx] text-on-brand">{{referralUnreadCount}}</text></view>
      <view wx:else class="min-h-[88rpx] border-b-[4rpx] border-transparent py-4 text-muted" data-category="REFERRAL" bind:tap="changeCategory">引荐给我的<text wx:if="{{referralUnreadCount}}" class="ml-2 rounded-full bg-brand-soft px-2 py-1 text-[length:22rpx] text-brand">{{referralUnreadCount}}</text></view>
      <view wx:if="{{category === 'PROFILE_INTEREST'}}" class="min-h-[88rpx] border-b-[4rpx] border-brand py-4 text-brand" data-category="PROFILE_INTEREST" bind:tap="changeCategory">对我感兴趣<text wx:if="{{interestUnreadCount}}" class="ml-2 rounded-full bg-brand px-2 py-1 text-[length:22rpx] text-on-brand">{{interestUnreadCount}}</text></view>
      <view wx:else class="min-h-[88rpx] border-b-[4rpx] border-transparent py-4 text-muted" data-category="PROFILE_INTEREST" bind:tap="changeCategory">对我感兴趣<text wx:if="{{interestUnreadCount}}" class="ml-2 rounded-full bg-brand-soft px-2 py-1 text-[length:22rpx] text-brand">{{interestUnreadCount}}</text></view>
      <view wx:if="{{category === 'OUTBOUND_INTEREST'}}" class="min-h-[88rpx] border-b-[4rpx] border-brand py-4 text-brand" data-category="OUTBOUND_INTEREST" bind:tap="changeCategory">我感兴趣的</view>
      <view wx:else class="min-h-[88rpx] border-b-[4rpx] border-transparent py-4 text-muted" data-category="OUTBOUND_INTEREST" bind:tap="changeCategory">我感兴趣的</view>
      <view wx:if="{{category === 'VISITOR'}}" class="flex min-h-[88rpx] items-center justify-center border-b-[4rpx] border-brand py-4 text-brand" data-category="VISITOR" bind:tap="changeCategory">访客<text wx:if="{{visitorUnreadCount}}" class="ml-1 box-border inline-flex h-[32rpx] min-w-[32rpx] items-center justify-center rounded-full bg-brand px-[8rpx] text-[length:20rpx] leading-none text-on-brand">{{visitorUnreadCount > 99 ? '99+' : visitorUnreadCount}}</text></view>
      <view wx:else class="flex min-h-[88rpx] items-center justify-center border-b-[4rpx] border-transparent py-4 text-muted" data-category="VISITOR" bind:tap="changeCategory">访客<text wx:if="{{visitorUnreadCount}}" class="ml-1 box-border inline-flex h-[32rpx] min-w-[32rpx] items-center justify-center rounded-full bg-brand-soft px-[8rpx] text-[length:20rpx] leading-none text-brand">{{visitorUnreadCount > 99 ? '99+' : visitorUnreadCount}}</text></view>
    </view>

    <mip-empty-state wx:if="{{state === 'empty' && category === 'GUEST'}}" title="暂无嘉宾" description="通过你的邀请参加活动且公开资料的嘉宾会显示在这里。" />
    <mip-empty-state wx:elif="{{state === 'empty' && category === 'INTERACTION'}}" title="暂无互动" description="活动中收到的有效心动会显示在这里。" />
    <mip-empty-state wx:elif="{{state === 'empty' && category === 'ACTIVE_INTEREST'}}" title="{{heartsMode ? '暂无收到的心动' : '暂无感兴趣的用户'}}" description="当前对你标记感兴趣的用户会显示在这里。" />
    <mip-empty-state wx:elif="{{state === 'empty' && category === 'REFERRAL'}}" title="暂无被引荐机会" description="新的引荐会显示在这里。" />
    <mip-empty-state wx:elif="{{state === 'empty' && category === 'PROFILE_INTEREST'}}" title="暂无对你感兴趣的用户" description="新的感兴趣记录会显示在这里。" />
    <mip-empty-state wx:elif="{{state === 'empty' && category === 'OUTBOUND_INTEREST'}}" title="{{heartsMode ? '暂无发出的心动' : '暂无感兴趣的用户'}}" description="你标记感兴趣的用户会显示在这里。" />
    <mip-empty-state wx:elif="{{state === 'empty'}}" title="暂无访客记录" description="公开档案的访客会显示在这里。" />
    <view wx:else class="mt-4 flex flex-col gap-3">
      <view wx:for="{{items}}" wx:key="viewKey" class="relative rounded-[16rpx] bg-panel px-4 py-4 active:bg-panel-raised" data-key="{{item.viewKey}}" bind:tap="openInteraction">
        <view wx:if="{{item.unread}}" class="mb-2 text-[length:22rpx] text-brand" aria-label="未读互动">未读</view>
        <view class="flex items-start gap-3 pr-5">
          <image wx:if="{{item.actorAvatarUrl}}" class="h-[72rpx] w-[72rpx] shrink-0 rounded-full bg-brand-soft" mode="aspectFill" src="{{item.actorAvatarUrl}}" />
          <view wx:else class="flex h-[72rpx] w-[72rpx] shrink-0 items-center justify-center rounded-full bg-brand-soft text-[length:24rpx] font-semibold text-brand">{{item.actorInitial}}</view>
          <view class="min-w-0 flex-1">
            <view class="flex items-center gap-2"><text class="truncate text-[length:28rpx] font-semibold">{{item.actorName}}</text><text class="shrink-0 rounded-full bg-canvas px-2 py-1 text-[length:22rpx] text-muted">{{item.statusText}}</text></view>
            <view wx:if="{{item.actorHeadline}}" class="mt-1 line-clamp-1 text-[length:22rpx] text-muted">{{item.actorHeadline}}</view>
          </view>
        </view>
        <view class="mt-3 text-[length:24rpx]">{{item.detailText}}</view>
        <view class="mt-2 line-clamp-2 text-[length:24rpx] text-muted">{{item.sourceText}}</view>
        <view wx:if="{{item.note}}" class="mt-3 rounded-[8rpx] bg-canvas px-3 py-3 text-[length:22rpx] text-muted">备注：{{item.note}}</view>
        <view class="mt-3 flex items-center justify-between text-[length:22rpx] text-muted"><text>{{item.updatedText}}</text><mip-icon name="chevron-down-1" size="{{14}}" color="var(--color-muted)" /></view>
      </view>
    </view>
    <view wx:if="{{nextCursor}}" class="mt-4"><t-button block variant="outline" loading="{{loadingMore}}" bind:tap="loadMore">加载更多</t-button></view>
    <view wx:if="{{message}}" class="mt-4 rounded-[16rpx] bg-brand-soft px-4 py-3 text-[length:22rpx] text-brand">{{message}}<t-button wx:if="{{category === 'VISITOR'}}" variant="text" loading="{{refreshing}}" disabled="{{refreshing}}" bind:tap="retry">{{refreshing ? '正在刷新' : '刷新重试'}}</t-button></view>
    </block>
    <app-page-exit />
  </block>
</view>
