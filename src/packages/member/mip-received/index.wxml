<view id="mip-received-interactions-page" class="mip-member-page min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-4 text-ink">
  <view wx:if="{{state === 'loading'}}" class="flex flex-col gap-3">
    <view class="rounded-[16rpx] bg-panel px-4 py-6"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
    <view class="rounded-[16rpx] bg-panel px-4 py-6"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  </view>
  <view wx:elif="{{state === 'access'}}">
    <app-empty-state title="需要完成身份信息" description="完成身份信息后可以查看收到的互动。" action-text="继续" bind:action="openAccess" />
    <app-page-exit />
  </view>
  <view wx:elif="{{state === 'error'}}">
    <app-empty-state title="暂时无法加载互动记录" description="请检查网络后重试。" action-text="重新加载" bind:action="retry" />
    <app-page-exit />
  </view>
  <block wx:else>
    <view class="rounded-[16rpx] bg-panel px-5 py-5">
      <view class="text-[length:22rpx] text-muted">主页总浏览量</view>
      <view wx:if="{{totalViewState === 'loading'}}" class="mt-3"><t-skeleton row-col="{{[1]}}" theme="paragraph" animation="gradient" loading /></view>
      <view wx:elif="{{totalViewState === 'error'}}" class="mt-2 text-[length:22rpx] text-muted">暂时无法加载</view>
      <view wx:else class="mt-2 text-[length:44rpx] font-bold text-brand">{{totalViewCount}}</view>
    </view>
    <view wx:if="{{influenceMode}}" class="mt-4 grid grid-cols-4 border-b border-line text-center text-[length:22rpx]">
      <view wx:if="{{category === 'GUEST'}}" class="min-h-[84rpx] border-b-[4rpx] border-brand py-4 text-brand" data-category="GUEST" bind:tap="changeCategory">嘉宾</view>
      <view wx:else class="min-h-[84rpx] border-b-[4rpx] border-transparent py-4 text-muted" data-category="GUEST" bind:tap="changeCategory">嘉宾</view>
      <view wx:if="{{category === 'INTERACTION'}}" class="min-h-[84rpx] border-b-[4rpx] border-brand py-4 text-brand" data-category="INTERACTION" bind:tap="changeCategory">互动</view>
      <view wx:else class="min-h-[84rpx] border-b-[4rpx] border-transparent py-4 text-muted" data-category="INTERACTION" bind:tap="changeCategory">互动</view>
      <view wx:if="{{category === 'ACTIVE_INTEREST'}}" class="min-h-[84rpx] border-b-[4rpx] border-brand py-4 text-brand" data-category="ACTIVE_INTEREST" bind:tap="changeCategory">感兴趣</view>
      <view wx:else class="min-h-[84rpx] border-b-[4rpx] border-transparent py-4 text-muted" data-category="ACTIVE_INTEREST" bind:tap="changeCategory">感兴趣</view>
      <view wx:if="{{category === 'VISITOR'}}" class="min-h-[84rpx] border-b-[4rpx] border-brand py-4 text-brand" data-category="VISITOR" bind:tap="changeCategory">访客<text wx:if="{{visitorUnreadCount}}" class="ml-1 rounded-full bg-brand px-1 py-1 text-[length:17rpx] text-on-brand">{{visitorUnreadCount}}</text></view>
      <view wx:else class="min-h-[84rpx] border-b-[4rpx] border-transparent py-4 text-muted" data-category="VISITOR" bind:tap="changeCategory">访客<text wx:if="{{visitorUnreadCount}}" class="ml-1 rounded-full bg-brand-soft px-1 py-1 text-[length:17rpx] text-brand">{{visitorUnreadCount}}</text></view>
    </view>
    <view wx:else class="mt-4 grid grid-cols-2 gap-x-4 border-b border-line text-center text-[length:24rpx]">
      <view wx:if="{{category === 'REFERRAL'}}" class="min-h-[84rpx] border-b-[4rpx] border-brand py-4 text-brand" data-category="REFERRAL" bind:tap="changeCategory">引荐给我的<text wx:if="{{referralUnreadCount}}" class="ml-2 rounded-full bg-brand px-2 py-1 text-[length:18rpx] text-on-brand">{{referralUnreadCount}}</text></view>
      <view wx:else class="min-h-[84rpx] border-b-[4rpx] border-transparent py-4 text-muted" data-category="REFERRAL" bind:tap="changeCategory">引荐给我的<text wx:if="{{referralUnreadCount}}" class="ml-2 rounded-full bg-brand-soft px-2 py-1 text-[length:18rpx] text-brand">{{referralUnreadCount}}</text></view>
      <view wx:if="{{category === 'PROFILE_INTEREST'}}" class="min-h-[84rpx] border-b-[4rpx] border-brand py-4 text-brand" data-category="PROFILE_INTEREST" bind:tap="changeCategory">对我感兴趣<text wx:if="{{interestUnreadCount}}" class="ml-2 rounded-full bg-brand px-2 py-1 text-[length:18rpx] text-on-brand">{{interestUnreadCount}}</text></view>
      <view wx:else class="min-h-[84rpx] border-b-[4rpx] border-transparent py-4 text-muted" data-category="PROFILE_INTEREST" bind:tap="changeCategory">对我感兴趣<text wx:if="{{interestUnreadCount}}" class="ml-2 rounded-full bg-brand-soft px-2 py-1 text-[length:18rpx] text-brand">{{interestUnreadCount}}</text></view>
      <view wx:if="{{category === 'OUTBOUND_INTEREST'}}" class="min-h-[84rpx] border-b-[4rpx] border-brand py-4 text-brand" data-category="OUTBOUND_INTEREST" bind:tap="changeCategory">我感兴趣的</view>
      <view wx:else class="min-h-[84rpx] border-b-[4rpx] border-transparent py-4 text-muted" data-category="OUTBOUND_INTEREST" bind:tap="changeCategory">我感兴趣的</view>
      <view wx:if="{{category === 'VISITOR'}}" class="min-h-[84rpx] border-b-[4rpx] border-brand py-4 text-brand" data-category="VISITOR" bind:tap="changeCategory">访客<text wx:if="{{visitorUnreadCount}}" class="ml-2 rounded-full bg-brand px-2 py-1 text-[length:18rpx] text-on-brand">{{visitorUnreadCount}}</text></view>
      <view wx:else class="min-h-[84rpx] border-b-[4rpx] border-transparent py-4 text-muted" data-category="VISITOR" bind:tap="changeCategory">访客<text wx:if="{{visitorUnreadCount}}" class="ml-2 rounded-full bg-brand-soft px-2 py-1 text-[length:18rpx] text-brand">{{visitorUnreadCount}}</text></view>
    </view>

    <app-empty-state wx:if="{{state === 'empty' && category === 'GUEST'}}" title="暂无嘉宾" description="通过你的邀请参加活动且公开资料的嘉宾会显示在这里。" />
    <app-empty-state wx:elif="{{state === 'empty' && category === 'INTERACTION'}}" title="暂无互动" description="活动中收到的有效心动会显示在这里。" />
    <app-empty-state wx:elif="{{state === 'empty' && category === 'ACTIVE_INTEREST'}}" title="暂无感兴趣的用户" description="当前对你标记感兴趣的用户会显示在这里。" />
    <app-empty-state wx:elif="{{state === 'empty' && category === 'REFERRAL'}}" title="暂无被引荐机会" description="新的引荐会显示在这里。" />
    <app-empty-state wx:elif="{{state === 'empty' && category === 'PROFILE_INTEREST'}}" title="暂无对你感兴趣的用户" description="新的感兴趣记录会显示在这里。" />
    <app-empty-state wx:elif="{{state === 'empty' && category === 'OUTBOUND_INTEREST'}}" title="暂无感兴趣的用户" description="你标记感兴趣的用户会显示在这里。" />
    <app-empty-state wx:elif="{{state === 'empty'}}" title="暂无访客记录" description="公开档案的访客会显示在这里。" />
    <view wx:else class="mt-4 flex flex-col gap-3">
      <view wx:for="{{items}}" wx:key="viewKey" class="relative rounded-[16rpx] bg-panel px-4 py-4 active:bg-panel-raised" data-key="{{item.viewKey}}" bind:tap="openInteraction">
        <view wx:if="{{item.unread}}" class="absolute right-4 top-4 h-[14rpx] w-[14rpx] rounded-full bg-brand"></view>
        <view class="flex items-start gap-3 pr-5">
          <image wx:if="{{item.actorAvatarUrl}}" class="h-[72rpx] w-[72rpx] shrink-0 rounded-full bg-brand-soft" mode="aspectFill" src="{{item.actorAvatarUrl}}" />
          <view wx:else class="flex h-[72rpx] w-[72rpx] shrink-0 items-center justify-center rounded-full bg-brand-soft text-[length:26rpx] font-semibold text-brand">{{item.actorInitial}}</view>
          <view class="min-w-0 flex-1">
            <view class="flex items-center gap-2"><text class="truncate text-[length:27rpx] font-semibold">{{item.actorName}}</text><text class="shrink-0 rounded-full bg-canvas px-2 py-1 text-[length:18rpx] text-muted">{{item.statusText}}</text></view>
            <view wx:if="{{item.actorHeadline}}" class="mt-1 line-clamp-1 text-[length:21rpx] text-muted">{{item.actorHeadline}}</view>
          </view>
        </view>
        <view class="mt-3 text-[length:23rpx]">{{item.detailText}}</view>
        <view class="mt-2 line-clamp-2 text-[length:23rpx] text-muted">{{item.sourceText}}</view>
        <view wx:if="{{item.note}}" class="mt-3 rounded-[12rpx] bg-canvas px-3 py-3 text-[length:22rpx] text-muted">备注：{{item.note}}</view>
        <view class="mt-3 flex items-center justify-between text-[length:20rpx] text-muted"><text>{{item.updatedText}}</text><t-icon name="chevron-right" size="28rpx" color="var(--color-muted)" /></view>
      </view>
    </view>
    <view wx:if="{{nextCursor}}" class="mt-4"><t-button block variant="outline" loading="{{loadingMore}}" bind:tap="loadMore">加载更多</t-button></view>
    <view wx:if="{{message}}" class="mt-4 rounded-[16rpx] bg-brand-soft px-4 py-3 text-[length:22rpx] text-brand">{{message}}</view>
    <app-page-exit />
  </block>
</view>
