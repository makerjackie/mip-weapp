<view id="member-announcement-detail-page" class="min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-4 text-ink">
  <view wx:if="{{state === 'loading'}}" class="rounded-[24rpx] bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}"><app-empty-state title="公告暂时无法打开" description="{{message}}" action-text="重新加载" bind:action="loadAnnouncement" /></view>
  <view wx:else class="rounded-[28rpx] bg-panel px-5 py-6">
    <view class="flex items-center gap-2"><view wx:if="{{item.isPinned}}" class="rounded-full bg-accent px-2 py-1 text-[length:18rpx] font-semibold text-white">置顶</view><view class="text-[length:20rpx] font-semibold text-brand">同行会公告</view></view>
    <view class="mt-3 text-[length:38rpx] font-bold leading-tight">{{item.title}}</view>
    <view wx:if="{{publishedText}}" class="mt-3 text-[length:20rpx] text-muted">{{publishedText}}</view>
    <view class="mt-5 border-t border-line pt-5 whitespace-pre-wrap text-[length:26rpx] leading-8">{{item.body}}</view>
  </view>
  <view wx:if="{{message && state === 'ready'}}" class="mt-4 rounded-[18rpx] bg-[#FFF0E8] px-4 py-3 text-[length:23rpx] text-[#9F4727]">{{message}}</view>
</view>
