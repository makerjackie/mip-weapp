<view id="registration-confirm-page" class="min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+180rpx)] pt-4 text-ink">
  <view wx:if="{{state === 'loading'}}" class="rounded-[28rpx] bg-panel px-5 py-8"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}"><app-empty-state title="暂时无法确认报名" description="活动可能已下线，请稍后重试。" action-text="重新加载" bind:action="load" /></view>
  <block wx:else>
    <view class="text-[length:36rpx] font-bold">{{editing ? '修改报名资料' : '确认报名信息'}}</view>
    <view class="mt-2 text-[length:22rpx] leading-5 text-muted">{{registrationHint}}</view>
    <view class="mt-5 rounded-[24rpx] border border-line bg-panel px-5 py-4">
      <view class="flex items-start justify-between gap-4">
        <view class="min-w-0 flex-1"><view class="text-[length:20rpx] font-semibold text-brand">本次活动</view><view class="mt-1 line-clamp-2 text-[length:27rpx] font-bold">{{event.title}}</view></view>
        <view class="shrink-0 rounded-full bg-brand-soft px-3 py-2 text-[length:20rpx] font-semibold text-brand">{{priceText}}</view>
      </view>
      <view class="mt-3 flex items-center gap-2 border-t border-line pt-3 text-[length:21rpx] text-muted"><t-icon name="check-circle" size="30rpx" color="var(--color-brand)" />{{profileReady ? '已绑定微信手机号，可直接提交' : '提交前需要绑定微信手机号'}}</view>
    </view>
    <view wx:if="{{questions.length}}" class="mt-4 rounded-[26rpx] bg-panel px-5 py-5">
      <view class="text-[length:28rpx] font-bold">报名信息</view>
      <view class="mt-1 text-[length:21rpx] text-muted">{{editing ? '修改只影响本次报名，不会覆盖个人名片。' : '已复用名片中的资料，你可以在本次报名中修改。'}}</view>
      <view wx:for="{{questions}}" wx:key="id" id="registration-question-{{index}}" class="mt-5">
        <view class="flex items-center gap-1 text-[length:23rpx] font-semibold">
          <text>{{item.label}}</text>
          <text wx:if="{{item.required}}" class="text-coral">*</text>
        </view>
        <view wx:if="{{item.description}}" class="mt-1 text-[length:20rpx] text-muted">{{item.description}}</view>
        <textarea
          wx:if="{{item.type === 'LONG_TEXT'}}"
          class="mt-2 box-border h-[170rpx] w-full max-w-full rounded-[18rpx] bg-canvas px-4 py-3 text-[length:24rpx]"
          value="{{item.value}}"
          data-index="{{index}}"
          maxlength="1000"
          bindinput="updateAnswer"
          placeholder="请填写"
        />
        <input
          wx:elif="{{item.type === 'SHORT_TEXT' || item.type === 'NUMBER' || item.type === 'PHONE' || item.type === 'ID_CARD'}}"
          class="mt-2 box-border h-[82rpx] w-full max-w-full rounded-[18rpx] bg-canvas px-4 text-[length:24rpx]"
          type="{{item.type === 'NUMBER' ? 'digit' : item.type === 'PHONE' ? 'number' : item.type === 'ID_CARD' ? 'idcard' : 'text'}}"
          value="{{item.value}}"
          data-index="{{index}}"
          maxlength="{{item.type === 'PHONE' ? 11 : item.type === 'ID_CARD' ? 18 : item.type === 'NUMBER' ? 20 : 120}}"
          bindinput="updateAnswer"
          placeholder="{{item.type === 'PHONE' ? '请输入 11 位手机号' : item.type === 'ID_CARD' ? '请输入身份证号' : '请填写'}}"
        />
        <picker
          wx:elif="{{item.type === 'SINGLE_CHOICE'}}"
          mode="selector"
          range="{{item.options}}"
          value="{{item.selectedIndex}}"
          data-index="{{index}}"
          bindchange="chooseSingle"
        >
          <view class="mt-2 flex h-[82rpx] items-center justify-between rounded-[18rpx] bg-canvas px-4 text-[length:24rpx]">
            <text>{{item.selectedText || '请选择'}}</text>
            <t-icon name="chevron-right" size="34rpx" color="var(--color-muted)" />
          </view>
        </picker>
        <checkbox-group
          wx:elif="{{item.type === 'MULTI_CHOICE'}}"
          class="mt-2 flex flex-wrap gap-3"
          data-index="{{index}}"
          bindchange="chooseMultiple"
        >
          <label wx:for="{{item.optionViews}}" wx:for-item="option" wx:key="label" class="rounded-full bg-canvas px-3 py-2 text-[length:22rpx]">
            <checkbox value="{{option.label}}" checked="{{option.checked}}" color="#285E46" />
            <text class="ml-1">{{option.label}}</text>
          </label>
        </checkbox-group>
        <view wx:elif="{{item.type === 'BOOLEAN'}}" class="mt-2 flex items-center justify-between rounded-[18rpx] bg-canvas px-4 py-3">
          <text class="text-[length:22rpx] text-muted">确认并同意</text>
          <switch checked="{{item.value}}" data-index="{{index}}" color="#285E46" bindchange="toggleBoolean" />
        </view>
      </view>
    </view>
    <view class="mt-4 rounded-[24rpx] bg-panel px-5 py-5">
      <view class="flex items-start justify-between gap-4">
        <view class="min-w-0 flex-1">
          <view class="text-[length:25rpx] font-semibold">在参与者列表展示我的公开资料</view>
          <view class="mt-2 text-[length:21rpx] leading-5 text-muted">默认开启。仅展示头像、昵称、职业与个人简介；手机号和报名答案不会公开。</view>
        </view>
        <switch checked="{{shareProfile}}" color="#285E46" bindchange="toggleShareProfile" />
      </view>
    </view>
    <view wx:if="{{message}}" class="mt-4 rounded-[18rpx] bg-[#FFF0E8] px-4 py-3 text-[length:23rpx] text-[#9F4727]">{{message}}</view>
    <view class="fixed inset-x-0 bottom-0 z-20 border-t border-line bg-panel px-4 pb-[calc(env(safe-area-inset-bottom)+20rpx)] pt-3"><t-button block size="large" theme="primary" loading="{{busy}}" bind:tap="confirm">{{editing ? '保存报名资料' : !profileReady ? '绑定手机号并继续' : event.memberFree && !event.membershipActive ? '开通会员后报名' : event.activityType === 'PAID' ? '支付 ' + priceText + ' 并报名' : event.registrationMode === 'APPROVAL' ? '提交报名申请' : event.waitlistEnabled && event.capacity && event.registrationCount >= event.capacity ? '加入候补' : '确认报名'}}</t-button></view>
  </block>
</view>
