<view id="mip-blind-box-coin-entries-page" class="mip-member-page min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-5 text-ink">
  <view class="flex items-start justify-between gap-4"><view><view class="text-[length:40rpx] font-bold">游戏币流水</view><view class="mt-2 text-[length:23rpx] text-muted">查看游戏币收支记录</view></view><view class="shrink-0 rounded-full bg-brand px-3 py-2 text-[length:22rpx] font-semibold text-on-brand">{{coinBalance}} 游戏币</view></view>
  <view wx:if="{{state === 'loading'}}" class="mt-5 rounded-[16rpx] bg-panel px-4 py-7"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}" class="mt-5"><app-empty-state title="暂时无法加载流水" description="{{message}}" action-text="重新加载" bind:action="loadEntries" /></view>
  <view wx:elif="{{state === 'empty'}}" class="mt-5"><app-empty-state title="暂无游戏币流水" description="游戏币发生变化后会显示在这里。" /></view>
  <view wx:else class="mt-5 overflow-hidden rounded-[16rpx] bg-panel">
    <view wx:for="{{items}}" wx:key="id" class="flex min-h-[112rpx] items-center gap-4 border-b border-line px-4 py-3 last:border-b-0"><view class="min-w-0 flex-1"><view class="text-[length:25rpx] font-semibold">{{item.reason}}</view><view wx:if="{{item.createdText}}" class="mt-1 text-[length:20rpx] text-muted">{{item.createdText}}</view><view class="mt-1 text-[length:19rpx] text-muted">余额 {{item.balanceAfter}}</view></view><view class="shrink-0 text-[length:29rpx] font-bold {{item.deltaValue > 0 ? 'text-success' : 'text-ink'}}">{{item.deltaText}}</view></view>
    <view wx:if="{{message}}" class="border-t border-line px-4 py-3 text-[length:22rpx] text-danger">{{message}}</view>
  </view>
  <app-page-exit label="返回盲盒" />
</view>
