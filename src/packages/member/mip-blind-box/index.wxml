<view id="mip-blind-box-page" class="mip-member-page min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-5 text-ink">
  <view class="flex items-start justify-between gap-4">
    <view><view class="text-[length:40rpx] font-bold">笨笨盲盒</view><view class="mt-2 text-[length:23rpx] text-muted">使用游戏币抽取已发布卡牌</view></view>
    <view wx:if="{{state !== 'forbidden'}}" class="shrink-0 rounded-full bg-brand px-3 py-2 text-[length:22rpx] font-semibold text-on-brand">{{coinBalance}} 游戏币</view>
  </view>

  <view wx:if="{{state !== 'forbidden'}}" class="mt-5 grid grid-cols-2 gap-3">
    <view class="box-border flex min-h-[104rpx] max-w-full items-center rounded-[16rpx] bg-panel px-4" aria-role="button" bind:tap="openBackpack"><view class="min-w-0 flex-1"><view class="text-[length:26rpx] font-semibold">卡牌背包</view><view class="mt-1 text-[length:22rpx] text-muted">查看已获得卡牌</view></view><t-icon name="chevron-right" size="32rpx" color="var(--color-muted)" /></view>
    <view class="box-border flex min-h-[104rpx] max-w-full items-center rounded-[16rpx] bg-panel px-4" aria-role="button" bind:tap="openCoinEntries"><view class="min-w-0 flex-1"><view class="text-[length:26rpx] font-semibold">游戏币流水</view><view class="mt-1 text-[length:22rpx] text-muted">查看收支记录</view></view><t-icon name="chevron-right" size="32rpx" color="var(--color-muted)" /></view>
  </view>

  <view aria-label="正在加载" aria-busy="true" wx:if="{{state === 'loading'}}" class="mt-5 rounded-[16rpx] bg-panel px-4 py-6"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}" class="mt-5"><app-empty-state title="暂时无法加载盲盒" description="{{message}}" action-text="重新加载" bind:action="loadCatalogs" /></view>
  <view wx:elif="{{state === 'forbidden'}}" class="mt-5"><app-empty-state title="仅对有效会员开放" description="当前账号没有有效会员权益。" action-text="查看会员服务" bind:action="openMembership" /></view>
  <view wx:elif="{{state === 'empty'}}" class="mt-5"><app-empty-state title="暂无可用盲盒" description="盲盒发布后会显示在这里。" /></view>
  <view wx:else class="mt-5 flex flex-col gap-3">
    <view wx:for="{{items}}" wx:key="id" class="rounded-[18rpx] border border-line bg-panel px-4 py-5" data-catalog-id="{{item.id}}" aria-role="button" bind:tap="openDetail">
      <view class="flex items-start justify-between gap-4"><view class="min-w-0 flex-1"><view class="truncate text-[length:30rpx] font-semibold">{{item.name}}</view><view wx:if="{{item.summary}}" class="mt-2 text-[length:22rpx] leading-[1.6] text-muted">{{item.summary}}</view></view><view class="shrink-0 rounded-full bg-brand-soft px-3 py-1 text-[length:22rpx] text-brand">{{item.drawCostCoin}} 游戏币</view></view>
      <view class="mt-4 flex flex-wrap gap-2 text-[length:22rpx] text-muted"><view class="rounded-full bg-panel-raised px-3 py-1">{{item.cardCount}} 种卡牌</view><view class="rounded-full bg-panel-raised px-3 py-1">{{item.stockText}}</view><view wx:if="{{item.dailyDrawLimit > 0}}" class="rounded-full bg-panel-raised px-3 py-1">每日最多 {{item.dailyDrawLimit}} 次</view></view>
    </view>
    <view wx:if="{{message}}" class="rounded-[12rpx] bg-panel px-4 py-3 text-[length:22rpx] text-danger">{{message}}</view>
  </view>
  <app-page-exit />
</view>
