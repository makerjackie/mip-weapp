<view id="mip-blind-box-backpack-page" class="min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-5 text-ink">
  <view class="text-[length:40rpx] font-bold">卡牌背包</view><view class="mt-2 text-[length:23rpx] text-muted">查看已获得的盲盒卡牌</view>
  <view wx:if="{{state === 'loading'}}" class="mt-5 rounded-[16rpx] bg-panel px-4 py-7"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}" class="mt-5"><app-empty-state title="暂时无法加载背包" description="{{message}}" action-text="重新加载" bind:action="loadInventory" /></view>
  <view wx:elif="{{state === 'empty'}}" class="mt-5"><app-empty-state title="暂无卡牌" description="抽取获得的卡牌会显示在这里。" /></view>
  <view wx:else class="mt-5 grid grid-cols-2 gap-3">
    <view wx:for="{{items}}" wx:key="cardId" class="min-w-0 rounded-[16rpx] border border-line bg-panel px-4 py-4"><view class="flex items-start justify-between gap-2"><view class="min-w-0 flex-1"><view class="truncate text-[length:26rpx] font-semibold">{{item.name}}</view><view class="mt-1 truncate text-[length:19rpx] text-muted">{{item.catalogName}}</view></view><view class="shrink-0 rounded-full bg-brand px-2 py-1 text-[length:20rpx] font-semibold text-on-brand">×{{item.quantity}}</view></view><view class="mt-3 text-[length:20rpx] text-brand">稀有度：{{item.rarityLabel}}</view><view wx:if="{{item.summary}}" class="mt-2 text-[length:20rpx] leading-[1.55] text-muted">{{item.summary}}</view><view wx:if="{{item.firstAcquiredText}}" class="mt-4 border-t border-line pt-3 text-[length:18rpx] text-muted">首次获得 {{item.firstAcquiredText}}</view><view wx:if="{{item.lastAcquiredText && item.lastAcquiredText !== item.firstAcquiredText}}" class="mt-1 text-[length:18rpx] text-muted">最近获得 {{item.lastAcquiredText}}</view></view>
    <view wx:if="{{message}}" class="col-span-2 rounded-[12rpx] bg-panel px-4 py-3 text-[length:22rpx] text-danger">{{message}}</view>
  </view>
  <app-page-exit label="返回盲盒" />
</view>
