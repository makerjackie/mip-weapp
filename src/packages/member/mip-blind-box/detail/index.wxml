<view id="mip-blind-box-detail-page" class="mip-member-page min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-5 text-ink">
  <view wx:if="{{state === 'loading'}}" class="rounded-[16rpx] bg-panel px-4 py-7"><t-skeleton row-col="{{[1,1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}"><app-empty-state title="暂时无法加载盲盒" description="{{message}}" action-text="重新加载" bind:action="loadDetail" /></view>
  <block wx:else>
    <view class="flex items-start justify-between gap-4"><view class="min-w-0 flex-1"><view class="text-[length:40rpx] font-bold">{{detail.name}}</view><view wx:if="{{detail.summary}}" class="mt-2 text-[length:23rpx] leading-[1.65] text-muted">{{detail.summary}}</view></view><view class="shrink-0 rounded-full bg-brand px-3 py-2 text-[length:22rpx] font-semibold text-on-brand">{{coinBalance}} 游戏币</view></view>

    <view class="mt-5 grid grid-cols-2 gap-3">
      <view class="rounded-[16rpx] bg-panel px-4 py-4"><view class="text-[length:21rpx] text-muted">单次消耗</view><view class="mt-1 text-[length:30rpx] font-bold">{{detail.drawCostCoin}} 游戏币</view></view>
      <view class="rounded-[16rpx] bg-panel px-4 py-4"><view class="text-[length:21rpx] text-muted">当前库存</view><view class="mt-1 text-[length:30rpx] font-bold">{{detail.stockRemaining}}</view></view>
    </view>

    <view wx:if="{{drawStage === 'drawing'}}" class="draw-stage draw-stage--drawing mt-5 rounded-[20rpx] border border-brand bg-panel px-5 py-8 text-center" aria-live="polite"><view class="draw-card-shell mx-auto h-[224rpx] w-[168rpx] rounded-[18rpx] border-[3rpx] border-brand bg-brand-soft"><view class="draw-card-center mx-auto mt-[76rpx] h-[64rpx] w-[64rpx] rounded-full border-[3rpx] border-brand" /></view><view class="mt-5 text-[length:27rpx] font-semibold">正在抽取</view><view class="mt-2 text-[length:21rpx] text-muted">正在确认抽取结果</view></view>
    <view wx:elif="{{drawStage === 'result' && drawResult}}" class="draw-stage draw-stage--result mt-5 rounded-[20rpx] border border-brand bg-panel px-5 py-6 text-center" aria-live="polite">
      <view class="text-[length:21rpx] text-brand">抽取结果</view><view class="mt-3 text-[length:34rpx] font-bold">{{drawResult.card.name}}</view><view class="mt-2 text-[length:22rpx] text-muted">{{drawResult.rarityLabel}}</view><view wx:if="{{drawResult.card.summary}}" class="mt-4 text-[length:23rpx] leading-[1.65] text-muted">{{drawResult.card.summary}}</view>
      <view class="mt-5 grid grid-cols-2 gap-3 text-left"><view class="rounded-[12rpx] bg-panel-raised px-3 py-3"><view class="text-[length:19rpx] text-muted">背包数量</view><view class="mt-1 text-[length:25rpx] font-semibold">{{drawResult.inventoryQuantity}}</view></view><view class="rounded-[12rpx] bg-panel-raised px-3 py-3"><view class="text-[length:19rpx] text-muted">剩余游戏币</view><view class="mt-1 text-[length:25rpx] font-semibold">{{drawResult.balanceAfter}}</view></view></view>
      <view wx:if="{{drawResult.pityTriggered}}" class="mt-4 rounded-[12rpx] bg-brand-soft px-3 py-3 text-[length:22rpx] text-brand">本次已触发保底规则</view><view wx:if="{{drawResult.drawnText}}" class="mt-3 text-[length:19rpx] text-muted">{{drawResult.drawnText}}</view>
      <view class="mt-5 grid grid-cols-2 gap-3"><t-button block variant="outline" bind:tap="openBackpack">查看背包</t-button><t-button block theme="primary" bind:tap="drawAgain">继续抽取</t-button></view>
    </view>
    <view wx:else class="mt-5 rounded-[20rpx] border border-line bg-panel px-5 py-6">
      <view class="text-[length:28rpx] font-semibold">抽取盲盒</view><view class="mt-2 text-[length:22rpx] text-muted">完成后会显示抽取结果和库存状态。</view>
      <view class="mt-5"><t-button block theme="primary" loading="{{drawing}}" disabled="{{drawing || detail.stockRemaining <= 0 || coinBalance < detail.drawCostCoin}}" bind:tap="draw">{{detail.stockRemaining <= 0 ? '库存已用完' : coinBalance < detail.drawCostCoin ? '游戏币不足' : '使用 ' + detail.drawCostCoin + ' 游戏币抽取'}}</t-button></view>
      <view class="mt-3 flex flex-wrap gap-2 text-[length:20rpx] text-muted"><view wx:if="{{detail.dailyDrawLimit > 0}}" class="rounded-full bg-panel-raised px-3 py-1">每日最多 {{detail.dailyDrawLimit}} 次</view><view wx:if="{{detail.pityThreshold > 0}}" class="rounded-full bg-panel-raised px-3 py-1">{{detail.pityThreshold}} 次保底</view><view class="rounded-full bg-panel-raised px-3 py-1">保底最低 {{detail.pityMinRarityLabel}}</view></view>
    </view>

    <view class="mt-4 grid grid-cols-2 gap-3"><view class="flex min-h-[96rpx] items-center rounded-[16rpx] bg-panel px-4" aria-role="button" bind:tap="openBackpack"><view class="min-w-0 flex-1"><view class="text-[length:25rpx] font-semibold">卡牌背包</view><view class="mt-1 text-[length:20rpx] text-muted">查看本盲盒卡牌</view></view><t-icon name="chevron-right" size="32rpx" color="var(--color-muted)" /></view><view class="flex min-h-[96rpx] items-center rounded-[16rpx] bg-panel px-4" aria-role="button" bind:tap="openCoinEntries"><view class="min-w-0 flex-1"><view class="text-[length:25rpx] font-semibold">游戏币流水</view><view class="mt-1 text-[length:20rpx] text-muted">查看收支记录</view></view><t-icon name="chevron-right" size="32rpx" color="var(--color-muted)" /></view></view>

    <view class="mt-6 text-[length:30rpx] font-semibold">普通抽取概率</view><view class="mt-2 text-[length:21rpx] leading-[1.6] text-muted">按当前已发布且有库存的卡牌权重计算。触发保底后，只在 {{detail.pityMinRarityLabel}} 及以上的有库存卡牌中抽取。</view><view class="mt-3 flex flex-col gap-2"><view wx:for="{{detail.rarities}}" wx:key="rarity" class="flex min-h-[88rpx] items-center gap-3 rounded-[14rpx] bg-panel px-4 py-3"><view class="min-w-0 flex-1"><view class="text-[length:25rpx] font-semibold">{{item.label}}</view><view class="mt-1 text-[length:20rpx] text-muted">{{item.availableCardCount}} 种可用卡牌</view></view><view class="text-right"><view class="text-[length:23rpx] text-brand">{{item.probabilityBasisPoints / 100}}%</view><view class="mt-1 text-[length:18rpx] text-muted">权重 {{item.weight}}</view></view></view></view>

    <view class="mt-6 text-[length:30rpx] font-semibold">卡牌目录</view><view wx:if="{{detail.cards.length}}" class="mt-3 grid grid-cols-2 gap-3"><view wx:for="{{detail.cards}}" wx:key="id" class="min-w-0 rounded-[16rpx] border border-line bg-panel px-4 py-4"><view class="truncate text-[length:25rpx] font-semibold">{{item.name}}</view><view class="mt-2 text-[length:20rpx] text-brand">{{item.rarityLabel}}</view><view wx:if="{{item.summary}}" class="mt-2 text-[length:20rpx] leading-[1.55] text-muted">{{item.summary}}</view><view class="mt-3 text-[length:19rpx] text-muted">{{item.stockText}}</view></view></view><view wx:else class="mt-3 rounded-[16rpx] bg-panel px-4 py-5 text-[length:23rpx] text-muted">暂无可展示卡牌。</view>

    <view class="mt-6 text-[length:30rpx] font-semibold">游戏规则</view><view class="mt-3 whitespace-pre-wrap rounded-[16rpx] bg-panel px-4 py-4 text-[length:23rpx] leading-[1.75] text-muted">{{detail.rulesText || '暂无游戏规则说明。'}}</view>
    <view class="mt-6 text-[length:30rpx] font-semibold">兑换规则</view><view class="mt-3 whitespace-pre-wrap rounded-[16rpx] bg-panel px-4 py-4 text-[length:23rpx] leading-[1.75] text-muted">{{detail.redemptionRulesText || '暂无兑换规则说明。'}}</view>
    <view wx:if="{{message}}" class="mt-4 rounded-[12rpx] bg-panel px-4 py-3 text-[length:22rpx] text-danger">{{message}}</view>
  </block>
  <app-page-exit label="返回盲盒" />
</view>
