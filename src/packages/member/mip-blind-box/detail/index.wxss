@keyframes blind-box-draw {
  0% {
    opacity: 0.72;
    transform: scale(0.92) rotate(-2deg);
  }

  50% {
    opacity: 1;
    transform: scale(1.04) rotate(2deg);
  }

  100% {
    opacity: 0.86;
    transform: scale(0.96) rotate(0deg);
  }
}

@keyframes blind-box-reveal {
  from {
    opacity: 0;
    transform: translateY(12rpx) scale(0.98);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.draw-card-shell {
  animation: blind-box-draw 900ms ease-in-out both;
}

.draw-stage--result {
  animation: blind-box-reveal 240ms ease-out both;
}
