<view id="member-detail-page" class="min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-5 text-ink">
  <view wx:if="{{state === 'loading'}}" class="rounded-[28rpx] bg-panel px-5 py-8"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}"><app-empty-state title="无法打开成员资料" description="资料可能正在审核，请稍后重试。" action-text="重新加载" bind:action="loadMember" /></view>
  <block wx:else>
    <view class="rounded-[30rpx] bg-panel px-5 py-5">
      <view class="flex items-start gap-4">
        <image wx:if="{{member.avatarUrl}}" class="h-[176rpx] w-[176rpx] shrink-0 rounded-full bg-brand-soft" src="{{member.avatarUrl}}" mode="aspectFill" />
        <view wx:else class="flex h-[176rpx] w-[176rpx] shrink-0 items-center justify-center rounded-full bg-brand text-[length:52rpx] font-bold text-white">{{initial}}</view>
        <view class="min-w-0 flex-1 pt-1">
          <view class="flex items-start justify-between gap-2"><view class="min-w-0 flex-1"><view class="truncate text-[length:35rpx] font-bold">{{member.nickname}}</view><view class="mt-1 truncate text-[length:22rpx] text-muted">{{member.city || '城市未公开'}}</view></view><view wx:if="{{!member.isSelf}}" class="flex h-[58rpx] w-[58rpx] shrink-0 items-center justify-center rounded-full bg-canvas" bind:tap="openSafetyActions"><t-icon name="more" size="34rpx" color="var(--color-muted)" /></view></view>
          <view wx:if="{{member.organization || member.roleTitle}}" class="mt-3 line-clamp-2 text-[length:22rpx] leading-5 text-muted">{{member.organization}}{{member.organization && member.roleTitle ? ' · ' : ''}}{{member.roleTitle}}</view>
          <view class="mt-3 inline-flex rounded-full bg-brand-soft px-3 py-1 text-[length:19rpx] font-semibold text-brand">{{member.detailLocked ? '公开资料' : '同行会会员'}}</view>
        </view>
      </view>
      <view wx:if="{{member.tags.length}}" class="mt-4 flex flex-wrap gap-2"><view wx:for="{{member.tags}}" wx:key="*this" class="rounded-full bg-brand-soft px-3 py-1 text-[length:20rpx] text-brand">{{item}}</view></view>
      <view class="mt-5 flex items-center gap-6 border-t border-line pt-4">
        <view><text class="text-[length:28rpx] font-bold">{{member.followersCount}}</text><text class="ml-1 text-[length:20rpx] text-muted">关注者</text></view>
        <view><text class="text-[length:28rpx] font-bold">{{member.followingCount}}</text><text class="ml-1 text-[length:20rpx] text-muted">关注</text></view>
        <view wx:if="{{!member.isSelf}}" class="ml-auto min-w-[176rpx]"><t-button block size="small" theme="primary" variant="{{member.isFollowing ? 'outline' : 'base'}}" loading="{{followBusy}}" bind:tap="toggleFollow">{{member.isFollowing ? '已关注' : '关注'}}</t-button></view>
      </view>
    </view>
    <view class="mt-4 rounded-[26rpx] bg-panel px-5 py-5"><view class="text-[length:27rpx] font-bold">关于我</view><view class="mt-3 whitespace-pre-wrap text-[length:25rpx] leading-7 text-muted">{{member.bio || member.headline || '这位成员还没有填写公开介绍。'}}</view></view>
    <view wx:if="{{member.interests.length || member.skills.length}}" class="mt-4 rounded-[26rpx] bg-panel px-5 py-5">
      <view wx:if="{{member.interests.length}}">
        <view class="text-[length:25rpx] font-bold">想交流</view>
        <view class="mt-3 flex flex-wrap gap-2"><view wx:for="{{member.interests}}" wx:key="*this" class="rounded-full bg-canvas px-3 py-2 text-[length:21rpx] text-muted">{{item}}</view></view>
      </view>
      <view wx:if="{{member.skills.length}}" class="mt-5">
        <view class="text-[length:25rpx] font-bold">可以分享</view>
        <view class="mt-3 flex flex-wrap gap-2"><view wx:for="{{member.skills}}" wx:key="*this" class="rounded-full bg-brand-soft px-3 py-2 text-[length:21rpx] text-brand">{{item}}</view></view>
      </view>
    </view>
    <view wx:if="{{member.detailLocked}}" class="mt-4 rounded-[26rpx] border border-accent bg-[#FFF7F1] px-5 py-5"><view class="text-[length:29rpx] font-bold">更多资料仅会员可见</view><view class="mt-2 text-[length:22rpx] leading-5 text-muted">开通后可查看完整介绍并参与更多会员活动。</view><view class="mt-5"><t-button block theme="primary" bind:tap="openMembership">开通会员查看</t-button></view></view>
    <view wx:else class="mt-4 rounded-[24rpx] bg-brand-soft px-5 py-5"><view class="text-[length:27rpx] font-semibold text-brand">完整资料已解锁</view><view class="mt-2 text-[length:22rpx] leading-5 text-brand">请尊重彼此边界，在共同活动中自然认识。</view></view>
    <view wx:if="{{message}}" class="mt-4 rounded-[18rpx] bg-[#FFF0E8] px-4 py-3 text-[length:23rpx] text-[#9F4727]">{{message}}</view>
  </block>
  <app-page-exit />
</view>
