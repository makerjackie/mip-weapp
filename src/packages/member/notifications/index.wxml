<view id="member-notifications-page" class="min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-4 text-ink">
  <view wx:if="{{state === 'loading'}}" class="rounded-[28rpx] bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}"><app-empty-state title="暂时无法加载消息" description="{{message || '请稍后重试。'}}" action-text="重新加载" bind:action="loadNotifications" /></view>
  <view wx:elif="{{!items.length}}"><app-empty-state title="暂时没有新消息" description="报名、活动变更和退款结果会显示在这里。" /></view>
  <view wx:else class="overflow-hidden rounded-[26rpx] bg-panel">
    <view
      wx:for="{{items}}"
      wx:key="id"
      class="flex min-h-[138rpx] items-start gap-3 border-b border-line px-4 py-4 last:border-b-0 active:bg-panel-muted"
      data-page-path="{{item.pagePath}}"
      bind:tap="openNotification"
    >
      <view wx:if="{{item.status === 'UNREAD'}}" class="mt-2 h-[16rpx] w-[16rpx] shrink-0 rounded-full bg-accent" />
      <view wx:else class="mt-2 h-[16rpx] w-[16rpx] shrink-0 rounded-full bg-line" />
      <view class="min-w-0 flex-1">
        <view class="flex items-center justify-between gap-3">
          <view class="truncate text-[length:26rpx] font-semibold">{{item.title}}</view>
          <view class="shrink-0 text-[length:19rpx] text-muted">{{item.createdText}}</view>
        </view>
        <view class="mt-2 line-clamp-2 text-[length:22rpx] leading-5 text-muted">{{item.summary}}</view>
      </view>
      <t-icon name="chevron-right" size="34rpx" color="var(--color-muted)" />
    </view>
  </view>
  <view wx:if="{{message && state === 'ready'}}" class="mt-4 rounded-[18rpx] bg-[#FFF0E8] px-4 py-3 text-[length:23rpx] text-[#9F4727]">{{message}}</view>
  <app-page-exit />
</view>
