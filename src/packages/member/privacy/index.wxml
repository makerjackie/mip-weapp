<view id="privacy-account-page" class="mip-member-page min-h-screen bg-canvas px-[24rpx] pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-[48rpx] text-ink">
  <view wx:if="{{state === 'loading'}}" class="rounded-[24rpx] bg-panel px-5 py-7">
    <t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading />
  </view>
  <mip-empty-state wx:elif="{{state === 'error'}}" title="暂时无法加载账号状态" description="{{message}}" action-text="重新加载" bind:action="loadAccountState" />
  <view wx:elif="{{state === 'success'}}">
    <mip-empty-state title="账号已注销" description="公开资料与可撤销状态已关闭。订单、支付、退款、活动记录和审计记录按规则保留。" />
    <app-page-exit always label="返回首页" tab-url="/pages/index/index" />
  </view>
  <block wx:else>
    <view>
      <mip-section-header title="账号与安全" />
      <view class="mt-[24rpx]">
        <mip-detail-row-group>
          <mip-detail-row label="绑定手机" actionable="{{true}}" bind:tap="openBindPhone" />
          <mip-detail-row label="隐私设置" actionable="{{true}}" bind:tap="openPrivacySettings" />
        </mip-detail-row-group>
      </view>
    </view>

    <view class="mt-[48rpx]">
      <mip-section-header title="协议" />
      <view class="mt-[24rpx]">
        <mip-detail-row-group>
          <mip-detail-row label="用户使用协议" actionable="{{true}}" bind:tap="openUserAgreement" />
          <mip-detail-row label="隐私政策" actionable="{{true}}" bind:tap="openPrivacyPolicy" />
          <mip-detail-row label="会员服务协议" actionable="{{true}}" bind:tap="openMembershipAgreement" />
        </mip-detail-row-group>
      </view>
    </view>

    <view class="mt-[48rpx]">
      <mip-section-header title="资料与隐私" />
      <view class="mt-[24rpx]">
        <mip-detail-row-group>
          <mip-detail-row label="公开设置" actionable="{{true}}" bind:tap="openVisibilitySettings" />
          <mip-detail-row label="屏蔽列表" actionable="{{true}}" bind:tap="openBlockedProfiles" />
        </mip-detail-row-group>
      </view>
    </view>

    <view class="mt-[24rpx]">
      <mip-detail-row-group>
        <mip-detail-row label="团队 PK" actionable="{{true}}" bind:tap="openGame" />
        <mip-detail-row label="帮助与客服" actionable="{{true}}" bind:tap="openHelp" />
        <mip-detail-row label="互动通知" actionable="{{true}}" bind:tap="openNotificationSettings" />
        <mip-detail-row label="关于 MIP" actionable="{{true}}" bind:tap="openAbout" />
      </mip-detail-row-group>
    </view>

    <view class="mt-[48rpx]">
      <view id="privacy-sign-out">
        <t-button block size="large" theme="default" loading="{{localLogoutState === 'processing'}}" disabled="{{localLogoutState === 'confirming' || closureState !== 'idle'}}" bind:tap="signOutLocally">退出登录</t-button>
      </view>
      <view wx:if="{{message && closureState === 'idle'}}" class="mt-[16rpx] px-[24rpx] text-[24rpx] leading-[36rpx] text-danger">{{message}}</view>
      <view id="privacy-closure-card" class="mt-[16rpx]">
        <t-button block size="large" variant="text" theme="danger" disabled="{{localLogoutState !== 'idle' || closureState !== 'idle'}}" bind:tap="startAccountClosure">注销账号</t-button>
      </view>
    </view>
    <app-page-exit label="返回我的" tab-url="/pages/profile/index" />
    <t-dialog
      id="privacy-closure-dialog"
      class="privacy-closure-dialog"
      visible="{{closureState !== 'idle'}}"
      title="注销账号"
      close-btn="{{closureState !== 'processing'}}"
      close-on-overlay-click="{{closureState !== 'processing'}}"
      prevent-scroll-through
      cancel-btn="{{ { content: '取消', variant: 'outline', theme: 'default', disabled: closureState === 'processing' } }}"
      confirm-btn="{{ { content: closureState === 'processing' ? '正在注销' : '确认注销', variant: 'base', theme: 'danger', loading: closureState === 'processing', disabled: confirmationPhrase !== requiredConfirmationPhrase || closureState === 'processing' } }}"
      bind:close="cancelAccountClosure"
      bind:confirm="submitAccountClosure"
    >
      <view slot="content" class="mt-[24rpx]">
        <view class="text-[28rpx] font-medium leading-[40rpx] text-danger">注销后无法恢复，请谨慎操作。</view>
        <view class="mt-[16rpx] text-[24rpx] leading-[36rpx] text-muted">公开资料和可撤销状态将关闭；订单、支付、退款、活动和审计记录按规则保留。存在待处理订单或退款时无法注销。</view>
        <view class="mt-[24rpx] text-[26rpx] leading-[40rpx] text-ink">输入“{{requiredConfirmationPhrase}}”</view>
        <input class="mt-[16rpx] box-border block h-[88rpx] w-full max-w-full rounded-[16rpx] bg-canvas px-[24rpx] text-[28rpx] text-ink" aria-label="账号注销确认短语" value="{{confirmationPhrase}}" maxlength="20" disabled="{{closureState === 'processing'}}" bindinput="updateConfirmationPhrase" placeholder="输入确认短语" placeholder-class="privacy-closure-placeholder" />
        <view wx:if="{{message}}" class="mt-[16rpx] text-[24rpx] leading-[36rpx] text-danger" aria-live="polite">{{message}}</view>
      </view>
    </t-dialog>
  </block>
</view>
