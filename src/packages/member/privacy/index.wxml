<view id="privacy-account-page" class="mip-member-page min-h-screen bg-canvas px-6 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-4 text-ink">
  <view wx:if="{{state === 'loading'}}" class="rounded-[24rpx] bg-panel px-5 py-7">
    <t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading />
  </view>
  <mip-empty-state wx:elif="{{state === 'error'}}" title="暂时无法加载账号状态" description="{{message}}" action-text="重新加载" bind:action="loadAccountState" />
  <view wx:elif="{{state === 'success'}}">
    <mip-empty-state title="账号已注销" description="公开资料与可撤销状态已关闭。订单、支付、退款、活动记录和审计记录按规则保留。" />
    <app-page-exit always label="返回首页" tab-url="/pages/index/index" />
  </view>
  <block wx:else>
    <!-- journey-review J5-01 账号设置（figma 1728_19083）：
         「账号与安全」+「协议」两组行卡直达三级页。第二组组名帧内残留「账号与安全」，
         按语义实现为「协议」；会员服务协议三级页设计未出（QS），先占位提示。 -->
    <view class="mt-[15rpx] -mx-3">
      <mip-section-header title="账号与安全" />
      <mip-detail-row-group class="mt-[23.2rpx]">
        <mip-detail-row label="绑定手机" actionable="{{true}}" bind:tap="openBindPhone" />
        <mip-detail-row label="隐私设置" actionable="{{true}}" bind:tap="openPrivacySettings" />
      </mip-detail-row-group>
      <mip-section-header class="mt-[48rpx]" title="协议" />
      <mip-detail-row-group class="mt-[23.2rpx]">
        <mip-detail-row label="用户使用协议" actionable="{{true}}" bind:tap="openUserAgreement" />
        <mip-detail-row label="隐私政策" actionable="{{true}}" bind:tap="openPrivacyPolicy" />
        <mip-detail-row label="会员服务协议" actionable="{{true}}" bind:tap="openMembershipAgreement" />
      </mip-detail-row-group>
    </view>

    <!-- 既有区块按 journey-review 盘点保留在协议组之下（不删功能）。 -->
    <view class="mt-[48rpx] px-1 text-[length:24rpx] font-semibold text-muted">资料与隐私</view>
    <view class="mt-3 overflow-hidden rounded-[24rpx] bg-panel">
      <view class="flex min-h-[104rpx] items-center justify-between gap-4 px-5" aria-role="button" bind:tap="openVisibilitySettings">
        <view class="min-w-0 flex-1"><view class="text-[length:28rpx] font-semibold">公开设置</view><view class="mt-1 text-[length:22rpx] leading-5 text-muted">管理公开档案和个人名片的可见信息</view></view>
        <mip-icon name="chevron-down-1" size="{{16}}" color="var(--color-muted)" />
      </view>
      <view class="flex min-h-[104rpx] items-center justify-between gap-4 border-t border-line px-5" aria-role="button" bind:tap="openBlockedProfiles">
        <view class="min-w-0 flex-1"><view class="text-[length:28rpx] font-semibold">屏蔽列表</view><view class="mt-1 text-[length:22rpx] leading-5 text-muted">查看和解除已屏蔽的用户</view></view>
        <mip-icon name="chevron-down-1" size="{{16}}" color="var(--color-muted)" />
      </view>
    </view>

    <view class="mt-5 overflow-hidden rounded-[24rpx] bg-panel"><view class="flex min-h-[96rpx] items-center justify-between px-5" bind:tap="openNotificationSettings"><text class="text-[length:28rpx]">互动通知</text><mip-icon name="chevron-down-1" size="{{16}}" /></view><view class="flex min-h-[96rpx] items-center justify-between border-t border-line px-5" bind:tap="openAbout"><text class="text-[length:28rpx]">关于 MIP</text><mip-icon name="chevron-down-1" size="{{16}}" /></view></view>

    <view class="mt-7 px-1 text-[length:24rpx] font-semibold text-muted">账号</view>
    <view class="mt-3 rounded-[24rpx] border border-line bg-panel px-5 py-5">
      <view class="text-[length:28rpx] font-semibold">退出登录</view>
      <view class="mt-2 text-[length:22rpx] leading-6 text-muted">清除本机登录状态，不会删除账号或业务记录。</view>
      <view id="privacy-sign-out" class="mt-5 flex min-h-[88rpx] items-center" bind:tap="signOutLocally">
        <t-button block variant="outline" theme="danger" loading="{{localLogoutState === 'processing'}}" disabled="{{closureState === 'processing'}}">退出登录</t-button>
      </view>
    </view>
    <view id="privacy-closure-card" class="mt-5 rounded-[24rpx] border border-line bg-panel px-5 py-5">
      <view class="text-[length:28rpx] font-semibold">账号注销</view>
      <view class="mt-2 text-[length:22rpx] leading-6 text-muted">注销后无法恢复。注销前请确认没有待处理的订单或退款。</view>
      <view wx:if="{{closureState === 'idle'}}" class="mt-5"><t-button block variant="outline" theme="danger" bind:tap="startAccountClosure">注销账号</t-button></view>
      <view wx:else id="privacy-closure-processing" class="mt-5 rounded-[16rpx] bg-panel-raised px-4 py-4">
        <view class="text-[length:24rpx] font-semibold">输入“{{requiredConfirmationPhrase}}”</view>
        <input class="mt-3 block h-[88rpx] w-full max-w-full box-border rounded-[16rpx] bg-panel px-3 text-[length:24rpx]" aria-label="账号注销确认短语" value="{{confirmationPhrase}}" maxlength="20" disabled="{{closureState === 'processing'}}" bindinput="updateConfirmationPhrase" placeholder="输入确认短语" placeholder-style="color:#B3B3B3" />
        <view wx:if="{{message}}" class="mt-3 text-[length:22rpx] leading-6 text-danger">{{message}}</view>
        <view class="mt-4 flex gap-3">
          <view class="min-w-0 flex-1"><t-button block variant="outline" disabled="{{closureState === 'processing'}}" bind:tap="cancelAccountClosure">取消</t-button></view>
          <view class="min-w-0 flex-1"><t-button block theme="danger" loading="{{closureState === 'processing'}}" disabled="{{confirmationPhrase !== requiredConfirmationPhrase}}" bind:tap="submitAccountClosure">继续</t-button></view>
        </view>
      </view>
    </view>
    <app-page-exit label="返回我的" tab-url="/pages/profile/index" />
  </block>
</view>
