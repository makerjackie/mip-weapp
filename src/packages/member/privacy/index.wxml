<view id="privacy-account-page" class="mip-member-page min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-4 text-ink">
  <view wx:if="{{state === 'loading'}}" class="rounded-[24rpx] bg-panel px-5 py-7">
    <t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading />
  </view>
  <app-empty-state wx:elif="{{state === 'error'}}" title="暂时无法加载账号状态" description="{{message}}" action-text="重新加载" bind:action="loadAccountState" />
  <view wx:elif="{{state === 'success'}}">
    <app-empty-state title="账号已注销" description="公开资料与可撤销状态已关闭。订单、支付、退款、活动记录和审计记录按规则保留。" />
    <app-page-exit managed bind:exit="leavePage" />
  </view>
  <block wx:else>
    <view class="px-1">
      <view class="text-[length:22rpx] font-semibold text-accent">数据说明</view>
      <view class="mt-1 text-[length:38rpx] font-bold">隐私与账号</view>
      <view class="mt-2 text-[length:22rpx] text-muted">小程序仅在对应功能需要时处理相关信息。</view>
    </view>
    <view class="mt-5 flex flex-col gap-3">
      <view class="rounded-[24rpx] bg-panel px-5 py-5"><view class="text-[length:27rpx] font-semibold">微信账号</view><view class="mt-2 text-[length:22rpx] leading-6 text-muted">用于识别账号、会员权益和订单，不会作为公开资料展示。</view></view>
      <view class="rounded-[24rpx] bg-panel px-5 py-5"><view class="text-[length:27rpx] font-semibold">手机号</view><view class="mt-2 text-[length:22rpx] leading-6 text-muted">仅在主动授权后用于活动、支付和必要联系，不会展示给其他成员。</view></view>
      <view class="rounded-[24rpx] bg-panel px-5 py-5"><view class="text-[length:27rpx] font-semibold">支付记录</view><view class="mt-2 text-[length:22rpx] leading-6 text-muted">订单和退款记录按法律与财务要求保存，可在订单详情查看状态。</view></view>
    </view>
    <view class="mt-5 rounded-[24rpx] bg-panel px-5 py-5"><view class="text-[length:27rpx] font-semibold">公开资料范围</view><view class="mt-2 text-[length:22rpx] leading-6 text-muted">身份状态、简介、公司和组织经历可以分别设置公开范围。手机号、OpenID、订单和报名答案不会作为公开资料展示。</view><view class="mt-5"><t-button block variant="outline" theme="primary" bind:tap="openProfilePrivacy">编辑公开范围</t-button></view></view>
    <view class="mt-5 rounded-[24rpx] bg-panel px-5 py-5"><view class="text-[length:27rpx] font-semibold">屏蔽列表</view><view class="mt-2 text-[length:22rpx] leading-6 text-muted">查看并解除你主动屏蔽的用户。</view><view class="mt-5"><t-button block variant="outline" theme="primary" bind:tap="openBlockedProfiles">查看屏蔽列表</t-button></view></view>
    <view class="mt-5 rounded-[24rpx] border border-line bg-panel px-5 py-5">
      <view class="text-[length:27rpx] font-semibold">退出登录</view>
      <view class="mt-2 text-[length:22rpx] leading-6 text-muted">清除这台设备上的登录状态和用户缓存，不会删除账号或业务记录。</view>
      <view id="privacy-sign-out" class="mt-5 flex min-h-[88rpx] items-center" bind:tap="signOutLocally">
        <t-button block variant="outline" theme="danger" loading="{{localLogoutState === 'processing'}}" disabled="{{closureState === 'processing'}}">退出登录</t-button>
      </view>
    </view>
    <view class="mt-5 rounded-[24rpx] border border-line bg-panel px-5 py-5">
      <view class="text-[length:27rpx] font-semibold">账号注销</view>
      <view class="mt-2 text-[length:22rpx] leading-6 text-muted">注销后无法恢复。公开资料、发布内容和可撤销互动将关闭，手机号等直接资料会被清理。订单、支付、退款、会员权益、活动业务事实和审计记录继续保留。</view>
      <view wx:if="{{closureState === 'idle'}}" class="mt-5"><t-button block variant="outline" theme="danger" bind:tap="startAccountClosure">注销账号</t-button></view>
      <view wx:else class="mt-5 rounded-[16rpx] bg-panel-raised px-4 py-4">
        <view class="text-[length:23rpx] font-semibold">输入“{{requiredConfirmationPhrase}}”</view>
        <input class="mt-3 block h-[80rpx] w-full max-w-full box-border rounded-[12rpx] bg-panel px-3 text-[length:24rpx]" value="{{confirmationPhrase}}" maxlength="20" disabled="{{closureState === 'processing'}}" bindinput="updateConfirmationPhrase" placeholder="输入确认短语" placeholder-style="color:#A3A3A3" />
        <view wx:if="{{message}}" class="mt-3 text-[length:22rpx] leading-6 text-danger">{{message}}</view>
        <view class="mt-4 flex gap-3">
          <view class="min-w-0 flex-1"><t-button block variant="outline" disabled="{{closureState === 'processing'}}" bind:tap="cancelAccountClosure">取消</t-button></view>
          <view class="min-w-0 flex-1"><t-button block theme="danger" loading="{{closureState === 'processing'}}" disabled="{{confirmationPhrase !== requiredConfirmationPhrase}}" bind:tap="submitAccountClosure">继续</t-button></view>
        </view>
      </view>
    </view>
    <view class="mt-5 rounded-[24rpx] border border-line bg-panel px-5 py-5"><view class="text-[length:27rpx] font-semibold">其他账号请求</view><view class="mt-2 text-[length:22rpx] leading-6 text-muted">数据副本或更正请求可通过小程序客服提交。</view><button open-type="contact" bind:contact="recordCustomerServiceInteraction" class="mt-5 w-full rounded-full border border-line bg-panel-raised py-3 text-[length:24rpx] text-ink">联系小程序客服</button></view>
    <app-page-exit managed bind:exit="leavePage" />
  </block>
</view>
