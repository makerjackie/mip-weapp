.growth-hero {
  background: #fcdf03;
}

.growth-level-art {
  mix-blend-mode: screen;
}

.growth-level-scale {
  box-shadow: inset 0 10rpx 0 #040404;
}

.growth-level-track {
  box-sizing: border-box;
  display: flex;
  min-width: 100%;
  min-height: 88rpx;
  padding: 0 24rpx;
}

.growth-level-item {
  flex: 1 0 144rpx;
  min-height: 88rpx;
}
