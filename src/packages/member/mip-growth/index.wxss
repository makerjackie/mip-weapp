/* Keep the crown inside the hero while the lower body sits behind its curve. */
.growth-hero-art {
  position: absolute;
  right: 36rpx;
  bottom: -8rpx;
  width: 350rpx;
  height: 310rpx;
  pointer-events: none;
}

.growth-hero-curve {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 20rpx;
  background: var(--color-canvas);
  border-radius: 50% 50% 0 0 / 100% 100% 0 0;
}

.growth-experience-link {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  z-index: 20;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 28rpx;
  background: var(--color-brand);
  border: 2rpx solid var(--color-on-brand);
  border-radius: 9999rpx;
}

/* Latest role-flows J1-06 / J4-03: all three labels sit on one baseline. */
.growth-level-scale {
  position: relative;
  height: 64rpx;
  margin-top: 26rpx;
}

.growth-level-point {
  position: absolute;
  bottom: 0;
  display: flex;
  gap: 8rpx;
  align-items: center;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 28rpx;
  color: var(--color-brand);
  white-space: nowrap;
}

.growth-level-point--first {
  left: 36rpx;
}

.growth-level-point--middle {
  left: 50%;
  transform: translateX(-50%);
}

.growth-level-point--last {
  right: 36rpx;
}

.growth-level-lock {
  display: flex;
  align-items: center;
}

/* Source task rows are 351 x 67px, with a distinct 12px EXP label / 18px amount. */
.growth-task-card {
  box-sizing: border-box;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto 128rpx;
  gap: 24rpx;
  align-items: center;
  min-height: 134rpx;
  padding: 24rpx;
  background: var(--color-panel);
  border-radius: var(--mip-radius-card-small);
}

.growth-task-reward {
  display: flex;
  gap: 8rpx;
  align-items: baseline;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 40rpx;
  color: var(--color-brand);
  white-space: nowrap;
}

.growth-task-reward__amount {
  font-size: 36rpx;
}

.growth-task-action {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 52rpx;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 34rpx;
  border-radius: 9999rpx;
}
