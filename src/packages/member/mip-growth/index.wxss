/* Keep the crown inside the hero while the lower body sits behind its curve. */
.growth-hero-art {
  position: absolute;
  right: 36rpx;
  bottom: -8rpx;
  width: 350rpx;
  height: 310rpx;
  pointer-events: none;
}

.growth-hero-curve {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 20rpx;
  background: var(--color-canvas);
  border-radius: 50% 50% 0 0 / 100% 100% 0 0;
}

/* MIW-83：贴着弧形过渡的黄色勾边（figma 3984:8075）——超宽椭圆顶弧，中段隐入
   深色弧内、两端沉入页面底色，与 hero 曲线叠出细亮线。 */
.growth-hero-curve-line {
  position: absolute;
  bottom: -300rpx;
  left: 50%;
  width: 1600rpx;
  height: 304rpx;
  pointer-events: none;
  border-top: 3rpx solid rgb(252 223 3 / 75%);
  border-radius: 50%;
  transform: translateX(-50%);
}

/* MIW-27：按钮中心与 XP 进度条中心（py-6 48 + mt-16 + 104.2 + 28 + 7.8 + 6 = 210rpx）
   同一水平线，并较原右上角胶囊放大一档（figma 1948:14177 入口样式沿用）。 */
.growth-experience-link {
  position: absolute;
  top: 183rpx;
  right: 16rpx;
  z-index: 20;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 34rpx;
  background: transparent;
  border: 2rpx solid var(--color-on-brand);
  border-radius: 9999rpx;
}

/* MIW-83 GROWTH-05/D1（2026-10-13 恢复）：非会员头部问号箱子（figma 3984:8761）
   替代 Lv 大字位，按设计节点原值 115px（230rpx）落位——素材自带透明内边距，
   可见箱体约 87px；hero 同步加高（284→410rpx），胶囊跟随下移后的
   XP 进度条中心（48+16+230+28+7.8+6 = 335.8rpx）。 */
.growth-mystery-box {
  display: block;
  width: 230rpx;
  height: 230rpx;
}

.growth-hero--boxed .growth-experience-link {
  top: 309rpx;
}

/* MIW-83 GROWTH-01：档位横滑条（figma 3984:8403）——swiper previous/next-margin
   224rpx 让邻档标签中心落在距屏幕边约 37px 处（档距 ≈151px，与设计稿一致）。 */
.growth-tier-area {
  position: relative;
  margin-top: 16rpx;
}

.growth-tier-swiper {
  height: 64rpx;
}

.growth-tier-label {
  display: flex;
  gap: 8rpx;
  align-items: center;
  justify-content: center;
  height: 100%;
  font-weight: 600;
  color: var(--color-brand);
  white-space: nowrap;
}

.growth-tier-label--current {
  font-size: 24rpx;
  line-height: 34rpx;
}

.growth-tier-label--side {
  font-size: 20rpx;
  line-height: 28rpx;
  opacity: 0.65;
}

.growth-tier-lock {
  display: flex;
  align-items: center;
}

/* 档位条下沿的黄色轨道细线（设计稿标签行随弧线排布）。 */
.growth-tier-arc {
  position: absolute;
  top: -10rpx;
  left: 50%;
  width: 1600rpx;
  height: 310rpx;
  pointer-events: none;
  border-top: 3rpx solid rgb(252 223 3 / 35%);
  border-radius: 50%;
  transform: translateX(-50%);
}

/* MIW-83 GROWTH-02：权益面板高度随档位行数过渡（原型 .28s ease）。 */
.growth-benefits {
  overflow: hidden;
  transition: min-height 0.28s ease;
}

/* Source task rows are 351 x 67px, with a distinct 12px XP label / 18px amount. */
.growth-task-card {
  box-sizing: border-box;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto 128rpx;
  gap: 24rpx;
  align-items: center;
  min-height: 134rpx;
  padding: 24rpx;
  background: var(--color-panel);
  border-radius: var(--mip-radius-card-small);
}

.growth-task-reward {
  display: flex;
  gap: 8rpx;
  align-items: baseline;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 40rpx;
  color: var(--color-brand);
  white-space: nowrap;
}

.growth-task-reward__amount {
  font-size: 36rpx;
}

.growth-task-action {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 52rpx;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 34rpx;
  border-radius: 9999rpx;
}

/* MIW-84：SHARE 任务卡的原生转发按钮——去 WeChat button 默认样式后复用上方胶囊规格。 */
.growth-task-share {
  padding: 0;
  margin: 0;
  background: transparent;
}

.growth-task-share::after {
  border: none;
}
