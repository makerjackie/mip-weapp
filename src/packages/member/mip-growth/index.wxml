<view id="mip-growth-page" class="min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-4 text-ink">
  <view wx:if="{{state === 'loading'}}" class="rounded-[16rpx] bg-panel px-4 py-7"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}"><app-empty-state title="暂时无法加载成长记录" description="请检查网络后重试。" action-text="重新加载" bind:action="loadGrowth" /><app-page-exit /></view>
  <block wx:else>
    <view class="rounded-[16rpx] bg-panel px-4 py-5">
      <view class="flex items-start justify-between gap-3">
        <view><view class="text-[length:23rpx] text-muted">当前等级</view><view class="mt-1 text-[length:38rpx] font-bold">{{snapshot.currentLevel.name}}</view></view>
        <view class="rounded-full bg-brand px-3 py-2 text-[length:22rpx] font-semibold text-on-brand">{{snapshot.account.experienceBalance}} 经验值</view>
      </view>
      <view wx:if="{{snapshot.nextLevel}}" class="mt-5">
        <progress percent="{{snapshot.levelProgressPercent}}" stroke-width="6" activeColor="#FCDF03" backgroundColor="#363636" border-radius="6" />
        <view class="mt-2 flex justify-between text-[length:21rpx] text-muted"><text>当前 {{snapshot.currentLevel.name}}</text><text>还差 {{snapshot.experienceToNextLevel}} 经验值</text></view>
      </view>
      <view wx:else class="mt-4 text-[length:22rpx] text-muted">已达到当前最高等级。</view>
      <view wx:if="{{snapshot.currentLevel.benefits.length}}" class="mt-4 border-t border-line pt-4">
        <view class="text-[length:24rpx] font-semibold">当前权益</view>
        <view class="mt-2 flex flex-col gap-2"><view wx:for="{{snapshot.currentLevel.benefits}}" wx:key="*this" class="text-[length:22rpx] text-muted">{{item}}</view></view>
      </view>
    </view>

    <view class="mt-4 grid grid-cols-2 gap-3">
      <view class="rounded-[16rpx] bg-panel px-3 py-4 text-center"><view class="text-[length:31rpx] font-bold">{{snapshot.account.experienceBalance}}</view><view class="mt-1 text-[length:21rpx] text-muted">经验值</view></view>
      <view class="rounded-[16rpx] bg-panel px-3 py-4 text-center"><view class="text-[length:31rpx] font-bold">{{snapshot.account.contributionBalance}}</view><view class="mt-1 text-[length:21rpx] text-muted">贡献值</view></view>
    </view>
    <view class="mt-4 flex min-h-[96rpx] items-center rounded-[16rpx] bg-panel px-4" bind:tap="openTasks"><view class="flex-1"><view class="text-[length:27rpx] font-semibold">任务</view><view class="mt-1 text-[length:22rpx] text-muted">查看任务和完成状态</view></view><t-icon name="chevron-right" size="32rpx" color="var(--color-muted)" /></view>

    <view class="mt-6 text-[length:30rpx] font-bold">等级与权益</view>
    <view class="mt-3 flex flex-col gap-3">
      <view wx:for="{{levels}}" wx:key="id" class="rounded-[16rpx] border border-line bg-panel px-4 py-4">
        <view class="flex items-center justify-between gap-3"><view class="text-[length:26rpx] font-semibold">{{item.name}}</view><view wx:if="{{item.current}}" class="rounded-full bg-brand-soft px-3 py-1 text-[length:20rpx] text-brand">当前等级</view></view>
        <view class="mt-2 text-[length:20rpx] text-muted">{{item.thresholdText}}</view>
        <view wx:if="{{item.benefits.length}}" class="mt-3 flex flex-col gap-2"><view wx:for="{{item.benefits}}" wx:for-item="benefit" wx:key="*this" class="text-[length:22rpx] text-muted">{{benefit}}</view></view>
        <view wx:else class="mt-3 text-[length:21rpx] text-muted">暂未配置等级权益。</view>
      </view>
    </view>

    <view class="mt-6 text-[length:30rpx] font-bold">成长规则</view>
    <view wx:if="{{earningRules.length === 0}}" class="mt-3 rounded-[16rpx] bg-panel px-4 py-5 text-[length:22rpx] text-muted">暂无启用的成长规则。</view>
    <view wx:else class="mt-3 flex flex-col gap-3">
      <view wx:for="{{earningRules}}" wx:key="id" class="rounded-[16rpx] bg-panel px-4 py-4"><view class="flex items-center justify-between gap-3"><view class="min-w-0 flex-1 text-[length:25rpx] font-semibold">{{item.name}}</view><view class="shrink-0 text-[length:24rpx] font-semibold text-brand">{{item.deltaText}}</view></view><view class="mt-2 text-[length:21rpx] text-muted">{{item.dailyLimitText}}</view></view>
    </view>

    <view class="mt-6 text-[length:30rpx] font-bold">成长流水</view>
    <view wx:if="{{entries.length === 0}}" class="mt-3 rounded-[16rpx] bg-panel px-4 py-7 text-center text-[length:23rpx] text-muted">暂无成长记录。</view>
    <view wx:else class="mt-3 flex flex-col gap-3">
      <view wx:for="{{entries}}" wx:key="id" class="flex items-center justify-between gap-4 rounded-[16rpx] bg-panel px-4 py-4">
        <view class="min-w-0 flex-1"><view class="line-clamp-1 text-[length:25rpx] font-semibold">{{item.ruleName || item.metricLabel}}</view><view class="mt-1 text-[length:21rpx] text-muted">{{item.createdText}}</view></view>
        <view class="text-right"><view class="text-[length:28rpx] font-bold text-brand">{{item.deltaText}}</view><view class="mt-1 text-[length:20rpx] text-muted">余额 {{item.balanceAfter}}</view></view>
      </view>
    </view>
    <view wx:if="{{nextCursor}}" class="mt-4"><t-button block variant="outline" loading="{{loadingMore}}" bind:tap="loadMore">加载更多</t-button></view>
    <view wx:if="{{message}}" class="mt-4 rounded-[16rpx] bg-brand-soft px-4 py-3 text-[length:22rpx] text-brand">{{message}}</view>
    <app-page-exit />
  </block>
</view>
