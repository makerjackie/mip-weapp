<view id="mip-growth-page" class="mip-member-page min-h-screen bg-canvas pb-[calc(env(safe-area-inset-bottom)+48rpx)] text-ink">
  <view aria-label="正在加载" aria-busy="true" wx:if="{{state === 'loading'}}" class="px-3 pt-3"><view class="rounded-[16rpx] bg-panel px-4 py-7"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view></view>
  <view wx:elif="{{state === 'error'}}" class="px-3 pt-3"><mip-empty-state title="暂时无法加载成长记录" description="{{message || '服务暂时不可用，请重新加载。'}}" action-text="重新加载" bind:action="loadGrowth" /></view>
  <block wx:else>
    <!-- Keep the original illustration at its intrinsic aspect ratio; controls stay live. -->
    <view class="growth-hero relative h-[284rpx] overflow-hidden bg-brand px-5 py-6 text-on-brand">
      <image class="growth-hero-art" mode="aspectFit" src="/packages/member/assets/figma/growth/hero-character.png" />
      <view class="growth-hero-curve" />
      <!-- MIW-27：经验值详情改为跳转独立明细页（figma 1948:14177），按钮与进度条同一水平线。 -->
      <view class="growth-experience-link" aria-role="button" aria-label="经验值详情" bind:tap="openExperienceDetails">经验值详情</view>
      <view class="relative z-10 ml-[8rpx] mt-[16rpx]">
        <view class="text-[96rpx] font-bold leading-[104.2rpx]">Lv.{{currentLevelNumber}}</view>
        <view class="text-[20rpx] font-semibold leading-[28rpx]">EXP: {{snapshot.account.experienceBalance}}<text wx:if="{{nextLevelThreshold}}"> I {{nextLevelThreshold}}</text></view>
        <view wx:if="{{nextLevelThreshold}}" class="relative mt-[7.8rpx] h-[12rpx] w-[300rpx] max-w-full rounded-full bg-panel-raised">
          <view class="absolute left-[4rpx] top-[4rpx] h-[4rpx] rounded-full bg-brand" style="width:{{snapshot.levelProgressPercent}}%;max-width:calc(100% - 8rpx)" />
        </view>
        <view wx:else class="mt-[7.8rpx] text-[20rpx] leading-[28rpx] opacity-70">已达到当前最高等级</view>
        <view wx:if="{{membershipValidityText}}" class="mt-[8rpx] text-[20rpx] font-medium leading-[28rpx]">{{membershipValidityText}}</view>
        <view wx:elif="{{membershipState === 'error'}}" class="mt-[8rpx] text-[20rpx] font-medium leading-[28rpx]">会员有效期暂时无法加载</view>
      </view>
    </view>

    <!-- Latest role-flows J1-06 / J4-03: level milestones share a baseline below the curved hero. -->
    <view wx:if="{{levelScale}}" class="growth-level-scale">
      <view class="growth-level-point growth-level-point--first">{{levelScale.leftText}}</view>
      <view class="growth-level-point growth-level-point--middle">
        <view wx:if="{{levelScale.centerLocked}}" class="growth-level-lock"><mip-icon name="lock-fill" size="{{10}}" color="var(--color-brand)" /></view>
        <text>{{levelScale.centerText}}</text>
      </view>
      <view class="growth-level-point growth-level-point--last">{{levelScale.rightText}}</view>
    </view>

    <!-- figma 1948_14079: benefits panel (12,199) 351×119 — title 16px semibold at panel
         (12,12); four 40px gift circles on an 88px pitch at panel y46, labels 12px at y44. -->
    <view class="mx-3 mt-[24rpx] rounded-[16rpx] bg-panel px-3 pb-3 pt-3">
      <view class="whitespace-nowrap text-[32rpx] font-semibold leading-[44.8rpx]">可享 {{snapshot.currentLevel.benefits.length}} 项权益</view>
      <view wx:if="{{snapshot.currentLevel.benefits.length}}" class="mt-[23rpx] grid grid-cols-4 gap-x-2 gap-y-4">
        <view wx:for="{{snapshot.currentLevel.benefits}}" wx:key="*this" class="min-w-0">
          <view class="mx-auto flex h-[80rpx] w-[80rpx] items-center justify-center rounded-full bg-brand"><view class="mt-[-2rpx]"><mip-icon name="gift" color="var(--color-on-brand)" /></view></view>
          <view class="mt-[8rpx] break-words text-center text-[24rpx] font-medium leading-[33.6rpx]">{{item}}</view>
        </view>
      </view>
      <view wx:else class="mt-2 text-[24rpx] leading-[34rpx] text-muted">当前等级暂未配置权益。</view>
    </view>

    <view aria-label="正在加载" aria-busy="true" wx:if="{{tasksState === 'loading'}}" class="mx-3 mt-[24rpx] rounded-[16rpx] bg-panel px-4 py-6"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
    <view wx:elif="{{tasksState === 'error'}}" class="mx-3 mt-[24rpx] rounded-[16rpx] bg-panel px-4 py-5"><view class="text-[24rpx]">成长任务暂时无法加载</view><view class="mt-2 text-[22rpx] text-muted">{{tasksMessage}}</view><view class="mt-3 flex min-h-[88rpx] items-center text-[22rpx] text-brand" aria-role="button" bind:tap="loadTasks">重新加载</view></view>
    <view wx:elif="{{tasksState === 'empty'}}" class="mx-3 mt-[24rpx] rounded-[16rpx] bg-panel px-4 py-5 text-[22rpx] text-muted">暂无可完成的成长任务。</view>
    <view wx:else class="mx-3 mt-[24rpx] flex flex-col gap-[24rpx]">
      <!-- figma 3296:5808 经验任务卡：任务名 12px + 说明 10px + 「+ EXP N」黄字 + 右侧胶囊。 -->
      <view wx:for="{{tasks}}" wx:key="id" class="growth-task-card active:bg-panel-muted" aria-role="button" aria-label="{{item.name}}，奖励 {{item.rewardExperience}} 经验" data-id="{{item.id}}" bind:tap="openTask">
        <view class="min-w-0 flex-1">
          <view class="truncate text-[24rpx] font-medium leading-[33.6rpx]">{{item.name}}</view>
          <view wx:if="{{item.content}}" class="mt-[6rpx] truncate text-[20rpx] leading-[28rpx] text-muted">{{item.content}}</view>
        </view>
        <view class="growth-task-reward"><text>+ EXP</text><text class="growth-task-reward__amount">{{item.rewardExperience}}</text></view>
        <view wx:if="{{item.status === 'AVAILABLE'}}" class="growth-task-action border border-black bg-brand text-on-brand">{{item.actionText}}</view>
        <view wx:elif="{{item.status === 'COMPLETED'}}" class="growth-task-action bg-canvas text-brand">{{item.actionText}}</view>
        <view wx:else class="growth-task-action bg-canvas text-muted">{{item.actionText}}</view>
      </view>
    </view>

    <view wx:if="{{message}}" class="mx-3 mt-4 rounded-[16rpx] bg-brand-soft px-4 py-3 text-[22rpx] text-brand">{{message}}</view>
  </block>

  <!-- J1-06 开通态：无有效会员时底部仅「立即加入」→ 会员订单确认页（J1-07）；本页不展示金额。 -->
  <mip-sticky-actions wx:if="{{membershipState === 'guest'}}">
    <view id="growth-join-actions" slot="actions" class="flex h-[80rpx] w-full items-center px-2">
      <mip-pill-button class="w-full" label="立即加入" withIcon bind:tap="openMembershipOrder">
        <mip-icon slot="icon" name="share-circle" size="{{15}}" color="var(--color-on-brand)" />
      </mip-pill-button>
    </view>
  </mip-sticky-actions>
  <!-- MIW-27 第二轮：首笔付费审核中——只读展示，不提供再次下单入口。 -->
  <mip-sticky-actions wx:elif="{{membershipState === 'pending'}}">
    <view slot="actions" class="flex h-[80rpx] w-full items-center px-2">
      <mip-pill-button class="w-full" variant="secondary" label="入会审核中" disabled />
    </view>
  </mip-sticky-actions>
  <mip-sticky-actions wx:elif="{{membershipState === 'error'}}">
    <view slot="actions" class="flex h-[80rpx] w-full items-center px-2">
      <mip-pill-button class="w-full" variant="secondary" label="重新加载会员状态" bind:tap="loadMembershipActions" />
    </view>
  </mip-sticky-actions>

  <!-- J4-03 续费态（figma 2165:17142 / 1948:14079）：未进续费窗口时「邀请加入」独占
       全宽黄底；进入到期前 3 个月窗口后「立即续费」黄底居右，「邀请加入」退居左侧
       黑底黄字。两者都指向同一会员订单确认页（J1-07）。 -->
  <mip-sticky-actions wx:if="{{isPlayer}}">
    <view id="growth-member-actions" slot="actions" class="flex h-[80rpx] w-full items-center gap-2">
      <mip-pill-button class="{{renewWindowOpen ? 'min-w-0 flex-1' : 'w-full'}}" variant="{{renewWindowOpen ? 'secondary' : 'primary'}}" label="邀请加入" withIcon openType="share" disabled="{{!invitationReady}}">
        <mip-icon slot="icon" name="share-circle" size="{{15}}" color="{{renewWindowOpen ? 'var(--color-brand)' : 'var(--color-on-brand)'}}" />
      </mip-pill-button>
      <mip-pill-button wx:if="{{renewWindowOpen}}" class="min-w-0 flex-1" label="立即续费" withIcon bind:tap="renewMembership">
        <t-icon slot="icon" name="card" size="30rpx" color="var(--color-on-brand)" />
      </mip-pill-button>
    </view>
  </mip-sticky-actions>
  <view wx:if="{{invitationMessage && isPlayer}}" class="mip-member-fixed-inset fixed inset-x-3 bottom-[calc(env(safe-area-inset-bottom)+132rpx)] z-20 rounded-[8rpx] border border-danger bg-panel px-4 py-3 text-center text-[22rpx] text-danger">{{invitationMessage}}</view>
</view>
