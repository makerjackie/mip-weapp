<view id="mip-growth-page" class="mip-member-page min-h-screen bg-canvas pb-[calc(env(safe-area-inset-bottom)+48rpx)] text-ink">
  <view aria-label="正在加载" aria-busy="true" wx:if="{{state === 'loading'}}" class="px-3 pt-3"><view class="rounded-[16rpx] bg-panel px-4 py-7"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view></view>
  <view wx:elif="{{state === 'error'}}" class="px-3 pt-3"><mip-empty-state title="暂时无法加载成长记录" description="请检查网络后重试。" action-text="重新加载" bind:action="loadGrowth" /><app-page-exit /></view>
  <block wx:else>
    <!-- figma 1948_14079: hero = baked composite (curved yellow field + color-burn sphere +
         generated art + 经验值详情 pill, ref HTML y88-230); Lv/EXP/progress/有效期 are live
         text at figma coords — impl raw css (24,32) 48px/52.1, (24,84) 10px, (24,102) 150×6
         bar with 2px inset fill, (24,112) 10px. -->
    <view class="growth-hero relative h-[284rpx] overflow-hidden bg-brand px-5 py-6 text-on-brand">
      <image class="pointer-events-none absolute inset-0 h-full w-full" mode="scaleToFill" src="/packages/member/assets/figma/growth/hero-bg.webp" />
      <image wx:if="{{legacyLevelArtVisible}}" class="growth-level-art pointer-events-none absolute -bottom-[4rpx] -right-[300rpx] h-[240rpx] w-[1052rpx]" mode="aspectFit" src="/packages/member/assets/figma/profile/level-art.webp" />
      <view class="relative z-10 ml-[8rpx] mt-[16rpx]">
        <view class="text-[length:96rpx] font-bold leading-[104.2rpx]">Lv.{{currentLevelNumber}}</view>
        <view class="text-[length:20rpx] font-semibold leading-[28rpx]">EXP: {{snapshot.account.experienceBalance}}<text wx:if="{{nextLevelThreshold}}"> I {{nextLevelThreshold}}</text></view>
        <view wx:if="{{nextLevelThreshold}}" class="relative mt-[7.8rpx] h-[12rpx] w-[300rpx] max-w-full rounded-full bg-panel-raised">
          <view class="absolute left-[4rpx] top-[4rpx] h-[4rpx] rounded-full bg-brand" style="width:{{snapshot.levelProgressPercent}}%;max-width:calc(100% - 8rpx)" />
        </view>
        <view wx:else class="mt-[7.8rpx] text-[length:20rpx] leading-[28rpx] opacity-70">已达到当前最高等级</view>
        <view wx:if="{{membershipEndsText}}" class="mt-[8rpx] text-[length:20rpx] font-medium leading-[28rpx]">会员有效期至 {{membershipEndsText}}</view>
        <view wx:elif="{{membershipState === 'guest'}}" class="mt-[8rpx] text-[length:20rpx] font-medium leading-[28rpx]">当前没有有效会员权益</view>
        <view wx:elif="{{membershipState === 'error'}}" class="mt-[8rpx] text-[length:20rpx] font-medium leading-[28rpx]">会员有效期暂时无法加载</view>
      </view>
    </view>

    <!-- figma 1948_14079: static three-point level scale (Lv.1 left / locked middle milestone
         centered on the page / Lv.N right), markers bottom-aligned at impl raw y187. -->
    <view wx:if="{{levelScale}}" class="relative mt-[26rpx] h-[64rpx]">
      <view class="absolute bottom-0 left-[36rpx] whitespace-nowrap text-[length:20rpx] font-semibold leading-[28rpx] text-brand">{{levelScale.leftText}}</view>
      <view class="absolute left-1/2 top-[30rpx] flex -translate-x-1/2 items-start">
        <view wx:if="{{levelScale.centerLocked}}" class="mr-[11rpx] mt-[8rpx]"><mip-icon name="lock-fill" color="var(--color-brand)" /></view>
        <view class="whitespace-nowrap text-[length:24rpx] font-semibold leading-[33.6rpx] text-brand">{{levelScale.centerText}}</view>
      </view>
      <view class="absolute bottom-0 right-[36rpx] whitespace-nowrap text-[length:20rpx] font-semibold leading-[28rpx] text-brand">{{levelScale.rightText}}</view>
    </view>

    <!-- figma 1948_14079: benefits panel (12,199) 351×119 — title 16px semibold at panel
         (12,12); four 40px gift circles on an 88px pitch at panel y46, labels 12px at y44. -->
    <view class="mx-3 mt-[24rpx] h-[238rpx] overflow-hidden rounded-[16rpx] bg-panel px-3 pt-3">
      <view class="whitespace-nowrap text-[length:32rpx] font-semibold leading-[44.8rpx]">可享 {{snapshot.currentLevel.benefits.length}} 项权益</view>
      <view wx:if="{{snapshot.currentLevel.benefits.length}}" class="mt-[23rpx] flex justify-between pl-[16rpx] pr-[14rpx]">
        <view wx:for="{{snapshot.currentLevel.benefits}}" wx:key="*this" class="w-[96rpx]">
          <view class="mx-auto flex h-[80rpx] w-[80rpx] items-center justify-center rounded-full bg-brand"><view class="mt-[-2rpx]"><mip-icon name="gift" color="var(--color-on-brand)" /></view></view>
          <view class="mt-[8rpx] text-center text-[length:24rpx] font-medium leading-[33.6rpx]">{{item}}</view>
        </view>
      </view>
      <view wx:else class="mt-2 text-[length:22rpx] text-muted">当前等级暂未配置权益。</view>
    </view>

    <!-- figma 1948_14079: task cards 351×67 on a 12px gap, first top at impl raw y330;
         line1 12px medium (12,14), line2 10px white (12,32), + EXP 16/12/16 brand (169,23),
         pill button 64×25 at (275,21). -->
    <view aria-label="正在加载" aria-busy="true" wx:if="{{tasksState === 'loading'}}" class="mx-3 mt-[24rpx] rounded-[16rpx] bg-panel px-4 py-6"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
    <view wx:elif="{{tasksState === 'error'}}" class="mx-3 mt-[24rpx] rounded-[16rpx] bg-panel px-4 py-5"><view class="text-[length:24rpx]">成长任务暂时无法加载</view><view class="mt-2 text-[length:22rpx] text-muted">{{tasksMessage}}</view><view class="mt-3 flex min-h-[88rpx] items-center text-[length:22rpx] text-brand" aria-role="button" bind:tap="loadTasks">重新加载</view></view>
    <view wx:elif="{{tasksState === 'empty'}}" class="mx-3 mt-[24rpx] rounded-[16rpx] bg-panel px-4 py-5 text-[length:22rpx] text-muted">暂无可完成的成长任务。</view>
    <view wx:else class="mx-3 mt-[24rpx] flex flex-col gap-[24rpx]">
      <view wx:for="{{tasks}}" wx:key="id" class="relative h-[134rpx] rounded-[16rpx] bg-panel active:bg-panel-muted" aria-role="button" aria-label="查看任务 {{item.name}}" data-id="{{item.id}}" bind:tap="openTask">
        <view class="absolute left-[24rpx] top-[28rpx] max-w-[270rpx] truncate text-[length:24rpx] font-medium leading-[33.6rpx]">{{item.name}}</view>
        <view class="absolute left-[24rpx] top-[64rpx] max-w-[270rpx] truncate text-[length:20rpx] leading-[28rpx]">{{item.content}}</view>
        <view class="absolute left-[338rpx] top-[46rpx] whitespace-nowrap text-[length:32rpx] font-medium leading-[44.8rpx] text-brand">+ <text class="text-[length:24rpx]">EXP</text> {{item.rewardExperience}}</view>
        <view wx:if="{{item.status === 'AVAILABLE'}}" class="absolute right-[24rpx] top-[42rpx] flex h-[50rpx] w-[128rpx] items-center justify-center rounded-full bg-brand text-[length:24rpx] font-medium text-on-brand">{{item.actionText}}</view>
        <view wx:else class="absolute right-[24rpx] top-[42rpx] flex h-[50rpx] w-[128rpx] items-center justify-center rounded-full bg-canvas text-[length:24rpx] font-medium text-brand">{{item.actionText}}</view>
      </view>
    </view>

    <view class="mx-3 mt-6 flex min-h-[88rpx] items-center justify-between gap-3"><view class="text-[length:30rpx] font-bold">成长任务</view><view class="flex min-h-[88rpx] items-center text-[length:22rpx] text-muted" aria-role="button" aria-label="查看全部成长任务" bind:tap="openTasks">全部任务<mip-icon name="chevron-down-1" size="{{15}}" color="var(--color-muted)" /></view></view>
    <view class="mx-3 mt-4 grid grid-cols-3 gap-3">
      <view class="rounded-[16rpx] bg-panel px-3 py-4 text-center"><view class="text-[length:32rpx] font-bold">{{snapshot.account.experienceBalance}}</view><view class="mt-1 text-[length:22rpx] text-muted">经验值</view></view>
      <view class="rounded-[16rpx] bg-panel px-3 py-4 text-center"><view class="text-[length:32rpx] font-bold">{{snapshot.account.contributionBalance}}</view><view class="mt-1 text-[length:22rpx] text-muted">贡献值</view></view>
      <view class="rounded-[16rpx] bg-panel px-3 py-4 text-center"><view class="text-[length:32rpx] font-bold">{{snapshot.account.coinBalance}}</view><view class="mt-1 text-[length:22rpx] text-muted">游戏币</view></view>
    </view>

    <view class="mx-3 mt-6 text-[length:30rpx] font-bold">等级与权益</view>
    <view class="mx-3 mt-3 flex flex-col gap-3">
      <view wx:for="{{levels}}" wx:key="id" class="rounded-[16rpx] border border-line bg-panel px-4 py-4">
        <view class="flex items-center justify-between gap-3"><view class="text-[length:24rpx] font-semibold">{{item.name}}</view><view wx:if="{{item.current}}" class="rounded-full bg-brand-soft px-3 py-1 text-[length:22rpx] text-brand">当前等级</view></view>
        <view class="mt-2 text-[length:22rpx] text-muted">{{item.thresholdText}}</view>
        <view wx:if="{{item.benefits.length}}" class="mt-3 flex flex-col gap-2"><view wx:for="{{item.benefits}}" wx:for-item="benefit" wx:key="*this" class="text-[length:22rpx] text-muted">{{benefit}}</view></view>
        <view wx:else class="mt-3 text-[length:22rpx] text-muted">暂未配置等级权益。</view>
      </view>
    </view>

    <view class="mx-3 mt-6 text-[length:30rpx] font-bold">成长规则</view>
    <view wx:if="{{earningRules.length === 0}}" class="mx-3 mt-3 rounded-[16rpx] bg-panel px-4 py-5 text-[length:22rpx] text-muted">暂无启用的成长规则。</view>
    <view wx:else class="mx-3 mt-3 flex flex-col gap-3">
      <view wx:for="{{earningRules}}" wx:key="id" class="rounded-[16rpx] bg-panel px-4 py-4"><view class="flex items-center justify-between gap-3"><view class="min-w-0 flex-1 text-[length:24rpx] font-semibold">{{item.name}}</view><view class="shrink-0 text-[length:24rpx] font-semibold text-brand">{{item.deltaText}}</view></view><view class="mt-2 text-[length:22rpx] text-muted">{{item.dailyLimitText}}</view></view>
    </view>

    <view class="mx-3 mt-6 text-[length:30rpx] font-bold">成长流水</view>
    <view wx:if="{{entries.length === 0}}" class="mx-3 mt-3 rounded-[16rpx] bg-panel px-4 py-7 text-center text-[length:24rpx] text-muted">暂无成长记录。</view>
    <view wx:else class="mx-3 mt-3 flex flex-col gap-3">
      <view wx:for="{{entries}}" wx:key="id" class="flex items-center justify-between gap-4 rounded-[16rpx] bg-panel px-4 py-4">
        <view class="min-w-0 flex-1"><view class="line-clamp-1 text-[length:24rpx] font-semibold">{{item.ruleName || item.metricLabel}}</view><view class="mt-1 text-[length:22rpx] text-muted">{{item.createdText}}</view></view>
        <view class="text-right"><view class="text-[length:28rpx] font-bold text-brand">{{item.deltaText}}</view><view class="mt-1 text-[length:22rpx] text-muted">余额 {{item.balanceAfter}}</view></view>
      </view>
    </view>
    <view wx:if="{{nextCursor}}" class="mx-3 mt-4"><t-button block variant="outline" loading="{{loadingMore}}" bind:tap="loadMore">加载更多</t-button></view>
    <view wx:if="{{message}}" class="mx-3 mt-4 rounded-[16rpx] bg-brand-soft px-4 py-3 text-[length:22rpx] text-brand">{{message}}</view>
    <view class="mx-3"><app-page-exit /></view>
  </block>

  <mip-sticky-actions wx:if="{{isPlayer}}">
    <view id="growth-member-actions" slot="actions" class="flex h-[112rpx] w-full items-center gap-2 rounded-full border border-brand bg-brand-soft p-2">
      <button open-type="share" disabled="{{!invitationReady}}" class="m-0 flex h-[88rpx] min-w-0 flex-1 items-center justify-center gap-2 rounded-full border border-line bg-panel p-0 text-[length:24rpx] font-semibold leading-[88rpx] text-brand disabled:opacity-50" aria-label="邀请加入 MIP"><mip-icon name="share-circle" size="{{15}}" color="var(--color-brand)" /><text>邀请加入</text></button>
      <button class="m-0 flex h-[88rpx] min-w-0 flex-1 items-center justify-center gap-2 rounded-full border-0 bg-brand p-0 text-[length:24rpx] font-semibold leading-[88rpx] text-on-brand active:bg-brand-active" aria-label="进入会员方案续费" bind:tap="renewMembership"><t-icon name="card" size="30rpx" color="var(--color-on-brand)" /><text>立即续费</text></button>
    </view>
  </mip-sticky-actions>
  <view wx:if="{{invitationMessage && isPlayer}}" class="mip-member-fixed-inset fixed inset-x-3 bottom-[calc(env(safe-area-inset-bottom)+132rpx)] z-20 rounded-[8rpx] border border-danger bg-panel px-4 py-3 text-center text-[length:22rpx] text-danger">{{invitationMessage}}</view>
</view>
