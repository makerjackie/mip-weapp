<view id="mip-opportunity-matching-page" class="min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-4 text-ink">
  <view class="flex items-center justify-between"><view><view class="text-[length:36rpx] font-bold">机会撮合</view><view class="mt-1 text-[length:22rpx] text-muted">基于公开的合作角色、标签和城市分会生成推荐。</view></view><view class="text-[length:22rpx] text-brand" bind:tap="openSettings">权限设置</view></view>
  <view wx:if="{{state === 'loading'}}" class="mt-5 rounded-[16rpx] bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}" class="mt-5"><app-empty-state title="暂时无法加载机会撮合" description="{{message || '请检查网络后重试。'}}" action-text="重新加载" bind:action="load" /></view>
  <block wx:elif="{{requestId}}">
    <view class="mt-5 grid grid-cols-2 overflow-hidden rounded-[14rpx] bg-panel text-center text-[length:24rpx]"><view class="py-3 {{tab === 'TALENT' ? 'bg-brand text-on-brand' : 'text-muted'}}" data-tab="TALENT" bind:tap="changeTab">人才推荐</view><view class="py-3 {{tab === 'PROJECT' ? 'bg-brand text-on-brand' : 'text-muted'}}" data-tab="PROJECT" bind:tap="changeTab">项目推荐</view></view>
    <view wx:if="{{!results.length}}" class="mt-5"><app-empty-state title="暂无符合阈值的推荐" description="可调整机会标签后重新生成。" /></view>
    <view wx:else class="mt-5 flex flex-col gap-3">
      <view wx:for="{{results}}" wx:key="candidateRef" class="rounded-[16rpx] bg-panel px-4 py-4">
        <view data-ref="{{item.candidateRef}}" data-type="{{item.type}}" bind:tap="openCandidate">
          <view class="flex items-center justify-between"><view class="text-[length:27rpx] font-semibold">{{item.type === 'TALENT' ? item.talent.nickname : item.project.title}}</view><view class="rounded-full bg-brand-soft px-3 py-1 text-[length:20rpx] text-brand">匹配度 {{item.score}}</view></view>
          <view wx:if="{{item.type === 'TALENT' && item.talent.headline}}" class="mt-2 text-[length:22rpx] text-muted">{{item.talent.headline}}</view><view wx:if="{{item.type === 'PROJECT'}}" class="mt-2 text-[length:22rpx] text-muted">{{item.project.valueSummary}}</view>
          <view class="mt-3 rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:21rpx] text-muted">推荐依据：{{item.explanationText}}</view>
        </view>
        <view class="mt-3 flex items-center justify-between border-t border-line pt-3 text-[length:21rpx]"><text class="text-muted">{{item.feedbackText || '这条推荐是否相关'}}</text><view class="flex gap-4"><text class="text-brand" data-ref="{{item.candidateRef}}" data-type="{{item.type}}" data-feedback="HELPFUL" bind:tap="giveFeedback">有帮助</text><text class="text-muted" data-ref="{{item.candidateRef}}" data-type="{{item.type}}" data-feedback="NOT_RELEVANT" bind:tap="giveFeedback">不相关</text></view></view>
      </view>
    </view>
    <view wx:if="{{nextCursor}}" class="mt-4"><t-button block variant="outline" loading="{{loadingMore}}" bind:tap="loadMore">加载更多</t-button></view>
  </block>
  <block wx:else>
    <view class="mt-6 text-[length:28rpx] font-semibold">选择已发布机会</view>
    <view wx:if="{{!opportunities.length}}" class="mt-3"><app-empty-state title="暂无已发布机会" description="发布机会后可生成撮合推荐。" /></view>
    <view wx:else class="mt-3 flex flex-col gap-3"><view wx:for="{{opportunities}}" wx:key="id" class="rounded-[16rpx] bg-panel px-4 py-4"><view class="text-[length:26rpx] font-semibold">{{item.title}}</view><view class="mt-2 text-[length:21rpx] text-muted">{{item.targetSummary}}</view><view class="mt-3"><t-button size="small" theme="primary" data-id="{{item.id}}" loading="{{creatingId === item.id}}" bind:tap="createRecommendation">生成推荐</t-button></view></view></view>
    <view wx:if="{{requests.length}}" class="mt-7 text-[length:28rpx] font-semibold">历史结果</view><view class="mt-3 flex flex-col gap-3"><view wx:for="{{requests}}" wx:key="id" class="rounded-[16rpx] bg-panel px-4 py-4" data-id="{{item.id}}" bind:tap="openRequest"><view class="flex items-center justify-between"><view class="text-[length:24rpx] font-semibold">{{item.sourceOpportunity.title}}</view><t-icon name="chevron-right" size="28rpx" color="var(--color-muted)" /></view><view class="mt-2 text-[length:21rpx] text-muted">{{item.resultCount}} 条推荐 · {{item.provider === 'EXTERNAL' ? '外部模型排序' : '本地规则排序'}}</view></view></view>
  </block>
  <view wx:if="{{message && state !== 'error'}}" class="mt-4 rounded-[16rpx] bg-brand-soft px-4 py-3 text-[length:22rpx] text-brand">{{message}}</view>
  <app-page-exit label="返回机会" />
</view>
