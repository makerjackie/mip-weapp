<view id="member-registrations-page" class="min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-4 text-ink">
  <view class="px-1"><view class="text-[length:22rpx] font-semibold text-accent">活动凭证</view><view class="mt-1 text-[length:38rpx] font-bold">我的活动</view></view>
  <view wx:if="{{state === 'loading'}}" class="mt-5 rounded-[28rpx] bg-panel px-5 py-8"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}" class="mt-5"><app-empty-state title="暂时无法加载活动" description="服务暂时没有响应，请稍后重试。" action-text="重新加载" bind:action="loadItems" /></view>
  <view wx:elif="{{items.length === 0}}" class="mt-5"><app-empty-state title="还没有报名活动" description="报名成功的活动会集中出现在这里。" /></view>
  <view wx:else class="mt-5 flex flex-col gap-3">
    <view wx:for="{{items}}" wx:key="id" data-event-id="{{item.eventId}}" data-status="{{item.registrationState}}" class="rounded-[26rpx] bg-panel px-5 py-5 active:opacity-70" bind:tap="openRegistration">
      <view class="flex items-start justify-between gap-3">
        <view class="min-w-0 flex-1">
          <view class="truncate text-[length:29rpx] font-bold">{{item.title}}</view>
          <view class="mt-2 text-[length:22rpx] text-muted">{{item.startsText}}</view>
          <view class="mt-1 text-[length:22rpx] text-muted">{{item.location}}</view>
          <view wx:if="{{item.reasonText}}" class="mt-2 text-[length:20rpx] leading-5 text-muted">{{item.reasonText}}</view>
        </view>
        <view wx:if="{{item.cancelledByType === 'EVENT' || item.eventState === 'CANCELLED'}}" class="rounded-full bg-[#FFF0E8] px-3 py-1 text-[length:20rpx] font-semibold text-[#9F4727]">{{item.statusText}}</view>
        <view wx:else class="rounded-full bg-brand-soft px-3 py-1 text-[length:20rpx] font-semibold text-brand">{{item.statusText}}</view>
      </view>
      <view class="mt-4 flex items-center justify-end gap-1 border-t border-line pt-3 text-[length:22rpx] font-semibold text-brand">
        {{item.registrationState === 'REGISTERED' || item.registrationState === 'ATTENDED' || item.registrationState === 'CANCELLATION_PENDING' ? '查看凭证' : '查看活动'}}
        <t-icon name="chevron-right" size="34rpx" color="var(--color-brand)" />
      </view>
    </view>
  </view>
  <view wx:if="{{message && state !== 'error'}}" class="mt-4 rounded-[18rpx] bg-[#FFF0E8] px-4 py-3 text-[length:23rpx] text-[#9F4727]">{{message}}</view>
  <app-page-exit />
</view>
