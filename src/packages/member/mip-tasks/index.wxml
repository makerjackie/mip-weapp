<view id="mip-tasks-page" class="mip-member-page min-h-screen bg-canvas px-3 pb-[calc(env(safe-area-inset-bottom)+48rpx)] text-ink">
  <view class="-mx-3 flex border-b border-line bg-canvas px-3">
    <view class="mip-tasks-tab flex min-h-[88rpx] flex-1 items-center justify-center border-b-[4rpx] border-brand text-[length:28rpx] text-brand">我的任务</view>
    <view wx:if="{{canDispatch}}" class="mip-tasks-tab flex min-h-[88rpx] flex-1 items-center justify-center border-b-[4rpx] border-transparent text-[length:28rpx] text-muted" aria-role="button" bind:tap="openDispatch">派发任务</view>
  </view>
  <view class="mt-3 flex gap-2">
    <view class="mip-tasks-filter flex min-h-[88rpx] items-center" data-filter="pending" bind:tap="chooseFilter"><view class="flex min-h-[56rpx] items-center rounded-[12rpx] px-3 text-[length:24rpx] {{filter === 'pending' ? 'bg-brand text-on-brand' : 'bg-panel text-muted'}}">待完成</view></view>
    <view class="mip-tasks-filter flex min-h-[88rpx] items-center" data-filter="ended" bind:tap="chooseFilter"><view class="flex min-h-[56rpx] items-center rounded-[12rpx] px-3 text-[length:24rpx] {{filter === 'ended' ? 'bg-brand text-on-brand' : 'bg-panel text-muted'}}">已结束</view></view>
  </view>
  <view wx:if="{{state === 'loading'}}" class="mt-5 rounded-[16rpx] bg-panel px-4 py-6"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}" class="mt-5"><app-empty-state title="暂时无法加载任务" description="{{message}}" action-text="重新加载" bind:action="loadTasks" /></view>
  <view wx:elif="{{state === 'empty' || (state === 'ready' && visibleTasks.length === 0)}}" class="mt-5"><app-empty-state title="{{filter === 'ended' ? '暂无已结束任务' : '暂无待完成任务'}}" description="{{filter === 'ended' ? '已结束的任务会显示在这里。' : '当前没有需要完成的任务。'}}" /></view>
  <view wx:else class="mt-3 flex flex-col gap-3">
    <view wx:for="{{visibleTasks}}" wx:key="id" class="mip-task-card overflow-hidden rounded-[8rpx] bg-panel" data-id="{{item.id}}" bind:tap="openTask">
      <view class="px-3 py-3">
        <view class="flex items-center justify-between gap-3">
          <view class="mip-task-stars flex gap-1" aria-label="任务奖励"><t-icon wx:for="{{item.starIndexes}}" wx:key="*this" name="star-filled" size="32rpx" color="var(--color-brand)" /></view>
          <view class="text-[length:22rpx] text-brand">+{{item.rewardExperience}} EXP</view>
        </view>
        <view class="mt-2 flex items-center justify-between gap-3"><view class="min-w-0 flex-1 truncate text-[length:30rpx] font-medium">{{item.name}}</view><view class="shrink-0 rounded-[8rpx] bg-brand-soft px-2 py-1 text-[length:20rpx] text-brand">{{item.statusText}}</view></view>
        <view class="mt-2 flex items-center gap-2 text-[length:22rpx] text-ink"><t-icon name="time" size="28rpx" color="var(--color-ink)" /><text>{{item.deadlineText}}</text></view>
        <view class="mt-1 flex items-center gap-2 text-[length:22rpx] text-ink"><t-icon name="file" size="28rpx" color="var(--color-ink)" /><text class="min-w-0 truncate">{{item.attachmentText}}</text></view>
      </view>
    </view>
  </view>
  <view wx:if="{{nextCursor}}" class="mt-4"><t-button block variant="outline" loading="{{loadingMore}}" bind:tap="loadMore">加载更多</t-button></view>
  <view wx:if="{{message && state === 'ready'}}" class="mt-4 rounded-[12rpx] bg-panel px-4 py-3 text-[length:22rpx] text-danger">{{message}}</view>
  <app-page-exit />
</view>
