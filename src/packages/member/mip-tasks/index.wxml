<view id="mip-tasks-page" class="min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-4 text-ink">
  <view class="text-[length:38rpx] font-bold">任务</view>
  <view class="mt-2 text-[length:23rpx] text-muted">完成已发布任务并查看奖励状态</view>
  <view wx:if="{{state === 'loading'}}" class="mt-5 rounded-[16rpx] bg-panel px-4 py-6"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}" class="mt-5"><app-empty-state title="暂时无法加载任务" description="{{message}}" action-text="重新加载" bind:action="loadTasks" /></view>
  <view wx:elif="{{state === 'empty'}}" class="mt-5"><app-empty-state title="暂无任务" description="已发布的任务会显示在这里。" /></view>
  <view wx:else class="mt-5 flex flex-col gap-3">
    <view wx:for="{{tasks}}" wx:key="id" class="rounded-[16rpx] bg-panel px-4 py-4" data-id="{{item.id}}" bind:tap="openTask">
      <view class="flex items-start justify-between gap-3"><view class="min-w-0 flex-1 text-[length:28rpx] font-semibold">{{item.name}}</view><view class="shrink-0 rounded-full bg-brand-soft px-3 py-1 text-[length:20rpx] text-brand">{{item.statusText}}</view></view>
      <view class="mt-2 line-clamp-2 text-[length:23rpx] leading-[1.65] text-muted">{{item.content}}</view>
      <view class="mt-3 flex flex-wrap gap-3 text-[length:21rpx] text-muted"><text>{{item.deadlineText}}</text><text>{{item.hasTemplate ? '提供任务模板' : '无任务模板'}}</text></view><view class="mt-3 flex items-center justify-between border-t border-line pt-3"><view class="text-[length:22rpx] text-brand">+{{item.rewardExperience}} 经验值</view><view class="flex items-center text-[length:21rpx] text-muted"><text>{{item.attachmentRequired ? '需要图片附件' : '无需附件'}}</text><t-icon name="chevron-right" size="28rpx" color="var(--color-muted)" /></view></view>
    </view>
  </view>
  <view wx:if="{{nextCursor}}" class="mt-4"><t-button block variant="outline" loading="{{loadingMore}}" bind:tap="loadMore">加载更多</t-button></view>
  <view wx:if="{{message && state === 'ready'}}" class="mt-4 rounded-[12rpx] bg-panel px-4 py-3 text-[length:22rpx] text-danger">{{message}}</view>
  <app-page-exit />
</view>
