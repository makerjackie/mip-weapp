<view id="event-detail-page" class="min-h-screen bg-panel pb-[calc(env(safe-area-inset-bottom)+170rpx)] text-ink">
  <view wx:if="{{state === 'loading'}}" class="mx-4 mt-4 rounded-[28rpx] bg-panel px-5 py-8"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}" class="mx-4 mt-4"><app-empty-state title="无法打开活动" description="活动可能已下线，请稍后重试。" action-text="重新加载" bind:action="loadEvent" /></view>
  <block wx:else>
    <view class="relative">
      <image wx:if="{{event.coverUrl}}" class="h-[320rpx] w-full bg-brand-soft" mode="aspectFill" src="{{event.coverUrl}}" />
      <view wx:else class="flex h-[260rpx] w-full items-end bg-brand px-5 pb-6 text-[length:32rpx] font-bold text-white">同行会活动</view>
    </view>

    <view class="px-4 pt-3">
      <view class="text-[length:21rpx] font-semibold tracking-[0.08em] text-accent">{{startsText}}</view>
      <view class="mt-1 text-[length:36rpx] font-bold leading-[1.22]">{{event.title}}</view>
      <view class="mt-2 flex flex-wrap gap-2">
        <view wx:for="{{featureTags}}" wx:key="*this" class="bg-canvas px-2 py-1 text-[length:19rpx] text-muted">{{item}}</view>
      </view>

      <view wx:if="{{bannerTitle && bannerTone === 'event'}}" class="mt-3 border-l-[6rpx] border-accent bg-[#FFF0E8] px-3 py-2">
        <view class="text-[length:22rpx] font-semibold text-[#9F4727]">{{bannerTitle}}</view>
        <view class="mt-1 text-[length:20rpx] leading-5 text-[#9F4727]">{{bannerDetail}}</view>
      </view>
      <view wx:elif="{{bannerTitle}}" class="mt-3 border-l-[6rpx] border-brand bg-brand-soft px-3 py-2">
        <view class="text-[length:22rpx] font-semibold text-brand">{{bannerTitle}}</view>
        <view class="mt-1 text-[length:20rpx] leading-5 text-muted">{{bannerDetail}}</view>
      </view>
      <view wx:if="{{event.registrationState === 'WAITLISTED'}}" class="mt-3 border-l-[6rpx] border-brand bg-brand-soft px-3 py-2 text-[length:21rpx] leading-5 text-brand">{{event.waitlistPosition ? '当前候补第 ' + event.waitlistPosition + ' 位，有空位后会自动补位。' : '已进入候补，有空位后会按顺序补位。'}}</view>
      <view wx:elif="{{event.registrationState === 'REJECTED'}}" class="mt-3 border-l-[6rpx] border-accent bg-[#FFF0E8] px-3 py-2 text-[length:21rpx] leading-5 text-[#9F4727]">本次报名未通过{{event.reviewReason ? '：' + event.reviewReason : ''}}</view>

      <view class="mt-3 border-y border-line">
        <view class="flex min-h-[64rpx] items-center gap-3 border-b border-line py-1">
          <t-icon name="time" size="31rpx" color="var(--color-muted)" />
          <view class="min-w-0 flex-1 text-[length:23rpx] font-semibold leading-5">{{eventPeriodText}}</view>
        </view>
        <view class="flex min-h-[64rpx] items-center gap-3 border-b border-line py-1" bind:tap="openMap">
          <t-icon name="location" size="31rpx" color="var(--color-muted)" />
          <view class="min-w-0 flex-1"><view class="line-clamp-1 text-[length:23rpx] font-semibold">{{locationTitle}}</view><view wx:if="{{locationDetail}}" class="mt-1 line-clamp-1 text-[length:19rpx] text-muted">{{locationDetail}}</view></view>
          <t-icon wx:if="{{event.address}}" name="chevron-right" size="34rpx" color="var(--color-muted)" />
        </view>
        <view class="flex min-h-[64rpx] items-center gap-3 border-b border-line py-1">
          <t-icon name="usergroup" size="31rpx" color="var(--color-muted)" />
          <view class="min-w-0 flex-1 text-[length:23rpx] font-semibold">{{event.registrationCount}} 人报名</view>
          <view class="shrink-0 text-[length:21rpx] font-semibold text-accent">{{availabilityText}}</view>
        </view>
        <view class="flex min-h-[64rpx] items-center gap-3 py-1">
          <t-icon name="money" size="31rpx" color="var(--color-muted)" />
          <view class="min-w-0 flex-1 text-[length:23rpx] font-semibold">费用 {{priceText}}</view>
          <view class="shrink-0 text-[length:19rpx] text-muted">截止 {{deadlineText}}</view>
        </view>
      </view>

      <view class="border-b border-line">
        <view class="flex min-h-[92rpx] items-center justify-between py-2 active:bg-panel-muted" bind:tap="openParticipants">
          <view>
            <view class="text-[length:26rpx] font-bold">{{event.registrationCount}} 人已报名</view>
            <view class="mt-1 text-[length:20rpx] text-muted">仅展示同意公开资料的成员</view>
          </view>
          <view class="flex items-center">
            <view wx:if="{{event.participantPreview.length}}" class="mr-2 flex flex-row-reverse">
              <block wx:for="{{event.participantPreview}}" wx:key="id">
                <image wx:if="{{item.avatarUrl}}" class="-ml-3 h-[58rpx] w-[58rpx] rounded-full border-[4rpx] border-panel bg-brand-soft" mode="aspectFill" src="{{item.avatarUrl}}" />
                <view wx:else class="-ml-3 flex h-[58rpx] w-[58rpx] items-center justify-center rounded-full border-[4rpx] border-panel bg-brand-soft"><t-icon name="user-avatar" size="30rpx" color="var(--color-brand)" /></view>
              </block>
            </view>
            <t-icon name="chevron-right" size="34rpx" color="var(--color-brand)" />
          </view>
        </view>
        <view wx:if="{{event.participantPreview.length}}" class="pb-3 text-[length:20rpx] leading-5 text-muted">
          {{event.participantPreview[0].nickname}}{{event.visibleParticipantCount > 1 ? ' 等 ' + event.visibleParticipantCount + ' 位成员已公开介绍' : ' 已公开介绍'}}
        </view>
      </view>

      <view wx:if="{{event.organizer}}" class="flex min-h-[108rpx] items-center gap-3 border-b border-line py-3 active:bg-panel-muted" bind:tap="openOrganizer">
        <image wx:if="{{event.organizer.avatarUrl}}" class="h-[72rpx] w-[72rpx] shrink-0 rounded-full bg-brand-soft" mode="aspectFill" src="{{event.organizer.avatarUrl}}" />
        <view wx:else class="flex h-[72rpx] w-[72rpx] shrink-0 items-center justify-center rounded-full bg-brand-soft"><t-icon name="user-avatar" size="38rpx" color="var(--color-brand)" /></view>
        <view class="min-w-0 flex-1"><view class="text-[length:19rpx] font-semibold text-accent">活动发起人</view><view class="mt-1 text-[length:25rpx] font-semibold">{{event.organizer.nickname}}</view><view wx:if="{{event.organizer.headline}}" class="mt-1 line-clamp-1 text-[length:20rpx] text-muted">{{event.organizer.headline}}</view></view>
        <view class="flex items-center gap-1 text-[length:20rpx] font-semibold text-brand">查看主页<t-icon name="chevron-right" size="30rpx" color="var(--color-brand)" /></view>
      </view>

      <view class="border-b border-line py-4">
        <view class="flex items-center justify-between"><view class="text-[length:28rpx] font-bold">关于这场活动</view><view wx:if="{{descriptionExpandable}}" class="text-[length:20rpx] font-semibold text-brand" bind:tap="toggleDescription">{{descriptionExpanded ? '收起' : '展开'}}</view></view>
        <view wx:if="{{descriptionExpanded || !descriptionExpandable}}" class="mt-3 whitespace-pre-wrap text-[length:24rpx] leading-7 text-muted">{{event.description || '活动说明稍后更新。'}}</view>
        <view wx:else class="mt-3 line-clamp-3 whitespace-pre-wrap text-[length:24rpx] leading-7 text-muted">{{event.description || '活动说明稍后更新。'}}</view>
        <view wx:if="{{event.address}}" class="mt-4 flex items-center justify-between gap-4 border-t border-line pt-4" bind:tap="openMap">
          <view class="min-w-0 flex-1"><view class="text-[length:20rpx] text-muted">详细地址</view><view class="mt-1 text-[length:23rpx]">{{event.address}}</view></view>
          <text class="shrink-0 text-[length:21rpx] font-semibold text-brand">{{event.latitude !== null ? '打开地图' : '复制地址'}}</text>
        </view>
        <view wx:if="{{event.onlineUrl}}" class="mt-4 flex items-center justify-between border-t border-line pt-4" bind:tap="copyOnlineLink"><text class="text-[length:23rpx]">线上参与链接</text><text class="text-[length:21rpx] font-semibold text-brand">复制</text></view>
      </view>

      <view
        wx:if="{{notificationAvailable && event.registrationState && event.registrationState !== 'CANCELLED' && event.registrationState !== 'REJECTED'}}"
        class="mt-4 flex items-center gap-3 rounded-[22rpx] bg-brand-soft px-4 py-4"
      >
        <view class="flex h-[58rpx] w-[58rpx] shrink-0 items-center justify-center rounded-full bg-panel"><t-icon name="notification" size="32rpx" color="var(--color-brand)" /></view>
        <view class="min-w-0 flex-1"><view class="text-[length:23rpx] font-semibold">{{notificationEnabled ? '活动提醒已开启' : '开启活动提醒'}}</view><view class="mt-1 text-[length:19rpx] text-muted">{{notificationEnabled ? '微信会按授权次数发送提醒' : '接收时间、地点与状态变化'}}</view></view>
        <t-button size="small" variant="outline" theme="primary" loading="{{notificationBusy}}" disabled="{{notificationEnabled}}" bind:tap="enableActivityNotifications">{{notificationEnabled ? '已开启' : '开启'}}</t-button>
      </view>
      <view class="mt-4 grid grid-cols-2 gap-3">
        <view class="flex min-h-[92rpx] items-center justify-center gap-2 rounded-[22rpx] bg-panel text-[length:23rpx] font-semibold text-brand active:bg-panel-muted" bind:tap="addToCalendar"><t-icon name="calendar" size="34rpx" color="var(--color-brand)" />加入日历</view>
        <button open-type="share" class="m-0 flex min-h-[92rpx] items-center justify-center gap-2 rounded-[22rpx] border-0 bg-panel p-0 text-[length:23rpx] font-semibold leading-[92rpx] text-brand active:bg-panel-muted"><t-icon name="share" size="34rpx" color="var(--color-brand)" />分享活动</button>
      </view>

      <view wx:if="{{event.notices}}" class="mt-4 rounded-[26rpx] bg-panel px-5 py-5"><view class="text-[length:28rpx] font-bold">活动须知</view><view class="mt-3 whitespace-pre-wrap text-[length:23rpx] leading-6 text-muted">{{event.notices}}</view></view>
      <view wx:if="{{event.cancellationPolicy}}" class="mt-4 rounded-[26rpx] bg-panel px-5 py-5"><view class="text-[length:28rpx] font-bold">取消与退款</view><view class="mt-3 whitespace-pre-wrap text-[length:23rpx] leading-6 text-muted">{{event.cancellationPolicy}}</view></view>
      <view wx:if="{{changeViews.length}}" class="mt-4 rounded-[26rpx] bg-panel px-5 py-5">
        <view class="text-[length:28rpx] font-bold">活动变更</view>
        <view wx:for="{{changeViews}}" wx:key="version" class="mt-4 border-l-[6rpx] border-brand pl-3"><view class="text-[length:23rpx] font-semibold">{{item.summary}}</view><view class="mt-1 text-[length:20rpx] text-muted">{{item.createdText}}</view></view>
      </view>
      <view wx:if="{{event.albumEnabled}}" class="mt-4 rounded-[26rpx] bg-panel px-5 py-5 active:bg-panel-muted" bind:tap="openAlbum">
        <view class="flex items-center justify-between"><view class="text-[length:28rpx] font-bold">活动相册</view><view class="flex items-center text-[length:22rpx] text-brand">查看全部<t-icon name="chevron-right" size="32rpx" color="var(--color-brand)" /></view></view>
        <view wx:if="{{event.albumPreview.length}}" class="mt-4 grid grid-cols-3 gap-2"><image wx:for="{{event.albumPreview}}" wx:key="id" class="h-[190rpx] w-full rounded-[16rpx] bg-canvas" mode="aspectFill" src="{{item.imageUrl}}" /></view>
        <view wx:else class="mt-3 text-[length:22rpx] text-muted">活动成员可以在这里分享现场照片。</view>
      </view>

      <view wx:if="{{event.canManage || event.canEditRegistration}}" class="mt-4 overflow-hidden rounded-[24rpx] bg-panel">
        <view wx:if="{{event.canManage}}" class="flex items-center justify-between border-b border-line px-5 py-4 active:bg-panel-muted" bind:tap="openEventOperations"><text class="text-[length:24rpx]">管理本场活动</text><t-icon name="chevron-right" size="34rpx" color="var(--color-muted)" /></view>
        <view wx:if="{{event.canEditRegistration}}" class="flex items-center justify-between px-5 py-4 active:bg-panel-muted" bind:tap="editRegistration"><text class="text-[length:24rpx]">修改报名资料</text><t-icon name="chevron-right" size="34rpx" color="var(--color-muted)" /></view>
      </view>
      <view wx:if="{{event.canCancel && (event.registrationState === 'PENDING_REVIEW' || event.registrationState === 'WAITLISTED')}}" class="mt-4"><t-button block variant="text" theme="danger" loading="{{busy}}" bind:tap="cancelRegistration">取消报名</t-button></view>
      <view wx:if="{{message}}" class="mt-4 rounded-[18rpx] bg-[#FFF0E8] px-4 py-3 text-[length:23rpx] text-[#9F4727]">{{message}}</view>
      <app-page-exit />
    </view>

    <view class="fixed bottom-0 left-0 right-0 z-50 flex items-center gap-3 border-t border-line bg-panel/95 px-4 pb-[calc(env(safe-area-inset-bottom)+16rpx)] pt-3">
      <button open-type="share" class="m-0 flex h-[88rpx] w-[94rpx] shrink-0 flex-col items-center justify-center border-0 bg-transparent p-0 text-[length:18rpx] leading-5 text-muted"><t-icon name="share" size="35rpx" color="var(--color-brand)" /><text class="mt-1">分享活动</text></button>
      <view class="min-w-0 flex-1">
        <view wx:if="{{action === 'closed' || action === 'full' || action === 'history' || action === 'pending' || action === 'waitlisted' || (action === 'event-cancelled' && !event.registrationState)}}" class="flex h-[88rpx] items-center justify-center rounded-[18rpx] bg-brand-soft px-4 text-center text-[length:27rpx] font-bold text-brand">{{actionLabel}}</view>
        <t-button wx:else block size="large" theme="primary" bind:tap="handleAction">{{actionLabel}}</t-button>
      </view>
    </view>
  </block>
  <app-phone-login-sheet visible="{{phoneSheetVisible}}" loading="{{phoneBinding}}" title="登录后继续报名" description="用于活动联系、订单与售后" bind:phone="bindPhone" bind:close="closePhoneSheet" bind:agreement="openAgreement" bind:privacy="openPrivacy" />
  <app-page-exit wx:if="{{state !== 'ready'}}" />
</view>
