<view id="mip-cooperation-detail-page" class="mip-member-page min-h-screen bg-canvas px-[24rpx] pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-[24rpx] text-ink">
  <view aria-label="正在加载" aria-busy="true" wx:if="{{state === 'loading'}}" class="rounded-[16rpx] bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}"><mip-empty-state title="暂时无法查看合作卡" description="{{message}}" action-text="重新加载" bind:action="load" /><app-page-exit /></view>
  <block wx:elif="{{item}}">
    <!-- figma 2704:13454 作者头：80px 头像 + fs16 昵称 + Lv 徽标 + 佩戴勋章 + 白色竖线行 + 灰色一句话介绍。
         全视角可见（2026-10-07 拍板）：访客与本人的差异仅在吸底操作（本人态多「编辑」）。 -->
    <view wx:if="{{item.author}}" class="flex items-center">
      <image wx:if="{{item.author.avatarUrl}}" class="h-[160rpx] w-[160rpx] shrink-0 rounded-full bg-brand-soft" src="{{item.author.avatarUrl}}" mode="aspectFill" />
      <view wx:else class="flex h-[160rpx] w-[160rpx] shrink-0 items-center justify-center rounded-full bg-brand-soft text-[40rpx] text-brand">MIP</view>
      <view class="min-w-0 flex-1 pl-[16rpx]">
        <view class="flex items-center gap-[8rpx]">
          <text class="min-w-0 shrink truncate text-[32rpx] font-medium leading-[44rpx]">{{item.author.nickname}}</text>
          <view wx:if="{{item.author.level}}" class="flex h-[32rpx] shrink-0 items-center rounded-[8rpx] bg-panel-raised px-[8rpx]">
            <text class="text-[20rpx] font-semibold leading-[28rpx] text-brand">Lv.{{item.author.level.number}}</text>
          </view>
          <image wx:if="{{badgeUrl}}" class="h-[40rpx] w-[40rpx] shrink-0" src="{{badgeUrl}}" mode="aspectFit" />
        </view>
        <view wx:if="{{authorLine}}" class="mt-[12rpx] truncate text-[20rpx] font-medium leading-[28rpx] text-ink">{{authorLine}}</view>
        <view wx:if="{{item.author.headline}}" class="mt-[12rpx] truncate text-[20rpx] font-normal leading-[28rpx] text-muted">{{item.author.headline}}</view>
      </view>
    </view>
    <view class="mt-[24rpx] overflow-hidden rounded-[32rpx]" aria-role="button" aria-label="{{item.mine ? '长按管理合作卡' : roleName + '合作卡'}}" bind:longpress="onCardLongPress">
      <mip-cooperation-card role-key="{{item.roleKey}}" positioning="{{item.positioning}}" target-summary="{{item.targetSummary}}" support="{{support}}" max-value="{{maxValue}}" tall show-quote />
    </view>
    <canvas id="cooperation-radar" type="2d" class="mt-[48rpx] h-[580rpx] w-full" />
    <!-- figma 2704:13454 菜单模块：黄圈图标表头 + 直角单元格表格（1px 拼缝），标题取角色 menu.title -->
    <view wx:if="{{menuRows.length}}" class="mt-[48rpx]">
      <view class="flex h-[64rpx] items-center gap-[8rpx] bg-panel px-[24rpx]">
        <view class="flex h-[32rpx] w-[32rpx] shrink-0 items-center justify-center rounded-full bg-brand" style="line-height: 0">
          <image class="h-[24rpx] w-[24rpx]" src="/packages/member/assets/figma/coop/icon-lifebuoy-dark.png" />
        </view>
        <text class="text-[20rpx] font-normal leading-[28rpx]">{{menuTitle}}</text>
      </view>
      <view class="mt-[2rpx] grid gap-[2rpx]" style="grid-template-columns: {{menuGridTemplate}}">
        <block wx:for="{{menuRows}}" wx:key="index">
          <text wx:for="{{item}}" wx:for-item="cell" wx:key="index" class="flex h-[64rpx] items-center justify-center overflow-hidden bg-panel px-[8rpx] text-center text-[20rpx] font-medium leading-[28rpx]">{{cell}}</text>
        </block>
      </view>
    </view>
    <view wx:if="{{quirkRows.length}}" class="mt-[24rpx]">
      <view class="flex h-[64rpx] items-center gap-[8rpx] bg-panel px-[24rpx]">
        <view class="flex h-[32rpx] w-[32rpx] shrink-0 items-center justify-center rounded-full bg-brand" style="line-height: 0">
          <image class="h-[24rpx] w-[24rpx]" src="/packages/member/assets/figma/coop/icon-virus-dark.png" />
        </view>
        <text class="text-[20rpx] font-normal leading-[28rpx]">需要被理解的“臭毛病”</text>
      </view>
      <view class="mt-[2rpx] grid gap-[2rpx]" style="grid-template-columns: 128rpx 240rpx 1fr">
        <block wx:for="{{quirkRows}}" wx:key="index">
          <text wx:for="{{item}}" wx:for-item="cell" wx:key="index" class="flex h-[64rpx] items-center justify-center overflow-hidden bg-panel px-[8rpx] text-center text-[20rpx] font-medium leading-[28rpx]">{{cell}}</text>
        </block>
      </view>
    </view>
    <view wx:if="{{message}}" class="mt-[24rpx] rounded-[16rpx] bg-brand-soft px-[16rpx] py-[12rpx] text-[22rpx] text-brand">{{message}}</view>
    <app-page-exit label="返回合作卡" />
  </block>

  <!-- figma 2704:13454 Group 27137：液态玻璃吸底栏。本人态：未发布=发布+编辑，已发布=编辑；访客无栏 -->
  <mip-sticky-actions wx:if="{{item && item.mine}}">
    <view slot="actions" class="grid w-full grid-cols-2 items-center gap-[16rpx]">
      <view wx:if="{{item.status !== 'PUBLISHED'}}" class="min-w-0">
        <mip-pill-button label="{{acting ? '发布中…' : '发布'}}" variant="secondary" loading="{{acting}}" bind:tap="publish" />
      </view>
      <view class="min-w-0 {{item.status === 'PUBLISHED' ? 'col-span-2' : ''}}">
        <mip-pill-button label="编辑" bind:tap="edit" />
      </view>
    </view>
  </mip-sticky-actions>
</view>
