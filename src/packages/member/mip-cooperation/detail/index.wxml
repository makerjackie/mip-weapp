<view id="mip-cooperation-detail-page" class="mip-member-page min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-4 text-ink">
  <view wx:if="{{state === 'loading'}}" class="rounded-[16rpx] bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}"><app-empty-state title="暂时无法查看合作卡" description="{{message}}" action-text="重新加载" bind:action="load" /><app-page-exit /></view>
  <block wx:elif="{{item}}">
    <view class="rounded-[16rpx] bg-panel px-5 py-5"><view class="flex items-center justify-between"><view class="rounded-full bg-brand px-3 py-1 text-[length:21rpx] font-semibold text-on-brand">{{roleName}}</view><view class="text-[length:20rpx] text-muted">{{item.author.cityName || '全国'}}</view></view><view class="mt-3 flex min-h-[88rpx] items-center" bind:tap="openAuthor"><view class="min-w-0 flex-1"><view class="text-[length:34rpx] font-bold">{{item.author.nickname}}</view><view wx:if="{{item.author.headline}}" class="mt-1 text-[length:22rpx] text-muted">{{item.author.headline}}</view></view><t-icon name="chevron-right" size="30rpx" color="var(--color-brand)" /></view><view class="mt-4 text-[length:24rpx] leading-7">{{item.positioning}}</view><view class="mt-4 rounded-[12rpx] bg-brand-soft px-4 py-3 text-[length:23rpx] leading-6"><text class="text-brand">合作目标：</text>{{item.targetSummary}}</view></view>
    <view class="mt-4 rounded-[16rpx] bg-panel px-4 py-5"><view class="text-[length:28rpx] font-semibold">能力自评</view><canvas id="cooperation-radar" type="2d" class="mt-3 h-[440rpx] w-full" /><view class="grid grid-cols-2 gap-2"><view wx:for="{{abilities}}" wx:key="key" class="flex items-center justify-between rounded-[10rpx] bg-panel-raised px-3 py-2 text-[length:21rpx]"><text class="text-muted">{{item.label}}</text><text>{{item.score}} / 5</text></view></view></view>
    <view wx:if="{{roleFields.length}}" class="mt-4 rounded-[16rpx] bg-panel px-5 py-5"><view class="text-[length:28rpx] font-semibold">合作信息</view><view class="mt-3 flex flex-col gap-3"><view wx:for="{{roleFields}}" wx:key="key" class="border-b border-line pb-3"><view class="text-[length:21rpx] text-muted">{{item.label}}</view><view class="mt-1 whitespace-pre-wrap text-[length:24rpx] leading-6">{{item.value}}</view></view></view></view>
    <t-button wx:if="{{!item.mine}}" class="mt-5" block size="large" theme="primary" disabled="{{interestPending}}" bind:tap="toggleInterest">{{item.interestActive ? '取消感兴趣' : '我感兴趣'}}</t-button>
    <view wx:if="{{!item.mine && interestPending}}" class="mt-2 text-center text-[length:20rpx] text-muted" aria-live="polite">正在同步</view>
    <t-button wx:if="{{item.canEdit}}" class="mt-5" block size="large" theme="primary" bind:tap="edit">编辑合作卡</t-button>
    <t-button wx:if="{{item.mine && item.status === 'PUBLISHED'}}" class="mt-3" block size="large" variant="outline" theme="danger" loading="{{acting}}" bind:tap="unpublish">下架合作卡</t-button>
    <t-button wx:if="{{item.mine}}" class="mt-3" block size="large" variant="text" theme="danger" loading="{{acting}}" bind:tap="deleteCard">删除合作卡</t-button>
    <view wx:if="{{message}}" class="mt-4 rounded-[16rpx] bg-brand-soft px-4 py-3 text-[length:22rpx] text-brand">{{message}}</view>
    <app-page-exit label="返回合作卡" />
  </block>
</view>
