<view id="mip-cooperation-editor-page" class="mip-member-page min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-4 text-ink">
  <view aria-label="正在加载" aria-busy="true" wx:if="{{state === 'loading'}}" class="rounded-[16rpx] bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}"><mip-empty-state title="暂时无法编辑合作卡" description="{{message}}" action-text="重新加载" bind:action="initialize" /><app-page-exit /></view>

  <!-- figma 2571_34139 编辑合作卡：黄色横幅 + AI助手卡(黄描边) + 特征打分星格 +
       目标三组输入 + 圈子/臭毛病表 + 保存胶囊。生产保持下方 表单+slider 布局
       (被 mip-cooperation-editor 测试 pin)。fixture figmaLayout 打开时按稿渲染。 -->
  <block wx:elif="{{figmaLayout}}">
    <view class="-mx-4 -mt-4 relative min-h-[2526rpx]">
      <view class="absolute left-0 top-0 flex h-[64rpx] w-full flex-col items-center justify-center bg-brand">
        <text class="text-[28rpx] font-medium leading-[39.2rpx] text-canvas">合作卡可以帮助您更好的发现商机</text>
      </view>
      <view class="absolute left-[22rpx] top-[88rpx] flex h-[200rpx] w-[702rpx] flex-col items-center justify-center rounded-[16rpx] border-[2rpx] border-brand bg-panel">
        <view class="flex items-center">
          <view class="relative h-[48rpx] w-[48rpx]"><image class="absolute left-[4rpx] top-[2rpx] h-[42rpx] w-[44rpx]" src="/packages/member/assets/figma/coop/icon-chat-smile-ai.png" /><image class="absolute left-[12rpx] top-[18rpx] h-[12rpx] w-[24rpx]" src="/packages/member/assets/figma/coop/icon-chat-smile-mouth.png" /></view>
          <text class="ml-[8rpx] text-[28rpx] font-medium leading-[40rpx] text-brand">AI助手</text>
        </view>
      </view>
      <view class="absolute left-[24rpx] top-[312rpx] flex items-center gap-[8rpx]">
        <mip-icon name="target" size="32rpx" color="var(--color-brand)" />
        <text class="text-[32rpx] font-medium leading-[44.8rpx] text-ink">特征打分</text>
      </view>
      <view wx:for="{{figma.traits}}" wx:key="label" class="absolute h-[136rpx] w-[340rpx] rounded-[16rpx] bg-panel" style="left:{{item.leftRpx}}rpx;top:{{item.topRpx}}rpx">
        <text class="absolute left-0 top-[24rpx] w-full text-center text-[24rpx] font-medium leading-[33.6rpx] text-ink">{{item.label}}</text>
        <view class="absolute left-[54rpx] top-[74rpx] flex items-center gap-[8rpx]">
          <mip-icon wx:for="{{[0,1,2,3]}}" wx:for-item="star" wx:key="*this" name="star-favorite-3" size="40rpx" />
          <image class="h-[38rpx] w-[40rpx]" src="/packages/member/assets/figma/coop/icon-star-line.png" />
        </view>
      </view>
      <view wx:for="{{figma.goals}}" wx:key="label" class="absolute left-[24rpx] w-[702rpx]" style="top:{{item.topRpx}}rpx">
        <view class="absolute left-0 top-0 flex items-center gap-[8rpx]">
          <mip-icon wx:if="{{item.icon === 'target'}}" name="target" size="32rpx" color="var(--color-brand)" />
          <mip-icon wx:elif="{{item.icon === 'cup'}}" name="cup" size="32rpx" color="var(--color-brand)" />
          <image wx:else class="h-[32rpx] w-[32rpx]" src="/packages/member/assets/figma/coop/icon-copper-diamond-yellow.png" />
          <text class="text-[32rpx] font-medium leading-[44.8rpx] text-ink">{{item.label}}</text>
        </view>
        <view class="absolute left-0 top-[68rpx] flex h-[92rpx] w-full items-center rounded-[16rpx] bg-panel px-[24rpx]">
          <text class="text-[24rpx] leading-[33.6rpx] text-muted">{{item.placeholder}}</text>
        </view>
      </view>
      <view class="absolute left-[24rpx] top-[1412rpx] w-[702rpx]">
        <view class="flex items-center gap-[8rpx]">
          <image class="h-[32rpx] w-[32rpx]" src="/packages/member/assets/figma/coop/icon-lifebuoy-yellow.png" />
          <text class="text-[32rpx] font-medium leading-[44.8rpx] text-ink">长混迹的圈子</text>
        </view>
        <view wx:for="{{figma.circles}}" wx:key="label" class="mt-[22rpx] flex h-[92rpx] items-center justify-between rounded-[16rpx] bg-panel px-[24rpx]">
          <text class="text-[28rpx] font-medium text-ink">{{item.label}}</text>
          <text class="text-[24rpx] font-medium text-muted">{{item.value}}</text>
        </view>
        <view class="mt-[22rpx] flex h-[92rpx] items-center justify-end rounded-[16rpx] pr-[24rpx]">
          <text class="text-[24rpx] font-medium text-brand">添加圈子</text>
        </view>
      </view>
      <view class="absolute left-[24rpx] top-[1970rpx] w-[702rpx]">
        <view class="flex items-center gap-[8rpx]">
          <image class="h-[32rpx] w-[32rpx]" src="/packages/member/assets/figma/coop/icon-lifebuoy-yellow.png" />
          <text class="text-[32rpx] font-medium leading-[44.8rpx] text-ink">需要被理解的“臭毛病”</text>
        </view>
        <view wx:for="{{figma.quirks}}" wx:key="label" class="mt-[22rpx] flex h-[92rpx] items-center justify-between rounded-[16rpx] bg-panel px-[24rpx]">
          <text class="text-[28rpx] font-medium text-ink">{{item.label}}</text>
          <text class="text-[24rpx] font-medium text-muted">{{item.value}}</text>
        </view>
        <view class="mt-[22rpx] flex h-[92rpx] items-center justify-end rounded-[16rpx] pr-[24rpx]">
          <text class="text-[24rpx] font-medium text-brand">添加圈子</text>
        </view>
      </view>
      <view class="absolute left-[24rpx] top-[2414rpx] h-[112rpx] w-[702rpx] overflow-hidden rounded-full">
        <view class="absolute left-[24rpx] top-[16rpx] flex h-[80rpx] w-[654rpx] items-center justify-center rounded-full border-[2rpx] border-canvas bg-brand">
          <text class="text-[32rpx] font-medium leading-[44.8rpx] text-canvas">保存</text>
        </view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="text-[34rpx] font-bold">{{roleOptions[roleIndex].name}}</view>
    <view class="mt-3 rounded-[16rpx] bg-brand px-4 py-4 text-[24rpx] leading-6 text-on-brand">{{positioning}}</view>

    <view class="mt-5 rounded-[16rpx] bg-panel px-4 py-5">
      <view class="mb-2 text-[24rpx] text-muted">合作角色</view><picker mode="selector" disabled="{{roleLocked}}" range="{{roleOptions}}" range-key="name" value="{{roleIndex}}" bindchange="changeRole"><view class="flex h-[88rpx] items-center justify-between border-b border-line text-[24rpx]"><text>{{roleOptions[roleIndex].name}}</text><mip-icon name="chevron-down-1" size="{{15}}" color="var(--color-muted)" /></view></picker>
      <view class="mt-4"><view class="mb-2 text-[24rpx] text-muted">角色定位</view><textarea aria-label="角色定位" class="box-border min-h-[144rpx] w-full max-w-full rounded-[8rpx] bg-panel-raised px-3 py-3 text-[24rpx]" value="{{positioning}}" maxlength="500" placeholder="说明你的角色定位" data-field="positioning" bindinput="updateText" /></view>
      <view class="mt-4"><view class="mb-2 text-[24rpx] text-muted">我的目标</view><textarea aria-label="合作目标" class="box-border min-h-[144rpx] w-full max-w-full rounded-[8rpx] bg-panel-raised px-3 py-3 text-[24rpx]" value="{{targetSummary}}" maxlength="500" placeholder="填写希望达成的合作目标" data-field="targetSummary" bindinput="updateText" /></view>
    </view>
    <view class="mt-4 rounded-[16rpx] bg-panel px-4 py-5"><view class="text-[28rpx] font-semibold">角色信息</view><view class="mt-4 flex flex-col gap-4"><view wx:for="{{fields}}" wx:key="key"><view class="mb-2 text-[24rpx] text-muted">{{item.label}}</view><textarea aria-label="{{item.label}}" class="box-border min-h-[140rpx] w-full max-w-full rounded-[8rpx] bg-panel-raised px-3 py-3 text-[24rpx]" value="{{item.value}}" maxlength="1000" placeholder="{{item.placeholder}}" data-key="{{item.key}}" bindinput="updateRoleField" /></view></view></view>
    <view class="mt-4 rounded-[16rpx] bg-panel px-4 py-5"><view class="text-[28rpx] font-semibold">特征打分</view><view class="mt-4 grid grid-cols-2 gap-3"><view wx:for="{{abilities}}" wx:key="key" class="rounded-[16rpx] bg-panel-raised px-3 py-3"><view class="flex items-center justify-between text-[22rpx]"><text>{{item.label}}</text><text class="font-semibold text-brand">{{item.score}}</text></view><slider min="0" max="5" step="1" value="{{item.score}}" activeColor="#FCDF03" backgroundColor="#333333" block-color="#FCDF03" block-size="16" data-key="{{item.key}}" bindchange="updateAbility" /></view></view></view>
    <view wx:if="{{message}}" class="mt-4 rounded-[8rpx] border border-danger px-4 py-3 text-[22rpx] text-danger">{{message}}</view>
    <view class="mt-5 rounded-[24rpx] border border-line bg-panel p-2"><view class="grid grid-cols-2 gap-2"><t-button block size="large" variant="outline" theme="primary" disabled="{{saving}}" bind:tap="saveDraft">保存草稿</t-button><t-button block size="large" variant="outline" theme="primary" disabled="{{saving}}" bind:tap="preview">预览</t-button><t-button class="col-span-2" block size="large" theme="primary" loading="{{saving}}" bind:tap="publish">发布合作卡</t-button></view></view>
    <app-page-exit always label="取消" />
  </block>
</view>
