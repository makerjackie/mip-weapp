<view id="mip-cooperation-editor-page" class="mip-member-page min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-4 text-ink">
  <view aria-label="正在加载" aria-busy="true" wx:if="{{state === 'loading'}}" class="rounded-[16rpx] bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}"><app-empty-state title="暂时无法编辑合作卡" description="{{message}}" action-text="重新加载" bind:action="initialize" /><app-page-exit /></view>
  <block wx:else>
    <view class="text-[length:36rpx] font-bold">{{roleOptions[roleIndex].name}}</view>
    <view class="mt-3 rounded-[16rpx] bg-brand px-4 py-4 text-[length:23rpx] leading-6 text-on-brand">{{positioning}}</view>
    <view wx:if="{{aiDraftLoaded}}" class="mt-4 rounded-[14rpx] bg-brand-soft px-4 py-3 text-[length:23rpx] text-brand">已载入 AI 草稿，可继续修改后保存。</view>
    <view class="mt-4 flex min-h-[112rpx] items-center gap-3 rounded-[16rpx] border border-brand bg-panel px-4" bind:tap="openAiAssistant">
      <view class="flex h-[68rpx] w-[68rpx] shrink-0 items-center justify-center rounded-full bg-brand"><t-icon name="chat" size="34rpx" color="var(--color-on-brand)" /></view>
      <view class="min-w-0 flex-1"><view class="text-[length:26rpx] font-semibold">AI 草稿助手</view><view class="mt-1 text-[length:22rpx] text-muted">可通过文字或语音整理合作卡草稿</view></view>
      <t-icon name="chevron-right" size="30rpx" color="var(--color-muted)" />
    </view>
    <view class="mt-5 rounded-[16rpx] bg-panel px-4 py-5">
      <view class="mb-2 text-[length:23rpx] text-muted">合作角色</view><picker mode="selector" disabled="{{roleLocked}}" range="{{roleOptions}}" range-key="name" value="{{roleIndex}}" bindchange="changeRole"><view class="flex h-[88rpx] items-center justify-between border-b border-line text-[length:25rpx]"><text>{{roleOptions[roleIndex].name}}</text><t-icon name="chevron-right" size="30rpx" color="var(--color-muted)" /></view></picker>
      <view class="mt-4"><view class="mb-2 text-[length:23rpx] text-muted">角色定位</view><textarea aria-label="角色定位" class="box-border min-h-[144rpx] w-full max-w-full rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:25rpx]" value="{{positioning}}" maxlength="500" placeholder="说明你的角色定位" data-field="positioning" bindinput="updateText" /></view>
      <view class="mt-4"><view class="mb-2 text-[length:23rpx] text-muted">我的目标</view><textarea aria-label="合作目标" class="box-border min-h-[144rpx] w-full max-w-full rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:25rpx]" value="{{targetSummary}}" maxlength="500" placeholder="填写希望达成的合作目标" data-field="targetSummary" bindinput="updateText" /></view>
    </view>
    <view class="mt-4 rounded-[16rpx] bg-panel px-4 py-5"><view class="text-[length:27rpx] font-semibold">角色信息</view><view class="mt-4 flex flex-col gap-4"><view wx:for="{{fields}}" wx:key="key"><view class="mb-2 text-[length:23rpx] text-muted">{{item.label}}</view><textarea aria-label="{{item.label}}" class="box-border min-h-[140rpx] w-full max-w-full rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:24rpx]" value="{{item.value}}" maxlength="1000" placeholder="{{item.placeholder}}" data-key="{{item.key}}" bindinput="updateRoleField" /></view></view></view>
    <view class="mt-4 rounded-[16rpx] bg-panel px-4 py-5"><view class="text-[length:27rpx] font-semibold">特征打分</view><view class="mt-4 grid grid-cols-2 gap-3"><view wx:for="{{abilities}}" wx:key="key" class="rounded-[14rpx] bg-panel-raised px-3 py-3"><view class="flex items-center justify-between text-[length:22rpx]"><text>{{item.label}}</text><text class="font-semibold text-brand">{{item.score}}</text></view><slider min="0" max="5" step="1" value="{{item.score}}" activeColor="#FCDF03" backgroundColor="#363636" block-color="#FCDF03" block-size="16" data-key="{{item.key}}" bindchange="updateAbility" /></view></view></view>
    <view wx:if="{{message}}" class="mt-4 rounded-[12rpx] border border-danger px-4 py-3 text-[length:22rpx] text-danger">{{message}}</view>
    <view class="mt-5 rounded-[24rpx] border border-line bg-panel p-2"><view class="grid grid-cols-2 gap-2"><t-button block size="large" variant="outline" theme="primary" disabled="{{saving}}" bind:tap="saveDraft">保存草稿</t-button><t-button block size="large" variant="outline" theme="primary" disabled="{{saving}}" bind:tap="preview">预览</t-button><t-button class="col-span-2" block size="large" theme="primary" loading="{{saving}}" bind:tap="publish">发布合作卡</t-button></view></view>
    <app-page-exit always label="取消" />
  </block>
</view>
