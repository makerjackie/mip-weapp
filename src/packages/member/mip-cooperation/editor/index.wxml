<view id="mip-cooperation-editor-page" class="min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-4 text-ink">
  <view wx:if="{{state === 'loading'}}" class="rounded-[16rpx] bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}"><app-empty-state title="暂时无法编辑合作卡" description="{{message}}" action-text="重新加载" bind:action="initialize" /><app-page-exit /></view>
  <block wx:else>
    <view class="text-[length:36rpx] font-bold">{{id ? '编辑合作卡' : '创建合作卡'}}</view>
    <view wx:if="{{aiDraftLoaded}}" class="mt-4 rounded-[14rpx] bg-brand-soft px-4 py-3 text-[length:23rpx] text-brand">已载入 AI 草稿，可继续修改后保存。</view>
    <view class="mt-5 rounded-[16rpx] bg-panel px-4 py-5">
      <view class="mb-2 text-[length:23rpx] text-muted">合作角色</view><picker mode="selector" disabled="{{roleLocked}}" range="{{roleOptions}}" range-key="name" value="{{roleIndex}}" bindchange="changeRole"><view class="flex h-[80rpx] items-center justify-between rounded-[12rpx] bg-panel-raised px-3 text-[length:25rpx]"><text>{{roleOptions[roleIndex].name}}</text><t-icon name="chevron-right" size="30rpx" color="var(--color-muted)" /></view></picker>
      <view class="mt-4"><view class="mb-2 text-[length:23rpx] text-muted">角色定位</view><textarea class="box-border min-h-[160rpx] w-full max-w-full rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:25rpx]" value="{{positioning}}" maxlength="500" placeholder="说明你的角色定位" data-field="positioning" bindinput="updateText" /></view>
      <view class="mt-4"><view class="mb-2 text-[length:23rpx] text-muted">合作目标</view><textarea class="box-border min-h-[160rpx] w-full max-w-full rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:25rpx]" value="{{targetSummary}}" maxlength="500" placeholder="填写希望达成的合作目标" data-field="targetSummary" bindinput="updateText" /></view>
    </view>
    <view class="mt-4 rounded-[16rpx] bg-panel px-4 py-5"><view class="text-[length:27rpx] font-semibold">角色信息</view><view class="mt-4 flex flex-col gap-4"><view wx:for="{{fields}}" wx:key="key"><view class="mb-2 text-[length:23rpx] text-muted">{{item.label}}</view><textarea class="box-border min-h-[140rpx] w-full max-w-full rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:24rpx]" value="{{item.value}}" maxlength="1000" placeholder="{{item.placeholder}}" data-key="{{item.key}}" bindinput="updateRoleField" /></view></view></view>
    <view class="mt-4 rounded-[16rpx] bg-panel px-4 py-5"><view class="text-[length:27rpx] font-semibold">能力自评</view><view class="mt-4 flex flex-col gap-4"><view wx:for="{{abilities}}" wx:key="key"><view class="flex items-center justify-between text-[length:23rpx]"><text>{{item.label}}</text><text class="text-brand">{{item.score}} / 5</text></view><slider min="0" max="5" step="1" value="{{item.score}}" activeColor="#FCDF03" backgroundColor="#363636" block-color="#FCDF03" block-size="18" data-key="{{item.key}}" bindchange="updateAbility" /></view></view></view>
    <view wx:if="{{message}}" class="mt-4 rounded-[12rpx] border border-danger px-4 py-3 text-[length:22rpx] text-danger">{{message}}</view>
    <view class="mt-5 flex gap-3"><t-button class="min-w-0 flex-1" block size="large" variant="outline" theme="primary" disabled="{{saving}}" bind:tap="saveDraft">保存草稿</t-button><t-button class="min-w-0 flex-1" block size="large" theme="primary" loading="{{saving}}" bind:tap="publish">发布</t-button></view>
    <app-page-exit label="取消" />
  </block>
</view>
