<view id="mip-profile-page" class="mip-member-page min-h-screen bg-canvas pb-[calc(env(safe-area-inset-bottom)+180rpx)] text-ink">
  <view wx:if="{{state === 'loading'}}" class="mx-3 mt-3 rounded-[16rpx] bg-panel px-5 py-8">
    <t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading />
  </view>
  <view wx:elif="{{state === 'error'}}" class="mx-3 mt-3"><app-empty-state title="暂时无法加载资料" description="身份服务暂时没有响应。" action-text="重新加载" bind:action="loadProfile" /></view>
  <block wx:else>
    <view class="bg-brand px-3 py-2 text-center text-[length:24rpx] text-on-brand">资料用于个人名片和公开档案展示</view>
    <view wx:if="{{aiDraftLoaded}}" class="mx-3 mt-3 rounded-[14rpx] bg-brand-soft px-4 py-3 text-[length:23rpx] text-brand">已载入 AI 草稿，可继续修改后保存。</view>

    <view class="mx-3 mt-3 flex items-center gap-2 text-[length:30rpx] font-semibold">
      <t-icon name="user-avatar" size="30rpx" color="var(--color-brand)" />
      <text>基础信息</text>
    </view>
    <view data-profile-basic-group="true" class="mx-3 mt-3 overflow-hidden rounded-[16rpx] bg-panel">
      <view data-profile-basic-row="avatar" class="flex min-h-[160rpx] items-center justify-between px-3 py-2">
        <button plain open-type="chooseAvatar" class="m-0 flex h-[112rpx] w-[112rpx] shrink-0 items-center justify-center overflow-hidden rounded-full border-0 bg-panel-raised p-0 leading-[112rpx]" disabled="{{avatarUploading || saving}}" bindchooseavatar="chooseAvatar">
          <image wx:if="{{avatarUrl}}" class="h-full w-full" mode="aspectFill" src="{{avatarUrl}}" />
          <t-icon wx:else name="user-avatar" size="56rpx" color="var(--color-muted)" />
        </button>
        <view class="text-[length:24rpx] text-muted">{{avatarUploading ? '头像上传中' : '更换头像'}}</view>
      </view>
      <view data-profile-basic-row="nickname" class="flex min-h-[92rpx] items-center border-t border-line px-3">
        <view class="w-[120rpx] shrink-0 text-[length:26rpx] font-medium">昵称 <text class="text-[length:20rpx] text-danger">*</text></view>
        <input class="h-[92rpx] min-w-0 flex-1 text-right text-[length:26rpx]" type="nickname" maxlength="64" value="{{nickname}}" data-field="nickname" bindinput="updateText" placeholder="请输入您的昵称" placeholder-style="color:#A3A3A3;text-align:right" />
      </view>
      <view data-profile-basic-row="realName" class="flex min-h-[92rpx] items-center border-t border-line px-3">
        <view class="w-[120rpx] shrink-0 text-[length:26rpx] font-medium">姓名</view>
        <input class="h-[92rpx] min-w-0 flex-1 text-right text-[length:26rpx]" maxlength="64" value="{{realName}}" data-field="realName" bindinput="updateText" placeholder="请输入您的姓名" placeholder-style="color:#A3A3A3;text-align:right" />
      </view>
      <view data-profile-basic-row="gender" class="flex min-h-[92rpx] items-center border-t border-line px-3">
        <view class="w-[120rpx] shrink-0 text-[length:26rpx] font-medium">性别</view>
        <radio-group class="flex min-w-0 flex-1 justify-end gap-2" bindchange="changeGender">
          <label wx:for="{{genderOptions}}" wx:key="value" class="flex min-h-[52rpx] items-center gap-1 rounded-full border px-2 text-[length:22rpx] {{gender === item.value ? 'border-brand bg-brand-soft text-brand' : 'border-line text-muted'}}">
            <radio class="hidden" value="{{item.value}}" checked="{{gender === item.value}}" color="#FCDF03" />
            <t-icon wx:if="{{item.value === 'MALE'}}" name="gender-male" size="26rpx" color="{{gender === item.value ? 'var(--color-brand)' : 'var(--color-muted)'}}" />
            <t-icon wx:elif="{{item.value === 'FEMALE'}}" name="gender-female" size="26rpx" color="{{gender === item.value ? 'var(--color-brand)' : 'var(--color-muted)'}}" />
            <text>{{item.label}}</text>
          </label>
        </radio-group>
      </view>
    </view>

    <view class="mx-3 mt-5 flex items-center gap-2 text-[length:30rpx] font-semibold">
      <t-icon name="file-edit" size="30rpx" color="var(--color-brand)" />
      <text>代表行业</text>
    </view>
    <view class="mx-3 mt-3 overflow-hidden rounded-[16rpx] bg-panel">
      <view data-catalog="industry" class="flex min-h-[92rpx] items-center justify-between gap-3 px-3" bind:tap="toggleCatalog">
        <text class="min-w-0 flex-1 truncate text-[length:25rpx] {{industryOptions[industryIndex].id ? 'text-ink' : 'text-muted'}}">{{industryOptions[industryIndex].id ? industryOptions[industryIndex].label : '请选择代表的行业标签'}}</text>
        <t-icon name="chevron-right" size="28rpx" color="var(--color-muted)" />
      </view>
      <view wx:if="{{industryCatalogExpanded}}" class="border-t border-line px-3 py-3"><mip-catalog-selector groups="{{industryGroups}}" selected-ids="{{selectedIndustryIds}}" multiple="{{false}}" clear-label="未选择" bind:change="changeIndustry" /></view>
    </view>

    <view class="mx-3 mt-5 flex items-center gap-2 text-[length:30rpx] font-semibold">
      <t-icon name="usergroup" size="30rpx" color="var(--color-brand)" />
      <text>当前身份状态</text>
    </view>
    <view class="mx-3 mt-3 flex flex-wrap gap-2">
      <block wx:for="{{careerIdentityOptions}}" wx:key="value">
        <view data-value="{{item.value}}" class="min-h-[56rpx] rounded-[12rpx] border px-3 py-1 text-[length:23rpx] {{careerIdentityKey === item.value ? 'border-brand bg-brand-soft text-brand' : 'border-transparent bg-panel text-muted'}}" bind:tap="chooseCareerIdentity">{{item.label}}</view>
      </block>
    </view>

    <view class="mx-3 mt-5 flex items-center gap-2 text-[length:30rpx] font-semibold">
      <t-icon name="file" size="30rpx" color="var(--color-brand)" />
      <text>一句话介绍你的工作和背景</text>
    </view>
    <view class="mx-3 mt-3 rounded-[16rpx] bg-panel px-3 py-3">
      <textarea class="block h-[176rpx] w-full max-w-full box-border bg-transparent text-[length:25rpx] leading-6" maxlength="160" value="{{headline}}" data-field="headline" bindinput="updateText" placeholder="例如：品牌主理人，寻找一起做项目的伙伴" placeholder-style="color:#A3A3A3" />
      <view class="text-right text-[length:21rpx] text-muted">{{headline.length}}/160</view>
    </view>

    <view data-profile-more-toggle="true" class="mx-3 mt-5 flex min-h-[92rpx] items-center justify-between rounded-[16rpx] bg-panel px-3" bind:tap="toggleMore">
      <view class="flex items-center gap-2 text-[length:27rpx] font-semibold">
        <t-icon name="view-list" size="28rpx" color="var(--color-brand)" />
        <text>更多资料</text>
      </view>
      <t-icon name="{{moreExpanded ? 'chevron-up' : 'chevron-down'}}" size="28rpx" color="var(--color-muted)" />
    </view>

    <block wx:if="{{moreExpanded}}">
    <view class="mx-3 mt-5 flex items-center gap-2 text-[length:30rpx] font-semibold">
      <t-icon name="location" size="30rpx" color="var(--color-brand)" />
      <text>主城市分会</text>
    </view>
    <view wx:if="{{branchGroups.length}}" class="mx-3 mt-3 overflow-hidden rounded-[16rpx] bg-panel">
      <view data-catalog="branch" class="flex min-h-[92rpx] items-center justify-between gap-3 px-3" bind:tap="toggleCatalog">
        <text class="min-w-0 flex-1 truncate text-[length:25rpx] {{branchOptions[branchIndex].id ? 'text-ink' : 'text-muted'}}">{{branchOptions[branchIndex].id ? branchOptions[branchIndex].label : '请选择主城市分会'}}</text>
        <t-icon name="chevron-right" size="28rpx" color="var(--color-muted)" />
      </view>
      <view wx:if="{{branchCatalogExpanded}}" class="border-t border-line px-3 py-3"><mip-catalog-selector groups="{{branchGroups}}" selected-ids="{{selectedBranchIds}}" multiple="{{false}}" clear-label="未选择" bind:change="changeBranch" /></view>
    </view>
    <view wx:else class="mx-3 mt-3 rounded-[16rpx] bg-panel px-3 py-3 text-[length:24rpx] text-muted">城市分会暂未配置，请稍后再试。</view>

    <block wx:if="{{abilityOptions.length}}">
      <view class="mx-3 mt-5 flex items-center gap-2 text-[length:30rpx] font-semibold">
        <t-icon name="tag" size="30rpx" color="var(--color-brand)" />
        <text>能力标签</text>
      </view>
      <view class="mx-3 mt-3 flex flex-wrap gap-2">
        <block wx:for="{{abilityOptions}}" wx:key="id">
          <view wx:if="{{item.selected}}" data-id="{{item.id}}" class="min-h-[56rpx] rounded-[12rpx] border border-brand bg-brand-soft px-3 py-1 text-[length:23rpx] text-brand" bind:tap="toggleAbility">{{item.label}}</view>
          <view wx:else data-id="{{item.id}}" class="min-h-[56rpx] rounded-[12rpx] border border-transparent bg-panel px-3 py-1 text-[length:23rpx] text-muted" bind:tap="toggleAbility">{{item.label}}</view>
        </block>
      </view>
    </block>

    <view class="mx-3 mt-5 flex items-center gap-2 text-[length:30rpx] font-semibold">
      <t-icon name="info-circle" size="30rpx" color="var(--color-brand)" />
      <text>补充资料</text>
    </view>
    <view class="mx-3 mt-3 overflow-hidden rounded-[16rpx] bg-panel">
      <view class="flex min-h-[92rpx] items-center px-3">
        <view class="w-[144rpx] shrink-0 text-[length:25rpx]">身份说明</view>
        <input class="h-[92rpx] min-w-0 flex-1 text-right text-[length:25rpx]" maxlength="32" value="{{identityStatus}}" data-field="identityStatus" bindinput="updateText" placeholder="例如：创业者" placeholder-style="color:#A3A3A3;text-align:right" />
      </view>
      <view class="border-t border-line px-3 py-3">
        <textarea class="block h-[180rpx] w-full max-w-full box-border bg-transparent text-[length:25rpx] leading-6" maxlength="300" value="{{introduction}}" data-field="introduction" bindinput="updateText" placeholder="补充经历、能力和合作方向" placeholder-style="color:#A3A3A3" />
        <view class="text-right text-[length:21rpx] text-muted">{{introduction.length}}/300</view>
      </view>
    </view>

    <view class="mx-3 mt-5 rounded-[16rpx] bg-panel px-4 py-5">
      <view class="text-[length:30rpx] font-semibold">组织信息</view>

      <view class="mt-4 flex items-center justify-between">
        <view class="text-[length:23rpx] font-semibold text-muted">公司</view>
        <view class="text-[length:22rpx] text-muted">{{companies.length}}/{{maxOrganizations}}</view>
      </view>
      <view wx:if="{{!companies.length}}" class="mt-3 rounded-[14rpx] border border-line px-4 py-4 text-[length:23rpx] text-muted">暂未添加公司经历。</view>
      <view wx:for="{{companies}}" wx:key="id" class="mt-3 rounded-[14rpx] border border-line bg-panel-raised px-3 py-4">
        <view class="flex min-h-[64rpx] items-center justify-between gap-2">
          <view class="text-[length:24rpx] font-semibold">公司 {{index + 1}}</view>
          <view class="flex shrink-0 items-center gap-1">
            <button plain class="m-0 flex min-h-[64rpx] min-w-[88rpx] items-center justify-center px-2 text-[length:22rpx] text-muted disabled:opacity-40" disabled="{{index === 0}}" data-kind="companies" data-index="{{index}}" data-direction="-1" bind:tap="moveExperience">上移</button>
            <button plain class="m-0 flex min-h-[64rpx] min-w-[88rpx] items-center justify-center px-2 text-[length:22rpx] text-muted disabled:opacity-40" disabled="{{index === companies.length - 1}}" data-kind="companies" data-index="{{index}}" data-direction="1" bind:tap="moveExperience">下移</button>
            <button plain class="m-0 flex min-h-[64rpx] min-w-[88rpx] items-center justify-center px-2 text-[length:22rpx] text-danger" data-kind="companies" data-index="{{index}}" bind:tap="removeExperience">删除</button>
          </view>
        </view>
        <input class="mt-2 block h-[88rpx] w-full max-w-full box-border rounded-[14rpx] bg-canvas px-4 text-[length:26rpx]" maxlength="120" value="{{item.name}}" data-kind="companies" data-index="{{index}}" data-field="name" bindinput="updateExperience" placeholder="公司名称" placeholder-style="color:#A3A3A3" />
        <input class="mt-3 block h-[88rpx] w-full max-w-full box-border rounded-[14rpx] bg-canvas px-4 text-[length:26rpx]" maxlength="80" value="{{item.role}}" data-kind="companies" data-index="{{index}}" data-field="role" bindinput="updateExperience" placeholder="职位" placeholder-style="color:#A3A3A3" />
      </view>
      <button plain class="mt-3 flex min-h-[88rpx] w-full max-w-full box-border items-center justify-center rounded-[14rpx] border border-line text-[length:24rpx] text-ink disabled:opacity-40" disabled="{{companies.length >= maxOrganizations}}" data-kind="companies" bind:tap="addExperience">添加公司经历</button>

      <view class="mt-6 flex items-center justify-between">
        <view class="text-[length:23rpx] font-semibold text-muted">组织</view>
        <view class="text-[length:22rpx] text-muted">{{organizations.length}}/{{maxOrganizations}}</view>
      </view>
      <view wx:if="{{!organizations.length}}" class="mt-3 rounded-[14rpx] border border-line px-4 py-4 text-[length:23rpx] text-muted">暂未添加组织经历。</view>
      <view wx:for="{{organizations}}" wx:key="id" class="mt-3 rounded-[14rpx] border border-line bg-panel-raised px-3 py-4">
        <view class="flex min-h-[64rpx] items-center justify-between gap-2">
          <view class="text-[length:24rpx] font-semibold">组织 {{index + 1}}</view>
          <view class="flex shrink-0 items-center gap-1">
            <button plain class="m-0 flex min-h-[64rpx] min-w-[88rpx] items-center justify-center px-2 text-[length:22rpx] text-muted disabled:opacity-40" disabled="{{index === 0}}" data-kind="organizations" data-index="{{index}}" data-direction="-1" bind:tap="moveExperience">上移</button>
            <button plain class="m-0 flex min-h-[64rpx] min-w-[88rpx] items-center justify-center px-2 text-[length:22rpx] text-muted disabled:opacity-40" disabled="{{index === organizations.length - 1}}" data-kind="organizations" data-index="{{index}}" data-direction="1" bind:tap="moveExperience">下移</button>
            <button plain class="m-0 flex min-h-[64rpx] min-w-[88rpx] items-center justify-center px-2 text-[length:22rpx] text-danger" data-kind="organizations" data-index="{{index}}" bind:tap="removeExperience">删除</button>
          </view>
        </view>
        <input class="mt-2 block h-[88rpx] w-full max-w-full box-border rounded-[14rpx] bg-canvas px-4 text-[length:26rpx]" maxlength="120" value="{{item.name}}" data-kind="organizations" data-index="{{index}}" data-field="name" bindinput="updateExperience" placeholder="组织名称" placeholder-style="color:#A3A3A3" />
        <input class="mt-3 block h-[88rpx] w-full max-w-full box-border rounded-[14rpx] bg-canvas px-4 text-[length:26rpx]" maxlength="80" value="{{item.role}}" data-kind="organizations" data-index="{{index}}" data-field="role" bindinput="updateExperience" placeholder="角色" placeholder-style="color:#A3A3A3" />
      </view>
      <button plain class="mt-3 flex min-h-[88rpx] w-full max-w-full box-border items-center justify-center rounded-[14rpx] border border-line text-[length:24rpx] text-ink disabled:opacity-40" disabled="{{organizations.length >= maxOrganizations}}" data-kind="organizations" bind:tap="addExperience">添加组织经历</button>
    </view>

    <view class="mx-3 mt-4 rounded-[16rpx] bg-panel px-4 py-5">
      <view class="text-[length:30rpx] font-semibold">联系方式</view>
      <view class="mt-2 text-[length:22rpx] leading-6 text-muted">{{phoneBound ? '已绑定，可重新授权本人微信手机号。' : '用于活动联系、订单与售后，不会公开展示。'}}</view>
      <button open-type="getPhoneNumber" disabled="{{phoneBinding || saving}}" class="mt-4 flex h-[84rpx] w-full max-w-full box-border items-center justify-center rounded-[14rpx] border border-line bg-panel-raised text-[length:25rpx] font-semibold text-ink disabled:opacity-60" bind:getphonenumber="bindPhone">
        {{phoneBinding ? '正在更新' : phoneBound ? '更换绑定手机号' : '绑定微信手机号'}}
      </button>
    </view>

    <view class="mx-3 mt-4 rounded-[16rpx] bg-panel px-4 py-4">
      <view class="text-[length:30rpx] font-semibold">公开范围</view>
      <view class="mt-3 flex min-h-[88rpx] items-center justify-between"><text class="text-[length:25rpx]">昵称</text><switch checked="{{visibilityNickname}}" color="#FCDF03" data-field="visibilityNickname" bindchange="updateVisibility" /></view>
      <view class="flex min-h-[88rpx] items-center justify-between"><text class="text-[length:25rpx]">姓名</text><switch checked="{{visibilityRealName}}" color="#FCDF03" data-field="visibilityRealName" bindchange="updateVisibility" /></view>
      <view class="flex min-h-[88rpx] items-center justify-between"><text class="text-[length:25rpx]">性别</text><switch checked="{{visibilityGender}}" color="#FCDF03" data-field="visibilityGender" bindchange="updateVisibility" /></view>
      <view class="flex min-h-[88rpx] items-center justify-between"><text class="text-[length:25rpx]">职业身份</text><switch checked="{{visibilityCareerIdentity}}" color="#FCDF03" data-field="visibilityCareerIdentity" bindchange="updateVisibility" /></view>
      <view class="flex min-h-[88rpx] items-center justify-between"><text class="text-[length:25rpx]">头像</text><switch checked="{{visibilityAvatar}}" color="#FCDF03" data-field="visibilityAvatar" bindchange="updateVisibility" /></view>
      <view class="flex min-h-[88rpx] items-center justify-between"><text class="text-[length:25rpx]">身份状态</text><switch checked="{{visibilityIdentityStatus}}" color="#FCDF03" data-field="visibilityIdentityStatus" bindchange="updateVisibility" /></view>
      <view class="mt-3 flex min-h-[88rpx] items-center justify-between"><text class="text-[length:25rpx]">一句话介绍</text><switch checked="{{visibilityHeadline}}" color="#FCDF03" data-field="visibilityHeadline" bindchange="updateVisibility" /></view>
      <view class="flex min-h-[88rpx] items-center justify-between"><text class="text-[length:25rpx]">个人简介</text><switch checked="{{visibilityIntroduction}}" color="#FCDF03" data-field="visibilityIntroduction" bindchange="updateVisibility" /></view>
      <view class="flex min-h-[88rpx] items-center justify-between"><text class="text-[length:25rpx]">主城市分会</text><switch checked="{{visibilityPrimaryBranch}}" color="#FCDF03" data-field="visibilityPrimaryBranch" bindchange="updateVisibility" /></view>
      <view class="flex min-h-[88rpx] items-center justify-between"><text class="text-[length:25rpx]">主行业</text><switch checked="{{visibilityIndustry}}" color="#FCDF03" data-field="visibilityIndustry" bindchange="updateVisibility" /></view>
      <view class="flex min-h-[88rpx] items-center justify-between"><text class="text-[length:25rpx]">能力</text><switch checked="{{visibilityAbilities}}" color="#FCDF03" data-field="visibilityAbilities" bindchange="updateVisibility" /></view>
      <view class="flex min-h-[88rpx] items-center justify-between"><text class="text-[length:25rpx]">公司经历</text><switch checked="{{visibilityCompanies}}" color="#FCDF03" data-field="visibilityCompanies" bindchange="updateVisibility" /></view>
      <view class="flex min-h-[88rpx] items-center justify-between"><text class="text-[length:25rpx]">组织经历</text><switch checked="{{visibilityOrganizations}}" color="#FCDF03" data-field="visibilityOrganizations" bindchange="updateVisibility" /></view>
      <view class="flex min-h-[88rpx] items-center justify-between"><text class="text-[length:25rpx]">影响力数据</text><switch checked="{{visibilityInfluence}}" color="#FCDF03" data-field="visibilityInfluence" bindchange="updateVisibility" /></view>
    </view>
    </block>

    <view wx:if="{{message}}" class="mx-3 mt-4 rounded-[16rpx] border border-line bg-panel-raised px-4 py-3 text-[length:23rpx] leading-6">{{message}}</view>
    <mip-sticky-actions><view slot="actions" class="w-full"><t-button block size="large" theme="primary" loading="{{saving}}" disabled="{{avatarUploading}}" bind:tap="saveProfile">保存资料</t-button></view></mip-sticky-actions>
  </block>
  <app-page-exit />
</view>
