<view id="mip-profile-page" class="mip-member-page min-h-screen bg-canvas pb-[calc(env(safe-area-inset-bottom)+180rpx)] text-ink">
  <view aria-label="正在加载" aria-busy="true" wx:if="{{state === 'loading'}}" class="mx-3 mt-3 rounded-[16rpx] bg-panel px-5 py-8">
    <t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading />
  </view>
  <view wx:elif="{{state === 'error'}}" class="mx-3 mt-3"><mip-empty-state title="暂时无法加载资料" description="身份服务暂时没有响应。" action-text="重新加载" bind:action="loadProfile" /></view>

  <!-- figma 1774_41143/1774_41253/1822_19405 编辑信息：黄色横幅 + 基础信息(头像/昵称/性别
       三行分组卡) + 代表行业(选择卡 + 12 标签) + 当前身份状态(7 标签) + 一句话介绍(textarea)。
       figma 1774_41767/2917_4785 代表行业选择器：黄色横幅 + 三组手风琴 + 已选计数 + 清除/确定。
       生产保持下方表单布局（被 vitest pin）。fixture figmaLayout 打开时按稿渲染，
       数据来自 ui-fidelity manifest fixture。 -->
  <block wx:elif="{{figmaLayout}}">
    <view wx:if="{{figma.picker}}" class="relative min-h-[1400rpx]">
      <view class="absolute left-0 top-0 h-[64rpx] w-full bg-brand">
        <text class="absolute left-0 top-[12rpx] w-full text-center text-[28rpx] font-semibold leading-[40rpx] text-canvas">请选择1个您当前所在的行业</text>
      </view>

      <block wx:for="{{figma.pickerGroups}}" wx:key="label">
        <text class="absolute left-[48rpx] text-[length:32rpx] font-semibold leading-[44.8rpx] text-ink" style="top:{{item.topRpx}}rpx">{{item.label}}</text>
        <mip-icon wx:if="{{item.expanded}}" class="absolute left-[666rpx] rotate-180" style="top:{{item.topRpx + 15}}rpx" name="chevron-down-1-15" size="{{12}}" color="var(--color-ink)" />
        <mip-icon wx:else class="absolute left-[666rpx]" style="top:{{item.topRpx + 15}}rpx" name="chevron-down-1-15" size="{{12}}" color="var(--color-ink)" />
      </block>

      <view wx:for="{{figma.pickerChips}}" wx:key="label" class="absolute flex h-[56rpx] items-center justify-center rounded-[16rpx] text-[length:28rpx] {{item.active ? 'bg-brand font-medium text-canvas' : 'bg-panel text-ink'}}" style="left:{{item.leftRpx}}rpx;top:{{item.topRpx}}rpx;width:{{item.widthRpx}}rpx">{{item.label}}</view>

      <text class="absolute left-[48rpx] top-[1200rpx] text-[length:28rpx] font-medium leading-[40rpx] text-brand">已选 1/1</text>
      <view class="absolute left-[24rpx] top-[1268rpx] h-[112rpx] w-[702rpx] rounded-full bg-[#3f3c27]">
        <view class="absolute left-[24rpx] top-[16rpx] flex h-[80rpx] w-[176rpx] items-center justify-center rounded-full bg-panel">
          <text class="text-[length:28rpx] font-medium leading-[40rpx] text-brand">清除</text>
        </view>
        <view class="absolute left-[226rpx] top-[16rpx] flex h-[80rpx] w-[450rpx] items-center justify-center rounded-full bg-brand">
          <text class="text-[length:32rpx] font-medium leading-[44.8rpx] text-canvas">确定</text>
        </view>
      </view>
    </view>
    <view wx:else class="relative min-h-[1500rpx]">
      <view class="absolute left-0 top-0 h-[64rpx] w-full bg-brand">
        <text class="absolute left-0 top-[12rpx] w-full text-center text-[28rpx] font-semibold leading-[40rpx] text-canvas">吸引更多适合你的资源和人脉~</text>
      </view>

      <image class="absolute left-[24rpx] top-[96rpx] h-[32rpx] w-[32rpx]" src="/packages/member/assets/figma/profile/icon-section-people.png" />
      <text class="absolute left-[64rpx] top-[88rpx] text-[32rpx] font-semibold leading-[44.8rpx] text-ink">基础信息</text>

      <view class="absolute left-[24rpx] top-[156rpx] h-[160rpx] w-[702rpx] bg-panel">
        <image class="absolute left-[24rpx] top-[24rpx] h-[112rpx] w-[112rpx] rounded-full" mode="aspectFill" src="/packages/member/assets/figma/profile/avatar-mine.webp" />
        <text class="absolute right-[24rpx] top-[60rpx] text-[28rpx] leading-[40rpx] text-ink">更换头像</text>
      </view>
      <mip-form-field-row
        class="absolute left-[24rpx] top-[318rpx]"
        style="width:702rpx"
        label="昵称 *"
        value="{{figma.nickname}}"
        placeholder="请输入您的昵称"
      />
      <view class="absolute left-[24rpx] top-[412rpx] h-[92rpx] w-[702rpx] bg-panel">
        <text class="absolute left-[24rpx] top-[28rpx] text-[28rpx] leading-[40rpx] text-ink">性别</text>
        <view class="absolute left-[470rpx] top-[18rpx] flex h-[56rpx] w-[96rpx] items-center justify-center gap-[4rpx] rounded-full border-[2rpx] {{figma.gender === 'MALE' ? 'border-brand bg-brand' : 'border-muted'}}">
          <text class="{{figma.gender === 'MALE' ? 'text-[24rpx] leading-[32rpx] text-canvas' : 'text-[24rpx] leading-[32rpx] text-muted'}}">♂</text>
          <text class="{{figma.gender === 'MALE' ? 'text-[28rpx] leading-[40rpx] text-canvas' : 'text-[28rpx] leading-[40rpx] text-muted'}}">男</text>
        </view>
        <view class="absolute left-[582rpx] top-[18rpx] flex h-[56rpx] w-[96rpx] items-center justify-center gap-[4rpx] rounded-full border-[2rpx] {{figma.gender === 'FEMALE' ? 'border-brand bg-brand' : 'border-muted'}}">
          <text class="{{figma.gender === 'FEMALE' ? 'text-[24rpx] leading-[32rpx] text-canvas' : 'text-[24rpx] leading-[32rpx] text-muted'}}">♀</text>
          <text class="{{figma.gender === 'FEMALE' ? 'text-[28rpx] leading-[40rpx] text-canvas' : 'text-[28rpx] leading-[40rpx] text-muted'}}">女</text>
        </view>
      </view>

      <image class="absolute left-[24rpx] top-[536rpx] h-[32rpx] w-[32rpx]" src="/packages/member/assets/figma/profile/icon-section-industry.png" />
      <text class="absolute left-[64rpx] top-[528rpx] text-[32rpx] font-semibold leading-[44.8rpx] text-ink">代表行业</text>

      <view class="absolute left-[24rpx] top-[596rpx] h-[92rpx] w-[702rpx] rounded-[16rpx] bg-panel">
        <block wx:if="{{figma.industryValue}}">
          <view class="absolute left-[16rpx] top-[22rpx] flex h-[48rpx] items-center gap-[8rpx] rounded-full bg-brand pl-[20rpx] pr-[10rpx]">
            <text class="text-[24rpx] font-semibold leading-[32rpx] text-canvas">{{figma.industryValue}}</text>
            <view class="flex h-[28rpx] w-[28rpx] items-center justify-center rounded-full bg-canvas">
              <mip-icon name="close" size="14rpx" color="var(--color-brand)" />
            </view>
          </view>
        </block>
        <text wx:else class="absolute left-[24rpx] top-[24rpx] text-[28rpx] leading-[40rpx] text-muted">请选择代表的行业标签</text>
        <view class="absolute right-[24rpx] top-[34rpx]">
          <mip-icon name="chevron-right-1" size="24rpx" color="var(--color-muted)" />
        </view>
      </view>

      <view wx:for="{{figma.industries}}" wx:key="index" class="absolute h-[56rpx] w-[164rpx] flex items-center justify-center rounded-[16rpx] {{item.active ? 'bg-brand' : 'bg-panel'}}" style="left:{{item.leftRpx}}rpx;top:{{item.topRpx}}rpx">
        <text class="{{item.active ? 'text-[28rpx] leading-[40rpx] text-canvas' : 'text-[28rpx] leading-[40rpx] text-muted'}}">{{item.label}}</text>
      </view>

      <image class="absolute left-[24rpx] top-[944rpx] h-[32rpx] w-[32rpx]" src="/packages/member/assets/figma/profile/icon-section-identity.png" />
      <text class="absolute left-[64rpx] top-[936rpx] text-[32rpx] font-semibold leading-[44.8rpx] text-ink">当前身份状态</text>

      <view wx:for="{{figma.statuses}}" wx:key="index" class="absolute h-[56rpx] w-[164rpx] flex items-center justify-center rounded-[16rpx] {{item.active ? 'bg-brand' : 'bg-panel'}}" style="left:{{item.leftRpx}}rpx;top:{{item.topRpx}}rpx">
        <text class="{{item.active ? 'text-[28rpx] leading-[40rpx] text-canvas' : 'text-[28rpx] leading-[40rpx] text-muted'}}">{{item.label}}</text>
      </view>

      <image class="absolute left-[24rpx] top-[1164rpx] h-[32rpx] w-[32rpx]" src="/packages/member/assets/figma/profile/icon-section-intro.png" />
      <text class="absolute left-[64rpx] top-[1156rpx] text-[32rpx] font-semibold leading-[44.8rpx] text-ink">一句话介绍你的工作和背景</text>

      <view class="absolute left-[24rpx] top-[1224rpx] h-[200rpx] w-[702rpx] rounded-[16rpx] bg-panel">
        <text wx:if="{{figma.intro}}" class="absolute left-[24rpx] top-[16rpx] text-[28rpx] leading-[40rpx] text-ink">{{figma.intro}}</text>
        <text wx:else class="absolute left-[24rpx] top-[16rpx] text-[28rpx] leading-[40rpx] text-muted">示例：MIP 创意社群创始人，寻找永创意做生意的伙伴</text>
        <text class="absolute bottom-[24rpx] right-[24rpx] text-[20rpx] leading-[28rpx] text-muted">0/300</text>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="bg-brand px-3 py-2 text-center text-[length:24rpx] text-on-brand">资料用于个人名片和公开档案展示</view>
    <view wx:if="{{aiOrganizationDraftLoaded}}" class="mx-3 mt-3 rounded-[16rpx] border border-line bg-panel px-4 py-3 text-[length:22rpx] leading-6 text-muted">草稿中的公司和组织信息会随本次保存同步更新，可在名片编辑中继续调整。</view>
    <view wx:if="{{message}}" data-profile-message="true" class="mx-3 mt-3 rounded-[16rpx] border border-line bg-panel-raised px-4 py-3 text-[length:24rpx] leading-6">{{message}}</view>

    <view class="mx-3 mt-3 flex items-center gap-2 text-[length:30rpx] font-semibold">
      <t-icon name="user-avatar" size="30rpx" color="var(--color-brand)" />
      <text>基础信息</text>
    </view>
    <view data-profile-basic-group="true" class="mx-3 mt-3 overflow-hidden rounded-[16rpx] bg-panel">
      <view data-profile-basic-row="avatar" class="flex min-h-[160rpx] items-center justify-between px-3 py-2">
        <button plain open-type="chooseAvatar" class="m-0 flex h-[112rpx] w-[112rpx] shrink-0 items-center justify-center overflow-hidden rounded-full border-0 bg-panel-raised p-0 leading-[112rpx]" disabled="{{avatarUploading || saving}}" bindchooseavatar="chooseAvatar">
          <image wx:if="{{avatarUrl}}" class="h-full w-full" mode="aspectFill" src="{{avatarUrl}}" />
          <t-icon wx:else name="user-avatar" size="56rpx" color="var(--color-muted)" />
        </button>
        <view class="text-[length:24rpx] text-muted">{{avatarUploading ? '头像上传中' : avatarPending ? '保存后生效' : '更换头像'}}</view>
      </view>
      <view data-profile-basic-row="nickname" class="flex min-h-[92rpx] items-center border-t border-line px-3">
        <view class="w-[120rpx] shrink-0 text-[length:24rpx] font-medium">昵称 <text class="text-[length:22rpx] text-danger">*</text></view>
        <input aria-label="昵称" class="h-[92rpx] min-w-0 flex-1 text-right text-[length:24rpx]" type="nickname" maxlength="64" value="{{nickname}}" data-field="nickname" bindinput="updateText" bindblur="updateText" placeholder="请输入您的昵称" placeholder-style="color:#B3B3B3;text-align:right" />
      </view>
      <view data-profile-basic-row="realName" class="flex min-h-[92rpx] items-center border-t border-line px-3">
        <view class="w-[120rpx] shrink-0 text-[length:24rpx] font-medium">姓名</view>
        <input aria-label="姓名" class="h-[92rpx] min-w-0 flex-1 text-right text-[length:24rpx]" maxlength="64" value="{{realName}}" data-field="realName" bindinput="updateText" placeholder="请输入您的姓名" placeholder-style="color:#B3B3B3;text-align:right" />
      </view>
      <view data-profile-basic-row="gender" class="flex min-h-[92rpx] items-center border-t border-line px-3">
        <view class="w-[120rpx] shrink-0 text-[length:24rpx] font-medium">性别</view>
        <radio-group class="flex min-w-0 flex-1 justify-end gap-2" bindchange="changeGender">
          <label wx:for="{{genderOptions}}" wx:key="value" class="flex min-h-[52rpx] items-center gap-1 rounded-full border px-2 text-[length:22rpx] {{gender === item.value ? 'border-brand bg-brand-soft text-brand' : 'border-line text-muted'}}">
            <radio class="hidden" value="{{item.value}}" checked="{{gender === item.value}}" color="#FCDF03" />
            <t-icon wx:if="{{item.value === 'MALE'}}" name="gender-male" size="26rpx" color="{{gender === item.value ? 'var(--color-brand)' : 'var(--color-muted)'}}" />
            <t-icon wx:elif="{{item.value === 'FEMALE'}}" name="gender-female" size="26rpx" color="{{gender === item.value ? 'var(--color-brand)' : 'var(--color-muted)'}}" />
            <text>{{item.label}}</text>
          </label>
        </radio-group>
      </view>
    </view>

    <view class="mx-3 mt-5 flex items-center gap-2 text-[length:30rpx] font-semibold">
      <t-icon name="file-edit" size="30rpx" color="var(--color-brand)" />
      <text>代表行业</text>
    </view>
    <view class="mx-3 mt-3 overflow-hidden rounded-[16rpx] bg-panel">
      <view data-catalog="industry" class="flex min-h-[92rpx] items-center justify-between gap-3 px-3" bind:tap="toggleCatalog">
        <text class="min-w-0 flex-1 truncate text-[length:24rpx] {{industryOptions[industryIndex].id ? 'text-ink' : 'text-muted'}}">{{industryOptions[industryIndex].id ? industryOptions[industryIndex].label : '请选择代表的行业标签'}}</text>
        <mip-icon name="chevron-down-1" size="{{14}}" color="var(--color-muted)" />
      </view>
      <view wx:if="{{industryCatalogExpanded}}" class="border-t border-line px-3 py-3"><mip-catalog-selector groups="{{industryGroups}}" selected-ids="{{selectedIndustryIds}}" multiple="{{false}}" clear-label="未选择" bind:change="changeIndustry" /></view>
    </view>

    <view class="mx-3 mt-5 flex items-center gap-2 text-[length:30rpx] font-semibold">
      <t-icon name="usergroup" size="30rpx" color="var(--color-brand)" />
      <text>当前身份状态</text>
    </view>
    <view class="mx-3 mt-3 flex flex-wrap gap-2">
      <block wx:for="{{careerIdentityOptions}}" wx:key="value">
        <view data-value="{{item.value}}" aria-role="radio" aria-checked="{{careerIdentityKey === item.value}}" class="flex items-center justify-center min-h-[88rpx] rounded-[8rpx] border px-3 py-1 text-[length:24rpx] {{careerIdentityKey === item.value ? 'border-brand bg-brand-soft text-brand' : 'border-transparent bg-panel text-muted'}}" bind:tap="chooseCareerIdentity">{{item.label}}</view>
      </block>
    </view>

    <view class="mx-3 mt-5 flex items-center gap-2 text-[length:30rpx] font-semibold">
      <mip-icon name="file-text" size="{{15}}" color="var(--color-brand)" />
      <text>一句话介绍你的工作和背景</text>
    </view>
    <view class="mx-3 mt-3 rounded-[16rpx] bg-panel px-3 py-3">
      <textarea aria-label="个人简介" class="block h-[176rpx] w-full max-w-full box-border bg-transparent text-[length:24rpx] leading-6" maxlength="160" value="{{headline}}" data-field="headline" bindinput="updateText" placeholder="例如：品牌主理人，寻找一起做项目的伙伴" placeholder-style="color:#B3B3B3" />
      <view class="text-right text-[length:22rpx] text-muted">{{headline.length}}/160</view>
    </view>

    <view data-profile-more-toggle="true" class="mx-3 mt-5 flex min-h-[92rpx] items-center justify-between rounded-[16rpx] bg-panel px-3" bind:tap="toggleMore">
      <view class="flex items-center gap-2 text-[length:28rpx] font-semibold">
        <t-icon name="view-list" size="28rpx" color="var(--color-brand)" />
        <text>更多资料</text>
      </view>
      <t-icon name="{{moreExpanded ? 'chevron-up' : 'chevron-down'}}" size="28rpx" color="var(--color-muted)" />
    </view>

    <block wx:if="{{moreExpanded}}">
    <view class="mx-3 mt-5 flex items-center gap-2 text-[length:30rpx] font-semibold">
      <mip-icon name="icon-map-pin-line" size="{{15}}" color="var(--color-brand)" />
      <text>主城市分会</text>
    </view>
    <view wx:if="{{branchGroups.length}}" class="mx-3 mt-3 overflow-hidden rounded-[16rpx] bg-panel">
      <view data-catalog="branch" class="flex min-h-[92rpx] items-center justify-between gap-3 px-3" bind:tap="toggleCatalog">
        <text class="min-w-0 flex-1 truncate text-[length:24rpx] {{branchOptions[branchIndex].id ? 'text-ink' : 'text-muted'}}">{{branchOptions[branchIndex].id ? branchOptions[branchIndex].label : '请选择主城市分会'}}</text>
        <mip-icon name="chevron-down-1" size="{{14}}" color="var(--color-muted)" />
      </view>
      <view wx:if="{{branchCatalogExpanded}}" class="border-t border-line px-3 py-3"><mip-catalog-selector groups="{{branchGroups}}" selected-ids="{{selectedBranchIds}}" multiple="{{false}}" clear-label="未选择" bind:change="changeBranch" /></view>
    </view>
    <view wx:else class="mx-3 mt-3 rounded-[16rpx] bg-panel px-3 py-3 text-[length:24rpx] text-muted">城市分会暂未配置，请稍后再试。</view>

    <block wx:if="{{abilityOptions.length}}">
      <view class="mx-3 mt-5 flex items-center gap-2 text-[length:30rpx] font-semibold">
        <t-icon name="tag" size="30rpx" color="var(--color-brand)" />
        <text>能力标签</text>
      </view>
      <view class="mx-3 mt-3 flex flex-wrap gap-2">
        <block wx:for="{{abilityOptions}}" wx:key="id">
          <view wx:if="{{item.selected}}" data-id="{{item.id}}" aria-role="checkbox" aria-checked="{{item.selected}}" class="flex items-center justify-center min-h-[88rpx] rounded-[8rpx] border border-brand bg-brand-soft px-3 py-1 text-[length:24rpx] text-brand" bind:tap="toggleAbility">{{item.label}}</view>
          <view wx:else data-id="{{item.id}}" aria-role="checkbox" aria-checked="{{item.selected}}" class="flex items-center justify-center min-h-[88rpx] rounded-[8rpx] border border-transparent bg-panel px-3 py-1 text-[length:24rpx] text-muted" bind:tap="toggleAbility">{{item.label}}</view>
        </block>
      </view>
    </block>

    <view class="mx-3 mt-5 flex items-center gap-2 text-[length:30rpx] font-semibold">
      <t-icon name="info-circle" size="30rpx" color="var(--color-brand)" />
      <text>补充资料</text>
    </view>
    <view class="mx-3 mt-3 overflow-hidden rounded-[16rpx] bg-panel">
      <view class="flex min-h-[92rpx] items-center px-3">
        <view class="w-[144rpx] shrink-0 text-[length:24rpx]">身份说明</view>
        <input aria-label="职业身份" class="h-[92rpx] min-w-0 flex-1 text-right text-[length:24rpx]" maxlength="32" value="{{identityStatus}}" data-field="identityStatus" bindinput="updateText" placeholder="例如：创业者" placeholder-style="color:#B3B3B3;text-align:right" />
      </view>
      <view class="border-t border-line px-3 py-3">
        <textarea aria-label="补充介绍" class="block h-[180rpx] w-full max-w-full box-border bg-transparent text-[length:24rpx] leading-6" maxlength="300" value="{{introduction}}" data-field="introduction" bindinput="updateText" placeholder="补充经历、能力和合作方向" placeholder-style="color:#B3B3B3" />
        <view class="text-right text-[length:22rpx] text-muted">{{introduction.length}}/300</view>
      </view>
    </view>

    <view class="mx-3 mt-4 rounded-[16rpx] bg-panel px-4 py-5">
      <view class="text-[length:30rpx] font-semibold">联系方式</view>
      <view class="mt-2 text-[length:22rpx] leading-6 text-muted">{{phoneBound ? '已绑定，可重新授权本人微信手机号。' : '用于活动联系、订单与售后，不会公开展示。'}}</view>
      <button open-type="getPhoneNumber" disabled="{{phoneBinding || saving}}" class="mt-4 flex h-[84rpx] w-full max-w-full box-border items-center justify-center rounded-[16rpx] border border-line bg-panel-raised text-[length:24rpx] font-semibold text-ink disabled:opacity-60" bind:getphonenumber="bindPhone">
        {{phoneBinding ? '正在更新' : phoneBound ? '更换绑定手机号' : '绑定微信手机号'}}
      </button>
    </view>
    </block>

    <mip-sticky-actions>
      <view slot="actions" class="w-full">
        <mip-primary-button
          label="保存资料"
          loading="{{saving}}"
          disabled="{{avatarUploading}}"
          bind:tap="saveProfile"
        />
      </view>
    </mip-sticky-actions>
  </block>
  <app-page-exit />
</view>
