<view id="mip-event-detail-page" class="mip-member-page min-h-screen bg-canvas pb-[calc(env(safe-area-inset-bottom)+160rpx)] text-ink">
  <web-view wx:if="{{onlineMode}}" src="{{onlineUrl}}" binderror="handleOnlineError" />
  <block wx:else>
    <view aria-label="正在加载" aria-busy="true" wx:if="{{state === 'loading'}}" class="mx-3 mt-3 rounded-[16rpx] bg-panel px-4 py-7"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
    <view wx:elif="{{state === 'error'}}" class="mx-3 mt-3"><app-empty-state title="无法打开活动" description="{{message || '请检查网络后重试。'}}" action-text="重新加载" bind:action="retryLoad" /></view>
    <block wx:else>
      <image wx:if="{{event.coverUrl}}" class="h-[422rpx] w-full bg-panel" mode="aspectFill" src="{{event.coverUrl}}" />
      <view wx:else class="flex h-[360rpx] w-full items-center justify-center bg-brand-soft"><t-icon name="calendar" size="80rpx" color="var(--color-brand)" /></view>

      <view class="relative z-10 -mt-[28rpx] px-3">
        <view class="rounded-[16rpx] bg-panel px-3 py-3">
          <view class="flex items-start justify-between gap-3">
            <view class="min-w-0 flex-1">
              <view class="flex flex-wrap gap-2">
                <text class="rounded-[8rpx] bg-panel-raised px-2 py-1 text-[length:22rpx] text-muted">{{event.eventTypeLabel}}</text>
                <text class="rounded-[8rpx] bg-brand px-2 py-1 text-[length:22rpx] font-semibold text-on-brand">{{accessText}}</text>
                <text wx:if="{{event.branchName}}" class="rounded-[8rpx] bg-panel-raised px-2 py-1 text-[length:22rpx] text-muted">{{event.branchName}}</text>
                <text wx:for="{{event.tags}}" wx:for-item="tag" wx:key="*this" class="rounded-[8rpx] bg-panel-raised px-2 py-1 text-[length:22rpx] text-muted">{{tag}}</text>
              </view>
              <view class="mt-3 text-[length:32rpx] font-semibold leading-[1.35]">{{event.title}}</view>
              <view wx:if="{{event.summary}}" class="mt-2 line-clamp-2 text-[length:22rpx] leading-5 text-muted">{{event.summary}}</view>
            </view>
            <view wx:if="{{event.canInteract}}" class="flex min-h-[88rpx] shrink-0 items-center rounded-full bg-brand px-3 text-[length:22rpx] font-semibold text-on-brand" bind:tap="openFeedback">活动反馈</view>
          </view>
          <view class="mt-3 flex min-h-[52rpx] items-center gap-2"><t-icon name="calendar" size="30rpx" color="var(--color-brand)" /><text class="min-w-0 flex-1 text-[length:23rpx]">{{startsText}}<text wx:if="{{endsText}}" class="text-muted"> 至 {{endsText}}</text></text></view>
          <view class="flex min-h-[88rpx] items-center gap-2" bind:tap="openLocation"><t-icon name="location" size="30rpx" color="var(--color-brand)" /><text class="min-w-0 flex-1 text-[length:23rpx]">{{locationText}}</text><text wx:if="{{event.mode !== 'ONLINE' && event.address}}" class="text-[length:22rpx] text-brand">{{hasCoordinates ? '地图' : '复制'}}</text></view>
          <view class="mt-2 flex items-end justify-between border-t border-line pt-3"><text class="text-[length:22rpx] text-muted">{{event.status === 'PUBLISHED' ? '报名进行中' : (event.status === 'ENDED' ? '活动已结束' : '活动已取消')}}</text><text wx:if="{{event.accessType === 'PAID'}}" class="text-[length:36rpx] font-semibold text-brand">{{accessText}}</text></view>
        </view>

        <view class="mt-3 rounded-[16rpx] bg-panel px-3 pb-3 pt-3" bind:tap="openParticipants">
          <view class="flex min-h-[48rpx] items-center justify-between"><text class="text-[length:24rpx] font-semibold text-brand">{{event.registrationCount}} 人参加<text wx:if="{{event.capacity}}"> / 限 {{event.capacity}} 人</text></text><view class="flex items-center gap-1 text-[length:22rpx] text-muted"><text>查看更多</text><t-icon name="chevron-right" size="26rpx" color="var(--color-muted)" /></view></view>
          <view wx:if="{{event.participantPreview.length}}" class="mt-3 flex items-start justify-between gap-2">
            <view wx:for="{{event.participantPreview}}" wx:key="participantRef" class="min-w-0 flex-1 text-center">
              <image wx:if="{{item.avatarUrl}}" class="mx-auto h-[80rpx] w-[80rpx] rounded-full bg-panel-raised" mode="aspectFill" src="{{item.avatarUrl}}" />
              <view wx:else class="mx-auto flex h-[80rpx] w-[80rpx] items-center justify-center rounded-full bg-brand-soft"><t-icon name="user-avatar" size="36rpx" color="var(--color-brand)" /></view>
              <view class="mt-2 truncate text-[length:22rpx] text-muted">{{item.nickname}}</view>
            </view>
          </view>
          <view wx:else class="mt-2 text-[length:22rpx] text-muted">暂无公开参与者资料</view>
        </view>

        <view class="mt-3 flex gap-2">
          <view wx:if="{{contentSection === 'INTRO'}}" class="flex min-h-[88rpx] items-center rounded-[16rpx] bg-brand px-3 text-[length:26rpx] font-semibold text-on-brand" data-section="INTRO" bind:tap="selectContentSection">活动介绍</view>
          <view wx:else class="flex min-h-[88rpx] items-center rounded-[16rpx] bg-panel px-3 text-[length:26rpx] text-muted" data-section="INTRO" bind:tap="selectContentSection">活动介绍</view>
          <view wx:if="{{contentSection === 'ORGANIZER'}}" class="flex min-h-[88rpx] items-center rounded-[16rpx] bg-brand px-3 text-[length:26rpx] font-semibold text-on-brand" data-section="ORGANIZER" bind:tap="selectContentSection">主办方</view>
          <view wx:else class="flex min-h-[88rpx] items-center rounded-[16rpx] bg-panel px-3 text-[length:26rpx] text-muted" data-section="ORGANIZER" bind:tap="selectContentSection">主办方</view>
          <view wx:if="{{contentSection === 'NOTICE'}}" class="flex min-h-[88rpx] items-center rounded-[16rpx] bg-brand px-3 text-[length:26rpx] font-semibold text-on-brand" data-section="NOTICE" bind:tap="selectContentSection">报名须知</view>
          <view wx:else class="flex min-h-[88rpx] items-center rounded-[16rpx] bg-panel px-3 text-[length:26rpx] text-muted" data-section="NOTICE" bind:tap="selectContentSection">报名须知</view>
        </view>

        <view wx:if="{{contentSection === 'INTRO'}}" class="mt-3 rounded-[16rpx] bg-panel px-3 py-3">
          <rich-text class="mip-event-rich-content text-[length:25rpx] leading-7 text-muted" nodes="{{descriptionNodes}}" />
          <view wx:if="{{event.contentMedia.length}}" class="mt-3 flex flex-col gap-3">
            <view wx:for="{{event.contentMedia}}" wx:key="imageUrl">
              <image class="w-full rounded-[12rpx] bg-panel-raised" mode="widthFix" src="{{item.imageUrl}}" data-url="{{item.imageUrl}}" bind:tap="previewContentImage" />
              <view wx:if="{{item.caption}}" class="mt-2 text-center text-[length:22rpx] text-muted">{{item.caption}}</view>
            </view>
          </view>
          <view wx:if="{{!event.description && !event.contentMedia.length}}" class="py-4 text-[length:23rpx] text-muted">暂无活动介绍。</view>
        </view>

        <view wx:elif="{{contentSection === 'ORGANIZER'}}" class="mt-3 rounded-[16rpx] bg-panel px-4 py-4">
          <view wx:if="{{event.organizer}}" class="flex min-h-[104rpx] items-center gap-3" bind:tap="openOrganizer">
            <image wx:if="{{event.organizer.avatarUrl}}" class="h-[88rpx] w-[88rpx] shrink-0 rounded-full bg-panel-raised" mode="aspectFill" src="{{event.organizer.avatarUrl}}" />
            <view wx:else class="flex h-[88rpx] w-[88rpx] shrink-0 items-center justify-center rounded-full bg-brand-soft"><t-icon name="user-avatar" size="40rpx" color="var(--color-brand)" /></view>
            <view class="min-w-0 flex-1"><view class="text-[length:27rpx] font-semibold">{{event.organizer.nickname || 'MIP 用户'}}</view><view wx:if="{{event.organizer.headline}}" class="mt-2 line-clamp-2 text-[length:22rpx] leading-5 text-muted">{{event.organizer.headline}}</view></view>
            <t-icon name="chevron-right" size="30rpx" color="var(--color-muted)" />
          </view>
          <view wx:else class="py-4 text-[length:23rpx] text-muted">主办方资料暂未公开。</view>
        </view>

        <view wx:else class="mt-3 rounded-[16rpx] bg-panel px-4 py-4">
          <view wx:if="{{event.notices}}" class="whitespace-pre-wrap text-[length:24rpx] leading-7 text-muted">{{event.notices}}</view>
          <view wx:else class="py-4 text-[length:23rpx] text-muted">暂无报名须知。</view>
        </view>

        <view wx:if="{{event.videoRecaps.length}}" class="mt-3 rounded-[16rpx] bg-panel px-4 py-4">
          <view class="text-[length:28rpx] font-bold">视频回顾</view>
          <view class="mt-3 flex flex-col gap-2">
            <view wx:for="{{event.videoRecaps}}" wx:key="id" class="flex min-h-[104rpx] items-center gap-3 rounded-[16rpx] bg-panel-raised px-3 py-3 {{videoRecapBusyId ? 'opacity-60' : ''}}" aria-role="button" aria-disabled="{{videoRecapBusyId !== ''}}" data-id="{{item.id}}" bind:tap="openVideoRecap">
              <view class="flex h-[64rpx] w-[64rpx] shrink-0 items-center justify-center rounded-full bg-brand-soft"><t-icon name="play-circle-stroke" size="36rpx" color="var(--color-brand)" /></view>
              <view class="min-w-0 flex-1"><view class="text-[length:25rpx] font-semibold">{{item.title}}</view><view wx:if="{{item.summary}}" class="mt-1 line-clamp-2 text-[length:22rpx] leading-5 text-muted">{{item.summary}}</view></view>
              <view class="flex shrink-0 items-center gap-1 text-[length:22rpx] text-brand"><text>{{videoRecapBusyId === item.id ? '正在打开' : (item.destination.type === 'PROFILE' ? '视频号主页' : '查看回顾')}}</text><t-icon name="chevron-right" size="26rpx" color="var(--color-brand)" /></view>
            </view>
          </view>
        </view>

        <view wx:if="{{event.invitationAttribution}}" class="mt-3 flex min-h-[96rpx] items-center gap-3 rounded-[16rpx] bg-brand-soft px-4 py-3">
          <image wx:if="{{event.invitationAttribution.avatarUrl}}" class="h-[64rpx] w-[64rpx] shrink-0 rounded-full bg-panel" mode="aspectFill" src="{{event.invitationAttribution.avatarUrl}}" />
          <view wx:else class="flex h-[64rpx] w-[64rpx] shrink-0 items-center justify-center rounded-full bg-panel"><image class="h-[46rpx] w-[46rpx]" mode="aspectFit" src="/assets/brand/mip-logo-yellow.png" /></view>
          <view><view class="text-[length:22rpx] text-muted">邀请来源</view><view class="mt-1 text-[length:25rpx] font-semibold">{{event.invitationAttribution.displayName}}</view></view>
        </view>

        <view class="mt-3 flex min-h-[96rpx] items-center gap-3 rounded-[16rpx] bg-panel px-4" bind:tap="openComments"><t-icon name="chat" size="34rpx" color="var(--color-brand)" /><view class="min-w-0 flex-1"><view class="text-[length:25rpx] font-semibold">活动评论</view><view class="mt-1 text-[length:22rpx] text-muted">查看和发布活动评论</view></view><t-icon name="chevron-right" size="32rpx" color="var(--color-muted)" /></view>
        <view wx:if="{{event.albumEnabled}}" class="mt-3 flex min-h-[96rpx] items-center gap-3 rounded-[16rpx] bg-panel px-4" bind:tap="openAlbum"><t-icon name="image" size="34rpx" color="var(--color-brand)" /><view class="min-w-0 flex-1"><view class="text-[length:25rpx] font-semibold">活动相册</view><view class="mt-1 text-[length:22rpx] text-muted">查看活动照片</view></view><t-icon name="chevron-right" size="32rpx" color="var(--color-muted)" /></view>
        <view wx:if="{{event.changes.length}}" class="mt-3 rounded-[16rpx] bg-panel px-4 py-4"><view class="text-[length:28rpx] font-bold">活动变更</view><view wx:for="{{event.changes}}" wx:key="version" class="mt-3 border-l-[4rpx] border-brand pl-3"><view class="text-[length:23rpx]">{{item.summary}}</view><view class="mt-1 text-[length:22rpx] text-muted">{{item.createdAt}}</view></view></view>
        <view wx:if="{{event.onlineAccessAvailable && onlineUrl}}" class="mt-3"><t-button block variant="outline" bind:tap="openOnlineEvent">进入线上活动</t-button></view>
        <view wx:if="{{event.canCheckIn}}" class="mt-3 flex min-h-[96rpx] items-center gap-3 rounded-[16rpx] bg-panel px-4" bind:tap="openCheckIn"><t-icon name="scan" size="34rpx" color="var(--color-brand)" /><view class="min-w-0 flex-1"><view class="text-[length:25rpx] font-semibold">活动签到</view><view class="mt-1 text-[length:22rpx] text-muted">扫描现场活动码完成签到验证</view></view><t-icon name="chevron-right" size="32rpx" color="var(--color-muted)" /></view>
        <view wx:if="{{event.canRetryRefund}}" class="mt-3"><t-button block variant="outline" loading="{{busy}}" bind:tap="cancelRegistration">继续处理退款</t-button></view>
        <view wx:elif="{{event.canCancel}}" class="mt-3"><t-button block variant="outline" theme="danger" loading="{{busy}}" bind:tap="cancelRegistration">取消报名</t-button></view>
        <view id="mip-event-calendar-action" class="mt-3"><t-button block variant="outline" bind:tap="addToCalendar">加入系统日历</t-button></view>
        <view wx:if="{{message}}" class="mt-3 rounded-[16rpx] bg-brand-soft px-4 py-3 text-[length:22rpx] text-brand">{{message}}</view>
        <app-page-exit />
      </view>

      <view id="mip-event-bottom-actions" class="mip-member-fixed-inset fixed bottom-[env(safe-area-inset-bottom)] z-50">
        <view class="box-border flex h-[112rpx] items-center gap-3 rounded-full bg-brand-soft px-3">
          <button id="mip-event-support-action" aria-label="联系客服" class="m-0 flex h-[88rpx] w-[120rpx] shrink-0 items-center justify-center border-0 bg-transparent p-0 leading-none after:border-0" bind:tap="callSupport"><view id="mip-event-support-surface" class="box-border flex h-[80rpx] w-[120rpx] items-center justify-center rounded-full border border-black bg-panel"><image class="h-[48rpx] w-[48rpx]" mode="aspectFit" src="/assets/figma/events/customer-service.svg" /></view></button>
          <button id="mip-event-share-action" aria-label="分享活动" class="m-0 flex h-[88rpx] w-[120rpx] shrink-0 items-center justify-center border-0 bg-transparent p-0 leading-none after:border-0" bind:tap="openShare"><view id="mip-event-share-surface" class="box-border flex h-[80rpx] w-[120rpx] items-center justify-center rounded-full border border-black bg-panel"><image class="h-[48rpx] w-[48rpx]" mode="aspectFit" src="/assets/figma/events/share-circle.svg" /></view></button>
          <button id="mip-event-primary-action" class="m-0 flex h-[88rpx] min-w-0 flex-1 items-center justify-center border-0 bg-transparent p-0 leading-none after:border-0" loading="{{busy}}" aria-disabled="{{primaryAction === 'disabled' || busy}}" bind:tap="handlePrimary"><view id="mip-event-primary-surface" class="box-border flex h-[80rpx] w-full items-center justify-center rounded-full border border-black bg-brand text-[length:32rpx] font-semibold text-on-brand">{{primaryLabel}}</view></button>
        </view>
      </view>

      <t-popup
        visible="{{shareOpen}}"
        placement="bottom"
        prevent-scroll-through
        close-on-overlay-click="{{true}}"
        overlay-props="{{shareOverlayProps}}"
        custom-style="--td-popup-bg-color: #080808; --td-popup-border-radius: 16rpx;"
        bind:visible-change="handleShareVisibility"
      >
        <view id="mip-event-share-sheet" class="box-border h-[836rpx] w-full max-w-full rounded-t-[16rpx] bg-[#080808] px-3 pt-3 text-ink">
          <view id="mip-event-share-actions" class="box-border h-[496rpx] rounded-[16rpx] bg-panel px-3 py-3">
            <view class="text-[length:28rpx] font-medium leading-[40rpx]">分享活动</view>
            <view class="mt-2 truncate text-[length:32rpx] font-medium leading-[44rpx]">{{event.title}}</view>
            <view class="mt-3 flex flex-col gap-3">
              <button id="mip-event-wechat-share" open-type="share" disabled="{{invitationLoading}}" aria-label="微信分享" class="m-0 box-border flex h-[92rpx] w-full max-w-full items-center justify-center gap-2 rounded-[16rpx] border-0 bg-[#087f42] p-0 text-[length:28rpx] font-medium leading-[40rpx] text-white after:border-0">
                <image class="h-[48rpx] w-[48rpx] shrink-0" mode="aspectFit" src="/assets/figma/events/wechat.svg" />
                <text>{{invitationLoading ? '正在准备分享' : '微信分享'}}</text>
              </button>
              <button id="mip-event-copy-link" aria-label="复制链接" class="m-0 box-border flex h-[92rpx] w-full max-w-full items-center justify-center gap-2 rounded-[16rpx] border-0 bg-[#155dcc] p-0 text-[length:28rpx] font-medium leading-[40rpx] text-white after:border-0" bind:tap="copyEventLink">
                <image class="h-[48rpx] w-[48rpx] shrink-0" mode="aspectFit" src="/assets/figma/events/link.svg" />
                <text>复制链接</text>
              </button>
              <button id="mip-event-download-code" aria-label="下载活动二维码" class="m-0 box-border flex h-[92rpx] w-full max-w-full items-center justify-center gap-2 rounded-[16rpx] border-0 bg-brand p-0 text-[length:28rpx] font-medium leading-[40rpx] text-on-brand after:border-0" disabled="{{posterBusy}}" bind:tap="downloadInvitationCode">
                <image class="h-[48rpx] w-[48rpx] shrink-0" mode="aspectFit" src="/assets/figma/events/qr-code.svg" />
                <text>{{posterBusy ? '正在生成活动二维码' : '下载活动二维码'}}</text>
              </button>
            </view>
          </view>

          <view id="mip-event-share-copy" class="relative mt-3 box-border h-[292rpx] rounded-[16rpx] bg-panel px-3 py-3">
            <view class="text-[length:28rpx] font-medium leading-[40rpx]">分享文案</view>
            <button id="mip-event-copy-text" aria-label="复制分享文案" class="absolute right-[-4rpx] top-[-4rpx] m-0 flex h-[88rpx] w-[88rpx] items-center justify-center border-0 bg-transparent p-0 leading-none after:border-0" bind:tap="copyShareText">
              <image class="h-[32rpx] w-[32rpx]" mode="aspectFit" src="/assets/figma/events/copy.svg" />
            </button>
            <view class="mt-2 truncate text-[length:32rpx] font-medium leading-[44rpx]">{{event.title}}</view>
            <view class="mt-2 truncate text-[length:24rpx] leading-[34rpx]">时间：{{shareTimeText}}</view>
            <view class="mt-[10rpx] truncate text-[length:24rpx] leading-[34rpx]">地址：{{locationText}}</view>
            <view class="mt-2 flex min-w-0 items-center text-[length:24rpx] leading-[34rpx]"><text class="shrink-0">报名链接：</text><text class="min-w-0 flex-1 truncate text-[#428bff]">MIP 小程序活动详情</text></view>
          </view>
        </view>
      </t-popup>
      <canvas id="mip-event-invitation-poster-canvas" type="2d" class="fixed left-[-9999px] top-0 h-[560px] w-[375px]"></canvas>
    </block>
    <app-page-exit wx:if="{{state !== 'ready'}}" />
  </block>
</view>
