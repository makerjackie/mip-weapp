<view id="mip-event-check-in-page" class="mip-member-page min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+40rpx)] pt-12 text-ink">
  <view class="rounded-[16rpx] bg-panel px-5 py-8 text-center">
    <view class="mx-auto flex h-[96rpx] w-[96rpx] items-center justify-center rounded-full bg-brand-soft"><t-icon name="scan" size="52rpx" color="var(--color-brand)" /></view>
    <view class="mt-5 text-[length:32rpx] font-bold">活动签到</view>
    <view wx:if="{{state === 'idle'}}" class="mt-3 text-[length:24rpx] leading-6 text-muted">扫描现场活动码后会核对身份、报名资格和签到时间。</view>
    <view wx:elif="{{state === 'checking'}}" class="mt-5 rounded-[12rpx] bg-panel-raised px-4 py-4"><t-skeleton row-col="{{[1,1]}}" theme="paragraph" animation="gradient" loading /></view>
    <view wx:elif="{{state === 'success'}}" class="mt-3 text-[length:24rpx] leading-6 text-success">签到成功</view>
    <view wx:else class="mt-3 text-[length:24rpx] leading-6 text-danger">{{message}}</view>
    <view wx:if="{{state === 'registration-required'}}" class="mt-6 flex flex-col gap-3"><t-button block size="large" theme="primary" bind:tap="openRegistration">前往报名</t-button><t-button block variant="outline" theme="default" bind:tap="scanAnother">重新扫码</t-button></view>
    <view wx:elif="{{state === 'registration-pending'}}" class="mt-6 flex flex-col gap-3"><t-button block size="large" theme="primary" bind:tap="retryRegistration">重新核对报名</t-button><t-button block variant="outline" theme="default" bind:tap="openMyEvents">查看我的活动</t-button></view>
    <view wx:elif="{{state === 'idle' || state === 'error'}}" class="mt-6"><t-button block size="large" theme="primary" bind:tap="scanCode">{{hasScanToken ? '确认签到' : '扫描活动码'}}</t-button></view>
    <view wx:if="{{state === 'success'}}" class="mt-6"><t-button block size="large" theme="primary" bind:tap="openInteraction">与你互动</t-button></view>
  </view>
  <view class="mt-4 rounded-[16rpx] bg-panel px-4 py-3 text-[length:21rpx] leading-5 text-muted">活动码可能被转发，签到仍会核对报名资格和活动时间。请仅在现场使用。</view>
  <app-page-exit />
</view>
