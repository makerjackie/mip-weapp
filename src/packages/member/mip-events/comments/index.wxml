<view id="mip-event-comments-page" class="mip-member-page min-h-screen bg-canvas px-3 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-3 text-ink">
  <view wx:if="{{state === 'loading'}}" class="rounded-[16rpx] bg-panel px-4 py-7"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'access'}}">
    <app-empty-state title="完成身份信息后查看评论" description="活动评论需要确认协议、手机号、昵称和主分会。" action-text="继续" bind:action="openAccess" />
    <app-page-exit />
  </view>
  <view wx:elif="{{state === 'error'}}">
    <app-empty-state title="暂时无法加载评论" description="{{message || '请检查网络后重试。'}}" action-text="重新加载" bind:action="retry" />
    <app-page-exit />
  </view>
  <block wx:else>
    <view class="rounded-[16rpx] bg-panel px-4 py-4">
      <view class="text-[length:30rpx] font-semibold">{{eventTitle || '活动评论'}}</view>
      <view class="mt-2 text-[length:21rpx] text-muted">{{eventStatus === 'PUBLISHED' ? '活动进行中' : eventStatus === 'ENDED' ? '活动已结束' : '活动已取消'}}</view>
    </view>

    <view wx:if="{{commentsEnabled}}" class="mt-3 rounded-[16rpx] bg-panel px-4 py-4">
      <view class="flex items-center justify-between gap-3">
        <view class="text-[length:27rpx] font-semibold">{{editingCommentId ? '编辑评论' : '发表评论'}}</view>
        <view wx:if="{{editingCommentId}}" class="flex min-h-[64rpx] items-center px-2 text-[length:22rpx] text-muted" bind:tap="cancelEdit">取消编辑</view>
      </view>
      <view class="mt-2 text-[length:21rpx] leading-5 text-muted">{{editingCommentId ? '评论发布后 30 分钟内可以编辑。' : moderationMode === 'REVIEW' ? '评论提交后由运营人员审核。' : '评论通过内容安全检查后发布。'}}</view>
      <t-textarea class="mt-3" value="{{draft}}" placeholder="填写活动评论" maxlength="800" disabled="{{submitting}}" bind:change="updateDraft" />
      <view class="mt-3"><t-button block theme="primary" loading="{{submitting}}" disabled="{{!draft || submitting}}" bind:tap="submitComment">{{editingCommentId ? '保存修改' : '提交评论'}}</t-button></view>
    </view>
    <view wx:else class="mt-3 rounded-[16rpx] bg-panel px-4 py-4 text-[length:23rpx] text-muted">当前活动已关闭评论。</view>

    <view class="mt-5 flex min-h-[64rpx] items-center justify-between">
      <view class="text-[length:29rpx] font-semibold">全部评论</view>
      <view class="text-[length:21rpx] text-muted">{{comments.length}} 条已加载</view>
    </view>

    <app-empty-state wx:if="{{comments.length === 0}}" title="暂无评论" description="已发布的评论会显示在这里。" />
    <view wx:else class="flex flex-col gap-3">
      <view wx:for="{{comments}}" wx:key="id" class="rounded-[16rpx] bg-panel px-4 py-4">
        <view class="flex items-center gap-3" data-id="{{item.id}}" bind:tap="openAuthor">
          <image wx:if="{{item.author.avatarUrl}}" class="h-[72rpx] w-[72rpx] shrink-0 rounded-full bg-panel-raised" mode="aspectFill" src="{{item.author.avatarUrl}}" />
          <view wx:else class="flex h-[72rpx] w-[72rpx] shrink-0 items-center justify-center rounded-full bg-brand-soft"><t-icon name="user-avatar" size="34rpx" color="var(--color-brand)" /></view>
          <view class="min-w-0 flex-1">
            <view class="truncate text-[length:24rpx] font-semibold">{{item.author.nickname}}</view>
            <view class="mt-1 text-[length:20rpx] text-muted">{{item.createdText}}<text wx:if="{{item.statusText}}"> · {{item.statusText}}</text></view>
          </view>
          <t-icon name="chevron-right" size="28rpx" color="var(--color-muted)" />
        </view>
        <view class="mt-3 whitespace-pre-wrap text-[length:25rpx] leading-[1.65]">{{item.body}}</view>
        <view class="mt-3 flex min-h-[64rpx] items-center justify-end gap-4 text-[length:21rpx]">
          <text wx:if="{{item.canEdit}}" class="text-brand" data-id="{{item.id}}" bind:tap="startEdit">编辑</text>
          <text wx:if="{{item.canDelete}}" class="text-danger" data-id="{{item.id}}" bind:tap="deleteComment">删除</text>
          <text wx:if="{{!item.mine}}" class="text-muted" data-id="{{item.id}}" bind:tap="reportComment">举报</text>
        </view>
      </view>
    </view>

    <view wx:if="{{nextCursor}}" class="mt-4"><t-button block variant="outline" loading="{{loadingMore}}" disabled="{{loadingMore}}" bind:tap="loadMore">加载更多</t-button></view>
    <view wx:if="{{message}}" class="mt-4 rounded-[16rpx] bg-brand-soft px-4 py-3 text-[length:22rpx] text-brand">{{message}}</view>
    <app-page-exit />
  </block>
</view>
