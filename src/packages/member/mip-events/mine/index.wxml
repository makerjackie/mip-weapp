<view id="mip-events-mine-page" class="mip-member-page min-h-screen bg-canvas pb-[calc(env(safe-area-inset-bottom)+40rpx)] text-ink">
  <view class="px-4 pt-4 text-center text-[length:34rpx] font-bold">我的活动</view>
  <view class="mt-3 grid grid-cols-2 border-b border-line text-center text-[length:25rpx]">
    <view wx:if="{{activeCategory === 'UPCOMING'}}" class="min-h-[76rpx] border-b-[4rpx] border-brand py-3 font-medium text-brand" data-category="UPCOMING" bind:tap="changeCategory">待参加({{counts.upcoming}})</view>
    <view wx:else class="min-h-[76rpx] border-b-[4rpx] border-transparent py-3 text-muted" data-category="UPCOMING" bind:tap="changeCategory">待参加({{counts.upcoming}})</view>
    <view wx:if="{{activeCategory === 'ATTENDED'}}" class="min-h-[76rpx] border-b-[4rpx] border-brand py-3 font-medium text-brand" data-category="ATTENDED" bind:tap="changeCategory">已参加({{counts.attended}})</view>
    <view wx:else class="min-h-[76rpx] border-b-[4rpx] border-transparent py-3 text-muted" data-category="ATTENDED" bind:tap="changeCategory">已参加({{counts.attended}})</view>
  </view>

  <view wx:if="{{state === 'loading'}}" class="mx-3 mt-4 rounded-[16rpx] bg-panel px-4 py-7"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}" class="mx-3 mt-5"><app-empty-state title="暂时无法加载活动" description="{{message || '请稍后重试。'}}" action-text="重新加载" bind:action="loadRegistrations" /></view>
  <view wx:elif="{{registrations.length === 0}}" class="mx-3 mt-5"><app-empty-state title="{{activeCategory === 'UPCOMING' ? '暂无待参加活动' : '暂无已参加活动'}}" description="{{activeCategory === 'UPCOMING' ? '报名确认后的活动会显示在这里。' : '完成签到的活动会显示在这里。'}}" /></view>
  <view wx:else class="mx-3 mt-4 flex flex-col gap-3">
    <view wx:for="{{registrations}}" wx:key="registrationId" class="overflow-hidden rounded-[16rpx] bg-panel" data-event-id="{{item.event.id}}" data-status="{{item.status}}" bind:tap="openRegistration">
      <image wx:if="{{item.event.coverUrl}}" class="h-[282rpx] w-full bg-brand-soft" mode="aspectFill" src="{{item.event.coverUrl}}" />
      <view wx:else class="flex h-[282rpx] w-full items-center justify-center bg-brand-soft"><t-icon name="calendar" size="64rpx" color="var(--color-brand)" /></view>
      <view class="relative px-3 pb-3 pt-3">
        <view class="flex items-start justify-between gap-3"><view class="line-clamp-2 min-w-0 flex-1 text-[length:28rpx] font-bold">{{item.event.title}}</view><view class="shrink-0 rounded-full bg-brand px-3 py-1 text-[length:20rpx] text-on-brand">{{item.statusText}}</view></view>
        <view wx:if="{{item.startsText}}" class="mt-3 flex items-center text-[length:22rpx] text-muted"><t-icon class="mr-2" name="calendar" size="28rpx" color="var(--color-brand)" />{{item.startsText}}</view>
        <view wx:if="{{item.locationText}}" class="mt-2 flex items-start text-[length:22rpx] leading-5 text-muted"><t-icon class="mr-2 shrink-0" name="location" size="28rpx" color="var(--color-brand)" /><text>{{item.locationText}}</text></view>
        <view class="mt-3 flex items-center justify-between gap-3">
          <view class="flex min-w-0 items-center">
            <view wx:if="{{item.event.participantPreview.length}}" class="mr-2 flex shrink-0"><block wx:for="{{item.event.participantPreview}}" wx:for-item="person" wx:key="participantRef"><image wx:if="{{person.avatarUrl}}" class="-mr-2 h-[44rpx] w-[44rpx] rounded-full border-2 border-panel bg-panel-raised" src="{{person.avatarUrl}}" mode="aspectFill" /><view wx:else class="-mr-2 flex h-[44rpx] w-[44rpx] items-center justify-center rounded-full border-2 border-panel bg-brand-soft text-[length:16rpx] text-brand">MIP</view></block></view>
            <text wx:if="{{item.participantCountText}}" class="truncate text-[length:20rpx] text-muted">{{item.participantCountText}}</text>
          </view>
          <view class="flex shrink-0 gap-2"><text class="rounded-[8rpx] bg-brand-soft px-2 py-1 text-[length:18rpx] text-brand">{{item.accessText}}</text><text wx:if="{{item.event.branchName}}" class="rounded-[8rpx] bg-panel-raised px-2 py-1 text-[length:18rpx] text-muted">{{item.event.branchName}}</text></view>
        </view>
      </view>
      <view wx:if="{{item.status === 'PAYMENT_PENDING'}}" class="border-t border-line px-3 py-2 text-[length:21rpx] text-muted">支付确认前不会生成报名资格。</view>
      <view wx:if="{{item.orderId || item.canEdit || item.canCancel || item.canRetryRefund}}" class="border-t border-line px-3 py-3">
        <view class="flex flex-wrap gap-2">
          <t-button wx:if="{{item.orderId}}" size="small" variant="outline" data-order-id="{{item.orderId}}" catch:tap="openOrder">查看订单详情</t-button>
          <t-button wx:if="{{item.canEdit}}" size="small" variant="outline" data-event-id="{{item.event.id}}" catch:tap="editRegistration">修改报名</t-button>
          <t-button wx:if="{{item.canRetryRefund}}" size="small" variant="outline" loading="{{cancelingId === item.registrationId}}" data-event-id="{{item.event.id}}" data-registration-id="{{item.registrationId}}" data-version="{{item.version}}" data-refund-retry="{{true}}" catch:tap="cancelRegistration">继续处理退款</t-button>
          <t-button wx:elif="{{item.canCancel}}" size="small" variant="outline" theme="danger" loading="{{cancelingId === item.registrationId}}" data-event-id="{{item.event.id}}" data-registration-id="{{item.registrationId}}" data-version="{{item.version}}" catch:tap="cancelRegistration">取消报名</t-button>
        </view>
      </view>
    </view>
    <view wx:if="{{nextCursor}}" class="py-4"><t-button block variant="outline" loading="{{loadingMore}}" bind:tap="loadMore">加载更多</t-button></view>
  </view>
  <view wx:if="{{message && state !== 'error'}}" class="mx-3 mt-4 rounded-[16rpx] bg-brand-soft px-4 py-3 text-[length:22rpx] text-brand">{{message}}</view>
  <app-page-exit />
</view>
