<view id="mip-event-registration-page" class="mip-member-page min-h-screen bg-canvas px-3 pb-[calc(env(safe-area-inset-bottom)+176rpx)] pt-3 text-ink">
  <view wx:if="{{state === 'loading'}}" class="rounded-[16rpx] bg-panel px-4 py-7"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}"><app-empty-state title="无法打开报名" description="{{message || '请稍后重试。'}}" action-text="重新加载" bind:action="loadEvent" /><app-page-exit /></view>
  <view wx:elif="{{state === 'blocked'}}"><app-empty-state title="{{editing ? '当前不能修改报名' : '当前不能报名'}}" description="{{message}}" action-text="查看我的活动" bind:action="openMine" /><app-page-exit /></view>
  <view wx:elif="{{state === 'submitted'}}" class="pt-10">
    <view class="rounded-[16rpx] bg-panel px-5 py-8 text-center">
      <view class="mx-auto flex h-[88rpx] w-[88rpx] items-center justify-center rounded-full bg-brand-soft"><t-icon name="check" size="48rpx" color="var(--color-brand)" /></view>
      <view class="mt-5 text-[length:32rpx] font-bold">{{resultTitle}}</view>
      <view class="mt-3 text-[length:24rpx] leading-6 text-muted">{{resultDescription}}</view>
      <view wx:if="{{event.invitationAttribution}}" class="mt-5 flex min-h-[96rpx] items-center gap-3 rounded-[16rpx] bg-brand-soft px-4 text-left">
        <image wx:if="{{event.invitationAttribution.avatarUrl}}" class="h-[64rpx] w-[64rpx] rounded-full" mode="aspectFill" src="{{event.invitationAttribution.avatarUrl}}" />
        <view wx:else class="flex h-[64rpx] w-[64rpx] items-center justify-center rounded-full bg-panel"><image class="h-[46rpx] w-[46rpx]" mode="aspectFit" src="/assets/brand/mip-logo-yellow.png" /></view>
        <view><view class="text-[length:20rpx] text-muted">邀请来源</view><view class="mt-1 text-[length:24rpx] font-semibold">{{event.invitationAttribution.displayName}}</view></view>
      </view>
      <view wx:if="{{canContinueCheckIn}}" class="mt-6"><t-button block size="large" theme="primary" bind:tap="continueCheckIn">继续签到</t-button></view>
      <view wx:elif="{{resumeCheckIn && orderId}}" class="mt-6"><t-button block size="large" theme="primary" loading="{{checkingRegistration}}" bind:tap="retryRegistration">重新核对报名</t-button></view>
      <view wx:if="{{orderId}}" class="mt-3"><t-button block variant="{{canContinueCheckIn ? 'outline' : 'base'}}" size="large" theme="{{canContinueCheckIn ? 'default' : 'primary'}}" bind:tap="openOrder">查看订单详情</t-button></view>
      <view class="mt-3"><t-button block variant="{{canContinueCheckIn || orderId ? 'text' : 'base'}}" size="large" theme="{{canContinueCheckIn || orderId ? 'default' : 'primary'}}" bind:tap="openMine">查看我的活动</t-button></view>
    </view>
    <app-page-exit />
  </view>
  <block wx:else>
    <image wx:if="{{event.coverUrl}}" class="mb-3 h-[298rpx] w-full rounded-[16rpx] bg-panel" mode="aspectFill" src="{{event.coverUrl}}" />
    <view class="rounded-[16rpx] bg-panel px-4 py-4">
      <view class="flex flex-wrap gap-2"><text class="rounded-[8rpx] bg-brand px-2 py-1 text-[length:20rpx] font-semibold text-on-brand">{{accessText}}</text><text class="rounded-[8rpx] bg-panel-raised px-2 py-1 text-[length:20rpx] text-muted">{{event.eventTypeLabel}}</text></view>
      <view class="mt-3 text-[length:32rpx] font-semibold leading-[1.35]">{{event.title}}</view>
      <view class="mt-3 flex items-center justify-between border-t border-line pt-3"><text class="text-[length:22rpx] text-muted">{{editing ? '修改已有报名' : '确认本次报名信息'}}</text><text class="text-[length:24rpx] font-semibold text-brand">{{priceText}}</text></view>
    </view>
    <view id="event-registration-feedback" wx:if="{{message}}" class="mt-3 rounded-[16rpx] border border-line bg-panel-raised px-4 py-3 text-[length:22rpx] leading-5 text-ink">{{message}}</view>

    <view class="mt-3 rounded-[16rpx] bg-panel px-4 py-4">
      <view class="flex items-center justify-between"><view class="text-[length:26rpx] font-semibold">报名资料</view><view class="flex min-h-[64rpx] items-center px-2 text-[length:22rpx] text-brand" bind:tap="openProfile">修改资料</view></view>
      <view class="mt-3 text-[length:26rpx]">{{profileNickname || '资料加载中'}}</view>
      <view class="mt-2 flex flex-wrap gap-2 text-[length:21rpx] text-muted"><text class="rounded-[12rpx] bg-panel-raised px-2 py-1">{{profilePhoneText || '手机号状态加载中'}}</text><text class="rounded-[12rpx] bg-panel-raised px-2 py-1">{{profileBranchText || '主分会状态加载中'}}</text></view>
    </view>

    <view class="mt-5 text-[length:30rpx] font-bold">{{editing ? '修改报名' : '确认报名'}}</view>
    <view wx:if="{{fields.length === 0}}" class="mt-3 rounded-[16rpx] bg-panel px-4 py-5 text-[length:23rpx] text-muted">本场活动没有额外报名问题。</view>
    <view wx:else class="mt-3 flex flex-col gap-3">
      <view wx:for="{{fields}}" wx:key="key" id="registration-field-{{index}}" class="rounded-[16rpx] bg-panel px-4 py-4">
        <view class="text-[length:24rpx] font-semibold">{{item.label}}<text wx:if="{{item.required}}" class="ml-1 text-danger">*</text></view>
        <textarea wx:if="{{item.type === 'TEXTAREA'}}" class="box-border mt-3 h-[180rpx] w-full max-w-full rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:24rpx]" value="{{item.value}}" maxlength="{{item.maxLength || 500}}" data-index="{{index}}" bindinput="onTextInput" placeholder="请输入" />
        <input wx:elif="{{item.type === 'TEXT'}}" class="box-border mt-3 h-[80rpx] w-full max-w-full rounded-[12rpx] bg-panel-raised px-3 text-[length:24rpx]" value="{{item.value}}" maxlength="{{item.maxLength || 120}}" data-index="{{index}}" bindinput="onTextInput" placeholder="请输入" />
        <picker wx:elif="{{item.type === 'SELECT'}}" range="{{item.options}}" value="{{item.selectedIndex}}" data-index="{{index}}" bindchange="onSelectChange"><view class="mt-3 flex min-h-[80rpx] items-center justify-between gap-2 rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:24rpx]"><text class="min-w-0 flex-1 break-all">{{item.selectedLabel}}</text><t-icon name="chevron-right" size="30rpx" color="var(--color-muted)" /></view></picker>
        <view wx:else class="mt-3 flex min-h-[80rpx] items-center justify-between"><text class="text-[length:23rpx] text-muted">确认</text><t-switch value="{{item.checked}}" data-index="{{index}}" bind:change="onBooleanChange" /></view>
        <view wx:if="{{item.type === 'TEXT' || item.type === 'TEXTAREA'}}" class="mt-2 text-right text-[length:20rpx] text-muted">{{item.currentLength}}/{{item.maxLength || (item.type === 'TEXTAREA' ? 500 : 120)}}</view>
        <view wx:if="{{item.error}}" class="mt-2 text-[length:21rpx] text-danger">{{item.error}}</view>
      </view>
    </view>

    <view class="mt-3 flex min-h-[104rpx] items-center justify-between rounded-[16rpx] bg-panel px-4">
      <view class="min-w-0 pr-3"><view class="text-[length:24rpx] font-semibold">在参与者列表展示公开资料</view><view class="mt-1 text-[length:20rpx] text-muted">仅影响本场活动的参与者列表</view></view>
      <t-switch value="{{shareProfile}}" bind:change="onShareProfileChange" />
    </view>
    <view wx:if="{{!editing && event.accessType === 'PAID'}}" class="mt-3 rounded-[16rpx] bg-brand-soft px-4 py-3 text-[length:22rpx] leading-5 text-brand">提交后将暂时保留名额并创建报名订单，支付确认后报名才会生效。</view>
    <view class="mt-3 rounded-[16rpx] bg-panel px-4 py-4 text-[length:21rpx] leading-6 text-muted">
      <view>{{cancellationText}}</view>
      <view class="mt-2">提交报名表示已阅读并同意<text class="text-brand" bind:tap="openAgreement">《服务协议》</text>和<text class="text-brand" bind:tap="openPrivacy">《隐私政策》</text>。</view>
    </view>
    <app-page-exit />
    <view class="mip-member-fixed-edge fixed bottom-0 left-0 right-0 z-50 border-t border-line bg-panel px-3 pb-[calc(env(safe-area-inset-bottom)+16rpx)] pt-3">
      <view class="flex h-[104rpx] items-center gap-3 rounded-full bg-brand-soft p-2">
        <view class="flex min-w-[152rpx] items-center justify-center text-[length:26rpx] font-semibold text-brand">{{priceText}}</view>
        <t-button class="min-w-0 flex-1" block size="large" theme="primary" loading="{{busy}}" bind:tap="submit">{{editing ? '保存修改' : '提交报名'}}</t-button>
      </view>
    </view>
  </block>
</view>
