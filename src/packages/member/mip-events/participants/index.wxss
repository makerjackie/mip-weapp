.participants-toolbar {
  min-width: 0;
}

.participants-search {
  display: flex;
  column-gap: 16rpx;
  align-items: center;
  min-width: 0;
  min-height: 88rpx;
  padding: 0 24rpx;
  background: var(--color-panel);
  border-radius: 16rpx;
}

.participants-search__input {
  box-sizing: border-box;
  flex: 1 1 auto;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  height: 88rpx;
  font-size: 26rpx;
}

.participants-search__clear {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  min-height: 88rpx;
  padding: 0 16rpx;
  margin-right: -16rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}

.participants-filters {
  margin-top: 8rpx;
  white-space: nowrap;
}

.participants-filter-row {
  display: inline-flex;
  column-gap: 12rpx;
  padding-right: 24rpx;
}

.participants-filter-target {
  display: flex;
  align-items: center;
  min-height: 88rpx;
}

.participants-filter-pill {
  display: flex;
  column-gap: 6rpx;
  align-items: center;
  min-height: 56rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
  line-height: 1;
  color: var(--color-muted);
  background: var(--color-panel);
  border-radius: 12rpx;
}

.participants-filter-pill--active {
  font-weight: 600;
  color: var(--color-on-brand);
  background: var(--color-brand);
}

.participants-filter-count {
  min-width: 24rpx;
  text-align: center;
}

.participants-private-note {
  display: flex;
  column-gap: 8rpx;
  align-items: center;
  min-height: 56rpx;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}

.participants-heart-action {
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  margin-top: 24rpx;
}

.participants-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  min-width: 0;
  margin-top: 8rpx;
}

.participant-card {
  position: relative;
  box-sizing: border-box;
  min-width: 0;
  min-height: 368rpx;
  padding: 16rpx 16rpx 20rpx;
  overflow: hidden;
  text-align: center;
  background: var(--color-panel);
  border: 1rpx solid transparent;
  border-radius: 16rpx;
}

.participant-card--pressed {
  background: var(--color-panel-raised);
  border-color: var(--color-line);
}

.participant-card--loading {
  padding: 56rpx 32rpx;
}

.participant-card__visual {
  position: relative;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  height: 120rpx;
}

.participant-card__kind {
  position: absolute;
  top: 0;
  left: 0;
  padding: 4rpx 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.4;
  color: var(--color-brand);
  white-space: nowrap;
  background: var(--color-panel-raised);
  border: 1rpx solid var(--color-line);
  border-radius: 8rpx;
}

.participant-card__chevron {
  position: absolute;
  top: 2rpx;
  right: 0;
}

.participant-card__avatar {
  display: block;
  width: 112rpx;
  height: 112rpx;
  background: var(--color-panel-raised);
  border-radius: 50%;
}

.participant-card__avatar--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-brand-soft);
}

.participant-card__name,
.participant-card__meta,
.participant-card__summary {
  display: -webkit-box;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  overflow-wrap: anywhere;
  -webkit-box-orient: vertical;
}

.participant-card__name {
  margin-top: 12rpx;
  -webkit-line-clamp: 1;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.35;
}

.participant-card__relations {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  justify-content: center;
  margin-top: 10rpx;
}

.participant-card__relation {
  display: flex;
  column-gap: 6rpx;
  align-items: center;
  min-height: 36rpx;
  padding: 0 10rpx;
  font-size: 22rpx;
  line-height: 1;
  color: var(--color-ink);
  background: var(--color-panel-raised);
  border: 1rpx solid var(--color-line);
  border-radius: 999rpx;
}

.participant-card__relation--sent {
  color: var(--color-brand);
  background: var(--color-brand-soft);
  border-color: var(--color-brand-soft);
}

.participant-card__meta {
  margin-top: 12rpx;
  -webkit-line-clamp: 2;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--color-ink);
  text-align: left;
}

.participant-card__summary {
  margin-top: 8rpx;
  -webkit-line-clamp: 2;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--color-muted);
  text-align: left;
}

@media (min-width: 600px) and (max-width: 959px) {
  .participants-toolbar {
    display: grid;
    grid-template-columns: minmax(240px, 2fr) minmax(0, 3fr);
    gap: 16px;
    align-items: start;
  }

  .participants-search,
  .participants-search__input,
  .participants-search__clear,
  .participants-filter-target {
    min-height: 48px;
  }

  .participants-search__input {
    height: 48px;
    font-size: 15px;
  }

  .participants-search__clear {
    font-size: 13px;
  }

  .participants-filters {
    margin-top: 0;
  }

  .participants-filter-row {
    column-gap: 8px;
    padding-right: 0;
  }

  .participants-filter-pill {
    min-height: 32px;
    padding: 0 12px;
    font-size: 14px;
  }

  .participants-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: 16px;
  }

  .participant-card {
    min-height: 220px;
    padding: 12px 12px 14px;
    border-radius: 8px;
  }

  .participant-card--loading {
    padding: 32px 20px;
  }

  .participant-card__visual {
    height: 76px;
  }

  .participant-card__avatar {
    width: 72px;
    height: 72px;
  }

  .participant-card__kind {
    padding: 2px 6px;
    font-size: 12px;
  }

  .participant-card__name {
    margin-top: 8px;
    font-size: 18px;
  }

  .participant-card__meta {
    margin-top: 8px;
    font-size: 13px;
  }

  .participant-card__summary {
    margin-top: 5px;
    font-size: 13px;
  }
}

@media (min-width: 960px) {
  .participants-toolbar {
    display: grid;
    grid-template-columns: minmax(260px, 2fr) minmax(0, 3fr);
    gap: 20px;
    align-items: start;
  }

  .participants-search,
  .participants-search__input,
  .participants-search__clear,
  .participants-filter-target {
    min-height: 48px;
  }

  .participants-search__input {
    height: 48px;
    font-size: 15px;
  }

  .participants-search__clear {
    font-size: 13px;
  }

  .participants-filters {
    margin-top: 0;
  }

  .participants-filter-row {
    column-gap: 8px;
    padding-right: 0;
  }

  .participants-filter-pill {
    min-height: 32px;
    padding: 0 12px;
    font-size: 14px;
  }

  .participants-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-top: 16px;
  }

  .participant-card {
    min-height: 220px;
    padding: 12px 12px 14px;
    border-radius: 8px;
  }

  .participant-card--loading {
    padding: 32px 20px;
  }

  .participant-card__visual {
    height: 76px;
  }

  .participant-card__avatar {
    width: 72px;
    height: 72px;
  }

  .participant-card__kind {
    padding: 2px 6px;
    font-size: 12px;
  }

  .participant-card__name {
    margin-top: 8px;
    font-size: 18px;
  }

  .participant-card__meta {
    margin-top: 8px;
    font-size: 13px;
  }

  .participant-card__summary {
    margin-top: 5px;
    font-size: 13px;
  }
}
