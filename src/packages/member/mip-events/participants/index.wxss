  /* 统一嘉宾卡组件壳的桌面缩放（页面 apply-shared 覆盖组件类）。 */
  .participants-cell .mip-talent-card--grid {
    min-height: 220px;
    padding: 12px 12px 14px;
    border-radius: 8px;
  }

  .participant-card--loading {
    padding: 32px 20px;
  }

  .participants-cell .mip-talent-card__figure-avatar {
    width: 72px;
