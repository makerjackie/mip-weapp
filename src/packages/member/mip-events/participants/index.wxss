.participants-toolbar {
  min-width: 0;
}

.participants-search {
  display: flex;
  column-gap: 16rpx;
  align-items: center;
  min-width: 0;
  min-height: 88rpx;
  padding: 0 24rpx;
  background: var(--color-panel);
  border-radius: 16rpx;
}

.participants-search__input {
  box-sizing: border-box;
  flex: 1 1 auto;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  height: 88rpx;
  font-size: 24rpx;
}

.participants-search__clear {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  min-height: 88rpx;
  padding: 0 16rpx;
  margin-right: -16rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}

.participants-filters {
  margin-top: 8rpx;
  white-space: nowrap;
}

.participants-filter-row {
  display: inline-flex;
  column-gap: 12rpx;
  padding-right: 24rpx;
}

.participants-filter-target {
  display: flex;
  align-items: center;
  min-height: 88rpx;
}

.participants-filter-pill {
  display: flex;
  column-gap: 6rpx;
  align-items: center;
  min-height: 56rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
  line-height: 1;
  color: var(--color-muted);
  background: var(--color-panel);
  border-radius: 8rpx;
}

.participants-filter-pill--active {
  font-weight: 600;
  color: var(--color-on-brand);
  background: var(--color-brand);
}

.participants-filter-count {
  min-width: 24rpx;
  text-align: center;
}

.participants-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  min-width: 0;
  margin-top: 8rpx;
}

/* 卡面（头像/名字/meta/简介/kind 章）由统一嘉宾卡组件 mip-talent-card grid 壳渲染；
   本页只保留页面自有事实：cell 按压态、corner 心形票热区、心动关系行、桌面缩放。 */
.participants-cell {
  min-width: 0;
}

.participants-cell--pressed .mip-talent-card--grid {
  background: var(--color-panel-raised);
}

.participant-card--loading {
  min-height: 368rpx;
  padding: 56rpx 32rpx;
  background: var(--color-panel);
  border-radius: 16rpx;
}

/* figma 1818_17230：卡片右上角 18x16 心形票位——灰描边未投可点 / 红实心已投。
   热区按本页 88rpx 触控标准用 padding 撑开（图标钉在内容区右上角，视觉尺寸不变），
   不用负偏移溢出，避免被卡片 overflow:hidden 裁掉实际命中面积。 */
.participant-card__heart {
  position: absolute;
  top: 0;
  right: 0;
  box-sizing: border-box;
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
  min-width: 88rpx;
  min-height: 88rpx;
  padding: 8rpx 8rpx 44rpx 44rpx;
  pointer-events: auto;
}

.participant-card__relations {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  justify-content: center;
  margin-top: 10rpx;
}

.participant-card__relation {
  display: flex;
  column-gap: 6rpx;
  align-items: center;
  min-height: 36rpx;
  padding: 0 10rpx;
  font-size: 22rpx;
  line-height: 1;
  color: var(--color-ink);
  background: var(--color-panel-raised);
  border: 1rpx solid var(--color-line);
  border-radius: 999rpx;
}

.participant-card__relation--sent {
  color: var(--color-brand);
  background: var(--color-brand-soft);
  border-color: var(--color-brand-soft);
}

@media (min-width: 600px) and (max-width: 959px) {
  .participants-toolbar {
    display: grid;
    grid-template-columns: minmax(240px, 2fr) minmax(0, 3fr);
    gap: 16px;
    align-items: start;
  }

  .participants-search,
  .participants-search__input,
  .participants-search__clear,
  .participants-filter-target {
    min-height: 48px;
  }

  .participants-search__input {
    height: 48px;
    font-size: 15px;
  }

  .participants-search__clear {
    font-size: 13px;
  }

  .participants-filters {
    margin-top: 0;
  }

  .participants-filter-row {
    column-gap: 8px;
    padding-right: 0;
  }

  .participants-filter-pill {
    min-height: 32px;
    padding: 0 12px;
    font-size: 14px;
  }

  .participants-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: 16px;
  }

  /* 统一嘉宾卡组件壳的桌面缩放（页面 apply-shared 覆盖组件类）。 */
  .participants-cell .mip-talent-card--grid {
    min-height: 220px;
    padding: 12px 12px 14px;
    border-radius: 8px;
  }

  .participant-card--loading {
    padding: 32px 20px;
  }

  .participants-cell .mip-talent-card__figure-avatar {
    width: 72px;
    height: 72px;
  }

  .participants-cell .mip-talent-card__lead-label {
    padding: 2px 6px;
    font-size: 12px;
  }

  .participant-card__heart {
    min-width: 48px;
    min-height: 48px;
    padding: 4px 4px 22px 22px;
  }

  .participants-cell .mip-talent-card__figure-name {
    margin-top: 8px;
    font-size: 18px;
  }

  .participants-cell .mip-talent-card__figure-meta {
    margin-top: 8px;
    font-size: 13px;
  }

  .participants-cell .mip-talent-card__figure-supporting {
    margin-top: 5px;
    font-size: 13px;
  }
}

