<view id="mip-event-participants-page" class="mip-member-page min-h-screen bg-canvas px-3 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-3 text-ink">
  <view class="flex items-center gap-2 rounded-[16rpx] bg-panel px-3">
    <t-icon name="search" size="36rpx" color="var(--color-muted)" />
    <input class="box-border h-[88rpx] min-w-0 flex-1 max-w-full text-[length:26rpx]" value="{{searchInput}}" maxlength="80" confirm-type="search" placeholder="搜索姓名、行业或简介" bindinput="onSearchInput" bindconfirm="onSearchConfirm" />
    <view wx:if="{{searchInput}}" class="flex min-h-[88rpx] items-center px-2 text-[length:22rpx] text-muted" bind:tap="clearSearch">清除</view>
  </view>

  <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="mt-3 whitespace-nowrap">
    <view class="inline-flex gap-2 pr-3">
      <view wx:if="{{kind === 'ALL'}}" class="flex min-h-[88rpx] items-center rounded-[16rpx] bg-brand px-3 text-[length:26rpx] font-medium text-on-brand" aria-role="radio" aria-checked="true" data-kind="ALL" bind:tap="changeKind">全部 · 已选</view>
      <view wx:else class="flex min-h-[88rpx] items-center rounded-[16rpx] bg-panel px-3 text-[length:26rpx] text-muted" aria-role="radio" aria-checked="false" data-kind="ALL" bind:tap="changeKind">全部</view>
      <view wx:if="{{kind === 'GUEST'}}" class="flex min-h-[88rpx] items-center rounded-[16rpx] bg-brand px-3 text-[length:26rpx] font-medium text-on-brand" aria-role="radio" aria-checked="true" data-kind="GUEST" bind:tap="changeKind">嘉宾 · 已选</view>
      <view wx:else class="flex min-h-[88rpx] items-center rounded-[16rpx] bg-panel px-3 text-[length:26rpx] text-muted" aria-role="radio" aria-checked="false" data-kind="GUEST" bind:tap="changeKind">嘉宾</view>
      <view wx:if="{{kind === 'PLAYER'}}" class="flex min-h-[88rpx] items-center rounded-[16rpx] bg-brand px-3 text-[length:26rpx] font-medium text-on-brand" aria-role="radio" aria-checked="true" data-kind="PLAYER" bind:tap="changeKind">玩家 · 已选</view>
      <view wx:else class="flex min-h-[88rpx] items-center rounded-[16rpx] bg-panel px-3 text-[length:26rpx] text-muted" aria-role="radio" aria-checked="false" data-kind="PLAYER" bind:tap="changeKind">玩家</view>
      <view class="flex min-h-[88rpx] items-center rounded-[16rpx] bg-panel px-3 text-[length:26rpx] text-muted" data-view-mode="SENT" bind:tap="openInteraction">我的心动</view>
      <view class="flex min-h-[88rpx] items-center rounded-[16rpx] bg-panel px-3 text-[length:26rpx] text-muted" data-view-mode="RECEIVED" bind:tap="openInteraction">对我心动</view>
    </view>
  </scroll-view>

  <view wx:if="{{state === 'loading'}}" class="mt-3 grid grid-cols-2 gap-3">
    <view class="min-h-[330rpx] rounded-[16rpx] bg-panel px-4 py-7"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
    <view class="min-h-[330rpx] rounded-[16rpx] bg-panel px-4 py-7"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  </view>
  <view wx:elif="{{state === 'error'}}">
    <app-empty-state title="暂时无法加载参与人" description="{{message}}" action-text="重新加载" bind:action="loadParticipants" />
    <app-page-exit />
  </view>
  <block wx:else>
    <app-empty-state wx:if="{{items.length === 0}}" title="暂无公开参与人" description="符合当前条件的公开资料会显示在这里。" />
    <view wx:else class="mt-3 grid grid-cols-2 gap-3">
      <view wx:for="{{items}}" wx:key="profileRef" class="relative box-border min-h-[374rpx] rounded-[16rpx] bg-panel px-3 pb-3 pt-4 text-center" data-profile-ref="{{item.profileRef}}" bind:tap="openProfile">
        <text wx:if="{{item.kindLabel}}" class="absolute left-2 top-2 rounded-[8rpx] border border-line bg-panel-raised px-1.5 py-0.5 text-[length:20rpx] font-semibold text-brand">{{item.kindLabel}}</text>
        <t-icon class="absolute right-2 top-2" name="chevron-right" size="28rpx" color="var(--color-muted)" />
        <image wx:if="{{item.avatarUrl}}" class="mx-auto h-[112rpx] w-[112rpx] rounded-full bg-panel-raised" mode="aspectFill" src="{{item.avatarUrl}}" />
        <view wx:else class="mx-auto flex h-[112rpx] w-[112rpx] items-center justify-center rounded-full bg-brand-soft"><t-icon name="user-avatar" size="52rpx" color="var(--color-brand)" /></view>
        <view class="mt-3 line-clamp-1 text-[length:30rpx] font-semibold">{{item.displayName}}</view>
        <view wx:if="{{item.metaText}}" class="mt-2 line-clamp-2 text-left text-[length:21rpx] leading-5 text-ink">{{item.metaText}}</view>
        <view wx:if="{{item.introductionText}}" class="mt-2 line-clamp-2 text-left text-[length:21rpx] leading-5 text-muted">{{item.introductionText}}</view>
      </view>
    </view>
    <view wx:if="{{nextCursor}}" class="mt-4"><t-button block variant="outline" theme="primary" loading="{{loadingMore}}" bind:tap="loadMore">加载更多</t-button></view>
    <view wx:if="{{message}}" class="mt-4 rounded-[16rpx] bg-brand-soft px-4 py-3 text-[length:22rpx] text-brand">{{message}}</view>
    <app-page-exit />
  </block>
</view>
