<view id="mip-event-participants-page" class="mip-member-page participants-page min-h-screen bg-canvas px-3 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-3 text-ink">
  <view class="participants-toolbar">
    <view class="participants-search">
      <mip-icon name="search-big-left-1" size="{{18}}" color="var(--color-muted)" />
      <input aria-label="搜索姓名，行业，简介等" class="participants-search__input" value="{{searchInput}}" maxlength="80" confirm-type="search" placeholder="搜索姓名，行业，简介等" bindinput="onSearchInput" bindconfirm="onSearchConfirm" />
      <view wx:if="{{searchInput}}" class="participants-search__clear" aria-role="button" aria-label="清除搜索内容" bind:tap="clearSearch">清除</view>
    </view>

    <!-- journey-review J2-02（figma 1818_17230）：四 tab 胶囊——嘉宾/玩家/我的心动/对我心动，
         心动 tab 带计数；默认 tab 由入口参数决定。 -->
    <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="participants-filters">
      <view class="participants-filter-row">
        <view class="participants-filter-target" aria-role="radio" aria-checked="{{activeView === 'PUBLIC' && kind === 'GUEST'}}" data-kind="GUEST" bind:tap="changeKind">
          <view class="participants-filter-pill {{activeView === 'PUBLIC' && kind === 'GUEST' ? 'participants-filter-pill--active' : ''}}">
            <text>嘉宾</text>
            <!-- 差异报告 C1：计数来自服务端 kindTotals（列表同口径，不含关键词过滤）。 -->
            <text wx:if="{{kindTotals}}" class="participants-filter-count">{{kindTotals.GUEST}}</text>
          </view>
        </view>
        <view class="participants-filter-target" aria-role="radio" aria-checked="{{activeView === 'PUBLIC' && kind === 'PLAYER'}}" data-kind="PLAYER" bind:tap="changeKind">
          <view class="participants-filter-pill {{activeView === 'PUBLIC' && kind === 'PLAYER' ? 'participants-filter-pill--active' : ''}}">
            <text>玩家</text>
            <text wx:if="{{kindTotals}}" class="participants-filter-count">{{kindTotals.PLAYER}}</text>
          </view>
        </view>
        <view class="participants-filter-target" aria-role="radio" aria-checked="{{activeView === 'SENT'}}" data-view="SENT" bind:tap="changeView">
          <view class="participants-filter-pill {{activeView === 'SENT' ? 'participants-filter-pill--active' : ''}}">
            <text>我的心动</text>
            <!-- MIW-36：计数为服务端 heartCounts（与详情胶囊同源），不用列表长度重算。 -->
            <text wx:if="{{heartState === 'ready'}}" class="participants-filter-count">{{heartMineCount}}</text>
          </view>
        </view>
        <view class="participants-filter-target" aria-role="radio" aria-checked="{{activeView === 'RECEIVED'}}" data-view="RECEIVED" bind:tap="changeView">
          <view class="participants-filter-pill {{activeView === 'RECEIVED' ? 'participants-filter-pill--active' : ''}}">
            <text>对我心动</text>
            <text wx:if="{{heartState === 'ready'}}" class="participants-filter-count">{{heartReceivedCount}}</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{(activeView === 'PUBLIC' && state === 'loading') || (activeView !== 'PUBLIC' && heartState === 'loading')}}" class="participants-grid participants-grid--loading">
    <view class="participant-card participant-card--loading"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
    <view class="participant-card participant-card--loading"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  </view>
  <view wx:elif="{{activeView === 'PUBLIC' && state === 'error'}}">
    <mip-empty-state title="暂时无法加载参与人" description="{{message}}" action-text="重新加载" bind:action="loadParticipants" />
    <app-page-exit />
  </view>
  <view wx:elif="{{activeView !== 'PUBLIC' && heartState === 'restricted'}}">
    <mip-empty-state title="心动功能暂不可用" description="完成登录、必要资料和本场签到后可查看和使用心动功能。" action-text="查看全部参与人" bind:action="showPublicParticipants" />
    <app-page-exit />
  </view>
  <view wx:elif="{{activeView !== 'PUBLIC' && heartState === 'error'}}">
    <mip-empty-state title="暂时无法加载心动信息" description="{{heartMessage}}" action-text="重新加载" bind:action="retryHeartState" />
    <app-page-exit />
  </view>
  <block wx:else>
    <mip-empty-state wx:if="{{displayItems.length === 0}}" title="{{emptyTitle}}" description="{{emptyDescription}}" />
    <!-- figma 1818_17230：双列卡 170x187——统一嘉宾卡组件 grid 壳：左上 Lv 章（名单 tab 另有
         kind 章）、右上心形票（corner 插槽页面自有事实：灰描边未投可点 / 红实心已投）、
         描边环头像、名字、居中三标签（白色竖线分隔）、一句话介绍、左下勋章、右下邀请人。
         MIW-73：四个 tab 同构，等级/勋章/邀请人由服务端公开口径补齐；标签行不再左对齐；
         卡面不再渲染「我的心动/对我心动」关系行（tab 归属已表达，右上红心是唯一投票交互）。 -->
    <view wx:else class="participants-grid">
      <view wx:for="{{displayItems}}" wx:key="profileRef" class="participants-cell" hover-class="participants-cell--pressed" aria-role="button" aria-label="查看{{item.displayName}}的公开档案" data-profile-ref="{{item.profileRef}}" bind:tap="openProfile">
        <mip-talent-card layout="grid" avatar-ring="{{true}}" lead-label="{{item.kindLabel}}" level-text="{{item.levelText}}" display-name="{{item.displayName}}" avatar-url="{{item.avatarUrl || ''}}" tags="{{item.profileTags}}" supporting-text="{{item.introductionText}}" medals="{{item.medals}}" inviter-name="{{item.inviterName}}" inviter-avatar-url="{{item.inviterAvatarUrl}}" inviter-kind="{{item.inviterKind}}">
          <view slot="corner">
            <!-- MIW-101：四 tab 卡片右上角恒渲染红心入口——点按即乐观翻转（变色+弹跳+toast），
                 不等服务端链路；名单内未签到者（无凭证）点按就地解释规则。
                 MIW-118：已投状态唯一表达就是本角标（heart.target 同口径四 tab 随卡点亮），
                 设计稿无顶部提示条，不得再加横幅/通知类冗余入口。 -->
            <view class="participant-card__heart {{heart.target && heart.target.profileRef === item.profileRef ? 'participant-card__heart--voted' : ''}} {{heartPulseRef === item.profileRef ? 'participant-card__heart--pulse' : ''}}" aria-role="button" aria-label="{{item.heartTicket ? (heart.target && heart.target.profileRef === item.profileRef ? '取消对' + item.displayName + '的心动' : '对' + item.displayName + '心动') : item.displayName + '签到后可被心动'}}" data-profile-ref="{{item.profileRef}}" catch:tap="toggleHeartVote">
              <!-- MIW-17 G3：原型已投红心 fill #FF2238（DS record 红），非 danger #FF4D5E。 -->
              <t-icon wx:if="{{heart.target && heart.target.profileRef === item.profileRef}}" name="heart-filled" size="18px" color="var(--mip-record)" />
              <t-icon wx:else name="heart" size="18px" color="var(--color-muted)" />
            </view>
          </view>
        </mip-talent-card>
      </view>
    </view>
    <view wx:if="{{activeView === 'PUBLIC' && nextCursor}}" class="mt-4"><t-button block variant="outline" theme="primary" loading="{{loadingMore}}" bind:tap="loadMore">加载更多</t-button></view>
    <view wx:if="{{activeView === 'PUBLIC' && message}}" class="mt-4 rounded-[16rpx] bg-brand-soft px-4 py-3 text-[22rpx] text-brand">{{message}}</view>
    <app-page-exit />
  </block>
</view>
