<view id="mip-event-interaction-page" class="min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+40rpx)] pt-4 text-ink">
  <view wx:if="{{state === 'loading'}}" class="rounded-[16rpx] bg-panel px-4 py-7"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}"><app-empty-state title="暂时无法加载互动" description="请确认已完成签到后重试。" action-text="重新加载" bind:action="loadInteraction" /><app-page-exit /></view>
  <block wx:else>
    <view class="text-[length:34rpx] font-bold">心动</view>
    <view class="mt-2 text-[length:22rpx] leading-5 text-muted">每场活动可选择一位已签到参与者，可改选或取消。选择结果仅本人可查看。</view>
    <view wx:if="{{candidates.length === 0}}" class="mt-4 rounded-[16rpx] bg-panel px-4 py-5 text-[length:23rpx] text-muted">暂无可选择的参与者。</view>
    <view wx:else class="mt-4 grid grid-cols-2 gap-3">
      <view wx:for="{{candidates}}" wx:key="participantRef" class="rounded-[16rpx] border border-line bg-panel px-3 py-4 text-center" data-target-ref="{{item.participantRef}}" bind:tap="chooseHeart">
        <image wx:if="{{item.avatarUrl}}" class="mx-auto h-[96rpx] w-[96rpx] rounded-full bg-brand-soft" mode="aspectFill" src="{{item.avatarUrl}}" />
        <view wx:else class="mx-auto flex h-[96rpx] w-[96rpx] items-center justify-center rounded-full bg-brand-soft"><t-icon name="user-avatar" size="48rpx" color="var(--color-brand)" /></view>
        <view class="mt-3 line-clamp-1 text-[length:24rpx] font-semibold">{{item.nickname}}</view>
        <view wx:if="{{item.headline}}" class="mt-1 line-clamp-1 text-[length:20rpx] text-muted">{{item.headline}}</view>
        <view wx:if="{{item.selected}}" class="mt-2 text-[length:21rpx] text-brand">已选择</view>
        <view wx:else class="mt-2 text-[length:21rpx] text-muted">选择</view>
      </view>
    </view>

    <view class="mt-6 rounded-[16rpx] bg-panel px-4 py-4">
      <view class="text-[length:28rpx] font-bold">对我心动的人</view>
      <view wx:if="{{received.length === 0}}" class="mt-3 text-[length:22rpx] text-muted">暂无记录。</view>
      <view wx:else class="mt-3 flex flex-col gap-3"><view wx:for="{{received}}" wx:key="participantRef" class="flex items-center gap-3"><image wx:if="{{item.avatarUrl}}" class="h-[64rpx] w-[64rpx] rounded-full bg-brand-soft" mode="aspectFill" src="{{item.avatarUrl}}" /><view class="text-[length:24rpx]">{{item.nickname}}</view></view></view>
    </view>

    <view class="mt-6 text-[length:34rpx] font-bold">活动反馈</view>
    <view class="mt-2 text-[length:22rpx] text-muted">反馈正文仅授权运营人员可查看，可在提交后修改。</view>
    <view class="mt-4 rounded-[16rpx] bg-panel px-4 py-4">
      <view class="text-[length:24rpx] font-semibold">评分</view>
      <picker range="{{ratingOptions}}" value="{{rating - 1}}" bindchange="onRatingChange"><view class="mt-3 flex h-[80rpx] items-center justify-between rounded-[12rpx] bg-panel-raised px-3"><text>{{rating}} 分</text><t-icon name="chevron-right" size="30rpx" color="var(--color-muted)" /></view></picker>
      <view class="mt-4 text-[length:24rpx] font-semibold">反馈内容</view>
      <textarea class="box-border mt-3 h-[240rpx] w-full max-w-full rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:24rpx]" value="{{body}}" maxlength="2000" bindinput="onBodyInput" placeholder="请输入反馈" />
      <view class="mt-4"><t-button block size="large" theme="primary" loading="{{savingFeedback}}" bind:tap="saveFeedback">保存反馈</t-button></view>
    </view>
    <view wx:if="{{message}}" class="mt-4 rounded-[16rpx] bg-brand-soft px-4 py-3 text-[length:22rpx] text-brand">{{message}}</view>
    <app-page-exit />
  </block>
</view>
