<view id="mip-event-interaction-page" class="mip-member-page min-h-screen bg-canvas px-3 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-3 text-ink">
  <view aria-label="正在加载" aria-busy="true" wx:if="{{state === 'loading'}}" class="rounded-[16rpx] bg-panel px-4 py-7"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'blocked'}}"><app-empty-state title="活动互动暂不可用" description="{{errorDescription}}" /><app-page-exit /></view>
  <view wx:elif="{{state === 'error'}}"><app-empty-state title="暂时无法加载互动" description="{{errorDescription}}" action-text="重新加载" bind:action="loadInteraction" /><app-page-exit /></view>
  <block wx:else>
    <view class="flex items-center gap-2 rounded-[16rpx] bg-panel px-3">
      <t-icon name="search" size="36rpx" color="var(--color-muted)" />
      <input aria-label="搜索姓名或简介" class="box-border h-[88rpx] min-w-0 flex-1 max-w-full text-[length:26rpx]" value="{{searchInput}}" maxlength="80" placeholder="搜索姓名或简介" bindinput="onSearchInput" />
      <view wx:if="{{searchInput}}" class="flex min-h-[88rpx] items-center px-2 text-[length:22rpx] text-muted" bind:tap="clearSearch">清除</view>
    </view>

    <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="mt-3 whitespace-nowrap">
      <view class="inline-flex gap-2 pr-3">
        <view wx:if="{{activeView === 'SENT'}}" class="flex min-h-[88rpx] items-center rounded-[16rpx] bg-brand px-3 text-[length:26rpx] font-medium text-on-brand" data-view="SENT" bind:tap="changeView">选择心动 {{heart.targetRef ? 1 : 0}}</view>
        <view wx:else class="flex min-h-[88rpx] items-center rounded-[16rpx] bg-panel px-3 text-[length:26rpx] text-muted" data-view="SENT" bind:tap="changeView">选择心动 {{heart.targetRef ? 1 : 0}}</view>
        <view wx:if="{{activeView === 'RECEIVED'}}" class="flex min-h-[88rpx] items-center rounded-[16rpx] bg-brand px-3 text-[length:26rpx] font-medium text-on-brand" data-view="RECEIVED" bind:tap="changeView">对我心动 {{received.length}}</view>
        <view wx:else class="flex min-h-[88rpx] items-center rounded-[16rpx] bg-panel px-3 text-[length:26rpx] text-muted" data-view="RECEIVED" bind:tap="changeView">对我心动 {{received.length}}</view>
      </view>
    </scroll-view>

    <block wx:if="{{activeView === 'SENT'}}">
      <view class="mt-3 rounded-[16rpx] bg-panel px-3 py-3 text-[length:22rpx] leading-5 text-muted">每场活动可选择一位已签到参与者，可改选或取消。选择结果仅本人可查看。</view>
      <app-empty-state wx:if="{{visibleCandidates.length === 0}}" title="暂无可选择的参与者" description="符合条件的已签到参与者会显示在这里。" />
      <view wx:else class="mt-3 grid grid-cols-2 gap-3">
        <view wx:for="{{visibleCandidates}}" wx:key="participantRef" class="relative box-border min-h-[330rpx] rounded-[16rpx] border border-line bg-panel px-3 pb-3 pt-4 text-center" data-target-ref="{{item.participantRef}}" bind:tap="chooseHeart">
          <view class="absolute right-2 top-2 flex h-[48rpx] w-[48rpx] items-center justify-center"><t-icon name="{{item.selected ? 'heart-filled' : 'heart'}}" size="36rpx" color="{{item.selected ? 'var(--color-danger)' : 'var(--color-muted)'}}" /></view>
          <image wx:if="{{item.avatarUrl}}" class="mx-auto h-[112rpx] w-[112rpx] rounded-full bg-brand-soft" mode="aspectFill" src="{{item.avatarUrl}}" />
          <view wx:else class="mx-auto flex h-[112rpx] w-[112rpx] items-center justify-center rounded-full bg-brand-soft"><t-icon name="user-avatar" size="52rpx" color="var(--color-brand)" /></view>
          <view class="mt-3 line-clamp-1 text-[length:30rpx] font-semibold">{{item.nickname}}</view>
          <view wx:if="{{item.headline}}" class="mt-2 line-clamp-3 text-left text-[length:22rpx] leading-5 text-muted">{{item.headline}}</view>
          <view wx:if="{{item.selected}}" class="mt-3 text-[length:22rpx] text-brand">已选择，再次点击可取消</view>
          <view wx:else class="mt-3 text-[length:22rpx] text-muted">选择</view>
        </view>
      </view>
    </block>

    <block wx:else>
      <app-empty-state wx:if="{{visibleReceived.length === 0}}" title="暂无对你心动的人" description="本场活动的互动结果会显示在这里。" />
      <view wx:else class="mt-3 grid grid-cols-2 gap-3">
        <view wx:for="{{visibleReceived}}" wx:key="participantRef" class="relative box-border min-h-[310rpx] rounded-[16rpx] bg-panel px-3 pb-3 pt-4 text-center">
          <view class="absolute right-2 top-2 flex h-[48rpx] w-[48rpx] items-center justify-center"><t-icon name="heart-filled" size="36rpx" color="var(--color-danger)" /></view>
          <image wx:if="{{item.avatarUrl}}" class="mx-auto h-[112rpx] w-[112rpx] rounded-full bg-brand-soft" mode="aspectFill" src="{{item.avatarUrl}}" />
          <view wx:else class="mx-auto flex h-[112rpx] w-[112rpx] items-center justify-center rounded-full bg-brand-soft"><t-icon name="user-avatar" size="52rpx" color="var(--color-brand)" /></view>
          <view class="mt-3 line-clamp-1 text-[length:30rpx] font-semibold">{{item.nickname}}</view>
          <view wx:if="{{item.headline}}" class="mt-2 line-clamp-3 text-left text-[length:22rpx] leading-5 text-muted">{{item.headline}}</view>
        </view>
      </view>
    </block>

    <view wx:if="{{message}}" class="mt-4 rounded-[16rpx] bg-brand-soft px-4 py-3 text-[length:22rpx] text-brand">{{message}}</view>
    <app-page-exit />
  </block>
</view>
