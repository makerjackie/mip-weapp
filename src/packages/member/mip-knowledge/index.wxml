<view id="mip-knowledge-page" class="min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-4 text-ink">
  <view class="text-[length:38rpx] font-bold">知识内容</view>
  <view class="mt-2 text-[length:23rpx] text-muted">查看热点、玩家攻略、视频和专家分享</view>

  <view class="mt-5 rounded-[16rpx] bg-panel px-4 py-4">
    <view class="flex items-center gap-2"><view class="min-w-0 flex-1"><t-input value="{{queryInput}}" placeholder="搜索标题、简介或作者" bind:change="updateQuery" /></view><t-button bind:tap="search">搜索</t-button></view>
    <scroll-view class="mt-3 whitespace-nowrap" scroll-x enhanced show-scrollbar="false">
      <view class="inline-flex gap-2 pr-4"><view class="flex min-h-[72rpx] items-center rounded-full px-4 text-[length:22rpx] {{!categoryId ? 'bg-brand text-on-brand' : 'bg-panel-raised text-muted'}}" data-id="" bind:tap="chooseCategory">全部行业</view><view wx:for="{{categories}}" wx:key="id" class="flex min-h-[72rpx] items-center rounded-full px-4 text-[length:22rpx] {{categoryId === item.id ? 'bg-brand text-on-brand' : 'bg-panel-raised text-muted'}}" data-id="{{item.id}}" bind:tap="chooseCategory">{{item.name}}</view></view>
    </scroll-view>
    <scroll-view class="mt-2 whitespace-nowrap" scroll-x enhanced show-scrollbar="false">
      <view class="inline-flex gap-2 pr-4"><view wx:for="{{typeOptions}}" wx:key="value" class="flex min-h-[72rpx] items-center rounded-full px-4 text-[length:22rpx] {{contentType === item.value ? 'bg-brand text-on-brand' : 'bg-panel-raised text-muted'}}" data-type="{{item.value}}" bind:tap="chooseType">{{item.label}}</view></view>
    </scroll-view>
  </view>

  <view wx:if="{{state === 'loading'}}" class="mt-5 rounded-[16rpx] bg-panel px-4 py-6"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}" class="mt-5"><app-empty-state title="暂时无法加载内容" description="{{message}}" action-text="重新加载" bind:action="loadFiltersAndContents" /></view>
  <view wx:elif="{{state === 'empty'}}" class="mt-5"><app-empty-state title="暂无内容" description="当前筛选条件下没有已发布内容。" /></view>
  <view wx:else class="mt-5 flex flex-col gap-3">
    <view wx:for="{{items}}" wx:key="id" class="overflow-hidden rounded-[16rpx] bg-panel" data-id="{{item.id}}" bind:tap="openContent">
      <image wx:if="{{item.coverUrl}}" class="h-[260rpx] w-full bg-panel-raised" mode="aspectFill" src="{{item.coverUrl}}" />
      <view class="px-4 py-4">
        <view class="flex items-start justify-between gap-3"><view class="min-w-0 flex-1 text-[length:29rpx] font-semibold">{{item.title}}</view><view class="shrink-0 rounded-full bg-brand-soft px-3 py-1 text-[length:20rpx] text-brand">{{item.typeLabel}}</view></view>
        <view class="mt-2 line-clamp-2 text-[length:23rpx] leading-[1.65] text-muted">{{item.summary}}</view>
        <view class="mt-3 flex items-center justify-between border-t border-line pt-3 text-[length:21rpx] text-muted"><text>{{item.category.name}} · {{item.sourceName || 'MIP'}}</text><text class="text-brand">{{item.priceLabel || item.accessLabel}}</text></view>
      </view>
    </view>
  </view>
  <view wx:if="{{nextCursor}}" class="mt-4"><t-button block variant="outline" loading="{{loadingMore}}" bind:tap="loadMore">加载更多</t-button></view>
  <view wx:if="{{message && state === 'ready'}}" class="mt-4 rounded-[12rpx] bg-panel px-4 py-3 text-[length:22rpx] text-danger">{{message}}</view>
  <app-page-exit />
</view>
