<view id="mip-membership-order-page" class="mip-member-page min-h-screen bg-canvas px-3 pb-[calc(env(safe-area-inset-bottom)+176rpx)] pt-3 text-ink">
  <view aria-label="正在加载" aria-busy="true" wx:if="{{state === 'loading'}}" class="rounded-[16rpx] bg-panel px-4 py-7"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}"><mip-empty-state title="无法打开订单确认" description="{{message || '会员方案暂时不可用，请稍后重试。'}}" action-text="重新加载" bind:action="loadPlan" /><app-page-exit /></view>

  <!-- journey-review J1-07 join-order（会员订单确认页，按活动订单 1821_19274 模式自拟）：
       商品卡 + 订单ID + 价格明细 + 购买须知 + 底部价格与「立即支付」。
       订单确认页无补充填写项（2026-09-21 终审 QO）；金额来自服务端会员方案（终审 C7 口径）。 -->
  <block wx:else>
    <view class="rounded-[16rpx] bg-panel px-3 pb-4 pt-3">
      <view class="flex items-center gap-2">
        <view class="flex h-[40rpx] items-center justify-center rounded-[8rpx] bg-brand px-2"><text class="text-[length:20rpx] font-medium leading-none text-on-brand">年卡</text></view>
        <text class="text-[length:24rpx] font-medium leading-[33.6rpx] text-brand">MIP 玩家会员</text>
      </view>
      <view class="mt-[16rpx] text-[length:48rpx] font-semibold leading-[67.2rpx]">{{planTitle}}</view>
      <view class="mt-[10rpx] text-[length:24rpx] leading-[33.6rpx] text-muted">解锁人才合作、机会发布等玩家专属权益</view>
      <view class="mt-[24rpx] h-[2rpx] w-full bg-line"></view>
      <view class="mt-[20rpx] flex items-start justify-between gap-4">
        <text class="shrink-0 text-[length:24rpx] leading-[33.6rpx]">有效期</text>
        <text class="min-w-0 flex-1 text-right text-[length:24rpx] leading-[33.6rpx] text-muted">{{validityText}}</text>
      </view>
      <view class="mt-[24rpx] flex items-start justify-between gap-4">
        <text class="shrink-0 text-[length:24rpx] leading-[33.6rpx]">等级经验</text>
        <text class="min-w-0 flex-1 text-right text-[length:24rpx] leading-[33.6rpx] text-muted">做任务升级，规则见「玩家等级」页</text>
      </view>
    </view>

    <view class="mt-3 flex h-[80rpx] items-center gap-3 rounded-[16rpx] bg-panel px-3">
      <view class="flex h-[32rpx] w-[32rpx] shrink-0 items-center justify-center rounded-full bg-brand"><mip-icon name="file-text" size="{{16}}" color="var(--color-on-brand)" /></view>
      <text class="shrink-0 text-[length:24rpx] leading-[33.6rpx]">订单ID</text>
      <text class="min-w-0 flex-1 truncate text-right text-[length:24rpx] font-medium leading-[33.6rpx]">{{orderNumberText}}</text>
    </view>

    <view class="mt-3 overflow-hidden rounded-[16rpx] bg-panel">
      <view class="flex h-[80rpx] items-center gap-3 px-3">
        <view class="flex h-[32rpx] w-[32rpx] shrink-0 items-center justify-center rounded-full bg-brand text-[length:20rpx] font-bold text-on-brand">¥</view>
        <text class="text-[length:24rpx] leading-[33.6rpx]">价格明细</text>
      </view>
      <view class="flex h-[80rpx] items-center justify-between border-t border-line px-3">
        <text class="text-[length:24rpx] leading-[33.6rpx]">玩家会员年费</text>
        <text class="text-[length:24rpx] font-medium leading-[33.6rpx]">{{feeText}}</text>
      </view>
      <view class="flex h-[80rpx] items-center justify-between border-t border-line px-3">
        <text class="text-[length:24rpx] font-medium leading-[33.6rpx]">总计</text>
        <view class="flex items-baseline text-brand"><text class="text-[length:24rpx] font-medium">{{totalSymbol}}</text><text class="text-[length:40rpx] font-medium leading-[56rpx]">{{totalAmount}}</text></view>
      </view>
    </view>

    <view class="mt-3 rounded-[16rpx] bg-panel px-3 py-4">
      <view class="flex h-[44rpx] items-center gap-3">
        <view class="flex h-[32rpx] w-[32rpx] shrink-0 items-center justify-center rounded-full bg-brand"><mip-icon name="file-text" size="{{16}}" color="var(--color-on-brand)" /></view>
        <text class="text-[length:24rpx] leading-[33.6rpx]">购买须知</text>
      </view>
      <view class="mt-3 whitespace-pre-wrap text-[length:24rpx] leading-[38rpx] text-muted">{{noticesText}}</view>
    </view>

    <view id="membership-order-feedback" wx:if="{{message}}" class="mt-3 rounded-[16rpx] border border-line bg-panel-raised px-4 py-3 text-[length:22rpx] leading-5">{{message}}</view>

    <view class="mt-3 rounded-[16rpx] bg-panel px-4 py-4 text-[length:20rpx] leading-6 text-muted">
      <view>支付成功后开通玩家权益；未完成支付的订单不会保留，重新发起即重新创建。</view>
    </view>
    <app-page-exit />
    <view class="mip-liquid-glass mip-member-fixed-inset box-border fixed inset-x-3 bottom-[calc(env(safe-area-inset-bottom)+16rpx)] z-20 flex h-[112rpx] items-center gap-3 rounded-full p-2">
      <view class="flex min-w-[152rpx] items-baseline justify-center leading-none text-brand" aria-label="{{feeText}}"><text class="text-[length:24rpx] font-medium leading-none">{{totalSymbol}}</text><text class="text-[length:40rpx] font-medium leading-none">{{totalAmount}}</text></view>
      <!-- 缓存方案未经服务端刷新确认（plansVerified=false）时禁用支付，与「会员方案更新失败，暂时无法支付。」文案一致。 -->
      <button id="membership-order-pay" class="m-0 flex h-[88rpx] min-w-0 flex-1 items-center justify-center border-0 bg-transparent p-0 leading-none after:border-0" loading="{{paying}}" disabled="{{paying || !plansVerified}}" aria-disabled="{{paying || !plansVerified}}" bind:tap="pay"><view class="box-border flex h-[80rpx] w-full items-center justify-center rounded-full border border-black bg-brand text-[length:32rpx] font-medium text-on-brand {{paying || !plansVerified ? 'opacity-60' : ''}}">立即支付</view></button>
    </view>
  </block>
</view>
