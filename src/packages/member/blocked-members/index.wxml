<view id="member-blocked-members-page" class="min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-4 text-ink">
  <view class="px-1"><view class="text-[length:22rpx] font-semibold text-accent">隐私设置</view><view class="mt-1 text-[length:38rpx] font-bold">已屏蔽的成员</view><view class="mt-2 text-[length:22rpx] text-muted">屏蔽不会影响已经产生的订单和活动报名。</view></view>
  <view wx:if="{{state === 'loading'}}" class="mt-5 rounded-[24rpx] bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}" class="mt-5"><app-empty-state title="暂时无法加载" description="{{message}}" action-text="重新加载" bind:action="loadItems" /></view>
  <view wx:elif="{{!items.length}}" class="mt-5"><app-empty-state title="没有屏蔽任何成员" description="你主动屏蔽的成员会显示在这里。" /></view>
  <view wx:else class="mt-5 overflow-hidden rounded-[24rpx] bg-panel">
    <view wx:for="{{items}}" wx:key="id" class="flex min-h-[116rpx] items-center gap-3 border-b border-line px-4 last:border-b-0">
      <image wx:if="{{item.avatarUrl}}" class="h-[76rpx] w-[76rpx] shrink-0 rounded-full bg-brand-soft" src="{{item.avatarUrl}}" mode="aspectFill" />
      <view wx:else class="flex h-[76rpx] w-[76rpx] shrink-0 items-center justify-center rounded-full bg-brand-soft text-brand">{{item.initial}}</view>
      <view class="min-w-0 flex-1"><view class="truncate text-[length:25rpx] font-semibold">{{item.nickname}}</view><view class="mt-1 truncate text-[length:20rpx] text-muted">{{item.headline || item.city || '公开资料'}}</view></view>
      <t-button size="small" variant="outline" theme="primary" loading="{{processingId === item.id}}" data-id="{{item.id}}" bind:tap="unblock">恢复</t-button>
    </view>
  </view>
  <view wx:if="{{message && state === 'ready'}}" class="mt-4 rounded-[18rpx] bg-[#FFF0E8] px-4 py-3 text-[length:23rpx] text-[#9F4727]">{{message}}</view>
  <app-page-exit />
</view>
