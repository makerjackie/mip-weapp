<view id="mip-opportunity-settings-page" class="min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-4 text-ink">
  <view class="text-[length:36rpx] font-bold">消息与机会权限</view><view class="mt-1 text-[length:22rpx] text-muted">设置仅影响当前账号，修改后由服务端执行。</view>
  <view wx:if="{{state === 'loading'}}" class="mt-5 rounded-[16rpx] bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}" class="mt-5"><app-empty-state title="暂时无法加载权限设置" description="{{message}}" action-text="重新加载" bind:action="load" /></view>
  <block wx:else>
    <view class="mt-5 overflow-hidden rounded-[16rpx] bg-panel"><view class="px-4 py-4 text-[length:27rpx] font-semibold">消息通知</view><view class="flex min-h-[90rpx] items-center justify-between border-t border-line px-4"><text class="text-[length:23rpx]">评论通知</text><t-switch checked="{{preferences.notifications.commentsEnabled}}" data-path="notifications.commentsEnabled" bind:change="toggle" /></view><view class="flex min-h-[90rpx] items-center justify-between border-t border-line px-4"><text class="text-[length:23rpx]">机会撮合推荐</text><t-switch checked="{{preferences.notifications.opportunityMatchingEnabled}}" data-path="notifications.opportunityMatchingEnabled" bind:change="toggle" /></view><view class="flex min-h-[90rpx] items-center justify-between border-t border-line px-4"><text class="text-[length:23rpx]">热点通知</text><t-switch checked="{{preferences.notifications.hotspotsEnabled}}" data-path="notifications.hotspotsEnabled" bind:change="toggle" /></view></view>
    <view class="mt-4 overflow-hidden rounded-[16rpx] bg-panel"><view class="px-4 py-4 text-[length:27rpx] font-semibold">机会权限</view><view class="flex min-h-[90rpx] items-center justify-between border-t border-line px-4"><text class="text-[length:23rpx]">启用机会撮合</text><t-switch checked="{{preferences.opportunities.matchingEnabled}}" data-path="opportunities.matchingEnabled" bind:change="toggle" /></view><view class="flex min-h-[90rpx] items-center justify-between border-t border-line px-4"><text class="text-[length:23rpx]">人才推荐</text><t-switch checked="{{preferences.opportunities.talentRecommendationsEnabled}}" data-path="opportunities.talentRecommendationsEnabled" bind:change="toggle" /></view><view class="flex min-h-[90rpx] items-center justify-between border-t border-line px-4"><text class="text-[length:23rpx]">项目推荐</text><t-switch checked="{{preferences.opportunities.projectRecommendationsEnabled}}" data-path="opportunities.projectRecommendationsEnabled" bind:change="toggle" /></view><view class="flex min-h-[90rpx] items-center justify-between border-t border-line px-4"><view><view class="text-[length:23rpx]">允许进入他人撮合结果</view><view class="mt-1 text-[length:20rpx] text-muted">仅使用公开资料。</view></view><t-switch checked="{{preferences.opportunities.discoverableForMatching}}" data-path="opportunities.discoverableForMatching" bind:change="toggle" /></view><view class="border-t border-line px-4 py-4"><view class="text-[length:23rpx]">可发现范围</view><view class="mt-3 grid grid-cols-2 gap-3 text-center text-[length:22rpx]"><view class="rounded-[12rpx] px-3 py-3 {{preferences.opportunities.matchingScope === 'PRIMARY_BRANCH' ? 'bg-brand text-on-brand' : 'bg-panel-raised text-muted'}}" data-scope="PRIMARY_BRANCH" bind:tap="setScope">主分会</view><view class="rounded-[12rpx] px-3 py-3 {{preferences.opportunities.matchingScope === 'PLATFORM' ? 'bg-brand text-on-brand' : 'bg-panel-raised text-muted'}}" data-scope="PLATFORM" bind:tap="setScope">全平台</view></view></view></view>
    <view class="mt-5"><t-button block theme="primary" loading="{{saving}}" bind:tap="save">保存设置</t-button></view>
    <view wx:if="{{message}}" class="mt-4 rounded-[16rpx] bg-brand-soft px-4 py-3 text-[length:22rpx] text-brand">{{message}}</view>
  </block>
  <app-page-exit label="返回我的" />
</view>
