<view id="mip-privacy-settings-page" class="mip-member-page mip-privacy-settings-shell min-h-screen bg-canvas px-[24rpx] pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-[24rpx] text-ink">
  <view wx:if="{{state === 'loading'}}" class="py-6 text-muted">正在加载隐私设置</view>
  <view wx:if="{{message}}" class="py-3 text-[24rpx] text-muted">{{message}}</view>
  <view wx:if="{{state === 'error'}}" class="flex min-h-[88rpx] items-center text-brand" aria-role="button" bind:tap="load">重新加载</view>
  <block wx:if="{{state === 'ready'}}">
  <view class="flex min-h-[92rpx] items-center justify-between rounded-[16rpx] bg-panel pl-[24rpx] pr-[20rpx]">
    <view class="min-w-0 flex-1 py-[20rpx] text-[28rpx] font-medium leading-[40rpx]">不让他人在搜索人才时找到我</view>
    <t-switch
      class="ml-[16rpx] shrink-0"
      disabled="{{saving}}"
      aria-label="不让他人在搜索人才时找到我"
      value="{{hideFromTalentSearch}}"
      data-key="hideFromTalentSearch"
      bind:change="onToggle"
    />
  </view>
  <view class="mt-[24rpx] flex min-h-[92rpx] items-center justify-between rounded-[16rpx] bg-panel pl-[24rpx] pr-[20rpx]">
    <view class="min-w-0 flex-1 py-[20rpx] text-[28rpx] font-medium leading-[40rpx]">不让非MIP玩家看到我发布的机会</view>
    <t-switch
      class="ml-[16rpx] shrink-0"
      disabled="{{saving}}"
      aria-label="不让非MIP玩家看到我发布的机会"
      value="{{hideOpportunitiesFromNonPlayers}}"
      data-key="hideOpportunitiesFromNonPlayers"
      bind:change="onToggle"
    />
  </view>
  </block>
  <app-page-exit label="返回账号设置" tab-url="/pages/profile/index" />
</view>
