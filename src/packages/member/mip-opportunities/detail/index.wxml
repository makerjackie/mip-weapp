<view id="mip-opportunity-detail-page" class="mip-member-page min-h-screen bg-canvas px-3 pb-[calc(env(safe-area-inset-bottom)+220rpx)] pt-3 text-ink">
  <view aria-label="正在加载" aria-busy="true" wx:if="{{state === 'loading'}}" id="opportunity-detail-loading" class="flex flex-col gap-3">
    <view class="flex h-[352rpx] overflow-hidden rounded-[16rpx] bg-panel p-2">
      <view class="h-[320rpx] w-[240rpx] shrink-0 rounded-[8rpx] bg-panel-raised" />
      <view class="min-w-0 flex-1 px-2 py-2"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
    </view>
    <view class="min-h-[240rpx] rounded-[16rpx] bg-panel px-4 py-5"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
    <app-page-exit label="返回机会" />
  </view>
  <view wx:elif="{{state === 'error'}}"><mip-empty-state title="暂时无法查看机会" description="{{message}}" action-text="重新加载" bind:action="load" /><app-page-exit /></view>
  <!-- figma 1768_37414/1768_37369 机会详情还原态：信息卡(封面+三行要素+发表时间) +
       项目介绍长面板(烘焙稿) + 底部双胶囊 CTA(发布者=编辑/结束招募，访客=+3想引荐/我想引荐)。
       生产保持下方 skeleton+卡片+介绍布局（opportunity-detail 测试 pin）。fixture
       figmaLayout 打开时按稿渲染，文案与图标都来自 ui-fidelity manifest fixture。 -->
  <block wx:elif="{{figmaLayout}}">
    <view class="-mx-3 -mt-3 relative min-h-[1400rpx]">
      <view class="absolute left-[24rpx] top-[24rpx] h-[352rpx] w-[702rpx] overflow-hidden rounded-[16rpx] bg-panel">
        <image class="absolute left-[16rpx] top-[16rpx] h-[320rpx] w-[240rpx] rounded-[8rpx]" mode="aspectFill" src="{{figma.cover}}" />
        <view class="absolute left-[272rpx] top-[24rpx] text-[32rpx] font-medium leading-[44.8rpx] text-ink">{{figma.title}}</view>
        <view wx:for="{{figma.rows}}" wx:key="label" class="absolute flex items-center gap-[8rpx]" style="left:272rpx;top:{{84 + index * 46}}rpx">
          <image class="h-[32rpx] w-[32rpx] shrink-0" mode="aspectFit" src="/assets/figma/opportunities/{{item.icon}}.svg" />
          <text class="text-[24rpx] leading-[34rpx] text-ink">{{item.label}}：{{item.value}}</text>
        </view>
        <view class="absolute right-[24rpx] top-[288rpx] text-[24rpx] leading-[40rpx] text-muted">{{figma.published}}</view>
      </view>
      <image class="absolute left-[24rpx] top-[400rpx] h-[2316rpx] w-[702rpx]" mode="scaleToFill" src="/packages/member/assets/figma/opportunities/intro-panel.webp" />
      <view class="absolute left-[24rpx] top-[1268rpx] h-[112rpx] w-[702rpx]">
        <block wx:if="{{figma.guestCta}}">
          <view class="absolute left-[24rpx] top-[16rpx] flex h-[80rpx] w-[258rpx] items-center justify-center rounded-full border-[2rpx] border-canvas bg-panel">
            <image class="h-[48rpx] w-[112rpx]" src="/packages/member/assets/figma/coop/coop-avatars.webp" />
            <view class="ml-[8rpx] flex items-center">
              <text class="text-[20rpx] font-semibold leading-[28rpx] text-brand">+</text>
              <text class="text-[24rpx] font-medium leading-[33.6rpx] text-brand">3想引荐</text>
            </view>
          </view>
          <view class="absolute left-[306rpx] top-[16rpx] flex h-[80rpx] w-[372rpx] items-center justify-center rounded-full border-[2rpx] border-canvas bg-brand">
            <text class="text-[32rpx] font-medium leading-[44.8rpx] text-canvas">我想引荐</text>
          </view>
        </block>
        <block wx:else>
          <view class="absolute left-[24rpx] top-[16rpx] flex h-[80rpx] w-[176rpx] items-center justify-center gap-[8rpx] rounded-full border-[2rpx] border-canvas bg-panel">
            <image class="h-[40rpx] w-[40rpx]" mode="aspectFit" src="/packages/member/assets/figma/opportunities/edit-draft.svg" />
            <text class="text-[32rpx] font-medium leading-[44.8rpx] text-brand">编辑</text>
          </view>
          <view class="absolute left-[224rpx] top-[16rpx] flex h-[80rpx] w-[454rpx] items-center justify-center rounded-full border-[2rpx] border-canvas bg-brand">
            <text class="text-[32rpx] font-medium leading-[44.8rpx] text-canvas">已完成招募，结束机会</text>
          </view>
        </block>
      </view>
    </view>
  </block>
  <block wx:elif="{{item}}">
    <view wx:if="{{message}}" class="mb-3 rounded-[8rpx] bg-panel px-4 py-3 text-[22rpx] text-danger">{{message}}</view>
    <mip-opportunity-card variant="detail" title="{{item.title}}" cover-url="{{item.coverUrl || ''}}" value-text="{{item.commercialTerms.amountDisplay || item.valueSummary}}" city-text="{{item.city.label || ''}}" region-text="{{item.regionText || ''}}" location-text="{{item.commercialTerms.locationDisplay || item.city.label || item.branchName || '全国'}}" target-text="{{item.targetSummary}}" status="{{item.status}}" published-text="{{publishedText}}" published-prefix="发表于：" type-tags="{{typeTagViews}}" />
    <view class="mt-3 rounded-[16rpx] bg-panel px-3 py-3">
      <view class="flex items-center gap-1 text-[32rpx] font-medium"><image class="h-[32rpx] w-[32rpx] shrink-0" src="/packages/member/assets/figma/opportunities/project-introduction.svg" mode="aspectFit" /><text>项目介绍</text></view>
      <view wx:if="{{item.description}}" class="mt-3 whitespace-pre-wrap text-[24rpx] leading-[40rpx] text-muted">{{item.description}}</view>
      <view wx:else class="mt-3 rounded-[8rpx] bg-panel-raised px-4 py-4 text-[24rpx] text-muted">暂未填写项目介绍</view>
      <view wx:if="{{roleNames.length}}" class="mt-4 flex flex-wrap gap-2"><view wx:for="{{roleNames}}" wx:key="*this" class="rounded-full border border-line px-3 py-1 text-[22rpx] text-muted">{{item}}</view></view>
      <view wx:if="{{item.industryTags.length || item.abilityTags.length}}" class="mt-3 flex flex-wrap gap-2"><view wx:for="{{item.industryTags}}" wx:key="id" class="rounded-full bg-panel-raised px-3 py-1 text-[22rpx] text-muted">{{item.label}}</view><view wx:for="{{item.abilityTags}}" wx:key="id" class="rounded-full bg-panel-raised px-3 py-1 text-[22rpx] text-muted">{{item.label}}</view></view>
    </view>
    <!-- journey-review J4-05/J4-06：发布人底部条=编辑 + 分享机会（mip-sticky-actions + mip-pill-button）。
         招募中/已结束均可分享；已下架置灰不可点（组件 disabled 态）；未发布过的草稿保持「发布机会」主按钮。
         已结束（ENDED）服务端不可编辑，「编辑」置灰不可点（编辑入口仅 DRAFT/PUBLISHED）。 -->
    <mip-sticky-actions wx:if="{{ownerBar}}" id="opportunity-owner-actions">
      <view slot="actions" class="flex h-[112rpx] w-full items-center gap-3 px-[16rpx]">
        <mip-pill-button wx:if="{{ownerBar === 'draft'}}" class="w-[176rpx] shrink-0" variant="secondary" label="编辑草稿" withIcon bind:tap="edit">
          <image slot="icon" class="h-[40rpx] w-[40rpx]" src="/packages/member/assets/figma/opportunities/edit-draft.svg" mode="aspectFit" />
        </mip-pill-button>
        <mip-pill-button wx:elif="{{ownerBar === 'ended'}}" class="w-[176rpx] shrink-0" variant="secondary" label="编辑" withIcon disabled>
          <image slot="icon" class="h-[40rpx] w-[40rpx] opacity-50" src="/packages/member/assets/figma/opportunities/edit-draft.svg" mode="aspectFit" />
        </mip-pill-button>
        <mip-pill-button wx:else class="w-[176rpx] shrink-0" variant="secondary" label="编辑" withIcon bind:tap="edit">
          <image slot="icon" class="h-[40rpx] w-[40rpx]" src="/packages/member/assets/figma/opportunities/edit-draft.svg" mode="aspectFit" />
        </mip-pill-button>
        <mip-pill-button wx:if="{{ownerBar === 'draft'}}" class="min-w-0 flex-1" label="发布机会" bind:tap="edit" />
        <mip-pill-button wx:elif="{{ownerBar === 'unpublished'}}" class="min-w-0 flex-1" label="分享机会" disabled />
        <mip-pill-button wx:else class="min-w-0 flex-1" label="分享机会" openType="share" />
      </view>
    </mip-sticky-actions>
    <!-- journey-review J3-09 + figma 机会详情（访客视角）：非发布人底部条=液态玻璃 bar，
         左「+N想合作」mip-attend-pill（无合作意向时隐藏）+ 右黄色「我想合作」。
         合作意向支持取消；项目结束后只允许取消已有意向。 -->
    <mip-sticky-actions wx:elif="{{!item.mine && (item.status === 'PUBLISHED' || item.cooperationActive)}}" id="opportunity-cooperation-actions">
      <view slot="actions" class="flex h-[112rpx] w-full items-center gap-[16rpx]">
        <view wx:if="{{item.cooperationCount}}" class="shrink-0" aria-role="button" aria-label="查看想合作的人" bind:tap="openCooperators">
          <mip-attend-pill count="{{item.cooperationCount}}" label="想合作" avatars="{{cooperationAvatars}}" variant="dark" />
        </view>
        <mip-pill-button class="min-w-0 flex-1" label="{{acting ? '处理中' : item.cooperationActive ? '取消合作意向' : '我想合作'}}" loading="{{acting}}" bind:tap="cooperationIntent" />
      </view>
    </mip-sticky-actions>
    <mip-sticky-actions wx:elif="{{!item.mine && item.status === 'ENDED'}}" id="opportunity-cooperation-actions">
      <view slot="actions" class="flex h-[112rpx] w-full items-center gap-[16rpx]">
        <view wx:if="{{item.cooperationCount}}" class="shrink-0" aria-role="button" aria-label="查看想合作的人" bind:tap="openCooperators">
          <mip-attend-pill count="{{item.cooperationCount}}" label="想合作" avatars="{{cooperationAvatars}}" variant="dark" />
        </view>
        <mip-pill-button class="min-w-0 flex-1" label="项目已结束" disabled />
      </view>
    </mip-sticky-actions>
    <app-page-exit label="返回机会" />
    <t-popup visible="{{cooperatorsVisible}}" placement="bottom" prevent-scroll-through bind:visible-change="handleCooperatorsVisibility">
      <view class="rounded-t-[24rpx] bg-panel px-4 pb-[calc(env(safe-area-inset-bottom)+32rpx)] pt-5 text-ink">
        <view class="flex items-center justify-between"><text class="text-[30rpx] font-semibold">想合作的人</text><view class="flex min-h-[88rpx] items-center px-3" aria-role="button" bind:tap="closeCooperators">关闭</view></view>
        <scroll-view scroll-y class="h-[600rpx]" bindscrolltolower="loadMoreCooperators">
          <view wx:for="{{cooperators}}" wx:key="profileRef" class="my-2 flex min-h-[96rpx] items-center gap-3 rounded-[16rpx] bg-panel-raised px-3 py-3" data-profile-ref="{{item.profileRef}}" aria-role="button" bind:tap="openTeamMember">
            <image wx:if="{{item.avatarUrl}}" class="h-[72rpx] w-[72rpx] shrink-0 rounded-full" src="{{item.avatarUrl}}" mode="aspectFill" />
            <view class="min-w-0 flex-1"><view class="truncate">{{item.nickname}}</view><view wx:if="{{item.headline}}" class="mt-1 truncate text-[22rpx] text-muted">{{item.headline}}</view></view>
            <mip-icon name="chevron-down-1" size="{{14}}" color="var(--color-muted)" />
          </view>
          <view wx:if="{{cooperatorsMessage}}" class="py-4 text-center text-muted" aria-role="button" bind:tap="retryCooperators">{{cooperatorsMessage}}，点击重试</view>
          <view wx:elif="{{cooperatorsLoading}}" class="py-4 text-center text-muted">正在加载</view>
          <view wx:elif="{{!cooperators.length}}" class="py-8 text-center text-muted">暂无合作意向</view>
          <view wx:elif="{{cooperatorsCursor}}" class="py-4 text-center text-brand" aria-role="button" bind:tap="loadMoreCooperators">加载更多</view>
        </scroll-view>
      </view>
    </t-popup>
  </block>
  <!-- MIW-40：发布人订阅授权引导层。页面级单实例常驻（自隐藏），check 由页面在三时机调用。 -->
  <mip-subscription-guide id="opportunity-subscribe-guide" template-key="OPPORTUNITY_NOTICE" opportunity-id="{{id}}" />
</view>
