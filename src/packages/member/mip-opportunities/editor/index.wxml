<view id="mip-opportunity-editor-page" class="mip-member-page min-h-screen bg-canvas px-3 pb-[calc(env(safe-area-inset-bottom)+220rpx)] text-ink">
  <view wx:if="{{state === 'loading'}}" class="mt-3 flex flex-col gap-3">
    <view class="min-h-[196rpx] rounded-[16rpx] bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
    <view class="min-h-[360rpx] rounded-[16rpx] bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
    <app-page-exit always label="取消" />
  </view>
  <view wx:elif="{{state === 'error'}}" class="pt-3"><mip-empty-state title="暂时无法编辑机会" description="{{message}}" action-text="重新加载" bind:action="initialize" /><app-page-exit always label="取消" /></view>
  <!-- figma 1766_36864 发布机会-编辑还原态：黄条提示 + 虚线粘贴卡 + 图标小节标签 +
       输入卡/城市九宫格 chip。生产保持下方流式表单（opportunity-editor 测试 pin）。
       fixture figmaLayout 打开时按稿渲染，文案与图标都来自 ui-fidelity manifest fixture。 -->
  <block wx:elif="{{figmaLayout}}">
    <view class="-mx-3 relative min-h-[1500rpx]">
      <view class="absolute left-0 top-0 flex h-[64rpx] w-full items-center justify-center bg-brand text-[28rpx] font-medium leading-[39.2rpx] text-on-brand">{{figma.banner}}</view>
      <view class="absolute left-[24rpx] top-[88rpx] flex h-[200rpx] w-[702rpx] items-center justify-center gap-[8rpx] rounded-[16rpx] border-[2rpx] border-dashed border-brand bg-panel">
        <mip-icon name="file-copy" size="{{16}}" color="var(--color-brand)" />
        <text class="text-[28rpx] leading-[39.2rpx] text-brand">粘贴整段文字，自动识别</text>
      </view>
      <view wx:for="{{figma.fields}}" wx:key="label" class="absolute left-[24rpx] flex items-center gap-[8rpx]" style="top:{{item.labelTopRpx}}rpx">
        <image class="h-[32rpx] w-[32rpx]" mode="aspectFit" src="{{item.icon}}" />
        <text class="text-[32rpx] font-medium leading-[44.8rpx] text-ink">{{item.label}}</text>
      </view>
      <view wx:for="{{figma.inputs}}" wx:key="text" class="absolute left-[24rpx] flex h-[92rpx] w-[702rpx] items-center rounded-[16rpx] bg-panel px-[48rpx]" style="top:{{item.topRpx}}rpx">
        <text class="text-[28rpx] leading-[39.2rpx] text-muted">{{item.text}}</text>
      </view>
      <view class="absolute left-[24rpx] top-[748rpx] flex h-[92rpx] w-[702rpx] items-center justify-between rounded-[16rpx] bg-panel pl-[48rpx] pr-[32rpx]">
        <text class="text-[28rpx] leading-[39.2rpx] text-muted">请选择主营城市</text>
        <mip-icon name="chevron-right-1" size="{{15}}" color="var(--color-muted)" />
      </view>
      <view class="absolute left-[24rpx] top-[842rpx] h-[176rpx] w-[702rpx] rounded-[16rpx] bg-panel">
        <view wx:for="{{figma.cities}}" wx:key="label" class="absolute flex h-[56rpx] w-[156rpx] items-center justify-center rounded-full {{item.active ? 'bg-brand' : 'bg-canvas'}}" style="left:{{item.leftRpx}}rpx;top:{{item.topRpx}}rpx">
          <text class="text-[28rpx] font-medium leading-[39.2rpx] {{item.active ? 'text-on-brand' : 'text-muted'}}">{{item.label}}</text>
        </view>
      </view>
      <view class="absolute left-[24rpx] top-[1298rpx] h-[200rpx] w-[702rpx] rounded-[16rpx] bg-panel px-[48rpx] pt-[10rpx]">
        <text class="text-[28rpx] leading-[39.2rpx] text-muted">示例：寻找成熟消费品渠道</text>
        <text class="absolute bottom-[16rpx] right-[32rpx] text-[28rpx] leading-[39.2rpx] text-muted">0/300</text>
      </view>
    </view>
  </block>
  <block wx:else>
    <view class="-mx-3 flex h-[64rpx] items-center justify-center bg-brand px-4 text-center text-[24rpx] font-medium text-on-brand">准确的描述可以更容易帮你找到合作机会</view>
    <!-- journey-review J4-04 ④：粘贴整段文字，输入区内嵌「确认」小按钮，识别后就地填入不跳页。 -->
    <view id="opportunity-paste-card" class="relative mt-3 rounded-[16rpx] border border-dashed border-brand bg-panel p-3">
      <view class="flex min-h-[64rpx] items-center gap-2 text-[28rpx] text-brand" aria-role="button" aria-label="读取剪贴板文字" bind:tap="readClipboardIntoPaste"><mip-icon name="file-copy" size="{{15}}" color="var(--color-brand)" />{{pasteRecognizing ? '正在智能识别' : '粘贴整段文字，自动识别'}}</view>
      <textarea class="box-border mt-2 h-[120rpx] w-full max-w-full rounded-[8rpx] bg-panel-raised px-2 py-2 text-[28rpx]" value="{{pasteText}}" maxlength="6000" placeholder="把项目介绍整段粘到这里" aria-label="粘贴待识别文字" bindinput="updatePasteText" />
      <view class="mt-2 flex items-center justify-between">
        <text wx:if="{{pasteNotice}}" class="min-w-0 flex-1 text-[22rpx] text-muted">{{pasteNotice}}</text>
        <view wx:else class="flex-1" />
        <view wx:if="{{pasteText && !pasteRecognizing}}" class="flex h-[48rpx] w-[96rpx] shrink-0 items-center justify-center rounded-[8rpx] bg-brand text-[24rpx] font-medium text-on-brand active:bg-brand-active" aria-role="button" bind:tap="recognizePastedText">确认</view>
      </view>
    </view>
    <view class="mt-3 flex flex-col gap-4">
      <view id="opportunity-field-title"><view class="mb-2 flex items-center gap-2 text-[28rpx] font-medium"><image class="h-[32rpx] w-[32rpx]" src="/packages/member/assets/figma/opportunities/edit-draft.svg" mode="aspectFit" /><text>项目名称</text><text class="text-[22rpx] text-danger">必填</text></view><input class="box-border h-[92rpx] w-full max-w-full rounded-[16rpx] bg-panel px-2 text-[28rpx]" value="{{title}}" maxlength="120" placeholder="请输入你的项目名称" aria-label="项目名称，必填" data-field="title" bindinput="updateText" /><view wx:if="{{titleError}}" class="mt-2 text-[22rpx] text-danger" aria-live="polite">{{titleError}}</view></view>
      <view id="opportunity-field-value-summary"><view class="mb-2 flex items-center gap-2 text-[28rpx] font-medium"><image class="h-[32rpx] w-[32rpx]" src="/assets/figma/opportunities/money-cny-circle.svg" mode="aspectFit" /><text>价值金额</text><text class="text-[22rpx] text-danger">必填</text></view><textarea class="box-border h-[92rpx] min-h-[92rpx] w-full max-w-full rounded-[16rpx] bg-panel px-2 py-3 text-[28rpx]" value="{{valueSummary}}" maxlength="240" placeholder="请输入价值金额" aria-label="价值金额或价值说明，必填" data-field="valueSummary" bindinput="updateText" /><view wx:if="{{valueSummaryError}}" class="mt-2 text-[22rpx] text-danger" aria-live="polite">{{valueSummaryError}}</view></view>
      <view>
        <view class="mb-2 flex items-center gap-2 text-[28rpx] font-medium"><image class="h-[32rpx] w-[32rpx]" src="/assets/figma/opportunities/location.svg" mode="aspectFit" /><text>主营城市</text></view>
        <view class="rounded-[16rpx] bg-panel p-2">
          <picker mode="selector" range="{{cityOptions}}" range-key="label" value="{{cityIndex}}" bindchange="changeCity"><view class="flex min-h-[92rpx] items-center justify-between rounded-[8rpx] bg-panel-raised px-3 text-[24rpx]"><text>{{cityTagId ? cityOptions[cityIndex].label : '请选择主营城市'}}</text><mip-icon name="chevron-down-1" size="{{14}}" color="var(--color-muted)" /></view></picker>
          <view class="mt-2 grid grid-cols-4 gap-2"><block wx:for="{{cityGridOptions}}" wx:key="id"><view wx:if="{{cityTagId === item.id}}" class="flex min-h-[88rpx] items-center justify-center rounded-[8rpx] bg-brand px-1 text-center text-[22rpx] text-on-brand" data-id="{{item.id}}" bind:tap="chooseCity">{{item.label}}</view><view wx:else class="flex min-h-[88rpx] items-center justify-center rounded-[8rpx] bg-canvas px-1 text-center text-[22rpx] text-muted" data-id="{{item.id}}" bind:tap="chooseCity">{{item.label}}</view></block></view>
        </view>
      </view>
      <view id="opportunity-field-region"><view class="mb-2 flex items-center gap-2 text-[28rpx] font-medium"><image class="h-[32rpx] w-[32rpx]" src="/assets/figma/opportunities/location.svg" mode="aspectFit" /><text>主营地区（选填）</text></view><input class="box-border h-[92rpx] w-full max-w-full rounded-[16rpx] bg-panel px-2 text-[28rpx]" value="{{regionText}}" maxlength="60" placeholder="示例：南山十亩地" aria-label="主营地区，选填" data-field="regionText" bindinput="updateText" /></view>
      <view id="opportunity-field-target-summary"><view class="mb-2 flex items-center gap-2 text-[28rpx] font-medium"><image class="h-[32rpx] w-[32rpx]" src="/assets/figma/opportunities/service-target.svg" mode="aspectFit" /><text>寻找合作方</text><text class="text-[22rpx] text-danger">必填</text></view><view class="relative"><textarea class="box-border h-[200rpx] min-h-[200rpx] w-full max-w-full rounded-[16rpx] bg-panel px-2 pb-[48rpx] pt-2 text-[28rpx]" value="{{targetSummary}}" maxlength="300" placeholder="示例：寻找成熟消费品渠道" aria-label="寻找合作方，必填" data-field="targetSummary" bindinput="updateText" /><view class="pointer-events-none absolute bottom-2 right-2 text-[24rpx] text-muted">{{targetSummary.length}}/300</view></view><view wx:if="{{targetSummaryError}}" class="mt-2 text-[22rpx] text-danger" aria-live="polite">{{targetSummaryError}}</view></view>
      <view id="opportunity-field-description"><view class="mb-2 flex items-center gap-2 text-[28rpx] font-medium"><image class="h-[32rpx] w-[32rpx]" src="/packages/member/assets/figma/opportunities/project-introduction.svg" mode="aspectFit" /><text>展开讲讲（选填）</text></view><view class="relative"><textarea class="box-border h-[200rpx] min-h-[200rpx] w-full max-w-full rounded-[16rpx] bg-panel px-2 pb-[48rpx] pt-2 text-[28rpx]" value="{{description}}" maxlength="300" placeholder="请详细介绍你的项目情况" aria-label="展开讲讲，选填，最多300字" data-field="description" bindinput="updateText" /><view class="pointer-events-none absolute bottom-2 right-2 text-[24rpx] text-muted">{{description.length}}/300</view></view></view>
      <view id="opportunity-field-roles"><view class="mb-2 flex items-center gap-2 text-[28rpx] font-medium"><t-icon name="usergroup" size="32rpx" color="var(--color-brand)" /><text>合作角色</text><text class="text-[22rpx] text-danger">必填，至少选择一种</text></view><view class="flex flex-wrap gap-2"><block wx:for="{{roleOptions}}" wx:key="key"><view class="flex min-h-[88rpx] items-center gap-2 rounded-full px-3 text-[22rpx] {{item.selected ? 'bg-brand text-on-brand' : 'bg-panel text-muted'}}" aria-role="checkbox" aria-checked="{{item.selected}}" aria-label="{{item.name}}{{item.selected ? '，已选择' : '，未选择'}}" data-key="{{item.key}}" bind:tap="toggleRole"><view wx:if="{{item.selected}}" class="flex h-[32rpx] w-[32rpx] shrink-0 items-center justify-center rounded-full bg-panel"><mip-icon name="check" size="{{11}}" color="var(--color-brand)" /></view><view wx:else class="box-border h-[32rpx] w-[32rpx] shrink-0 rounded-full border border-brand" /><text>{{item.name}}</text></view></block></view><view wx:if="{{roleError}}" class="mt-2 text-[22rpx] text-danger" aria-live="polite">{{roleError}}</view></view>
      <view id="opportunity-field-visibility">
        <view class="mb-2 flex items-center gap-2 text-[28rpx] font-medium"><mip-icon name="contacts-1-1" size="{{16}}" color="var(--color-brand)" /><text>你希望项目被谁看到</text></view>
        <view class="overflow-hidden rounded-[16rpx] bg-panel">
          <view class="flex min-h-[104rpx] items-center gap-3 px-4" aria-role="radio" aria-checked="{{!playersOnly}}" data-visibility="PLATFORM" bind:tap="chooseVisibility"><view class="flex h-[48rpx] w-[48rpx] shrink-0 items-center justify-center rounded-full border-[4rpx] border-solid {{!playersOnly ? 'border-brand' : 'border-panel-raised'}}"><view wx:if="{{!playersOnly}}" class="h-[20rpx] w-[20rpx] rounded-full bg-brand" /></view><text class="text-[28rpx]">发布到平台，让更多人看到</text></view>
          <view class="border-t border-line" />
          <view class="flex min-h-[104rpx] items-center gap-3 px-4" aria-role="radio" aria-checked="{{playersOnly}}" data-visibility="INTERNAL" bind:tap="chooseVisibility"><view class="flex h-[48rpx] w-[48rpx] shrink-0 items-center justify-center rounded-full border-[4rpx] border-solid {{playersOnly ? 'border-brand' : 'border-panel-raised'}}"><view wx:if="{{playersOnly}}" class="h-[20rpx] w-[20rpx] rounded-full bg-brand" /></view><text class="text-[28rpx]">仅希望 MIP 内部玩家看到</text></view>
        </view>
      </view>
      <view>
        <view class="mb-2 flex items-center gap-2 text-[28rpx] font-medium"><mip-icon name="image" size="{{16}}" color="var(--color-brand)" /><text>项目封面（选填）</text></view>
        <view class="flex items-end gap-3">
          <image class="h-[240rpx] w-[180rpx] rounded-[8rpx] bg-panel-raised" mode="aspectFill" src="{{coverUrl || defaultCoverUrl}}" aria-role="button" bind:tap="chooseCover" />
          <view class="flex min-w-0 flex-1 flex-col gap-2"><t-button block variant="outline" loading="{{coverUploading}}" disabled="{{saving}}" bind:tap="chooseCover">{{coverUrl ? '更换封面' : '上传封面'}}</t-button><text class="text-[22rpx] text-muted">未上传时使用系统默认封面</text></view>
        </view>
        <view wx:if="{{coverMessage}}" class="mt-3 rounded-[8rpx] border border-danger px-3 py-3 text-[22rpx] text-danger" aria-live="polite">{{coverMessage}}</view>
      </view>
      <view id="opportunity-field-types">
        <view class="mb-2 flex items-center gap-2 text-[28rpx] font-medium"><mip-icon name="target" size="{{16}}" color="var(--color-brand)" /><text>机会类型</text></view>
        <view class="flex gap-3">
          <block wx:for="{{typeOptions}}" wx:key="key">
            <view wx:if="{{item.selected}}" class="flex h-[56rpx] w-[152rpx] items-center justify-center rounded-[16rpx] bg-brand text-[28rpx] font-medium text-on-brand" aria-role="checkbox" aria-checked="true" data-key="{{item.key}}" bind:tap="toggleTypeOption">{{item.label}}</view>
            <view wx:else class="box-border flex h-[56rpx] w-[152rpx] items-center justify-center rounded-[16rpx] border border-brand bg-panel text-[28rpx] text-brand" aria-role="checkbox" aria-checked="false" data-key="{{item.key}}" bind:tap="toggleTypeOption">{{item.label}}</view>
          </block>
        </view>
      </view>
      <view id="opportunity-field-status">
        <view class="mb-2 flex items-center gap-2 text-[28rpx] font-medium"><mip-icon name="signpost-fill" size="{{16}}" color="var(--color-brand)" /><text>项目状态</text></view>
        <view class="flex h-[92rpx] items-center justify-between rounded-[16rpx] bg-panel px-4" aria-role="button" aria-expanded="{{statusSheetVisible}}" bind:tap="openStatusSheet">
          <text class="text-[28rpx] text-brand">{{projectStatus === 'RECRUITING' ? '招募中' : projectStatus === 'ENDED' ? '结束项目' : '下架项目'}}</text>
          <mip-icon name="chevron-down-1" size="{{14}}" color="var(--color-muted)" />
        </view>
      </view>
    </view>
    <view wx:if="{{advancedOpen}}" class="mt-4 rounded-[16rpx] bg-panel px-4 py-5">
      <view class="text-[24rpx] font-medium">金额范围（元，选填）</view><view class="mt-2 flex gap-2"><input aria-label="最低金额" class="box-border h-[88rpx] min-w-0 flex-1 rounded-[8rpx] bg-panel-raised px-3 text-[24rpx]" type="digit" value="{{minAmountYuan}}" placeholder="最低金额" data-field="minAmountYuan" bindinput="updateAmount" /><input aria-label="最高金额" class="box-border h-[88rpx] min-w-0 flex-1 rounded-[8rpx] bg-panel-raised px-3 text-[24rpx]" type="digit" value="{{maxAmountYuan}}" placeholder="最高金额" data-field="maxAmountYuan" bindinput="updateAmount" /></view><view class="mt-3 flex gap-2"><block wx:for="{{['NATIONAL','REMOTE']}}" wx:key="*this"><view wx:if="{{locationTypes.indexOf(item) >= 0}}" class="flex min-h-[88rpx] items-center rounded-full bg-brand px-3 py-2 text-[22rpx] text-on-brand" data-type="{{item}}" bind:tap="toggleLocationType">{{item === 'NATIONAL' ? '全国' : '远程'}}</view><view wx:else class="flex min-h-[88rpx] items-center rounded-full bg-panel-raised px-3 py-2 text-[22rpx] text-muted" data-type="{{item}}" bind:tap="toggleLocationType">{{item === 'NATIONAL' ? '全国' : '远程'}}</view></block></view><view class="mt-2 text-[22rpx] text-muted">可选择多个合作城市，也可选择全国或远程。</view><view class="mt-2 flex flex-wrap gap-2"><block wx:for="{{cityOptions}}" wx:key="id"><view wx:if="{{item.id && locationCityTagIds.indexOf(item.id) >= 0}}" class="flex min-h-[88rpx] items-center rounded-full bg-brand px-2 py-2 text-[22rpx] text-on-brand" data-id="{{item.id}}" bind:tap="toggleLocationCity">{{item.label}}</view><view wx:elif="{{item.id}}" class="flex min-h-[88rpx] items-center rounded-full bg-panel-raised px-2 py-2 text-[22rpx] text-muted" data-id="{{item.id}}" bind:tap="toggleLocationCity">{{item.label}}</view></block></view>
    </view>
    <view wx:if="{{advancedOpen}}" class="mt-4 rounded-[16rpx] bg-panel px-4 py-5">
      <view class="flex items-center gap-2 text-[24rpx] font-semibold"><t-icon name="usergroup" size="32rpx" color="var(--color-brand)" /><text>发布范围</text></view>
      <view class="mt-3 flex gap-2"><view wx:if="{{scopeType === 'PLATFORM'}}" class="flex min-h-[88rpx] items-center rounded-full bg-brand px-4 text-[22rpx] text-on-brand" aria-role="radio" aria-checked="true" data-scope="PLATFORM" bind:tap="chooseScope">平台</view><view wx:else class="flex min-h-[88rpx] items-center rounded-full bg-panel-raised px-4 text-[22rpx] text-muted" aria-role="radio" aria-checked="false" data-scope="PLATFORM" bind:tap="chooseScope">平台</view><view wx:if="{{scopeType === 'BRANCH'}}" class="flex min-h-[88rpx] items-center rounded-full bg-brand px-4 text-[22rpx] text-on-brand" aria-role="radio" aria-checked="true" data-scope="BRANCH" bind:tap="chooseScope">城市分会</view><view wx:else class="flex min-h-[88rpx] items-center rounded-full bg-panel-raised px-4 text-[22rpx] text-muted" aria-role="radio" aria-checked="false" data-scope="BRANCH" bind:tap="chooseScope">城市分会</view></view>
      <picker wx:if="{{scopeType === 'BRANCH'}}" mode="selector" range="{{branchOptions}}" range-key="name" value="{{branchIndex}}" bindchange="changeBranch"><view class="mt-3 flex h-[80rpx] items-center justify-between rounded-[8rpx] bg-panel-raised px-3 text-[24rpx]"><text>{{branchOptions[branchIndex].name}}</text><mip-icon name="chevron-down-1" size="{{15}}" color="var(--color-muted)" /></view></picker>
    </view>
    <view class="mt-3 flex min-h-[88rpx] items-center justify-between rounded-[8rpx] border border-line bg-panel px-4 text-[24rpx]" aria-role="button" aria-expanded="{{advancedOpen}}" bind:tap="toggleAdvancedSettings"><view><view class="font-medium">更多设置</view><view class="mt-1 text-[22rpx] text-muted">金额、发布范围、行业、能力和团队成员</view></view><t-icon name="{{advancedOpen ? 'chevron-up' : 'chevron-down'}}" size="30rpx" color="var(--color-brand)" /></view>
    <view wx:if="{{advancedOpen}}" class="mt-4 rounded-[16rpx] bg-panel px-4 py-5">
      <view wx:if="{{industryGroups.length}}" class="text-[24rpx] font-semibold">行业</view><block wx:for="{{industryGroups}}" wx:for-item="group" wx:key="id"><view class="mt-3 text-[22rpx] text-muted">{{group.label}}</view><view class="mt-2 flex flex-wrap gap-2"><block wx:for="{{group.options}}" wx:for-item="tag" wx:key="id"><view wx:if="{{tag.selected}}" class="flex min-h-[88rpx] items-center rounded-full bg-brand px-3 text-[22rpx] text-on-brand" data-type="industry" data-id="{{tag.id}}" bind:tap="toggleTag">{{tag.label}}</view><view wx:else class="flex min-h-[88rpx] items-center rounded-full bg-panel-raised px-3 text-[22rpx] text-muted" data-type="industry" data-id="{{tag.id}}" bind:tap="toggleTag">{{tag.label}}</view></block></view></block>
      <view wx:if="{{abilityOptions.length}}" class="mt-5 text-[24rpx] font-semibold">能力</view><view class="mt-3 flex flex-wrap gap-2"><block wx:for="{{abilityOptions}}" wx:key="id"><view wx:if="{{item.selected}}" class="flex min-h-[88rpx] items-center rounded-full bg-brand px-3 text-[22rpx] text-on-brand" data-type="ability" data-id="{{item.id}}" bind:tap="toggleTag">{{item.label}}</view><view wx:else class="flex min-h-[88rpx] items-center rounded-full bg-panel-raised px-3 text-[22rpx] text-muted" data-type="ability" data-id="{{item.id}}" bind:tap="toggleTag">{{item.label}}</view></block></view>
    </view>
    <view wx:if="{{advancedOpen}}" class="mt-4 rounded-[16rpx] bg-panel px-4 py-5">
      <view class="flex items-center justify-between"><view><view class="text-[24rpx] font-semibold">团队成员</view><view class="mt-1 text-[22rpx] text-muted">仅可选择有效会员，最多 8 人</view></view><t-button size="small" variant="outline" theme="primary" bind:tap="openTeamPicker">选择成员</t-button></view>
      <view wx:if="{{teamMembers.length}}" class="mt-3 flex flex-col gap-2"><view wx:for="{{teamMembers}}" wx:key="profileRef" class="flex items-center rounded-[8rpx] bg-panel-raised px-3 py-3"><image wx:if="{{item.avatarUrl}}" class="mr-3 h-[64rpx] w-[64rpx] rounded-full" src="{{item.avatarUrl}}" mode="aspectFill" /><view wx:else class="mr-3 flex h-[64rpx] w-[64rpx] items-center justify-center rounded-full bg-brand-soft text-[22rpx] text-brand">MIP</view><view class="min-w-0 flex-1"><view class="truncate text-[24rpx] font-semibold">{{item.nickname}}</view><view wx:if="{{item.headline}}" class="mt-1 truncate text-[22rpx] text-muted">{{item.headline}}</view></view><view class="pl-3 text-[22rpx] text-danger" data-profile-ref="{{item.profileRef}}" catch:tap="removeTeamMember">移除</view></view></view>
      <view wx:else class="mt-3 rounded-[8rpx] bg-panel-raised px-3 py-4 text-[22rpx] text-muted">暂未添加团队成员</view>
    </view>
    <view wx:if="{{editorMode !== 'PUBLISHED'}}" class="mt-5"><t-button block size="large" variant="outline" theme="primary" disabled="{{saving || coverUploading}}" bind:tap="saveDraft">保存草稿</t-button></view>
    <view wx:if="{{message}}" class="mt-4 rounded-[8rpx] border border-danger px-4 py-3 text-[22rpx] text-danger" aria-live="polite">{{message}}</view>
    <!-- journey-review J4-04 ③：液态玻璃底部条 + 黄芯胶囊「确认发布」。 -->
    <view id="opportunity-editor-fixed-actions" class="mip-liquid-glass mip-member-fixed-inset fixed inset-x-3 bottom-[calc(env(safe-area-inset-bottom)+16rpx)] z-20 flex h-[112rpx] items-center rounded-full p-2">
      <view class="flex h-[80rpx] w-full items-center justify-center rounded-full bg-brand text-[32rpx] font-medium text-on-brand active:bg-brand-active {{saving || coverUploading ? 'opacity-60' : ''}}" aria-role="button" aria-disabled="{{saving || coverUploading}}" bind:tap="publish">{{editorMode === 'PUBLISHED' ? '保存修改' : '确认发布'}}</view>
    </view>
    <app-page-exit always label="取消" />
    <!-- journey-review QZ2：项目状态半屏三选项（说明文案逐字取自终审稿）+ 取消胶囊。
         新建流程先发布，已发布机会支持结束和下架。 -->
    <t-popup visible="{{statusSheetVisible}}" placement="bottom" prevent-scroll-through bind:visible-change="handleStatusSheetVisibility">
      <view class="box-border rounded-t-[32rpx] bg-panel px-3 pb-[calc(env(safe-area-inset-bottom)+32rpx)] pt-5 text-ink">
        <view class="px-2 text-[32rpx] font-semibold">项目状态</view>
        <view class="mt-2">
          <block wx:for="{{projectStatusOptions}}" wx:key="key">
            <view class="flex min-h-[120rpx] items-center justify-between gap-3 border-b border-line px-2 {{item.disabled ? 'opacity-50' : ''}}" aria-role="radio" aria-checked="{{projectStatus === item.key}}" aria-disabled="{{item.disabled}}" data-key="{{item.key}}" bind:tap="chooseProjectStatus">
              <view class="min-w-0 flex-1">
                <view class="flex items-center gap-2"><text class="text-[32rpx] {{projectStatus === item.key ? 'text-brand' : ''}}">{{item.label}}</text><text wx:if="{{item.disabledNote}}" class="shrink-0 rounded-full bg-panel-raised px-2 py-1 text-[20rpx] text-muted">{{item.disabledNote}}</text></view>
                <view class="mt-1 text-[24rpx] text-muted">{{item.description}}</view>
              </view>
              <mip-icon wx:if="{{projectStatus === item.key}}" name="check" size="{{16}}" color="var(--color-brand)" />
            </view>
          </block>
        </view>
        <view class="mt-4 flex h-[88rpx] items-center justify-center rounded-full bg-panel-raised text-[28rpx] text-muted" aria-role="button" bind:tap="closeStatusSheet">取消</view>
      </view>
    </t-popup>
    <t-popup visible="{{teamPickerVisible}}" placement="bottom" prevent-scroll-through bind:visible-change="handleTeamPickerVisibility">
      <view class="box-border max-h-[76vh] min-h-[520rpx] rounded-t-[24rpx] bg-panel px-4 pb-[calc(env(safe-area-inset-bottom)+32rpx)] pt-5 text-ink">
        <view class="flex items-center justify-between"><view class="text-[30rpx] font-semibold">选择团队成员</view><view class="flex min-h-[88rpx] items-center px-3 text-[24rpx] text-brand" bind:tap="closeTeamPicker">完成</view></view>
        <view class="mt-4 flex gap-2"><input aria-label="搜索姓名、公司或行业" class="box-border h-[88rpx] min-w-0 flex-1 rounded-[8rpx] bg-panel-raised px-3 text-[24rpx]" value="{{teamKeyword}}" maxlength="80" placeholder="搜索姓名、公司或行业" bindinput="updateTeamKeyword" confirm-type="search" bindconfirm="searchTeam" /><t-button theme="primary" loading="{{teamLoading}}" bind:tap="searchTeam">搜索</t-button></view>
        <view wx:if="{{!teamLoading && !teamCandidates.length}}" class="py-12 text-center text-[24rpx] text-muted">暂无符合条件的会员</view>
        <scroll-view wx:else scroll-y class="mt-4 max-h-[52vh]"><view wx:for="{{teamCandidates}}" wx:key="profileRef" class="mb-2 flex items-center rounded-[8rpx] bg-panel-raised px-3 py-3" data-profile-ref="{{item.profileRef}}" bind:tap="toggleTeamMember"><image wx:if="{{item.avatarUrl}}" class="mr-3 h-[72rpx] w-[72rpx] rounded-full" src="{{item.avatarUrl}}" mode="aspectFill" /><view wx:else class="mr-3 flex h-[72rpx] w-[72rpx] items-center justify-center rounded-full bg-brand-soft text-[22rpx] text-brand">MIP</view><view class="min-w-0 flex-1"><view class="truncate text-[24rpx] font-semibold">{{item.nickname || 'MIP 用户'}}</view><view wx:if="{{item.headline}}" class="mt-1 truncate text-[22rpx] text-muted">{{item.headline}}</view></view><view wx:if="{{item.selected}}" class="rounded-full bg-brand px-3 py-1 text-[22rpx] text-on-brand">已选择</view><view wx:else class="rounded-full border border-line px-3 py-1 text-[22rpx] text-muted">选择</view></view></scroll-view>
      </view>
    </t-popup>
  </block>
</view>
