<view id="mip-opportunity-editor-page" class="mip-member-page min-h-screen bg-canvas px-3 pb-[calc(env(safe-area-inset-bottom)+220rpx)] text-ink">
  <view wx:if="{{state === 'loading'}}" class="mt-3 flex flex-col gap-3">
    <view class="min-h-[196rpx] rounded-[16rpx] bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
    <view class="min-h-[360rpx] rounded-[16rpx] bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
    <app-page-exit always label="取消" />
  </view>
  <view wx:elif="{{state === 'error'}}" class="pt-3"><app-empty-state title="暂时无法编辑机会" description="{{message}}" action-text="重新加载" bind:action="initialize" /><app-page-exit always label="取消" /></view>
  <block wx:else>
    <view class="-mx-3 flex h-[64rpx] items-center justify-center bg-brand px-4 text-center text-[length:26rpx] font-medium text-on-brand">准确的描述可以更容易帮你找到合作机会</view>
    <view class="mt-3 flex min-h-[196rpx] items-center justify-center rounded-[16rpx] border border-dashed border-brand bg-panel text-[length:27rpx] text-brand active:bg-panel-raised" aria-role="button" aria-disabled="{{pasteRecognizing}}" bind:tap="pasteAndRecognize"><t-icon class="mr-2" name="file-copy" size="30rpx" color="var(--color-brand)" />{{pasteRecognizing ? '正在智能识别' : '粘贴整段文字，自动识别'}}</view>
    <view class="mt-3 flex flex-col gap-4">
      <view id="opportunity-field-title"><view class="mb-2 flex items-center gap-2 text-[length:28rpx] font-medium"><image class="h-[32rpx] w-[32rpx]" src="/assets/figma/opportunities/edit-draft.svg" mode="aspectFit" /><text>项目名称</text><text class="text-[length:22rpx] text-danger">必填</text></view><input class="box-border h-[92rpx] w-full max-w-full rounded-[16rpx] bg-panel px-2 text-[length:28rpx]" value="{{title}}" maxlength="120" placeholder="请输入你的项目名称" aria-label="项目名称，必填" data-field="title" bindinput="updateText" /><view wx:if="{{titleError}}" class="mt-2 text-[length:22rpx] text-danger" aria-live="polite">{{titleError}}</view></view>
      <view id="opportunity-field-value-summary"><view class="mb-2 flex items-center gap-2 text-[length:28rpx] font-medium"><image class="h-[32rpx] w-[32rpx]" src="/assets/figma/opportunities/money-cny-circle.svg" mode="aspectFit" /><text>价值金额</text><text class="text-[length:22rpx] text-danger">必填</text></view><textarea class="box-border h-[92rpx] min-h-[92rpx] w-full max-w-full rounded-[16rpx] bg-panel px-2 py-3 text-[length:28rpx]" value="{{valueSummary}}" maxlength="240" placeholder="请输入价值金额或价值说明" aria-label="价值金额或价值说明，必填" data-field="valueSummary" bindinput="updateText" /><view wx:if="{{valueSummaryError}}" class="mt-2 text-[length:22rpx] text-danger" aria-live="polite">{{valueSummaryError}}</view></view>
      <view>
        <view class="mb-2 flex items-center gap-2 text-[length:28rpx] font-medium"><image class="h-[32rpx] w-[32rpx]" src="/assets/figma/opportunities/location.svg" mode="aspectFit" /><text>主营城市</text></view>
        <view class="rounded-[16rpx] bg-panel p-2">
          <picker mode="selector" range="{{cityOptions}}" range-key="label" value="{{cityIndex}}" bindchange="changeCity"><view class="flex min-h-[92rpx] items-center justify-between rounded-[12rpx] bg-panel-raised px-3 text-[length:24rpx]"><text>{{cityTagId ? cityOptions[cityIndex].label : '未选择时为全国，可选择主营城市'}}</text><t-icon name="chevron-right" size="28rpx" color="var(--color-muted)" /></view></picker>
          <view class="mt-2 grid grid-cols-4 gap-2"><block wx:for="{{cityGridOptions}}" wx:key="id"><view wx:if="{{cityTagId === item.id}}" class="flex min-h-[88rpx] items-center justify-center rounded-[12rpx] bg-brand px-1 text-center text-[length:22rpx] text-on-brand" data-id="{{item.id}}" bind:tap="chooseCity">{{item.label}}</view><view wx:else class="flex min-h-[88rpx] items-center justify-center rounded-[12rpx] bg-canvas px-1 text-center text-[length:22rpx] text-muted" data-id="{{item.id}}" bind:tap="chooseCity">{{item.label}}</view></block></view>
        </view>
      </view>
      <view id="opportunity-field-target-summary"><view class="mb-2 flex items-center gap-2 text-[length:28rpx] font-medium"><image class="h-[32rpx] w-[32rpx]" src="/assets/figma/opportunities/service-target.svg" mode="aspectFit" /><text>寻找合作方</text><text class="text-[length:22rpx] text-danger">必填</text></view><view class="relative"><textarea class="box-border h-[200rpx] min-h-[200rpx] w-full max-w-full rounded-[16rpx] bg-panel px-2 pb-[48rpx] pt-2 text-[length:28rpx]" value="{{targetSummary}}" maxlength="500" placeholder="示例：寻找成熟消费品渠道" aria-label="寻找合作方，必填" data-field="targetSummary" bindinput="updateText" /><view class="pointer-events-none absolute bottom-2 right-2 text-[length:24rpx] text-muted">{{targetSummary.length}}/500</view></view><view wx:if="{{targetSummaryError}}" class="mt-2 text-[length:22rpx] text-danger" aria-live="polite">{{targetSummaryError}}</view></view>
      <view id="opportunity-field-description"><view class="mb-2 flex items-center gap-2 text-[length:28rpx] font-medium"><image class="h-[32rpx] w-[32rpx]" src="/assets/figma/opportunities/project-introduction.svg" mode="aspectFit" /><text>项目说明</text><text class="text-[length:22rpx] text-danger">必填</text></view><view class="relative"><textarea class="box-border h-[200rpx] min-h-[200rpx] w-full max-w-full rounded-[16rpx] bg-panel px-2 pb-[48rpx] pt-2 text-[length:28rpx]" value="{{description}}" maxlength="6000" placeholder="请详细介绍你的项目情况" aria-label="项目说明，必填" data-field="description" bindinput="updateText" /><view class="pointer-events-none absolute bottom-2 right-2 text-[length:24rpx] text-muted">{{description.length}}/6000</view></view><view wx:if="{{descriptionError}}" class="mt-2 text-[length:22rpx] text-danger" aria-live="polite">{{descriptionError}}</view></view>
      <view id="opportunity-field-roles"><view class="mb-2 flex items-center gap-2 text-[length:28rpx] font-medium"><t-icon name="usergroup" size="32rpx" color="var(--color-brand)" /><text>合作角色</text><text class="text-[length:22rpx] text-danger">必填，至少选择一种</text></view><view class="flex flex-wrap gap-2"><block wx:for="{{roleOptions}}" wx:key="key"><view class="flex min-h-[88rpx] items-center gap-2 rounded-full px-3 text-[length:22rpx] {{item.selected ? 'bg-brand text-on-brand' : 'bg-panel text-muted'}}" aria-role="checkbox" aria-checked="{{item.selected}}" aria-label="{{item.name}}{{item.selected ? '，已选择' : '，未选择'}}" data-key="{{item.key}}" bind:tap="toggleRole"><view wx:if="{{item.selected}}" class="flex h-[32rpx] w-[32rpx] shrink-0 items-center justify-center rounded-full bg-panel"><t-icon name="check" size="22rpx" color="var(--color-brand)" /></view><view wx:else class="box-border h-[32rpx] w-[32rpx] shrink-0 rounded-full border border-brand" /><text>{{item.name}}</text></view></block></view><view wx:if="{{roleError}}" class="mt-2 text-[length:22rpx] text-danger" aria-live="polite">{{roleError}}</view></view>
    </view>
    <view wx:if="{{advancedOpen}}" class="mt-4 rounded-[16rpx] bg-panel px-4 py-5">
      <view class="text-[length:24rpx] font-medium">金额范围（元，选填）</view><view class="mt-2 flex gap-2"><input aria-label="最低金额" class="box-border h-[88rpx] min-w-0 flex-1 rounded-[12rpx] bg-panel-raised px-3 text-[length:24rpx]" type="digit" value="{{minAmountYuan}}" placeholder="最低金额" data-field="minAmountYuan" bindinput="updateAmount" /><input aria-label="最高金额" class="box-border h-[88rpx] min-w-0 flex-1 rounded-[12rpx] bg-panel-raised px-3 text-[length:24rpx]" type="digit" value="{{maxAmountYuan}}" placeholder="最高金额" data-field="maxAmountYuan" bindinput="updateAmount" /></view><view class="mt-3 flex gap-2"><block wx:for="{{['NATIONAL','REMOTE']}}" wx:key="*this"><view wx:if="{{locationTypes.indexOf(item) >= 0}}" class="flex min-h-[88rpx] items-center rounded-full bg-brand px-3 py-2 text-[length:22rpx] text-on-brand" data-type="{{item}}" bind:tap="toggleLocationType">{{item === 'NATIONAL' ? '全国' : '远程'}}</view><view wx:else class="flex min-h-[88rpx] items-center rounded-full bg-panel-raised px-3 py-2 text-[length:22rpx] text-muted" data-type="{{item}}" bind:tap="toggleLocationType">{{item === 'NATIONAL' ? '全国' : '远程'}}</view></block></view><view class="mt-2 text-[length:22rpx] text-muted">可选择多个合作城市，也可选择全国或远程。</view><view class="mt-2 flex flex-wrap gap-2"><block wx:for="{{cityOptions}}" wx:key="id"><view wx:if="{{item.id && locationCityTagIds.indexOf(item.id) >= 0}}" class="flex min-h-[88rpx] items-center rounded-full bg-brand px-2 py-2 text-[length:22rpx] text-on-brand" data-id="{{item.id}}" bind:tap="toggleLocationCity">{{item.label}}</view><view wx:elif="{{item.id}}" class="flex min-h-[88rpx] items-center rounded-full bg-panel-raised px-2 py-2 text-[length:22rpx] text-muted" data-id="{{item.id}}" bind:tap="toggleLocationCity">{{item.label}}</view></block></view>
    </view>
    <view wx:if="{{advancedOpen}}" class="mt-4 rounded-[16rpx] bg-panel px-4 py-5">
      <view class="flex items-center gap-2 text-[length:26rpx] font-semibold"><t-icon name="usergroup" size="32rpx" color="var(--color-brand)" /><text>发布范围</text></view>
      <view class="mt-3 flex gap-2"><view wx:if="{{scopeType === 'PLATFORM'}}" class="flex min-h-[88rpx] items-center rounded-full bg-brand px-4 text-[length:22rpx] text-on-brand" aria-role="radio" aria-checked="true" data-scope="PLATFORM" bind:tap="chooseScope">平台</view><view wx:else class="flex min-h-[88rpx] items-center rounded-full bg-panel-raised px-4 text-[length:22rpx] text-muted" aria-role="radio" aria-checked="false" data-scope="PLATFORM" bind:tap="chooseScope">平台</view><view wx:if="{{scopeType === 'BRANCH'}}" class="flex min-h-[88rpx] items-center rounded-full bg-brand px-4 text-[length:22rpx] text-on-brand" aria-role="radio" aria-checked="true" data-scope="BRANCH" bind:tap="chooseScope">城市分会</view><view wx:else class="flex min-h-[88rpx] items-center rounded-full bg-panel-raised px-4 text-[length:22rpx] text-muted" aria-role="radio" aria-checked="false" data-scope="BRANCH" bind:tap="chooseScope">城市分会</view></view>
      <picker wx:if="{{scopeType === 'BRANCH'}}" mode="selector" range="{{branchOptions}}" range-key="name" value="{{branchIndex}}" bindchange="changeBranch"><view class="mt-3 flex h-[80rpx] items-center justify-between rounded-[12rpx] bg-panel-raised px-3 text-[length:24rpx]"><text>{{branchOptions[branchIndex].name}}</text><t-icon name="chevron-right" size="30rpx" color="var(--color-muted)" /></view></picker>
    </view>
    <view class="mt-4 rounded-[16rpx] bg-panel px-4 py-5">
      <view class="flex items-center gap-2 text-[length:26rpx] font-semibold"><t-icon name="image" size="32rpx" color="var(--color-brand)" /><text>机会封面</text></view>
      <image wx:if="{{coverUrl}}" class="mt-3 h-[240rpx] w-[180rpx] rounded-[8rpx] bg-panel-raised" mode="aspectFill" src="{{coverUrl}}" />
      <view wx:else class="mt-3 flex h-[240rpx] w-[180rpx] items-center justify-center rounded-[8rpx] border border-dashed border-brand bg-panel-raised text-[length:23rpx] text-brand active:bg-panel" aria-role="button" bind:tap="chooseCover">添加封面</view>
      <view class="mt-3"><t-button block variant="outline" loading="{{coverUploading}}" disabled="{{saving}}" bind:tap="chooseCover">{{coverUrl ? '更换封面' : '上传封面'}}</t-button></view>
      <view wx:if="{{coverMessage}}" class="mt-3 rounded-[12rpx] border border-danger px-3 py-3 text-[length:22rpx] text-danger" aria-live="polite">{{coverMessage}}</view>
    </view>
    <view class="mt-3 flex min-h-[88rpx] items-center justify-between rounded-[12rpx] border border-line bg-panel px-4 text-[length:24rpx]" aria-role="button" aria-expanded="{{advancedOpen}}" bind:tap="toggleAdvancedSettings"><view><view class="font-medium">更多设置</view><view class="mt-1 text-[length:22rpx] text-muted">金额、发布范围、行业、能力和团队成员</view></view><t-icon name="{{advancedOpen ? 'chevron-up' : 'chevron-down'}}" size="30rpx" color="var(--color-brand)" /></view>
    <view wx:if="{{advancedOpen}}" class="mt-4 rounded-[16rpx] bg-panel px-4 py-5">
      <view wx:if="{{industryGroups.length}}" class="text-[length:26rpx] font-semibold">行业</view><block wx:for="{{industryGroups}}" wx:for-item="group" wx:key="id"><view class="mt-3 text-[length:22rpx] text-muted">{{group.label}}</view><view class="mt-2 flex flex-wrap gap-2"><block wx:for="{{group.options}}" wx:for-item="tag" wx:key="id"><view wx:if="{{tag.selected}}" class="flex min-h-[88rpx] items-center rounded-full bg-brand px-3 text-[length:22rpx] text-on-brand" data-type="industry" data-id="{{tag.id}}" bind:tap="toggleTag">{{tag.label}}</view><view wx:else class="flex min-h-[88rpx] items-center rounded-full bg-panel-raised px-3 text-[length:22rpx] text-muted" data-type="industry" data-id="{{tag.id}}" bind:tap="toggleTag">{{tag.label}}</view></block></view></block>
      <view wx:if="{{abilityOptions.length}}" class="mt-5 text-[length:26rpx] font-semibold">能力</view><view class="mt-3 flex flex-wrap gap-2"><block wx:for="{{abilityOptions}}" wx:key="id"><view wx:if="{{item.selected}}" class="flex min-h-[88rpx] items-center rounded-full bg-brand px-3 text-[length:22rpx] text-on-brand" data-type="ability" data-id="{{item.id}}" bind:tap="toggleTag">{{item.label}}</view><view wx:else class="flex min-h-[88rpx] items-center rounded-full bg-panel-raised px-3 text-[length:22rpx] text-muted" data-type="ability" data-id="{{item.id}}" bind:tap="toggleTag">{{item.label}}</view></block></view>
    </view>
    <view wx:if="{{advancedOpen}}" class="mt-4 rounded-[16rpx] bg-panel px-4 py-5">
      <view class="flex items-center justify-between"><view><view class="text-[length:26rpx] font-semibold">团队成员</view><view class="mt-1 text-[length:22rpx] text-muted">仅可选择有效会员，最多 8 人</view></view><t-button size="small" variant="outline" theme="primary" bind:tap="openTeamPicker">选择成员</t-button></view>
      <view wx:if="{{teamMembers.length}}" class="mt-3 flex flex-col gap-2"><view wx:for="{{teamMembers}}" wx:key="profileRef" class="flex items-center rounded-[12rpx] bg-panel-raised px-3 py-3"><image wx:if="{{item.avatarUrl}}" class="mr-3 h-[64rpx] w-[64rpx] rounded-full" src="{{item.avatarUrl}}" mode="aspectFill" /><view wx:else class="mr-3 flex h-[64rpx] w-[64rpx] items-center justify-center rounded-full bg-brand-soft text-[length:22rpx] text-brand">MIP</view><view class="min-w-0 flex-1"><view class="truncate text-[length:24rpx] font-semibold">{{item.nickname}}</view><view wx:if="{{item.headline}}" class="mt-1 truncate text-[length:22rpx] text-muted">{{item.headline}}</view></view><view class="pl-3 text-[length:22rpx] text-danger" data-profile-ref="{{item.profileRef}}" catch:tap="removeTeamMember">移除</view></view></view>
      <view wx:else class="mt-3 rounded-[12rpx] bg-panel-raised px-3 py-4 text-[length:22rpx] text-muted">暂未添加团队成员</view>
    </view>
    <view wx:if="{{editorMode !== 'PUBLISHED'}}" class="mt-5"><t-button block size="large" variant="outline" theme="primary" disabled="{{saving || coverUploading}}" bind:tap="saveDraft">保存草稿</t-button></view>
    <view wx:if="{{message}}" class="mt-4 rounded-[12rpx] border border-danger px-4 py-3 text-[length:22rpx] text-danger" aria-live="polite">{{message}}</view>
    <view id="opportunity-editor-fixed-actions" class="mip-member-fixed-inset fixed inset-x-3 bottom-[calc(env(safe-area-inset-bottom)+16rpx)] z-20">
      <t-button block size="large" theme="primary" loading="{{saving}}" disabled="{{saving || coverUploading}}" bind:tap="publish">{{editorMode === 'PUBLISHED' ? '保存修改' : '发布机会'}}</t-button>
    </view>
    <app-page-exit always label="取消" />
    <t-popup visible="{{pastePreviewVisible}}" placement="bottom" prevent-scroll-through bind:visible-change="handlePastePreviewVisibility">
      <view class="box-border max-h-[76vh] min-h-[420rpx] rounded-t-[24rpx] bg-panel px-4 pb-[calc(env(safe-area-inset-bottom)+32rpx)] pt-5 text-ink">
        <view class="text-[length:30rpx] font-semibold">确认识别结果</view>
        <view class="mt-2 text-[length:22rpx] leading-5 text-muted">确认后只替换以下已识别字段，仍可继续修改。</view>
        <view wx:if="{{pasteRecognitionNotice}}" class="mt-3 rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:22rpx] leading-5 text-muted" aria-live="polite">{{pasteRecognitionNotice}}</view>
        <scroll-view scroll-y class="mt-4 max-h-[46vh]"><view wx:for="{{pastePreview}}" wx:key="key" class="mb-2 rounded-[12rpx] bg-panel-raised px-3 py-3"><view class="text-[length:22rpx] text-muted">{{item.label}}</view><view class="mt-1 whitespace-pre-wrap text-[length:24rpx] leading-6">{{item.value}}</view></view></scroll-view>
        <view class="mt-4 grid grid-cols-2 gap-3"><t-button block variant="outline" bind:tap="closePastePreview">取消</t-button><t-button block theme="primary" bind:tap="confirmPasteDraft">确认填入</t-button></view>
      </view>
    </t-popup>
    <t-popup visible="{{teamPickerVisible}}" placement="bottom" prevent-scroll-through bind:visible-change="handleTeamPickerVisibility">
      <view class="box-border max-h-[76vh] min-h-[520rpx] rounded-t-[24rpx] bg-panel px-4 pb-[calc(env(safe-area-inset-bottom)+32rpx)] pt-5 text-ink">
        <view class="flex items-center justify-between"><view class="text-[length:30rpx] font-semibold">选择团队成员</view><view class="flex min-h-[88rpx] items-center px-3 text-[length:23rpx] text-brand" bind:tap="closeTeamPicker">完成</view></view>
        <view class="mt-4 flex gap-2"><input aria-label="搜索姓名、公司或行业" class="box-border h-[88rpx] min-w-0 flex-1 rounded-[12rpx] bg-panel-raised px-3 text-[length:24rpx]" value="{{teamKeyword}}" maxlength="80" placeholder="搜索姓名、公司或行业" bindinput="updateTeamKeyword" confirm-type="search" bindconfirm="searchTeam" /><t-button theme="primary" loading="{{teamLoading}}" bind:tap="searchTeam">搜索</t-button></view>
        <view wx:if="{{!teamLoading && !teamCandidates.length}}" class="py-12 text-center text-[length:23rpx] text-muted">暂无符合条件的会员</view>
        <scroll-view wx:else scroll-y class="mt-4 max-h-[52vh]"><view wx:for="{{teamCandidates}}" wx:key="profileRef" class="mb-2 flex items-center rounded-[12rpx] bg-panel-raised px-3 py-3" data-profile-ref="{{item.profileRef}}" bind:tap="toggleTeamMember"><image wx:if="{{item.avatarUrl}}" class="mr-3 h-[72rpx] w-[72rpx] rounded-full" src="{{item.avatarUrl}}" mode="aspectFill" /><view wx:else class="mr-3 flex h-[72rpx] w-[72rpx] items-center justify-center rounded-full bg-brand-soft text-[length:22rpx] text-brand">MIP</view><view class="min-w-0 flex-1"><view class="truncate text-[length:24rpx] font-semibold">{{item.nickname || 'MIP 用户'}}</view><view wx:if="{{item.headline}}" class="mt-1 truncate text-[length:22rpx] text-muted">{{item.headline}}</view></view><view wx:if="{{item.selected}}" class="rounded-full bg-brand px-3 py-1 text-[length:22rpx] text-on-brand">已选择</view><view wx:else class="rounded-full border border-line px-3 py-1 text-[length:22rpx] text-muted">选择</view></view></scroll-view>
      </view>
    </t-popup>
  </block>
</view>
