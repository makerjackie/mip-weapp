<view id="mip-opportunity-editor-page" class="min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-4 text-ink">
  <view wx:if="{{state === 'loading'}}" class="rounded-[16rpx] bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}"><app-empty-state title="暂时无法编辑机会" description="{{message}}" action-text="重新加载" bind:action="initialize" /><app-page-exit /></view>
  <block wx:else>
    <view class="text-[length:36rpx] font-bold">{{id ? '编辑机会' : '发布机会'}}</view>
    <view class="mt-5 flex flex-col gap-4 rounded-[16rpx] bg-panel px-4 py-5">
      <view><view class="mb-2 text-[length:23rpx] text-muted">机会标题</view><input class="box-border h-[80rpx] w-full max-w-full rounded-[12rpx] bg-panel-raised px-3 text-[length:25rpx]" value="{{title}}" maxlength="120" placeholder="填写机会标题" data-field="title" bindinput="updateText" /></view>
      <view><view class="mb-2 text-[length:23rpx] text-muted">机会价值</view><textarea class="box-border min-h-[140rpx] w-full max-w-full rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:25rpx]" value="{{valueSummary}}" maxlength="240" placeholder="说明参与者可以获得的价值" data-field="valueSummary" bindinput="updateText" /></view>
      <view><view class="mb-2 text-[length:23rpx] text-muted">寻找内容</view><textarea class="box-border min-h-[160rpx] w-full max-w-full rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:25rpx]" value="{{targetSummary}}" maxlength="500" placeholder="说明需要的合作对象、资源或能力" data-field="targetSummary" bindinput="updateText" /></view>
      <view><view class="mb-2 text-[length:23rpx] text-muted">详细说明</view><textarea class="box-border min-h-[260rpx] w-full max-w-full rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:25rpx]" value="{{description}}" maxlength="6000" placeholder="填写背景、合作方式和其他说明" data-field="description" bindinput="updateText" /></view>
    </view>
    <view class="mt-4 rounded-[16rpx] bg-panel px-4 py-5">
      <view class="text-[length:26rpx] font-semibold">机会封面</view>
      <image wx:if="{{coverUrl}}" class="mt-3 h-[320rpx] w-full rounded-[12rpx] bg-panel-raised" mode="aspectFill" src="{{coverUrl}}" />
      <view wx:else class="mt-3 flex h-[240rpx] items-center justify-center rounded-[12rpx] bg-panel-raised text-[length:23rpx] text-muted">暂未上传封面</view>
      <view class="mt-3"><t-button block variant="outline" loading="{{coverUploading}}" disabled="{{saving}}" bind:tap="chooseCover">{{coverUrl ? '更换封面' : '上传封面'}}</t-button></view>
    </view>
    <view class="mt-4 rounded-[16rpx] bg-panel px-4 py-5">
      <view class="text-[length:26rpx] font-semibold">发布范围</view>
      <view class="mt-3 flex gap-2"><view wx:if="{{scopeType === 'PLATFORM'}}" class="rounded-full bg-brand px-4 py-2 text-[length:22rpx] text-on-brand" data-scope="PLATFORM" bind:tap="chooseScope">平台</view><view wx:else class="rounded-full bg-panel-raised px-4 py-2 text-[length:22rpx] text-muted" data-scope="PLATFORM" bind:tap="chooseScope">平台</view><view wx:if="{{scopeType === 'BRANCH'}}" class="rounded-full bg-brand px-4 py-2 text-[length:22rpx] text-on-brand" data-scope="BRANCH" bind:tap="chooseScope">城市分会</view><view wx:else class="rounded-full bg-panel-raised px-4 py-2 text-[length:22rpx] text-muted" data-scope="BRANCH" bind:tap="chooseScope">城市分会</view></view>
      <picker wx:if="{{scopeType === 'BRANCH'}}" mode="selector" range="{{branchOptions}}" range-key="name" value="{{branchIndex}}" bindchange="changeBranch"><view class="mt-3 flex h-[80rpx] items-center justify-between rounded-[12rpx] bg-panel-raised px-3 text-[length:24rpx]"><text>{{branchOptions[branchIndex].name}}</text><t-icon name="chevron-right" size="30rpx" color="var(--color-muted)" /></view></picker>
      <picker mode="selector" range="{{cityOptions}}" range-key="label" value="{{cityIndex}}" bindchange="changeCity"><view class="mt-3 flex h-[80rpx] items-center justify-between rounded-[12rpx] bg-panel-raised px-3 text-[length:24rpx]"><text>主营城市：{{cityOptions[cityIndex].label}}</text><t-icon name="chevron-right" size="30rpx" color="var(--color-muted)" /></view></picker>
    </view>
    <view class="mt-4 rounded-[16rpx] bg-panel px-4 py-5">
      <view class="text-[length:26rpx] font-semibold">合作角色</view><view class="mt-3 flex flex-wrap gap-2"><block wx:for="{{roleOptions}}" wx:key="key"><view wx:if="{{item.selected}}" class="rounded-full bg-brand px-3 py-2 text-[length:22rpx] text-on-brand" data-key="{{item.key}}" bind:tap="toggleRole">{{item.name}}</view><view wx:else class="rounded-full bg-panel-raised px-3 py-2 text-[length:22rpx] text-muted" data-key="{{item.key}}" bind:tap="toggleRole">{{item.name}}</view></block></view>
      <view wx:if="{{industryGroups.length}}" class="mt-5 text-[length:26rpx] font-semibold">行业</view><block wx:for="{{industryGroups}}" wx:for-item="group" wx:key="id"><view class="mt-3 text-[length:21rpx] text-muted">{{group.label}}</view><view class="mt-2 flex flex-wrap gap-2"><block wx:for="{{group.options}}" wx:for-item="tag" wx:key="id"><view wx:if="{{tag.selected}}" class="rounded-full bg-brand px-3 py-2 text-[length:22rpx] text-on-brand" data-type="industry" data-id="{{tag.id}}" bind:tap="toggleTag">{{tag.label}}</view><view wx:else class="rounded-full bg-panel-raised px-3 py-2 text-[length:22rpx] text-muted" data-type="industry" data-id="{{tag.id}}" bind:tap="toggleTag">{{tag.label}}</view></block></view></block>
      <view wx:if="{{abilityOptions.length}}" class="mt-5 text-[length:26rpx] font-semibold">能力</view><view class="mt-3 flex flex-wrap gap-2"><block wx:for="{{abilityOptions}}" wx:key="id"><view wx:if="{{item.selected}}" class="rounded-full bg-brand px-3 py-2 text-[length:22rpx] text-on-brand" data-type="ability" data-id="{{item.id}}" bind:tap="toggleTag">{{item.label}}</view><view wx:else class="rounded-full bg-panel-raised px-3 py-2 text-[length:22rpx] text-muted" data-type="ability" data-id="{{item.id}}" bind:tap="toggleTag">{{item.label}}</view></block></view>
    </view>
    <view class="mt-4 rounded-[16rpx] bg-panel px-4 py-5">
      <view class="flex items-center justify-between"><view><view class="text-[length:26rpx] font-semibold">团队成员</view><view class="mt-1 text-[length:21rpx] text-muted">仅可选择有效会员，最多 8 人</view></view><t-button size="small" variant="outline" theme="primary" bind:tap="openTeamPicker">选择成员</t-button></view>
      <view wx:if="{{teamMembers.length}}" class="mt-3 flex flex-col gap-2"><view wx:for="{{teamMembers}}" wx:key="profileRef" class="flex items-center rounded-[12rpx] bg-panel-raised px-3 py-3"><image wx:if="{{item.avatarUrl}}" class="mr-3 h-[64rpx] w-[64rpx] rounded-full" src="{{item.avatarUrl}}" mode="aspectFill" /><view wx:else class="mr-3 flex h-[64rpx] w-[64rpx] items-center justify-center rounded-full bg-brand-soft text-[length:22rpx] text-brand">MIP</view><view class="min-w-0 flex-1"><view class="truncate text-[length:24rpx] font-semibold">{{item.nickname}}</view><view wx:if="{{item.headline}}" class="mt-1 truncate text-[length:20rpx] text-muted">{{item.headline}}</view></view><view class="pl-3 text-[length:21rpx] text-danger" data-profile-ref="{{item.profileRef}}" catch:tap="removeTeamMember">移除</view></view></view>
      <view wx:else class="mt-3 rounded-[12rpx] bg-panel-raised px-3 py-4 text-[length:22rpx] text-muted">暂未添加团队成员</view>
    </view>
    <view wx:if="{{message}}" class="mt-4 rounded-[12rpx] border border-danger px-4 py-3 text-[length:22rpx] text-danger">{{message}}</view>
    <view class="mt-5 flex gap-3"><t-button class="min-w-0 flex-1" block size="large" variant="outline" theme="primary" disabled="{{saving || coverUploading}}" bind:tap="saveDraft">保存草稿</t-button><t-button class="min-w-0 flex-1" block size="large" theme="primary" loading="{{saving}}" disabled="{{coverUploading}}" bind:tap="publish">发布</t-button></view>
    <app-page-exit label="取消" />
    <t-popup visible="{{teamPickerVisible}}" placement="bottom" prevent-scroll-through bind:visible-change="handleTeamPickerVisibility">
      <view class="box-border max-h-[76vh] min-h-[520rpx] rounded-t-[24rpx] bg-panel px-4 pb-[calc(env(safe-area-inset-bottom)+32rpx)] pt-5 text-ink">
        <view class="flex items-center justify-between"><view class="text-[length:30rpx] font-semibold">选择团队成员</view><view class="text-[length:23rpx] text-brand" bind:tap="closeTeamPicker">完成</view></view>
        <view class="mt-4 flex gap-2"><input class="box-border h-[76rpx] min-w-0 flex-1 rounded-[12rpx] bg-panel-raised px-3 text-[length:24rpx]" value="{{teamKeyword}}" maxlength="80" placeholder="搜索姓名、公司或行业" bindinput="updateTeamKeyword" confirm-type="search" bindconfirm="searchTeam" /><t-button theme="primary" loading="{{teamLoading}}" bind:tap="searchTeam">搜索</t-button></view>
        <view wx:if="{{!teamLoading && !teamCandidates.length}}" class="py-12 text-center text-[length:23rpx] text-muted">暂无符合条件的会员</view>
        <scroll-view wx:else scroll-y class="mt-4 max-h-[52vh]"><view wx:for="{{teamCandidates}}" wx:key="profileRef" class="mb-2 flex items-center rounded-[12rpx] bg-panel-raised px-3 py-3" data-profile-ref="{{item.profileRef}}" bind:tap="toggleTeamMember"><image wx:if="{{item.avatarUrl}}" class="mr-3 h-[72rpx] w-[72rpx] rounded-full" src="{{item.avatarUrl}}" mode="aspectFill" /><view wx:else class="mr-3 flex h-[72rpx] w-[72rpx] items-center justify-center rounded-full bg-brand-soft text-[length:22rpx] text-brand">MIP</view><view class="min-w-0 flex-1"><view class="truncate text-[length:24rpx] font-semibold">{{item.nickname || 'MIP 用户'}}</view><view wx:if="{{item.headline}}" class="mt-1 truncate text-[length:20rpx] text-muted">{{item.headline}}</view></view><view wx:if="{{item.selected}}" class="rounded-full bg-brand px-3 py-1 text-[length:20rpx] text-on-brand">已选择</view><view wx:else class="rounded-full border border-line px-3 py-1 text-[length:20rpx] text-muted">选择</view></view></scroll-view>
      </view>
    </t-popup>
  </block>
</view>
