<view id="mip-opportunity-editor-page" class="mip-member-page min-h-screen bg-canvas px-3 pb-[calc(env(safe-area-inset-bottom)+220rpx)] text-ink">
  <view wx:if="{{state === 'loading'}}" class="mt-3 flex flex-col gap-3">
    <view class="min-h-[196rpx] rounded-[16rpx] bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
    <view class="min-h-[360rpx] rounded-[16rpx] bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
    <app-page-exit label="取消" />
  </view>
  <view wx:elif="{{state === 'error'}}" class="pt-3"><mip-empty-state title="暂时无法编辑机会" description="{{message}}" action-text="重新加载" bind:action="initialize" /><app-page-exit label="取消" /></view>
  <!-- figma 3359:6086 发布机会-编辑-最新：黄条提示 + 虚线粘贴卡（粘贴并识别）+ 图标小节标签 +
       机会类型/项目状态/可见性行卡 + 城市宫格 chip + 默认封面与虚线添加卡。
       2026-10-07 客户确认删除「更多设置」（金额范围/合作地点/发布范围/行业/能力/团队成员，
       均为服务端选填）：小程序只保留主表单；存量值在编辑时原样带回，字段改由管理后台维护。 -->
  <block wx:else>
    <view class="-mx-3 flex h-[64rpx] items-center justify-center bg-brand px-4 text-center text-[28rpx] font-medium leading-[40rpx] text-on-brand">准确的描述可以更容易帮你找到合作机会</view>
    <!-- journey-review J4-04 ④：粘贴整段文字一键识别，就地填入不跳页。 -->
    <view id="opportunity-paste-card" class="mt-3 flex h-[200rpx] flex-col items-center justify-center gap-[16rpx] rounded-[16rpx] border-[2rpx] border-dashed border-brand bg-panel">
      <view class="flex items-center gap-[8rpx] text-[28rpx] text-brand"><mip-icon name="file-copy" size="{{15}}" color="var(--color-brand)" />粘贴整段文字，自动识别</view>
      <view class="flex h-[50rpx] items-center justify-center rounded-full bg-brand px-[24rpx] text-[24rpx] font-medium leading-[34rpx] text-on-brand active:bg-brand-active {{pasteRecognizing ? 'opacity-60' : ''}}" aria-role="button" aria-disabled="{{pasteRecognizing}}" bind:tap="pasteAndRecognize">{{pasteRecognizing ? '正在识别' : '粘贴并识别'}}</view>
    </view>
    <view class="mt-3 flex flex-col gap-3">
      <view id="opportunity-field-types">
        <view class="flex items-center gap-[8rpx] text-[32rpx] font-medium leading-[44rpx]"><image class="h-[32rpx] w-[32rpx]" src="/assets/figma/opportunities/type-bubble-chart.svg" mode="aspectFit" /><text>机会类型</text></view>
        <view class="mt-2 flex flex-col gap-3">
          <block wx:for="{{typeOptions}}" wx:key="key">
            <view class="flex min-h-[92rpx] items-center gap-[20rpx] rounded-[16rpx] bg-panel px-[16rpx]" aria-role="checkbox" aria-checked="{{item.selected}}" aria-label="{{item.label}}，{{item.hint}}" data-key="{{item.key}}" bind:tap="toggleTypeOption">
              <view wx:if="{{item.selected}}" class="flex h-[48rpx] w-[48rpx] shrink-0 items-center justify-center rounded-full bg-brand"><mip-icon name="check" size="{{12}}" color="var(--color-on-brand)" /></view>
              <view wx:else class="box-border h-[40rpx] w-[40rpx] shrink-0 rounded-full border-[2rpx] border-solid border-brand" />
              <text class="shrink-0 text-[28rpx] font-medium leading-[40rpx]">{{item.label}}</text>
              <text class="min-w-0 flex-1 truncate text-[24rpx] leading-[34rpx] text-muted">{{item.hint}}</text>
            </view>
          </block>
        </view>
      </view>
      <view id="opportunity-field-title">
        <view class="flex items-center gap-[8rpx] text-[32rpx] font-medium leading-[44rpx]"><image class="h-[32rpx] w-[32rpx]" src="/packages/member/assets/figma/opportunities/edit-draft.svg" mode="aspectFit" /><text>机会名称</text></view>
        <input class="mt-2 box-border h-[92rpx] w-full max-w-full rounded-[16rpx] bg-panel px-[16rpx] text-[28rpx]" value="{{title}}" maxlength="120" placeholder="请输入名称，让人一听就了解这是什么事" aria-label="机会名称，必填" data-field="title" bindinput="updateText" />
        <view wx:if="{{titleError}}" class="mt-2 text-[22rpx] text-danger" aria-live="polite">{{titleError}}</view>
      </view>
      <view id="opportunity-field-value-summary">
        <view class="flex items-center gap-[8rpx] text-[32rpx] font-medium leading-[44rpx]"><image class="h-[32rpx] w-[32rpx]" src="/assets/figma/opportunities/money-cny-circle.svg" mode="aspectFit" /><text>价值金额</text></view>
        <textarea class="mt-2 box-border h-[92rpx] min-h-[92rpx] w-full max-w-full rounded-[16rpx] bg-panel px-[16rpx] py-3 text-[28rpx]" value="{{valueSummary}}" maxlength="240" placeholder="请输入价值金额，让参与者跃跃欲试" aria-label="价值金额或价值说明，必填" data-field="valueSummary" bindinput="updateText" />
        <view wx:if="{{valueSummaryError}}" class="mt-2 text-[22rpx] text-danger" aria-live="polite">{{valueSummaryError}}</view>
      </view>
      <view id="opportunity-field-city">
        <view class="flex items-center gap-[8rpx] text-[32rpx] font-medium leading-[44rpx]"><image class="h-[32rpx] w-[32rpx]" src="/assets/figma/opportunities/city-building.svg" mode="aspectFit" /><text>主营城市</text></view>
        <view class="mt-2 rounded-[16rpx] bg-panel p-[16rpx]">
          <picker mode="selector" range="{{cityOptions}}" range-key="label" value="{{cityIndex}}" bindchange="changeCity">
            <view class="flex min-h-[60rpx] items-center justify-between px-[8rpx]" aria-role="button" aria-label="选择主营城市">
              <text class="text-[28rpx] {{cityTagId ? 'text-ink' : 'text-muted'}}">{{cityTagId ? cityOptions[cityIndex].label : '哪些城市有这个机会'}}</text>
              <mip-icon name="chevron-right-1" size="{{15}}" color="var(--color-muted)" />
            </view>
          </picker>
          <view class="mt-[12rpx] grid grid-cols-4 gap-[16rpx]">
            <block wx:for="{{cityGridOptions}}" wx:key="id">
              <view wx:if="{{cityTagId === item.id}}" class="flex h-[56rpx] items-center justify-center rounded-[16rpx] bg-brand text-center text-[28rpx] font-medium text-on-brand" data-id="{{item.id}}" bind:tap="chooseCity">{{item.label}}</view>
              <view wx:else class="flex h-[56rpx] items-center justify-center rounded-[16rpx] bg-canvas text-center text-[28rpx] text-muted" data-id="{{item.id}}" bind:tap="chooseCity">{{item.label}}</view>
            </block>
          </view>
        </view>
      </view>
      <view id="opportunity-field-region">
        <view class="flex items-center gap-[8rpx] text-[32rpx] font-medium leading-[44rpx]"><image class="h-[32rpx] w-[32rpx]" src="/assets/figma/opportunities/location.svg" mode="aspectFit" /><text>主营地区（选填）</text></view>
        <input class="mt-2 box-border h-[92rpx] w-full max-w-full rounded-[16rpx] bg-panel px-[16rpx] text-[28rpx]" value="{{regionText}}" maxlength="60" placeholder="示例：观澜古墟" aria-label="主营地区，选填" data-field="regionText" bindinput="updateText" />
      </view>
      <view id="opportunity-field-target-summary">
        <view class="flex items-center gap-[8rpx] text-[32rpx] font-medium leading-[44rpx]"><image class="h-[32rpx] w-[32rpx]" src="/assets/figma/opportunities/service-target.svg" mode="aspectFit" /><text>寻找合作方</text></view>
        <view class="relative">
          <textarea class="mt-2 box-border h-[200rpx] min-h-[200rpx] w-full max-w-full rounded-[16rpx] bg-panel px-[16rpx] pb-[48rpx] pt-3 text-[28rpx]" value="{{targetSummary}}" maxlength="300" placeholder="示例：我要寻找IDG或同级别投资机构的FA" aria-label="寻找合作方，必填" data-field="targetSummary" bindinput="updateText" />
          <view class="pointer-events-none absolute bottom-2 right-4 text-[24rpx] text-muted">{{targetSummary.length}}/300</view>
        </view>
        <view wx:if="{{targetSummaryError}}" class="mt-2 text-[22rpx] text-danger" aria-live="polite">{{targetSummaryError}}</view>
      </view>
      <view id="opportunity-field-description">
        <view class="flex items-center gap-[8rpx] text-[32rpx] font-medium leading-[44rpx]"><image class="h-[32rpx] w-[32rpx]" src="/packages/member/assets/figma/opportunities/project-introduction.svg" mode="aspectFit" /><text>展开讲讲（选填）</text></view>
        <view class="relative">
          <textarea class="mt-2 box-border h-[200rpx] min-h-[200rpx] w-full max-w-full rounded-[16rpx] bg-panel px-[16rpx] pb-[48rpx] pt-3 text-[28rpx]" value="{{description}}" maxlength="300" placeholder="请详细介绍你的项目情况" aria-label="展开讲讲，选填，最多300字" data-field="description" bindinput="updateText" />
          <view class="pointer-events-none absolute bottom-2 right-4 text-[24rpx] text-muted">{{description.length}}/300</view>
        </view>
      </view>
      <!-- MIW-50 客户确认（2026-10-07）：设计稿无「合作角色」表单项，小程序不再提供角色编辑。
           roleOptions 仅作存量回填，编辑时随 save() 原样带回；新增机会不传角色，
           字段改由管理后台维护。 -->
      <view id="opportunity-field-status">
        <view class="flex items-center gap-[8rpx] text-[32rpx] font-medium leading-[44rpx]"><image class="h-[32rpx] w-[32rpx]" src="/assets/figma/opportunities/status-hourglass.svg" mode="aspectFit" /><text>项目状态</text></view>
        <view class="mt-2 flex h-[92rpx] items-center justify-between rounded-[16rpx] bg-panel px-[16rpx]" aria-role="button" aria-expanded="{{statusSheetVisible}}" aria-label="选择项目状态" bind:tap="openStatusSheet">
          <text class="text-[28rpx] font-medium">{{projectStatusText}}</text>
          <mip-icon name="chevron-down-1-15" size="{{12}}" color="var(--color-ink)" />
        </view>
      </view>
      <view id="opportunity-field-visibility">
        <view class="flex items-center gap-[8rpx] text-[32rpx] font-medium leading-[44rpx]"><image class="h-[32rpx] w-[32rpx]" src="/assets/figma/opportunities/eye-visible.svg" mode="aspectFit" /><text>你希望项目被谁看到</text></view>
        <view class="mt-2 flex flex-col gap-3">
          <view class="flex min-h-[92rpx] items-center gap-[16rpx] rounded-[16rpx] bg-panel px-[16rpx]" aria-role="radio" aria-checked="{{!playersOnly}}" data-visibility="PLATFORM" bind:tap="chooseVisibility">
            <view wx:if="{{!playersOnly}}" class="flex h-[48rpx] w-[48rpx] shrink-0 items-center justify-center rounded-full bg-brand"><mip-icon name="check" size="{{12}}" color="var(--color-on-brand)" /></view>
            <view wx:else class="box-border h-[40rpx] w-[40rpx] shrink-0 rounded-full border-[2rpx] border-solid border-brand" />
            <text class="text-[28rpx]">发布到平台，让更多人看到</text>
          </view>
          <view class="flex min-h-[92rpx] items-center gap-[16rpx] rounded-[16rpx] bg-panel px-[16rpx]" aria-role="radio" aria-checked="{{playersOnly}}" data-visibility="INTERNAL" bind:tap="chooseVisibility">
            <view wx:if="{{playersOnly}}" class="flex h-[48rpx] w-[48rpx] shrink-0 items-center justify-center rounded-full bg-brand"><mip-icon name="check" size="{{12}}" color="var(--color-on-brand)" /></view>
            <view wx:else class="box-border h-[40rpx] w-[40rpx] shrink-0 rounded-full border-[2rpx] border-solid border-brand" />
            <text class="text-[28rpx]">仅希望 MIP 内部玩家看到</text>
          </view>
        </view>
      </view>
      <view id="opportunity-field-cover">
        <view class="flex items-center gap-[8rpx] text-[32rpx] font-medium leading-[44rpx]"><image class="h-[32rpx] w-[32rpx]" src="/assets/figma/opportunities/cover-image.svg" mode="aspectFit" /><text>项目封面（选填）</text></view>
        <view class="mt-2 flex gap-3">
          <image class="h-[240rpx] w-[180rpx] rounded-[16rpx] bg-panel-raised" mode="aspectFill" src="{{coverUrl || defaultCoverUrl}}" aria-role="img" aria-label="当前项目封面" />
          <view class="flex h-[240rpx] w-[180rpx] items-center justify-center gap-[8rpx] rounded-[16rpx] border-[2rpx] border-dashed border-brand bg-panel {{coverUploading ? 'opacity-60' : ''}}" aria-role="button" aria-label="{{coverUrl ? '更换封面' : '添加封面'}}" bind:tap="chooseCover">
            <image class="h-[28rpx] w-[28rpx]" src="/assets/figma/opportunities/cover-add-plus.svg" mode="aspectFit" />
            <text class="text-[28rpx] font-medium text-brand">{{coverUploading ? '上传中' : '添加'}}</text>
          </view>
        </view>
        <view wx:if="{{coverMessage}}" class="mt-3 rounded-[8rpx] border border-danger px-3 py-3 text-[22rpx] text-danger" aria-live="polite">{{coverMessage}}</view>
      </view>
    </view>
    <!-- MIW-50 客户确认（2026-10-07）：编辑器不提供「保存草稿」按钮，表单只走
         「确认发布/保存修改」（publish=true）；草稿态编辑（编辑草稿入口）同样
         以发布收口，字段填完即可发布。 -->
    <!-- MIP-3：保存失败横幅固定在吸底保存按钮上方，不自动消失（下一次保存或修改字段后清除）。 -->
    <view wx:if="{{message}}" class="save-error-banner rounded-[8rpx] border border-danger px-4 py-3 text-[22rpx] text-danger" aria-live="polite">{{message}}</view>
    <!-- journey-review J4-04 ③：液态玻璃底部条（mip-sticky-actions）+ 黄芯胶囊「确认发布」（mip-pill-button）。 -->
    <mip-sticky-actions id="opportunity-editor-fixed-actions">
      <view slot="actions" class="w-full px-[16rpx]">
        <mip-pill-button class="w-full" label="{{editorMode === 'PUBLISHED' ? '保存修改' : '确认发布'}}" loading="{{saving}}" disabled="{{saving || coverUploading}}" bind:tap="publish" />
      </view>
    </mip-sticky-actions>
    <!-- journey-review QZ2：项目状态半屏三选项（说明文案逐字取自终审稿）+ 取消胶囊。
         新建流程先发布，已发布机会支持结束和下架。 -->
    <t-popup visible="{{statusSheetVisible}}" placement="bottom" prevent-scroll-through bind:visible-change="handleStatusSheetVisibility">
      <view class="box-border rounded-t-[32rpx] bg-panel px-3 pb-[calc(env(safe-area-inset-bottom)+32rpx)] pt-5 text-ink">
        <view class="px-2 text-[32rpx] font-semibold">项目状态</view>
        <view class="mt-2">
          <block wx:for="{{projectStatusOptions}}" wx:key="key">
            <view class="flex min-h-[120rpx] items-center justify-between gap-3 border-b border-line px-2 {{item.disabled ? 'opacity-50' : ''}}" aria-role="radio" aria-checked="{{projectStatus === item.key}}" aria-disabled="{{item.disabled}}" data-key="{{item.key}}" bind:tap="chooseProjectStatus">
              <view class="min-w-0 flex-1">
                <view class="flex items-center gap-2"><text class="text-[32rpx] {{projectStatus === item.key ? 'text-brand' : ''}}">{{item.label}}</text><text wx:if="{{item.disabledNote}}" class="shrink-0 rounded-full bg-panel-raised px-2 py-1 text-[20rpx] text-muted">{{item.disabledNote}}</text></view>
                <view class="mt-1 text-[24rpx] text-muted">{{item.description}}</view>
              </view>
              <mip-icon wx:if="{{projectStatus === item.key}}" name="check" size="{{16}}" color="var(--color-brand)" />
            </view>
          </block>
        </view>
        <view class="mt-4 flex h-[88rpx] items-center justify-center rounded-full bg-panel-raised text-[28rpx] text-muted" aria-role="button" bind:tap="closeStatusSheet">取消</view>
      </view>
    </t-popup>
  </block>
</view>
