<view id="mip-opportunity-mine-page" class="min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-4 text-ink">
  <view class="flex items-center justify-between"><view class="text-[length:36rpx] font-bold">我的机会</view><view class="rounded-[12rpx] bg-brand px-4 py-3 text-[length:22rpx] font-semibold text-on-brand" bind:tap="create">发布机会</view></view>
  <view wx:if="{{state === 'loading'}}" class="mt-5 rounded-[16rpx] bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}" class="mt-5"><app-empty-state title="暂时无法加载机会" description="{{message}}" action-text="重新加载" bind:action="load" /></view>
  <view wx:elif="{{!items.length}}" class="mt-5"><app-empty-state title="还没有发布机会" description="已保存的草稿和已发布机会会显示在这里。" action-text="发布机会" bind:action="create" /></view>
  <view wx:else class="mt-5 flex flex-col gap-3"><view wx:for="{{items}}" wx:key="id" class="rounded-[16rpx] bg-panel px-4 py-4 active:bg-panel-raised" data-id="{{item.id}}" bind:tap="open"><view class="flex items-center justify-between"><view class="rounded-full bg-brand-soft px-3 py-1 text-[length:20rpx] text-brand">{{item.status}}</view><view class="text-[length:20rpx] text-muted">{{item.city.label || item.branchName || '全国'}}</view></view><view class="mt-3 text-[length:28rpx] font-semibold">{{item.title}}</view><view class="mt-2 line-clamp-2 text-[length:22rpx] text-muted">{{item.targetSummary}}</view><view class="mt-3 text-[length:20rpx] text-muted">{{item.referralCount}} 人引荐</view></view></view>
  <view wx:if="{{loadingMore}}" class="py-5 text-center text-[length:21rpx] text-muted">正在加载</view>
  <app-page-exit label="返回机会" />
</view>
