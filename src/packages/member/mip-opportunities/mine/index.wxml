<view id="mip-opportunity-mine-page" class="mip-member-page min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-4 text-ink">
  <view class="flex items-center justify-between"><view class="text-[length:34rpx] font-bold">相关机会</view><view class="rounded-[8rpx] bg-brand px-4 py-3 text-[length:22rpx] font-semibold text-on-brand" bind:tap="create">发布机会</view></view>
  <!-- 两类列表均为游标分页；服务端未返回精确总数前不把当前已加载条数当作总数。 -->
  <view class="mt-4 flex gap-3">
    <view wx:if="{{tab === 'PUBLISHED'}}" class="flex h-[56rpx] items-center rounded-[16rpx] border border-canvas bg-brand px-3 text-[length:24rpx] font-medium text-on-brand" data-tab="PUBLISHED" aria-role="tab" aria-selected="true" bind:tap="changeTab">发布机会</view>
    <view wx:else class="flex h-[56rpx] items-center rounded-[16rpx] bg-panel px-3 text-[length:24rpx] text-muted" data-tab="PUBLISHED" aria-role="tab" aria-selected="false" bind:tap="changeTab">发布机会</view>
    <view wx:if="{{tab === 'REFERRED'}}" class="flex h-[56rpx] items-center rounded-[16rpx] border border-canvas bg-brand px-3 text-[length:24rpx] font-medium text-on-brand" data-tab="REFERRED" aria-role="tab" aria-selected="true" bind:tap="changeTab">引荐机会</view>
    <view wx:else class="flex h-[56rpx] items-center rounded-[16rpx] bg-panel px-3 text-[length:24rpx] text-muted" data-tab="REFERRED" aria-role="tab" aria-selected="false" bind:tap="changeTab">引荐机会</view>
  </view>

  <block wx:if="{{tab === 'PUBLISHED'}}">
    <view aria-label="正在加载" aria-busy="true" wx:if="{{publishedState === 'loading'}}" class="mt-5 flex flex-col gap-3"><view class="rounded-[16rpx] bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view><view class="rounded-[16rpx] bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view></view>
    <view wx:elif="{{publishedState === 'error'}}" class="mt-5"><mip-empty-state title="暂时无法加载已发布机会" description="请检查网络后重试。" action-text="重新加载" bind:action="retry" /></view>
    <!-- journey-review J2-06：我的项目空态文案 + 发布入口。 -->
    <view wx:elif="{{!publishedItems.length}}" class="mt-5"><mip-empty-state title="欢迎发布项目机会" description="有匹配的资源或人才MIP将主动联系你" action-text="发布机会" bind:action="create" /></view>
    <view wx:else class="mt-5 flex flex-col gap-3">
      <!-- journey-review J6-03：长按卡片删除（C5：原生确认弹窗 + toast）；已下架置灰；卡片保持现行样式（不带机会类型黄标）。 -->
      <view wx:for="{{publishedItems}}" wx:key="id" class="rounded-[16rpx] bg-panel px-4 py-4 active:bg-panel-raised {{item.dimmed ? 'opacity-50 grayscale' : ''}}" data-id="{{item.id}}" aria-label="{{item.title}}，长按删除" bind:tap="openPublished" bindlongpress="confirmDeletePublished">
        <view class="flex items-center justify-between"><view class="rounded-full {{item.dimmed ? 'bg-panel-raised text-muted' : 'bg-brand-soft text-brand'}} px-3 py-1 text-[length:22rpx]">{{item.statusLabel}}</view><view class="text-[length:22rpx] text-muted">{{item.regionText || item.commercialTerms.locationDisplay || item.city.label || item.branchName || '全国'}}</view></view>
        <view class="mt-3 text-[length:28rpx] font-semibold">{{item.title}}</view>
        <view wx:if="{{item.commercialTerms.amountDisplay}}" class="mt-2 text-[length:22rpx] text-muted">金额：{{item.commercialTerms.amountDisplay}}</view>
        <view class="mt-2 line-clamp-2 text-[length:22rpx] text-muted">{{item.targetSummary}}</view>
        <view class="mt-3 flex min-h-[88rpx] items-center justify-between gap-3"><view class="text-[length:22rpx] text-muted">{{item.referralCount}} 次引荐</view><view wx:if="{{item.status === 'DRAFT' || item.status === 'PUBLISHED'}}" class="flex min-h-[88rpx] items-center px-3 text-[length:24rpx] font-medium text-brand" aria-role="button" data-id="{{item.id}}" catch:tap="editPublished">编辑</view></view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view aria-label="正在加载" aria-busy="true" wx:if="{{referredState === 'loading'}}" class="mt-5 flex flex-col gap-3"><view class="rounded-[16rpx] bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view><view class="rounded-[16rpx] bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view></view>
    <view wx:elif="{{referredState === 'error'}}" class="mt-5"><mip-empty-state title="暂时无法加载被引荐机会" description="请检查网络后重试。" action-text="重新加载" bind:action="retry" /></view>
    <view wx:elif="{{!referredItems.length}}" class="mt-5"><mip-empty-state title="暂无被引荐机会" description="其他用户向你引荐机会后会显示在这里。" /></view>
    <view wx:else class="mt-5 flex flex-col gap-3">
      <view wx:for="{{referredItems}}" wx:key="viewKey" class="relative rounded-[16rpx] bg-panel px-4 py-4 active:bg-panel-raised" data-key="{{item.viewKey}}" bind:tap="openReferred">
        <view wx:if="{{item.unread}}" class="mb-2 text-[length:22rpx] text-brand" aria-label="未读引荐">未读</view>
        <view class="flex items-center gap-3 pr-5" data-profile-ref="{{item.actor.profileRef}}" catch:tap="openReferrer"><image wx:if="{{item.actor.avatarUrl}}" class="h-[64rpx] w-[64rpx] shrink-0 rounded-full bg-brand-soft" src="{{item.actor.avatarUrl}}" mode="aspectFill" /><view wx:else class="flex h-[64rpx] w-[64rpx] shrink-0 items-center justify-center rounded-full bg-brand-soft text-[length:24rpx] font-semibold text-brand">{{item.actorInitial}}</view><view class="min-w-0 flex-1"><view class="truncate text-[length:24rpx] font-semibold">{{item.actorName}}</view><view class="mt-1 text-[length:22rpx] text-muted">向你引荐了这个机会</view></view><view class="rounded-full bg-canvas px-2 py-1 text-[length:22rpx] text-muted">{{item.statusText}}</view></view>
        <view class="mt-4 text-[length:28rpx] font-semibold">{{item.opportunity.title}}</view>
        <view wx:if="{{item.note}}" class="mt-3 rounded-[8rpx] bg-panel-raised px-3 py-3 text-[length:22rpx] text-muted">备注：{{item.note}}</view>
        <view class="mt-3 flex items-center justify-between text-[length:22rpx] text-muted"><text>{{item.updatedText}}</text><mip-icon name="chevron-down-1" size="{{14}}" color="var(--color-muted)" /></view>
      </view>
      <view class="min-h-[88rpx] py-3 text-center text-[length:22rpx] text-brand" bind:tap="openAllReceived">查看全部互动</view>
    </view>
  </block>

  <view wx:if="{{loadingMore}}" class="py-5 text-center text-[length:22rpx] text-muted">正在加载</view>
  <view wx:if="{{message}}" class="mt-4 rounded-[16rpx] bg-brand-soft px-4 py-3 text-[length:22rpx] text-brand">{{message}}</view>
  <app-page-exit label="返回机会" />
</view>
