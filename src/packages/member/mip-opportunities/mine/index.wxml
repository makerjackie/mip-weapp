<view id="mip-opportunity-mine-page" class="mip-member-page min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-4 text-ink">
  <view class="flex items-center justify-between"><view class="text-[34rpx] font-bold">相关机会</view><view class="rounded-[8rpx] bg-brand px-4 py-3 text-[22rpx] font-semibold text-on-brand" bind:tap="create">发布机会</view></view>
  <!-- 两类列表均为游标分页；服务端未返回精确总数前不把当前已加载条数当作总数。 -->
  <view class="mt-4 flex gap-3">
    <view wx:if="{{tab === 'PUBLISHED'}}" class="flex h-[56rpx] items-center rounded-[16rpx] border border-canvas bg-brand px-3 text-[24rpx] font-medium text-on-brand" data-tab="PUBLISHED" aria-role="tab" aria-selected="true" bind:tap="changeTab">发布机会</view>
    <view wx:else class="flex h-[56rpx] items-center rounded-[16rpx] bg-panel px-3 text-[24rpx] text-muted" data-tab="PUBLISHED" aria-role="tab" aria-selected="false" bind:tap="changeTab">发布机会</view>
    <view wx:if="{{tab === 'COOPERATING'}}" class="flex h-[56rpx] items-center rounded-[16rpx] border border-canvas bg-brand px-3 text-[24rpx] font-medium text-on-brand" data-tab="COOPERATING" aria-role="tab" aria-selected="true" bind:tap="changeTab">我想合作</view>
    <view wx:else class="flex h-[56rpx] items-center rounded-[16rpx] bg-panel px-3 text-[24rpx] text-muted" data-tab="COOPERATING" aria-role="tab" aria-selected="false" bind:tap="changeTab">我想合作</view>
  </view>

  <block wx:if="{{tab === 'PUBLISHED'}}">
    <view aria-label="正在加载" aria-busy="true" wx:if="{{publishedState === 'loading'}}" class="mt-5 flex flex-col gap-3"><view class="rounded-[16rpx] bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view><view class="rounded-[16rpx] bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view></view>
    <view wx:elif="{{publishedState === 'error'}}" class="mt-5"><mip-empty-state title="暂时无法加载已发布机会" description="请检查网络后重试。" action-text="重新加载" bind:action="retry" /></view>
    <!-- journey-review J2-06：我的项目空态文案 + 发布入口。 -->
    <view wx:elif="{{!publishedItems.length}}" class="mt-5"><mip-empty-state title="欢迎发布项目机会" description="有匹配的资源或人才MIP将主动联系你" action-text="发布机会" bind:action="create" /></view>
    <view wx:else class="mt-5 flex flex-col gap-3">
      <!-- journey-review J6-03：长按卡片删除（C5：原生确认弹窗 + toast）；已下架置灰；卡片保持现行样式（不带机会类型黄标）。 -->
      <view wx:for="{{publishedItems}}" wx:key="id" class="rounded-[16rpx] bg-panel px-4 py-4 active:bg-panel-raised {{item.dimmed ? 'opacity-50 grayscale' : ''}}" data-id="{{item.id}}" aria-label="{{item.title}}，长按删除" bind:tap="openPublished" bindlongpress="confirmDeletePublished">
        <view class="flex items-center justify-between"><view class="rounded-full {{item.dimmed ? 'bg-panel-raised text-muted' : 'bg-brand-soft text-brand'}} px-3 py-1 text-[22rpx]">{{item.statusLabel}}</view><view class="text-[22rpx] text-muted">{{item.regionText || item.commercialTerms.locationDisplay || item.city.label || item.branchName || '全国'}}</view></view>
        <view class="mt-3 text-[28rpx] font-semibold">{{item.title}}</view>
        <view wx:if="{{item.commercialTerms.amountDisplay}}" class="mt-2 text-[22rpx] text-muted">金额：{{item.commercialTerms.amountDisplay}}</view>
        <view class="mt-2 line-clamp-2 text-[22rpx] text-muted">{{item.targetSummary}}</view>
        <view class="mt-3 flex min-h-[88rpx] items-center justify-between gap-3"><view class="text-[22rpx] text-muted">{{item.cooperationCount || 0}} 人想合作</view><view wx:if="{{item.status === 'DRAFT' || item.status === 'PUBLISHED'}}" class="flex min-h-[88rpx] items-center px-3 text-[24rpx] font-medium text-brand" aria-role="button" data-id="{{item.id}}" catch:tap="editPublished">编辑</view></view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view aria-label="正在加载" aria-busy="true" wx:if="{{cooperatingState === 'loading'}}" class="mt-5 flex flex-col gap-3"><view class="rounded-[16rpx] bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view><view class="rounded-[16rpx] bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view></view>
    <view wx:elif="{{cooperatingState === 'error'}}" class="mt-5"><mip-empty-state title="暂时无法加载合作意向" description="请检查网络后重试。" action-text="重新加载" bind:action="retry" /></view>
    <view wx:elif="{{!cooperatingItems.length}}" class="mt-5"><mip-empty-state title="暂无合作意向" description="在机会详情点击“我想合作”后，会显示在这里。" /></view>
    <view wx:else class="mt-5 flex flex-col gap-3">
      <view wx:for="{{cooperatingItems}}" wx:key="id" class="rounded-[16rpx] bg-panel px-4 py-4 active:bg-panel-raised" data-id="{{item.id}}" bind:tap="openPublished">
        <view class="text-[28rpx] font-semibold">{{item.title}}</view>
        <view class="mt-2 line-clamp-2 text-[22rpx] text-muted">{{item.targetSummary}}</view>
        <view class="mt-3 text-[22rpx] text-muted">{{item.statusLabel}} · {{item.cooperationCount || 0}} 人想合作</view>
      </view>
      <view class="min-h-[88rpx] py-3 text-center text-[22rpx] text-brand" bind:tap="openAllReceived">查看全部互动</view>
    </view>
  </block>

  <view wx:if="{{loadingMore}}" class="py-5 text-center text-[22rpx] text-muted">正在加载</view>
  <view wx:if="{{message}}" class="mt-4 rounded-[16rpx] bg-brand-soft px-4 py-3 text-[22rpx] text-brand">{{message}}</view>
  <app-page-exit label="返回机会" />
</view>
