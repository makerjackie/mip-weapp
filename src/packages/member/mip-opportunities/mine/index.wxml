<view id="mip-opportunity-mine-page" class="min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-4 text-ink">
  <view class="flex items-center justify-between"><view class="text-[length:36rpx] font-bold">相关机会</view><view class="rounded-[12rpx] bg-brand px-4 py-3 text-[length:22rpx] font-semibold text-on-brand" bind:tap="create">发布机会</view></view>
  <view class="mt-4 grid grid-cols-2 border-b border-line text-center text-[length:24rpx]">
    <view wx:if="{{tab === 'PUBLISHED'}}" class="min-h-[84rpx] border-b-[4rpx] border-brand py-4 text-brand" data-tab="PUBLISHED" bind:tap="changeTab">我发布的</view><view wx:else class="min-h-[84rpx] border-b-[4rpx] border-transparent py-4 text-muted" data-tab="PUBLISHED" bind:tap="changeTab">我发布的</view>
    <view wx:if="{{tab === 'REFERRED'}}" class="min-h-[84rpx] border-b-[4rpx] border-brand py-4 text-brand" data-tab="REFERRED" bind:tap="changeTab">引荐给我的<text wx:if="{{referredUnreadCount}}" class="ml-2 rounded-full bg-brand px-2 py-1 text-[length:18rpx] text-on-brand">{{referredUnreadCount > 99 ? '99+' : referredUnreadCount}}</text></view><view wx:else class="min-h-[84rpx] border-b-[4rpx] border-transparent py-4 text-muted" data-tab="REFERRED" bind:tap="changeTab">引荐给我的<text wx:if="{{referredUnreadCount}}" class="ml-2 rounded-full bg-brand-soft px-2 py-1 text-[length:18rpx] text-brand">{{referredUnreadCount > 99 ? '99+' : referredUnreadCount}}</text></view>
  </view>

  <block wx:if="{{tab === 'PUBLISHED'}}">
    <view wx:if="{{publishedState === 'loading'}}" class="mt-5 flex flex-col gap-3"><view class="rounded-[16rpx] bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view><view class="rounded-[16rpx] bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view></view>
    <view wx:elif="{{publishedState === 'error'}}" class="mt-5"><app-empty-state title="暂时无法加载已发布机会" description="请检查网络后重试。" action-text="重新加载" bind:action="retry" /></view>
    <view wx:elif="{{!publishedItems.length}}" class="mt-5"><app-empty-state title="还没有发布机会" description="草稿和已发布机会会显示在这里。" action-text="发布机会" bind:action="create" /></view>
    <view wx:else class="mt-5 flex flex-col gap-3"><view wx:for="{{publishedItems}}" wx:key="id" class="rounded-[16rpx] bg-panel px-4 py-4 active:bg-panel-raised" data-id="{{item.id}}" bind:tap="openPublished"><view class="flex items-center justify-between"><view class="rounded-full bg-brand-soft px-3 py-1 text-[length:20rpx] text-brand">{{item.status === 'PUBLISHED' ? '招募中' : item.status === 'ENDED' ? '已完成' : '草稿'}}</view><view class="text-[length:20rpx] text-muted">{{item.city.label || item.branchName || '全国'}}</view></view><view class="mt-3 text-[length:28rpx] font-semibold">{{item.title}}</view><view class="mt-2 line-clamp-2 text-[length:22rpx] text-muted">{{item.targetSummary}}</view><view class="mt-3 text-[length:20rpx] text-muted">{{item.referralCount}} 次引荐</view></view></view>
  </block>

  <block wx:else>
    <view wx:if="{{referredState === 'loading'}}" class="mt-5 flex flex-col gap-3"><view class="rounded-[16rpx] bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view><view class="rounded-[16rpx] bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view></view>
    <view wx:elif="{{referredState === 'error'}}" class="mt-5"><app-empty-state title="暂时无法加载被引荐机会" description="请检查网络后重试。" action-text="重新加载" bind:action="retry" /></view>
    <view wx:elif="{{!referredItems.length}}" class="mt-5"><app-empty-state title="暂无被引荐机会" description="其他用户向你引荐机会后会显示在这里。" /></view>
    <view wx:else class="mt-5 flex flex-col gap-3">
      <view wx:for="{{referredItems}}" wx:key="viewKey" class="relative rounded-[16rpx] bg-panel px-4 py-4 active:bg-panel-raised" data-key="{{item.viewKey}}" bind:tap="openReferred">
        <view wx:if="{{item.unread}}" class="absolute right-4 top-4 h-[14rpx] w-[14rpx] rounded-full bg-brand"></view>
        <view class="flex items-center gap-3 pr-5" data-profile-ref="{{item.actor.profileRef}}" catch:tap="openReferrer"><image wx:if="{{item.actor.avatarUrl}}" class="h-[64rpx] w-[64rpx] shrink-0 rounded-full bg-brand-soft" src="{{item.actor.avatarUrl}}" mode="aspectFill" /><view wx:else class="flex h-[64rpx] w-[64rpx] shrink-0 items-center justify-center rounded-full bg-brand-soft text-[length:24rpx] font-semibold text-brand">{{item.actorInitial}}</view><view class="min-w-0 flex-1"><view class="truncate text-[length:24rpx] font-semibold">{{item.actorName}}</view><view class="mt-1 text-[length:20rpx] text-muted">向你引荐了这个机会</view></view><view class="rounded-full bg-canvas px-2 py-1 text-[length:18rpx] text-muted">{{item.statusText}}</view></view>
        <view class="mt-4 text-[length:28rpx] font-semibold">{{item.opportunity.title}}</view>
        <view wx:if="{{item.note}}" class="mt-3 rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:22rpx] text-muted">备注：{{item.note}}</view>
        <view class="mt-3 flex items-center justify-between text-[length:20rpx] text-muted"><text>{{item.updatedText}}</text><t-icon name="chevron-right" size="28rpx" color="var(--color-muted)" /></view>
      </view>
      <view class="min-h-[72rpx] py-3 text-center text-[length:22rpx] text-brand" bind:tap="openAllReceived">查看全部互动</view>
    </view>
  </block>

  <view wx:if="{{loadingMore}}" class="py-5 text-center text-[length:21rpx] text-muted">正在加载</view>
  <view wx:if="{{message}}" class="mt-4 rounded-[16rpx] bg-brand-soft px-4 py-3 text-[length:22rpx] text-brand">{{message}}</view>
  <app-page-exit label="返回机会" />
</view>
