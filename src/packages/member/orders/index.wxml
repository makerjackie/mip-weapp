<view id="member-orders-page" class="min-h-screen bg-canvas px-3 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-4 text-ink">
  <view class="text-[length:38rpx] font-bold">我的订单</view>
  <view id="order-filter-tabs" class="mt-4 grid grid-cols-4 border-b border-line text-center text-[length:22rpx]">
    <view wx:if="{{filter === 'all'}}" class="min-h-[76rpx] border-b-[4rpx] border-brand py-3 text-brand" data-filter="all" bind:tap="changeFilter">全部</view><view wx:else class="min-h-[76rpx] border-b-[4rpx] border-transparent py-3 text-muted" data-filter="all" bind:tap="changeFilter">全部</view>
    <view wx:if="{{filter === 'pending'}}" class="min-h-[76rpx] border-b-[4rpx] border-brand py-3 text-brand" data-filter="pending" bind:tap="changeFilter">待确认</view><view wx:else class="min-h-[76rpx] border-b-[4rpx] border-transparent py-3 text-muted" data-filter="pending" bind:tap="changeFilter">待确认</view>
    <view wx:if="{{filter === 'paid'}}" class="min-h-[76rpx] border-b-[4rpx] border-brand py-3 text-brand" data-filter="paid" bind:tap="changeFilter">已支付</view><view wx:else class="min-h-[76rpx] border-b-[4rpx] border-transparent py-3 text-muted" data-filter="paid" bind:tap="changeFilter">已支付</view>
    <view wx:if="{{filter === 'refund'}}" class="min-h-[76rpx] border-b-[4rpx] border-brand py-3 text-brand" data-filter="refund" bind:tap="changeFilter">退款</view><view wx:else class="min-h-[76rpx] border-b-[4rpx] border-transparent py-3 text-muted" data-filter="refund" bind:tap="changeFilter">退款</view>
  </view>

  <view wx:if="{{state === 'loading'}}" class="mt-4 flex flex-col gap-3"><view class="rounded-[16rpx] bg-panel px-4 py-6"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view><view class="rounded-[16rpx] bg-panel px-4 py-6"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view></view>
  <view wx:elif="{{state === 'error'}}" class="mt-5"><app-empty-state title="订单暂时无法加载" description="请稍后重试。" action-text="重新加载" bind:action="loadOrders" /></view>
  <view wx:elif="{{orders.length === 0}}" class="mt-5"><app-empty-state title="{{allOrders.length ? '当前分类暂无订单' : '还没有订单'}}" description="{{allOrders.length ? '可切换其他分类查看。' : '购买会员或付费活动后，订单会显示在这里。'}}" /></view>
  <view wx:else class="mt-4 flex flex-col gap-3">
    <view wx:for="{{orders}}" wx:key="id" data-order-id="{{item.id}}" class="rounded-[16rpx] bg-panel px-4 py-4 active:bg-panel-raised" bind:tap="openOrder">
      <view class="flex items-start justify-between gap-3">
        <view class="min-w-0 flex-1"><view class="truncate text-[length:28rpx] font-semibold">{{item.title}}</view><view wx:if="{{item.createdText}}" class="mt-2 text-[length:21rpx] text-muted">{{item.createdText}}</view></view>
        <text wx:if="{{item.statusSuccess}}" class="shrink-0 rounded-full bg-panel-raised px-3 py-1 text-[length:20rpx] text-success">{{item.statusText}}</text>
        <text wx:elif="{{item.statusDanger}}" class="shrink-0 rounded-full bg-panel-raised px-3 py-1 text-[length:20rpx] text-danger">{{item.statusText}}</text>
        <text wx:elif="{{item.statusBrand}}" class="shrink-0 rounded-full bg-brand-soft px-3 py-1 text-[length:20rpx] text-brand">{{item.statusText}}</text>
        <text wx:else class="shrink-0 rounded-full bg-panel-raised px-3 py-1 text-[length:20rpx] text-muted">{{item.statusText}}</text>
      </view>
      <view class="mt-4 flex items-end justify-between border-t border-line pt-3"><text class="text-[length:21rpx] text-muted">{{item.orderType === 'EVENT' ? '活动订单' : '会员订单'}}</text><text class="text-[length:31rpx] font-bold">{{item.amountText}}</text></view>
    </view>
  </view>
  <view wx:if="{{message && state !== 'error'}}" class="mt-4 rounded-[16rpx] border border-line bg-panel-raised px-4 py-3 text-[length:22rpx]">{{message}}</view>
  <app-page-exit label="返回" />
</view>
