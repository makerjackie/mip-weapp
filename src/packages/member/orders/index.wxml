<view id="member-orders-page" class="mip-member-page min-h-screen bg-canvas px-3 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-0 text-ink">
  <view id="order-filter-tabs" class="grid grid-cols-4 border-b border-line text-center text-[length:24rpx]">
    <view wx:if="{{filter === 'all'}}" class="min-h-[88rpx] border-b-[4rpx] border-brand py-3 text-brand" data-filter="all" bind:tap="changeFilter">全部</view><view wx:else class="min-h-[88rpx] border-b-[4rpx] border-transparent py-3 text-muted" data-filter="all" bind:tap="changeFilter">全部</view>
    <view wx:if="{{filter === 'PENDING_USE'}}" class="min-h-[88rpx] border-b-[4rpx] border-brand py-3 text-brand" data-filter="PENDING_USE" bind:tap="changeFilter">待使用</view><view wx:else class="min-h-[88rpx] border-b-[4rpx] border-transparent py-3 text-muted" data-filter="PENDING_USE" bind:tap="changeFilter">待使用</view>
    <view wx:if="{{filter === 'COMPLETED'}}" class="min-h-[88rpx] border-b-[4rpx] border-brand py-3 text-brand" data-filter="COMPLETED" bind:tap="changeFilter">已完成</view><view wx:else class="min-h-[88rpx] border-b-[4rpx] border-transparent py-3 text-muted" data-filter="COMPLETED" bind:tap="changeFilter">已完成</view>
    <view wx:if="{{filter === 'REFUNDED'}}" class="min-h-[88rpx] border-b-[4rpx] border-brand py-3 text-brand" data-filter="REFUNDED" bind:tap="changeFilter">已退款</view><view wx:else class="min-h-[88rpx] border-b-[4rpx] border-transparent py-3 text-muted" data-filter="REFUNDED" bind:tap="changeFilter">已退款</view>
  </view>

  <view aria-label="正在加载" aria-busy="true" wx:if="{{state === 'loading'}}" class="mt-4 flex flex-col gap-3"><view class="rounded-[16rpx] bg-panel px-4 py-6"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view><view class="rounded-[16rpx] bg-panel px-4 py-6"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view></view>
  <view wx:elif="{{state === 'error'}}" class="mt-5"><app-empty-state title="订单暂时无法加载" description="请稍后重试。" action-text="重新加载" bind:action="loadOrders" /></view>
  <view wx:elif="{{orders.length === 0}}" class="mt-5"><app-empty-state title="{{allOrders.length ? '当前分类暂无订单' : '还没有订单'}}" description="{{allOrders.length ? '可切换其他分类查看。' : '购买会员、活动或单内容后，订单会显示在这里。'}}" /></view>
  <view wx:else class="mt-4 flex flex-col gap-3">
    <view wx:for="{{orders}}" wx:key="id" data-order-id="{{item.id}}" class="order-card overflow-hidden rounded-[16rpx] bg-panel active:bg-panel-raised {{item.orderType === 'EVENT' ? 'order-card--event' : ''}}" bind:tap="openOrder">
      <image wx:if="{{item.orderType === 'EVENT' && item.event.coverUrl}}" class="order-card__cover h-[298rpx] w-full bg-panel-raised" src="{{item.event.coverUrl}}" mode="aspectFill" />
      <view class="order-card__body px-4 py-4">
      <view class="flex items-start justify-between gap-3">
        <view class="min-w-0 flex-1"><view wx:if="{{item.orderType === 'EVENT'}}" class="truncate text-[length:32rpx] font-semibold">{{item.title}}</view><view wx:else class="truncate text-[length:28rpx] font-semibold">{{item.title}}</view><view wx:if="{{item.orderType !== 'EVENT' && item.createdText}}" class="mt-2 text-[length:22rpx] text-muted">{{item.createdText}}</view></view>
        <text wx:if="{{item.orderType !== 'EVENT' && item.statusSuccess}}" class="shrink-0 rounded-full bg-panel-raised px-3 py-1 text-[length:22rpx] text-success">{{item.statusText}}</text>
        <text wx:elif="{{item.orderType !== 'EVENT' && item.statusDanger}}" class="shrink-0 rounded-full bg-panel-raised px-3 py-1 text-[length:22rpx] text-danger">{{item.statusText}}</text>
        <text wx:elif="{{item.orderType !== 'EVENT' && item.statusBrand}}" class="shrink-0 rounded-full bg-panel-raised px-3 py-1 text-[length:22rpx] text-brand">{{item.statusText}}</text>
        <text wx:elif="{{item.orderType !== 'EVENT'}}" class="shrink-0 rounded-full bg-panel-raised px-3 py-1 text-[length:22rpx] text-muted">{{item.statusText}}</text>
      </view>
      <view wx:if="{{item.orderType === 'EVENT' && item.eventStartsText}}" class="mt-3 flex items-center text-[length:22rpx] text-muted"><t-icon class="mr-2" name="calendar" size="26rpx" color="var(--color-brand)" />{{item.eventStartsText}}</view>
      <view wx:if="{{item.orderType === 'EVENT' && item.eventLocationText}}" class="mt-2 flex items-start text-[length:22rpx] leading-5 text-muted"><t-icon class="mr-2 shrink-0" name="location" size="26rpx" color="var(--color-brand)" /><text>{{item.eventLocationText}}</text></view>
      <view class="mt-4 flex items-center justify-between border-t border-line pt-3">
        <text wx:if="{{item.orderType === 'EVENT'}}" class="rounded-[8rpx] bg-panel-raised px-3 py-1 text-[length:22rpx] text-muted">{{item.statusText}}</text>
        <text wx:else class="text-[length:22rpx] text-muted">{{item.orderType === 'CONTENT' ? '内容订单' : '会员订单'}}</text>
        <text class="text-[length:31rpx] font-bold {{item.amountHighlight ? 'text-brand' : ''}}">{{item.amountLabel}}：{{item.amountText}}</text>
      </view>
      </view>
    </view>
  </view>
  <view wx:if="{{message && state !== 'error'}}" class="mt-4 rounded-[16rpx] border border-line bg-panel-raised px-4 py-3 text-[length:22rpx]">{{message}}</view>
  <app-page-exit label="返回" />
</view>
