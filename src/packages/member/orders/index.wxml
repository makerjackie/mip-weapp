<view id="member-orders-page" class="min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-4 text-ink">
  <view class="px-1"><view class="text-[length:22rpx] font-semibold text-accent">支付与售后</view><view class="mt-1 text-[length:38rpx] font-bold">我的订单</view></view>
  <view id="order-filter-tabs" class="mt-4 border-b border-line">
    <t-tabs value="{{filter}}" theme="line" space-evenly bind:change="changeFilter">
      <t-tab-panel value="all" label="全部" />
      <t-tab-panel value="pending" label="待确认" />
      <t-tab-panel value="paid" label="已支付" />
      <t-tab-panel value="refunded" label="退款" />
    </t-tabs>
  </view>
  <view wx:if="{{state === 'loading'}}" class="mt-5 rounded-[28rpx] bg-panel px-5 py-8"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}" class="mt-5"><app-empty-state title="暂时无法加载订单" description="服务暂时没有响应，请稍后重试。" action-text="重新加载" bind:action="loadOrders" /></view>
  <view wx:elif="{{orders.length === 0}}" class="mt-5"><app-empty-state title="{{allOrders.length ? '这个分类还没有订单' : '还没有订单'}}" description="{{allOrders.length ? '切换其他分类查看订单状态。' : '购买会员后，支付与退款状态会出现在这里。'}}" /></view>
  <view wx:else class="mt-5 flex flex-col gap-3">
    <view wx:for="{{orders}}" wx:key="id" data-order-id="{{item.id}}" class="rounded-[26rpx] bg-panel px-5 py-5 active:opacity-70" bind:tap="openOrder">
      <view class="flex items-start justify-between gap-4"><view class="min-w-0 flex-1"><view class="truncate text-[length:28rpx] font-bold">{{item.planName}}</view><view class="mt-2 text-[length:21rpx] text-muted">{{item.createdText}}</view></view><view class="rounded-full bg-brand-soft px-3 py-1 text-[length:20rpx] font-semibold text-brand">{{item.statusText}}</view></view>
      <view class="mt-4 flex items-end justify-between border-t border-line pt-4"><view class="text-[length:21rpx] text-muted">点击查看权益与售后状态</view><view class="text-[length:32rpx] font-bold text-accent">{{item.amountText}}</view></view>
    </view>
  </view>
  <view wx:if="{{message && state !== 'error'}}" class="mt-4 rounded-[18rpx] bg-[#FFF0E8] px-4 py-3 text-[length:23rpx] text-[#9F4727]">{{message}}</view>
</view>
