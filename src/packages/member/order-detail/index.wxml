<view id="order-detail-page" class="mip-member-page min-h-screen bg-canvas px-3 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-4 text-ink">
  <view aria-label="正在加载" aria-busy="true" wx:if="{{state === 'loading'}}" class="flex flex-col gap-3"><view class="rounded-[16rpx] bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view><view class="rounded-[16rpx] bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view></view>
  <view wx:elif="{{state === 'error'}}"><app-empty-state title="订单暂时无法加载" description="{{message}}" action-text="重新加载" bind:action="load" /></view>
  <block wx:elif="{{figmaLayout}}">
    <!-- figma 1723_16459/1724_17741 订单详情（含退款提示稿）：
         封面卡 + 活动信息卡 + 订单ID 条 + 费用明细 + 购买须知 + 退款按钮；
         退款提示稿在整页 0.33 透明度上叠微信原生样式确认弹窗（#333 盒、
         #999 正文、取消 #eaeaea / 确定 #7d90a9）。生产保持原布局
         （被 order-detail 测试 pin）。fixture figmaLayout 打开时按稿渲染。 -->
    <view class="relative -mt-4 min-h-[1640rpx]">
      <view class="{{figma.dialog ? 'opacity-[0.33]' : ''}}">
      <view class="absolute left-[24rpx] top-[24rpx] h-[298rpx] w-[702rpx] overflow-hidden rounded-[16rpx]">
        <image class="h-[298rpx] w-full" src="/assets/figma/orders/cover-detail.png" />
      </view>
      <view class="absolute left-[24rpx] top-[346rpx] h-[232rpx] w-[702rpx] rounded-[16rpx] bg-panel">
        <view class="absolute left-[24rpx] top-[26rpx] flex h-[32rpx] items-center justify-center rounded-full bg-[#80ccff] w-[62rpx] text-[length:20rpx] font-medium leading-[32rpx] text-canvas">沙龙</view>
        <view class="absolute left-[98rpx] top-[26rpx] flex h-[32rpx] items-center justify-center rounded-full bg-brand w-[80rpx] text-[length:20rpx] font-medium leading-[32rpx] text-canvas">仅玩家</view>
        <view class="absolute left-[24rpx] top-[72rpx] text-[length:32rpx] font-medium leading-[44.8rpx] text-ink">MIP反人性早会第328场</view>
        <image class="absolute left-[24rpx] top-[136rpx] h-[32rpx] w-[32rpx]" src="/assets/figma/events/icon-calendar.png" />
        <view class="absolute left-[62rpx] top-[133rpx] text-[length:24rpx] leading-[33.6rpx] text-ink">12月12日 10:00-12:00</view>
        <image class="absolute left-[24rpx] top-[180rpx] h-[32rpx] w-[32rpx]" src="/assets/figma/events/icon-pin.png" />
        <view class="absolute left-[62rpx] top-[176rpx] text-[length:24rpx] leading-[33.6rpx] text-ink">深圳 新洲二街海松大厦A座1706室</view>
      </view>
      <view class="absolute left-[24rpx] top-[602rpx] h-[80rpx] w-[702rpx] rounded-[16rpx] bg-panel">
        <image class="absolute left-[24rpx] top-[24rpx] h-[32rpx] w-[32rpx]" src="/assets/figma/orders/icon-order.png" />
        <view class="absolute left-[62rpx] top-[26rpx] text-[length:24rpx] leading-[33.6rpx] text-ink">订单ID</view>
        <view class="absolute right-[64rpx] top-[26rpx] text-[length:24rpx] font-medium leading-[33.6rpx] text-ink">2020020013201031031</view>
        <image class="absolute right-[18rpx] top-[24rpx] h-[32rpx] w-[32rpx]" src="/assets/figma/orders/icon-copy.png" />
      </view>
      <view class="absolute left-[24rpx] top-[706rpx] h-[320rpx] w-[702rpx] rounded-[16rpx] bg-panel">
        <image class="absolute left-[24rpx] top-[24rpx] h-[32rpx] w-[32rpx]" src="/assets/figma/orders/icon-price.png" />
        <view class="absolute left-[62rpx] top-[26rpx] text-[length:24rpx] leading-[33.6rpx] text-ink">价格明细</view>
        <view class="absolute left-[24rpx] top-[106rpx] text-[length:24rpx] leading-[33.6rpx] text-ink">活动门票</view>
        <view class="absolute right-[26rpx] top-[106rpx] text-[length:24rpx] font-medium leading-[33.6rpx] text-ink">¥598</view>
        <view class="absolute left-[24rpx] top-[186rpx] text-[length:24rpx] leading-[33.6rpx] text-ink">活动周边</view>
        <view class="absolute right-[26rpx] top-[186rpx] text-[length:24rpx] font-medium leading-[33.6rpx] text-ink">¥98</view>
        <view class="absolute left-[24rpx] top-[265rpx] text-[length:24rpx] leading-[33.6rpx] text-ink">总计</view>
        <view class="absolute right-[26rpx] top-[256rpx] text-[length:40rpx] font-bold leading-[56rpx] text-brand">¥589</view>
      </view>
      <view class="absolute left-[24rpx] top-[1050rpx] h-[490rpx] w-[702rpx] rounded-[16rpx] bg-panel">
        <image class="absolute left-[24rpx] top-[28rpx] h-[32rpx] w-[32rpx]" src="/assets/figma/orders/icon-notice.png" />
        <view class="absolute left-[62rpx] top-[25rpx] text-[length:24rpx] leading-[33.6rpx] text-ink">购买须知</view>
        <view class="absolute left-[24rpx] top-[101rpx] text-[length:24rpx] font-medium leading-[34rpx] tracking-[-1rpx] text-ink">一、订单确认与支付</view>
        <view class="absolute left-[32rpx] top-[168rpx] text-[length:24rpx] leading-[34rpx] tracking-[-1rpx] text-muted">1. 订单生效：提交订单并成功支付后，即视为交易合同成</view>
        <view class="absolute left-[62rpx] top-[202rpx] text-[length:24rpx] leading-[34rpx] tracking-[-1rpx] text-muted">立。</view>
        <view class="absolute left-[32rpx] top-[243rpx] text-[length:24rpx] leading-[34rpx] tracking-[-1rpx] text-muted">2. 支付方式：我们支持微信支付、支付宝、银行卡转账等线</view>
        <view class="absolute left-[62rpx] top-[277rpx] text-[length:24rpx] leading-[34rpx] tracking-[-1rpx] text-muted">上支付方式（请根据实际情况填写）。</view>
        <view class="absolute left-[32rpx] top-[318rpx] text-[length:24rpx] leading-[34rpx] tracking-[-1rpx] text-muted">3. 订单修改：支付前可修改或取消订单；支付后如需修改，</view>
        <view class="absolute left-[62rpx] top-[352rpx] text-[length:24rpx] leading-[34rpx] tracking-[-1rpx] text-muted">请及时联系客服处理。</view>
      </view>
      <view class="absolute left-[24rpx] top-[1558rpx] h-[76rpx] w-[702rpx] items-center rounded-[16rpx] bg-panel-raised text-center text-[length:32rpx] leading-[76rpx] text-muted">退款</view>
      </view>
      <view wx:if="{{figma.dialog}}" class="absolute left-[54rpx] top-[404rpx] h-[464rpx] w-[640rpx] rounded-[16rpx] bg-[#333333]">
        <view class="absolute left-0 top-[64rpx] w-full text-center text-[length:32rpx] font-semibold leading-[44.8rpx] text-[#eaeaea]">{{figma.dialog.title}}</view>
        <view class="absolute left-0 top-[142rpx] w-full text-center text-[length:32rpx] leading-[48rpx] text-[#999999]">
          <view>{{figma.dialog.line1}}</view>
          <view>{{figma.dialog.line2}}</view>
          <view>{{figma.dialog.line3}}</view>
        </view>
        <view class="absolute left-0 top-[352rpx] h-[2rpx] w-full bg-[#484848]"></view>
        <view class="absolute left-0 top-[386rpx] w-[320rpx] text-center text-[length:32rpx] leading-[44.8rpx] text-[#eaeaea]">取消</view>
        <view class="absolute left-[320rpx] top-[386rpx] w-[320rpx] text-center text-[length:32rpx] leading-[44.8rpx] text-[#7d90a9]">确定</view>
      </view>
    </view>
  </block>
  <block wx:else>
    <view wx:if="{{!isEventOrder}}" class="rounded-[16rpx] bg-panel px-5 py-5">
      <view class="flex items-start justify-between gap-3"><view class="min-w-0 flex-1"><view class="text-[length:22rpx] text-muted">订单状态</view><view class="mt-2 text-[length:40rpx] font-bold">{{statusText}}</view></view><text wx:if="{{statusSuccess}}" class="rounded-full bg-panel-raised px-3 py-1 text-[length:22rpx] text-success">已确认</text><text wx:elif="{{statusDanger}}" class="rounded-full bg-panel-raised px-3 py-1 text-[length:22rpx] text-danger">未完成</text><text wx:elif="{{statusBrand}}" class="rounded-full bg-brand-soft px-3 py-1 text-[length:22rpx] text-brand">处理中</text></view>
      <view class="mt-3 text-[length:22rpx] leading-5 text-muted">{{statusDescription}}</view>
      <view class="mt-5 text-[length:22rpx] text-muted">{{title}}</view><view class="mt-1 text-[length:40rpx] font-bold text-brand">{{amountText}}</view>
    </view>

    <block wx:if="{{isEventOrder}}">
    <view class="overflow-hidden rounded-[16rpx] bg-panel">
      <image wx:if="{{order.event && eventCoverUrl}}" class="h-[298rpx] w-full bg-panel-raised" src="{{eventCoverUrl}}" mode="aspectFill" />
      <view class="px-4 py-4">
        <view class="mb-3 flex gap-2"><text class="rounded-[8rpx] bg-brand px-2 py-1 text-[length:22rpx] text-on-brand">活动</text><text wx:if="{{serviceStatusText}}" class="rounded-[8rpx] bg-brand-soft px-2 py-1 text-[length:22rpx] text-brand">{{serviceStatusText}}</text></view>
        <view class="text-[length:28rpx] font-semibold">{{order.event ? order.event.title : title}}</view>
        <view wx:if="{{eventStartsText}}" class="mt-3 flex items-start text-[length:22rpx] text-muted"><mip-icon class="mr-2 shrink-0" name="calendar-schedule" size="{{14}}" color="var(--color-brand)" /><text>{{eventStartsText}}<text wx:if="{{eventEndsText}}"> 至 {{eventEndsText}}</text></text></view>
        <view wx:if="{{eventLocationText}}" class="mt-2 flex items-start text-[length:22rpx] leading-5 text-muted"><mip-icon class="mr-2 shrink-0" name="icon-map-pin-line" size="{{14}}" color="var(--color-brand)" /><text>{{eventLocationText}}</text></view>
        <view wx:if="{{!order.event}}" class="mt-3 text-[length:22rpx] leading-5 text-muted">活动信息暂时不可用，订单金额和状态仍以服务端记录为准。</view>
      </view>
    </view>
    <view class="mt-4 flex min-h-[88rpx] items-center justify-between rounded-[16rpx] bg-panel px-4 active:bg-panel-raised" aria-role="button" bind:tap="copyOrderId"><view class="flex items-center gap-2"><t-icon name="order" size="28rpx" color="var(--color-brand)" /><text>订单ID</text></view><view class="flex min-w-0 max-w-[68%] items-center gap-2"><text class="min-w-0 flex-1 truncate text-right text-[length:22rpx] text-muted">{{order.id}}</text><text class="shrink-0 text-[length:22rpx] font-semibold text-brand">复制</text></view></view>

    <view class="mt-4 overflow-hidden rounded-[16rpx] bg-panel">
      <view class="border-b border-line px-4 py-3 text-[length:24rpx] font-semibold">费用明细</view>
      <view wx:for="{{priceItems}}" wx:key="label" class="flex min-h-[84rpx] items-center justify-between gap-4 border-b border-line px-4 last:border-b-0"><text class="text-muted">{{item.label}}</text><text>{{item.amountText}}</text></view>
      <view wx:if="{{!priceItems.length}}" class="border-b border-line px-4 py-4 text-[length:22rpx] text-muted">该订单未保存拆分费用，以下展示订单总额。</view>
      <view class="flex min-h-[84rpx] items-center justify-between px-4"><text>总计</text><text class="text-[length:40rpx] font-bold text-brand">{{amountText}}</text></view>
    </view>
    <view class="mt-4 bg-panel px-4 py-4 text-[length:22rpx] leading-6 text-muted"><view class="mb-4 flex items-center gap-2 text-ink"><t-icon name="info-circle" size="28rpx" color="var(--color-brand)" /><text>购买须知</text></view><view>一、订单确认与支付</view><view class="mt-2">1. 订单提交并成功支付后，订单视为交易合同成立。</view><view class="mt-1">2. 支付方式以当前页面展示为准。</view><view class="mt-1">3. 订单修改和取消请联系运营管理。</view></view>
    <view class="mt-4 rounded-[16rpx] border border-line bg-panel px-4 py-4 text-[length:22rpx] leading-6 text-muted">取消报名及关联退款请前往“我的活动”处理，最终结果以服务端状态为准。</view>
    </block>

    <view wx:if="{{!isEventOrder}}" class="mt-4 overflow-hidden rounded-[16rpx] bg-panel">
      <view class="flex min-h-[92rpx] items-center justify-between gap-4 border-b border-line px-4"><text class="text-muted">订单类型</text><text class="text-right">{{order.orderType === 'EVENT' ? '活动订单' : order.orderType === 'CONTENT' ? '内容订单' : '会员订单'}}</text></view>
      <view wx:if="{{productDescription}}" class="flex min-h-[92rpx] items-center justify-between gap-4 border-b border-line px-4"><text class="shrink-0 text-muted">方案说明</text><text class="text-right">{{productDescription}}</text></view>
      <view wx:if="{{serviceStatusText}}" class="flex min-h-[92rpx] items-center justify-between gap-4 border-b border-line px-4"><text class="text-muted">使用状态</text><text class="text-right">{{serviceStatusText}}</text></view>
      <view wx:if="{{createdText}}" class="flex min-h-[92rpx] items-center justify-between gap-4 border-b border-line px-4"><text class="text-muted">下单时间</text><text class="text-right">{{createdText}}</text></view>
      <view wx:if="{{paidText}}" class="flex min-h-[92rpx] items-center justify-between gap-4 border-b border-line px-4"><text class="text-muted">支付时间</text><text class="text-right">{{paidText}}</text></view>
      <view wx:if="{{refundedAmountText}}" class="flex min-h-[92rpx] items-center justify-between gap-4 px-4"><text class="text-muted">退款金额</text><text class="text-right">{{refundedAmountText}}</text></view>
    </view>

    <view wx:if="{{!isEventOrder}}" class="mt-4 rounded-[16rpx] border border-line bg-panel px-4 py-4 text-[length:22rpx] leading-5 text-muted">退款金额、可退资格和订单关联状态均由服务端核对。提交成功只表示已受理，完成状态以本页更新结果为准。</view>
    <view wx:if="{{checkInResumeState !== 'none'}}" class="mt-4 rounded-[16rpx] border border-line bg-panel px-4 py-4">
      <view class="text-[length:24rpx] font-semibold">现场签到</view>
      <view class="mt-2 text-[length:22rpx] leading-5 text-muted">{{checkInResumeMessage}}</view>
      <view wx:if="{{checkInResumeState === 'ready'}}" class="mt-4"><t-button block size="large" theme="primary" bind:tap="continueCheckIn">继续签到</t-button></view>
      <view wx:elif="{{checkInResumeState === 'pending'}}" class="mt-4"><t-button block variant="outline" theme="default" bind:tap="retryEventRegistration">重新核对报名</t-button></view>
    </view>
    <view wx:if="{{message}}" class="mt-4 rounded-[16rpx] border border-line bg-panel-raised px-4 py-3 text-[length:22rpx]">{{message}}</view>
    <view class="mt-6 flex flex-col gap-3">
      <t-button wx:if="{{paymentPending}}" block size="large" theme="primary" loading="{{paying}}" disabled="{{!paymentEnabled}}" bind:tap="requestPayment">{{paymentEnabled ? '继续支付' : paymentUnavailableText}}</t-button>
      <t-button wx:if="{{refundable}}" block size="large" variant="outline" theme="danger" loading="{{submittingRefund}}" disabled="{{!paymentEnabled}}" bind:tap="requestRefund">{{paymentEnabled ? '申请退款' : '退款服务尚未配置'}}</t-button>
      <view wx:if="{{isEventOrder}}" class="flex gap-3"><t-button class="min-w-0 flex-1" block variant="outline" theme="default" bind:tap="openMyEvents">我的活动</t-button><t-button wx:if="{{eventId}}" class="min-w-0 flex-1" block theme="primary" bind:tap="openEvent">返回活动</t-button></view>
      <view wx:elif="{{isContentOrder}}" class="grid grid-cols-2 gap-3"><t-button block variant="outline" theme="default" bind:tap="openHelp">帮助与客服</t-button><t-button block theme="primary" bind:tap="openContent">返回内容</t-button></view>
      <view wx:else class="grid grid-cols-2 gap-3"><t-button block variant="outline" theme="default" bind:tap="openHelp">帮助与客服</t-button><t-button block theme="primary" bind:tap="openMembership">会员方案</t-button></view>
    </view>
  </block>
  <app-page-exit label="返回" />
</view>
