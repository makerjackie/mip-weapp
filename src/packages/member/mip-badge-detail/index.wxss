.badge-detail-page {
  min-height: 100vh;
  background: var(--color-canvas);
}

.badge-detail-content {
  box-sizing: border-box;
  min-height: calc(100vh - env(safe-area-inset-bottom));

  /* figma 1740_3454: badge art sits 109px below the nav (200px art centred in
     the upper screen), so the content needs a 218rpx top inset, not 48rpx. */
  padding-top: calc(env(safe-area-inset-top) + 218rpx);
}

.badge-detail-art-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 400rpx;
  height: 400rpx;
  margin: 0 auto;
}

.badge-detail-art {
  width: 100%;
  height: 100%;
}

.badge-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 280rpx;
  height: 280rpx;
  background: var(--color-brand-soft);
}

.badge-placeholder--hexagon {
  clip-path: polygon(25% 7%, 75% 7%, 100% 50%, 75% 93%, 25% 93%, 0 50%);
}
