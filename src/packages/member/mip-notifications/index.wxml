<view id="mip-notifications-page" class="mip-member-page min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-4 text-ink">
  <view aria-label="正在加载" aria-busy="true" wx:if="{{state === 'loading'}}" class="rounded-[16rpx] bg-panel px-4 py-7"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}"><mip-empty-state title="暂时无法加载消息" description="{{message || '服务暂时不可用，请重新加载。'}}" action-text="重新加载" bind:action="loadInbox" /><app-page-exit /></view>
  <block wx:else>
    <view class="mt-6 flex items-center justify-between"><view class="text-[length:30rpx] font-bold">消息</view><view class="text-[length:22rpx] text-muted">{{unreadCount}} 条未读</view></view>
    <view class="mt-3"><t-button variant="text" theme="primary" loading="{{markingAllRead}}" disabled="{{unreadCount === 0 || refreshing || loadingMore || markingAllRead}}" bind:tap="markAllRead">全部已读</t-button></view>
    <view wx:if="{{items.length === 0}}" class="mt-3 rounded-[16rpx] bg-panel px-4 py-8 text-center text-[length:24rpx] text-muted">暂无消息。</view>
    <view wx:else class="mt-3 flex flex-col gap-3">
      <view wx:for="{{items}}" wx:key="id" class="relative rounded-[16rpx] bg-panel px-4 py-4" data-id="{{item.id}}" bind:tap="openMessage">
        <view wx:if="{{!item.readAt}}" class="mb-2 text-[length:22rpx] text-brand" aria-label="未读消息">未读</view>
        <view class="pr-5 text-[length:24rpx] font-semibold">{{item.title}}</view>
        <view class="mt-2 text-[length:24rpx] leading-6 text-muted">{{item.body}}</view>
        <view class="mt-3 flex items-center justify-between text-[length:22rpx] text-muted"><text>{{item.createdText}}</text><mip-icon wx:if="{{item.target}}" name="chevron-down-1" size="{{14}}" color="var(--color-muted)" /></view>
      </view>
    </view>
    <view wx:if="{{nextCursor}}" class="mt-4"><t-button block variant="outline" loading="{{loadingMore}}" disabled="{{refreshing || markingAllRead || loadingMore}}" bind:tap="loadMore">加载更多</t-button></view>
    <view wx:if="{{message}}" class="mt-4 rounded-[16rpx] bg-brand-soft px-4 py-3 text-[length:22rpx] text-brand">{{message}}</view>
    <app-page-exit />
  </block>
</view>
