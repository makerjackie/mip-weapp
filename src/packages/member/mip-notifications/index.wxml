<view id="mip-notifications-page" class="min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-4 text-ink">
  <view wx:if="{{state === 'loading'}}" class="rounded-[16rpx] bg-panel px-4 py-7"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}"><app-empty-state title="暂时无法加载消息" description="请检查网络后重试。" action-text="重新加载" bind:action="loadInbox" /><app-page-exit /></view>
  <block wx:else>
    <view class="flex items-center justify-between gap-3 rounded-[16rpx] bg-panel px-4 py-4">
      <view><view class="text-[length:27rpx] font-semibold">微信活动提醒</view><view class="mt-1 text-[length:21rpx] text-muted">站内消息始终保留，微信提醒需要单独授权。</view></view>
      <t-button size="small" theme="primary" disabled="{{!subscriptionAvailable}}" loading="{{requestingSubscription}}" bind:tap="requestEventReminder">{{subscriptionAvailable ? '授权' : '未配置'}}</t-button>
    </view>
    <view class="mt-6 flex items-center justify-between"><view class="text-[length:30rpx] font-bold">消息</view><view class="text-[length:22rpx] text-muted">{{unreadCount}} 条未读</view></view>
    <view wx:if="{{items.length === 0}}" class="mt-3 rounded-[16rpx] bg-panel px-4 py-8 text-center text-[length:23rpx] text-muted">暂无消息。</view>
    <view wx:else class="mt-3 flex flex-col gap-3">
      <view wx:for="{{items}}" wx:key="id" class="relative rounded-[16rpx] bg-panel px-4 py-4" data-id="{{item.id}}" bind:tap="openMessage">
        <view wx:if="{{!item.readAt}}" class="absolute right-4 top-4 h-[14rpx] w-[14rpx] rounded-full bg-brand"></view>
        <view class="pr-5 text-[length:26rpx] font-semibold">{{item.title}}</view>
        <view class="mt-2 text-[length:23rpx] leading-6 text-muted">{{item.body}}</view>
        <view class="mt-3 flex items-center justify-between text-[length:20rpx] text-muted"><text>{{item.createdText}}</text><t-icon wx:if="{{item.target}}" name="chevron-right" size="28rpx" color="var(--color-muted)" /></view>
      </view>
    </view>
    <view wx:if="{{nextCursor}}" class="mt-4"><t-button block variant="outline" loading="{{loadingMore}}" bind:tap="loadMore">加载更多</t-button></view>
    <view wx:if="{{message}}" class="mt-4 rounded-[16rpx] bg-brand-soft px-4 py-3 text-[length:22rpx] text-brand">{{message}}</view>
    <app-page-exit />
  </block>
</view>
