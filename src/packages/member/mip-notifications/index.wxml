<view id="mip-notifications-page" class="mip-member-page min-h-screen bg-canvas px-3 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-3 text-ink">
  <view aria-label="正在加载" aria-busy="true" wx:if="{{state === 'loading'}}" class="rounded-[16rpx] bg-panel px-4 py-7"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}"><mip-empty-state title="暂时无法加载消息" description="{{message || '服务暂时不可用，请重新加载。'}}" action-text="重新加载" bind:action="loadInbox" /><app-page-exit /></view>
  <block wx:else>
    <!-- journey-review J3-04b 站内信（QI 自拟承接稿）：
         行 = 类型图标(40px 圆底 #333) + 类型名 + 预览一行 + 相对时间 + 行右上未读红点。
         进入页面即清除未读（onShow → enterInbox），无顶部「全部已读」按钮。 -->
    <view wx:if="{{items.length === 0}}" class="mt-3 rounded-[16rpx] bg-panel px-4 py-8 text-center text-[length:24rpx] text-muted">暂无消息。</view>
    <view wx:else class="flex flex-col gap-[16rpx]">
      <view wx:for="{{items}}" wx:key="id" class="relative flex items-start gap-[24rpx] rounded-[16rpx] bg-panel px-[24rpx] py-[28rpx] active:bg-panel-raised" data-id="{{item.id}}" bind:tap="openMessage">
        <view class="relative flex h-[80rpx] w-[80rpx] shrink-0 items-center justify-center rounded-full bg-panel-raised">
          <t-icon name="{{item.rowType.iconName}}" size="40rpx" color="{{item.rowType.iconColor}}" />
          <view wx:if="{{!item.readAt}}" class="absolute -right-[4rpx] -top-[4rpx] h-[16rpx] w-[16rpx] rounded-full bg-danger" aria-label="未读消息" />
        </view>
        <view class="min-w-0 flex-1">
          <view class="flex items-center justify-between gap-[16rpx]">
            <text class="truncate text-[length:32rpx] font-medium leading-[44.8rpx]">{{item.rowType.label}}</text>
            <text class="shrink-0 text-[length:20rpx] leading-[28rpx] text-muted">{{item.createdText}}</text>
          </view>
          <view class="mt-[6rpx] truncate text-[length:24rpx] leading-[33.6rpx] text-muted">{{item.body}}</view>
        </view>
        <mip-icon wx:if="{{item.target}}" class="mt-[28rpx] shrink-0" name="chevron-down-1" size="{{14}}" color="var(--color-muted)" />
      </view>
    </view>
    <view wx:if="{{nextCursor}}" class="mt-4"><t-button block variant="outline" loading="{{loadingMore}}" disabled="{{refreshing || markingAllRead || loadingMore}}" bind:tap="loadMore">加载更多</t-button></view>
    <view wx:if="{{message}}" class="mt-4 rounded-[16rpx] bg-brand-soft px-4 py-3 text-[length:22rpx] text-brand">{{message}}</view>
    <app-page-exit />
  </block>
</view>
