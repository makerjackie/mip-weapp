.badge-page {
  min-height: 100vh;
  background: var(--color-canvas);
}

.badge-hero {
  background: var(--color-panel);
}

/* figma 1746_3663: 40px tab bar on canvas with a 1px #202020 divider and a
   2px brand indicator spanning the active half. */
.badge-tabs {
  height: 80rpx;
  border-bottom: 2rpx solid var(--color-panel);
}

.badge-equipped-panel {
  box-sizing: border-box;
  padding: 0;
  background: transparent;
  border: 0;
}

.badge-equipped-slot {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
  color: var(--color-ink);
}

.badge-order-button {
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 52rpx;
  padding: 0 8rpx;
  font-size: 22rpx;
  line-height: 1.2;
  color: var(--color-ink);
  border: 1rpx solid var(--color-line);
  border-radius: 8rpx;
}

.badge-action-hit {
  display: flex;
  flex: 1 1 0;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 88rpx;
}

.badge-order-button--disabled {
  color: var(--color-muted);
  border-color: var(--color-line);
}

.badge-tab {
  position: relative;
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--color-muted);
}

.badge-tab--active {
  font-weight: 500;
  color: var(--color-brand);
}

.badge-tab--active::after {
  position: absolute;
  right: 0;
  bottom: -2rpx;
  left: 0;
  height: 4rpx;
  content: '';
  background: var(--color-brand);
}

/* figma 1746_3663: three 90px arts at integer x (24/143/262 → 29px gaps) and
   a 161px row pitch (136.8px card + 24.2px gap); fractional tracks resample
   the arts and bleed pixels, so the tracks are fixed at 180rpx. */
.badge-grid {
  display: grid;
  grid-template-columns: repeat(3, 180rpx);
  gap: 48.4rpx 58rpx;
}

.badge-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
  border-radius: 8rpx;
}

/* figma 1746_3663: the collection grid ends flush with the 24px page padding
   (327 = 90*3 + 29 + 28), so the right column starts 1px left of the uniform
   58rpx track; the equipped trio keeps the uniform pitch. */
.badge-grid .badge-item:nth-child(3n) {
  justify-self: start;
  width: 180rpx;
  margin-left: -2rpx;
}

.badge-item--selected {
  background: rgb(252 223 3 / 8%);
}

.badge-art-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 180rpx;
  height: 180rpx;
}

.badge-art {
  width: 100%;
  height: 100%;
}

.badge-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 132rpx;
  background: var(--color-brand-soft);
}

.badge-placeholder--hexagon {
  clip-path: polygon(25% 7%, 75% 7%, 100% 50%, 75% 93%, 25% 93%, 0 50%);
}
