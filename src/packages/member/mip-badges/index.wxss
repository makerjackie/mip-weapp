.badge-page {
  min-height: 100vh;
  background: var(--color-canvas);
}

.badge-hero {
  background: #202020;
}

.badge-tabs {
  height: 80rpx;
}

.badge-equipped-panel {
  box-sizing: border-box;
}

.badge-equipped-slot {
  flex: 1;
  min-width: 0;
  color: #fff;
}

.badge-order-button,
.badge-card-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 40rpx;
  padding: 0 10rpx;
  font-size: 20rpx;
  line-height: 1.2;
  color: #f5f5f5;
  border: 1rpx solid #4a4a4a;
  border-radius: 8rpx;
}

.badge-order-button--disabled,
.badge-card-action--disabled {
  color: var(--color-muted);
  border-color: var(--color-line);
}

.badge-filters {
  gap: 4rpx;
}

.badge-filter {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  font-size: 22rpx;
  color: #a3a3a3;
  border-radius: 8rpx;
}

.badge-filter--active {
  font-weight: 600;
  color: #111;
  background: #fcdf03;
}

.badge-tab {
  position: relative;
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #b3b3b3;
}

.badge-tab--active {
  color: #fff;
}

.badge-tab--active::after {
  position: absolute;
  right: 54rpx;
  bottom: 0;
  left: 54rpx;
  height: 6rpx;
  content: '';
  background: #fcdf03;
}

.badge-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 40rpx 18rpx;
}

.badge-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
  padding: 8rpx 0;
  border-radius: 12rpx;
}

.badge-item--selected {
  background: rgb(252 223 3 / 8%);
}

.badge-art-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 168rpx;
  height: 168rpx;
}

.badge-art-wrap--locked {
  opacity: .5;
  filter: grayscale(1);
}

.badge-art {
  width: 100%;
  height: 100%;
}

.badge-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 132rpx;
  background: var(--color-brand-soft);
}

.badge-placeholder--hexagon {
  clip-path: polygon(25% 7%, 75% 7%, 100% 50%, 75% 93%, 25% 93%, 0 50%);
}

.badge-card-action {
  min-width: 108rpx;
  min-height: 44rpx;
  border-color: #5a5a5a;
}
