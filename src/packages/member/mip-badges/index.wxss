.badge-page {
  min-height: 100vh;
  background: var(--color-canvas);
}

.badge-hero {
  background: var(--color-panel);
}

.badge-tabs {
  height: 80rpx;
}

.badge-equipped-panel {
  box-sizing: border-box;
  padding: 0;
  background: transparent;
  border: 0;
}

.badge-equipped-slot {
  flex: 1;
  min-width: 0;
  color: var(--color-ink);
}

.badge-order-button,
.badge-card-action {
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 52rpx;
  padding: 0 8rpx;
  font-size: 22rpx;
  line-height: 1.2;
  color: var(--color-ink);
  border: 1rpx solid var(--color-line);
  border-radius: 8rpx;
}

.badge-action-hit,
.badge-card-action-hit {
  display: flex;
  flex: 1 1 0;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 88rpx;
}

.badge-card-action-hit {
  flex: 0 0 auto;
  min-width: 108rpx;
}

.badge-order-button--disabled,
.badge-card-action--disabled {
  color: var(--color-muted);
  border-color: var(--color-line);
}

.badge-filters {
  gap: 4rpx;
}

.badge-filter {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  font-size: 22rpx;
  color: var(--color-muted);
  border-radius: 8rpx;
}

.badge-filter--active {
  font-weight: 600;
  color: var(--color-on-brand);
  background: var(--color-brand);
}

.badge-tab {
  position: relative;
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--color-muted);
}

.badge-tab--active {
  color: var(--color-ink);
}

.badge-tab--active::after {
  position: absolute;
  right: 54rpx;
  bottom: 0;
  left: 54rpx;
  height: 6rpx;
  content: '';
  background: var(--color-brand);
}

.badge-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 32rpx 18rpx;
}

.badge-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
  padding: 4rpx 0;
  border-radius: 12rpx;
}

.badge-item--selected {
  background: rgb(252 223 3 / 8%);
}

.badge-art-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 168rpx;
  height: 168rpx;
}

.badge-art-wrap--locked {
  opacity: .5;
  filter: grayscale(1);
}

.badge-art {
  width: 100%;
  height: 100%;
}

.badge-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 132rpx;
  background: var(--color-brand-soft);
}

.badge-placeholder--hexagon {
  clip-path: polygon(25% 7%, 75% 7%, 100% 50%, 75% 93%, 25% 93%, 0 50%);
}

.badge-card-action {
  min-width: 108rpx;
  min-height: 52rpx;
  border-color: var(--color-line);
}
