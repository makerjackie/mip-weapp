<view id="mip-people-discovery-page" class="mip-member-page min-h-screen bg-canvas px-3 pb-[calc(env(safe-area-inset-bottom)+260rpx)] pt-3 text-ink">
  <view class="flex min-h-[88rpx] items-center gap-3">
    <view class="flex min-h-[88rpx] min-w-0 flex-1 items-center gap-2 rounded-[16rpx] bg-panel px-2">
      <t-icon name="search" size="40rpx" color="var(--color-muted)" />
      <input id="people-search-input" class="box-border min-w-0 flex-1 max-w-full text-[length:28rpx]" value="{{keywordInput}}" maxlength="80" confirm-type="search" placeholder="搜索姓名、行业或能力" bindinput="onKeywordInput" bindconfirm="submitSearch" />
      <view wx:if="{{keywordInput}}" class="flex min-h-[88rpx] items-center px-2 text-[length:21rpx] text-muted" bind:tap="clearSearch">清除</view>
    </view>
    <view id="people-filter-toggle" class="flex min-h-[88rpx] w-[160rpx] shrink-0 items-center justify-center gap-1 rounded-[16rpx] bg-panel text-[length:32rpx] text-muted active:bg-panel-raised" aria-role="button" aria-expanded="{{filterOpen}}" bind:tap="toggleFilters"><t-icon name="filter" size="32rpx" color="var(--color-muted)" /><text>筛选</text></view>
  </view>

  <view class="mt-3 flex h-[56rpx] items-center gap-3">
    <view class="people-filter-chip-hit" aria-role="radio" aria-checked="{{searchScope === 'GLOBAL'}}" data-scope="GLOBAL" bind:tap="changeSearchScope"><view class="flex h-[56rpx] items-center rounded-[16rpx] px-3 text-[length:28rpx] {{searchScope === 'GLOBAL' ? 'bg-brand font-medium text-on-brand' : 'bg-panel text-muted'}}">全局搜索</view></view>
    <view class="people-filter-chip-hit" aria-role="radio" aria-checked="{{searchScope === 'PLAYER'}}" data-scope="PLAYER" bind:tap="changeSearchScope"><view class="flex h-[56rpx] items-center rounded-[16rpx] px-3 text-[length:28rpx] {{searchScope === 'PLAYER' ? 'bg-brand font-medium text-on-brand' : 'bg-panel text-muted'}}">只搜玩家</view></view>
    <view class="min-w-0 flex-1 truncate text-right text-[length:22rpx] text-muted">{{branchOptions[branchIndex].label}}</view>
  </view>

  <view wx:if="{{filterOpen}}" class="mt-4">
    <view class="text-[length:32rpx] font-medium">人才筛选</view>
    <view class="mt-4"><mip-catalog-selector title="城市与分会" groups="{{branchGroups}}" selected-ids="{{draftBranchIds}}" multiple="{{false}}" clear-label="全部城市与分会" bind:change="changeBranch" /></view>
    <view class="mt-5 text-[length:32rpx] font-medium">合作角色</view>
    <view class="mt-2 flex flex-wrap gap-2"><view wx:for="{{roleOptions}}" wx:key="key" class="people-filter-chip-hit" aria-role="radio" aria-checked="{{draftRoleKey === item.key}}" data-key="{{item.key}}" bind:tap="chooseRole"><view class="flex h-[56rpx] items-center rounded-[16rpx] px-3 text-[length:28rpx] {{draftRoleKey === item.key ? 'bg-brand text-on-brand' : 'bg-panel text-muted'}}">{{item.name}}</view></view></view>
    <view class="mt-5 text-[length:32rpx] font-medium">行业选择</view>
    <view wx:for="{{industryViewGroups}}" wx:for-item="group" wx:key="id" class="mt-4">
      <view class="text-[length:28rpx] text-ink">{{group.label}}</view>
      <view class="mt-2 flex flex-wrap gap-2">
        <view wx:for="{{group.options}}" wx:for-item="option" wx:key="id" class="people-filter-chip-hit" aria-role="checkbox" aria-checked="{{option.selected}}" data-id="{{option.id}}" bind:tap="toggleIndustry"><view class="flex h-[56rpx] items-center rounded-[16rpx] px-3 text-[length:28rpx] {{option.selected ? 'bg-brand text-on-brand' : 'bg-panel text-muted'}}">{{option.label}}</view></view>
      </view>
    </view>
    <view wx:if="{{!industryGroups.length}}" class="mt-3 text-[length:22rpx] text-muted">行业筛选项暂时无法加载。</view>
    <view class="mt-5 text-[length:32rpx] font-medium">能力选择</view>
    <view wx:if="{{abilityOptions.length}}" class="mt-2 flex flex-wrap gap-2"><view wx:for="{{abilityOptions}}" wx:key="id" class="people-filter-chip-hit" aria-role="checkbox" aria-checked="{{item.selected}}" data-id="{{item.id}}" bind:tap="toggleAbility"><view class="flex h-[56rpx] items-center rounded-[16rpx] px-3 text-[length:28rpx] {{item.selected ? 'bg-brand text-on-brand' : 'bg-panel text-muted'}}">{{item.label}}</view></view></view>
    <view wx:else class="mt-3 text-[length:22rpx] text-muted">能力筛选项暂时无法加载。</view>
    <view class="mip-member-fixed-inset fixed inset-x-3 bottom-[calc(env(safe-area-inset-bottom)+16rpx)] z-20 rounded-[20rpx] border border-brand bg-brand-soft p-2">
      <view class="px-3 pb-1 text-[length:22rpx] text-brand">已选行业 {{draftIndustryTagIds.length}}/8</view>
      <view class="flex items-center gap-3">
        <view class="flex h-[80rpx] w-[176rpx] shrink-0 items-center justify-center rounded-full border border-canvas bg-panel text-[length:32rpx] font-medium text-brand active:bg-panel-raised" aria-role="button" bind:tap="resetFilterDraft">清除</view>
        <view class="flex h-[80rpx] min-w-0 flex-1 items-center justify-center rounded-full border border-canvas bg-brand text-[length:32rpx] font-medium text-on-brand active:bg-brand-active" aria-role="button" bind:tap="applyFilters">确定</view>
      </view>
    </view>
  </view>

  <view wx:if="{{!filterOpen && state === 'loading'}}" class="mt-3 flex flex-col gap-3"><view class="flex h-[254rpx] items-center rounded-[16rpx] bg-panel px-3"><view class="h-[112rpx] w-[112rpx] rounded-full bg-panel-raised" /><view class="min-w-0 flex-1 pl-3"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view></view><view class="flex h-[254rpx] items-center rounded-[16rpx] bg-panel px-3"><view class="h-[112rpx] w-[112rpx] rounded-full bg-panel-raised" /><view class="min-w-0 flex-1 pl-3"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view></view></view>
  <view wx:elif="{{!filterOpen && state === 'error'}}" class="mt-5"><app-empty-state title="暂时无法加载人才档案" description="{{message}}" action-text="重新加载" bind:action="retryLoad" /></view>
  <view wx:elif="{{!filterOpen && state === 'empty'}}" class="mt-5"><app-empty-state title="没有找到公开档案" description="调整筛选条件后重试。" action-text="清除筛选" bind:action="clearAllFilters" /></view>

  <view wx:if="{{!filterOpen && state === 'ready'}}" class="mt-3 flex flex-col gap-3">
    <view wx:for="{{people}}" wx:key="profileRef" class="active:bg-panel-raised" aria-role="button" data-profile-ref="{{item.profileRef}}" bind:tap="openProfile">
      <mip-talent-card display-name="{{item.displayName}}" kind-label="{{item.kindLabel}}" avatar-url="{{item.avatarUrl || ''}}" meta-text="{{item.branchText || '城市未公开'}}{{item.primaryIndustry ? '｜' + item.primaryIndustry.label : ''}}" supporting-text="{{item.headline || item.identityStatus || '未填写个人简介'}}" role-names="{{item.roleNames}}" target-text="{{item.abilityText}}" />
    </view>
  </view>
  <view wx:if="{{!filterOpen && loadingMore}}" class="py-5 text-center text-[length:21rpx] text-muted">正在加载</view>
  <view wx:if="{{!filterOpen && message && state === 'ready'}}" class="mt-3 rounded-[12rpx] border border-line bg-panel px-4 py-3 text-[length:22rpx] text-muted">{{message}}</view>
  <app-page-exit />
</view>
