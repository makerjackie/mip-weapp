<view id="event-participants-page" class="min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-4 text-ink">
  <view wx:if="{{state === 'loading'}}" class="rounded-[28rpx] bg-panel px-5 py-8"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}"><app-empty-state title="暂时无法查看参与者" description="{{message || '请稍后重试。'}}" action-text="重新加载" bind:action="load" /></view>
  <block wx:else>
    <view class="rounded-[28rpx] bg-brand px-5 py-5 text-on-brand">
      <view class="text-[length:20rpx] font-semibold tracking-[0.12em] text-white/70">一起参加这场活动</view>
      <view class="mt-2 text-[length:34rpx] font-bold leading-[1.25]">{{eventTitle}}</view>
      <view class="mt-3 text-[length:22rpx] text-white/80">{{totalRegistrationCount}} 人已报名 · {{visibleParticipantCount}} 人公开了资料</view>
    </view>
    <scroll-view wx:if="{{roleFilters.length}}" class="mt-4 w-full whitespace-nowrap" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="inline-flex gap-2 pr-4">
        <block wx:for="{{roleViews}}" wx:key="label">
          <view wx:if="{{item.selected}}" class="rounded-full bg-brand px-4 py-2 text-[length:21rpx] font-semibold text-on-brand" data-role="{{item.label}}" bind:tap="chooseRole">{{item.label || '全部'}}</view>
          <view wx:else class="rounded-full bg-panel px-4 py-2 text-[length:21rpx] font-semibold text-muted" data-role="{{item.label}}" bind:tap="chooseRole">{{item.label || '全部'}}</view>
        </block>
      </view>
    </scroll-view>
    <view wx:if="{{!items.length}}" class="mt-5"><app-empty-state title="还没有公开的参与者资料" description="报名人数仍按真实报名记录统计；是否公开资料由每位成员自行选择。" /></view>
    <view wx:else class="mt-4 flex flex-col gap-3">
      <view wx:for="{{items}}" wx:key="id" class="flex items-start gap-4 rounded-[26rpx] bg-panel px-4 py-4 active:bg-panel-muted" data-member-id="{{item.id}}" bind:tap="openMember">
        <image wx:if="{{item.avatarUrl}}" class="h-[112rpx] w-[112rpx] shrink-0 rounded-[22rpx] bg-brand-soft" mode="aspectFill" src="{{item.avatarUrl}}" />
        <view wx:else class="flex h-[112rpx] w-[112rpx] shrink-0 items-center justify-center rounded-[22rpx] bg-brand-soft"><t-icon name="user-avatar" size="52rpx" color="var(--color-brand)" /></view>
        <view class="min-w-0 flex-1">
          <view class="flex items-center justify-between gap-3"><view class="truncate text-[length:27rpx] font-bold">{{item.nickname}}</view><t-icon name="chevron-right" size="32rpx" color="var(--color-muted)" /></view>
          <view wx:if="{{item.subtitle}}" class="mt-1 truncate text-[length:20rpx] text-muted">{{item.subtitle}}</view>
          <view class="mt-2 line-clamp-2 text-[length:22rpx] leading-5 text-muted">{{item.introduction}}</view>
          <view wx:if="{{item.tags.length}}" class="mt-3 flex flex-wrap gap-2"><view wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="rounded-full bg-brand-soft px-2 py-1 text-[length:18rpx] text-brand">{{tag}}</view></view>
        </view>
      </view>
    </view>
    <view wx:if="{{loadingMore}}" class="py-5 text-center text-[length:21rpx] text-muted">正在加载更多参与者…</view>
    <view wx:elif="{{items.length && !nextCursor}}" class="py-5 text-center text-[length:20rpx] text-muted">仅展示主动同意公开资料的成员</view>
    <view wx:if="{{message && state === 'ready'}}" class="mt-4 rounded-[18rpx] bg-[#FFF0E8] px-4 py-3 text-[length:23rpx] text-[#9F4727]">{{message}}</view>
  </block>
  <app-page-exit />
</view>
