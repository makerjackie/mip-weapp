<view id="mip-card-edit-page" class="mip-member-page min-h-screen bg-canvas text-ink">
  <view wx:if="{{state === 'loading'}}" class="mx-[24rpx] mt-[24rpx] rounded-[16rpx] bg-panel px-4 py-7"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}" class="mx-[24rpx] mt-[24rpx]"><mip-empty-state title="暂时无法加载名片" description="{{message}}" action-text="重新加载" bind:action="load" /><app-page-exit /></view>
  <block wx:else>
    <!-- figma 1732_20291: 名片卡 351×246 r16 @页面 (12,12)，烘焙黄底+吉祥物（card-bg-d-yellow），
         姓名 fs20 @ (12,12)，公司/职位/组织/组织职位 fs12 @ 44/65/94/115，
         联系行 21px 节距 @ 154/175/196/217（icon 16 格 x13 + 4px 缝 + 文本 x33），
         头像 120 圆 @ (219,12) 2px 品牌环，名片码 60 圆 @ (279,174) 1px 品牌环。 -->
    <view class="relative mx-[24rpx] mt-[24rpx] h-[492rpx] overflow-hidden rounded-[32rpx] bg-brand-alt">
      <image class="absolute left-0 top-0 h-full w-full" src="/packages/member/assets/figma/profile/card-bg-d-yellow.webp" mode="aspectFill" />
      <view class="absolute left-[24rpx] top-[24rpx] whitespace-nowrap text-[40rpx] font-medium leading-[56rpx] text-canvas">{{previewNickname}}</view>
      <view class="absolute left-[24rpx] top-[88rpx] whitespace-nowrap text-[24rpx] font-medium leading-[33.6rpx] text-canvas">{{previewCompany}}</view>
      <view class="absolute left-[24rpx] top-[130rpx] whitespace-nowrap text-[24rpx] font-medium leading-[33.6rpx] text-canvas">{{previewRole}}</view>
      <view class="absolute left-[24rpx] top-[188rpx] whitespace-nowrap text-[24rpx] font-medium leading-[33.6rpx] text-canvas">{{previewOrganization}}</view>
      <view class="absolute left-[24rpx] top-[230rpx] whitespace-nowrap text-[24rpx] font-medium leading-[33.6rpx] text-canvas">{{previewOrganizationRole}}</view>
      <view class="absolute left-[26rpx] top-[308rpx] flex items-center gap-[8rpx]">
        <view class="flex h-[32rpx] w-[32rpx] items-center justify-center"><mip-icon name="cellphone-2" size="{{16}}" color="var(--color-canvas)" /></view>
        <text class="whitespace-nowrap text-[24rpx] font-medium leading-[33.6rpx] text-canvas">{{previewPhone}}</text>
      </view>
      <view class="absolute left-[26rpx] top-[350rpx] flex items-center gap-[8rpx]">
        <view class="flex h-[32rpx] w-[32rpx] items-center justify-center"><mip-icon name="wechat-2" size="{{16}}" color="var(--color-canvas)" /></view>
        <text class="whitespace-nowrap text-[24rpx] font-medium leading-[33.6rpx] text-canvas">{{previewWechat}}</text>
      </view>
      <view class="absolute left-[26rpx] top-[392rpx] flex items-center gap-[8rpx]">
        <view class="flex h-[32rpx] w-[32rpx] items-center justify-center"><mip-icon name="mail-2" size="{{16}}" color="var(--color-canvas)" /></view>
        <text class="whitespace-nowrap text-[24rpx] font-medium leading-[33.6rpx] text-canvas">{{previewEmail}}</text>
      </view>
      <view class="absolute left-[26rpx] top-[434rpx] flex items-center gap-[8rpx]">
        <view class="flex h-[32rpx] w-[32rpx] items-center justify-center"><mip-icon name="icon-map-pin-line" size="{{16}}" color="var(--color-canvas)" /></view>
        <text class="whitespace-nowrap text-[24rpx] font-medium leading-[33.6rpx] text-canvas">{{previewAddress}}</text>
      </view>
      <view class="absolute left-[438rpx] top-[24rpx] h-[240rpx] w-[240rpx] overflow-hidden rounded-full border-[4rpx] border-brand">
        <image wx:if="{{previewAvatarUrl}}" class="h-full w-full" src="{{previewAvatarUrl}}" mode="aspectFill" />
        <view wx:else class="flex h-full w-full items-center justify-center bg-black/10 text-[48rpx] font-medium text-canvas">{{previewInitial}}</view>
      </view>
      <view wx:if="{{previewCodeUrl}}" class="absolute right-[24rpx] top-[348rpx] h-[120rpx] w-[120rpx] overflow-hidden rounded-full border-[2rpx] border-brand">
        <image class="h-full w-full" src="{{previewCodeUrl}}" mode="aspectFill" />
      </view>
    </view>

    <!-- figma 1732_20291: 个人信息组 @ (12,282)：头 16 格 + 4px 缝 + fs16 标题；行 46px 高 1px 拼
         缝（92rpx + 2rpx 缝），首行头像行 80px r8 顶圆，尾行 r8 底圆；添加行透明全圆角右对齐。
         第二段经历（figma 1729_20514）：子标题 第二公司职位 + 独立卡（公司/职位行）+ 添加行随最后一段。 -->
    <view class="mx-[24rpx] mt-[48rpx] flex items-center gap-[8rpx]">
      <view class="flex h-[32rpx] w-[32rpx] items-center justify-center"><mip-icon name="contacts-1-1" size="{{16}}" color="var(--color-brand)" /></view>
      <text class="whitespace-nowrap text-[32rpx] font-medium leading-[44.8rpx]">个人信息</text>
    </view>
    <view class="mx-[24rpx] mt-[24rpx] flex flex-col gap-[2rpx]">
      <view data-card-field-group="company" class="flex h-[160rpx] items-center justify-between rounded-t-[16rpx] bg-panel px-[24rpx]">
        <view class="h-[112rpx] w-[112rpx] overflow-hidden rounded-full bg-panel-raised">
          <image wx:if="{{formAvatarUrl}}" class="h-full w-full" src="{{formAvatarUrl}}" mode="aspectFill" />
          <view wx:else class="flex h-full w-full items-center justify-center text-[40rpx] font-medium text-muted">{{previewInitial}}</view>
        </view>
        <text class="whitespace-nowrap text-[24rpx] font-medium leading-[33.6rpx] text-muted">更换头像</text>
      </view>
      <view data-card-field-group="identity" data-card-field-row="realName" class="flex min-h-[92rpx] items-center justify-between bg-panel px-[24rpx] py-[20rpx]">
        <view class="flex items-baseline gap-[4rpx]">
          <text class="whitespace-nowrap text-[28rpx] font-medium leading-[33.6rpx]">姓名</text>
          <text class="text-[20rpx] font-medium leading-[33.6rpx] text-danger"> *</text>
        </view>
        <input class="h-[52rpx] flex-1 bg-transparent text-right text-[24rpx] font-medium leading-[33.6rpx]" placeholder-style="color: var(--color-muted)" placeholder="请输入您的姓名" value="{{realName}}" bindinput="updateText" data-field="realName" />
      </view>
      <view data-card-field-group="company" class="flex items-center justify-between bg-panel px-[24rpx] py-[2rpx]">
        <view class="flex items-baseline gap-[4rpx]">
          <text class="whitespace-nowrap text-[28rpx] font-medium leading-[33.6rpx]">公司</text>
          <text class="text-[20rpx] font-medium leading-[33.6rpx] text-danger"> *</text>
        </view>
        <input data-card-field-row="company" class="h-[88rpx] flex-1 bg-transparent text-right text-[24rpx] font-medium leading-[33.6rpx]" placeholder-style="color: var(--color-muted)" placeholder="请输入您的公司名称" value="{{companies[0].name}}" bindinput="updateExperience" data-kind="companies" data-index="0" data-field="name" />
      </view>
      <view data-card-field-group="company" class="flex items-center justify-between rounded-b-[16rpx] bg-panel px-[24rpx] py-[2rpx]">
        <view class="flex items-baseline gap-[4rpx]">
          <text class="whitespace-nowrap text-[28rpx] font-medium leading-[33.6rpx]">职位</text>
          <text class="text-[20rpx] font-medium leading-[33.6rpx] text-danger"> *</text>
        </view>
        <input data-card-field-row="role" class="h-[88rpx] flex-1 bg-transparent text-right text-[24rpx] font-medium leading-[33.6rpx]" placeholder-style="color: var(--color-muted)" placeholder="请输入您的公司职位" value="{{companies[0].role}}" bindinput="updateExperience" data-kind="companies" data-index="0" data-field="role" />
      </view>
      <block wx:for="{{companies}}" wx:key="id">
        <view wx:if="{{companies.length > 1 && index > 0}}" class="mt-[28rpx] flex flex-col" data-card-field-group="company">
          <view class="flex h-[34rpx] items-center justify-between">
            <text class="whitespace-nowrap text-[28rpx] font-medium leading-[33.6rpx]">{{index === 1 ? '第二公司职位' : '其他公司职位'}}</text>
            <view class="flex items-center gap-[24rpx]">
              <text class="whitespace-nowrap text-[20rpx] font-medium leading-[28rpx] text-muted" aria-role="button" aria-label="上移公司经历" bind:tap="moveExperience" data-kind="companies" data-index="{{index}}" data-direction="-1">上移</text>
              <text class="whitespace-nowrap text-[20rpx] font-medium leading-[28rpx] text-muted" aria-role="button" aria-label="下移公司经历" bind:tap="moveExperience" data-kind="companies" data-index="{{index}}" data-direction="1">下移</text>
              <text class="whitespace-nowrap text-[20rpx] font-medium leading-[28rpx] text-muted" aria-role="button" aria-label="删除公司经历" bind:tap="removeExperience" data-kind="companies" data-index="{{index}}">删除</text>
            </view>
          </view>
          <view class="mt-[28rpx] flex flex-col gap-[2rpx]">
            <view class="flex items-center justify-between rounded-t-[16rpx] bg-panel px-[24rpx] py-[2rpx]">
              <view class="flex items-baseline gap-[4rpx]">
                <text class="whitespace-nowrap text-[28rpx] font-medium leading-[33.6rpx]">公司</text>
                <text class="text-[20rpx] font-medium leading-[33.6rpx] text-danger"> *</text>
              </view>
              <input data-card-field-row="company" class="h-[88rpx] flex-1 bg-transparent text-right text-[24rpx] font-medium leading-[33.6rpx]" placeholder-style="color: var(--color-muted)" placeholder="请输入您的公司名称" value="{{item.name}}" bindinput="updateExperience" data-kind="companies" data-index="{{index}}" data-field="name" />
            </view>
            <view class="flex items-center justify-between rounded-b-[16rpx] bg-panel px-[24rpx] py-[2rpx]">
              <view class="flex items-baseline gap-[4rpx]">
                <text class="whitespace-nowrap text-[28rpx] font-medium leading-[33.6rpx]">职位</text>
                <text class="text-[20rpx] font-medium leading-[33.6rpx] text-danger"> *</text>
              </view>
              <input data-card-field-row="role" class="h-[88rpx] flex-1 bg-transparent text-right text-[24rpx] font-medium leading-[33.6rpx]" placeholder-style="color: var(--color-muted)" placeholder="请输入您的公司职位" value="{{item.role}}" bindinput="updateExperience" data-kind="companies" data-index="{{index}}" data-field="role" />
            </view>
          </view>
        </view>
      </block>
      <view class="flex h-[92rpx] items-center justify-end gap-[16rpx] rounded-[16rpx]" aria-role="button" aria-label="添加公司经历" bind:tap="addExperience" data-kind="companies">
        <view class="flex h-[28rpx] w-[28rpx] items-center justify-center"><mip-icon name="icon-plus-fill" size="{{14}}" color="var(--color-brand)" /></view>
        <text class="whitespace-nowrap text-[24rpx] font-medium leading-[33.6rpx] text-brand">添加公司/职位</text>
      </view>
    </view>

    <!-- figma 1732_20291: 联系方式组 @ (12,596)：头 contacts-book-3 + fs16；行 手机号/微信/邮箱/地址
         46px 节距 47，首尾 8px 圆角；手机号行 = 授权按钮（open-type getPhoneNumber）。 -->
    <view class="mx-[24rpx] mt-[24rpx] flex items-center gap-[8rpx]">
      <view class="flex h-[32rpx] w-[32rpx] items-center justify-center"><mip-icon name="contacts-book-3" size="{{16}}" color="var(--color-brand)" /></view>
      <text class="whitespace-nowrap text-[32rpx] font-medium leading-[44.8rpx]">联系方式</text>
    </view>
    <view data-card-field-group="contact" class="mx-[24rpx] mt-[24rpx] flex flex-col gap-[2rpx]">
      <view data-card-field-row="phone" class="flex min-h-[92rpx] items-center justify-between rounded-t-[16rpx] bg-panel px-[24rpx] py-[20rpx]">
        <view class="flex items-baseline gap-[4rpx]">
          <text class="whitespace-nowrap text-[28rpx] font-medium leading-[33.6rpx]">手机号</text>
          <text class="text-[20rpx] font-medium leading-[33.6rpx] text-danger"> *</text>
        </view>
        <button class="flex flex-1 items-center justify-end bg-transparent p-0 text-right text-[24rpx] font-medium leading-[33.6rpx] {{phoneMasked ? 'text-ink' : 'text-muted'}}" open-type="getPhoneNumber" bindgetphonenumber="bindPhone">{{phoneMasked || '请输入您的手机号'}}</button>
      </view>
      <view data-card-field-row="wechat" class="flex min-h-[92rpx] items-center justify-between bg-panel px-[24rpx] py-[20rpx]">
        <text class="whitespace-nowrap text-[28rpx] font-medium leading-[33.6rpx]">微信</text>
        <input class="h-[52rpx] flex-1 bg-transparent text-right text-[24rpx] font-medium leading-[33.6rpx]" placeholder-style="color: var(--color-muted)" placeholder="请输入微信号" value="{{wechat}}" bindinput="updateText" data-field="wechat" />
      </view>
      <view data-card-field-row="email" class="flex min-h-[92rpx] items-center justify-between bg-panel px-[24rpx] py-[20rpx]">
        <text class="whitespace-nowrap text-[28rpx] font-medium leading-[33.6rpx]">邮箱</text>
        <input class="h-[52rpx] flex-1 bg-transparent text-right text-[24rpx] font-medium leading-[33.6rpx]" placeholder-style="color: var(--color-muted)" placeholder="请输入您的邮箱" value="{{email}}" bindinput="updateText" data-field="email" />
      </view>
      <view data-card-field-row="address" class="flex min-h-[92rpx] items-center justify-between rounded-b-[16rpx] bg-panel px-[24rpx] py-[20rpx]">
        <text class="whitespace-nowrap text-[28rpx] font-medium leading-[33.6rpx]">地址</text>
        <input class="h-[52rpx] flex-1 bg-transparent text-right text-[24rpx] font-medium leading-[33.6rpx]" placeholder-style="color: var(--color-muted)" placeholder="请输入您的地址" value="{{address}}" bindinput="updateText" data-field="address" />
      </view>
    </view>

    <!-- figma 1732_20291: 组织信息组 @ (12,829)；第二段组织（figma 1729_20840）同公司经历模型。 -->
    <view class="mx-[24rpx] mt-[24rpx] flex items-center gap-[8rpx]">
      <view class="flex h-[32rpx] w-[32rpx] items-center justify-center"><mip-icon name="parent" size="{{16}}" color="var(--color-brand)" /></view>
      <text class="whitespace-nowrap text-[32rpx] font-medium leading-[44.8rpx]">组织信息</text>
    </view>
    <view data-card-field-group="organization" class="mx-[24rpx] mt-[24rpx] flex flex-col gap-[2rpx]">
      <view class="flex items-center justify-between rounded-t-[16rpx] bg-panel px-[24rpx] py-[2rpx]">
        <text class="whitespace-nowrap text-[28rpx] font-medium leading-[33.6rpx]">组织</text>
        <input data-card-field-row="organization" class="h-[88rpx] flex-1 bg-transparent text-right text-[24rpx] font-medium leading-[33.6rpx]" placeholder-style="color: var(--color-muted)" placeholder="请输入您的组织名称" value="{{organizations[0].name}}" bindinput="updateExperience" data-kind="organizations" data-index="0" data-field="name" />
      </view>
      <view class="flex items-center justify-between rounded-b-[16rpx] bg-panel px-[24rpx] py-[2rpx]">
        <text class="whitespace-nowrap text-[28rpx] font-medium leading-[33.6rpx]">职位</text>
        <input data-card-field-row="organizationRole" class="h-[88rpx] flex-1 bg-transparent text-right text-[24rpx] font-medium leading-[33.6rpx]" placeholder-style="color: var(--color-muted)" placeholder="请输入您的公司职位" value="{{organizations[0].role}}" bindinput="updateExperience" data-kind="organizations" data-index="0" data-field="role" />
      </view>
      <block wx:for="{{organizations}}" wx:key="id">
        <view wx:if="{{organizations.length > 1 && index > 0}}" class="mt-[28rpx] flex flex-col">
          <view class="flex h-[34rpx] items-center justify-between">
            <text class="whitespace-nowrap text-[28rpx] font-medium leading-[33.6rpx]">{{index === 1 ? '第二组织职位' : '其他组织职位'}}</text>
            <view class="flex items-center gap-[24rpx]">
              <text class="whitespace-nowrap text-[20rpx] font-medium leading-[28rpx] text-muted" aria-role="button" aria-label="上移组织经历" bind:tap="moveExperience" data-kind="organizations" data-index="{{index}}" data-direction="-1">上移</text>
              <text class="whitespace-nowrap text-[20rpx] font-medium leading-[28rpx] text-muted" aria-role="button" aria-label="下移组织经历" bind:tap="moveExperience" data-kind="organizations" data-index="{{index}}" data-direction="1">下移</text>
              <text class="whitespace-nowrap text-[20rpx] font-medium leading-[28rpx] text-muted" aria-role="button" aria-label="删除组织经历" bind:tap="removeExperience" data-kind="organizations" data-index="{{index}}">删除</text>
            </view>
          </view>
          <view class="mt-[28rpx] flex flex-col gap-[2rpx]">
            <view class="flex items-center justify-between rounded-t-[16rpx] bg-panel px-[24rpx] py-[2rpx]">
              <text class="whitespace-nowrap text-[28rpx] font-medium leading-[33.6rpx]">组织</text>
              <input data-card-field-row="organization" class="h-[88rpx] flex-1 bg-transparent text-right text-[24rpx] font-medium leading-[33.6rpx]" placeholder-style="color: var(--color-muted)" placeholder="请输入您的组织名称" value="{{item.name}}" bindinput="updateExperience" data-kind="organizations" data-index="{{index}}" data-field="name" />
            </view>
            <view class="flex items-center justify-between rounded-b-[16rpx] bg-panel px-[24rpx] py-[2rpx]">
              <text class="whitespace-nowrap text-[28rpx] font-medium leading-[33.6rpx]">职位</text>
              <input data-card-field-row="organizationRole" class="h-[88rpx] flex-1 bg-transparent text-right text-[24rpx] font-medium leading-[33.6rpx]" placeholder-style="color: var(--color-muted)" placeholder="请输入您的公司职位" value="{{item.role}}" bindinput="updateExperience" data-kind="organizations" data-index="{{index}}" data-field="role" />
            </view>
          </view>
        </view>
      </block>
      <view class="flex h-[92rpx] items-center justify-end gap-[16rpx] rounded-[16rpx]" aria-role="button" aria-label="添加组织经历" bind:tap="addExperience" data-kind="organizations">
        <view class="flex h-[28rpx] w-[28rpx] items-center justify-center"><mip-icon name="icon-plus-fill" size="{{14}}" color="var(--color-brand)" /></view>
        <text class="whitespace-nowrap text-[24rpx] font-medium leading-[33.6rpx] text-brand">添加组织/职位</text>
      </view>
    </view>

    <view wx:if="{{message}}" class="mx-[24rpx] mt-[16rpx] rounded-[8rpx] bg-panel px-4 py-3 text-[22rpx] leading-[30.8rpx] text-danger">{{message}}</view>

    <!-- figma 1732_20291: 底部玻璃药丸 @ (12,1068) 351×56：预览 88×40 panel 底 + 保存 227×40
         品牌底，1px 黑描边，间距 12px。 -->
    <mip-sticky-actions>
      <view slot="actions" class="flex h-[112rpx] w-full items-center gap-[24rpx] rounded-full bg-brand-soft px-[24rpx] py-[16rpx]">
        <view class="flex h-[80rpx] w-[176rpx] items-center justify-center gap-[16rpx] rounded-full border border-black bg-panel" aria-role="button" aria-label="预览名片" bind:tap="openPreview">
          <view class="flex h-[40rpx] w-[40rpx] items-center justify-center"><mip-icon name="id-card" size="{{20}}" color="var(--color-brand)" /></view>
          <text class="whitespace-nowrap text-[32rpx] font-medium leading-[44.8rpx] text-brand">预览</text>
        </view>
        <view class="flex h-[80rpx] flex-1 items-center justify-center rounded-full border border-black bg-brand active:bg-brand-active" aria-role="button" aria-label="保存名片" bind:tap="save">
          <text class="whitespace-nowrap text-[32rpx] font-medium leading-[44.8rpx] text-on-brand">{{saving ? '保存中…' : '保存'}}</text>
        </view>
      </view>
    </mip-sticky-actions>
    <app-page-exit />
  </block>
</view>
