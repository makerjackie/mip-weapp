<view id="mip-card-edit-page" class="mip-member-page min-h-screen bg-canvas pb-[calc(env(safe-area-inset-bottom)+180rpx)] text-ink">
  <view aria-label="正在加载" aria-busy="true" wx:if="{{state === 'loading'}}" class="mx-3 mt-3 rounded-[16rpx] bg-panel px-5 py-8"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}" class="mx-3 mt-3"><app-empty-state title="暂时无法加载名片设置" description="身份服务暂时没有响应。" action-text="重新加载" bind:action="load" /></view>
  <block wx:else>
    <view class="card-edit-preview" aria-label="名片预览">
      <view class="card-edit-preview__copy">
        <view class="card-edit-preview__name">{{previewNickname}}</view>
        <view wx:if="{{companies.length}}" class="card-edit-preview__line">{{companies[0].name}}</view>
        <view wx:if="{{companies.length && companies[0].role}}" class="card-edit-preview__line">{{companies[0].role}}</view>
        <view wx:if="{{organizations.length}}" class="card-edit-preview__line card-edit-preview__line--spaced">{{organizations[0].name}}</view>
        <view wx:if="{{organizations.length && organizations[0].role}}" class="card-edit-preview__line">{{organizations[0].role}}</view>
        <view class="card-edit-preview__contacts">
          <view wx:if="{{phoneBound && phoneMasked}}">{{phoneMasked}}</view>
          <view wx:if="{{wechat}}">{{wechat}}</view>
          <view wx:if="{{email}}">{{email}}</view>
          <view wx:if="{{address}}">{{address}}</view>
        </view>
      </view>
      <image wx:if="{{previewAvatarUrl}}" class="card-edit-preview__avatar" mode="aspectFill" src="{{previewAvatarUrl}}" />
      <view wx:else class="card-edit-preview__avatar card-edit-preview__avatar--fallback">{{previewInitial}}</view>
      <view wx:if="{{previewCodeUrl}}" class="card-edit-preview__code"><image mode="aspectFit" src="{{previewCodeUrl}}" /></view>
    </view>
    <view class="mx-3 mt-3 text-[length:22rpx] text-muted">保存后，名片会同步更新。</view>

    <view class="mx-3 mt-3 text-[length:30rpx] font-semibold">个人信息</view>
    <view data-card-field-group="identity" class="mip-radius-card-medium mx-3 mt-3 overflow-hidden bg-panel">
      <view data-card-field-row="realName" class="flex min-h-[92rpx] items-center px-3">
        <text class="w-[144rpx] shrink-0 text-[length:26rpx] font-medium">姓名</text>
        <input aria-label="姓名" class="h-[92rpx] min-w-0 flex-1 text-right text-[length:26rpx]" maxlength="64" value="{{realName}}" data-field="realName" bindinput="updateText" placeholder="请输入姓名" placeholder-style="color:#A3A3A3;text-align:right" />
      </view>
    </view>

    <view class="mx-3 mt-5 flex items-center justify-between"><view class="text-[length:30rpx] font-semibold">公司信息</view><view class="text-[length:22rpx] text-muted">{{companies.length}}/{{maxOrganizations}}</view></view>
    <view data-card-field-group="company" class="mx-3 mt-3">
      <view wx:if="{{!companies.length}}" class="rounded-[16rpx] border border-line bg-panel px-4 py-5 text-[length:23rpx] text-muted">暂未添加公司经历。</view>
      <view wx:for="{{companies}}" wx:key="id" class="mt-3 rounded-[16rpx] border border-line bg-panel px-3 py-4">
        <view class="flex min-h-[64rpx] items-center justify-between gap-2">
          <view class="text-[length:24rpx] font-semibold">公司 {{index + 1}}</view>
          <view class="flex shrink-0 items-center gap-1">
            <button plain class="m-0 flex min-h-[88rpx] min-w-[88rpx] items-center justify-center px-2 text-[length:22rpx] text-muted disabled:opacity-40" disabled="{{index === 0}}" data-kind="companies" data-index="{{index}}" data-direction="-1" bind:tap="moveExperience">上移</button>
            <button plain class="m-0 flex min-h-[88rpx] min-w-[88rpx] items-center justify-center px-2 text-[length:22rpx] text-muted disabled:opacity-40" disabled="{{index === companies.length - 1}}" data-kind="companies" data-index="{{index}}" data-direction="1" bind:tap="moveExperience">下移</button>
            <button plain class="m-0 flex min-h-[88rpx] min-w-[88rpx] items-center justify-center px-2 text-[length:22rpx] text-danger" data-kind="companies" data-index="{{index}}" bind:tap="removeExperience">删除</button>
          </view>
        </view>
        <input aria-label="公司名称" data-card-field-row="company" class="mt-2 block h-[88rpx] w-full max-w-full box-border rounded-[14rpx] bg-canvas px-4 text-[length:26rpx]" maxlength="120" value="{{item.name}}" data-kind="companies" data-index="{{index}}" data-field="name" bindinput="updateExperience" placeholder="公司名称" placeholder-style="color:#A3A3A3" />
        <input aria-label="公司职位" data-card-field-row="role" class="mt-3 block h-[88rpx] w-full max-w-full box-border rounded-[14rpx] bg-canvas px-4 text-[length:26rpx]" maxlength="80" value="{{item.role}}" data-kind="companies" data-index="{{index}}" data-field="role" bindinput="updateExperience" placeholder="职位" placeholder-style="color:#A3A3A3" />
      </view>
      <button plain class="mt-3 flex min-h-[88rpx] w-full max-w-full box-border items-center justify-center rounded-[14rpx] border border-line text-[length:24rpx] text-ink disabled:opacity-40" disabled="{{companies.length >= maxOrganizations}}" data-kind="companies" bind:tap="addExperience">添加公司经历</button>
    </view>

    <view class="mx-3 mt-5 text-[length:30rpx] font-semibold">联系方式</view>
    <view data-card-field-group="contact" class="mip-radius-card-medium mx-3 mt-3 overflow-hidden bg-panel">
      <view data-card-field-row="phone" class="flex min-h-[92rpx] items-center border-b border-line px-3">
        <text class="w-[144rpx] shrink-0 text-[length:26rpx] font-medium">手机号</text>
        <view class="flex min-w-0 flex-1 items-center justify-end gap-2 text-[length:25rpx]"><text class="truncate text-muted">{{phoneBound ? (phoneMasked || '已绑定') : '未绑定'}}</text><button open-type="getPhoneNumber" plain disabled="{{phoneBinding || saving}}" class="m-0 shrink-0 border-0 p-0 text-[length:23rpx] text-brand disabled:opacity-50" bind:getphonenumber="bindPhone">{{phoneBinding ? '更新中' : (phoneBound ? '更换' : '绑定')}}</button></view>
      </view>
      <view data-card-field-row="wechat" class="flex min-h-[92rpx] items-center border-b border-line px-3">
        <text class="w-[144rpx] shrink-0 text-[length:26rpx] font-medium">微信号</text>
        <input aria-label="微信号" class="h-[92rpx] min-w-0 flex-1 text-right text-[length:26rpx]" maxlength="120" value="{{wechat}}" data-field="wechat" bindinput="updateText" placeholder="请输入微信号" placeholder-style="color:#A3A3A3;text-align:right" />
      </view>
      <view data-card-field-row="email" class="flex min-h-[92rpx] items-center border-b border-line px-3">
        <text class="w-[144rpx] shrink-0 text-[length:26rpx] font-medium">邮箱</text>
        <input aria-label="邮箱" class="h-[92rpx] min-w-0 flex-1 text-right text-[length:26rpx]" maxlength="160" value="{{email}}" data-field="email" bindinput="updateText" placeholder="请输入邮箱" placeholder-style="color:#A3A3A3;text-align:right" />
      </view>
      <view data-card-field-row="address" class="flex min-h-[92rpx] items-center px-3">
        <text class="w-[144rpx] shrink-0 text-[length:26rpx] font-medium">地址</text>
        <input aria-label="联系地址" class="h-[92rpx] min-w-0 flex-1 text-right text-[length:26rpx]" maxlength="240" value="{{address}}" data-field="address" bindinput="updateText" placeholder="请输入联系地址" placeholder-style="color:#A3A3A3;text-align:right" />
      </view>
    </view>

    <view class="mx-3 mt-5 flex items-center justify-between"><view class="text-[length:30rpx] font-semibold">组织信息</view><view class="text-[length:22rpx] text-muted">{{organizations.length}}/{{maxOrganizations}}</view></view>
    <view data-card-field-group="organization" class="mx-3 mt-3">
      <view wx:if="{{!organizations.length}}" class="rounded-[16rpx] border border-line bg-panel px-4 py-5 text-[length:23rpx] text-muted">暂未添加组织经历。</view>
      <view wx:for="{{organizations}}" wx:key="id" class="mt-3 rounded-[16rpx] border border-line bg-panel px-3 py-4">
        <view class="flex min-h-[64rpx] items-center justify-between gap-2">
          <view class="text-[length:24rpx] font-semibold">组织 {{index + 1}}</view>
          <view class="flex shrink-0 items-center gap-1">
            <button plain class="m-0 flex min-h-[88rpx] min-w-[88rpx] items-center justify-center px-2 text-[length:22rpx] text-muted disabled:opacity-40" disabled="{{index === 0}}" data-kind="organizations" data-index="{{index}}" data-direction="-1" bind:tap="moveExperience">上移</button>
            <button plain class="m-0 flex min-h-[88rpx] min-w-[88rpx] items-center justify-center px-2 text-[length:22rpx] text-muted disabled:opacity-40" disabled="{{index === organizations.length - 1}}" data-kind="organizations" data-index="{{index}}" data-direction="1" bind:tap="moveExperience">下移</button>
            <button plain class="m-0 flex min-h-[88rpx] min-w-[88rpx] items-center justify-center px-2 text-[length:22rpx] text-danger" data-kind="organizations" data-index="{{index}}" bind:tap="removeExperience">删除</button>
          </view>
        </view>
        <input aria-label="组织名称" data-card-field-row="organization" class="mt-2 block h-[88rpx] w-full max-w-full box-border rounded-[14rpx] bg-canvas px-4 text-[length:26rpx]" maxlength="120" value="{{item.name}}" data-kind="organizations" data-index="{{index}}" data-field="name" bindinput="updateExperience" placeholder="组织名称" placeholder-style="color:#A3A3A3" />
        <input aria-label="组织职位" data-card-field-row="organizationRole" class="mt-3 block h-[88rpx] w-full max-w-full box-border rounded-[14rpx] bg-canvas px-4 text-[length:26rpx]" maxlength="80" value="{{item.role}}" data-kind="organizations" data-index="{{index}}" data-field="role" bindinput="updateExperience" placeholder="组织职位" placeholder-style="color:#A3A3A3" />
      </view>
      <button plain class="mt-3 flex min-h-[88rpx] w-full max-w-full box-border items-center justify-center rounded-[14rpx] border border-line text-[length:24rpx] text-ink disabled:opacity-40" disabled="{{organizations.length >= maxOrganizations}}" data-kind="organizations" bind:tap="addExperience">添加组织经历</button>
    </view>
    <view wx:if="{{message}}" class="mx-3 mt-4 rounded-[16rpx] border border-line bg-panel-raised px-4 py-3 text-[length:23rpx] leading-6">{{message}}</view>
    <mip-sticky-actions><view slot="actions" class="w-full"><t-button block size="large" theme="primary" loading="{{saving}}" bind:tap="save">保存名片设置</t-button></view></mip-sticky-actions>
  </block>
  <app-page-exit />
</view>
