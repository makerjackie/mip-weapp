<view id="mip-game-team-page" class="min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-4 text-ink">
  <view wx:if="{{state === 'loading'}}" class="rounded-[16rpx] bg-panel px-4 py-6"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}"><app-empty-state title="暂时无法加载队伍" description="{{message}}" action-text="重新加载" bind:action="loadTeam" /></view>
  <block wx:else>
    <view class="text-[length:38rpx] font-bold">队伍大本营</view><view class="mt-2 text-[length:23rpx] text-muted">{{team.seasonName}}</view>
    <view class="headquarters headquarters-level-{{team.headquartersLevel.number}} mt-5 overflow-hidden rounded-[20rpx] px-5 py-6">
      <view class="text-[length:22rpx] opacity-70">{{team.headquartersLevel.label}}</view><view class="mt-2 text-[length:34rpx] font-bold">{{team.name}}</view><view class="mt-4 text-[length:23rpx]">赛季经验值 {{team.score}}</view><view wx:if="{{team.branchName}}" class="mt-2 text-[length:21rpx] opacity-70">{{team.branchName}}</view>
      <view class="headquarters-mark mt-6"><view></view><view></view><view></view><view></view></view>
    </view>
    <view wx:if="{{team.summary}}" class="mt-4 rounded-[16rpx] bg-panel px-4 py-4 text-[length:23rpx] leading-[1.65] text-muted">{{team.summary}}</view>
    <view class="mt-6 flex items-end justify-between"><view class="text-[length:30rpx] font-semibold">队伍成员</view><view class="text-[length:22rpx] text-muted">{{team.memberCount}} 人</view></view>
    <view wx:if="{{team.members.length}}" class="mt-3 overflow-hidden rounded-[16rpx] bg-panel"><view wx:for="{{team.members}}" wx:key="memberRef" class="flex min-h-[96rpx] items-center gap-3 border-b border-line px-4 py-3 last:border-b-0"><image wx:if="{{item.avatarUrl}}" class="h-[64rpx] w-[64rpx] rounded-full bg-panel-raised" mode="aspectFill" src="{{item.avatarUrl}}" /><view wx:else class="h-[64rpx] w-[64rpx] rounded-full bg-panel-raised"></view><view class="min-w-0 flex-1"><view class="truncate text-[length:25rpx]">{{item.nickname}}</view><view class="mt-1 text-[length:20rpx] text-muted">{{item.role === 'CAPTAIN' ? '队长' : '成员'}}</view></view></view></view>
    <view wx:else class="mt-3 rounded-[16rpx] bg-panel px-4 py-5 text-[length:23rpx] text-muted">暂无成员。</view>
    <view wx:if="{{team.formerMembers.length}}" class="mt-6 text-[length:30rpx] font-semibold">历史成员</view>
    <view wx:if="{{team.formerMembers.length}}" class="mt-3 overflow-hidden rounded-[16rpx] bg-panel"><view wx:for="{{team.formerMembers}}" wx:key="memberRef" class="flex min-h-[88rpx] items-center gap-3 border-b border-line px-4 py-3 last:border-b-0"><view class="min-w-0 flex-1"><view class="truncate text-[length:23rpx]">{{item.nickname}}</view><view class="mt-1 text-[length:19rpx] text-muted">{{item.role === 'CAPTAIN' ? '原队长' : '原成员'}} · {{item.joinedDateText}} 至 {{item.leftDateText}}</view></view></view></view>
  </block>
  <app-page-exit />
</view>
