<view id="mip-game-page" class="mip-member-page min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-4 text-ink">
  <view class="text-[length:38rpx] font-bold">团队 PK</view>
  <view class="mt-2 text-[length:23rpx] text-muted">查看赛季、每周对阵和排行榜</view>

  <view wx:if="{{state === 'loading'}}" class="mt-5 rounded-[16rpx] bg-panel px-4 py-6"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}" class="mt-5"><app-empty-state title="暂时无法加载赛季" description="{{message}}" action-text="重新加载" bind:action="load" /></view>
  <view wx:elif="{{state === 'empty'}}" class="mt-5"><app-empty-state title="暂无进行中的赛季" description="赛季发布后会显示在这里。" /></view>
  <block wx:else>
    <view class="mt-5 rounded-[18rpx] bg-panel px-4 py-5">
      <view class="flex items-start justify-between gap-3"><view><view class="text-[length:31rpx] font-semibold">{{overview.season.name}}</view><view class="mt-2 text-[length:22rpx] text-muted">{{seasonPeriodText}}</view></view><t-button size="small" variant="outline" bind:tap="toggleRules">赛季规则</t-button></view>
      <view wx:if="{{overview.season.summary}}" class="mt-3 text-[length:23rpx] leading-[1.65] text-muted">{{overview.season.summary}}</view>
      <view wx:if="{{rulesOpen}}" class="mt-4 whitespace-pre-wrap rounded-[12rpx] bg-panel-raised px-3 py-3 text-[length:23rpx] leading-[1.7] text-muted">{{overview.season.rulesText}}</view>
    </view>

    <view wx:if="{{overview.team}}" class="mt-4 rounded-[18rpx] border border-brand bg-panel px-4 py-4" aria-role="button" bind:tap="openTeam">
      <view class="flex items-center justify-between gap-3"><view><view class="text-[length:22rpx] text-muted">我的队伍</view><view class="mt-1 text-[length:29rpx] font-semibold">{{overview.team.name}}</view></view><view class="text-right"><view class="text-[length:22rpx] text-brand">{{overview.team.headquartersLevel.label}}</view><view class="mt-1 text-[length:20rpx] text-muted">{{overview.team.memberCount}} 名成员</view></view></view>
    </view>
    <view wx:else class="mt-4 rounded-[16rpx] bg-panel px-4 py-4 text-[length:23rpx] text-muted">当前赛季暂未加入队伍。</view>

    <view class="mt-6 flex items-end justify-between"><view><view class="text-[length:30rpx] font-semibold">每周对阵</view><view class="mt-1 text-[length:22rpx] text-muted">分数由经验值流水结算</view></view></view>
    <view wx:if="{{matches.length}}" class="mt-3 flex flex-col gap-3">
      <view wx:for="{{matches}}" wx:key="id" class="rounded-[16rpx] bg-panel px-4 py-4"><view class="text-[length:20rpx] text-muted">{{item.periodText}}</view><view class="mt-3 grid grid-cols-[1fr_auto_1fr] items-center gap-3"><view class="text-[length:25rpx] font-semibold">{{item.teamA.name}}</view><view class="rounded-full bg-panel-raised px-3 py-2 text-[length:22rpx] text-brand">{{item.resultText}}</view><view class="text-right text-[length:25rpx] font-semibold">{{item.teamB.name}}</view></view></view>
    </view>
    <view wx:else class="mt-3 rounded-[16rpx] bg-panel px-4 py-5 text-[length:23rpx] text-muted">暂无对阵记录。</view>

    <view class="mt-6 text-[length:30rpx] font-semibold">历史对阵</view>
    <view wx:if="{{history.length}}" class="mt-3 flex flex-col gap-2">
      <view wx:for="{{history}}" wx:key="id" class="flex min-h-[88rpx] items-center gap-3 rounded-[14rpx] bg-panel px-4 py-3"><view class="min-w-0 flex-1"><view class="truncate text-[length:23rpx]">{{item.teamA.name}} 对 {{item.teamB.name}}</view><view class="mt-1 text-[length:19rpx] text-muted">{{item.periodText}}</view></view><view class="text-[length:24rpx] font-semibold text-brand">{{item.resultText}}</view></view>
    </view>
    <view wx:else class="mt-3 rounded-[16rpx] bg-panel px-4 py-5 text-[length:23rpx] text-muted">暂无已结算的历史对阵。</view>

    <view class="mt-6 text-[length:30rpx] font-semibold">排行榜</view>
    <scroll-view scroll-x class="mt-3 whitespace-nowrap"><view class="inline-flex gap-2"><t-tag wx:for="{{rankingOptions}}" wx:key="key" id="game-ranking-{{item.key}}" variant="{{rankingType === item.key ? 'light' : 'outline'}}" theme="warning" data-type="{{item.key}}" bind:tap="changeRanking">{{item.label}}</t-tag></view></scroll-view>
    <scroll-view wx:if="{{branches.length}}" scroll-x class="mt-3 whitespace-nowrap"><view class="inline-flex gap-2"><t-tag variant="{{!branchId ? 'light' : 'outline'}}" data-id="" bind:tap="changeBranch">全部分会</t-tag><t-tag wx:for="{{branches}}" wx:key="id" variant="{{branchId === item.id ? 'light' : 'outline'}}" data-id="{{item.id}}" bind:tap="changeBranch">{{item.name}}</t-tag></view></scroll-view>
    <view wx:if="{{loadingRanking}}" class="mt-3 rounded-[16rpx] bg-panel px-4 py-5"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
    <view wx:elif="{{rankings.length}}" class="mt-3 overflow-hidden rounded-[16rpx] bg-panel">
      <view wx:for="{{rankings}}" wx:key="rank" class="flex min-h-[88rpx] items-center gap-3 border-b border-line px-4 py-3 last:border-b-0"><view class="w-[52rpx] text-center text-[length:25rpx] font-semibold text-brand">{{item.rank}}</view><view class="min-w-0 flex-1"><view class="truncate text-[length:25rpx]">{{item.displayName}}</view><view class="mt-1 text-[length:20rpx] text-muted">{{item.branchName || '未设置分会'}}<text wx:if="{{item.levelLabel}}"> · {{item.levelLabel}}</text></view></view><view class="text-[length:25rpx] font-semibold">{{item.score}}</view></view>
    </view>
    <view wx:else class="mt-3 rounded-[16rpx] bg-panel px-4 py-5 text-[length:23rpx] text-muted">排行榜尚未生成。</view>
    <view wx:if="{{message}}" class="mt-4 rounded-[12rpx] bg-panel px-4 py-3 text-[length:22rpx] text-danger">{{message}}</view>
  </block>
  <app-page-exit />
</view>
