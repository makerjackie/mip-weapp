/* Talent card per figma 1768_37534 (351x127 design px -> 702x254rpx):
   two stacked panels (86px top + 1px seam + 40px band). */
.mip-talent-card {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 254rpx;
  overflow: hidden;
  background: transparent;
}

.mip-talent-card__top {
  position: relative;
  height: 172rpx;
  background: var(--color-panel);
  border-radius: 16rpx 16rpx 0 0;
}

.mip-talent-card__bottom {
  position: relative;
  height: 80rpx;
  margin-top: 2rpx;
  background: var(--color-panel);
  border-radius: 0 0 16rpx 16rpx;
}

.mip-talent-card__avatar {
  position: absolute;
  top: 34rpx;
  left: 24rpx;
  width: 112rpx;
  height: 112rpx;
  background: var(--color-panel-raised);
  border-radius: 50%;
}

.mip-talent-card__avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--color-muted);
}

.mip-talent-card__name-row {
  position: absolute;
  top: 26rpx;
  right: 24rpx;
  left: 160rpx;
  display: flex;
  align-items: center;
  height: 40rpx;
}

.mip-talent-card__name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 44.8rpx;
  color: var(--color-ink);
  white-space: nowrap;
}

.mip-talent-card__level {
  box-sizing: border-box;
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  height: 32rpx;
  padding: 0 8rpx;
  margin-left: 8rpx;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 28rpx;
  color: var(--color-brand);
  background: var(--color-panel-raised);
  border: 1rpx solid var(--color-canvas);
  border-radius: 8rpx;
}

.mip-talent-card__badge {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  margin-left: 8rpx;
}

.mip-talent-card__badge--dot {
  background: var(--color-brand);
  border-radius: 50%;
}

.mip-talent-card__kind {
  flex: none;
  padding: 0 8rpx;
  margin-left: 8rpx;
  font-size: 20rpx;
  line-height: 32rpx;
  color: var(--color-brand);
  background: var(--color-brand-soft);
  border-radius: 8rpx;
}

.mip-talent-card__meta {
  position: absolute;
  top: 76rpx;
  right: 24rpx;
  left: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 24rpx;
  line-height: 33.6rpx;
  color: var(--color-muted);
  white-space: nowrap;
}

.mip-talent-card__supporting {
  position: absolute;
  top: 118rpx;
  right: 24rpx;
  left: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 20rpx;
  line-height: 28rpx;
  color: var(--color-muted);
  white-space: nowrap;
}

.mip-talent-card__roles {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.mip-talent-card__role-tag {
  position: relative;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  height: 32rpx;
  padding-right: 8rpx;
  padding-left: 40rpx;
  background: var(--color-brand);
  border: 1rpx solid var(--color-canvas);
  border-radius: 8rpx;
}

.mip-talent-card__role-tag--alt {
  background: var(--color-tag-player);
}

.mip-talent-card__role-tag--plain {
  padding-left: 8rpx;
}

.mip-talent-card__role-icon {
  position: absolute;
  top: 0;
  left: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  background: var(--color-panel);
  border: 1rpx solid var(--color-canvas);
  border-radius: 8rpx 0 0 8rpx;
}

.mip-talent-card__role-icon-image {
  width: 100%;
  height: 100%;
}

.mip-talent-card__role-label {
  font-size: 20rpx;
  font-weight: 500;
  line-height: 28rpx;
  color: var(--color-on-brand);
  white-space: nowrap;
}

.mip-talent-card__inviter {
  position: absolute;
  top: 16rpx;
  right: 24rpx;
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.mip-talent-card__inviter-name {
  max-width: 180rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 28rpx;
  color: var(--color-brand);
  text-align: right;
  white-space: nowrap;
}

.mip-talent-card__inviter-avatar {
  flex: none;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  box-shadow: 0 0 0 2rpx var(--color-ink);
}

.mip-talent-card__target {
  position: absolute;
  top: 16rpx;
  right: 24rpx;
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 20rpx;
  line-height: 28rpx;
  color: var(--color-brand);
  text-align: right;
  white-space: nowrap;
}

/* Grid 竖版嘉宾卡：figma 1818_17230/1732_19323（170x187 -> 双列 374rpx 高）。
   Lv/未读在左上角，corner 插槽留给页面自有事实（心动、×N、红心徽标），
   底部左勋章（≤3 枚佩戴口径）、右邀请人。 */
.mip-talent-card--grid {
  position: relative;
  display: flex;
  flex-direction: column;
  min-width: 0;
  min-height: 374rpx;
  padding: 16rpx 24rpx 16rpx;
  overflow: hidden;
  background: var(--color-panel);
  border-radius: 16rpx;
}

.mip-talent-card__lead {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  display: flex;
  gap: 8rpx;
  align-items: center;
}

.mip-talent-card__unread {
  flex: none;
  width: 16rpx;
  height: 16rpx;
  background: var(--color-danger);
  border-radius: 50%;
}

.mip-talent-card--grid .mip-talent-card__level {
  margin-left: 0;
}

.mip-talent-card__lead-label {
  box-sizing: border-box;
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  height: 32rpx;
  padding: 0 8rpx;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 28rpx;
  color: var(--color-brand);
  background: var(--color-panel-raised);
  border: 1rpx solid var(--color-canvas);
  border-radius: 8rpx;
}

.mip-talent-card__figure-avatar--ring {
  border: 3rpx solid var(--color-ink);
}

/* 活动参与人卡（figma 1818_17230）：meta/简介左对齐；嘉宾/心动/访客卡（1732_19323）居中。 */
.mip-talent-card--grid-left .mip-talent-card__figure-meta,
.mip-talent-card--grid-left .mip-talent-card__figure-supporting {
  text-align: left;
}

.mip-talent-card__corner {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: flex;
  justify-content: flex-end;
  pointer-events: none;
}

.mip-talent-card__figure {
  display: flex;
  flex: none;
  justify-content: center;
}

.mip-talent-card__figure-avatar {
  display: flex;
  width: 112rpx;
  height: 112rpx;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-brand);
  background: var(--color-brand-soft);
  border-radius: 50%;
}

.mip-talent-card__figure-name {
  margin-top: 16rpx;
  overflow: hidden;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 44.8rpx;
  color: var(--color-ink);
  text-align: center;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.mip-talent-card__figure-status {
  margin-top: 8rpx;
  overflow: hidden;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 34rpx;
  color: var(--color-ink);
  text-align: center;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.mip-talent-card__figure-meta {
  margin-top: 8rpx;
  display: -webkit-box;
  overflow: hidden;
  font-size: 20rpx;
  line-height: 28rpx;
  color: var(--color-ink);
  text-align: center;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.mip-talent-card__figure-supporting {
  margin-top: 8rpx;
  display: -webkit-box;
  overflow: hidden;
  font-size: 20rpx;
  line-height: 28rpx;
  color: var(--color-muted);
  text-align: center;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.mip-talent-card__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: auto;
  padding-top: 24rpx;
  min-height: 40rpx;
}

.mip-talent-card__medals {
  display: flex;
  flex: none;
  gap: 8rpx;
  align-items: center;
}

.mip-talent-card__medal {
  width: 40rpx;
  height: 40rpx;
}

/* 无图勋章的兜底圆点（与公开档案页勋章 fallback-dot 同口径），不伪造勋章图。 */
.mip-talent-card__medal--dot {
  background: var(--color-brand);
  border-radius: 50%;
}

.mip-talent-card__inviter--grid {
  position: static;
  gap: 8rpx;
  margin-left: auto;
}

.mip-talent-card__inviter--grid .mip-talent-card__inviter-name {
  max-width: 200rpx;
  color: var(--color-ink);
  text-align: left;
}

.mip-talent-card__inviter-avatar--grid {
  width: 40rpx;
  height: 40rpx;
  box-shadow: none;
}
