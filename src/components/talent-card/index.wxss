/* Talent card per figma 1768_37534 (MIW-58 字段重排)：上板 = 头像 + 名称 + Lv +
   ≤3 枚佩戴勋章 + 三标签行（城市 | 代表行业 | 身份状态，24rpx 灰）+ 一句话介绍（≤2 行）；
   下板 = 左角色黄色小标签 / 右邀请人（{昵称}邀请 黄字）。两板之间 2rpx 分缝。 */
.mip-talent-card {
  position: relative;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: transparent;
}

.mip-talent-card__top {
  box-sizing: border-box;
  display: flex;
  gap: 24rpx;
  min-height: 172rpx;
  padding: 24rpx;
  background: var(--color-panel);
  border-radius: 16rpx 16rpx 0 0;
}

.mip-talent-card__bottom {
  box-sizing: border-box;
  display: flex;
  gap: 16rpx;
  align-items: center;
  justify-content: space-between;
  min-height: 80rpx;
  padding: 16rpx 24rpx;
  margin-top: 2rpx;
  background: var(--color-panel);
  border-radius: 0 0 16rpx 16rpx;
}

.mip-talent-card__avatar {
  flex: none;
  width: 112rpx;
  height: 112rpx;
  background: var(--color-panel-raised);
  border-radius: 50%;
}

.mip-talent-card__avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--color-muted);
}

.mip-talent-card__body {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.mip-talent-card__name-row {
  display: flex;
  gap: 8rpx;
  align-items: center;
  min-height: 40rpx;
}

.mip-talent-card__name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 44.8rpx;
  color: var(--color-ink);
  white-space: nowrap;
}

.mip-talent-card__level {
  box-sizing: border-box;
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  height: 32rpx;
  padding: 0 8rpx;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 28rpx;
  color: var(--color-brand);
  background: var(--color-panel-raised);
  border: 1rpx solid var(--color-canvas);
  border-radius: 8rpx;
}

/* MIW-58 三标签行（1768_37534 最新稿）：城市 | 代表行业 | 身份状态，24rpx 灰、
   竖线分隔、单行左对齐、超宽省略。 */
.mip-talent-card__tags {
  display: flex;
  gap: 8rpx;
  align-items: center;
  min-width: 0;
  margin-top: 8rpx;
  overflow: hidden;
}

.mip-talent-card__tag {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 33.6rpx;
  color: var(--color-muted);
  white-space: nowrap;
}

.mip-talent-card__tag-divider {
  flex: none;
  width: 2rpx;
  height: 20rpx;
  background: var(--color-muted);
}

.mip-talent-card__meta {
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 24rpx;
  line-height: 33.6rpx;
  color: var(--color-muted);
  white-space: nowrap;
}

/* 一句话介绍：最多两行，超出省略（与竖版卡 supporting 同口径）。 */
.mip-talent-card__supporting {
  display: -webkit-box;
  margin-top: 8rpx;
  overflow: hidden;
  -webkit-line-clamp: 2;
  font-size: 20rpx;
  line-height: 28rpx;
  color: var(--color-muted);
  text-align: left;
  -webkit-box-orient: vertical;
}

.mip-talent-card__roles {
  display: flex;
  gap: 8rpx;
  min-width: 0;
  overflow: hidden;
}

.mip-talent-card__role-tag {
  box-sizing: border-box;
  display: flex;
  flex: none;
  align-items: center;
  height: 32rpx;
  padding: 0 8rpx;
  background: var(--color-tag-player);
  border-radius: 8rpx;
}

.mip-talent-card__role-label {
  font-size: 20rpx;
  font-weight: 500;
  line-height: 28rpx;
  color: var(--color-on-brand);
  white-space: nowrap;
}

.mip-talent-card__inviter {
  display: flex;
  flex: none;
  gap: 8rpx;
  align-items: center;
  margin-left: auto;
}

/* 横版邀请人（1768_37534）：{昵称}邀请 品牌黄 500；竖版 grid 覆盖回白色+「邀请人」前缀。 */
.mip-talent-card__inviter-name {
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 28rpx;
  color: var(--color-brand);
  text-align: right;
  white-space: nowrap;
}

.mip-talent-card__inviter-avatar {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
}

.mip-talent-card__target {
  position: absolute;
  top: 16rpx;
  right: 24rpx;
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 20rpx;
  line-height: 28rpx;
  color: var(--color-brand);
  text-align: right;
  white-space: nowrap;
}

/* Grid 竖版嘉宾卡：figma 1818_17230/1732_19323（170x187 -> 双列 374rpx 高）。
   Lv/未读在左上角，corner 插槽留给页面自有事实（心动、×N、红心徽标），
   底部左勋章（≤3 枚佩戴口径）、右邀请人。 */
.mip-talent-card--grid {
  position: relative;
  display: flex;
  flex-direction: column;
  min-width: 0;
  min-height: 374rpx;
  padding: 16rpx 24rpx;
  overflow: hidden;
  background: var(--color-panel);
  border-radius: 16rpx;
}

.mip-talent-card__lead {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  display: flex;
  gap: 8rpx;
  align-items: center;
}

.mip-talent-card__unread {
  flex: none;
  width: 16rpx;
  height: 16rpx;
  background: var(--color-danger);
  border-radius: 50%;
}

.mip-talent-card__lead-label {
  box-sizing: border-box;
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  height: 32rpx;
  padding: 0 8rpx;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 28rpx;
  color: var(--color-brand);
  background: var(--color-panel-raised);
  border: 1rpx solid var(--color-canvas);
  border-radius: 8rpx;
}

.mip-talent-card__figure-avatar--ring {
  border: 3rpx solid var(--color-ink);
}

/* 活动参与人卡（figma 1818_17230）：meta/简介左对齐；嘉宾/心动/访客卡（1732_19323）居中。 */
.mip-talent-card--grid-left .mip-talent-card__figure-meta,
.mip-talent-card--grid-left .mip-talent-card__figure-supporting {
  text-align: left;
}

/* 参与人卡走三标签行时同样左对齐（justify 覆盖，text-align 管不到 flex 子项）。 */
.mip-talent-card--grid-left .mip-talent-card__figure-tags {
  justify-content: flex-start;
}

.mip-talent-card__corner {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: flex;
  justify-content: flex-end;
  pointer-events: none;
}

.mip-talent-card__figure {
  display: flex;
  flex: none;
  justify-content: center;
}

.mip-talent-card__figure-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  overflow: hidden;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-brand);
  background: var(--color-brand-soft);
  border-radius: 50%;
}

.mip-talent-card__figure-name {
  margin-top: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 44.8rpx;
  color: var(--color-ink);
  text-align: center;
  white-space: nowrap;
}

.mip-talent-card__figure-status {
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 34rpx;
  color: var(--color-ink);
  text-align: center;
  white-space: nowrap;
}

/* MIW-52 统一三标签行：地区MIP | 代表行业 | 身份状态，竖线分隔、单行居中、超宽省略。
   gap 8rpx：双列卡内宽约 291rpx，三标签（20rpx 字号）+2 竖线需在此内放下。 */
.mip-talent-card__figure-tags {
  display: flex;
  gap: 8rpx;
  align-items: center;
  justify-content: center;
  min-width: 0;
  margin-top: 8rpx;
  overflow: hidden;
}

.mip-talent-card__figure-tag {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 20rpx;
  line-height: 28rpx;
  color: var(--color-ink);
  white-space: nowrap;
}

.mip-talent-card__figure-tag-divider {
  flex: none;
  width: 2rpx;
  height: 20rpx;
  background: var(--color-line);
}

.mip-talent-card__figure-meta {
  display: -webkit-box;
  margin-top: 8rpx;
  overflow: hidden;
  -webkit-line-clamp: 2;
  font-size: 20rpx;
  line-height: 28rpx;
  color: var(--color-ink);
  text-align: center;
  -webkit-box-orient: vertical;
}

.mip-talent-card__figure-supporting {
  display: -webkit-box;
  margin-top: 8rpx;
  overflow: hidden;
  -webkit-line-clamp: 2;
  font-size: 20rpx;
  line-height: 28rpx;
  color: var(--color-muted);
  text-align: center;
  -webkit-box-orient: vertical;
}

.mip-talent-card__foot {
  display: flex;
  gap: 16rpx;
  align-items: center;
  justify-content: space-between;
  min-height: 40rpx;
  padding-top: 24rpx;
  margin-top: auto;
}

.mip-talent-card__medals {
  display: flex;
  flex: none;
  gap: 8rpx;
  align-items: center;
}

.mip-talent-card__medal {
  width: 40rpx;
  height: 40rpx;
}

/* 无图勋章的兜底圆点（与公开档案页勋章 fallback-dot 同口径），不伪造勋章图。 */
.mip-talent-card__medal--dot {
  background: var(--color-brand);
  border-radius: 50%;
}

.mip-talent-card__inviter--grid {
  position: static;
  gap: 8rpx;
  margin-left: auto;
}

.mip-talent-card__inviter--grid .mip-talent-card__inviter-name {
  max-width: 200rpx;
  color: var(--color-ink);
  text-align: left;
}

.mip-talent-card__inviter-avatar--grid {
  width: 40rpx;
  height: 40rpx;
  box-shadow: none;
}
