<view wx:if="{{layout === 'grid'}}" class="mip-talent-card mip-talent-card--grid {{leftAlignBody ? 'mip-talent-card--grid-left' : ''}}" aria-label="{{displayName}}">
  <view class="mip-talent-card__lead">
    <view wx:if="{{unread}}" class="mip-talent-card__unread" aria-label="未读" />
    <view wx:if="{{levelText}}" class="mip-talent-card__level">{{levelText}}</view>
    <view wx:if="{{leadLabel}}" class="mip-talent-card__lead-label">{{leadLabel}}</view>
  </view>
  <view class="mip-talent-card__corner"><slot name="corner" /></view>
  <view class="mip-talent-card__figure">
    <image wx:if="{{avatarUrl}}" class="mip-talent-card__figure-avatar {{avatarRing ? 'mip-talent-card__figure-avatar--ring' : ''}}" src="{{avatarUrl}}" mode="aspectFill" />
    <view wx:else class="mip-talent-card__figure-avatar mip-talent-card__figure-avatar--empty {{avatarRing ? 'mip-talent-card__figure-avatar--ring' : ''}}">{{displayName[0] || 'M'}}</view>
  </view>
  <view class="mip-talent-card__figure-name">{{displayName}}</view>
  <view wx:if="{{statusText}}" class="mip-talent-card__figure-status">{{statusText}}</view>
  <!-- MIW-52 统一三标签行（地区MIP | 代表行业 | 身份状态）；未传 tags 回退旧 metaText。 -->
  <view wx:if="{{displayTags.length}}" class="mip-talent-card__figure-tags">
    <block wx:for="{{displayTags}}" wx:key="*this">
      <view wx:if="{{index > 0}}" class="mip-talent-card__figure-tag-divider" aria-hidden="true" />
      <text class="mip-talent-card__figure-tag">{{item}}</text>
    </block>
  </view>
  <view wx:elif="{{metaText}}" class="mip-talent-card__figure-meta">{{metaText}}</view>
  <view wx:if="{{supportingText}}" class="mip-talent-card__figure-supporting">{{supportingText}}</view>
  <slot name="body" />
  <view class="mip-talent-card__foot">
    <view wx:if="{{displayMedals.length}}" class="mip-talent-card__medals">
      <block wx:for="{{displayMedals}}" wx:key="id">
        <image wx:if="{{item.imageUrl}}" class="mip-talent-card__medal" src="{{item.imageUrl}}" mode="aspectFit" />
        <view wx:else class="mip-talent-card__medal mip-talent-card__medal--dot" aria-label="{{item.id}}" />
      </block>
    </view>
    <!-- MIW-52 右下角可配置：footRightMode="custom" 渲染 foot-right 插槽（NPC 任务分配勾选态预留），
         默认 'inviter' 保持邀请人/targetText 行为。 -->
    <block wx:if="{{footRightMode === 'custom'}}">
      <slot name="foot-right" />
    </block>
    <view wx:elif="{{inviter.name}}" class="mip-talent-card__inviter mip-talent-card__inviter--grid">
      <text class="mip-talent-card__inviter-name">邀请人{{inviter.name}}</text>
      <image wx:if="{{inviter.avatarUrl}}" class="mip-talent-card__inviter-avatar mip-talent-card__inviter-avatar--grid" src="{{inviter.avatarUrl}}" mode="aspectFill" />
    </view>
    <view wx:elif="{{targetText}}" class="mip-talent-card__target">{{targetText}}</view>
  </view>
</view>
<!-- MIW-58 横版人才合作卡（figma 1768_37534 字段重排）：上板 = 头像 + 名称（单行省略）
     + Lv 等级 + 最多 3 枚佩戴勋章 + 三标签行（城市 | 代表行业 | 身份状态，24rpx 灰、竖线分隔）
     + 一句话介绍（最多两行省略）；下板 = 左 6 大角色黄色小标签 / 右邀请人
     （{昵称}邀请 黄字 + 头像，玩家/平台判定在服务端，同一样式）。 -->
<view wx:else class="mip-talent-card" aria-label="{{displayName}}">
  <view class="mip-talent-card__top">
    <image wx:if="{{avatarUrl}}" class="mip-talent-card__avatar" src="{{avatarUrl}}" mode="aspectFill" />
    <view wx:else class="mip-talent-card__avatar mip-talent-card__avatar-placeholder">MIP</view>
    <view class="mip-talent-card__body">
      <view class="mip-talent-card__name-row">
        <view class="mip-talent-card__name">{{displayName}}</view>
        <view wx:if="{{levelText}}" class="mip-talent-card__level">{{levelText}}</view>
        <view wx:if="{{displayMedals.length}}" class="mip-talent-card__medals">
          <block wx:for="{{displayMedals}}" wx:key="id">
            <image wx:if="{{item.imageUrl}}" class="mip-talent-card__medal" src="{{item.imageUrl}}" mode="aspectFit" />
            <view wx:else class="mip-talent-card__medal mip-talent-card__medal--dot" aria-label="{{item.id}}" />
          </block>
        </view>
      </view>
      <view wx:if="{{displayTags.length}}" class="mip-talent-card__tags">
        <block wx:for="{{displayTags}}" wx:key="*this">
          <view wx:if="{{index > 0}}" class="mip-talent-card__tag-divider" aria-hidden="true" />
          <text class="mip-talent-card__tag">{{item}}</text>
        </block>
      </view>
      <view wx:elif="{{metaText}}" class="mip-talent-card__meta">{{metaText}}</view>
      <view wx:if="{{supportingText}}" class="mip-talent-card__supporting">{{supportingText}}</view>
    </view>
  </view>
  <view class="mip-talent-card__bottom">
    <view wx:if="{{roleNames.length}}" class="mip-talent-card__roles">
      <view wx:for="{{roleNames}}" wx:key="*this" class="mip-talent-card__role-tag"><text class="mip-talent-card__role-label">{{item}}</text></view>
    </view>
    <view wx:if="{{inviter.name}}" class="mip-talent-card__inviter">
      <text class="mip-talent-card__inviter-name">{{inviter.name}}邀请</text>
      <image wx:if="{{inviter.avatarUrl}}" class="mip-talent-card__inviter-avatar" src="{{inviter.avatarUrl}}" mode="aspectFill" />
    </view>
  </view>
</view>
