<view wx:if="{{available}}" class="mt-4 rounded-[16rpx] bg-panel px-4 py-4">
  <view class="text-[length:24rpx] text-muted">{{description}}</view>
  <view class="mt-3"><t-button block variant="outline" loading="{{requesting}}" disabled="{{granted}}" bind:tap="request">{{granted ? '本次提醒已开启' : label}}</t-button></view>
  <view wx:if="{{message}}" class="mt-2 text-[length:24rpx] text-muted">{{message}}</view>
</view>
