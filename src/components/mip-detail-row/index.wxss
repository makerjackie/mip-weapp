.mip-detail-row {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 92rpx;
  padding: 20rpx 20rpx 20rpx 24rpx;
  background: var(--mip-bg-surface);
}

.mip-detail-row__label {
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 40rpx;
  color: var(--mip-text-primary);
  white-space: nowrap;
}

.mip-detail-row__trailing {
  display: flex;
  flex: 1 1 auto;
  gap: 12rpx;
  align-items: center;
  justify-content: flex-end;
  min-width: 0;
  margin-left: 16rpx;
}

.mip-detail-row__value {
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 34rpx;
  color: var(--mip-text-secondary);
  text-align: right;
  white-space: nowrap;
}

.mip-detail-row__chevron {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  transform: rotate(1.6deg);
}
