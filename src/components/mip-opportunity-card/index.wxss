.mip-opportunity-card {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  height: 352rpx;
  padding: 16rpx;
  overflow: hidden;
  color: var(--color-ink);
  background: var(--color-panel);
  border-radius: var(--mip-radius-card);
}

.mip-opportunity-card__cover {
  display: flex;
  flex: 0 0 240rpx;
  align-items: center;
  justify-content: center;
  height: 320rpx;
  overflow: hidden;
  background: var(--color-panel-raised);
  border-radius: var(--mip-radius-control);
}

.mip-opportunity-card__cover-image,
.mip-opportunity-card__cover-placeholder {
  width: 240rpx;
  height: 320rpx;
}

.mip-opportunity-card__cover-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-brand-soft);
}

.mip-opportunity-card__cover-placeholder-image {
  width: 100%;
  height: 100%;
}

.mip-opportunity-card__content {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  padding: 8rpx 0 8rpx 16rpx;
}

.mip-opportunity-card__title {
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 44rpx;
  white-space: nowrap;
}

.mip-opportunity-card__facts {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 16rpx;
}

.mip-opportunity-card__fact {
  display: flex;
  gap: 8rpx;
  align-items: center;
  min-width: 0;
  font-size: 24rpx;
  line-height: 34rpx;
}

.mip-opportunity-card__icon {
  flex: 0 0 32rpx;
  width: 32rpx;
  height: 32rpx;
}

.mip-opportunity-card__fact-text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mip-opportunity-card__footer {
  display: flex;
  justify-content: flex-end;
  margin-top: auto;
}

/* journey-review J3-01：机会类型黄标占左下、想合作聚合胶囊退到右下。 */
.mip-opportunity-card__footer--split {
  justify-content: space-between;
}

.mip-opportunity-card__type-tags {
  display: flex;
  gap: 8rpx;
  min-width: 0;
  overflow: hidden;
}

/* 46x20 设计像素黄标：#fcdf03 底、10px 黑字、r4 圆角。 */
.mip-opportunity-card__type-tag {
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 12rpx;
  font-size: 20rpx;
  line-height: 28rpx;
  color: var(--color-on-brand);
  white-space: nowrap;
  background: var(--color-brand);
  border-radius: 8rpx;
}

.mip-opportunity-card__published {
  margin-top: auto;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 22rpx;
  line-height: 30rpx;
  color: var(--color-muted);
  text-align: right;
  white-space: nowrap;
}

.mip-opportunity-card__published + .mip-opportunity-card__footer {
  margin-top: 8rpx;
}
