.mip-opportunity-card {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  height: 352rpx;
  padding: 16rpx;
  overflow: hidden;
  color: var(--color-ink);
  background: var(--color-panel);

  /* MIW-55 figma 3675:6828 卡片 r=8px（16rpx），原 --mip-radius-card 32rpx 偏大。 */
  border-radius: var(--mip-radius-card-small);
}

.mip-opportunity-card__cover {
  display: flex;
  flex: 0 0 240rpx;
  align-items: center;
  justify-content: center;
  height: 320rpx;
  overflow: hidden;
  background: var(--color-panel-raised);

  /* figma 封面 r=4px（8rpx）。 */
  border-radius: 8rpx;
}

.mip-opportunity-card__cover-image,
.mip-opportunity-card__cover-placeholder {
  width: 240rpx;
  height: 320rpx;
}

.mip-opportunity-card__cover-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-brand-soft);
}

.mip-opportunity-card__cover-placeholder-image {
  width: 100%;
  height: 100%;
}

.mip-opportunity-card__content {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  padding: 8rpx 0 8rpx 16rpx;
}

.mip-opportunity-card__title {
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 44rpx;
  white-space: nowrap;
}

.mip-opportunity-card__facts {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 16rpx;
}

.mip-opportunity-card__fact {
  display: flex;
  gap: 8rpx;
  align-items: center;
  min-width: 0;
  font-size: 24rpx;
  line-height: 34rpx;
}

.mip-opportunity-card__icon {
  flex: 0 0 32rpx;
  width: 32rpx;
  height: 32rpx;
}

.mip-opportunity-card__fact-text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* MIW-55 figma 3675:6828 底行垂直居中对齐：黄标在左，聚合胶囊由 __pill 推到右。 */
.mip-opportunity-card__footer {
  display: flex;
  gap: 16rpx;
  align-items: center;
  margin-top: auto;
}

.mip-opportunity-card__type-tags {
  display: flex;
  gap: 8rpx;
  min-width: 0;
  overflow: hidden;
}

/* 46x20 设计像素黄标：#fcdf03 底、10px 黑字 500、r4 圆角、左右 8px 内边距。 */
.mip-opportunity-card__type-tag {
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 16rpx;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 28rpx;
  color: var(--color-on-brand);
  white-space: nowrap;
  background: var(--color-brand);
  border-radius: 8rpx;
}

.mip-opportunity-card__pill {
  display: flex;
  margin-left: auto;
}

.mip-opportunity-card__published {
  margin-top: auto;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 22rpx;
  line-height: 30rpx;
  color: var(--color-muted);
  text-align: right;
  white-space: nowrap;
}

.mip-opportunity-card__published + .mip-opportunity-card__footer {
  margin-top: 8rpx;
}

/* J3-09 / J4-05: detail has four fact rows and puts publication time beside
   the type tags. Cooperation counts already have their own bottom action. */
.mip-opportunity-card--detail {
  height: auto;
  min-height: 352rpx;
}

.mip-opportunity-card--detail .mip-opportunity-card__footer {
  flex-wrap: wrap;
  gap: 8rpx;
  align-items: center;
  padding-top: 8rpx;
}

.mip-opportunity-card--detail .mip-opportunity-card__type-tags {
  flex-shrink: 0;
  flex-wrap: wrap;
}

.mip-opportunity-card__detail-published {
  flex: 1;
  min-width: 240rpx;
  font-size: 20rpx;
  line-height: 28rpx;
  color: var(--color-muted);
  text-align: right;
}

/* MIW-55 figma 3675:7012 下架卡：封面置灰、信息图标由品牌黄转 #b3b3b3、
   类型黄标与城市行不渲染、聚合胶囊灰底（见 attend-pill --gray）。 */
.mip-opportunity-card--offline .mip-opportunity-card__cover-image,
.mip-opportunity-card--offline .mip-opportunity-card__cover-placeholder-image {
  filter: grayscale(1);
}

.mip-opportunity-card--offline .mip-opportunity-card__icon {
  filter: grayscale(1) brightness(0.84);
}
