<view class="mip-opportunity-card" aria-label="{{title}}">
  <view class="mip-opportunity-card__cover">
    <image wx:if="{{displayCoverUrl}}" class="mip-opportunity-card__cover-image" src="{{displayCoverUrl}}" mode="aspectFill" />
    <view wx:else class="mip-opportunity-card__cover-placeholder"><image class="mip-opportunity-card__cover-placeholder-image" src="{{fallbackCoverUrl}}" mode="aspectFit" /></view>
  </view>
  <view class="mip-opportunity-card__content">
    <view class="mip-opportunity-card__title">{{title}}</view>
    <view class="mip-opportunity-card__facts">
      <view class="mip-opportunity-card__fact"><image class="mip-opportunity-card__icon" src="/assets/figma/opportunities/money-cny-circle.svg" mode="aspectFit" /><text class="mip-opportunity-card__fact-text">价值：{{valueText}}</text></view>
      <view wx:if="{{cityText}}" class="mip-opportunity-card__fact"><image class="mip-opportunity-card__icon" src="/assets/figma/opportunities/location.svg" mode="aspectFit" /><text class="mip-opportunity-card__fact-text">城市：{{cityText}}</text></view>
      <view class="mip-opportunity-card__fact"><image class="mip-opportunity-card__icon" src="/assets/figma/opportunities/location.svg" mode="aspectFit" /><text class="mip-opportunity-card__fact-text">地区：{{locationText}}</text></view>
      <view class="mip-opportunity-card__fact"><image class="mip-opportunity-card__icon" src="/assets/figma/opportunities/service-target.svg" mode="aspectFit" /><text class="mip-opportunity-card__fact-text">寻找：{{targetText}}</text></view>
    </view>
    <view wx:if="{{publishedText}}" class="mip-opportunity-card__published">{{publishedPrefix}}{{publishedText}}</view>
    <view class="mip-opportunity-card__footer {{typeTags.length ? 'mip-opportunity-card__footer--split' : ''}}">
      <view wx:if="{{typeTags.length}}" class="mip-opportunity-card__type-tags">
        <text wx:for="{{typeTags}}" wx:key="key" class="mip-opportunity-card__type-tag">{{item.label}}</text>
      </view>
      <mip-attend-pill
        count="{{referralCount}}"
        label="{{pillLabel}}"
        avatars="{{displayAvatars}}"
        variant="yellow"
      />
    </view>
  </view>
</view>
