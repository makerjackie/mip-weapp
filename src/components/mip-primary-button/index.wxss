.mip-primary-button {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 112rpx;
  background:
    linear-gradient(rgb(255 255 255 / 12%), rgb(255 255 255 / 12%)),
    rgb(255 221 2 / 10%);
  border: 1rpx solid rgb(255 255 255 / 7%);
  border-radius: 100rpx;
  box-shadow:
    inset 0 0 0 1rpx rgb(255 255 255 / 7%),
    inset 0 2rpx 3rpx rgb(255 255 255 / 10%);
}

.mip-primary-button__core {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 654rpx;
  height: 80rpx;
  padding: 0;
  margin: 0;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 44.8rpx;
  color: var(--mip-text-on-brand);
  background: var(--mip-brand);
  border: 1rpx solid #080808;
  border-radius: 100rpx;
}

.mip-primary-button__core[disabled] {
  color: var(--mip-text-on-brand);
  background: var(--mip-brand);
  opacity: 0.4;
}
