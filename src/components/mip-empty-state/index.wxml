<view class="mip-radius-card border border-line bg-panel px-6 py-10 text-center" aria-role="group">
  <view aria-role="status" aria-live="polite" aria-atomic="true" aria-label="{{description ? title + '。' + description : title}}">
    <view class="text-[length:30rpx] font-semibold text-ink">{{title}}</view>
    <view wx:if="{{description}}" class="mx-auto mt-3 max-w-[560rpx] text-[length:24rpx] leading-6 text-muted">{{description}}</view>
  </view>
  <view wx:if="{{actionText}}" class="mt-6 active:opacity-70">
    <t-button size="large" theme="primary" variant="outline" bind:tap="handleAction">{{actionText}}</t-button>
  </view>
</view>
