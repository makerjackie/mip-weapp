.mip-nav-bar {
  position: relative;
  z-index: 20;
  width: 100%;
}

.mip-nav-bar--absolute {
  position: absolute;
  top: 0;
  left: 0;
}

.mip-nav-bar__status {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 94rpx;
  padding: 0 48rpx;
}

.mip-nav-bar__time {
  font-family: var(--mip-font-number);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 40rpx;
  color: var(--mip-text-primary);
}

.mip-nav-bar__status-icons {
  display: flex;
  gap: 10rpx;
  align-items: center;
}

.mip-nav-bar__signal {
  width: 34rpx;
  height: 22rpx;
  background: var(--mip-text-primary);
  border-radius: 4rpx;
}

.mip-nav-bar__wifi {
  width: 30rpx;
  height: 22rpx;
  background: var(--mip-text-primary);
  border-radius: 4rpx;
}

.mip-nav-bar__battery {
  width: 46rpx;
  height: 24rpx;
  border: 2rpx solid rgb(255 255 255 / 45%);
  border-radius: 7rpx;
}

.mip-nav-bar__bar {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  height: 82rpx;
}

.mip-nav-bar__back {
  position: absolute;
  top: 18rpx;
  left: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
}

.mip-nav-bar__title {
  position: absolute;
  top: 16rpx;
  left: 196rpx;
  width: 358rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 44rpx;
  color: var(--mip-text-primary);
  text-align: center;
  white-space: nowrap;
}

.mip-nav-bar__capsule {
  position: absolute;
  top: 8rpx;
  left: 570rpx;
  box-sizing: border-box;
  width: 174rpx;
  height: 48rpx;
  background: rgb(255 255 255 / 8%);
  border: 1rpx solid rgb(255 255 255 / 18%);
  border-radius: 100rpx;
}

.mip-nav-bar__capsule-dot {
  position: absolute;
  top: 11rpx;
  left: 36rpx;
  width: 26rpx;
  height: 26rpx;
  background: rgb(255 255 255 / 82%);
  border-radius: 50%;
}

.mip-nav-bar__capsule-line {
  position: absolute;
  top: 23rpx;
  left: 82rpx;
  width: 56rpx;
  height: 2rpx;
  background: rgb(255 255 255 / 82%);
}
