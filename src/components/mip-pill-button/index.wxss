.mip-pill-button {
  box-sizing: border-box;
  display: inline-flex;
  gap: 16rpx;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 80rpx;
  padding: 0 32rpx;
  border: 1rpx solid #080808;
  border-radius: 100rpx;
}

.mip-pill-button--primary {
  background: var(--mip-brand);
}

.mip-pill-button--secondary {
  background: var(--mip-bg-surface);
}

/* Native-button root (open-type): strip WeChat defaults so the pill styles read as-is. */
.mip-pill-button--native {
  margin: 0;
  line-height: 1.4;
}

.mip-pill-button--native::after {
  border: none;
}

.mip-pill-button__icon {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
}

.mip-pill-button--primary .mip-pill-button__label {
  color: var(--mip-text-on-brand);
}

.mip-pill-button--secondary .mip-pill-button__label {
  color: var(--mip-brand);
}

.mip-pill-button__label {
  /* 窄胶囊（176rpx 编辑/分享）去掉左右 padding 后内容仍放不下，label 一旦可换行
     就会把「编辑」竖排（MIW-50）。图标与文字整体不收缩，居中溢出 padding 即可。 */
  flex-shrink: 0;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 44.8rpx;
  white-space: nowrap;
}

/* MIW-64 figma 3828:27052：disabled/loading 不再是黄底降透明（观感「暗黄」），
   而是设计稿里「不可用」的固定表达：灰底 #B3B3B3 + 深灰字 #4C4C4C。
   置于文件末尾以覆盖上方 primary/secondary 的底色与字色（同特异性后者胜）。 */
.mip-pill-button--disabled {
  background: var(--mip-text-secondary);
}

.mip-pill-button--disabled .mip-pill-button__label {
  color: #4c4c4c;
}
