<!-- F1（审计 2026-10-09）：根节点必须 catch:tap——绑定 tap 的同时原生 tap 继续冒泡、
     穿越组件边界再次命中宿主，页面 handler 一次点按执行两次（无闩锁的快速路径
     开/关相互抵消）。catch 挡掉冒泡只留 triggerEvent，所有绑定点单触发；
     open-type 分支的原生能力（share 等）由 open-type 属性承载，不受 catch:tap 影响。 -->
<button
  wx:if="{{openType}}"
  class="mip-pill-button mip-pill-button--{{variant}} mip-pill-button--native {{disabled || loading ? 'mip-pill-button--disabled' : ''}}"
  open-type="{{openType}}"
  disabled="{{disabled || loading}}"
  aria-role="button"
  aria-disabled="{{disabled || loading}}"
  catch:tap="handleTap"
>
  <view wx:if="{{withIcon}}" class="mip-pill-button__icon">
    <slot name="icon" />
  </view>
  <text class="mip-pill-button__label">{{label}}</text>
</button>
<view
  wx:else
  class="mip-pill-button mip-pill-button--{{variant}} {{disabled || loading ? 'mip-pill-button--disabled' : ''}}"
  aria-role="button"
  aria-disabled="{{disabled || loading}}"
  catch:tap="handleTap"
>
  <view wx:if="{{withIcon}}" class="mip-pill-button__icon">
    <slot name="icon" />
  </view>
  <text class="mip-pill-button__label">{{label}}</text>
</view>
