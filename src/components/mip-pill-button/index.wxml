<button
  wx:if="{{openType}}"
  class="mip-pill-button mip-pill-button--{{variant}} mip-pill-button--native {{disabled || loading ? 'mip-pill-button--disabled' : ''}}"
  open-type="{{openType}}"
  disabled="{{disabled || loading}}"
  aria-role="button"
  aria-disabled="{{disabled || loading}}"
  bind:tap="handleTap"
>
  <view wx:if="{{withIcon}}" class="mip-pill-button__icon">
    <slot name="icon" />
  </view>
  <text class="mip-pill-button__label">{{label}}</text>
</button>
<view
  wx:else
  class="mip-pill-button mip-pill-button--{{variant}} {{disabled || loading ? 'mip-pill-button--disabled' : ''}}"
  aria-role="button"
  aria-disabled="{{disabled || loading}}"
  bind:tap="handleTap"
>
  <view wx:if="{{withIcon}}" class="mip-pill-button__icon">
    <slot name="icon" />
  </view>
  <text class="mip-pill-button__label">{{label}}</text>
</view>
