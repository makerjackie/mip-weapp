<view wx:if="{{variant === 'feed'}}" class="event-card event-card--feed mip-radius-card overflow-hidden bg-panel">
  <view class="relative h-[298rpx] w-full active:opacity-80" bind:tap="handleSelect">
    <image wx:if="{{event.coverUrl}}" class="h-full w-full bg-brand-soft" mode="aspectFill" src="{{event.coverUrl}}" />
    <view wx:else class="flex h-full w-full items-center justify-center bg-brand-soft"><t-icon name="calendar" size="70rpx" color="var(--color-brand)" /></view>
    <event-participant-preview class="absolute bottom-2 left-2" participants="{{event.participantPreview}}" count="{{event.registrationCount}}" count-text="{{event.countText}}" plus-label="{{event.plusLabel}}" remain-text="{{event.remainText}}" />
    <view class="absolute bottom-2 right-2 flex max-w-[60%] flex-wrap justify-end gap-1">
      <mip-order-tag wx:if="{{event.accessLabel}}" label="{{event.accessLabel}}" />
      <mip-order-tag wx:if="{{event.eventTypeLabel}}" label="{{event.eventTypeLabel}}" />
      <mip-order-tag wx:if="{{event.statusLabel}}" label="{{event.statusLabel}}" bg="var(--color-brand-soft)" border="transparent" color="var(--color-brand)" />
    </view>
  </view>
  <view class="relative px-3 pb-[22rpx] pt-2">
    <view class="line-clamp-1 text-[length:32rpx] font-medium leading-[44.8rpx]">{{event.title}}</view>
    <view class="mt-2 flex h-[36rpx] items-center gap-1 text-[length:24rpx] leading-[33.6rpx] text-ink"><t-icon name="calendar" size="32rpx" color="var(--color-brand)" /><text>{{event.startsText}}</text></view>
    <view class="mt-1 flex h-[36rpx] items-center gap-1 text-[length:24rpx] leading-[33.6rpx] text-ink"><t-icon name="location" size="32rpx" color="var(--color-brand)" /><text class="line-clamp-1">{{event.locationText}}</text></view>
    <button wx:if="{{showShare}}" open-type="share" class="absolute bottom-0 right-0 m-0 flex h-[88rpx] w-[88rpx] items-center justify-center border-0 bg-transparent p-0 leading-none after:border-0" aria-label="分享活动" data-event-id="{{event.id}}" catch:tap="handleShare"><view class="flex h-[56rpx] w-[56rpx] items-center justify-center rounded-full bg-brand"><t-icon name="share" size="30rpx" color="var(--color-on-brand)" /></view></button>
  </view>
</view>
<view wx:elif="{{compact}}" class="mip-radius-card-medium flex h-[210rpx] overflow-hidden border border-line bg-panel active:bg-panel-muted" bind:tap="handleSelect">
  <image wx:if="{{event.coverUrl}}" class="h-[210rpx] w-[210rpx] shrink-0 bg-brand-soft" mode="aspectFill" src="{{event.coverUrl}}" />
  <view wx:else class="flex h-[210rpx] w-[210rpx] shrink-0 items-center justify-center bg-brand-soft"><t-icon name="calendar-event" size="54rpx" color="var(--color-brand)" /></view>
  <view class="flex min-w-0 flex-1 flex-col px-4 py-3">
    <view class="flex items-center justify-between gap-2">
      <view class="truncate text-[length:22rpx] font-semibold text-accent">{{event.startsText}}</view>
      <view wx:if="{{event.statusText}}" class="shrink-0 rounded-full bg-brand-soft px-2 py-1 text-[length:17rpx] font-semibold text-brand">{{event.statusText}}</view>
    </view>
    <view class="mt-2 line-clamp-2 text-[length:26rpx] font-bold leading-6">{{event.title}}</view>
    <view class="mt-2 truncate text-[length:22rpx] text-muted">{{event.location || '地点待定'}}</view>
    <view class="mt-auto flex items-center justify-between gap-2">
      <view class="truncate text-[length:22rpx] text-muted">{{event.availabilityText}}</view>
      <view wx:if="{{event.priceText}}" class="shrink-0 text-[length:22rpx] font-semibold text-brand">{{event.priceText}}</view>
    </view>
  </view>
</view>
<view wx:else class="mip-radius-card overflow-hidden bg-panel shadow-[0_8rpx_32rpx_rgba(29,42,35,0.06)]">
  <view class="active:opacity-80" bind:tap="handleSelect">
    <image wx:if="{{event.coverUrl}}" class="h-[280rpx] w-full bg-brand-soft" mode="aspectFill" src="{{event.coverUrl}}" />
    <view class="px-4 py-4">
      <view class="flex items-start justify-between gap-4">
        <view class="min-w-0 flex-1">
          <view class="text-[length:22rpx] font-semibold text-accent">{{event.startsText}}</view>
          <view class="mt-1 line-clamp-2 text-[length:30rpx] font-bold">{{event.title}}</view>
          <view class="mt-2 text-[length:22rpx] text-muted">{{event.location}} · {{event.availabilityText}}</view>
        </view>
        <view wx:if="{{event.priceText}}" class="rounded-full bg-brand-soft px-3 py-2 text-[length:22rpx] font-semibold text-brand">{{event.priceText}}</view>
      </view>
    </view>
  </view>
  <view wx:if="{{showAction}}" class="px-4 pb-4 active:opacity-70">
    <t-button
      block
      theme="primary"
      variant="outline"
      disabled="{{event.action === 'registered' || event.action === 'payment' || event.action === 'full' || event.action === 'closed'}}"
      loading="{{actionLoading}}"
      catch:tap="handleAction"
    >{{event.actionLabel}}</t-button>
  </view>
</view>
