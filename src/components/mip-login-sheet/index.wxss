/* journey-review login-sheet：#202020 底部弹层，16px 顶角，10/24/40 padding，
   44px 品牌行 + 16px 标题 + 12px 说明 + 40px 黄色胶囊按钮 + 12px 幽灵取消。 */
.mip-login-sheet__scrim {
  position: fixed;
  inset: 0;

  /* Modal layer: above the custom TabBar (9999), matching the dialog layer. */
  z-index: 11000;
  background: rgb(8 8 8 / 60%);
}

.mip-login-sheet {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 11001;
  box-sizing: border-box;
  padding: 20rpx 48rpx calc(env(safe-area-inset-bottom) + 80rpx);
  text-align: center;
  background: var(--color-panel, #202020);
  border-radius: 32rpx 32rpx 0 0;
}

.mip-login-sheet__grab {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 28rpx;
  background: #333;
  border-radius: 100rpx;
}

.mip-login-sheet__brand {
  display: flex;
  gap: 20rpx;
  align-items: center;
  justify-content: center;
  margin: 4rpx 0 28rpx;
}

.mip-login-sheet__logo {
  width: 88rpx;
  height: 88rpx;
  background: var(--color-brand-soft, #4d4400);
  border-radius: 24rpx;
}

.mip-login-sheet__title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 44.8rpx;
  color: var(--color-ink, #fff);
}

.mip-login-sheet__sub {
  margin: 12rpx 0 32rpx;
  font-size: 24rpx;
  line-height: 33.6rpx;
  color: var(--color-muted, #b3b3b3);
  white-space: pre-line;
}

/* MIW-121 协议勾选行：22rpx 弱化文案 + 品牌色链接，压缩副标题与主按钮之间的间距。 */
.mip-login-sheet__consent {
  display: flex;
  justify-content: center;
  margin: 0 0 24rpx;
}

.mip-login-sheet__consent-row {
  display: flex;
  gap: 8rpx;
  align-items: flex-start;
  justify-content: center;
}

/* 原生 checkbox 默认约 44.8rpx，压到与 22rpx 文案同级的视觉尺寸；
   transform 不收缩布局盒，负外边距收回缩放后的空隙。
   原生视觉块不居中于布局盒（flex-start 下实测中心偏下约 4px），
   -6rpx 顶边距把勾选块拉回与首行文字光学对齐。 */
.mip-login-sheet__consent-checkbox {
  margin: -6rpx -8rpx 0 0;
  transform: scale(0.68);
  transform-origin: center;
}

.mip-login-sheet__consent-text {
  font-size: 22rpx;
  line-height: 40rpx;
  color: var(--color-muted, #b3b3b3);
  text-align: left;
}

.mip-login-sheet__consent-link {
  color: var(--color-brand, #fcdf03);
}

.mip-login-sheet__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 80rpx;
  padding: 0;
  margin: 0;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 44.8rpx;
  color: var(--color-on-brand, #080808);
  background: var(--color-brand, #fcdf03);
  border: 2rpx solid #080808;
  border-radius: 100rpx;
}

.mip-login-sheet__btn::after {
  border: 0;
}

.mip-login-sheet__btn[disabled] {
  color: var(--color-on-brand, #080808);
  background: var(--color-brand, #fcdf03);
  opacity: 0.6;
}

.mip-login-sheet__ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin-top: 28rpx;
  font-size: 24rpx;
  line-height: 33.6rpx;
  color: var(--color-muted, #b3b3b3);
}
