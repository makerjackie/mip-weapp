
.mip-sticky-actions-spacer {
  height: calc(128rpx + env(safe-area-inset-bottom));
}

.mip-sticky-actions-shell {
  position: fixed;
  right: auto;
  bottom: calc(env(safe-area-inset-bottom) + 16rpx);
  left: 50%;
  z-index: 20;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  width: calc(100% - 48rpx);
  max-width: calc(var(--mip-member-shell-max-width, 100%) - 48rpx);
  min-height: 112rpx;
  /* MIW-64 figma 3828:26877：栏 56px 高、上下内边距 8px，slot 内容 80rpx（=40px 按钮高）。 */
  padding: 16rpx;
  border-radius: 9999rpx;
  transform: translateX(-50%);
}
