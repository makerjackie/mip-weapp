.mip-stat-header {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  height: 136rpx;
  background: var(--mip-bg-surface);
  border-radius: 16rpx;
}

.mip-stat-header__column {
  position: absolute;
  top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  align-items: center;
  width: 96rpx;
}

.mip-stat-header__value-wrap {
  position: relative;
}

.mip-stat-header__value {
  font-size: 40rpx;
  font-weight: 500;
  line-height: 56rpx;
  color: var(--mip-text-primary);
}

.mip-stat-header__badge {
  position: absolute;
  top: -8rpx;
  right: -2rpx;
  min-width: 28rpx;
  padding: 0 4rpx;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 26rpx;
  color: var(--mip-text-primary);
  text-align: center;
  background: #ff2238;
  border-radius: 100rpx;
}

.mip-stat-header__label {
  font-size: 20rpx;
  line-height: 28rpx;
  color: var(--mip-text-primary);
}
