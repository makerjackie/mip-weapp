/* Card geometry from figma 1770:38896: 351x68 shell, four 48px columns at left 31.5+i*80 (design px). */
.mip-stat-header {
  box-sizing: border-box;
  display: flex;
  gap: 64rpx;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 136rpx;
  padding: 0 63rpx;
  background: var(--mip-bg-surface);
  border-radius: 16rpx;
}

.mip-stat-header__column {
  position: relative;
  display: flex;
  flex: none;
  flex-direction: column;
  gap: 4rpx;
  align-items: center;
  width: 96rpx;
}

.mip-stat-header__value-wrap {
  position: relative;
}

.mip-stat-header__value {
  font-size: 40rpx;
  font-weight: 500;
  line-height: 56rpx;
  color: var(--mip-text-primary);
}

.mip-stat-header__label-wrap {
  position: relative;
}

/* MIW-17 G2（mine-member Frame 3754 / DS StatHeader）：14×14 圆角标钉在 48px 列右上——
   原型 badge left 234/314 = 列右缘(239.5/319.5) − 5.5，即 right -17rpx、top -8rpx（列顶 12 → 角标顶 8）；
   #ff2238 内含白色 10/500 未读数；min-width + 水平 padding 让两位数仍走胶囊形，一位数与设计稿同宽。 */
.mip-stat-header__badge {
  position: absolute;
  top: -8rpx;
  right: -17rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 4rpx;
  background: var(--mip-record);
  border-radius: 100rpx;
}

.mip-stat-header__badge-count {
  font-size: 20rpx;
  font-weight: 500;
  line-height: 26rpx;
  color: var(--mip-text-primary);
}

.mip-stat-header__label {
  font-size: 20rpx;
  line-height: 28rpx;
  color: var(--mip-text-primary);
}
