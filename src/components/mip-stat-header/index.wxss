/* Card geometry from figma 1770:38896: 351x68 shell, four 48px columns at left 31.5+i*80 (design px). */
.mip-stat-header {
  box-sizing: border-box;
  display: flex;
  gap: 64rpx;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 136rpx;
  padding: 0 63rpx;
  background: var(--mip-bg-surface);
  border-radius: 16rpx;
}

.mip-stat-header__column {
  display: flex;
  flex: none;
  flex-direction: column;
  gap: 4rpx;
  align-items: center;
  width: 96rpx;
}

.mip-stat-header__value-wrap {
  position: relative;
}

.mip-stat-header__value {
  font-size: 40rpx;
  font-weight: 500;
  line-height: 56rpx;
  color: var(--mip-text-primary);
}

.mip-stat-header__label-wrap {
  position: relative;
}

.mip-stat-header__badge {
  position: absolute;
  top: 0;
  left: calc(100% + 6rpx);
  width: 12rpx;
  height: 12rpx;
  background: var(--color-danger);
  border-radius: 50%;
}

.mip-stat-header__label {
  font-size: 20rpx;
  line-height: 28rpx;
  color: var(--mip-text-primary);
}
