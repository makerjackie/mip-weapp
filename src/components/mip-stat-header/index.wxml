<view class="mip-stat-header" aria-role="group">
  <view
    wx:for="{{stats}}"
    wx:key="label"
    class="mip-stat-header__column"
    data-index="{{index}}"
    bind:tap="handleSelect"
  >
    <view class="mip-stat-header__value-wrap">
      <text class="mip-stat-header__value">{{item.value}}</text>
    </view>
    <view class="mip-stat-header__label-wrap"><text class="mip-stat-header__label">{{item.label}}</text></view>
    <!-- MIW-17 G2（DS StatHeader）：角标钉在 48px 列右上（原型 badge left = 列右缘 − 5.5px，与数值宽度无关）、内含未读数；
         badgeLabel 可选，未传时保持「有新访客」默认（向后兼容既有访客卡）。 -->
    <view wx:if="{{item.badge}}" class="mip-stat-header__badge" aria-label="{{item.badgeLabel || '有新访客'}}"><text class="mip-stat-header__badge-count">{{item.badgeCount}}</text></view>
  </view>
</view>
