<view class="cooperation-role-card" style="background-color: {{view.bg}}" aria-label="{{view.name}}合作卡">
  <image wx:if="{{view.image}}" class="cooperation-role-card__art" mode="scaleToFill" fade-show="{{false}}" src="{{view.image}}" />
  <view wx:if="{{view.name}}" class="cooperation-role-card__name" style="color: {{view.light}}">
    <text wx:for="{{view.nameRuns}}" wx:key="index" class="cooperation-role-card__name-run {{item.latin ? 'cooperation-role-card__name-run--latin' : ''}}">{{item.text}}</text>
  </view>
  <view wx:if="{{showDetails && view.goal}}" class="cooperation-role-card__strip cooperation-role-card__strip--goal">
    <view class="cooperation-role-card__badge">
      <view class="cooperation-role-card__badge-circle"><mip-icon name="target" color="#202020" /></view>
      <text class="cooperation-role-card__badge-label">{{goalLabel}}</text>
    </view>
    <text class="cooperation-role-card__value">{{view.goal}}</text>
  </view>
  <view wx:if="{{showDetails && view.referral}}" class="cooperation-role-card__strip cooperation-role-card__strip--referral">
    <view class="cooperation-role-card__badge">
      <view class="cooperation-role-card__badge-circle"><mip-icon name="cup" color="#202020" /></view>
      <text class="cooperation-role-card__badge-label">{{referralLabel}}</text>
    </view>
    <text class="cooperation-role-card__value">{{view.referral}}</text>
  </view>
</view>
