.cooperation-role-card {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  height: 400rpx;
  overflow: hidden;
  border-radius: 32rpx;
}

.cooperation-role-card__art {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.cooperation-role-card__name {
  position: absolute;
  top: 192rpx;
  left: 24rpx;
  max-width: 654rpx;
  overflow: hidden;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 33.6rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
  text-transform: uppercase;
}

.cooperation-role-card__name-run--latin {
  font-family: 'Baloo', 'Baloo 2', -apple-system, system-ui, sans-serif;
  font-weight: 400;
}

.cooperation-role-card__strip {
  position: absolute;
  left: 0;
  display: flex;
  gap: 16rpx;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  background: #202020;
}

.cooperation-role-card__strip--goal {
  top: 240rpx;
  border-radius: 32rpx 32rpx 0 0;
}

.cooperation-role-card__strip--referral {
  top: 320rpx;
  border-radius: 0 0 32rpx 32rpx;
}

.cooperation-role-card__badge {
  display: flex;
  gap: 8rpx;
  align-items: center;
  flex: 0 0 auto;
}

.cooperation-role-card__badge-circle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  background: var(--color-brand);
  border-radius: 50%;
}

.cooperation-role-card__badge-label {
  font-size: 20rpx;
  font-weight: 400;
  line-height: 28rpx;
  color: var(--color-ink);
  white-space: nowrap;
}

.cooperation-role-card__value {
  flex: 1 1 auto;
  min-width: 0;
  overflow: hidden;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 33.6rpx;
  color: var(--color-ink);
  text-align: right;
  white-space: nowrap;
  text-overflow: ellipsis;
}
