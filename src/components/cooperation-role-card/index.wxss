.cooperation-role-card {
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  overflow: hidden;
  color: var(--color-ink);
  background: var(--color-panel);
  border-radius: var(--mip-radius-card);
}

.cooperation-role-card__hero {
  position: relative;
  box-sizing: border-box;
  height: 240rpx;
  padding: 20rpx 24rpx;
  overflow: hidden;
}

.cooperation-role-card__soft {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  width: 50%;
  clip-path: polygon(18% 0, 100% 0, 100% 100%, 0 100%, 16% 52%, 0 52%);
}

.cooperation-role-card__brand,
.cooperation-role-card__copy,
.cooperation-role-card__art {
  position: relative;
  z-index: 1;
}

.cooperation-role-card__brand {
  font-size: 38rpx;
  font-weight: 800;
  line-height: 44rpx;
  letter-spacing: 2rpx;
}

.cooperation-role-card__copy {
  position: absolute;
  right: 52%;
  bottom: 18rpx;
  left: 24rpx;
}

.cooperation-role-card__role {
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 36rpx;
  white-space: nowrap;
}

.cooperation-role-card__positioning {
  display: -webkit-box;
  margin-top: 6rpx;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  font-size: 19rpx;
  line-height: 28rpx;
  opacity: 0.86;
}

.cooperation-role-card__art {
  position: absolute;
  right: 38rpx;
  bottom: 0;
  width: 226rpx;
  height: 240rpx;
}

.cooperation-role-card__details {
  padding: 0 24rpx;
  background: var(--color-panel);
}

.cooperation-role-card__detail-row {
  box-sizing: border-box;
  display: grid;
  grid-template-columns: 140rpx minmax(0, 1fr);
  gap: 16rpx;
  align-items: center;
  min-height: 80rpx;
  padding: 16rpx 0;
}

.cooperation-role-card__detail-row + .cooperation-role-card__detail-row {
  border-top: 1rpx solid var(--color-line);
}

.cooperation-role-card__detail-key {
  display: flex;
  gap: 8rpx;
  align-items: center;
  font-size: 20rpx;
  color: var(--color-ink);
  white-space: nowrap;
}

.cooperation-role-card__detail-icon {
  flex: 0 0 auto;
  width: 30rpx;
  height: 30rpx;
}

.cooperation-role-card__detail-value {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 32rpx;
  text-align: right;
}

.cooperation-role-card--compact .cooperation-role-card__hero {
  height: 200rpx;
}

.cooperation-role-card--compact .cooperation-role-card__copy {
  right: 48%;
}

.cooperation-role-card--compact .cooperation-role-card__art {
  right: 20rpx;
  width: 188rpx;
  height: 200rpx;
}
