.mip-level-banner {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  height: 160rpx;
  overflow: hidden;
  background: var(--color-brand);
  border-radius: 32rpx 32rpx 0 0;
}

.mip-level-banner__decoration {
  position: absolute;
  top: 0;
  right: 0;
  width: 50%;
  height: 100%;
  overflow: hidden;
  pointer-events: none;
}

.mip-level-banner__base {
  position: absolute;
  top: 0;
  right: 0;
  width: 200%;
  height: 100%;
}

.mip-level-banner__decoration::after {
  position: absolute;
  inset: 0;
  content: '';
  background: linear-gradient(to right, var(--color-brand), transparent 24%);
}

.mip-level-banner__level {
  position: absolute;
  top: 18rpx;
  left: 28rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 44.8rpx;
  color: var(--color-on-brand);
}

.mip-level-banner__experience {
  position: absolute;
  top: 88rpx;
  left: 28rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 28rpx;
  color: var(--color-on-brand);
}

.mip-level-banner__action {
  position: absolute;
  top: 24rpx;
  right: 32rpx;
  display: flex;
  gap: 8rpx;
  align-items: center;
}

.mip-level-banner__action-label {
  font-size: 20rpx;
  font-weight: 400;
  line-height: 28rpx;
  color: var(--color-on-brand);
  white-space: nowrap;
}

.mip-level-banner__arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24rpx;
  height: 24rpx;
  transform: rotate(1.6deg);
}

.mip-level-banner__slot {
  position: absolute;
  top: 120rpx;
  left: 24rpx;
  width: 300rpx;
  height: 12rpx;
  overflow: hidden;
  background: #4d4400;
  border-radius: 100rpx;
}

.mip-level-banner__fill {
  height: 4rpx;
  margin: 4rpx 0 0 4rpx;
  background: var(--color-brand);
  border-radius: 100rpx;
}
