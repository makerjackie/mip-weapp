<!-- MIW-40 订阅授权两段式引导层：check() 只弹本层，「开启提醒」tap 才触发原生订阅面板。
     mode=REQUEST 请求授权；MANUAL=拒绝后仅保留手动开启文案（D4，不再拉原生面板）。
     TEMPLATE_MISSING、已入账、BANNED、24h 内已展示、拒绝满 3 次时 visible 恒为 false。 -->
<t-popup visible="{{visible}}" placement="bottom" prevent-scroll-through bind:visible-change="onVisibleChange">
  <view class="rounded-t-[24rpx] bg-panel px-4 pb-[calc(env(safe-area-inset-bottom)+32rpx)] pt-5 text-ink" aria-role="dialog" aria-modal="{{true}}" aria-label="机会动态提醒">
    <view class="flex items-center justify-between">
      <text class="text-[30rpx] font-semibold">开启机会动态提醒</text>
      <view id="mip-subscription-guide-close" class="flex min-h-[88rpx] items-center px-3 text-muted" aria-role="button" bind:tap="dismiss">关闭</view>
    </view>
    <view class="mt-2 text-[24rpx] leading-[40rpx] text-muted">有人对你的机会表达合作意向等新动态时，通过微信服务通知提醒你。</view>
    <view wx:if="{{mode === 'MANUAL'}}" class="mt-3 rounded-[8rpx] bg-panel-raised px-3 py-3 text-[24rpx] leading-[40rpx] text-muted">你之前选择了暂不开启。如需开启，请点右上角「···」→「设置」→「订阅消息」，手动开启「机会动态」。</view>
    <view wx:if="{{message}}" class="mt-3 text-[24rpx] text-danger">{{message}}</view>
    <view class="mt-4">
      <t-button wx:if="{{mode === 'REQUEST'}}" id="mip-subscription-guide-request" block size="large" theme="primary" loading="{{requesting}}" bind:tap="request">开启提醒</t-button>
      <t-button wx:else id="mip-subscription-guide-known" block size="large" variant="outline" theme="primary" bind:tap="dismiss">知道了</t-button>
      <view wx:if="{{mode === 'REQUEST'}}" id="mip-subscription-guide-dismiss" class="mt-3 pb-1 text-center text-[24rpx] text-muted" aria-role="button" bind:tap="dismiss">暂不</view>
    </view>
  </view>
</t-popup>
