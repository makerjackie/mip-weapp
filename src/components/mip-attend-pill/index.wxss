.mip-attend-pill {
  position: relative;
  box-sizing: border-box;
  display: inline-flex;
  gap: 12rpx;
  align-items: center;
  justify-content: center;
  width: max-content;
  min-width: 232rpx;
  height: 56rpx;
  padding: 4rpx 16rpx 4rpx 4rpx;
  border-radius: 100rpx;
}

.mip-attend-pill--dark {
  background: var(--mip-bg-surface-3);
}

.mip-attend-pill--yellow {
  background: var(--mip-brand);
}

.mip-attend-pill--dark .mip-attend-pill__count {
  color: var(--mip-text-primary);
}

.mip-attend-pill--yellow .mip-attend-pill__count {
  color: var(--mip-text-on-brand);
}

.mip-attend-pill--disabled {
  opacity: 0.4;
}

.mip-attend-pill__avatars {
  display: flex;
  flex-shrink: 0;
  height: 48rpx;
}

.mip-attend-pill__avatar {
  position: relative;
  box-sizing: border-box;
  width: 48rpx;
  height: 48rpx;
  margin-left: -18rpx;
  object-fit: cover;
  border: 2rpx solid rgb(255 255 255 / 100%);
  border-radius: 50%;
}

.mip-attend-pill__avatar:first-child {
  margin-left: 0;
}

.mip-attend-pill__count {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 34rpx;
  white-space: nowrap;
}
