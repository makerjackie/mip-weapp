<view
  class="mip-attend-pill mip-attend-pill--{{variant}} {{disabled ? 'mip-attend-pill--disabled' : ''}}"
  aria-role="button"
  bind:tap="handleTap"
>
  <view wx:if="{{avatars.length}}" class="mip-attend-pill__avatars">
    <image
      wx:for="{{avatars}}"
      wx:key="*this"
      class="mip-attend-pill__avatar"
      wx:if="{{index < 3}}"
      style="z-index:{{3 - index}}"
      mode="aspectFill"
      src="{{item}}"
    />
  </view>
  <text class="mip-attend-pill__count">+{{count}}{{label}}</text>
</view>
