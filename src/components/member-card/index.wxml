<view wx:if="{{grid}}" class="overflow-hidden rounded-[24rpx] bg-panel shadow-[0_8rpx_32rpx_rgba(29,42,35,0.06)] active:opacity-70" bind:tap="handleSelect">
  <image wx:if="{{member.avatarUrl}}" class="h-[280rpx] w-full bg-brand-soft" mode="aspectFill" fade-show="{{false}}" src="{{member.avatarUrl}}" />
  <view wx:else class="flex h-[280rpx] w-full items-center justify-center bg-brand-soft text-[length:52rpx] font-bold text-brand">{{member.initial}}</view>
  <view class="px-3 py-3">
    <view class="flex items-center justify-between gap-2"><view class="truncate text-[length:27rpx] font-bold">{{member.nickname}}</view><view wx:if="{{member.detailLocked}}" class="shrink-0 text-[length:18rpx] text-accent">会员可见</view></view>
    <view class="mt-1 text-[length:20rpx] text-muted">{{member.city}}</view>
    <view class="mt-2 line-clamp-2 min-h-[72rpx] text-[length:21rpx] leading-5">{{member.headline}}</view>
    <view wx:if="{{member.tags.length}}" class="mt-2 flex flex-wrap gap-1"><view wx:for="{{member.tags}}" wx:key="*this" class="rounded-full bg-brand-soft px-2 py-1 text-[length:18rpx] text-brand">{{item}}</view></view>
  </view>
</view>
<view wx:else class="overflow-hidden rounded-[28rpx] bg-panel shadow-[0_8rpx_32rpx_rgba(29,42,35,0.06)] active:opacity-70" bind:tap="handleSelect">
  <view class="flex items-center gap-3 p-3">
    <image wx:if="{{member.avatarUrl}}" class="h-[104rpx] w-[104rpx] shrink-0 rounded-[20rpx] bg-brand-soft" mode="aspectFill" fade-show="{{false}}" src="{{member.avatarUrl}}" />
    <view wx:else class="flex h-[104rpx] w-[104rpx] shrink-0 items-center justify-center rounded-[20rpx] bg-brand-soft text-[length:32rpx] font-bold text-brand">{{member.initial}}</view>
    <view class="min-w-0 flex-1">
      <view class="flex items-center justify-between gap-3">
        <view class="truncate text-[length:28rpx] font-bold text-ink">{{member.nickname}}</view>
        <t-tag wx:if="{{member.detailLocked}}" theme="warning" variant="light">会员可见</t-tag>
      </view>
      <view class="mt-1 text-[length:22rpx] text-muted">{{member.city}}</view>
      <view class="mt-1 line-clamp-2 text-[length:23rpx] leading-5 text-ink">{{member.headline}}</view>
      <view wx:if="{{!compact && member.tags.length}}" class="mt-3 flex flex-wrap gap-2">
        <view wx:for="{{member.tags}}" wx:key="*this" class="rounded-full bg-brand-soft px-3 py-1 text-[length:20rpx] text-brand">{{item}}</view>
      </view>
    </view>
  </view>
</view>
