<view
  wx:if="{{visible}}"
  class="event-phone-preview__overlay"
  aria-role="dialog"
  aria-label="活动手机预览"
  catch:tap="close"
>
  <view class="event-phone-preview__device bg-canvas text-ink" catch:tap="stopPropagation">
    <view class="event-phone-preview__header border-b border-solid border-line bg-panel">
      <view class="text-[length:16px] font-semibold">手机预览</view>
      <button
        class="event-phone-preview__close"
        aria-label="关闭手机预览"
        bind:tap="close"
        hover-class="none"
      ><t-icon name="close" size="22px" color="var(--td-text-color-primary)" /></button>
    </view>

    <scroll-view class="event-phone-preview__scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <image wx:if="{{model.coverUrl}}" class="event-phone-preview__cover w-full bg-panel-raised" mode="aspectFill" src="{{model.coverUrl}}" />
      <view wx:else class="event-phone-preview__cover flex w-full items-center justify-center bg-panel-raised text-[length:14px] text-muted">暂未上传封面</view>

      <view class="flex flex-col gap-5 px-5 py-5">
        <view class="flex flex-wrap gap-2">
          <view class="rounded-full bg-brand-soft px-3 py-1 text-[length:12px] font-semibold text-brand">{{model.scopeLabel}}</view>
          <view class="rounded-full bg-panel-raised px-3 py-1 text-[length:12px] text-ink">{{model.modeLabel}}</view>
          <view class="rounded-full bg-panel-raised px-3 py-1 text-[length:12px] text-ink">{{model.accessLabel}}</view>
        </view>

        <view>
          <view class="break-words text-[length:24px] font-bold leading-[1.35]">{{model.title}}</view>
          <view class="mt-3 break-words text-[length:15px] leading-[1.65] text-muted">{{model.summary}}</view>
        </view>

        <view class="flex flex-col gap-3 rounded-[16px] bg-panel px-4 py-4">
          <view class="flex items-start gap-3">
            <t-icon class="mt-[2px] shrink-0" name="time" size="18px" color="var(--td-brand-color)" />
            <view class="min-w-0 flex-1 break-words text-[length:14px] leading-[1.55]">{{model.timeText}}</view>
          </view>
          <view class="flex items-start gap-3">
            <t-icon class="mt-[2px] shrink-0" name="location" size="18px" color="var(--td-brand-color)" />
            <view class="min-w-0 flex-1 break-words text-[length:14px] leading-[1.55]">{{model.locationText}}</view>
          </view>
        </view>

        <view>
          <view class="text-[length:17px] font-semibold">活动介绍</view>
          <text class="event-phone-preview__copy mt-3 text-[length:14px] leading-[1.75] text-ink" user-select>{{model.description}}</text>
          <view wx:for="{{model.contentMedia}}" wx:key="imageUrl" class="mt-4 overflow-hidden rounded-[14px] bg-panel">
            <image class="event-phone-preview__content-image w-full bg-panel-raised" mode="widthFix" src="{{item.imageUrl}}" />
            <view wx:if="{{item.caption}}" class="break-words px-3 py-3 text-[length:13px] leading-[1.6] text-muted">{{item.caption}}</view>
          </view>
        </view>

        <view class="border-t border-solid border-line pt-5">
          <view class="text-[length:17px] font-semibold">报名须知</view>
          <text class="event-phone-preview__copy mt-3 text-[length:14px] leading-[1.75] text-muted" user-select>{{model.notices}}</text>
        </view>
      </view>
    </scroll-view>

    <view class="event-phone-preview__footer border-t border-solid border-line bg-panel">
      <t-button block theme="primary" size="large" disabled aria-label="预览中不可报名">预览中不可报名</t-button>
    </view>
  </view>
</view>
