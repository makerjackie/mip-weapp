<!-- BUG-01（交互审计 2026-10-12）：根节点必须 catch:tap——triggerEvent('tap') 与原生
     冒泡 tap 同名，bind 会让宿主绑定一次点按执行两次（同 mip-pill-button 的 F1 修复）。 -->
<view
  class="mip-form-field-row {{disabled ? 'mip-form-field-row--disabled' : ''}}"
  aria-role="button"
  aria-disabled="{{disabled}}"
  catch:tap="handleTap"
>
  <text class="mip-form-field-row__label">{{label}}</text>
  <view class="mip-form-field-row__trailing">
    <text class="mip-form-field-row__value {{value ? '' : 'mip-form-field-row__value--placeholder'}}">{{value || placeholder}}</text>
    <view wx:if="{{trailing === 'calendar'}}" class="mip-form-field-row__icon">
      <mip-icon name="calendar-schedule" size="{{14}}" color="var(--color-muted)" />
    </view>
    <view wx:if="{{trailing === 'chevron'}}" class="mip-form-field-row__icon">
      <mip-icon name="chevron-down-1" color="var(--color-muted)" />
    </view>
  </view>
</view>
