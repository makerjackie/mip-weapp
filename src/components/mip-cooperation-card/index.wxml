<view class="mip-cooperation-card {{tall ? 'mip-cooperation-card--tall' : ''}}" style="background-color: {{view.bg}}" aria-label="{{view.name}}合作卡">
  <image wx:if="{{view.image}}" class="mip-cooperation-card__art" mode="scaleToFill" fade-show="{{false}}" src="{{view.image}}" />
  <view wx:if="{{view.name}}" class="mip-cooperation-card__name" style="color: {{view.light}}">
    <text wx:for="{{view.nameRuns}}" wx:key="index" class="mip-cooperation-card__name-run {{item.latin ? 'mip-cooperation-card__name-run--latin' : ''}}">{{item.text}}</text>
  </view>
  <view wx:if="{{showDetails && (view.goal || view.referral || view.maxValue || (showQuote && view.slogan))}}" class="mip-cooperation-card__details">
    <view wx:if="{{showQuote && view.slogan}}" class="mip-cooperation-card__quote">{{view.slogan}}</view>
    <view wx:if="{{view.goal}}" class="mip-cooperation-card__strip mip-cooperation-card__strip--goal">
      <view class="mip-cooperation-card__badge">
        <view class="mip-cooperation-card__badge-circle"><mip-icon name="target" size="{{10}}" color="var(--color-panel)" /></view>
        <text class="mip-cooperation-card__badge-label">{{goalLabel}}</text>
      </view>
      <text class="mip-cooperation-card__value">{{view.goal}}</text>
    </view>
    <view wx:if="{{view.referral}}" class="mip-cooperation-card__strip mip-cooperation-card__strip--referral">
      <view class="mip-cooperation-card__badge">
        <view class="mip-cooperation-card__badge-circle"><mip-icon name="cup" size="{{10}}" color="var(--color-panel)" /></view>
        <text class="mip-cooperation-card__badge-label">{{referralLabel}}</text>
      </view>
      <text class="mip-cooperation-card__value">{{view.referral}}</text>
    </view>
    <view wx:if="{{view.maxValue}}" class="mip-cooperation-card__strip mip-cooperation-card__strip--value">
      <view class="mip-cooperation-card__badge">
        <view class="mip-cooperation-card__badge-circle"><image class="h-[20rpx] w-[20rpx]" src="/assets/mip/icon-copper-diamond-dark.png" /></view>
        <text class="mip-cooperation-card__badge-label">{{valueLabel}}</text>
      </view>
      <text class="mip-cooperation-card__value">{{view.maxValue}}</text>
    </view>
  </view>
  <!-- 六角色烘焙卡静态预载锚点（MIW-100 同族）：cooperationCardVariants 的 image 只能经
       {{}} 动态绑定（model.ts 闭集 map），上传依赖分析探不到会被剔出体验版；此处静态
       引用保证打包，增删角色须同步 model.ts。 -->
  <view aria-hidden="true" class="fixed left-[-9999rpx] top-0 h-0 w-0 overflow-hidden">
    <image class="h-[2rpx] w-[2rpx]" src="/assets/mip/coop-card-dogplaner@3x.png" />
    <image class="h-[2rpx] w-[2rpx]" src="/assets/mip/coop-card-upstart@3x.png" />
    <image class="h-[2rpx] w-[2rpx]" src="/assets/mip/coop-card-design-slave@3x.png" />
    <image class="h-[2rpx] w-[2rpx]" src="/assets/mip/coop-card-pimp@3x.png" />
    <image class="h-[2rpx] w-[2rpx]" src="/assets/mip/coop-card-business-man@3x.png" />
    <image class="h-[2rpx] w-[2rpx]" src="/assets/mip/coop-card-old-nanny@3x.png" />
  </view>
</view>
