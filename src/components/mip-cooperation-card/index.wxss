.mip-cooperation-card {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  height: 400rpx;
  overflow: hidden;
  border-radius: 32rpx;
}

.mip-cooperation-card__art {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.mip-cooperation-card__name {
  position: absolute;
  top: 192rpx;
  left: 24rpx;
  max-width: 654rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 33.6rpx;
  text-transform: uppercase;
  white-space: nowrap;
}

.mip-cooperation-card__name-run--latin {
  font-family: Baloo, 'Baloo 2', -apple-system, system-ui, sans-serif;
  font-weight: 400;
}

/* 单一黑色容器承载两行，行间不存在独立元素的拼接缝；
   底部过绘 2rpx 交由卡片圆角裁切，杜绝底边取整露出底图 */
.mip-cooperation-card__details {
  position: absolute;
  top: 240rpx;
  bottom: -2rpx;
  left: 0;
  box-sizing: border-box;
  width: 100%;
  background: #202020;
  border-radius: 32rpx 32rpx 0 0;
}

.mip-cooperation-card__strip {
  position: relative;
  box-sizing: border-box;
  display: flex;
  gap: 16rpx;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
}

.mip-cooperation-card__badge {
  display: flex;
  flex: 0 0 auto;
  gap: 8rpx;
  align-items: center;
}

.mip-cooperation-card__badge-circle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  background: var(--color-brand);
  border-radius: 50%;
}

.mip-cooperation-card__badge-label {
  font-size: 20rpx;
  font-weight: 400;
  line-height: 28rpx;
  color: var(--color-ink);
  white-space: nowrap;
}

.mip-cooperation-card__value {
  flex: 1 1 auto;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 33.6rpx;
  color: var(--color-ink);
  text-align: right;
  white-space: nowrap;
}
