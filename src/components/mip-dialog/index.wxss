.mip-dialog__scrim {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgb(0 0 0 / 60%);
}

.mip-dialog {
  box-sizing: border-box;
  width: 640rpx;
  overflow: hidden;
  background: var(--mip-bg-surface-2);
  border-radius: 16rpx;
}

.mip-dialog--frame {
  position: absolute;
  top: 0;
  left: 0;
  height: 464rpx;
}

.mip-dialog__body {
  position: relative;
  height: 352rpx;
}

.mip-dialog__title {
  position: absolute;
  top: 64rpx;
  left: 48rpx;
  width: 544rpx;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 44rpx;
  color: rgb(255 255 255 / 90%);
  text-align: center;
}

.mip-dialog__title--frame {
  top: 64rpx;
  font-weight: 600;
  line-height: 44.8rpx;
}

.mip-dialog__content {
  position: absolute;
  top: 144rpx;
  left: 48rpx;
  width: 544rpx;
  font-size: 34rpx;
  line-height: 48rpx;
  color: var(--mip-text-primary);
  text-align: center;
}

.mip-dialog__content--frame {
  top: 142rpx;
  line-height: 48rpx;
  color: #999;
}

.mip-dialog__actions {
  display: flex;
  border-top: 1rpx solid rgb(255 255 255 / 10%);
}

.mip-dialog__actions--single {
  border-top: 0;
}

.mip-dialog__button {
  display: flex;
  flex: 1 1 0;
  align-items: center;
  justify-content: center;
  min-height: 112rpx;
  font-size: 34rpx;
  font-weight: 500;
  color: #7d90a9;
  border-right: 1rpx solid rgb(255 255 255 / 10%);
}

.mip-dialog__actions--single .mip-dialog__button {
  border-right: 0;
}

.mip-dialog__button--disabled {
  opacity: 0.6;
}

.mip-dialog__frame-rule {
  position: absolute;
  top: 352rpx;
  left: 0;
  width: 100%;
  height: 2rpx;
  background: #484848;
}

.mip-dialog__frame-button {
  position: absolute;
  top: 396rpx;
  left: 0;
  width: 100%;
  font-size: 32rpx;
  line-height: 44.8rpx;
  color: #576b95;
  text-align: center;
}
