<view class="w-full max-w-full box-border">
  <view wx:if="{{clearLabel}}" class="flex flex-wrap gap-2">
    <view data-industry-clear="true" aria-role="button" aria-pressed="{{!selectedIds.length}}" bind:tap="onClear">
      <mip-tag-chip label="{{clearLabel}}" active="{{!selectedIds.length}}" />
    </view>
  </view>

  <block wx:if="{{showPopular && popularOptions.length}}">
    <view class="mt-3 text-[22rpx] text-muted">热门行业</view>
    <view class="mt-2 flex flex-wrap gap-2">
      <view
        wx:for="{{popularOptions}}"
        wx:key="id"
        data-id="{{item.id}}"
        aria-role="{{multiple ? 'checkbox' : 'radio'}}"
        aria-checked="{{item.selected}}"
        bind:tap="onChipTap"
      >
        <mip-tag-chip label="{{item.label}}" active="{{item.selected}}" />
      </view>
    </view>
  </block>

  <view wx:if="{{accordion && viewGroups.length}}" class="mt-3 overflow-hidden rounded-[8rpx] border border-line">
    <block wx:for="{{viewGroups}}" wx:for-item="group" wx:key="id">
      <view
        class="flex min-h-[88rpx] items-center gap-2 border-b border-line px-3"
        data-group-id="{{group.id}}"
        aria-role="button"
        aria-expanded="{{expandedGroupId === group.id}}"
        bind:tap="onGroupToggle"
      >
        <text class="min-w-0 flex-1 truncate text-[24rpx]">{{group.label}}</text>
        <t-icon name="{{expandedGroupId === group.id ? 'chevron-up' : 'chevron-down'}}" size="28rpx" color="var(--color-muted)" />
      </view>
      <view wx:if="{{expandedGroupId === group.id}}" class="flex flex-wrap gap-2 border-b border-line bg-panel-raised px-3 py-3">
        <view
          wx:for="{{group.options}}"
          wx:for-item="option"
          wx:key="id"
          data-id="{{option.id}}"
          aria-role="checkbox"
          aria-checked="{{option.selected}}"
          bind:tap="onChipTap"
        >
          <mip-tag-chip label="{{option.label}}" active="{{option.selected}}" />
        </view>
      </view>
    </block>
  </view>

  <block wx:else>
    <block wx:for="{{viewGroups}}" wx:for-item="group" wx:key="id">
      <view class="mt-3 text-[22rpx] text-muted">{{group.label}}</view>
      <view class="mt-2 flex flex-wrap gap-2">
        <view
          wx:for="{{group.options}}"
          wx:for-item="option"
          wx:key="id"
          data-id="{{option.id}}"
          aria-role="{{multiple ? 'checkbox' : 'radio'}}"
          aria-checked="{{option.selected}}"
          bind:tap="onChipTap"
        >
          <mip-tag-chip label="{{option.label}}" active="{{option.selected}}" />
        </view>
      </view>
    </block>
  </block>
</view>
