<view class="event-participant-preview flex h-[56rpx] items-center rounded-full bg-panel-raised pl-[4rpx] pr-[20rpx]" aria-label="{{countText || (count + '人参加')}}">
  <view class="flex items-center">
    <block wx:for="{{participants}}" wx:key="participantRef">
      <image wx:if="{{item.avatarUrl}}" class="relative h-[48rpx] w-[48rpx] rounded-full bg-brand-soft {{index ? '-ml-[18rpx]' : ''}}" style="z-index: {{10 - index}}" mode="aspectFill" src="{{item.avatarUrl}}" />
      <view wx:else class="relative flex h-[48rpx] w-[48rpx] items-center justify-center rounded-full bg-brand-soft {{index ? '-ml-[18rpx]' : ''}}" style="z-index: {{10 - index}}"><t-icon name="user-avatar" size="28rpx" color="var(--color-brand)" /></view>
    </block>
  </view>
  <text wx:if="{{plusLabel}}" class="relative ml-[12rpx] text-[length:20rpx] font-semibold leading-[28rpx] text-ink" style="z-index: 20">{{plusLabel}}</text>
  <text class="relative text-[length:24rpx] font-semibold leading-[33.6rpx] text-ink" style="z-index: 20">{{remainText || countText || (count + '人参加')}}</text>
</view>
