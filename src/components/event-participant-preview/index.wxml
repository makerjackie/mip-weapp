<!-- MIW-73：0 人不渲染；头像最多出镜前 3 个；文案恒读报名总数「N人参加」。 -->
<view wx:if="{{count > 0}}" class="event-participant-preview flex h-[56rpx] items-center rounded-full bg-panel-raised pl-[4rpx] pr-[20rpx]" aria-label="{{countText || (count + '人参加')}}">
  <view class="flex items-center">
    <block wx:for="{{participants}}" wx:key="participantRef">
      <image wx:if="{{index < 3 && item.avatarUrl}}" class="relative h-[48rpx] w-[48rpx] rounded-full bg-brand-soft {{index ? '-ml-[18rpx]' : ''}}" style="z-index: {{10 - index}}" mode="aspectFill" src="{{item.avatarUrl}}" />
      <view wx:elif="{{index < 3}}" class="relative flex h-[48rpx] w-[48rpx] items-center justify-center rounded-full bg-brand-soft {{index ? '-ml-[18rpx]' : ''}}" style="z-index: {{10 - index}}"><t-icon name="user-avatar" size="28rpx" color="var(--color-brand)" /></view>
    </block>
  </view>
  <text class="relative ml-[12rpx] text-[24rpx] font-semibold leading-[33.6rpx] text-ink" style="z-index: 20">{{countText || (count + '人参加')}}</text>
</view>
