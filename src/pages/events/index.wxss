.mip-events-loading {
  --td-skeleton-bg-color: var(--color-panel-raised);
  --td-skeleton-animation-gradient: rgb(255 255 255 / 8%);
}

/* City notice dialog per figma 1820_19040: 320x232 panel over a 70% scrim.
   Figma places the scrim at screen y 86..778 css; the pixel proxy collapses the
   44 css safe area, so fixed offsets are calibrated -44 css (top 84rpx, bottom
   156rpx) to land on the same reference rows (device values: 172rpx / 68rpx). */
.events-city-notice {
  position: fixed;
  inset: 84rpx 0 156rpx;
  z-index: 60;
  background: rgb(8 8 8 / 70%);
}

.events-city-notice__panel {
  position: absolute;
  top: 408rpx;
  left: 54rpx;
  width: 640rpx;
  height: 464rpx;
  overflow: hidden;
  background: var(--color-line);
  border-radius: 16rpx;
}

.events-city-notice__title {
  position: absolute;
  top: 64rpx;
  left: 48rpx;
  width: 544rpx;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 47.6rpx;
  color: rgb(255 255 255 / 90%);
  text-align: center;
}

.events-city-notice__body {
  position: absolute;
  top: 144rpx;
  left: 48rpx;
  width: 544rpx;
  font-size: 34rpx;
  line-height: 47.6rpx;
  color: rgb(255 255 255 / 50%);
  text-align: center;
}

.events-city-notice__footer {
  position: absolute;
  top: 352rpx;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 640rpx;
  height: 112rpx;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 47.6rpx;
  color: var(--td-text-color-disabled);
  border-top: 2rpx solid rgb(255 255 255 / 10%);
}
