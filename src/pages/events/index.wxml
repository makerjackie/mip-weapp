<view id="mip-events-page" class="mip-member-page mip-member-tab-page min-h-screen bg-canvas px-3 pb-[calc(env(safe-area-inset-bottom)+220rpx)] text-ink">
  <app-top-safe-area id="events-status-bar" />
  <view id="events-custom-navigation" class="box-border flex h-[88rpx] items-center pr-[200rpx]">
    <view id="events-city-select" class="flex h-[88rpx] max-w-[360rpx] min-w-0 items-center gap-1 text-[length:28rpx] font-semibold" aria-role="button" bind:tap="selectCity">
      <text class="min-w-0 truncate">{{selectedCity || '全部城市'}}</text>
      <t-icon class="shrink-0" name="chevron-down" size="28rpx" color="var(--color-ink)" />
    </view>
  </view>

  <swiper wx:if="{{banners.length}}" class="h-[298rpx] overflow-hidden rounded-[16rpx] bg-panel" autoplay="{{banners.length > 1}}" circular="{{banners.length > 1}}" indicator-dots="{{banners.length > 1}}" interval="4500" duration="400">
    <swiper-item wx:for="{{banners}}" wx:key="id">
      <view class="h-full w-full" aria-role="button" aria-label="{{item.accessibilityLabel}}" data-banner-id="{{item.id}}" bind:tap="openBanner">
        <image class="h-full w-full" mode="aspectFill" src="{{item.imageUrl}}" />
      </view>
    </swiper-item>
  </swiper>

  <view class="mt-3 grid grid-cols-2 overflow-hidden rounded-[16rpx] bg-panel">
    <view wx:if="{{view === 'UPCOMING'}}" class="flex min-h-[88rpx] items-center justify-center text-[length:28rpx] font-semibold text-brand" aria-role="tab" aria-selected="true" data-view="UPCOMING" bind:tap="changeView"><t-icon class="mr-1" name="file" size="28rpx" color="var(--color-brand)" />活动报名</view>
    <view wx:else class="flex min-h-[88rpx] items-center justify-center text-[length:28rpx] font-semibold text-muted" aria-role="tab" aria-selected="false" data-view="UPCOMING" bind:tap="changeView"><t-icon class="mr-1" name="file" size="28rpx" color="var(--color-muted)" />活动报名</view>
    <view wx:if="{{view === 'PAST'}}" class="flex min-h-[88rpx] items-center justify-center text-[length:28rpx] font-semibold text-brand" aria-role="tab" aria-selected="true" data-view="PAST" bind:tap="changeView"><t-icon class="mr-1" name="chat" size="28rpx" color="var(--color-brand)" />往期活动</view>
    <view wx:else class="flex min-h-[88rpx] items-center justify-center text-[length:28rpx] font-semibold text-muted" aria-role="tab" aria-selected="false" data-view="PAST" bind:tap="changeView"><t-icon class="mr-1" name="chat" size="28rpx" color="var(--color-muted)" />往期活动</view>
  </view>

  <view wx:if="{{videoChannelConfigured}}" class="mt-3 flex min-h-[88rpx] items-center justify-between rounded-[16rpx] bg-panel px-4" bind:tap="openPastReview">
    <view><view class="text-[length:25rpx] font-semibold">往期回顾</view><view class="mt-1 text-[length:22rpx] text-muted">在视频号查看活动内容</view></view>
    <t-icon name="chevron-right" size="32rpx" color="var(--color-brand)" />
  </view>

  <view class="mt-2 flex items-center justify-between gap-2">
    <view class="flex items-center gap-2">
      <view class="flex min-h-[88rpx] items-center" aria-role="radio" aria-checked="{{dateFilter === 'RECENT'}}" data-filter="RECENT" bind:tap="changeDateFilter"><text wx:if="{{dateFilter === 'RECENT'}}" class="rounded-[16rpx] bg-brand px-3 py-2 text-[length:24rpx] font-semibold text-on-brand">近期活动</text><text wx:else class="rounded-[16rpx] bg-panel px-3 py-2 text-[length:24rpx] text-muted">近期活动</text></view>
      <view class="flex min-h-[88rpx] items-center" aria-role="radio" aria-checked="{{dateFilter === 'ENDED'}}" data-filter="ENDED" bind:tap="changeDateFilter"><text wx:if="{{dateFilter === 'ENDED'}}" class="rounded-[16rpx] bg-brand px-3 py-2 text-[length:24rpx] font-semibold text-on-brand">已结束</text><text wx:else class="rounded-[16rpx] bg-panel px-3 py-2 text-[length:24rpx] text-muted">已结束</text></view>
    </view>
      <view class="flex min-h-[88rpx] items-center" aria-role="radio" aria-checked="{{dateFilter === 'TODAY'}}" data-filter="TODAY" bind:tap="changeDateFilter"><view wx:if="{{dateFilter === 'TODAY' || dateFilter === 'CUSTOM'}}" class="flex items-center gap-1 rounded-[16rpx] bg-panel px-3 py-2 text-[length:24rpx] text-brand"><text>{{dateFilter === 'CUSTOM' ? (customDateLabel || '自定义日期') : '今天'}}</text><view class="flex min-h-[56rpx] items-center" catch:tap="showCalendar"><t-icon name="calendar" size="28rpx" color="var(--color-brand)" /></view></view><view wx:else class="flex items-center gap-1 rounded-[16rpx] bg-panel px-3 py-2 text-[length:24rpx] text-ink"><text>今天</text><view class="flex min-h-[56rpx] items-center" catch:tap="showCalendar"><t-icon name="calendar" size="28rpx" color="var(--color-ink)" /></view></view></view>
  </view>

  <view wx:if="{{rangePanelVisible}}" class="mt-2 flex flex-col gap-3 rounded-[16rpx] bg-panel px-4 py-3">
    <view class="flex min-h-[64rpx] items-center">
      <text class="text-[length:26rpx] font-semibold">活动筛选</text>
    </view>

    <view>
      <text class="text-[length:22rpx] text-muted">日期范围</text>
      <view class="mt-2 flex gap-2">
        <view class="box-border flex min-h-[88rpx] min-w-0 flex-1 items-center rounded-[12rpx] bg-panel-raised px-3 text-[length:23rpx]" aria-role="button" data-target="FROM" bind:tap="showRangeCalendar">
          <text class="text-muted">开始日期</text>
          <text wx:if="{{dateFromLabel}}" class="ml-2 text-ink">{{dateFromLabel}}</text>
        </view>
        <view class="box-border flex min-h-[88rpx] min-w-0 flex-1 items-center rounded-[12rpx] bg-panel-raised px-3 text-[length:23rpx]" aria-role="button" data-target="TO" bind:tap="showRangeCalendar">
          <text class="text-muted">结束日期</text>
          <text wx:if="{{dateToLabel}}" class="ml-2 text-ink">{{dateToLabel}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{eventTypeOptions.length}}">
      <text class="text-[length:22rpx] text-muted">活动类型</text>
      <view class="mt-2 flex flex-wrap gap-2">
        <block wx:for="{{eventTypeOptions}}" wx:key="key">
          <view wx:if="{{item.selected}}" class="flex min-h-[72rpx] items-center rounded-full bg-brand px-3 text-[length:23rpx] font-semibold text-on-brand" aria-role="checkbox" aria-checked="true" data-key="{{item.key}}" bind:tap="selectEventType">{{item.name}}</view>
          <view wx:else class="flex min-h-[72rpx] items-center rounded-full bg-panel-raised px-3 text-[length:23rpx] text-ink" aria-role="checkbox" aria-checked="false" data-key="{{item.key}}" bind:tap="selectEventType">{{item.name}}</view>
        </block>
      </view>
    </view>

    <view>
      <text class="text-[length:22rpx] text-muted">参与方式</text>
      <view class="mt-2 grid grid-cols-2 gap-2">
        <view wx:if="{{draftAccessType === ''}}" class="flex min-h-[72rpx] items-center justify-center rounded-[12rpx] bg-brand text-[length:23rpx] font-semibold text-on-brand" data-value="" bind:tap="selectAccessType">全部</view>
        <view wx:else class="flex min-h-[72rpx] items-center justify-center rounded-[12rpx] bg-panel-raised text-[length:23rpx] text-ink" data-value="" bind:tap="selectAccessType">全部</view>
        <view wx:if="{{draftAccessType === 'FREE'}}" class="flex min-h-[72rpx] items-center justify-center rounded-[12rpx] bg-brand text-[length:23rpx] font-semibold text-on-brand" data-value="FREE" bind:tap="selectAccessType">免费活动</view>
        <view wx:else class="flex min-h-[72rpx] items-center justify-center rounded-[12rpx] bg-panel-raised text-[length:23rpx] text-ink" data-value="FREE" bind:tap="selectAccessType">免费活动</view>
        <view wx:if="{{draftAccessType === 'MEMBER_INCLUDED'}}" class="flex min-h-[72rpx] items-center justify-center rounded-[12rpx] bg-brand text-[length:23rpx] font-semibold text-on-brand" data-value="MEMBER_INCLUDED" bind:tap="selectAccessType">玩家活动</view>
        <view wx:else class="flex min-h-[72rpx] items-center justify-center rounded-[12rpx] bg-panel-raised text-[length:23rpx] text-ink" data-value="MEMBER_INCLUDED" bind:tap="selectAccessType">玩家活动</view>
        <view wx:if="{{draftAccessType === 'PAID'}}" class="flex min-h-[72rpx] items-center justify-center rounded-[12rpx] bg-brand text-[length:23rpx] font-semibold text-on-brand" data-value="PAID" bind:tap="selectAccessType">付费活动</view>
        <view wx:else class="flex min-h-[72rpx] items-center justify-center rounded-[12rpx] bg-panel-raised text-[length:23rpx] text-ink" data-value="PAID" bind:tap="selectAccessType">付费活动</view>
      </view>
    </view>

    <view wx:if="{{tagOptions.length}}">
      <text class="text-[length:22rpx] text-muted">活动标签</text>
      <view class="mt-2 flex flex-wrap gap-2">
        <block wx:for="{{tagOptions}}" wx:key="key">
          <view wx:if="{{item.selected}}" class="flex min-h-[72rpx] items-center rounded-full bg-brand px-3 text-[length:23rpx] font-semibold text-on-brand" aria-role="checkbox" aria-checked="true" data-key="{{item.key}}" bind:tap="toggleEventTag">{{item.name}}</view>
          <view wx:else class="flex min-h-[72rpx] items-center rounded-full bg-panel-raised px-3 text-[length:23rpx] text-ink" aria-role="checkbox" aria-checked="false" data-key="{{item.key}}" bind:tap="toggleEventTag">{{item.name}}</view>
        </block>
      </view>
    </view>

    <view>
      <text class="text-[length:22rpx] text-muted">开始时间排序</text>
      <view class="mt-2 grid grid-cols-2 gap-2">
        <view wx:if="{{draftSortDirection === 'ASC'}}" class="flex min-h-[72rpx] items-center justify-center rounded-[12rpx] bg-brand text-[length:23rpx] font-semibold text-on-brand" data-value="ASC" bind:tap="selectSortDirection">从早到晚</view>
        <view wx:else class="flex min-h-[72rpx] items-center justify-center rounded-[12rpx] bg-panel-raised text-[length:23rpx] text-ink" data-value="ASC" bind:tap="selectSortDirection">从早到晚</view>
        <view wx:if="{{draftSortDirection === 'DESC'}}" class="flex min-h-[72rpx] items-center justify-center rounded-[12rpx] bg-brand text-[length:23rpx] font-semibold text-on-brand" data-value="DESC" bind:tap="selectSortDirection">从晚到早</view>
        <view wx:else class="flex min-h-[72rpx] items-center justify-center rounded-[12rpx] bg-panel-raised text-[length:23rpx] text-ink" data-value="DESC" bind:tap="selectSortDirection">从晚到早</view>
      </view>
    </view>

    <view class="flex gap-2">
      <view id="events-clear-filters" class="box-border flex min-h-[88rpx] min-w-0 flex-1 items-center justify-center rounded-[16rpx] border border-line bg-panel-raised text-[length:25rpx] font-semibold text-ink" aria-role="button" bind:tap="clearDiscoveryFilters">清空筛选</view>
      <view id="events-confirm-filters" class="box-border flex min-h-[88rpx] min-w-0 flex-1 items-center justify-center rounded-[16rpx] bg-brand text-[length:25rpx] font-semibold text-on-brand" aria-role="button" bind:tap="confirmDiscoveryFilters">确定筛选</view>
    </view>
  </view>

  <view class="mt-1 flex items-center gap-2">
    <view class="flex min-h-[88rpx] min-w-0 flex-1 items-center gap-2 rounded-[16rpx] bg-panel px-3">
      <t-icon name="search" size="30rpx" color="var(--color-muted)" />
      <input class="box-border h-[80rpx] min-w-0 flex-1 max-w-full text-[length:24rpx]" value="{{searchInput}}" bindinput="onSearchInput" bindconfirm="onSearchConfirm" confirm-type="search" maxlength="50" placeholder="搜索活动名称" />
      <view wx:if="{{searchInput}}" class="px-2 py-2 text-[length:22rpx] text-muted" bind:tap="clearSearch">清除</view>
    </view>
    <view class="relative flex h-[88rpx] w-[88rpx] items-center justify-center rounded-[16rpx] bg-panel" aria-role="button" aria-expanded="{{rangePanelVisible}}" bind:tap="toggleRangePanel"><t-icon name="filter" size="32rpx" color="{{rangePanelVisible || dateFrom || dateTo || activeFilterCount ? 'var(--color-brand)' : 'var(--color-muted)'}}" /><text wx:if="{{activeFilterCount}}" class="absolute right-1 top-1 flex h-[30rpx] min-w-[30rpx] items-center justify-center rounded-full bg-brand px-1 text-[length:18rpx] font-semibold text-on-brand">{{activeFilterCount}}</text></view>
  </view>

  <view wx:if="{{state === 'loading'}}" class="mip-events-loading mt-4 flex flex-col gap-3">
    <view class="rounded-[16rpx] bg-panel px-4 py-6"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
    <view class="rounded-[16rpx] bg-panel px-4 py-6"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  </view>
  <view wx:elif="{{state === 'error'}}" class="mt-5"><app-empty-state title="暂时无法加载活动" description="请稍后重试。" action-text="重新加载" bind:action="loadEvents" /></view>
  <view wx:elif="{{events.length === 0}}" class="mt-5"><app-empty-state title="暂无活动" description="符合当前条件的活动会显示在这里。" /></view>
  <view wx:else id="events-list" class="mt-3 flex flex-col gap-3">
    <event-card wx:for="{{events}}" wx:key="id" event="{{item}}" variant="feed" show-share="{{true}}" bind:select="openEvent" />
    <view wx:if="{{nextCursor}}" class="flex min-h-[88rpx] items-center justify-center rounded-[16rpx] bg-panel text-[length:24rpx] text-brand" bind:tap="loadMore">{{loadingMore ? '加载中' : '加载更多'}}</view>
    <view wx:else class="py-2 text-center text-[length:24rpx] text-muted">已显示全部活动</view>
  </view>
  <view wx:if="{{message && state !== 'error'}}" class="mt-4 rounded-[16rpx] bg-brand-soft px-4 py-3 text-[length:22rpx] text-brand">{{message}}</view>
  <t-calendar visible="{{calendarVisible}}" value="{{calendarValue}}" min-date="{{calendarMinDate}}" max-date="{{calendarMaxDate}}" title="选择活动日期" type="single" switch-mode="year-month" confirm-btn="确定" bind:confirm="confirmCalendar" bind:close="closeCalendar" />
</view>
