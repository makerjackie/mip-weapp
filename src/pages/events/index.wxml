<view id="mip-events-page" class="mip-member-page mip-member-tab-page min-h-screen bg-canvas px-3 pb-[calc(env(safe-area-inset-bottom)+220rpx)] text-ink">
  <app-top-safe-area id="events-status-bar" />
  <view id="events-custom-navigation" class="box-border flex h-[88rpx] items-center pr-[200rpx]">
    <view id="events-city-select" class="flex h-[88rpx] max-w-[360rpx] min-w-0 items-center gap-1 text-[28rpx] font-semibold" aria-role="button" bind:tap="selectCity">
      <text class="min-w-0 truncate text-[34rpx]">{{selectedCity || '全部城市'}}</text>
      <mip-icon class="shrink-0" name="chevron-down-1-15" size="{{10}}" color="var(--color-ink)" />
    </view>
  </view>

  <swiper wx:if="{{banners.length}}" class="mt-2 h-[298rpx] overflow-hidden rounded-[16rpx] bg-panel" autoplay="{{banners.length > 1}}" circular="{{banners.length > 1}}" indicator-dots="{{banners.length > 1}}" interval="4500" duration="400">
    <swiper-item wx:for="{{banners}}" wx:key="id">
      <view class="h-full w-full" aria-role="button" aria-label="{{item.accessibilityLabel}}" data-banner-id="{{item.id}}" bind:tap="openBanner">
        <image class="h-full w-full" mode="aspectFill" src="{{item.imageUrl}}" />
      </view>
    </swiper-item>
  </swiper>

  <view class="mt-3 flex h-[80rpx] items-center rounded-[16rpx] bg-panel" aria-role="tablist" aria-label="活动板块">
    <view class="flex min-w-0 flex-1 items-center justify-center gap-1" aria-role="tab" aria-selected="{{view === 'UPCOMING'}}" data-filter="RECENT" bind:tap="changeDateFilter">
      <mip-icon name="event-signup" size="{{16}}" color="{{view === 'UPCOMING' ? 'var(--color-brand)' : 'var(--color-muted)'}}" />
      <text wx:if="{{view === 'UPCOMING'}}" class="text-[32rpx] font-medium text-brand">活动报名</text>
      <text wx:else class="text-[32rpx] font-medium text-muted">活动报名</text>
    </view>
    <view class="flex min-w-0 flex-1 items-center justify-center gap-1" aria-role="tab" aria-selected="{{view === 'PAST'}}" data-filter="ENDED" bind:tap="changeDateFilter">
      <mip-icon name="event-past" size="{{16}}" color="{{view === 'PAST' ? 'var(--color-brand)' : 'var(--color-muted)'}}" />
      <text wx:if="{{view === 'PAST'}}" class="text-[32rpx] font-medium text-brand">往期活动</text>
      <text wx:else class="text-[32rpx] font-medium text-muted">往期活动</text>
    </view>
  </view>

  <view wx:if="{{view === 'UPCOMING'}}" class="mt-3 flex items-center gap-2" aria-role="radiogroup" aria-label="活动状态">
    <view class="flex items-center" aria-role="radio" aria-checked="{{dateFilter !== 'ENDED'}}" data-filter="RECENT" bind:tap="changeStatusFilter"><text wx:if="{{dateFilter !== 'ENDED'}}" class="rounded-[16rpx] bg-brand px-[16rpx] py-[8rpx] text-[28rpx] font-medium leading-[39.2rpx] text-on-brand">近期活动</text><text wx:else class="rounded-[16rpx] bg-panel px-[16rpx] py-[8rpx] text-[28rpx] font-medium leading-[39.2rpx] text-muted">近期活动</text></view>
    <view class="flex items-center" aria-role="radio" aria-checked="{{dateFilter === 'ENDED'}}" data-filter="ENDED" bind:tap="changeStatusFilter"><text wx:if="{{dateFilter === 'ENDED'}}" class="rounded-[16rpx] bg-brand px-[16rpx] py-[8rpx] text-[28rpx] font-medium leading-[39.2rpx] text-on-brand">已结束</text><text wx:else class="rounded-[16rpx] bg-panel px-[16rpx] py-[8rpx] text-[28rpx] font-medium leading-[39.2rpx] text-muted">已结束</text></view>
    <!-- MIW-37/MIW-39 figma 1819_17793: 默认只有日历入口；在日期选择器确认后才出现所选日期标签
         （选中当天显示「今天」，其他日期显示「M月D日」），点标签或 icon 都会再次打开选择器。 -->
    <view class="ml-auto flex h-[56rpx] shrink-0 items-center gap-2 rounded-[16rpx] bg-panel px-[16rpx]">
      <view wx:if="{{customDateLabel}}" class="whitespace-nowrap text-[28rpx] font-medium leading-[39.2rpx] text-brand" aria-role="button" aria-label="已选活动日期 {{customDateLabel}}" bind:tap="showCalendar">{{customDateLabel}}</view>
      <view class="flex h-[56rpx] w-[40rpx] shrink-0 items-center justify-center" aria-role="button" aria-label="选择活动日期" bind:tap="showCalendar"><mip-icon name="calendar-schedule" size="{{20}}" color="var(--color-brand)" /></view>
    </view>
  </view>

  <view wx:if="{{view === 'UPCOMING'}}" class="mt-3 flex items-center">
    <view class="flex h-[80rpx] min-w-0 flex-1 items-center gap-1 rounded-[16rpx] bg-panel px-3">
      <mip-icon name="search-big-left-1" size="{{16}}" color="var(--color-muted)" />
      <input class="box-border h-full min-w-0 flex-1 max-w-full text-[28rpx]" value="{{searchInput}}" bindinput="onSearchInput" bindconfirm="onSearchConfirm" confirm-type="search" maxlength="50" placeholder="搜索活动名称" aria-label="搜索活动名称" />
      <view wx:if="{{searchInput}}" class="flex h-full items-center px-2 text-[22rpx] text-muted" aria-role="button" aria-label="清除搜索" bind:tap="clearSearch">清除</view>
    </view>
  </view>

  <view wx:if="{{state === 'loading'}}" class="mip-events-loading mt-4 flex flex-col gap-3" aria-label="正在加载" aria-busy="true">
    <view class="rounded-[16rpx] bg-panel px-4 py-6"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
    <view class="rounded-[16rpx] bg-panel px-4 py-6"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  </view>
  <view wx:elif="{{state === 'error'}}" class="mt-5"><mip-empty-state title="暂时无法加载活动" description="请稍后重试。" action-text="重新加载" bind:action="loadEvents" /></view>
  <view wx:elif="{{events.length === 0}}" class="mt-5">
    <!-- MIW-57 往期活动 tab 展示后台配置的回顾条目，空态文案与活动报名 tab 分开。 -->
    <mip-empty-state wx:if="{{view === 'PAST'}}" title="暂无往期活动" description="往期回顾配置后会显示在这里。" />
    <mip-empty-state wx:else title="暂无活动" description="符合当前条件的活动会显示在这里。" />
  </view>
  <view wx:else id="events-list" class="mt-3 flex flex-col gap-3">
    <mip-activity-card wx:for="{{events}}" wx:key="id" event="{{item}}" variant="{{view === 'PAST' ? 'recap' : 'feed'}}" show-share="{{view !== 'PAST'}}" bind:select="openEvent" />
    <view wx:if="{{nextCursor}}" class="flex min-h-[88rpx] items-center justify-center rounded-[16rpx] bg-panel text-[24rpx] text-brand" bind:tap="loadMore">{{loadingMore ? '加载中' : '加载更多'}}</view>
    <view wx:else class="py-2 text-center text-[24rpx] text-muted">已显示全部活动</view>
  </view>
  <view wx:if="{{message && state !== 'error'}}" class="mt-4 rounded-[16rpx] bg-brand-soft px-4 py-3 text-[22rpx] text-brand">{{message}}</view>
  <view wx:if="{{cityNoticeVisible}}" class="events-city-notice" aria-role="dialog" aria-label="温馨提示">
    <view class="events-city-notice__panel">
      <view class="events-city-notice__title">温馨提示</view>
      <view class="events-city-notice__body"><view>MIP更多城市正在猛猛建设中</view><view>敬请期待~</view></view>
      <view class="events-city-notice__footer" aria-role="button" bind:tap="closeCityNotice">我知道了</view>
    </view>
  </view>

  <!-- MIW-37 figma 1819_17793 日期选择：按稿实现的选择弹层，替代 t-calendar（白底与稿不符）。
       层级取 11000（对话层）：底部确认按钮要压过 custom TabBar（9999）。 -->
  <view wx:if="{{calendarVisible}}" class="fixed left-0 top-0 z-[11000] h-full w-full overflow-hidden" catchtouchmove="noop">
    <view class="absolute inset-0 bg-[rgba(0,0,0,0.9)]" aria-role="button" aria-label="关闭日期选择" bind:tap="closeCalendar"></view>
    <view class="events-calendar-sheet absolute bottom-0 left-0 w-full rounded-t-[32rpx] bg-canvas">
      <view class="flex h-[96rpx] items-center justify-center">
        <text class="text-[32rpx] font-medium leading-[44.8rpx] text-brand">请选择活动日期</text>
      </view>
      <view class="flex h-[96rpx] items-center">
        <view class="relative flex h-full flex-1 items-center justify-center">
          <view class="absolute left-[48rpx] top-0 h-full w-[48rpx] flex items-center justify-center" aria-role="button" aria-label="上一年" data-delta="-1" bind:tap="shiftCalendarYear"><mip-icon class="rotate-180" name="chevron-right-1" size="{{12}}" color="var(--color-brand)" /></view>
          <view class="absolute right-[48rpx] top-0 h-full w-[48rpx] flex items-center justify-center" aria-role="button" aria-label="下一年" data-delta="1" bind:tap="shiftCalendarYear"><mip-icon name="chevron-right-1" size="{{12}}" color="var(--color-brand)" /></view>
          <view class="text-center text-[32rpx] font-semibold leading-[44.8rpx] text-ink">{{calendarYear}}</view>
        </view>
        <view class="relative flex h-full flex-1 items-center justify-center">
          <view class="absolute left-[48rpx] top-0 h-full w-[48rpx] flex items-center justify-center" aria-role="button" aria-label="上一月" data-delta="-1" bind:tap="shiftCalendarMonth"><mip-icon class="rotate-180" name="chevron-right-1" size="{{12}}" color="var(--color-brand)" /></view>
          <view class="absolute right-[48rpx] top-0 h-full w-[48rpx] flex items-center justify-center" aria-role="button" aria-label="下一月" data-delta="1" bind:tap="shiftCalendarMonth"><mip-icon name="chevron-right-1" size="{{12}}" color="var(--color-brand)" /></view>
          <view class="text-center text-[32rpx] font-semibold leading-[44.8rpx] text-ink">{{calendarMonth}}月</view>
        </view>
      </view>
      <view class="pb-[32rpx] pt-[22rpx]">
        <view class="flex justify-center gap-[4rpx]">
          <text wx:for="{{calendarWeekdays}}" wx:key="*this" class="h-[44rpx] w-[92rpx] text-center text-[32rpx] font-semibold leading-[44.8rpx] text-ink">{{item}}</text>
        </view>
        <view class="mt-[22rpx] flex flex-col justify-center gap-[4rpx]">
          <view wx:for="{{calendarWeeks}}" wx:for-item="week" wx:key="key" class="flex justify-center gap-[4rpx]">
            <view wx:for="{{week.cells}}" wx:for-item="cell" wx:key="key" class="relative flex h-[92rpx] w-[92rpx] items-center justify-center rounded-[16rpx] {{cell.cellClass}}" aria-role="button" aria-label="{{cell.key}}" aria-disabled="{{cell.disabled}}" data-date="{{cell.key}}" data-disabled="{{cell.disabled}}" bind:tap="pickCalendarDay">
              <text wx:if="{{cell.day}}" class="text-[32rpx] leading-[34.8rpx]">{{cell.day}}</text>
              <view wx:if="{{cell.dot}}" class="absolute bottom-[9rpx] left-[40rpx] h-[12rpx] w-[12rpx] rounded-full bg-brand"></view>
            </view>
          </view>
        </view>
      </view>
      <view class="flex h-[96rpx] items-center justify-center">
        <view class="flex h-[80rpx] w-[670rpx] items-center justify-center rounded-full bg-brand border border-black" aria-role="button" aria-label="确认所选日期" bind:tap="confirmCalendar">
          <text class="text-[32rpx] font-medium leading-[44.8rpx] text-canvas">确认</text>
        </view>
      </view>
      <!-- 稿内确认按钮下方的 home indicator 区（18px），设备上叠加 safe-area 兜住小白条。 -->
      <view class="h-[28rpx]"></view>
    </view>
  </view>

  <!-- figma 1824_19671 原生日期选择：wx picker 为原生组件，代理不渲染，fixture-gated 按稿绘制。 -->
  <view wx:if="{{figmaNativePicker}}" class="fixed left-0 top-0 z-50 h-[1350rpx] w-full overflow-hidden">
    <view class="absolute inset-0 bg-[rgba(0,0,0,0.675)]"></view>
    <view class="absolute left-0 top-[796rpx] h-[600rpx] w-full rounded-t-[24rpx] bg-[#333333]"></view>
    <text class="absolute left-[33rpx] top-[832rpx] text-[28rpx] font-semibold leading-[39.2rpx] text-ink">选择日期</text>
    <text class="absolute left-[148rpx] top-[956rpx] text-[32rpx] font-medium leading-[44.8rpx] text-ink">2025年</text>
    <text class="absolute left-[352rpx] top-[956rpx] text-[32rpx] font-medium leading-[44.8rpx] text-ink">8月</text>
    <text class="absolute left-[148rpx] top-[1066rpx] text-[32rpx] font-medium leading-[44.8rpx] text-ink">2026年</text>
    <text class="absolute left-[352rpx] top-[1066rpx] text-[32rpx] font-medium leading-[44.8rpx] text-ink">9月</text>
    <text class="absolute left-[531rpx] top-[1066rpx] text-[32rpx] font-medium leading-[44.8rpx] text-ink">1日</text>
    <text class="absolute left-[345rpx] top-[1181rpx] text-[32rpx] font-medium leading-[44.8rpx] text-ink">10月</text>
    <text class="absolute left-[528rpx] top-[1181rpx] text-[32rpx] font-medium leading-[44.8rpx] text-ink">2日</text>
    <view class="absolute left-[24rpx] top-[1031rpx] h-[2rpx] w-[702rpx] bg-[#474747]"></view>
    <view class="absolute left-[24rpx] top-[1143rpx] h-[2rpx] w-[702rpx] bg-[#474747]"></view>
    <view class="absolute left-[145rpx] top-[1324rpx] h-[80rpx] w-[210rpx] rounded-[16rpx] bg-[#3a3a3a]">
      <text class="flex h-full w-full items-center justify-center text-[32rpx] font-medium text-ink">取消</text>
    </view>
    <view class="absolute left-[390rpx] top-[1324rpx] h-[80rpx] w-[220rpx] rounded-[16rpx] bg-[#07c160]">
      <text class="flex h-full w-full items-center justify-center text-[32rpx] font-medium text-[#0a0a0a]">完成</text>
    </view>
  </view>
</view>
