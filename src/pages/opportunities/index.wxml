<view id="mip-opportunities-page" class="mip-member-page mip-member-tab-page min-h-screen bg-canvas pb-[calc(env(safe-area-inset-bottom)+220rpx)] text-ink">
  <app-top-safe-area id="opportunities-status-bar" />
  <view id="opportunities-custom-navigation" class="box-border flex h-[88rpx] items-center pl-3 pr-[200rpx]">
    <view wx:if="{{filterOpen}}" id="opportunities-filter-toggle" class="flex h-[88rpx] max-w-[360rpx] min-w-0 items-center gap-1 text-[length:32rpx] font-medium" aria-role="button" aria-label="关闭筛选" aria-expanded="true" bind:tap="toggleFilters">
      <t-icon name="chevron-left" size="36rpx" color="var(--color-ink)" />
      <text class="min-w-0 truncate">筛选</text>
    </view>
    <view wx:else class="max-w-[360rpx] min-w-0 text-[length:32rpx] font-medium"><text class="block truncate">{{mode === 'opportunities' ? '机会' : '人才合作'}}</text></view>
  </view>

  <block wx:if="{{filterOpen}}">
    <view id="opportunities-filter-page" class="opportunities-filter-panel mx-3 pb-[280rpx] pt-2">
      <view class="flex min-h-[88rpx] items-center justify-between border-b border-line">
        <view class="text-[length:30rpx] font-semibold">筛选条件</view>
        <view class="flex min-h-[88rpx] items-center px-2 text-[length:24rpx] text-brand" aria-role="button" bind:tap="resetFilters">清除</view>
      </view>

      <block wx:if="{{mode === 'opportunities'}}">
        <view class="mt-4 text-[length:25rpx] font-semibold">合作地点</view>
        <view class="mt-2 flex flex-wrap gap-2">
          <view wx:if="{{draftLocationPreset === 'ALL'}}" class="flex min-h-[88rpx] items-center rounded-full bg-brand px-4 py-2 text-[length:24rpx] text-on-brand" aria-role="radio" aria-checked="true" data-preset="ALL" bind:tap="chooseLocationPreset">不限</view>
          <view wx:else class="flex min-h-[88rpx] items-center rounded-full bg-panel-raised px-4 py-2 text-[length:24rpx] text-muted" aria-role="radio" aria-checked="false" data-preset="ALL" bind:tap="chooseLocationPreset">不限</view>
          <view wx:if="{{draftLocationPreset === 'REMOTE'}}" class="flex min-h-[88rpx] items-center rounded-full bg-brand px-4 py-2 text-[length:24rpx] text-on-brand" aria-role="radio" aria-checked="true" data-preset="REMOTE" bind:tap="chooseLocationPreset">远程</view>
          <view wx:else class="flex min-h-[88rpx] items-center rounded-full bg-panel-raised px-4 py-2 text-[length:24rpx] text-muted" aria-role="radio" aria-checked="false" data-preset="REMOTE" bind:tap="chooseLocationPreset">远程</view>
          <view wx:if="{{draftLocationPreset === 'NATIONAL'}}" class="flex min-h-[88rpx] items-center rounded-full bg-brand px-4 py-2 text-[length:24rpx] text-on-brand" aria-role="radio" aria-checked="true" data-preset="NATIONAL" bind:tap="chooseLocationPreset">全国</view>
          <view wx:else class="flex min-h-[88rpx] items-center rounded-full bg-panel-raised px-4 py-2 text-[length:24rpx] text-muted" aria-role="radio" aria-checked="false" data-preset="NATIONAL" bind:tap="chooseLocationPreset">全国</view>
          <view wx:if="{{draftLocationPreset === 'CITY'}}" class="flex min-h-[88rpx] items-center rounded-full bg-brand px-4 py-2 text-[length:24rpx] text-on-brand" aria-role="radio" aria-checked="true" data-preset="CITY" bind:tap="chooseLocationPreset">城市</view>
          <view wx:else class="flex min-h-[88rpx] items-center rounded-full bg-panel-raised px-4 py-2 text-[length:24rpx] text-muted" aria-role="radio" aria-checked="false" data-preset="CITY" bind:tap="chooseLocationPreset">城市</view>
        </view>
        <view wx:if="{{draftLocationPreset === 'CITY'}}" class="mt-3 rounded-[16rpx] border border-line bg-panel px-3 py-3">
          <mip-catalog-selector title="城市" groups="{{cityGroups}}" selected-ids="{{citySelectionIds}}" multiple="{{false}}" clear-label="全部城市" bind:change="changeCity" />
        </view>
      </block>
      <view wx:else class="mt-4 rounded-[16rpx] border border-line bg-panel px-3 py-3">
        <mip-catalog-selector title="城市分会" groups="{{cityGroups}}" selected-ids="{{citySelectionIds}}" multiple="{{false}}" clear-label="全部分会" bind:change="changeCity" />
      </view>

      <view class="mt-5 text-[length:25rpx] font-semibold">合作角色</view>
      <view class="mt-2 flex flex-wrap gap-2">
        <block wx:for="{{roleOptions}}" wx:key="key">
          <view wx:if="{{draftRoleKey === item.key}}" class="flex min-h-[88rpx] items-center rounded-full bg-brand px-4 py-2 text-[length:24rpx] text-on-brand" aria-role="radio" aria-checked="true" data-key="{{item.key}}" bind:tap="chooseRole">{{item.name}}</view>
          <view wx:else class="flex min-h-[88rpx] items-center rounded-full bg-panel-raised px-4 py-2 text-[length:24rpx] text-muted" aria-role="radio" aria-checked="false" data-key="{{item.key}}" bind:tap="chooseRole">{{item.name}}</view>
        </block>
      </view>

      <view class="mt-5 overflow-hidden rounded-[16rpx] border border-line bg-panel">
        <view id="opportunities-industry-toggle" class="flex min-h-[96rpx] items-center gap-2 px-3" aria-role="button" aria-expanded="{{industryPickerOpen}}" bind:tap="toggleIndustryPicker">
          <view class="min-w-0 flex-1"><view class="text-[length:25rpx] font-semibold">行业</view><view class="mt-1 truncate text-[length:22rpx] text-muted">{{draftIndustryTagIds.length ? draftIndustryTagIds.length + ' 项已选' : '不限'}}</view></view>
          <t-icon name="{{industryPickerOpen ? 'chevron-up' : 'chevron-down'}}" size="32rpx" color="var(--color-muted)" />
        </view>
        <view wx:if="{{industryPickerOpen}}" class="border-t border-line px-3 pb-3">
          <view class="mt-3 flex flex-wrap gap-2">
            <view wx:if="{{!draftIndustryTagIds.length}}" class="flex min-h-[88rpx] items-center rounded-full bg-brand px-4 py-2 text-[length:24rpx] text-on-brand" aria-role="button" aria-pressed="true" bind:tap="clearIndustrySelection">不限</view>
            <view wx:else class="flex min-h-[88rpx] items-center rounded-full bg-panel-raised px-4 py-2 text-[length:24rpx] text-muted" aria-role="button" aria-pressed="false" bind:tap="clearIndustrySelection">不限</view>
          </view>
          <block wx:if="{{popularIndustryOptions.length}}">
            <view class="mt-3 text-[length:22rpx] text-muted">热门行业</view>
            <view class="mt-2 flex flex-wrap gap-2">
              <block wx:for="{{popularIndustryOptions}}" wx:key="id">
                <view wx:if="{{item.selected}}" class="flex min-h-[88rpx] items-center rounded-full bg-brand px-4 py-2 text-[length:24rpx] text-on-brand" aria-role="checkbox" aria-checked="true" data-type="industry" data-id="{{item.id}}" bind:tap="toggleTag">{{item.label}}</view>
                <view wx:else class="flex min-h-[88rpx] items-center rounded-full bg-panel-raised px-4 py-2 text-[length:24rpx] text-muted" aria-role="checkbox" aria-checked="false" data-type="industry" data-id="{{item.id}}" bind:tap="toggleTag">{{item.label}}</view>
              </block>
            </view>
          </block>
          <view wx:if="{{industryGroups.length}}" class="mt-3 overflow-hidden rounded-[12rpx] border border-line">
            <block wx:for="{{industryGroups}}" wx:for-item="group" wx:key="id">
              <view class="flex min-h-[88rpx] items-center gap-2 border-b border-line px-3 last:border-b-0" aria-role="button" aria-expanded="{{expandedIndustryGroupId === group.id}}" data-group-id="{{group.id}}" bind:tap="toggleIndustryGroup"><text class="min-w-0 flex-1 truncate text-[length:24rpx]">{{group.label}}</text><t-icon name="{{expandedIndustryGroupId === group.id ? 'chevron-up' : 'chevron-down'}}" size="28rpx" color="var(--color-muted)" /></view>
              <view wx:if="{{expandedIndustryGroupId === group.id}}" class="flex flex-wrap gap-2 border-b border-line bg-panel-raised px-3 py-3">
                <block wx:for="{{group.options}}" wx:for-item="option" wx:key="id">
                  <view wx:if="{{option.selected}}" class="flex min-h-[88rpx] items-center rounded-full bg-brand px-4 py-2 text-[length:24rpx] text-on-brand" aria-role="checkbox" aria-checked="true" data-type="industry" data-id="{{option.id}}" bind:tap="toggleTag">{{option.label}}</view>
                  <view wx:else class="flex min-h-[88rpx] items-center rounded-full bg-panel px-4 py-2 text-[length:24rpx] text-muted" aria-role="checkbox" aria-checked="false" data-type="industry" data-id="{{option.id}}" bind:tap="toggleTag">{{option.label}}</view>
                </block>
              </view>
            </block>
          </view>
        </view>
      </view>

      <block wx:if="{{mode === 'opportunities'}}">
        <view class="mt-3 overflow-hidden rounded-[16rpx] border border-line bg-panel">
          <view id="opportunities-more-filter-toggle" class="flex min-h-[96rpx] items-center gap-2 px-3" aria-role="button" aria-expanded="{{moreFiltersOpen}}" bind:tap="toggleMoreFilters">
            <view class="min-w-0 flex-1"><view class="text-[length:25rpx] font-semibold">更多筛选</view><view class="mt-1 truncate text-[length:22rpx] text-muted">能力与金额</view></view>
            <t-icon name="{{moreFiltersOpen ? 'chevron-up' : 'chevron-down'}}" size="32rpx" color="var(--color-muted)" />
          </view>
          <view wx:if="{{moreFiltersOpen}}" class="border-t border-line px-3 pb-3">
            <view wx:if="{{abilityOptions.length}}" class="mt-3 text-[length:22rpx] text-muted">能力</view>
            <view wx:if="{{abilityOptions.length}}" class="mt-2 flex flex-wrap gap-2">
              <block wx:for="{{abilityOptions}}" wx:key="id">
                <view wx:if="{{item.selected}}" class="flex min-h-[88rpx] items-center rounded-full bg-brand px-4 py-2 text-[length:24rpx] text-on-brand" aria-role="checkbox" aria-checked="true" data-type="ability" data-id="{{item.id}}" bind:tap="toggleTag">{{item.label}}</view>
                <view wx:else class="flex min-h-[88rpx] items-center rounded-full bg-panel-raised px-4 py-2 text-[length:24rpx] text-muted" aria-role="checkbox" aria-checked="false" data-type="ability" data-id="{{item.id}}" bind:tap="toggleTag">{{item.label}}</view>
              </block>
            </view>
            <view class="mt-3 text-[length:22rpx] text-muted">金额（元）</view>
            <view class="mt-2 grid grid-cols-2 gap-2">
              <input class="box-border h-[88rpx] min-w-0 rounded-[12rpx] bg-panel-raised px-3 text-[length:24rpx]" type="digit" value="{{draftMinAmountYuan}}" placeholder="最低金额" data-field="draftMinAmountYuan" bindinput="updateAmount" />
              <input class="box-border h-[88rpx] min-w-0 rounded-[12rpx] bg-panel-raised px-3 text-[length:24rpx]" type="digit" value="{{draftMaxAmountYuan}}" placeholder="最高金额" data-field="draftMaxAmountYuan" bindinput="updateAmount" />
            </view>
          </view>
        </view>
      </block>

      <view wx:if="{{message}}" class="mt-3 rounded-[12rpx] border border-line bg-panel px-3 py-3 text-[length:22rpx] text-danger">{{message}}</view>
    </view>

    <view id="opportunities-filter-actions" class="mip-member-fixed-inset opportunities-filter-actions fixed inset-x-3 bottom-[calc(env(safe-area-inset-bottom)+112rpx)] z-20 grid min-h-[112rpx] grid-cols-2 items-center gap-2 rounded-full border border-brand bg-brand-soft p-2">
      <view class="min-w-0"><t-button block size="large" variant="outline" theme="primary" bind:tap="resetFilters">清除</t-button></view>
      <view class="min-w-0"><t-button block size="large" theme="primary" bind:tap="applyFilters">确认筛选</t-button></view>
    </view>
  </block>

  <block wx:else>
    <view class="flex h-[80rpx] border-b border-line">
      <view wx:if="{{mode === 'opportunities'}}" class="opportunities-tab-hit relative flex flex-1 items-center justify-center text-[length:32rpx] font-medium text-brand" data-mode="opportunities" aria-role="tab" aria-selected="true" bind:tap="changeMode">机会搜索<view class="absolute inset-x-0 bottom-[-2rpx] h-[4rpx] bg-brand" /></view>
      <view wx:else class="opportunities-tab-hit relative flex flex-1 items-center justify-center text-[length:32rpx] text-muted" data-mode="opportunities" aria-role="tab" aria-selected="false" bind:tap="changeMode">机会搜索</view>
      <view wx:if="{{mode === 'cooperation'}}" class="opportunities-tab-hit relative flex flex-1 items-center justify-center text-[length:32rpx] font-medium text-brand" data-mode="cooperation" aria-role="tab" aria-selected="true" bind:tap="changeMode">人才合作<view class="absolute inset-x-0 bottom-[-2rpx] h-[4rpx] bg-brand" /></view>
      <view wx:else class="opportunities-tab-hit relative flex flex-1 items-center justify-center text-[length:32rpx] text-muted" data-mode="cooperation" aria-role="tab" aria-selected="false" bind:tap="changeMode">人才合作</view>
    </view>

    <view class="mx-3 mt-3 flex h-[80rpx] items-center gap-2">
      <view class="flex h-[80rpx] min-w-0 flex-1 items-center gap-2 rounded-[16rpx] bg-panel px-3">
        <t-icon name="search" size="36rpx" color="var(--color-muted)" />
        <input id="opportunities-search-input" class="box-border min-w-0 flex-1 max-w-full text-[length:28rpx]" value="{{keywordInput}}" maxlength="80" confirm-type="search" placeholder="{{mode === 'opportunities' ? '搜索机会、行业或能力' : '搜索人才或合作方向'}}" bindinput="onKeywordInput" bindconfirm="onSearchConfirm" />
        <view wx:if="{{keywordInput}}" class="flex min-h-[80rpx] items-center px-2 text-[length:24rpx] text-muted" aria-role="button" bind:tap="clearSearch">清除</view>
      </view>
      <view id="opportunities-filter-toggle" class="relative flex h-[80rpx] w-[144rpx] shrink-0 items-center justify-center gap-1 rounded-[16rpx] bg-panel text-[length:28rpx] text-muted active:bg-panel-raised" aria-role="button" aria-expanded="false" bind:tap="toggleFilters">
        <t-icon name="filter" size="30rpx" color="var(--color-muted)" /><text>筛选</text>
        <view wx:if="{{appliedFilterCount}}" class="absolute right-[10rpx] top-[8rpx] flex h-[28rpx] min-w-[28rpx] items-center justify-center rounded-full bg-brand px-1 text-[length:18rpx] text-on-brand">{{appliedFilterCount}}</view>
      </view>
    </view>

    <view wx:if="{{appliedFilterChips.length}}" class="mx-3 mt-2 flex min-h-[64rpx] items-center gap-2 overflow-hidden">
      <scroll-view class="min-w-0 flex-1 whitespace-nowrap" scroll-x enhanced show-scrollbar="{{false}}"><view class="inline-flex gap-2 pr-2"><view wx:for="{{appliedFilterChips}}" wx:key="key" class="inline-flex h-[56rpx] items-center rounded-full bg-panel px-3 text-[length:22rpx] text-muted">{{item.label}}</view></view></scroll-view>
      <view class="flex min-h-[64rpx] shrink-0 items-center px-2 text-[length:22rpx] text-brand" aria-role="button" bind:tap="clearAppliedFilters">清除筛选</view>
    </view>

    <view wx:if="{{mode === 'opportunities'}}" class="mx-3 mt-3 flex h-[56rpx] items-center gap-3">
      <view class="opportunities-chip-hit" aria-role="radio" aria-checked="{{status === 'RECRUITING'}}" data-status="RECRUITING" bind:tap="changeStatus"><view wx:if="{{status === 'RECRUITING'}}" class="flex h-[56rpx] items-center rounded-[16rpx] bg-brand px-2 text-[length:28rpx] font-medium text-on-brand">招募中</view><view wx:else class="flex h-[56rpx] items-center rounded-[16rpx] bg-panel px-2 text-[length:28rpx] font-medium text-muted">招募中</view></view>
      <view class="opportunities-chip-hit" aria-role="radio" aria-checked="{{status === 'COMPLETED'}}" data-status="COMPLETED" bind:tap="changeStatus"><view wx:if="{{status === 'COMPLETED'}}" class="flex h-[56rpx] items-center rounded-[16rpx] bg-brand px-2 text-[length:28rpx] font-medium text-on-brand">已完成</view><view wx:else class="flex h-[56rpx] items-center rounded-[16rpx] bg-panel px-2 text-[length:28rpx] font-medium text-muted">已完成</view></view>
      <view class="flex-1" />
      <view class="opportunities-chip-hit" aria-role="button" bind:tap="publish"><view class="flex h-[56rpx] items-center gap-1 rounded-[16rpx] bg-brand px-2 text-[length:28rpx] font-medium text-on-brand active:bg-brand-active"><image class="h-[28rpx] w-[28rpx]" src="/assets/figma/opportunities/publish-plus.svg" mode="aspectFit" /><text>发布机会</text></view></view>
    </view>
    <view wx:else class="mx-3 mt-3 flex h-[56rpx] items-center justify-end"><view class="opportunities-chip-hit" aria-role="button" bind:tap="publish"><view class="flex h-[56rpx] items-center rounded-[16rpx] bg-brand px-3 text-[length:28rpx] font-medium text-on-brand active:bg-brand-active">创建合作卡</view></view></view>

    <view class="mx-3 mt-2 grid grid-cols-3 rounded-[16rpx] border border-line bg-panel">
      <view class="flex min-h-[88rpx] items-center justify-center text-[length:24rpx] text-muted" aria-role="button" bind:tap="openPeople">{{mode === 'opportunities' ? '找人才' : '人才名录'}}</view>
      <view class="flex min-h-[88rpx] items-center justify-center border-l border-line text-[length:24rpx] text-muted" aria-role="button" bind:tap="openMatching">机会撮合</view>
      <view class="flex min-h-[88rpx] items-center justify-center border-l border-line text-[length:24rpx] text-muted" aria-role="button" bind:tap="openMine">{{mode === 'opportunities' ? '我的机会' : '我的合作卡'}}</view>
    </view>
    <view wx:if="{{mode === 'cooperation'}}" class="mx-3 mt-2 flex min-h-[64rpx] items-center justify-between text-[length:22rpx] text-muted"><text>按合作角色查看已发布的合作卡</text><view class="flex min-h-[64rpx] items-center px-2 text-brand" aria-role="button" bind:tap="openCases">超级案例</view></view>

    <view wx:if="{{state === 'loading'}}" class="mip-opportunities-loading mx-3 mt-3 flex flex-col gap-3">
      <view class="flex h-[352rpx] rounded-[16rpx] bg-panel p-2"><view class="h-[320rpx] w-[240rpx] shrink-0 rounded-[8rpx] bg-panel-raised" /><view class="min-w-0 flex-1 px-2 py-2"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view></view>
      <view class="flex h-[352rpx] rounded-[16rpx] bg-panel p-2"><view class="h-[320rpx] w-[240rpx] shrink-0 rounded-[8rpx] bg-panel-raised" /><view class="min-w-0 flex-1 px-2 py-2"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view></view>
    </view>
    <view wx:elif="{{state === 'error'}}" class="mx-3 mt-5"><app-empty-state title="暂时无法加载内容" description="{{message}}" action-text="重新加载" bind:action="retryLoad" /></view>
    <view wx:elif="{{mode === 'opportunities' && !opportunities.length}}" class="mx-3 mt-5"><app-empty-state title="没有找到相关机会" description="调整筛选条件后重试。" action-text="{{hasAppliedFilters ? '清除筛选' : ''}}" bind:action="clearAppliedFilters" /></view>
    <view wx:elif="{{mode === 'cooperation' && !cooperationTalents.length}}" class="mx-3 mt-5"><app-empty-state title="没有找到人才" description="{{hasAppliedFilters ? '调整筛选条件后重试。' : '已发布合作卡的人才会显示在这里。'}}" action-text="{{hasAppliedFilters ? '清除筛选' : ''}}" bind:action="clearAppliedFilters" /></view>

    <view wx:if="{{state === 'ready' && mode === 'opportunities'}}" class="mx-3 mt-3 flex flex-col gap-3">
      <!-- The shared opportunity card keeps the frozen 120x160 cover contract and count-only referral treatment. -->
      <view wx:for="{{opportunities}}" wx:key="id" class="active:bg-panel-raised" aria-role="button" data-id="{{item.id}}" bind:tap="openOpportunity"><mip-opportunity-card title="{{item.title}}" cover-url="{{item.coverUrl || ''}}" value-text="{{item.commercialTerms.amountDisplay || item.valueSummary}}" location-text="{{item.commercialTerms.locationDisplay || item.city.label || item.branchName || '全国'}}" target-text="{{item.targetSummary}}" referral-count="{{item.referralCount}}" /></view>
    </view>

    <view wx:if="{{state === 'ready' && mode === 'cooperation'}}" class="mx-3 mt-3 flex flex-col gap-3">
      <view wx:for="{{cooperationTalents}}" wx:key="talentKey" class="active:bg-panel-raised" aria-role="button" data-profile-ref="{{item.profileRef}}" bind:tap="openTalent"><mip-talent-card display-name="{{item.author.nickname}}" avatar-url="{{item.author.avatarUrl || ''}}" meta-text="{{item.author.cityName || '城市未公开'}}{{item.author.primaryIndustry ? '｜' + item.author.primaryIndustry.label : ''}}{{item.author.headline ? '｜' + item.author.headline : ''}}" supporting-text="{{item.primaryPositioning}}" role-names="{{item.roleNames}}" target-text="{{item.primaryTargetSummary}}" /></view>
    </view>
    <view wx:if="{{loadingMore}}" class="py-5 text-center text-[length:24rpx] text-muted">正在加载</view>
    <view wx:if="{{message && state === 'ready'}}" class="mx-3 mt-4 rounded-[12rpx] border border-line bg-panel px-4 py-3 text-[length:22rpx] text-muted">{{message}}</view>
  </block>
</view>
