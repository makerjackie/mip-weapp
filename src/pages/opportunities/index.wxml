<view id="mip-opportunities-page" class="min-h-screen bg-canvas px-3 pb-[calc(env(safe-area-inset-bottom)+220rpx)] pt-3 text-ink">
  <view class="flex flex-col gap-2 px-1">
    <view class="flex items-center justify-between gap-3">
      <view class="flex min-h-[88rpx] min-w-0 items-center gap-1 text-[length:28rpx] font-semibold" aria-role="button" aria-expanded="{{filterOpen}}" bind:tap="toggleFilters"><text class="truncate">{{cityOptions[cityIndex].label}}</text><t-icon name="chevron-down" size="28rpx" color="var(--color-ink)" /></view>
      <view class="flex min-h-[88rpx] shrink-0 items-center rounded-[12rpx] bg-brand px-4 py-3 text-[length:23rpx] font-semibold text-on-brand active:bg-brand-active" aria-role="button" bind:tap="publish">{{mode === 'opportunities' ? '发布机会' : '创建合作卡'}}</view>
    </view>
    <view class="grid grid-cols-2 gap-2">
      <view class="flex min-h-[88rpx] items-center justify-center rounded-[12rpx] border border-line px-3 py-2 text-[length:22rpx] text-muted active:bg-panel" aria-role="button" bind:tap="openPeople">找人才</view>
      <view class="flex min-h-[88rpx] items-center justify-center rounded-[12rpx] border border-line px-3 py-2 text-[length:22rpx] text-muted active:bg-panel" aria-role="button" bind:tap="openMine">我的机会</view>
    </view>
  </view>

  <view class="mt-2 flex border-b border-line">
    <view wx:if="{{mode === 'opportunities'}}" class="relative flex-1 py-3 text-center text-[length:28rpx] font-semibold text-ink" data-mode="opportunities" bind:tap="changeMode">机会搜索<view class="absolute bottom-0 left-1/2 h-[4rpx] w-[64rpx] -translate-x-1/2 rounded-full bg-brand" /></view>
    <view wx:else class="relative flex-1 py-3 text-center text-[length:28rpx] text-muted" data-mode="opportunities" bind:tap="changeMode">机会搜索</view>
    <view wx:if="{{mode === 'cooperation'}}" class="relative flex-1 py-3 text-center text-[length:28rpx] font-semibold text-ink" data-mode="cooperation" bind:tap="changeMode">人才合作<view class="absolute bottom-0 left-1/2 h-[4rpx] w-[64rpx] -translate-x-1/2 rounded-full bg-brand" /></view>
    <view wx:else class="relative flex-1 py-3 text-center text-[length:28rpx] text-muted" data-mode="cooperation" bind:tap="changeMode">人才合作</view>
  </view>

  <view class="mt-3 flex items-center gap-2">
    <view class="flex min-h-[88rpx] min-w-0 flex-1 items-center gap-2 rounded-[12rpx] bg-panel px-3">
      <t-icon name="search" size="32rpx" color="var(--color-muted)" />
      <input id="opportunities-search-input" class="box-border min-w-0 flex-1 max-w-full text-[length:24rpx]" value="{{keywordInput}}" maxlength="80" confirm-type="search" placeholder="{{mode === 'cooperation' ? '搜索合作方向或成员' : '搜索机会、行业或能力'}}" bindinput="onKeywordInput" bindconfirm="onSearchConfirm" />
      <view wx:if="{{keywordInput}}" class="px-2 py-2 text-[length:21rpx] text-muted" bind:tap="clearSearch">清除</view>
    </view>
    <view id="opportunities-filter-toggle" class="flex h-[88rpx] w-[88rpx] items-center justify-center rounded-[12rpx] border border-line bg-panel active:bg-panel-raised" aria-role="button" aria-expanded="{{filterOpen}}" bind:tap="toggleFilters">
      <t-icon name="filter" size="34rpx" color="var(--color-ink)" />
    </view>
  </view>

  <view wx:if="{{mode === 'opportunities'}}" class="mt-3 flex gap-2">
    <view wx:if="{{status === 'RECRUITING'}}" class="flex min-h-[88rpx] items-center rounded-full bg-brand px-4 py-2 text-[length:22rpx] font-semibold text-on-brand" aria-role="radio" aria-checked="true" data-status="RECRUITING" bind:tap="changeStatus">招募中 · 已选</view><view wx:else class="flex min-h-[88rpx] items-center rounded-full bg-panel px-4 py-2 text-[length:22rpx] text-muted" aria-role="radio" aria-checked="false" data-status="RECRUITING" bind:tap="changeStatus">招募中</view>
    <view wx:if="{{status === 'COMPLETED'}}" class="flex min-h-[88rpx] items-center rounded-full bg-brand px-4 py-2 text-[length:22rpx] font-semibold text-on-brand" aria-role="radio" aria-checked="true" data-status="COMPLETED" bind:tap="changeStatus">已完成 · 已选</view><view wx:else class="flex min-h-[88rpx] items-center rounded-full bg-panel px-4 py-2 text-[length:22rpx] text-muted" aria-role="radio" aria-checked="false" data-status="COMPLETED" bind:tap="changeStatus">已完成</view>
  </view>

  <view wx:if="{{filterOpen}}" class="mt-3 rounded-[16rpx] border border-line bg-panel px-4 py-4">
    <view class="flex items-center justify-between"><view class="text-[length:25rpx] font-semibold">筛选条件</view><view class="text-[length:21rpx] text-brand" bind:tap="resetFilters">重置</view></view>
    <view class="mt-4"><mip-catalog-selector title="城市" groups="{{cityGroups}}" selected-ids="{{citySelectionIds}}" multiple="{{false}}" clear-label="全国" bind:change="changeCity" /></view>
    <view class="mt-4 text-[length:25rpx] font-semibold">合作角色</view>
    <view class="mt-3 flex flex-wrap gap-2">
      <block wx:for="{{roleOptions}}" wx:key="key"><view wx:if="{{draftRoleKey === item.key}}" class="rounded-full bg-brand px-3 py-2 text-[length:21rpx] text-on-brand" data-key="{{item.key}}" bind:tap="chooseRole">{{item.name}}</view><view wx:else class="rounded-full bg-panel-raised px-3 py-2 text-[length:21rpx] text-muted" data-key="{{item.key}}" bind:tap="chooseRole">{{item.name}}</view></block>
    </view>
    <view wx:if="{{industryGroups.length}}" class="mt-4"><mip-catalog-selector title="行业" groups="{{industryGroups}}" selected-ids="{{draftIndustryTagIds}}" multiple="{{true}}" max-selections="{{8}}" clear-label="不限" bind:change="changeIndustry" /></view>
    <block wx:if="{{mode === 'opportunities'}}">
      <view wx:if="{{abilityOptions.length}}" class="mt-4 text-[length:25rpx] font-semibold">能力</view>
      <view class="mt-2 flex flex-wrap gap-2">
        <block wx:for="{{abilityOptions}}" wx:key="id"><view wx:if="{{item.selected}}" class="rounded-full bg-brand px-3 py-2 text-[length:21rpx] text-on-brand" data-type="ability" data-id="{{item.id}}" bind:tap="toggleTag">{{item.label}}</view><view wx:else class="rounded-full bg-panel-raised px-3 py-2 text-[length:21rpx] text-muted" data-type="ability" data-id="{{item.id}}" bind:tap="toggleTag">{{item.label}}</view></block>
      </view>
    </block>
    <view class="mt-5 flex gap-2"><t-button class="min-w-0 flex-1" block variant="outline" bind:tap="resetFilters">重置</t-button><t-button class="min-w-0 flex-1" block theme="primary" bind:tap="applyFilters">确认筛选</t-button></view>
  </view>

  <view wx:if="{{mode === 'cooperation'}}" class="mt-3 flex items-center justify-between rounded-[12rpx] border border-line px-3 py-3 text-[length:22rpx]">
    <view class="text-muted">按合作角色查看已发布的合作卡</view>
    <view class="text-brand" bind:tap="openCases">超级案例</view>
  </view>

  <view wx:if="{{state === 'loading'}}" class="mt-4 flex flex-col gap-3">
    <view class="rounded-[16rpx] bg-panel px-4 py-6"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
    <view class="rounded-[16rpx] bg-panel px-4 py-6"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  </view>
  <view wx:elif="{{state === 'error'}}" class="mt-5"><app-empty-state title="暂时无法加载内容" description="{{message}}" action-text="重新加载" bind:action="retryLoad" /></view>
  <view wx:elif="{{mode === 'opportunities' && !opportunities.length}}" class="mt-5"><app-empty-state title="没有找到相关机会" description="调整筛选条件后重试。" action-text="{{hasAppliedFilters ? '清除筛选' : ''}}" bind:action="clearAppliedFilters" /></view>
  <view wx:elif="{{mode === 'cooperation' && !cooperationCards.length}}" class="mt-5"><app-empty-state title="没有找到合作卡" description="{{hasAppliedFilters ? '调整筛选条件后重试。' : '已发布的合作卡会显示在这里。'}}" action-text="{{hasAppliedFilters ? '清除筛选' : ''}}" bind:action="clearAppliedFilters" /></view>

  <view wx:if="{{state === 'ready' && mode === 'opportunities'}}" class="mt-4 flex flex-col gap-3">
    <view wx:for="{{opportunities}}" wx:key="id" class="flex min-h-[352rpx] overflow-hidden rounded-[16rpx] bg-panel p-2 active:bg-panel-raised" data-id="{{item.id}}" bind:tap="openOpportunity">
      <view class="flex w-[240rpx] shrink-0 items-center justify-center overflow-hidden rounded-[12rpx] bg-panel-raised">
        <image wx:if="{{item.coverUrl}}" class="h-full w-full" src="{{item.coverUrl}}" mode="aspectFill" />
        <t-icon wx:else name="undertake-delivery" size="72rpx" color="var(--color-brand)" />
      </view>
      <view class="flex min-w-0 flex-1 flex-col px-3 py-2">
        <view class="line-clamp-2 text-[length:28rpx] font-semibold leading-6">{{item.title}}</view>
        <view class="mt-2 line-clamp-2 text-[length:22rpx] leading-5 text-muted">{{item.valueSummary}}</view>
        <view class="mt-2 flex items-center gap-1 text-[length:21rpx] text-muted"><t-icon name="location" size="25rpx" color="var(--color-muted)" /><text>{{item.city.label || item.branchName || '全国'}}</text></view>
        <view class="mt-2 line-clamp-2 text-[length:22rpx] leading-5"><text class="text-muted">寻找：</text>{{item.targetSummary}}</view>
        <view class="mt-auto flex items-center justify-between pt-2">
          <view class="truncate text-[length:20rpx] text-muted">{{item.author.nickname}}</view>
          <view class="rounded-full bg-brand-soft px-3 py-1 text-[length:20rpx] text-brand">{{item.referralCount}} 人引荐</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{state === 'ready' && mode === 'cooperation'}}" class="mt-4 flex flex-col gap-3">
    <view wx:for="{{cooperationCards}}" wx:key="id" class="rounded-[16rpx] bg-panel px-4 py-4 active:bg-panel-raised" data-id="{{item.id}}" bind:tap="openCooperationCard">
      <view class="flex items-center justify-between"><view class="rounded-full bg-brand px-3 py-1 text-[length:20rpx] font-semibold text-on-brand">{{item.roleName}}</view><view class="text-[length:20rpx] text-muted">{{item.author.cityName || '城市未公开'}}</view></view>
      <view class="mt-3 flex items-center gap-3"><image wx:if="{{item.author.avatarUrl}}" class="h-[72rpx] w-[72rpx] shrink-0 rounded-full bg-panel-raised" src="{{item.author.avatarUrl}}" mode="aspectFill" /><view class="min-w-0 flex-1"><view class="truncate text-[length:28rpx] font-semibold">{{item.author.nickname}}</view><view wx:if="{{item.author.headline || item.author.primaryIndustry}}" class="mt-1 truncate text-[length:21rpx] text-muted">{{item.author.headline || item.author.primaryIndustry.label}}</view></view></view>
      <view class="mt-2 line-clamp-2 text-[length:23rpx] leading-6 text-muted">{{item.positioning}}</view>
      <view class="mt-3 border-t border-line pt-3 text-[length:22rpx]"><text class="text-muted">合作目标：</text>{{item.targetSummary}}</view>
    </view>
  </view>
  <view wx:if="{{loadingMore}}" class="py-5 text-center text-[length:21rpx] text-muted">正在加载</view>
  <view wx:if="{{message && state === 'ready'}}" class="mt-4 rounded-[12rpx] border border-line bg-panel px-4 py-3 text-[length:22rpx] text-muted">{{message}}</view>
</view>
