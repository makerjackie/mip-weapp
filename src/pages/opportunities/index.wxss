
.opportunities-tab-hit {
  min-height: 88rpx;
  margin: -4rpx 0;
}

.opportunities-chip-hit {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  min-height: 88rpx;
  margin: -16rpx 0;
  white-space: nowrap;
}

.opportunities-filter-actions {
  box-sizing: border-box;
}

/* Keep the final filter row above the fixed confirmation bar on short screens. */
.opportunities-filter-panel {
  padding-bottom: calc(280rpx + env(safe-area-inset-bottom) + 112rpx);
}

/* figma 2917_4785 行业二级页：页内全屏覆盖，须压过自绘 tabBar（custom-tab-bar z-index 9999）。 */
.opportunities-industry-page {
  position: fixed;
  inset: 0;
  z-index: 10000;
  display: flex;
  flex-direction: column;
  background: var(--color-canvas);
}

/* Paint the native page before asynchronously loaded components are ready. */
page {
  background-color: #080808;
}
