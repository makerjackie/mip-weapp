<view id="mip-membership-page" class="mip-member-page min-h-screen bg-canvas px-3 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-4 text-ink">
  <view class="rounded-[20rpx] bg-brand px-5 py-5 text-on-brand">
    <view class="flex items-start justify-between gap-4"><view><view class="text-[length:22rpx] font-semibold">{{identityState === 'error' ? '会员状态暂不可用' : membershipLabel}}</view><view class="mt-2 text-[length:36rpx] font-bold">会员方案</view></view><view class="rounded-full bg-canvas px-3 py-2 text-[length:20rpx] text-brand">{{isPlayer ? '已开通' : '待开通'}}</view></view>
    <view class="mt-3 text-[length:23rpx] opacity-70">{{identityState === 'error' ? '恢复后可查看当前会员状态。' : membershipDescription}}</view>
    <view wx:if="{{membershipEndsText}}" class="mt-2 text-[length:21rpx] opacity-70">有效期至 {{membershipEndsText}}</view>
  </view>

  <view class="mt-4 flex min-h-[96rpx] items-center justify-between rounded-[16rpx] bg-panel px-4" bind:tap="openBenefits"><view><view class="text-[length:26rpx] font-semibold">权益说明</view><view class="mt-1 text-[length:20rpx] text-muted">查看方案权益和使用说明</view></view><t-icon name="chevron-right" size="34rpx" color="var(--color-brand)" /></view>

  <view id="mip-membership-loading-state" wx:if="{{state === 'loading'}}" class="mt-5 flex flex-col gap-3"><view class="rounded-[16rpx] bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view><view class="rounded-[16rpx] bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view></view>
  <view id="mip-membership-error-state" wx:elif="{{state === 'error'}}" class="mt-5"><app-empty-state title="会员方案暂时无法加载" description="请稍后重试。" action-text="重新加载" bind:action="loadPlans" /></view>
  <view wx:elif="{{plans.length === 0}}" class="mt-5"><app-empty-state title="暂无可用会员方案" description="方案启用后会显示在这里。" /></view>
  <view wx:else class="mt-5 flex flex-col gap-3">
    <block wx:for="{{plans}}" wx:key="id">
      <view wx:if="{{selectedPlanId === item.id}}" data-plan-id="{{item.id}}" class="rounded-[16rpx] border-2 border-brand bg-panel px-5 py-5" bind:tap="selectPlan">
        <view class="flex items-start justify-between gap-4"><view class="min-w-0 flex-1"><view class="text-[length:30rpx] font-bold">{{item.name}}</view><view wx:if="{{item.description}}" class="mt-2 text-[length:22rpx] leading-5 text-muted">{{item.description}}</view><view class="mt-3 text-[length:21rpx] text-brand">{{item.durationText}}</view></view><view class="shrink-0 text-[length:36rpx] font-bold text-brand">{{item.priceText}}</view></view>
      </view>
      <view wx:else data-plan-id="{{item.id}}" class="rounded-[16rpx] border-2 border-transparent bg-panel px-5 py-5" bind:tap="selectPlan">
        <view class="flex items-start justify-between gap-4"><view class="min-w-0 flex-1"><view class="text-[length:30rpx] font-bold">{{item.name}}</view><view wx:if="{{item.description}}" class="mt-2 text-[length:22rpx] leading-5 text-muted">{{item.description}}</view><view class="mt-3 text-[length:21rpx] text-muted">{{item.durationText}}</view></view><view class="shrink-0 text-[length:36rpx] font-bold">{{item.priceText}}</view></view>
      </view>
    </block>
  </view>

  <view wx:if="{{selectedBenefits.length}}" class="mt-4 rounded-[16rpx] bg-panel px-4 py-4">
    <view class="text-[length:27rpx] font-semibold">方案权益</view>
    <view class="mt-3 flex flex-col gap-3"><view wx:for="{{selectedBenefits}}" wx:key="*this" class="flex items-start gap-3 text-[length:23rpx]"><t-icon class="mt-1 shrink-0" name="check" size="26rpx" color="var(--color-brand)" /><text class="min-w-0 flex-1">{{item}}</text></view></view>
  </view>

  <view wx:if="{{message && state !== 'error'}}" class="mt-4 rounded-[16rpx] border border-line bg-panel-raised px-4 py-3 text-[length:22rpx] text-ink">{{message}}</view>
  <view wx:if="{{invitationMessage}}" class="mt-4 rounded-[16rpx] border border-line bg-panel-raised px-4 py-3 text-[length:22rpx] text-ink">{{invitationMessage}}</view>
  <view wx:if="{{state === 'ready' && plans.length}}" class="mt-6"><t-button block size="large" theme="primary" loading="{{paying || accessing}}" disabled="{{!paymentEnabled || !selectedPlanId}}" bind:tap="purchase">{{!paymentEnabled ? '会员支付尚未配置' : isPlayer ? '续费会员' : '微信支付'}}</t-button></view>
  <view class="mt-3 text-center text-[length:21rpx] leading-5 text-muted">支付调起后需等待服务端确认，以订单状态为准。</view>
  <view wx:if="{{isPlayer}}" class="mt-4 rounded-[16rpx] bg-panel px-4 py-5">
    <view class="text-[length:27rpx] font-semibold">会员邀请</view>
    <view class="mt-1 text-[length:21rpx] text-muted">邀请资格和归因由服务端确认</view>
    <view wx:if="{{invitationSourceName}}" class="mt-4 flex items-center gap-3 rounded-[12rpx] bg-panel-raised px-3 py-3">
      <image wx:if="{{invitationSourceAvatar}}" class="h-[56rpx] w-[56rpx] shrink-0 rounded-full" mode="aspectFill" src="{{invitationSourceAvatar}}" />
      <t-icon wx:else name="user" size="38rpx" color="var(--color-brand)" />
      <view><view class="text-[length:20rpx] text-muted">当前会员邀请来源</view><view class="mt-1 text-[length:23rpx] font-semibold">{{invitationSourceName}}</view></view>
    </view>
    <view class="mt-4 grid grid-cols-2 gap-3">
      <t-button block variant="outline" theme="default" open-type="share" disabled="{{!invitationReady}}">微信分享</t-button>
      <t-button block variant="outline" theme="default" disabled="{{!invitationReady}}" bind:tap="copyInvitation">复制邀请文案</t-button>
      <view class="col-span-2"><t-button block theme="primary" loading="{{posterBusy}}" bind:tap="createInvitationPoster">生成邀请海报</t-button></view>
    </view>
    <image wx:if="{{posterPath}}" class="mt-4 h-[560rpx] w-full rounded-[16rpx] bg-panel-raised" mode="aspectFit" src="{{posterPath}}" bind:tap="previewInvitationPoster" />
    <view wx:if="{{posterPath}}" class="mt-3 grid grid-cols-2 gap-3"><t-button block variant="outline" bind:tap="previewInvitationPoster">预览海报</t-button><t-button block theme="primary" bind:tap="saveInvitationPoster">保存到相册</t-button></view>
  </view>
  <view class="mt-3"><t-button block variant="text" theme="default" bind:tap="openOrders">查看我的订单</t-button></view>
  <app-page-exit label="返回" />
  <canvas id="mip-membership-invitation-canvas" type="2d" class="fixed left-[-9999px] top-0 h-[560px] w-[375px]"></canvas>
</view>
