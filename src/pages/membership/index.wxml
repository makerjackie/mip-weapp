<view id="membership-checkout-page" class="min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+48rpx)] pt-4 text-ink">
  <view class="overflow-hidden rounded-[34rpx] bg-brand px-5 py-6 text-white shadow-[0_18rpx_40rpx_rgba(40,94,70,0.16)]">
    <view class="flex items-center justify-between gap-4">
      <view class="flex min-w-0 items-center gap-3">
        <image wx:if="{{membershipActive && avatarUrl}}" class="h-[72rpx] w-[72rpx] shrink-0 rounded-full border-2 border-white/70" mode="aspectFill" src="{{avatarUrl}}" />
        <view wx:elif="{{membershipActive}}" class="flex h-[72rpx] w-[72rpx] shrink-0 items-center justify-center rounded-full bg-white/15 text-[length:26rpx] font-bold">{{nicknameInitial}}</view>
        <view class="min-w-0"><view class="truncate text-[length:22rpx] text-brand-soft">{{membershipActive ? nickname : '同行会会员'}}</view><view wx:if="{{membershipActive && expiresText}}" class="mt-1 text-[length:20rpx] text-brand-soft">有效期至 {{expiresText}}</view></view>
      </view>
      <view class="rounded-full bg-white/15 px-3 py-1 text-[length:20rpx]">{{membershipActive ? '已开通' : '待开通'}}</view>
    </view>
    <view class="mt-3 text-[length:42rpx] font-bold">{{membershipActive ? '会员权益' : '加入同行会会员'}}</view>
    <view class="mt-3 text-[length:23rpx] leading-6 text-brand-soft">完整成员资料、会员活动、优先报名与专属身份凭证。</view>
    <view class="mt-6 grid grid-cols-2 gap-2">
      <view class="rounded-[18rpx] bg-white/10 px-3 py-3 text-[length:22rpx]">完整成员资料</view>
      <view class="rounded-[18rpx] bg-white/10 px-3 py-3 text-[length:22rpx]">会员活动免费</view>
      <view class="rounded-[18rpx] bg-white/10 px-3 py-3 text-[length:22rpx]">优先报名</view>
      <view class="rounded-[18rpx] bg-white/10 px-3 py-3 text-[length:22rpx]">会员身份凭证</view>
    </view>
  </view>

  <view class="mt-4 flex items-center justify-between rounded-[22rpx] bg-panel px-4 py-4" bind:tap="openBenefits">
    <view><view class="text-[length:26rpx] font-semibold">权益说明</view><view class="mt-1 text-[length:21rpx] text-muted">查看使用规则与常见问题</view></view><t-icon name="chevron-right" size="40rpx" color="var(--color-brand)" />
  </view>

  <view wx:if="{{state === 'loading'}}" class="mt-5 rounded-[28rpx] bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}" class="mt-5"><app-empty-state title="暂时无法加载会员方案" description="服务暂时没有响应，请稍后重试。" action-text="重新加载" bind:action="loadPlans" /></view>
  <view wx:elif="{{plans.length === 0}}" class="mt-5"><app-empty-state title="会员方案即将开放" description="开放后会在这里展示权益和价格。" /></view>
  <view wx:else class="mt-5 flex flex-col gap-3">
    <view wx:for="{{plans}}" wx:key="id" data-plan-id="{{item.id}}" class="rounded-[26rpx] border-2 bg-panel px-5 py-5 active:opacity-70" style="border-color: {{selectedPlanId === item.id ? '#285E46' : 'transparent'}}" bind:tap="selectPlan">
      <view class="flex items-start justify-between gap-4">
        <view class="min-w-0 flex-1">
          <view class="text-[length:30rpx] font-bold">{{item.name}}</view>
          <view class="mt-2 text-[length:22rpx] leading-5 text-muted">{{item.description}}</view>
          <view class="mt-3 text-[length:21rpx] font-semibold text-brand">{{item.durationText}}</view>
        </view>
        <view class="text-[length:36rpx] font-bold text-accent">{{item.priceText}}</view>
      </view>
    </view>
  </view>
  <view wx:if="{{message && state !== 'error'}}" class="mt-4 rounded-[18rpx] bg-[#FFF0E8] px-4 py-3 text-[length:23rpx] text-[#9F4727]">{{message}}</view>
  <view wx:if="{{state === 'ready' && plans.length}}" class="mt-6 active:opacity-70"><t-button block size="large" theme="primary" loading="{{paying}}" disabled="{{!paymentEnabled || !selectedPlanId}}" bind:tap="purchase">{{!paymentEnabled ? '会员服务即将开放' : membershipActive ? '续费会员' : '微信支付并开通'}}</t-button></view>
  <view class="mt-3 text-center text-[length:21rpx] text-muted">付款后自动确认结果并开通权益</view>
  <view class="mt-3 active:opacity-70"><t-button block variant="text" theme="primary" bind:tap="openOrders">查看订单与售后</t-button></view>
  <view class="mt-3"><t-button block variant="outline" theme="primary" bind:tap="backToHome">返回首页</t-button></view>
  <app-phone-login-sheet
    visible="{{phoneSheetVisible}}"
    loading="{{phoneBinding}}"
    title="登录后继续支付"
    description="用于会员凭证、订单与售后"
    bind:phone="bindPhone"
    bind:close="closePhoneSheet"
    bind:agreement="openAgreement"
    bind:privacy="openPrivacy"
  />
</view>
