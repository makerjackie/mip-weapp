<view id="membership-explore-page" class="min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+160rpx)] pt-4 text-ink">
  <view class="px-1">
    <view class="text-[length:22rpx] font-semibold text-accent">成员社区</view>
    <view class="mt-1 text-[length:39rpx] font-bold">认识有趣的人</view>
    <view class="mt-2 text-[length:23rpx] text-muted">先看公开资料，再决定是否进一步了解。</view>
  </view>

  <view id="explore-filter-tabs" class="mt-4 border-b border-line">
    <t-tabs value="{{filter}}" theme="line" space-evenly bind:change="changeFilter">
      <t-tab-panel value="recommended" label="推荐" />
      <t-tab-panel value="same-city" label="同城" />
      <t-tab-panel value="new" label="新加入" />
    </t-tabs>
  </view>

  <view wx:if="{{state === 'loading'}}" class="mt-6 rounded-[28rpx] bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}" class="mt-6"><app-empty-state title="暂时无法加载成员" description="服务暂时没有响应，请稍后重试。" action-text="重新加载" bind:action="loadRecommendations" /></view>
  <view wx:elif="{{recommendations.length === 0}}" class="mt-6"><app-empty-state title="{{emptyTitle}}" description="{{emptyDescription}}" /></view>
  <view id="member-discovery-list" wx:else class="mt-5 flex flex-col gap-3">
    <view wx:for="{{recommendations}}" wx:key="id" class="member-discovery-item">
      <member-card member="{{item}}" bind:select="openMember" />
    </view>
  </view>
  <view wx:if="{{message && state === 'ready'}}" class="mt-4 rounded-[18rpx] bg-[#FFF0E8] px-4 py-3 text-[length:23rpx] text-[#9F4727]">{{message}}</view>
</view>
