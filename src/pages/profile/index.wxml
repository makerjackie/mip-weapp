<view id="membership-profile-page" class="min-h-screen bg-canvas px-4 pb-[calc(env(safe-area-inset-bottom)+240rpx)] pt-4 text-ink">
  <view wx:if="{{state === 'loading'}}" class="rounded-[28rpx] bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  <view wx:elif="{{state === 'error'}}"><app-empty-state title="暂时无法加载资料" description="服务暂时没有响应，请稍后重试。" action-text="重新加载" bind:action="loadProfile" /></view>

  <block wx:else>
    <view class="flex items-center gap-4 px-1 py-2">
      <image wx:if="{{avatarUrl}}" class="h-[116rpx] w-[116rpx] rounded-full bg-brand-soft" mode="aspectFill" fade-show="{{false}}" src="{{avatarUrl}}" />
      <view wx:else class="flex h-[116rpx] w-[116rpx] items-center justify-center rounded-full bg-brand text-[length:38rpx] font-bold text-white">{{nicknameInitial}}</view>
      <view class="min-w-0 flex-1">
        <view class="truncate text-[length:36rpx] font-bold">{{nickname}}</view>
        <view class="mt-1 flex flex-wrap items-center gap-2 text-[length:23rpx] text-muted"><text>{{city || '还没有设置城市'}}</text><text class="rounded-full bg-brand-soft px-2 py-1 text-[length:19rpx] text-brand">{{phoneBound ? '手机号已绑定' : '未绑定手机号'}}</text></view>
        <view wx:if="{{headline}}" class="mt-1 line-clamp-2 text-[length:22rpx] text-muted">{{headline}}</view>
      </view>
      <view class="rounded-full bg-brand-soft px-3 py-2 text-[length:21rpx] font-semibold text-brand" bind:tap="openProfileEdit">编辑</view>
    </view>

    <view class="mt-5 rounded-[30rpx] bg-brand px-5 py-5 text-white" bind:tap="openMembership">
      <view class="flex items-center justify-between">
        <view><view class="text-[length:21rpx] text-brand-soft">{{membershipLabel}}</view><view class="mt-2 text-[length:30rpx] font-bold">{{expiresText ? '有效期至 ' + expiresText : '解锁完整会员体验'}}</view></view>
        <view class="flex items-center gap-1 rounded-full bg-white py-2 pl-4 pr-2 text-[length:22rpx] font-semibold text-brand">查看 <t-icon name="chevron-right" size="32rpx" color="var(--color-brand)" /></view>
      </view>
    </view>

    <view wx:if="{{completion < 100}}" class="mt-4 rounded-[24rpx] bg-panel px-4 py-4" bind:tap="openAccess">
      <view class="flex items-center justify-between"><view class="text-[length:26rpx] font-semibold">资料完成度 {{completion}}%</view><view class="rounded-full bg-brand px-3 py-2 text-[length:20rpx] font-semibold text-white">完善资料</view></view>
      <view class="mt-3 h-[8rpx] overflow-hidden rounded-full bg-panel-muted"><view class="h-full rounded-full bg-brand" style="width: {{completion}}%" /></view>
      <view class="mt-2 text-[length:20rpx] text-muted">完善资料，让更多人了解你</view>
    </view>

    <view id="profile-service-actions" class="mt-5 overflow-hidden rounded-[26rpx] bg-panel">
      <view class="profile-service-action flex min-h-[112rpx] items-center gap-3 border-b border-line px-4" bind:tap="openRegistrations">
        <view class="profile-service-icon flex h-[72rpx] w-[72rpx] shrink-0 items-center justify-center rounded-full bg-brand-soft"><t-icon name="calendar-event" size="40rpx" color="var(--color-brand)" /></view>
        <view class="min-w-0 flex-1"><view class="text-[length:27rpx] font-semibold">我的活动</view><view class="mt-1 text-[length:20rpx] text-muted">查看报名记录与活动凭证</view></view>
        <t-icon name="chevron-right" size="40rpx" color="var(--color-muted)" />
      </view>
      <view class="profile-service-action flex min-h-[112rpx] items-center gap-3 px-4" bind:tap="openOrders">
        <view class="profile-service-icon flex h-[72rpx] w-[72rpx] shrink-0 items-center justify-center rounded-full bg-brand-soft"><t-icon name="money" size="40rpx" color="var(--color-brand)" /></view>
        <view class="min-w-0 flex-1"><view class="text-[length:27rpx] font-semibold">订单与售后</view><view class="mt-1 text-[length:20rpx] text-muted">查看支付、退款与权益状态</view></view>
        <t-icon name="chevron-right" size="40rpx" color="var(--color-muted)" />
      </view>
      <view class="profile-service-action flex min-h-[112rpx] items-center gap-3 border-t border-line px-4" bind:tap="openConnections">
        <view class="profile-service-icon flex h-[72rpx] w-[72rpx] shrink-0 items-center justify-center rounded-full bg-brand-soft"><t-icon name="usergroup" size="40rpx" color="var(--color-brand)" /></view>
        <view class="min-w-0 flex-1"><view class="text-[length:27rpx] font-semibold">我的关注</view><view class="mt-1 text-[length:20rpx] text-muted">查看关注与关注我的成员</view></view>
        <t-icon name="chevron-right" size="40rpx" color="var(--color-muted)" />
      </view>
    </view>

    <view class="mt-5 overflow-hidden rounded-[26rpx] bg-panel">
      <view class="flex min-h-[96rpx] items-center justify-between border-b border-line px-5" bind:tap="openNotifications">
        <view class="flex items-center gap-3">
          <view class="text-[length:27rpx] font-semibold">消息通知</view>
          <view wx:if="{{unreadNotificationCount}}" class="min-w-[38rpx] rounded-full bg-accent px-2 py-1 text-center text-[length:18rpx] font-semibold text-white">{{unreadNotificationCount > 99 ? '99+' : unreadNotificationCount}}</view>
        </view>
        <t-icon name="chevron-right" size="40rpx" color="var(--color-brand)" />
      </view>
      <view class="flex min-h-[96rpx] items-center justify-between border-b border-line px-5" bind:tap="openBenefits"><view class="text-[length:27rpx] font-semibold">会员权益说明</view><t-icon name="chevron-right" size="40rpx" color="var(--color-brand)" /></view>
      <view class="flex min-h-[96rpx] items-center justify-between border-b border-line px-5" bind:tap="openPrivacy"><view class="text-[length:27rpx] font-semibold">隐私与账号</view><t-icon name="chevron-right" size="40rpx" color="var(--color-brand)" /></view>
      <view class="flex min-h-[96rpx] items-center justify-between border-b border-line px-5" bind:tap="openHelp"><view class="text-[length:27rpx] font-semibold">帮助与客服</view><t-icon name="chevron-right" size="40rpx" color="var(--color-brand)" /></view>
      <view class="flex min-h-[96rpx] items-center justify-between px-5" bind:tap="openAbout"><view class="text-[length:27rpx] font-semibold">关于同行会</view><t-icon name="chevron-right" size="40rpx" color="var(--color-brand)" /></view>
    </view>

    <view wx:if="{{adminEnabled || eventManagerEnabled}}" class="mt-5 rounded-[24rpx] border border-accent bg-[#FFF7F1] px-5 py-4" bind:tap="openManagedEvents"><view class="flex items-center justify-between"><view><view class="text-[length:26rpx] font-bold">活动管理</view><view class="mt-1 text-[length:21rpx] text-muted">{{adminEnabled ? adminRole + ' · 查看负责的活动' : '查看你负责的活动'}}</view></view><view class="flex items-center gap-1 text-accent">进入 <t-icon name="chevron-right" size="36rpx" color="var(--color-accent)" /></view></view></view>
    <view wx:if="{{adminEnabled}}" class="mt-3 rounded-[24rpx] border border-line bg-panel px-5 py-4" bind:tap="openAdmin"><view class="flex items-center justify-between"><view><view class="text-[length:26rpx] font-bold">手机运营台</view><view class="mt-1 text-[length:21rpx] text-muted">成员、订单与系统运营</view></view><view class="flex items-center gap-1 text-brand">进入 <t-icon name="chevron-right" size="36rpx" color="var(--color-brand)" /></view></view></view>
    <view wx:if="{{message}}" class="mt-4 rounded-[18rpx] bg-[#FFF0E8] px-4 py-3 text-[length:23rpx] text-[#9F4727]">{{message}}</view>
  </block>
</view>
