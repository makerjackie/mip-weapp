<view id="mip-account-page" class="mip-member-page mip-member-tab-page profile-page">
  <view wx:if="{{state === 'loading'}}" class="profile-loading" aria-role="status" aria-label="正在加载资料" aria-busy="true">
    <view class="profile-loading-card"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
    <view class="profile-loading-card"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  </view>
  <view wx:elif="{{state === 'error'}}" class="profile-state">
    <mip-empty-state title="暂时无法加载资料" description="资料服务暂时没有响应。" action-text="重新加载" bind:action="loadProfile" />
    <view class="mt-3 flex min-h-[88rpx] items-center justify-center text-[length:24rpx] text-brand" aria-role="button" bind:tap="copyLoadingDiagnostics">复制诊断信息</view>
  </view>

  <!-- figma 1732_19949/1774_41441 我的（放大头变体）：面板头 + 等级横幅 + 统计 + 功能 + 操作 +
       tab 条；合作卡 tab = production mip-cooperation-card + 虚线添加卡，超级案例 tab =
       黄点时间线 + 案例卡。生产保持下方 profile-* 布局（被 vitest pin）。fixture
       figmaLayout 打开时按稿渲染，数据来自 ui-fidelity manifest fixture。 -->
  <block wx:elif="{{figmaLayout}}">
    <view class="-mx-3 -mt-3 relative min-h-[1750rpx]">
      <view class="absolute left-0 top-0 h-[208rpx] w-full bg-panel" />
      <view class="absolute left-[24rpx] top-[24rpx] h-[160rpx] w-[160rpx]">
        <image class="h-full w-full rounded-full" mode="aspectFill" src="{{figma.avatar}}" />
        <view class="pointer-events-none absolute inset-0 rounded-full border-[4rpx] border-canvas" />
      </view>
      <view class="absolute left-[208rpx] top-[42rpx] flex items-center">
        <text class="text-[32rpx] font-medium leading-[44.8rpx] text-ink">{{figma.name}}</text>
        <view class="ml-[8rpx] flex h-[32rpx] w-[68rpx] items-center justify-center rounded-[8rpx] border-[2rpx] border-canvas bg-panel-raised">
          <text class="text-[20rpx] font-semibold leading-[28rpx] text-brand">{{figma.level}}</text>
        </view>
        <image class="ml-[8rpx] h-[40rpx] w-[40rpx]" src="/packages/member/assets/figma/coop/frog-badge.png" />
      </view>
      <view class="absolute left-[208rpx] top-[98rpx] text-[20rpx] font-medium leading-[28rpx] text-ink">{{figma.tagline}}</view>
      <view class="absolute left-[208rpx] top-[138rpx] text-[20rpx] leading-[28rpx] text-muted">{{figma.intro}}</view>

      <image class="absolute left-[24rpx] top-[208rpx] h-[160rpx] w-[702rpx]" mode="scaleToFill" src="/assets/figma/profile/level-banner-mine.png" />

      <view class="absolute left-[24rpx] top-[392rpx] h-[136rpx] w-[702rpx] rounded-[16rpx] bg-panel">
        <view wx:for="{{figma.stats}}" wx:key="label" class="absolute top-[24rpx] flex w-[96rpx] flex-col items-center gap-[4rpx]" style="left:{{item.leftRpx}}rpx">
          <text class="text-[40rpx] font-medium leading-[56rpx] text-ink">{{item.value}}</text>
          <text class="text-[20rpx] leading-[28rpx] text-ink">{{item.label}}</text>
        </view>
        <view class="absolute left-[628rpx] top-[16rpx] flex h-[28rpx] w-[28rpx] items-center justify-center rounded-full bg-[#ff2238]">
          <text class="text-[20rpx] leading-[26rpx] text-ink">{{figma.redBadge}}</text>
        </view>
      </view>

      <view wx:for="{{figma.features}}" wx:key="label" class="absolute h-[144rpx] w-[340rpx] flex items-center gap-[24rpx] rounded-[16rpx] bg-panel px-[24rpx]" style="left:{{item.leftRpx}}rpx;top:552rpx">
        <image class="h-[96rpx] w-[96rpx]" mode="aspectFit" src="{{item.image}}" />
        <text class="text-[32rpx] font-semibold text-ink">{{item.label}}</text>
      </view>

      <view class="absolute left-[24rpx] top-[720rpx] grid h-[160rpx] w-[702rpx] grid-cols-4 rounded-[16rpx] bg-panel">
        <view wx:for="{{figma.actions}}" wx:key="label" class="flex flex-col items-center justify-center gap-[30rpx]">
          <image class="h-[56rpx] w-[56rpx]" mode="aspectFit" src="{{item.icon}}" />
          <text class="text-[28rpx] font-medium leading-[28rpx] text-ink">{{item.label}}</text>
        </view>
      </view>

      <view class="absolute left-0 top-[904rpx] grid h-[80rpx] w-full grid-cols-3">
        <view wx:for="{{figma.tabs}}" wx:key="*this" class="relative flex h-full items-center justify-center">
          <text class="{{index === figma.activeTab ? 'text-[28rpx] font-medium leading-[40rpx] text-brand' : 'text-[28rpx] leading-[40rpx] text-muted'}}">{{item}}</text>
          <view wx:if="{{index === figma.activeTab}}" class="absolute bottom-0 left-0 h-[4rpx] w-[250rpx] bg-brand" />
        </view>
      </view>

      <block wx:if="{{figma.activeTab === 0}}">
        <view class="absolute left-[24rpx] top-[1008rpx] w-[702rpx]">
          <mip-cooperation-card role-key="{{figma.card.roleKey}}" name="{{figma.card.name}}" positioning="{{figma.card.positioning}}" target-summary="{{figma.card.targetSummary}}" />
        </view>
        <view class="absolute left-[24rpx] top-[1432rpx] flex h-[200rpx] w-[702rpx] flex-row items-center justify-center gap-[8rpx] rounded-[16rpx] border-[1rpx] border-dashed border-brand bg-panel">
          <mip-icon name="icon-plus-fill" size="28rpx" color="var(--color-brand)" />
          <text class="text-[28rpx] font-medium leading-[40rpx] text-brand">添加</text>
        </view>
      </block>

      <block wx:if="{{figma.activeTab === 1}}">
        <view class="absolute left-[60rpx] top-[1032rpx] h-[448rpx] w-[2rpx] bg-brand" />
        <view wx:for="{{figma.cases}}" wx:key="month" class="absolute left-0 w-full" style="top:{{1012 + index * 224}}rpx">
          <text class="block w-full text-center text-[24rpx] font-semibold leading-[40rpx] text-brand">{{item.month}}</text>
        </view>
        <view wx:for="{{figma.cases}}" wx:key="month" class="absolute left-[49rpx] h-[24rpx] w-[24rpx] rounded-full bg-brand" style="top:{{1021 + index * 224}}rpx" />
        <view wx:for="{{figma.cases}}" wx:key="month" class="absolute h-[126rpx] w-[578rpx] rounded-[16rpx] bg-panel" style="left:124rpx;top:{{1082 + index * 224}}rpx">
          <image class="absolute left-[22rpx] top-[19rpx] h-[28rpx] w-[28rpx]" src="/assets/figma/profile/icon-folder.png" />
          <text class="absolute left-[64rpx] top-[16rpx] text-[28rpx] font-medium leading-[40rpx] text-ink">{{item.title}}</text>
          <text class="absolute left-[24rpx] top-[62rpx] text-[24rpx] leading-[33.6rpx] text-muted">{{item.summary}}</text>
        </view>
      </block>
    </view>
  </block>

  <block wx:else>
    <view wx:if="{{!authenticated}}" class="profile-guest">
      <view class="profile-guest-hero" aria-role="button" aria-label="登录注册" bind:tap="openLogin">
        <image class="profile-guest-avatar" src="/assets/figma/profile/guest-avatar.png" mode="aspectFill" />
        <view class="profile-guest-login">登录注册</view>
      </view>
      <view class="profile-guest-banner" aria-role="button" aria-label="请登录后查看" bind:tap="openLogin">
        <view class="profile-guest-banner-text">请登录后查看</view>
        <image class="profile-guest-banner-sphere" src="/assets/figma/profile/guest-banner-sphere.png" />
        <image class="profile-guest-banner-king profile-guest-banner-king--1" src="/assets/figma/profile/guest-banner-king-1.png" />
        <image class="profile-guest-banner-king profile-guest-banner-king--2" src="/assets/figma/profile/guest-banner-king-2.png" />
      </view>
    </view>
    <view wx:else class="profile-hero">
      <view class="profile-summary" bind:tap="openProfileEdit">
        <image wx:if="{{avatarUrl}}" class="profile-avatar" mode="aspectFill" fade-show="{{false}}" src="{{avatarUrl}}" />
        <view wx:else class="profile-avatar profile-avatar--fallback">{{nicknameInitial}}</view>
        <view class="profile-identity">
          <view class="profile-name-row">
            <text class="profile-name">{{nickname}}</text>
            <text class="profile-level-chip">{{growthState === 'ready' ? levelName : membershipLabel}}</text>
            <image wx:if="{{primaryBadge && primaryBadge.imageUrl}}" class="profile-rank-mark" mode="aspectFill" src="{{primaryBadge.imageUrl}}" />
            <t-icon wx:elif="{{primaryBadge && primaryBadge.iconName}}" name="{{primaryBadge.iconName}}" size="36rpx" color="var(--color-brand)" />
            <image wx:elif="{{primaryBadge}}" class="profile-rank-mark" mode="aspectFit" src="/assets/figma/profile/rank-mark.png" />
          </view>
          <view class="profile-meta">
            <text>{{primaryBranchName}}</text>
            <text wx:if="{{primaryIndustryName}}"> I {{primaryIndustryName}}</text>
            <text wx:if="{{identityStatus}}"> I {{identityStatus}}</text>
          </view>
          <view wx:if="{{headline}}" class="profile-headline">{{headline}}</view>
          <view wx:elif="{{!profileComplete}}" class="profile-headline">档案待完善</view>
        </view>
      </view>

      <mip-level-banner wx:if="{{isPlayer && growthState === 'ready'}}" class="profile-level-banner" level="{{levelName}}" current="{{experience}}" target="{{growthTarget}}" fill-px="{{growthFillPx}}" bind:tap="openGrowth" />
      <view wx:elif="{{isPlayer}}" class="profile-level-card" bind:tap="openGrowth">
        <view class="profile-level-header">
          <text class="profile-level-name">玩家等级</text>
        </view>
        <view wx:if="{{growthState === 'loading'}}" class="profile-level-loading" />
        <view wx:else class="profile-level-experience">成长数据暂时不可用</view>
      </view>
      <view wx:else class="profile-membership-card" bind:tap="openMembership">
        <view>
          <view class="profile-membership-label">{{membershipLabel}}</view>
          <view class="profile-membership-description">{{membershipDescription}}</view>
        </view>
        <view class="profile-membership-action">查看会员</view>
      </view>
    </view>

    <mip-stat-header
      wx:if="{{authenticated}}"
      class="profile-stats"
      stats="{{[
        {value: guestCount === null ? '—' : guestCount, label: '嘉宾', category: 'GUEST', target: 'influence'},
        {value: interactionCount === null ? '—' : interactionCount, label: '互动过', category: 'INTERACTION', target: 'influence'},
        {value: interestCount === null ? '—' : interestCount, label: '心动值', category: 'ACTIVE_INTEREST', target: 'influence'},
        {value: visitorCount === null ? '—' : visitorCount, label: '访客', target: 'visitor', badge: visitorUnreadCount > 99 ? '99+' : (visitorUnreadCount > 0 ? visitorUnreadCount : '')}
      ]}}"
      bind:select="openStat"
    />

    <view wx:if="{{authenticated}}" class="profile-feature-grid">
      <view class="profile-feature" bind:tap="openTasks"><image class="profile-feature-image" mode="aspectFit" src="/assets/figma/profile/task.png" /><text class="profile-feature-label">NPC任务</text></view>
      <view class="profile-feature" bind:tap="openBadges"><image class="profile-feature-image" mode="aspectFit" src="/assets/figma/profile/badge.png" /><text class="profile-feature-label">MIP勋章</text></view>
    </view>

    <view id="profile-service-actions" class="profile-actions">
      <view class="profile-action" bind:tap="openRegistrations"><image class="profile-action-icon" mode="aspectFit" src="/assets/figma/profile/action-events.svg" /><text>活动</text></view>
      <view class="profile-action" bind:tap="openMemberCard"><image class="profile-action-icon" mode="aspectFit" src="/assets/figma/profile/action-card.svg" /><text>名片</text></view>
      <view class="profile-action" bind:tap="openOrders"><image class="profile-action-icon" mode="aspectFit" src="/assets/figma/profile/action-orders.svg" /><text>订单</text></view>
      <view class="profile-action" bind:tap="openSettings"><image class="profile-action-icon" mode="aspectFit" src="/assets/figma/profile/action-settings.svg" /><text>设置</text></view>
    </view>

    <view wx:if="{{adminVisible && authenticated}}" class="profile-admin-entry profile-admin-entry--primary" bind:tap="openAdmin"><view><view class="profile-more-label">现场工作台</view><view class="profile-more-description">授权活动、签到与网页登录</view></view><mip-icon name="chevron-down-1" size="{{17}}" color="var(--color-brand)" /></view>

    <view wx:if="{{authenticated}}" class="profile-tabs" aria-role="tablist">
      <view wx:if="{{portfolioTab === 'cooperation'}}" id="profile-tab-cooperation" class="profile-tab profile-tab--active" aria-role="tab" aria-selected="true" data-tab="cooperation" bind:tap="changePortfolioTab">合作卡</view>
      <view wx:else id="profile-tab-cooperation" class="profile-tab" aria-role="tab" aria-selected="false" data-tab="cooperation" bind:tap="changePortfolioTab">合作卡</view>
      <view wx:if="{{portfolioTab === 'cases'}}" id="profile-tab-cases" class="profile-tab profile-tab--active" aria-role="tab" aria-selected="true" data-tab="cases" bind:tap="changePortfolioTab">超级案例</view>
      <view wx:else id="profile-tab-cases" class="profile-tab" aria-role="tab" aria-selected="false" data-tab="cases" bind:tap="changePortfolioTab">超级案例</view>
      <view wx:if="{{portfolioTab === 'opportunities'}}" id="profile-tab-opportunities" class="profile-tab profile-tab--active" aria-role="tab" aria-selected="true" data-tab="opportunities" bind:tap="changePortfolioTab">相关机会</view>
      <view wx:else id="profile-tab-opportunities" class="profile-tab" aria-role="tab" aria-selected="false" data-tab="opportunities" bind:tap="changePortfolioTab">相关机会</view>
    </view>

    <block wx:if="{{authenticated && portfolioTab === 'cooperation'}}">
      <view wx:if="{{cooperationState === 'loading'}}" class="profile-portfolio-loading"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
      <view wx:elif="{{cooperationState === 'error'}}" class="profile-state"><mip-empty-state title="合作卡暂时无法加载" description="稍后可以重新加载。" action-text="重新加载" bind:action="loadCooperation" /></view>
      <view wx:else class="profile-portfolio-list">
        <view wx:for="{{cooperationCards}}" wx:key="id" class="profile-cooperation-card" data-id="{{item.id}}" bind:tap="openCooperation">
          <mip-cooperation-card role-key="{{item.roleKey}}" positioning="{{item.positioning}}" target-summary="{{item.targetSummary}}" />
        </view>
        <mip-empty-state wx:if="{{cooperationCards.length === 0}}" title="暂无合作卡" description="添加后会显示在这里。" action-text="添加合作卡" bind:action="openCooperationEditor" />
        <view wx:else class="profile-add-card {{openingAction === 'cooperation-editor' ? 'profile-add-card--loading' : ''}}" aria-role="button" aria-label="添加合作卡" aria-disabled="{{openingAction === 'cooperation-editor'}}" bind:tap="openCooperationEditor"><view class="profile-add-content"><image src="/assets/figma/profile/add.svg" mode="aspectFit" /><text wx:if="{{openingAction === 'cooperation-editor'}}">正在打开</text><text wx:else>添加</text></view></view>
      </view>
    </block>

    <block wx:elif="{{authenticated && portfolioTab === 'cases'}}">
      <view wx:if="{{caseState === 'loading'}}" class="profile-portfolio-loading"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
      <view wx:elif="{{caseState === 'error'}}" class="profile-state"><mip-empty-state title="超级案例暂时无法加载" description="稍后可以重新加载。" action-text="重新加载" bind:action="loadCases" /></view>
      <view wx:else class="profile-portfolio-list">
        <view wx:for="{{cases}}" wx:key="id" class="profile-content-card" data-id="{{item.id}}" bind:tap="openCase"><view class="profile-content-title">{{item.projectName}}</view><view class="profile-content-summary">{{item.summary}}</view></view>
        <mip-empty-state wx:if="{{cases.length === 0}}" title="暂无超级案例" description="添加后会显示在这里。" action-text="添加超级案例" bind:action="openCaseList" />
        <view wx:else class="profile-add-card" aria-role="button" bind:tap="openCaseList"><view class="profile-add-content"><image src="/assets/figma/profile/add.svg" mode="aspectFit" />管理超级案例</view></view>
      </view>
    </block>

    <block wx:elif="{{authenticated}}">
      <view wx:if="{{opportunityState === 'loading'}}" class="profile-portfolio-loading"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
      <view wx:elif="{{opportunityState === 'error'}}" class="profile-state"><mip-empty-state title="相关机会暂时无法加载" description="稍后可以重新加载。" action-text="重新加载" bind:action="loadOpportunities" /></view>
      <view wx:else>
        <view class="profile-opportunity-chips">
          <view class="profile-opportunity-chip profile-opportunity-chip--active" aria-role="button" bind:tap="openOpportunityList">发布机会</view>
          <view class="profile-opportunity-chip" aria-role="button" bind:tap="openReferredOpportunities">引荐给我的</view>
        </view>
        <view class="profile-portfolio-list">
          <view wx:for="{{opportunities}}" wx:key="id" data-id="{{item.id}}" bind:tap="openOpportunity"><mip-opportunity-card title="{{item.title}}" cover-url="{{item.coverUrl || ''}}" value-text="{{item.commercialTerms.amountDisplay || item.valueSummary}}" location-text="{{item.commercialTerms.locationDisplay || item.cityName || '全国'}}" target-text="{{item.targetSummary}}" referral-count="{{item.referralCount}}" avatars="{{item.avatars}}" /></view>
          <mip-empty-state wx:if="{{opportunities.length === 0}}" title="暂无相关机会" description="发布的机会会显示在这里。" action-text="查看我的机会" bind:action="openOpportunityList" />
          <view wx:else class="profile-add-card" aria-role="button" bind:tap="openOpportunityList"><view class="profile-add-content"><image src="/assets/figma/profile/add.svg" mode="aspectFit" />管理机会</view></view>
        </view>
      </view>
    </block>

    <view wx:if="{{authenticated}}" class="profile-services-entry" aria-role="button" bind:tap="openServices">
      <view class="profile-services-icon"><t-icon name="grid-view" size="42rpx" color="var(--color-brand)" /></view>
      <view class="profile-services-copy">
        <view class="profile-more-label">全部服务</view>
        <view class="profile-more-description">消息、互动、工具与支持</view>
      </view>
      <view class="profile-services-trailing">
        <view wx:if="{{notificationUnreadCount > 0}}" class="profile-unread-badge">{{notificationUnreadCount > 99 ? '99+' : notificationUnreadCount}}</view>
        <mip-icon name="chevron-down-1" size="{{17}}" color="var(--color-muted)" />
      </view>
    </view>

    <view wx:if="{{message}}" class="profile-message">{{message}}</view>
  </block>
</view>
