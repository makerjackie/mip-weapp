<view id="mip-account-page" class="min-h-screen bg-canvas px-3 pb-[calc(env(safe-area-inset-bottom)+220rpx)] pt-4 text-ink">
  <view wx:if="{{state === 'loading'}}" class="flex flex-col gap-3">
    <view class="rounded-[16rpx] bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
    <view class="rounded-[16rpx] bg-panel px-5 py-7"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
  </view>
  <view wx:elif="{{state === 'error'}}"><app-empty-state title="暂时无法加载资料" description="资料服务暂时没有响应。" action-text="重新加载" bind:action="loadProfile" /></view>

  <block wx:else>
    <view class="flex min-h-[88rpx] items-center justify-between"><view class="text-[length:40rpx] font-bold">我的</view><view class="min-h-[64rpx] px-3 py-2 text-[length:22rpx] text-brand" bind:tap="openProfileEdit">编辑档案</view></view>
    <view class="mt-2 flex items-center gap-4 rounded-[16rpx] bg-panel px-4 py-5">
      <image wx:if="{{avatarUrl}}" class="h-[116rpx] w-[116rpx] shrink-0 rounded-full bg-brand-soft" mode="aspectFill" fade-show="{{false}}" src="{{avatarUrl}}" />
      <view wx:else class="flex h-[116rpx] w-[116rpx] shrink-0 items-center justify-center rounded-full bg-brand text-[length:38rpx] font-bold text-on-brand">{{nicknameInitial}}</view>
      <view class="min-w-0 flex-1">
        <view class="flex items-center gap-2"><view class="truncate text-[length:34rpx] font-bold">{{nickname}}</view><text class="shrink-0 rounded-full bg-brand-soft px-2 py-1 text-[length:19rpx] text-brand">{{membershipLabel}}</text></view>
        <view class="mt-2 text-[length:22rpx] text-muted">{{primaryBranchName}}</view>
        <view wx:if="{{headline}}" class="mt-1 line-clamp-2 text-[length:22rpx] text-muted">{{headline}}</view>
        <view wx:elif="{{!profileComplete}}" class="mt-1 text-[length:22rpx] text-muted">档案待完善</view>
      </view>
    </view>

    <view wx:if="{{isPlayer}}" class="mt-4 rounded-[16rpx] bg-brand px-5 py-5 text-on-brand" bind:tap="openGrowth">
      <view class="flex items-start justify-between gap-3"><view><view class="text-[length:22rpx] font-semibold">玩家等级</view><view class="mt-2 text-[length:34rpx] font-bold">{{growthState === 'ready' ? levelName : '成长记录'}}</view></view><view class="rounded-full bg-canvas px-3 py-2 text-[length:20rpx] text-brand">查看明细</view></view>
      <view wx:if="{{membershipEndsText}}" class="mt-2 text-[length:21rpx] opacity-70">会员有效期至 {{membershipEndsText}}</view>
      <view wx:if="{{growthState === 'loading'}}" class="mt-4 h-[12rpx] animate-pulse rounded-full bg-canvas opacity-30" />
      <block wx:elif="{{growthState === 'ready'}}">
        <view class="mt-4 h-[12rpx] overflow-hidden rounded-full bg-canvas opacity-70"><view class="h-full rounded-full bg-panel" style="width: {{growthProgress}}%" /></view>
        <view class="mt-2 text-[length:20rpx] opacity-70">{{growthNextText}}</view>
      </block>
      <view wx:else class="mt-3 text-[length:21rpx] opacity-70">成长数据暂时不可用</view>
    </view>
    <view wx:else class="mt-4 rounded-[16rpx] border border-line bg-panel px-5 py-5" bind:tap="openMembership">
      <view class="flex items-center justify-between gap-4"><view><view class="text-[length:22rpx] text-muted">{{membershipLabel}}</view><view class="mt-2 text-[length:30rpx] font-bold">{{membershipDescription}}</view></view><view class="shrink-0 rounded-full bg-brand px-3 py-2 text-[length:20rpx] font-semibold text-on-brand">查看会员</view></view>
    </view>

    <view wx:if="{{growthState === 'ready'}}" class="mt-3 grid grid-cols-3 gap-2">
      <view class="rounded-[14rpx] bg-panel px-3 py-4 text-center"><view class="text-[length:29rpx] font-bold">{{experience}}</view><view class="mt-1 text-[length:20rpx] text-muted">经验值</view></view>
      <view class="rounded-[14rpx] bg-panel px-3 py-4 text-center"><view class="text-[length:29rpx] font-bold">{{contribution}}</view><view class="mt-1 text-[length:20rpx] text-muted">贡献值</view></view>
      <view class="rounded-[14rpx] bg-panel px-3 py-4 text-center"><view class="text-[length:29rpx] font-bold">{{coin}}</view><view class="mt-1 text-[length:20rpx] text-muted">游戏币</view></view>
    </view>

    <view id="profile-service-actions" class="mt-5 grid grid-cols-4 gap-2 rounded-[16rpx] bg-panel px-2 py-4 text-center">
      <view class="flex min-h-[112rpx] flex-col items-center justify-center" bind:tap="openRegistrations"><t-icon name="calendar-event" size="38rpx" color="var(--color-brand)" /><text class="mt-2 text-[length:21rpx]">我的活动</text></view>
      <view class="flex min-h-[112rpx] flex-col items-center justify-center" bind:tap="openProfileEdit"><t-icon name="user-avatar" size="38rpx" color="var(--color-brand)" /><text class="mt-2 text-[length:21rpx]">我的档案</text></view>
      <view class="flex min-h-[112rpx] flex-col items-center justify-center" bind:tap="openOrders"><t-icon name="money" size="38rpx" color="var(--color-brand)" /><text class="mt-2 text-[length:21rpx]">我的订单</text></view>
      <view class="relative flex min-h-[112rpx] flex-col items-center justify-center" bind:tap="openNotifications"><view wx:if="{{unreadCount > 0}}" class="absolute right-[18rpx] top-[2rpx] min-w-[28rpx] rounded-full bg-brand px-1 text-center text-[length:17rpx] font-bold leading-[28rpx] text-on-brand">{{unreadCount > 99 ? '99+' : unreadCount}}</view><t-icon name="notification" size="38rpx" color="var(--color-brand)" /><text class="mt-2 text-[length:21rpx]">站内消息</text></view>
    </view>

    <view class="mt-6 text-[length:32rpx] font-bold">我的内容</view>
    <view class="mt-3 grid grid-cols-3 border-b border-line text-center text-[length:23rpx]">
      <view wx:if="{{portfolioTab === 'cooperation'}}" class="min-h-[76rpx] border-b-[4rpx] border-brand py-3 text-brand" data-tab="cooperation" bind:tap="changePortfolioTab">合作卡</view>
      <view wx:else class="min-h-[76rpx] border-b-[4rpx] border-transparent py-3 text-muted" data-tab="cooperation" bind:tap="changePortfolioTab">合作卡</view>
      <view wx:if="{{portfolioTab === 'cases'}}" class="min-h-[76rpx] border-b-[4rpx] border-brand py-3 text-brand" data-tab="cases" bind:tap="changePortfolioTab">超级案例</view>
      <view wx:else class="min-h-[76rpx] border-b-[4rpx] border-transparent py-3 text-muted" data-tab="cases" bind:tap="changePortfolioTab">超级案例</view>
      <view wx:if="{{portfolioTab === 'opportunities'}}" class="min-h-[76rpx] border-b-[4rpx] border-brand py-3 text-brand" data-tab="opportunities" bind:tap="changePortfolioTab">相关机会</view>
      <view wx:else class="min-h-[76rpx] border-b-[4rpx] border-transparent py-3 text-muted" data-tab="opportunities" bind:tap="changePortfolioTab">相关机会</view>
    </view>

    <block wx:if="{{portfolioTab === 'cooperation'}}">
      <view wx:if="{{cooperationState === 'loading'}}" class="mt-3 rounded-[16rpx] bg-panel px-4 py-5"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
      <view wx:elif="{{cooperationState === 'error'}}" class="mt-3"><app-empty-state title="合作卡暂时无法加载" description="稍后可以重新加载。" action-text="重新加载" bind:action="loadCooperation" /></view>
      <view wx:elif="{{cooperationCards.length === 0}}" class="mt-3"><app-empty-state title="还没有合作卡" description="创建后可以对外展示合作角色与目标。" action-text="管理合作卡" bind:action="openCooperationList" /></view>
      <view wx:else class="mt-3 flex flex-col gap-2"><view wx:for="{{cooperationCards}}" wx:key="id" class="rounded-[16rpx] bg-panel px-4 py-4" data-id="{{item.id}}" bind:tap="openCooperation"><view class="flex items-center justify-between"><text class="text-[length:27rpx] font-semibold">{{item.roleName}}</text><text class="text-[length:20rpx] text-brand">{{item.status === 'PUBLISHED' ? '已发布' : '草稿'}}</text></view><view class="mt-2 line-clamp-2 text-[length:22rpx] text-muted">{{item.targetSummary}}</view></view><view class="mt-2 min-h-[72rpx] py-3 text-center text-[length:22rpx] text-brand" bind:tap="openCooperationList">管理全部合作卡</view></view>
    </block>

    <block wx:elif="{{portfolioTab === 'cases'}}">
      <view wx:if="{{caseState === 'loading'}}" class="mt-3 rounded-[16rpx] bg-panel px-4 py-5"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
      <view wx:elif="{{caseState === 'error'}}" class="mt-3"><app-empty-state title="超级案例暂时无法加载" description="稍后可以重新加载。" action-text="重新加载" bind:action="loadCases" /></view>
      <view wx:elif="{{cases.length === 0}}" class="mt-3"><app-empty-state title="还没有超级案例" description="案例可以展示项目职责与结果。" action-text="管理超级案例" bind:action="openCaseList" /></view>
      <view wx:else class="mt-3 flex flex-col gap-2"><view wx:for="{{cases}}" wx:key="id" class="rounded-[16rpx] bg-panel px-4 py-4" data-id="{{item.id}}" bind:tap="openCase"><view class="text-[length:27rpx] font-semibold">{{item.projectName}}</view><view class="mt-2 line-clamp-2 text-[length:22rpx] text-muted">{{item.summary}}</view></view><view class="mt-2 min-h-[72rpx] py-3 text-center text-[length:22rpx] text-brand" bind:tap="openCaseList">管理全部超级案例</view></view>
    </block>

    <block wx:else>
      <view wx:if="{{opportunityState === 'loading'}}" class="mt-3 rounded-[16rpx] bg-panel px-4 py-5"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
      <view wx:elif="{{opportunityState === 'error'}}" class="mt-3"><app-empty-state title="相关机会暂时无法加载" description="稍后可以重新加载。" action-text="重新加载" bind:action="loadOpportunities" /></view>
      <view wx:elif="{{opportunities.length === 0}}" class="mt-3"><app-empty-state title="还没有发布机会" description="你发布的合作机会会显示在这里。" action-text="管理机会" bind:action="openOpportunityList" /></view>
      <view wx:else class="mt-3 flex flex-col gap-2"><view wx:for="{{opportunities}}" wx:key="id" class="rounded-[16rpx] bg-panel px-4 py-4" data-id="{{item.id}}" bind:tap="openOpportunity"><view class="flex items-center justify-between gap-3"><text class="line-clamp-1 min-w-0 flex-1 text-[length:27rpx] font-semibold">{{item.title}}</text><text class="text-[length:20rpx] text-brand">{{item.status === 'PUBLISHED' ? '招募中' : item.status === 'ENDED' ? '已完成' : '草稿'}}</text></view><view class="mt-2 line-clamp-2 text-[length:22rpx] text-muted">{{item.valueSummary}}</view></view><view class="mt-2 min-h-[72rpx] py-3 text-center text-[length:22rpx] text-brand" bind:tap="openOpportunityList">管理全部机会</view></view>
    </block>

    <view class="mt-6 overflow-hidden rounded-[16rpx] bg-panel">
      <view class="flex min-h-[96rpx] items-center justify-between border-b border-line px-4" bind:tap="openBranches"><view><view class="text-[length:26rpx] font-semibold">主分会</view><view class="mt-1 text-[length:20rpx] text-muted">{{primaryBranchName}}</view></view><t-icon name="chevron-right" size="34rpx" color="var(--color-muted)" /></view>
      <view class="flex min-h-[96rpx] items-center justify-between border-b border-line px-4" bind:tap="openReceivedInteractions"><view><view class="text-[length:26rpx] font-semibold">收到的互动</view><view class="mt-1 text-[length:20rpx] text-muted">查看被引荐机会和感兴趣记录</view></view><t-icon name="chevron-right" size="34rpx" color="var(--color-muted)" /></view>
      <view class="flex min-h-[96rpx] items-center justify-between border-b border-line px-4" bind:tap="openHeartHistory"><view><view class="text-[length:26rpx] font-semibold">心动记录</view><view class="mt-1 text-[length:20rpx] text-muted">查看我点过和对我心动的人</view></view><t-icon name="chevron-right" size="34rpx" color="var(--color-muted)" /></view>
      <view class="flex min-h-[96rpx] items-center justify-between border-b border-line px-4" bind:tap="openAiDrafts"><view><view class="text-[length:26rpx] font-semibold">AI 草稿</view><view class="mt-1 text-[length:20rpx] text-muted">整理档案、合作卡和案例草稿</view></view><t-icon name="chevron-right" size="34rpx" color="var(--color-muted)" /></view>
      <view class="flex min-h-[96rpx] items-center justify-between border-b border-line px-4" bind:tap="openBenefits"><view class="text-[length:26rpx] font-semibold">会员权益</view><t-icon name="chevron-right" size="34rpx" color="var(--color-muted)" /></view>
      <view class="flex min-h-[96rpx] items-center justify-between border-b border-line px-4" bind:tap="openPrivacy"><view class="text-[length:26rpx] font-semibold">隐私与账号</view><t-icon name="chevron-right" size="34rpx" color="var(--color-muted)" /></view>
      <view class="flex min-h-[96rpx] items-center justify-between border-b border-line px-4" bind:tap="openHelp"><view class="text-[length:26rpx] font-semibold">帮助与客服</view><t-icon name="chevron-right" size="34rpx" color="var(--color-muted)" /></view>
      <view class="flex min-h-[96rpx] items-center justify-between px-4" bind:tap="openAbout"><view class="text-[length:26rpx] font-semibold">关于 MIP</view><t-icon name="chevron-right" size="34rpx" color="var(--color-muted)" /></view>
    </view>

    <view wx:if="{{eventManagementVisible}}" class="mt-4 rounded-[16rpx] border border-line bg-panel px-4 py-4" bind:tap="openManagedEvents"><view class="flex items-center justify-between"><view><view class="text-[length:26rpx] font-semibold">活动管理</view><view class="mt-1 text-[length:20rpx] text-muted">查看已授权的活动</view></view><t-icon name="chevron-right" size="34rpx" color="var(--color-brand)" /></view></view>
    <view wx:if="{{adminVisible}}" class="mt-3 rounded-[16rpx] border border-brand bg-brand-soft px-4 py-4" bind:tap="openAdmin"><view class="flex items-center justify-between"><view><view class="text-[length:26rpx] font-semibold">运营管理</view><view class="mt-1 text-[length:20rpx] text-muted">按当前授权范围进入</view></view><t-icon name="chevron-right" size="34rpx" color="var(--color-brand)" /></view></view>
    <view wx:if="{{message}}" class="mt-4 rounded-[16rpx] border border-line bg-panel-raised px-4 py-3 text-[length:22rpx] text-ink">{{message}}</view>
  </block>
</view>
