.profile-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 24rpx 24rpx calc(env(safe-area-inset-bottom) + 220rpx);
  color: var(--color-ink);
  background: var(--color-canvas);
}

.profile-loading {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.profile-loading-card,
.profile-portfolio-loading {
  padding: 40rpx 32rpx;
  background: var(--color-panel);
  border-radius: var(--mip-radius-card-medium);
}

.profile-state {
  margin-top: 24rpx;
}

.profile-hero {
  box-sizing: border-box;
  padding: 24rpx 24rpx 0;
  margin: -24rpx -24rpx 0;
  background: var(--color-panel);
}

/* 24rpx of hero panel between the summary row and the level banner (figma 1770:38871). */
.profile-level-banner {
  margin-top: 24rpx;
}

/* 右侧 72rpx 为站内信命中区（J3-04），加 16rpx 间隔，避免档案内容滑入其点击范围。 */
.profile-summary {
  display: flex;
  align-items: center;
  min-height: 160rpx;
  padding-right: 88rpx;
}

.profile-avatar {
  box-sizing: border-box;
  flex: 0 0 auto;
  width: 160rpx;
  height: 160rpx;
  background: var(--color-brand-soft);
  border: 4rpx solid var(--color-canvas);
  border-radius: 50%;
}

.profile-avatar--fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-on-brand);
  background: var(--color-brand);
}

.profile-identity {
  min-width: 0;
  margin-left: 24rpx;
}

.profile-name-row {
  display: flex;
  gap: 8rpx;
  align-items: center;
  min-width: 0;
}

.profile-name {
  max-width: 220rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 44rpx;
  white-space: nowrap;
}

.profile-level-chip {
  flex: 0 0 auto;
  padding: 2rpx 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 28rpx;
  color: var(--color-brand);
  background: var(--color-panel-raised);
  border: 1rpx solid var(--color-canvas);
  border-radius: 8rpx;
}

.profile-rank-mark {
  flex: 0 0 auto;
  width: 40rpx;
  height: 40rpx;
}

.profile-meta,
.profile-headline {
  max-width: 470rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 22rpx;
  line-height: 28rpx;
  white-space: nowrap;
}

.profile-meta {
  margin-top: 12rpx;
  color: var(--color-ink);
}

.profile-headline {
  margin-top: 12rpx;
  color: var(--color-muted);
}

.profile-level-card,
.profile-membership-card {
  position: relative;
  box-sizing: border-box;
  min-height: 160rpx;
  margin-top: 24rpx;
  overflow: hidden;
  border-radius: var(--mip-radius-card);
}

.profile-level-card {
  padding: 20rpx 28rpx;
  color: var(--color-on-brand);
  background: var(--color-brand);
}

.profile-level-header,
.profile-level-experience,
.profile-level-loading {
  position: relative;
  z-index: 1;
}

.profile-level-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.profile-level-name {
  max-width: 260rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 44rpx;
  white-space: nowrap;
}

.profile-level-experience {
  margin-top: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 28rpx;
}

.profile-level-loading {
  width: 294rpx;
  height: 12rpx;
  margin-top: 8rpx;
  overflow: hidden;
  background: rgb(8 8 8 / 24%);
  border-radius: 999rpx;
}

.profile-membership-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  background: var(--color-panel);
  border: 1rpx solid var(--color-line);
}

.profile-membership-label {
  font-size: 22rpx;
  color: var(--color-muted);
}

.profile-membership-description {
  margin-top: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.profile-membership-action {
  flex: 0 0 auto;
  min-height: 44rpx;
  padding: 8rpx 16rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 44rpx;
  color: var(--color-on-brand);
  background: var(--color-brand);
  border-radius: 999rpx;
}

.profile-stats {
  display: block;
  margin-top: 24rpx;
}

.profile-stat {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  min-width: 0;
  min-height: 88rpx;
}

.profile-stat-value {
  position: relative;
  max-width: 100%;
  font-size: 40rpx;
  font-weight: 500;
  line-height: 56rpx;
  white-space: nowrap;
}

.profile-stat-label {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 28rpx;
}

.profile-stat-badge {
  position: absolute;
  top: -8rpx;
  right: -2rpx;
  box-sizing: border-box;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 4rpx;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 28rpx;
  color: var(--color-ink);
  text-align: center;
  background: #ff2238;
  border-radius: 999rpx;
}

.profile-feature-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22rpx;
  margin-top: 24rpx;
}

.profile-feature {
  box-sizing: border-box;
  display: flex;
  gap: 24rpx;
  align-items: center;
  min-width: 0;
  min-height: 144rpx;
  padding: 24rpx;
  background: var(--color-panel);
  border-radius: var(--mip-radius-card-medium);
}

.profile-feature-image {
  flex: 0 0 auto;
  width: 96rpx;
  height: 96rpx;
}

.profile-feature-label {
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 32rpx;
  font-weight: 600;
  white-space: nowrap;
}

.profile-actions {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  min-height: 160rpx;
  margin-top: 24rpx;
  background: var(--color-panel);
  border-radius: var(--mip-radius-card-medium);
}

.profile-action {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 112rpx;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 28rpx;
}

.profile-action-icon {
  width: 56rpx;
  height: 56rpx;
}

.profile-tabs {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin: 24rpx -24rpx 0;
  border-bottom: 2rpx solid var(--color-panel);
}

.profile-tab {
  box-sizing: border-box;
  min-height: 80rpx;
  padding: 20rpx 8rpx;
  font-size: 28rpx;
  line-height: 40rpx;
  color: var(--color-muted);
  text-align: center;
  border-bottom: 4rpx solid transparent;
}

.profile-tab--active {
  color: var(--color-brand);
  border-bottom-color: var(--color-brand);
}

.profile-opportunity-chips {
  display: flex;
  gap: 40rpx;
  align-items: center;
  padding-left: 26rpx;
  margin-top: 24rpx;
}

.profile-opportunity-chip {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 39.2rpx;
  color: var(--color-ink);
  background: var(--color-panel);
  border-radius: 16rpx;
}

.profile-opportunity-chip--active {
  color: var(--color-on-brand);
  background: var(--color-brand);
}

.profile-portfolio-loading,
.profile-portfolio-list {
  margin-top: 24rpx;
}

.profile-portfolio-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.profile-portfolio-empty {
  padding: 32rpx 24rpx;
  font-size: 24rpx;
  color: var(--color-muted);
  text-align: center;
}

.profile-portfolio-more {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  font-size: 24rpx;
  color: var(--color-brand);
}

.profile-cooperation-card {
  overflow: hidden;
  border-radius: var(--mip-radius-card);
}

.profile-content-card {
  padding: 28rpx 24rpx;
  background: var(--color-panel);
  border-radius: var(--mip-radius-card-medium);
}

.profile-case-timeline {
  position: relative;
}

.profile-case-timeline::before {
  position: absolute;
  top: 12rpx;
  bottom: 48rpx;
  left: 17rpx;
  width: 2rpx;
  content: '';
  background: var(--color-brand);
}

.profile-case-entry {
  position: relative;
  padding-bottom: 24rpx;
}

.profile-case-entry::before {
  position: absolute;
  top: 8rpx;
  left: 6rpx;
  width: 24rpx;
  height: 24rpx;
  content: '';
  background: var(--color-brand);
  border-radius: 50%;
}

.profile-case-month {
  min-height: 40rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 40rpx;
  color: var(--color-brand);
  text-align: center;
}

.profile-case-card {
  box-sizing: border-box;
  min-height: 126rpx;
  padding: 18rpx 22rpx;
  margin: 16rpx 0 0 60rpx;
  background: var(--color-panel);
  border-radius: var(--mip-radius-card-medium);
}

.profile-case-title-row {
  display: flex;
  gap: 8rpx;
  align-items: center;
}

.profile-case-title-row image {
  flex: 0 0 auto;
  width: 28rpx;
  height: 28rpx;
}

.profile-content-heading {
  display: flex;
  gap: 20rpx;
  align-items: center;
  justify-content: space-between;
}

.profile-content-title {
  display: block;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 28rpx;
  font-weight: 600;
  white-space: nowrap;
}

.profile-content-status {
  flex: 0 0 auto;
  font-size: 22rpx;
  color: var(--color-brand);
}

.profile-content-summary {
  display: -webkit-box;
  margin-top: 12rpx;
  overflow: hidden;
  -webkit-line-clamp: 2;
  font-size: 22rpx;
  line-height: 34rpx;
  color: var(--color-muted);
  -webkit-box-orient: vertical;
}

.profile-add-card {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 200rpx;
  padding: 16rpx;
  color: var(--color-brand);
  background: var(--color-panel);
  border: 1rpx dashed var(--color-brand);
  border-radius: var(--mip-radius-card-small);
}

.profile-add-card--loading {
  opacity: 0.62;
}

.profile-add-content {
  display: flex;
  gap: 8rpx;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
}

.profile-add-content image {
  width: 28rpx;
  height: 28rpx;
}

.profile-services-entry,
.profile-admin-entry {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 20rpx 32rpx;
}

.profile-services-entry {
  margin-top: 48rpx;
  background: var(--color-panel);
  border: 1rpx solid var(--color-line);
  border-radius: var(--mip-radius-card-medium);
}

.profile-services-icon {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  background: var(--color-brand-soft);
  border-radius: var(--mip-radius-control);
}

.profile-services-copy {
  min-width: 0;
  margin-left: 20rpx;
}

.profile-more-label {
  font-size: 24rpx;
  font-weight: 600;
  line-height: 36rpx;
}

.profile-more-description {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 28rpx;
  color: var(--color-muted);
}

.profile-services-trailing {
  display: flex;
  flex: 0 0 auto;
  gap: 12rpx;
  align-items: center;
  padding-left: 16rpx;
  margin-left: auto;
}

.profile-unread-badge {
  box-sizing: border-box;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 36rpx;
  color: var(--color-on-brand);
  text-align: center;
  background: var(--color-brand);
  border-radius: 999rpx;
}

.profile-admin-entry {
  justify-content: space-between;
  margin-top: 24rpx;
  background: var(--color-panel);
  border: 1rpx solid var(--color-line);
  border-radius: var(--mip-radius-card-medium);
}

.profile-admin-entry--primary {
  margin-top: 16rpx;
  background: var(--color-brand-soft);
  border-color: var(--color-brand);
}

.profile-message {
  padding: 24rpx 32rpx;
  margin-top: 24rpx;
  font-size: 22rpx;
  color: var(--color-ink);
  background: var(--color-panel-raised);
  border: 1rpx solid var(--color-line);
  border-radius: var(--mip-radius-card-medium);
}

/* Guest (not logged in) hero per figma 1862_18360. */
.profile-guest {
  padding-top: 30rpx;

  /* Reference panel starts at the crop edge; cancel the page container inset. */
  margin-top: -30rpx;
  background: var(--color-panel);
}

.profile-guest-hero {
  display: flex;
  gap: 24rpx;
  align-items: center;
  height: 160rpx;
  padding: 0 24rpx;
}

.profile-guest-avatar {
  box-sizing: border-box;
  width: 160rpx;
  height: 160rpx;
  background: var(--color-brand);
  border: 4rpx solid var(--color-canvas);
  border-radius: 50%;
}

.profile-guest-login {
  font-size: 32rpx;
  font-weight: 500;
  line-height: 44.8rpx;
  color: var(--color-ink);
}

.profile-guest-banner {
  position: relative;
  height: 160rpx;
  margin: 24rpx 24rpx 0;
  overflow: hidden;
  background: var(--color-brand);
  border-radius: 32rpx 32rpx 0 0;
}

.profile-guest-banner-text {
  position: absolute;
  top: 18rpx;
  left: 28rpx;
  z-index: 2;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 39.2rpx;
  color: var(--color-on-brand);
}

.profile-guest-banner-sphere {
  position: absolute;
  top: 0;
  left: 150rpx;
  width: 552rpx;
  height: 160rpx;
  mix-blend-mode: color-burn;
}

.profile-guest-banner-king {
  position: absolute;
  top: 0;
  height: 160rpx;
}

.profile-guest-banner-king--1 {
  left: 304rpx;
  width: 312rpx;
}

.profile-guest-banner-king--2 {
  left: 358rpx;
  width: 308rpx;
}

.profile-action-unread {
  position: absolute;
  top: 0;
  right: 8rpx;
}

/* journey-review J3-04：站内信右上角入口（登录态头部，native 导航栏约束下的页面右上角位置）。 */
.profile-hero {
  position: relative;
}

.profile-inbox-entry {
  position: absolute;
  top: 30rpx;
  right: 36rpx;
  z-index: 2;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
}

/* 375px 稿的铃铛位于 (327,109)，扣除 88px 原生导航后为 (327,21)。
   48rpx 图标居中于 72rpx 触控区；红点位于图标内 left:32/top:0。 */
.profile-inbox-unread {
  position: absolute;
  top: 12rpx;
  left: 44rpx;
  width: 16rpx;
  height: 16rpx;
  background: #ff1313;
  border-radius: 50%;
}
