<view id="mip-home-page" class="mip-member-page mip-member-tab-page min-h-screen bg-canvas px-3 pb-[calc(env(safe-area-inset-bottom)+220rpx)] pt-4 text-ink">
  <view class="flex min-h-[88rpx] items-center justify-between">
    <view class="flex items-center gap-3">
      <image class="h-[58rpx] w-[58rpx] rounded-[14rpx]" mode="aspectFit" fade-show="{{false}}" src="{{logoPath}}" />
      <view class="text-[length:40rpx] font-bold">{{productName}}</view>
    </view>
    <view class="flex min-h-[88rpx] items-center gap-1 px-2 text-[length:23rpx]" bind:tap="openBranches">
      <t-icon name="location" size="30rpx" color="var(--color-brand)" />
      <text>{{primaryBranchName}}</text>
      <t-icon name="chevron-right" size="28rpx" color="var(--color-muted)" />
    </view>
  </view>

  <view aria-label="正在加载" aria-busy="true" wx:if="{{bannerState === 'loading'}}" class="mt-3 h-[298rpx] overflow-hidden rounded-[16rpx] bg-panel px-4 py-5">
    <t-skeleton row-col="{{[1,1]}}" theme="paragraph" animation="gradient" loading />
  </view>
  <swiper wx:elif="{{bannerState === 'ready' && banners.length}}" class="mt-3 h-[298rpx] overflow-hidden rounded-[16rpx] bg-panel" autoplay="{{banners.length > 1}}" circular="{{banners.length > 1}}" indicator-dots="{{banners.length > 1}}" interval="4500" duration="400">
    <swiper-item wx:for="{{banners}}" wx:key="id">
      <view class="h-full w-full" aria-role="button" aria-label="{{item.accessibilityLabel}}" data-index="{{index}}" bind:tap="openBanner">
        <image class="h-full w-full" mode="aspectFill" src="{{item.imageUrl}}" />
      </view>
    </swiper-item>
  </swiper>
  <view wx:elif="{{bannerState === 'error'}}" class="mt-3 flex min-h-[128rpx] items-center justify-between gap-4 rounded-[20rpx] border border-line bg-panel px-4 py-4">
    <view class="min-w-0">
      <view class="text-[length:26rpx] font-semibold">推荐内容暂时无法加载</view>
      <view class="mt-1 text-[length:22rpx] text-muted">其他内容仍可继续浏览。</view>
    </view>
    <view class="flex min-h-[88rpx] shrink-0 items-center rounded-full bg-brand px-4 text-[length:22rpx] font-semibold text-on-brand" aria-role="button" bind:tap="retryBanner">重新加载</view>
  </view>

  <view wx:if="{{hasAnnouncements}}" class="mt-7">
    <view class="flex min-h-[64rpx] items-center justify-between">
      <view class="text-[length:32rpx] font-bold">社区公告</view>
      <view class="flex items-center gap-1 text-[length:22rpx] text-brand" bind:tap="openAnnouncements">全部公告<t-icon name="chevron-right" size="28rpx" color="var(--color-brand)" /></view>
    </view>
    <view wx:if="{{announcement}}" class="mt-3 rounded-[16rpx] border border-brand bg-panel px-4 py-4 active:bg-panel-raised" bind:tap="openAnnouncement">
      <view class="flex items-center gap-2"><text wx:if="{{announcement.isPinned}}" class="rounded-full bg-brand-soft px-3 py-1 text-[length:22rpx] text-brand">置顶</text><text wx:if="{{announcement.branchName}}" class="text-[length:22rpx] text-muted">{{announcement.branchName}}</text></view>
      <view class="mt-2 line-clamp-2 text-[length:28rpx] font-bold">{{announcement.title}}</view>
      <view class="mt-2 line-clamp-2 text-[length:22rpx] leading-5 text-muted">{{announcement.summary}}</view>
    </view>
  </view>

  <view class="mt-7">
    <view class="flex min-h-[64rpx] items-center justify-between">
      <view class="text-[length:32rpx] font-bold">近期活动</view>
      <view class="flex items-center gap-1 text-[length:22rpx] text-brand" bind:tap="openEvents">全部活动<t-icon name="chevron-right" size="28rpx" color="var(--color-brand)" /></view>
    </view>
    <view aria-label="正在加载" aria-busy="true" wx:if="{{eventState === 'loading'}}" class="mt-3 flex flex-col gap-3">
      <view class="rounded-[16rpx] bg-panel px-4 py-6"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
      <view class="rounded-[16rpx] bg-panel px-4 py-6"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
    </view>
    <view wx:elif="{{eventState === 'error'}}" class="mt-3"><app-empty-state title="活动暂时无法加载" description="其他内容仍可继续浏览。" action-text="重新加载" bind:action="loadEvents" /></view>
    <view wx:elif="{{events.length === 0}}" class="mt-3"><app-empty-state title="暂无近期活动" description="新活动发布后会显示在这里。" /></view>
    <view wx:else class="mt-3 flex flex-col gap-3">
      <event-card wx:for="{{events}}" wx:key="id" event="{{item}}" variant="feed" bind:select="openEvent" />
    </view>
  </view>

  <view class="mt-7">
    <view class="flex min-h-[64rpx] items-center justify-between">
      <view class="text-[length:32rpx] font-bold">合作机会</view>
      <view class="flex items-center gap-1 text-[length:22rpx] text-brand" bind:tap="openOpportunities">全部机会<t-icon name="chevron-right" size="28rpx" color="var(--color-brand)" /></view>
    </view>
    <view aria-label="正在加载" aria-busy="true" wx:if="{{opportunityState === 'loading'}}" class="mt-3 rounded-[16rpx] bg-panel px-4 py-6"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
    <view wx:elif="{{opportunityState === 'error'}}" class="mt-3"><app-empty-state title="机会暂时无法加载" description="其他内容仍可继续浏览。" action-text="重新加载" bind:action="loadOpportunities" /></view>
    <view wx:elif="{{opportunities.length === 0}}" class="mt-3"><app-empty-state title="暂无合作机会" description="已发布的招募信息会显示在这里。" /></view>
    <view wx:else class="mt-3 flex flex-col gap-3">
      <view wx:for="{{opportunities}}" wx:key="id" class="active:bg-panel-raised" aria-role="button" data-id="{{item.id}}" bind:tap="openOpportunity"><mip-opportunity-card title="{{item.title}}" cover-url="{{item.coverUrl || ''}}" value-text="{{item.commercialTerms.amountDisplay || item.valueSummary}}" location-text="{{item.commercialTerms.locationDisplay || item.city.label || item.branchName || '全国'}}" target-text="{{item.targetSummary}}" referral-count="{{item.referralCount}}" /></view>
    </view>
  </view>

  <view class="mt-7">
    <view class="flex min-h-[64rpx] items-center justify-between">
      <view class="text-[length:32rpx] font-bold">更多内容</view>
    </view>
    <view class="mt-3 flex min-h-[112rpx] items-center justify-between gap-3 rounded-[16rpx] bg-panel px-4 py-4 active:bg-panel-raised" bind:tap="openKnowledge">
      <view class="min-w-0 flex-1">
        <view class="text-[length:27rpx] font-semibold">知识内容</view>
        <view class="mt-1 text-[length:22rpx] text-muted">热点、行业内容、视频和专家分享</view>
      </view>
      <t-icon name="chevron-right" size="34rpx" color="var(--color-brand)" />
    </view>
  </view>
</view>
