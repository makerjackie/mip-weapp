<view id="mip-home-page" class="mip-member-page mip-member-tab-page min-h-screen bg-canvas px-3 pb-[calc(env(safe-area-inset-bottom)+220rpx)] pt-4 text-ink">
  <view class="flex min-h-[88rpx] items-center justify-between">
    <view class="flex items-center gap-3">
      <image class="h-[58rpx] w-[58rpx] rounded-[14rpx]" mode="aspectFit" fade-show="{{false}}" src="{{logoPath}}" />
      <view class="text-[length:40rpx] font-bold">{{productName}}</view>
    </view>
    <view class="flex min-h-[72rpx] items-center gap-1 px-2 text-[length:23rpx]" bind:tap="openBranches">
      <t-icon name="location" size="30rpx" color="var(--color-brand)" />
      <text>{{primaryBranchName}}</text>
      <t-icon name="chevron-right" size="28rpx" color="var(--color-muted)" />
    </view>
  </view>

  <image wx:if="{{bannerImagePath}}" class="mt-3 h-[260rpx] w-full rounded-[20rpx] bg-panel" mode="aspectFill" src="{{bannerImagePath}}" aria-role="button" aria-label="{{bannerAccessibilityLabel}}" bind:tap="openBanner" />

  <view class="mt-3 rounded-[20rpx] bg-brand px-5 py-5 text-on-brand" bind:tap="openMembership">
    <view class="flex items-start justify-between gap-4">
      <view class="min-w-0 flex-1">
        <view class="text-[length:22rpx] font-semibold">{{identityState === 'error' ? '会员状态暂不可用' : membershipLabel}}</view>
        <view class="mt-2 text-[length:34rpx] font-bold">{{identityState === 'error' ? '查看会员服务' : membershipDescription}}</view>
        <view wx:if="{{membershipEndsText}}" class="mt-2 text-[length:21rpx] opacity-70">有效期至 {{membershipEndsText}}</view>
      </view>
      <view class="flex min-h-[64rpx] shrink-0 items-center gap-1 rounded-full bg-canvas px-3 text-[length:21rpx] font-semibold text-brand">
        查看<t-icon name="chevron-right" size="28rpx" color="var(--color-brand)" />
      </view>
    </view>
  </view>

  <view class="mt-4 rounded-[16rpx] border border-line bg-panel px-4 py-4" bind:tap="openBranches">
    <view class="flex items-center justify-between gap-3">
      <view class="min-w-0 flex-1">
        <view class="text-[length:27rpx] font-semibold">城市分会</view>
        <view wx:if="{{branchState === 'loading'}}" class="mt-2 h-[28rpx] w-[240rpx] animate-pulse rounded bg-panel-raised" />
        <view wx:elif="{{branchState === 'error'}}" class="mt-1 text-[length:22rpx] text-muted">城市分会暂不可用</view>
        <view wx:elif="{{branchNames.length}}" class="mt-1 truncate text-[length:22rpx] text-muted">{{branchNamesText}}</view>
        <view wx:else class="mt-1 text-[length:22rpx] text-muted">暂无可用分会</view>
      </view>
      <t-icon name="chevron-right" size="34rpx" color="var(--color-brand)" />
    </view>
  </view>

  <view class="mt-4 rounded-[16rpx] border border-line bg-panel px-4 py-4 active:bg-panel-raised" bind:tap="openBlindBoxes">
    <view class="flex items-center justify-between gap-3">
      <view class="min-w-0 flex-1">
        <view class="text-[length:27rpx] font-semibold">笨笨盲盒</view>
        <view class="mt-1 text-[length:22rpx] text-muted">使用游戏币抽取卡牌并查看背包</view>
      </view>
      <t-icon name="chevron-right" size="34rpx" color="var(--color-brand)" />
    </view>
  </view>

  <view class="mt-4 rounded-[16rpx] border border-line bg-panel px-4 py-4 active:bg-panel-raised" bind:tap="openKnowledge">
    <view class="flex items-center justify-between gap-3">
      <view class="min-w-0 flex-1">
        <view class="text-[length:27rpx] font-semibold">知识内容</view>
        <view class="mt-1 text-[length:22rpx] text-muted">热点、行业内容、视频和专家分享</view>
      </view>
      <t-icon name="chevron-right" size="34rpx" color="var(--color-brand)" />
    </view>
  </view>

  <view wx:if="{{hasAnnouncements}}" class="mt-7">
    <view class="flex min-h-[64rpx] items-center justify-between">
      <view class="text-[length:32rpx] font-bold">社区公告</view>
      <view class="flex items-center gap-1 text-[length:22rpx] text-brand" bind:tap="openAnnouncements">全部公告<t-icon name="chevron-right" size="28rpx" color="var(--color-brand)" /></view>
    </view>
    <view wx:if="{{announcement}}" class="mt-3 rounded-[16rpx] border border-brand bg-panel px-4 py-4 active:bg-panel-raised" bind:tap="openAnnouncement">
      <view class="flex items-center gap-2"><text class="rounded-full bg-brand-soft px-3 py-1 text-[length:20rpx] text-brand">置顶</text><text wx:if="{{announcement.branchName}}" class="text-[length:20rpx] text-muted">{{announcement.branchName}}</text></view>
      <view class="mt-2 line-clamp-2 text-[length:28rpx] font-bold">{{announcement.title}}</view>
      <view class="mt-2 line-clamp-2 text-[length:22rpx] leading-5 text-muted">{{announcement.summary}}</view>
    </view>
  </view>

  <view class="mt-7">
    <view class="flex min-h-[64rpx] items-center justify-between">
      <view class="text-[length:32rpx] font-bold">近期活动</view>
      <view class="flex items-center gap-1 text-[length:22rpx] text-brand" bind:tap="openEvents">全部活动<t-icon name="chevron-right" size="28rpx" color="var(--color-brand)" /></view>
    </view>
    <view wx:if="{{eventState === 'loading'}}" class="mt-3 flex flex-col gap-3">
      <view class="rounded-[16rpx] bg-panel px-4 py-6"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
      <view class="rounded-[16rpx] bg-panel px-4 py-6"><t-skeleton row-col="{{[1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
    </view>
    <view wx:elif="{{eventState === 'error'}}" class="mt-3"><app-empty-state title="活动暂时无法加载" description="其他内容仍可继续浏览。" action-text="重新加载" bind:action="loadEvents" /></view>
    <view wx:elif="{{events.length === 0}}" class="mt-3"><app-empty-state title="暂无近期活动" description="新活动发布后会显示在这里。" /></view>
    <view wx:else class="mt-3 flex flex-col gap-3">
      <view wx:for="{{events}}" wx:key="id" class="overflow-hidden rounded-[16rpx] bg-panel active:bg-panel-raised" data-id="{{item.id}}" bind:tap="openEvent">
        <image wx:if="{{item.coverUrl}}" class="h-[260rpx] w-full" mode="aspectFill" src="{{item.coverUrl}}" />
        <view class="px-4 py-4">
          <view class="flex items-center justify-between gap-3"><text class="rounded-full bg-brand-soft px-3 py-1 text-[length:20rpx] text-brand">{{item.accessLabel}}</text><text class="text-[length:21rpx] text-muted">{{item.registrationCount}} 人参加</text></view>
          <view class="mt-2 line-clamp-2 text-[length:29rpx] font-bold">{{item.title}}</view>
          <view class="mt-2 text-[length:22rpx] text-muted">{{item.startsText}} · {{item.locationText}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="mt-7">
    <view class="flex min-h-[64rpx] items-center justify-between">
      <view class="text-[length:32rpx] font-bold">合作机会</view>
      <view class="flex items-center gap-1 text-[length:22rpx] text-brand" bind:tap="openOpportunities">全部机会<t-icon name="chevron-right" size="28rpx" color="var(--color-brand)" /></view>
    </view>
    <view wx:if="{{opportunityState === 'loading'}}" class="mt-3 rounded-[16rpx] bg-panel px-4 py-6"><t-skeleton row-col="{{[1,1,1,1]}}" theme="paragraph" animation="gradient" loading /></view>
    <view wx:elif="{{opportunityState === 'error'}}" class="mt-3"><app-empty-state title="机会暂时无法加载" description="其他内容仍可继续浏览。" action-text="重新加载" bind:action="loadOpportunities" /></view>
    <view wx:elif="{{opportunities.length === 0}}" class="mt-3"><app-empty-state title="暂无合作机会" description="已发布的招募信息会显示在这里。" /></view>
    <view wx:else class="mt-3 flex flex-col gap-3">
      <view wx:for="{{opportunities}}" wx:key="id" class="rounded-[16rpx] bg-panel px-4 py-4 active:bg-panel-raised" data-id="{{item.id}}" bind:tap="openOpportunity">
        <view class="flex items-start justify-between gap-3"><view class="line-clamp-2 min-w-0 flex-1 text-[length:28rpx] font-bold">{{item.title}}</view><text class="shrink-0 rounded-full bg-brand-soft px-3 py-1 text-[length:20rpx] text-brand">招募中</text></view>
        <view class="mt-2 line-clamp-2 text-[length:22rpx] leading-5 text-muted">{{item.valueSummary}}</view>
        <view class="mt-3 flex items-center justify-between text-[length:21rpx] text-muted"><text>{{item.metaText}}</text><text>{{item.referralCount}} 人引荐</text></view>
      </view>
    </view>
  </view>
</view>
