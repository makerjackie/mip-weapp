/* iOS-critical half of the liquid-glass surface; the rest lives in app.css.
   Kept in a plain wxss file (@import'ed by each page) because the tailwind
   app.css pipeline strips the -webkit-backdrop-filter prefix and the
   @supports fallback that iOS still requires. */
.mip-liquid-glass {
  -webkit-backdrop-filter: blur(20px) saturate(150%);
}

@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .mip-liquid-glass {
    background: rgb(32 32 32 / 92%);
  }
}
