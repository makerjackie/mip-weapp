MINI_PROGRAM_NAME=MIP
APP_NAMESPACE=mip
MINI_PROGRAM_APP_ID=wx_your_mini_program_app_id
MIP_ALLOWED_APP_IDS=wx_your_mini_program_app_id
# Local-only verified mainland mobile number used to locate the initial owner.
# Keep the committed example empty; the number must already be bound on a real device.
MIP_OWNER_PHONE=
CLOUDBASE_ENV_ID=
CLOUDBASE_RESOURCE_APP_ID=
# Required for CloudBase management commands. Use an environment-level API Key, not a frontend publish_key.
# Create at https://tcb.cloud.tencent.com/dev#/env/apikey and keep the value in .env.local only.
CLOUDBASE_API_KEY=
MIP_IDENTITY_FUNCTION_NAME=mip-identity-api
MIP_MEDIA_FUNCTION_NAME=mip-media-api
MIP_EVENTS_FUNCTION_NAME=mip-events-api
MIP_OPPORTUNITIES_FUNCTION_NAME=mip-opportunities-api
MIP_COMMUNITY_FUNCTION_NAME=mip-community-api
MIP_COMMERCE_FUNCTION_NAME=mip-commerce-api
MIP_ADMIN_FUNCTION_NAME=mip-admin-api
MIP_GROWTH_FUNCTION_NAME=mip-growth-api
MIP_GAME_FUNCTION_NAME=mip-game-api
MIP_TASKS_FUNCTION_NAME=mip-tasks-api
MIP_BANNERS_FUNCTION_NAME=mip-banners-api
MIP_AI_FUNCTION_NAME=mip-ai-api
MIP_NOTIFICATIONS_FUNCTION_NAME=mip-notifications-api
MIP_LEDGER_FUNCTION_NAME=mip-payment-ledger
MIP_NOTIFICATION_FUNCTION_NAME=mip-notification-worker
MIP_OUTBOX_FUNCTION_NAME=mip-outbox-worker
MIP_MESSAGE_SCHEDULER_FUNCTION_NAME=mip-message-scheduler
MIP_MESSAGE_SCHEDULER_TRIGGER_NAME=mip-message-campaign-next
# Required only for the dedicated scheduler deployment. Confirm the SCF cron
# wall-clock offset with the scheduler canary before activating dispatch.
MIP_SCF_REGION=
MIP_SCF_TIMER_UTC_OFFSET_MINUTES=
MIP_MESSAGE_SCHEDULER_ROLE_NAME=MIPMessageSchedulerRole
# Resource owner UIN is used only to build narrow CAM resource identifiers.
CLOUDBASE_RESOURCE_UIN=
MIP_PAY_FUNCTION_NAME=mip-cloudpay
MIP_PAY_CALLBACK_FUNCTION=mip-cloudpay-callback
MIP_REFUND_FUNCTION_NAME=mip-refund-worker
MIP_PAYMENT_MODE=disabled
MIP_CATALOG_STAGE=TEST
MIP_KNOWLEDGE_TEST_PRICE_CENTS=990
# Exact HTTPS hostnames only. Wildcards and IP literals are rejected.
MIP_KNOWLEDGE_SOURCE_ALLOWED_HOSTS=feed.example.com
MIP_KNOWLEDGE_WEBVIEW_ALLOWED_HOSTS=knowledge.example.com
MIP_DEPLOYMENT_STAGE=development

# WeChat subscribe-message template IDs and keyword mapping. Template IDs are
# configured manually at mp.weixin.qq.com. They are identifiers, not secrets.
# Keep client build and server worker on the same JSON value.
MIP_SUBSCRIBE_TEMPLATES_JSON=
MIP_MINIPROGRAM_STATE=trial
# Optional customer-service window and service-account adapter. The service-account
# endpoint must be HTTPS; keep its HMAC secret in .env.local only.
MIP_CUSTOMER_SERVICE_ENABLED=false
MIP_SERVICE_ACCOUNT_ADAPTER_JSON=
MIP_SERVICE_ACCOUNT_ADAPTER_SECRET=

# Server-only product configuration. Keep real values in .env.local.
# Leave blank to use the repository defaults. A non-empty agreement array is
# injected unchanged into identity, commerce, opportunities, and admin APIs.
MIP_AGREEMENTS_JSON=
MIP_AI_PROVIDER_FUNCTION_NAME=
MIP_AI_AVATAR_PROVIDER_FUNCTION_NAME=
MIP_MATCHING_PROVIDER_FUNCTION_NAME=
MIP_MATCHING_PROVIDER_TIMEOUT_MS=3000
MIP_AI_DRAFT_TTL_HOURS=72
MIP_EXPORT_MAX_ROWS=5000
MIP_EXPORT_MAX_BYTES=8388608
# Keep false during normal development. Enable only after copying one app scope
# and reusing the exact UnionID pepper in the target AppID environment.
MIP_UNION_ID_REBIND_ENABLED=false

# Optional stable secret overrides. cloud:deploy generates and preserves these
# on the isolated mip-* functions when left blank.
MIP_IDENTITY_PEPPER=
MIP_UNION_IDENTITY_PEPPER=
MIP_MEDIA_SCOPE_SECRET=
MIP_MEDIA_MAINTENANCE_HMAC_SECRET=
MIP_PHONE_ENCRYPTION_KEY=
MIP_EVENT_TOKEN_SECRET=
MIP_LEDGER_SECRET=
MIP_TEST_MEMBERSHIP_HMAC_SECRET=
MIP_GROWTH_HMAC_SECRET=
MIP_NOTIFICATION_HMAC_SECRET=
MIP_OUTBOX_HMAC_SECRET=
MIP_MESSAGE_DISPATCH_HMAC_SECRET=
MIP_REFUND_WORKER_HMAC_SECRET=
MIP_NOTIFICATION_ENCRYPTION_KEY=
MIP_AI_HMAC_SECRET=
MIP_AI_STORAGE_KEY=
MIP_MATCHING_INTERNAL_HMAC_SECRET=
MIP_MATCHING_REFERENCE_SECRET=

# Server-only. Native CloudPay keeps certificates and signatures on the platform;
# each Mini Program AppID still needs its own merchant binding/authorization.
WECHAT_PAY_MERCHANT_ID=

# Optional server-only URI override. When blank, cloud:deploy creates an
# environment-scoped least-privilege user and keeps its URI only in Function configuration.
MIP_DB_CONNECTION_URI=
# Leave blank to derive mip_<EnvID fingerprint>. A different or shared name is rejected.
MIP_DB_RUNTIME_USER=

# Optional when CloudBase cannot infer these from the existing MySQL instance.
MIP_DB_VPC_ID=
MIP_DB_SUBNET_ID=
BUILD_SHA=development
