# Browser only receives the same-origin BFF address. Set true only for explicit local demo mode.
VITE_MIP_ADMIN_API_URL=/api/admin
VITE_MIP_ADMIN_DEMO_MODE=true

# Server-only Pages Function bindings. Configure with Cloudflare secrets/variables; never prefix with VITE_.
MIP_WEB_ALLOWED_ORIGIN=https://mipmini.01mvp.com
MIP_WEB_ALLOWED_APP_IDS=
MIP_WEB_SESSION_SECRET=
MIP_ADMIN_WEB_LOGIN_HMAC_SECRET=
MIP_ADMIN_UPSTREAM_URL=
MIP_ADMIN_UPSTREAM_HMAC_SECRET=
