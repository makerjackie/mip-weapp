MINI_PROGRAM_NAME=同行会
APP_NAMESPACE=membership
MINI_PROGRAM_APP_ID=wx_your_mini_program_app_id
MEMBERSHIP_ALLOWED_APP_IDS=wx_your_mini_program_app_id
CLOUDBASE_ENV_ID=
CLOUDBASE_RESOURCE_APP_ID=
# Optional. Environment-level CloudBase API Key for MCP. Do not use a frontend publish_key.
# Create at https://tcb.cloud.tencent.com/dev#/env/apikey and keep the value in .env.local only.
CLOUDBASE_API_KEY=
MEMBERSHIP_FUNCTION_NAME=membership-api
MEMBERSHIP_ADMIN_FUNCTION_NAME=membership-admin-api
MEMBERSHIP_LEDGER_FUNCTION_NAME=membership-payment-ledger
MEMBERSHIP_PAY_FUNCTION_NAME=membership-cloudpay
MEMBERSHIP_PAY_CALLBACK_FUNCTION=membership-cloudpay-callback
MEMBERSHIP_PAYMENT_MODE=disabled
MEMBERSHIP_DEPLOYMENT_STAGE=development

# WeChat subscribe-message template IDs and keyword mapping. Template IDs are
# configured manually at mp.weixin.qq.com. They are identifiers, not secrets.
# Keep client build and server worker on the same JSON value.
MEMBERSHIP_SUBSCRIBE_TEMPLATES_JSON=
MEMBERSHIP_MINIPROGRAM_STATE=trial

# Server-only. Native CloudPay keeps certificates and signatures on the platform;
# each Mini Program AppID still needs its own merchant binding/authorization.
WECHAT_PAY_MERCHANT_ID=

# Optional server-only override. When blank, cloud:deploy creates a least-privilege
# member_runtime MySQL user and keeps the generated URI only in Function configuration.
MEMBERSHIP_DB_CONNECTION_URI=

# Optional when CloudBase cannot infer these from the existing MySQL instance.
MEMBERSHIP_DB_VPC_ID=
MEMBERSHIP_DB_SUBNET_ID=
BUILD_SHA=development
